# ====================================================
# Django core utilities – merged from 'ref' and 'grep'
# ====================================================
[submodule "libs/django-osoul"]
	path = applications/libs/django-osoul
	url = https://github.com/mammhoud/django-osoul
	branch = generic
	ignore = dirty
	fetchRecurseSubmodules = true

# ====================================================
# AI / Agent toolkit – merged from 'rseal'
# ====================================================
[submodule "libs/crafts-ai"]
	path = applications/libs/crafts-ai
	url = https://github.com/mammhoud/crafts-ai
	branch = generic
	ignore = dirty
	fetchRecurseSubmodules = true


# ============================================================
# Coolify Production Environment Variables
# ============================================================
# Override values for production deployment
# ============================================================

# Application Settings
APP_ID=
APP_NAME=Coolify
APP_KEY=
APP_ENV=production
APP_DEBUG=false
APP_URL=https://coolify.your-domain.com

# Database Settings
DB_USERNAME=coolify
DB_PASSWORD=

# Redis Settings
REDIS_PASSWORD=

# Pusher Settings
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=

# Soketi Settings
SOKETI_PORT=6001
SOKETI_DEBUG=false

# Root User
ROOT_USERNAME=
ROOT_USER_EMAIL=
ROOT_USER_PASSWORD=

# Registry URL
REGISTRY_URL=ghcr.io

# Docker Address Pool
DOCKER_ADDRESS_POOL_BASE=172.17.0.0/12
DOCKER_ADDRESS_POOL_SIZE=24

# Application Port
APP_PORT=8000

# PHP Settings
PHP_MEMORY_LIMIT=512M
PHP_FPM_PM_CONTROL=dynamic
PHP_FPM_PM_START_SERVERS=4
PHP_FPM_PM_MIN_SPARE_SERVERS=2
PHP_FPM_PM_MAX_SPARE_SERVERS=10

# Data Directory
DATA_DIR=/data/coolify

# LATEST_IMAGE
LATEST_IMAGE=latest

{
  "mcpServers": {
    "deployment": {
      "command": "python",
      "args": [
        "mcp_server.py"
      ],
      "env": {
        "DJANGO_SETTINGS_MODULE": "core.settings",
        "PYTHONPATH": "applications/libs/crafts-ai/src"
      }
    },
    "crafts-ai": {
      "command": "uvicorn",
      "args": [
        "crafts_ai.mcp_server:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8002"
      ],
      "env": {
        "PYTHONPATH": "applications/libs/crafts-ai/src"
      }
    }
  }
}

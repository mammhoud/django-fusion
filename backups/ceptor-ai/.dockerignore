# Root .dockerignore — applied when build context is repository root
# (context: ../..  from applications/<site>/).  The shared compose/Dockerfile
# copies applications/<PROJECT_PATH>/ via COPY, so all paths are relative
# to this root.
# ===============================================================
# Global patterns
# ===============================================================

# Dependencies (always rebuilt in Docker)
**/node_modules
**/.venv

# Python bytecode
**/__pycache__
**/*.pyc
**/*.pyo

# Build & cache artifacts
**/.sass-cache
**/.cache
**/dist
**/build
**/*.egg-info
**/.pytest_cache
**/.hypothesis
**/.ruff_cache
**/.mypy_cache
**/.tox
**/.nox

# OS files
**/.DS_Store
**/Thumbs.db

# Version control
**/.git
**/.gitignore
**/.gitattributes
**/.gitmodules

# IDE & editor config
**/.idea
**/.vscode
**/.claude

# Logs
**/*.log
**/logs

# Environment & secrets
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.cert

# ===============================================================
# Site-specific exclusions (all relative to repository root)
# ===============================================================

# ── VResume ─────────────────────────────────────────────────
applications/VResume/db.sqlite3
applications/VResume/staticfiles/
applications/VResume/static_root/
applications/VResume/media_root/
# Note: bundles are no longer built in Docker (uses pre-built bundles from git)

# ── ctc-research ────────────────────────────────────────────
applications/ctc-research/db.sqlite3
applications/ctc-research/staticfiles/
# Note: bundles are no longer built in Docker (uses pre-built bundles from git)

# ── lms-demo ────────────────────────────────────────────────
applications/lms-demo/db.sqlite3
applications/lms-demo/staticfiles/
# Note: bundles are no longer built in Docker (uses pre-built bundles from git)

# ── customizer (also used by context: ..  from applications/) ──
applications/customizer/db.sqlite3
applications/customizer/data/
applications/customizer/staticfiles/
applications/customizer/static_root/
applications/customizer/media_root/
applications/customizer/assets/bundles/
applications/customizer/assets/node_modules/

# ── Shared workspace ────────────────────────────────────────
applications/assets/bundles/
applications/assets/media/
applications/assets/staticfiles/

# Source maps & workbox precache (generated by webpack)
**/bundles/**/*.map
**/bundles/**/precache-*

# ── Skip site-level editable installs ──────────────────────
# Site pyproject.toml files trigger `uv pip install --editable`
# in the Dockerfile, which creates top-level "www" packages that
# shadow Django's import resolution.  PYTHONPATH in the entrypoint
# handles all runtime imports, so the editable install is unnecessary.
applications/ctc-research/pyproject.toml
applications/VResume/pyproject.toml
applications/crm/pyproject.toml
applications/lms-demo/pyproject.toml


# Keep lib submodules in the build context (they contain django-fusion and ceptor-ai).
# Only exclude build/cache artifacts that may appear inside them.
applications/libs/**/node_modules
applications/libs/**/.venv
applications/libs/**/__pycache__
applications/libs/**/*.pyc
applications/libs/**/*.pyo
applications/libs/**/.pytest_cache
applications/libs/**/.mypy_cache
applications/libs/**/*.egg-info
applications/libs/**/dist
applications/libs/**/build
# ============================================
# 🌐 CTC Research — Environment Configuration Example
# Copy to .env and fill in values
# ============================================

# Core Environment
# Valid SERVER_ENV values: development, demo, staging, testing, production
SERVER_ENV=production
RUNNING_ENV=docker
MODULE=LMS
DJANGO_WEBSITE=ctc-research
WEBSITE=ctc-research
WEBSITE_NAME=ctc-research

# Django
DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret

# Domain & Hosts
ALLOWED_HOSTS=ctc-research.com,www.ctc-research.com,arch.ctc-research.com
CSRF_TRUSTED_ORIGINS=https://ctc-research.com,https://www.ctc-research.com
CORS_ALLOWED_ORIGINS=https://ctc-research.com,https://www.ctc-research.com

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/3

# Django Superuser (initial setup)
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@ctc-research.com
SUPERUSER_PASSWORD=change-me

# Feature Flags
VAULT_ENABLED_FOR_DYNACONF=false

# Email (SMTP)
EMAIL_STRATEGY=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_SENDER_1=your-primary-sender@gmail.com
EMAIL_SENDER_1_PASSWORD=your-app-password
EMAIL_SENDER_2=your-secondary-sender@gmail.com
EMAIL_SENDER_2_PASSWORD=your-app-password
EMAIL_USER=your-secondary-sender@gmail.com
EMAIL_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-secondary-sender@gmail.com

# Git (optional — for container sync)
# GIT_REPO=ctc-website
# GIT_USERNAME=your-username
# GIT_TOKEN=replace-with-token

# Database (PostgreSQL — used when SERVER_ENV=production/demo/staging)
# For local development without Docker, use .env.development or set DB_TYPE=sqlite.
DB_ENGINE=django.db.backends.postgresql
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=db_ctc
DB_USER=postgres
DB_PASSWORD=change-me

# Payments (optional)
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...

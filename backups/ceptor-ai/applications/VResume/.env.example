# ============================================
# 🌐 ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and adjust values for your environment.
# Required at minimum: DJANGO_SECRET_KEY, DJANGO_HOST, DB credentials

# Core Environment
SERVER_ENV=development                     # development, production
RUNNING_ENV=local                          # local, docker
MODULE=CMS                                 # CMS
DJANGO_SERVER_TYPE=wsgi                    # wsgi, asgi
PORT=5072

# Django Settings
DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-secure-random-key

# Domain Configuration
DJANGO_HOST=localhost:5072
DOCS_HOST=docs.example.com
TRAEFIK_HOST=traefik.example.com
DB_TYPE=sqlite                             # sqlite, postgres

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_FROM=noreply@example.com
EMAIL_USER=
EMAIL_PASSWORD=

# Django Superuser (for initial setup)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-too

# Redis & Celery (optional — runtime only, not required for basic dev)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Feature Flags
VAULT_ENABLED_FOR_DYNACONF=false
EMAIL_TRACKING_ENABLED=false
EMAIL_QUEUE_ENABLED=false

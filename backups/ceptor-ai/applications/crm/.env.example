# CRM site environment variables — copy to .env and fill in values
DJANGO_WEBSITE=crm
WEBSITE=crm
DJANGO_SETTINGS_MODULE=crm.settings

# Security
DJANGO_SECRET_KEY=change-me-in-production

# Database (override the shared default if needed)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=crm_db
# DB_USER=postgres
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432

# Server
PORT=5074
DEBUG=true
SERVER_ENV=development

# ============================================
# 🌐 ENVIRONMENT CONFIGURATION — EXAMPLE
# Copy to .env and fill in values
# ============================================
# 
# ⚠️  SECURITY NOTICE
# This file is a template. For sensitive credentials and passwords:
# 1. Copy this file to .env (git-ignored)
# 2. Store database passwords in compose/config/secrets.yml
# 3. Load secrets.yml in deployment configurations
# See compose/config/secrets.example.yml for the secrets structure

# Core Environment
SERVER_ENV=production
RUNNING_ENV=docker
MODULE=CMS
DJANGO_WEBSITE=structa.cloud
WEBSITE_NAME=structa.cloud

# Django
DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret

# Domain & Hosts
DOMAIN=structa.cloud
SITE_DOMAIN=structa.cloud
ALLOWED_HOSTS=structa.cloud,www.structa.cloud,core.structa.cloud
CSRF_TRUSTED_ORIGINS=https://structa.cloud,https://www.structa.cloud,https://core.structa.cloud
CORS_ALLOWED_ORIGINS=https://structa.cloud,https://www.structa.cloud,https://core.structa.cloud

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0

# Superuser
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=vresume@structa.cloud
SUPERUSER_PASSWORD=change-me

# Feature Flags
VAULT_ENABLED_FOR_DYNACONF=false

# Email
EMAIL_STRATEGY=smtp
EMAIL_USER=vresume@structa.cloud
EMAIL_PASSWORD=your-smtp-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=vresume@structa.cloud

# Payments (optional)
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

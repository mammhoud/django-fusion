# Structa Cloud Root Environment Configuration
# Copy this file to .env and fill in your values
# .env is git-ignored and should never be committed

# Django Settings
DJANGO_SETTINGS_MODULE=configs.settings.local
DEBUG=True
ENVIRONMENT=development

# Database (see compose/config/secrets.yml for passwords)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=structa_cloud
DB_USER=postgres
DB_HOST=postgres
DB_PORT=5432
# DB_PASSWORD is stored in compose/config/secrets.yml

# Redis
REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD is stored in compose/config/secrets.yml

# Django Secret
# SECRET_KEY is stored in compose/config/secrets.yml

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,*.structa.cloud

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# API Configuration
API_DEBUG=True
API_LOG_LEVEL=DEBUG

# Feature Flags
FEATURE_AI_ENABLED=False
FEATURE_MCP_SERVER=False

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# File Storage
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

# ============================================================
# Proxy / SSL / DNS-01 (consumed by proxy/docker-compose.traefik.yml)
# ============================================================
# These vars are the SINGLE source of truth for the Traefik proxy and
# the Let's Encrypt DNS-01 ACME flow. Keep them at the base repo .env
# (this file) so the proxy and any local tooling can read them from
# one place. The legacy `proxy/.env` is still respected as a fallback
# (see proxy/docker-compose.traefik.yml for the loader chain).
#
# DNS_PROVIDER selects the DNS-01 plugin in Traefik. Today only
# "cloudflare" is wired; "route53" / "gandi" / "digitalocean" can be
# added by extending proxy/traefik/dynamic.yml + the env vars below.
DNS_PROVIDER=cloudflare

# --- Cloudflare DNS-01 credentials ---
# RECOMMENDED: scoped API token. Create at
#   https://dash.cloudflare.com/profile/api-tokens
# Permissions: Zone / DNS / Edit (scoped to the relevant zones).
CF_DNS_API_TOKEN=

# LEGACY (alternative to CF_DNS_API_TOKEN): global API key + account email.
# Leave both empty if you're using CF_DNS_API_TOKEN above.
CF_API_EMAIL=
CF_API_KEY=

# --- Let's Encrypt ---
# Used for the ACME account registration and expiry notifications.
LETSENCRYPT_EMAIL=admin@structa.cloud

# ============================================================
# Git / GitHub Push Authentication
# ============================================================
# Used by `make push`, `make push-libs`, and `make push-lib` for
# authenticated pushes to GitHub remotes. Generate a classic PAT
# or fine-grained token at: https://github.com/settings/tokens
# Minimum scopes: repo (private repos) or public_repo (public).
#
# The token is injected via `git credential.helper` so it never
# appears in process listings (unlike URL-injection approaches).
#
# Can also be exported as GITHUB_TOKEN in the environment.
github=ghp_xxxxxxxxxxxxxxxxxxxx

# Root .dockerignore — applied when build context is repository root
# (context: ../..  from core/<site>/).  The shared compose/Dockerfile
# copies core/<PROJECT_PATH>/ via COPY, so all paths are relative
# to this root.
# ===============================================================
# Global patterns
# ===============================================================

# Dependencies (always rebuilt in Docker)
**/node_modules
**/.venv

# Python bytecode
**/__pycache__
**/*.pyc
**/*.pyo

# Build & cache artifacts
**/.sass-cache
**/.cache
**/dist
**/build
**/*.egg-info
**/.pytest_cache
**/.hypothesis
**/.ruff_cache
**/.mypy_cache
**/.tox
**/.nox

# OS files
**/.DS_Store
**/Thumbs.db

# Version control
**/.git
**/.gitignore
**/.gitattributes
**/.gitmodules

# IDE & editor config
**/.idea
**/.vscode
**/.claude

# Logs
**/*.log
**/logs

# Environment & secrets
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.cert

# ===============================================================
# Site-specific exclusions (all relative to repository root)
# ===============================================================

# ── VResume ─────────────────────────────────────────────────
core/VResume/db.sqlite3
core/VResume/staticfiles/
core/VResume/static_root/
core/VResume/media_root/
core/VResume/assets/bundles/

# ── ctc-research ────────────────────────────────────────────
core/ctc-research/db.sqlite3
core/ctc-research/staticfiles/
core/ctc-research/assets/bundles/

# ── lms-demo ────────────────────────────────────────────────
core/lms-demo/db.sqlite3
core/lms-demo/staticfiles/
core/lms-demo/assets/bundles/

# ── tinker (also used by context: ..  from core/) ──
core/tinker/db.sqlite3
core/tinker/data/
core/tinker/staticfiles/
core/tinker/static_root/
core/tinker/media_root/
core/tinker/assets/bundles/
core/tinker/assets/node_modules/

# ── Shared workspace ────────────────────────────────────────
core/assets/bundles/
core/assets/media/
core/assets/staticfiles/

# Source maps & workbox precache (generated by webpack)
**/bundles/**/*.map
**/bundles/**/precache-*

# Root .dockerignore — applied when build context is repository root
# (context: ../..  from applications/<site>/).  The shared compose/Dockerfile
# copies applications/<PROJECT_PATH>/ via COPY, so all paths are relative
# to this root.
# ===============================================================
# Global patterns
# ===============================================================

# Dependencies (always rebuilt in Docker)
**/node_modules
**/.venv

# Python bytecode
**/__pycache__
**/*.pyc
**/*.pyo

# Build & cache artifacts
**/.sass-cache
**/.cache
**/dist
**/build
**/*.egg-info
**/.pytest_cache
**/.hypothesis
**/.ruff_cache
**/.mypy_cache
**/.tox
**/.nox

# OS files
**/.DS_Store
**/Thumbs.db

# Version control
**/.git
**/.gitignore
**/.gitattributes
**/.gitmodules

# IDE & editor config
**/.idea
**/.vscode
**/.claude

# Logs
**/*.log
**/logs

# Environment & secrets
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.cert

# ===============================================================
# Site-specific exclusions (all relative to repository root)
# ===============================================================

# ── VResume ─────────────────────────────────────────────────
applications/VResume/db.sqlite3
applications/VResume/staticfiles/
applications/VResume/static_root/
applications/VResume/media_root/
applications/VResume/assets/bundles/

# ── ctc-research ────────────────────────────────────────────
applications/ctc-research/db.sqlite3
applications/ctc-research/staticfiles/
applications/ctc-research/assets/bundles/

# ── lms-demo ────────────────────────────────────────────────
applications/lms-demo/db.sqlite3
applications/lms-demo/staticfiles/
applications/lms-demo/assets/bundles/

# ── customizer (also used by context: ..  from applications/) ──
applications/customizer/db.sqlite3
applications/customizer/data/
applications/customizer/staticfiles/
applications/customizer/static_root/
applications/customizer/media_root/
applications/customizer/assets/bundles/
applications/customizer/assets/node_modules/

# ── Shared workspace ────────────────────────────────────────
applications/assets/bundles/
applications/assets/media/
applications/assets/staticfiles/

# Source maps & workbox precache (generated by webpack)
**/bundles/**/*.map
**/bundles/**/precache-*

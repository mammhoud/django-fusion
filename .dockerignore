# Root .dockerignore — applied when build context is repository root
# (context: ../..  from projects/<site>/).  The shared compose/Dockerfile
# copies projects/<PROJECT_PATH>/ via COPY, so all paths are relative
# to this root.
# ===============================================================
# Global patterns
# ===============================================================

# Dependencies (always rebuilt in Docker)
**/node_modules
**/.venv

# Python bytecode
**/__pycache__
**/*.pyc
**/*.pyo

# Build & cache artifacts
**/.sass-cache
**/.cache
**/dist
**/build
**/*.egg-info
**/.pytest_cache
**/.hypothesis
**/.ruff_cache
**/.mypy_cache
**/.tox
**/.nox

# OS files
**/.DS_Store
**/Thumbs.db
tmp/*
tmp
# Version control
**/.git
**/.gitignore
**/.gitattributes
**/.gitmodules

# IDE & editor config
**/.idea
**/.vscode
**/.claude

# Logs
**/*.log
**/logs

# Environment & secrets
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.cert

# ===============================================================
# Site-specific exclusions (all relative to repository root)
# ===============================================================

# ── VResume ─────────────────────────────────────────────────
projects/portfolio/db.sqlite3
projects/VResume/staticfiles/
projects/VResume/static_root/
projects/VResume/media_root/
projects/portfolio/assets/bundles/

# ── ctc-research ────────────────────────────────────────────
projects/ctc-research/db.sqlite3
projects/ctc-research/staticfiles/
projects/ctc-research/assets/bundles/

# ── lms ────────────────────────────────────────────────
projects/lms/db.sqlite3
projects/lms/staticfiles/
projects/lms/assets/bundles/

# ── cypercloud (also used by context: ..  from projects/) ──
projects/cypercloud/db.sqlite3
projects/cypercloud/data/
projects/cypercloud/staticfiles/
projects/cypercloud/static_root/
projects/cypercloud/media_root/
projects/cypercloud/assets/bundles/
projects/cypercloud/assets/node_modules/

# ── Shared workspace ────────────────────────────────────────
projects/assets/bundles/
projects/assets/media/
projects/assets/staticfiles/

# ── Local libraries (submodules at repo base) ────────────────
libs/**/.venv/
libs/**/.pytest_cache/
libs/**/.ruff_cache/
libs/**/.mypy_cache/
libs/**/__pycache__/
libs/**/*.egg-info/
libs/**/.git/

# Source maps & workbox precache (generated by webpack)
**/bundles/**/*.map
**/bundles/**/precache-*

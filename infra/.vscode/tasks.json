{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🔧 Django: Run Server",
      "type": "shell",
      "command": "uv run ./com dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "⚡ Ruff: Fast Format",
      "type": "shell",
      "command": "ruff format .",
      "group": "build",
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      }
    },
    {
      "label": "🧹 Clean Unused Imports",
      "type": "shell",
      "command": "ruff check --select F401,F841 --fix .",
      "group": "build",
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      }
    }
  ]
}

{
  "name": "Structa Cloud — Full Monorepo",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/structa.cloud",
  "remoteUser": "root",
  "containerUser": "root",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    }
  },
  "postCreateCommand": "cd /workspaces/structa.cloud && npm install --no-audit --no-fund && echo '--- toolchain ---' && node -v && npm -v && (cd /tmp && pnpm -v) && cd /workspaces/structa.cloud && npx nx --version && python3 --version && uv --version && rustc --version && docker --version && docker compose version",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "charliermarsh.ruff",
        "rust-lang.rust-analyzer"
      ],
      "settings": {
        "typescript.tsdk": "node_modules/typescript/lib",
        "eslint.workingDirectories": [{ "mode": "auto" }]
      }
    }
  },
  "forwardPorts": [3000, 4321, 5173],
  "postAttachCommand": "echo 'workspace ready: /workspaces/structa.cloud'",
  "containerEnv": {
    "SHELL": "/usr/bin/zsh"
  }
}

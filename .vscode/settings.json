  // ============================================
  // 🎮 Enhanced Window & UI Settings
  // ============================================
  "window.titleBarStyle": "custom",
  "window.menuBarVisibility": "compact",
  "window.zoomLevel": 0,
  "window.dialogStyle": "custom",
  "window.nativeTabs": false,
  "window.nativeFullScreen": true,
  "window.restoreWindows": "none",
  "window.restoreFullscreen": false,
  "window.clickThroughInactive": false,
  // Compact UI for better space usage
  "window.density.editorTabHeight": "compact",
  "window.density.editorFontSize": "default",
  "window.density.activityBar": "default",
  "window.density.statusBar": "compact",
  "window.density.panelTitleBarHeight": "compact",
  "window.density.panelSectionHeaderHeight": "compact",
  "window.density.sideBarTitleBarHeight": "compact",
  "window.density.listItemHeight": "compact",
  "window.density.treeIndent": 16,
  "window.density.modalTitleBarHeight": "compact",
  // ============================================
  // 🔐 Security & Workspace
  // ============================================
  "security.workspace.trust.enabled": true,
  "security.workspace.trust.untrustedFiles": "open",
  "security.workspace.trust.startupPrompt": "once",
  "application.shellEnvironmentResolutionTimeout": 10,
  // ============================================
  // 📦 Extension Management
  // ============================================
  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,
  "extensions.closeExtensionDetailsOnViewChange": true,
  "extensions.ignoreRecommendations": true,
  "extensions.supportUntrustedWorkspaces": {
    "recommendations": false,
    "extensions": false
  },
  // ============================================
  // ⚙️ Debug & Testing
  // ============================================
  "debug.toolBarLocation": "docked",
  "debug.openDebug": "openOnDebugBreak",
  "debug.openExplorerOnEnd": false,
  "debug.enableAllHovers": false,
  "debug.showInStatusBar": "never",
  "debug.showSubSessionsInToolBar": false,
  "debug.console.fontSize": 14,
  "debug.console.lineHeight": 1.2,
  "debug.console.wordWrap": false,
  "debug.internalConsoleOptions": "neverOpen",
  // ============================================
  // 📈 Telemetry & Feedback
  // ============================================
  "telemetry.telemetryLevel": "off",
  "workbench.enableExperiments": false,
  "workbench.settings.editor": "ui",
  "update.mode": "none",
  "update.showReleaseNotes": false,
  // ============================================
  // 🎛️ Python Tracking Enhancements
  // ============================================
  "python.tracking.enabled": true,
  "python.tracking.imports": true,
  "python.tracking.functions": true,
  "python.tracking.classes": true,
  "python.tracking.variables": false,
  "python.tracking.codeLens.enable": false,
  "python.tracking.codeLens.references": false,
  "python.tracking.codeLens.implementations": false,
  "python.tracking.patterns": {
    "imports": "^import\\s+|^from\\s+",
    "functions": "^def\\s+",
    "classes": "^class\\s+",
    "async_functions": "^async\\s+def\\s+",
    "decorators": "^@"
  },
  "workbench.editor.tabActionLocation": "right",
  "accessibility.signals.terminalBell": {

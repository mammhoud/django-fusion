#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# pre-push hook — runs unit tests in changed JS projects before push.
#
# Behavior (controlled by env vars):
#   SKIP_TESTS=1     → skip all tests (emergency bypass)
#   TEST_FULL=1      → run 'npm run test:all' (unit + E2E) instead of
#                       just 'npm run test' (unit tests only)
#   TEST_PROJECTS=""  → force specific projects (space-separated paths)
#
# Examples:
#   git push                          # runs unit tests only
#   TEST_FULL=1 git push              # runs unit + E2E tests
#   SKIP_TESTS=1 git push             # emergency bypass
#   TEST_PROJECTS="lms-fusion/frontend" git push  # only lms-fusion frontend
#
# Install:
#   git config core.hooksPath .githooks
#   chmod +x .githooks/pre-push
#
# Or run: make setup-githooks
# ─────────────────────────────────────────────────────────────────────

set -euo pipefail

# ── Colors ──────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# ── Config ──────────────────────────────────────────────────────────

# Root of the monorepo (where .githooks/ lives)
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Map of project path → display name (parallel arrays for bash 3.2+ compat)
# Only these projects get tested (matches .github/workflows/js-test.yml)
PROJECT_PATHS=(
  "projects/lms-fusion/frontend"
  "projects/cms-fusion/frontend"
  "projects/pos/pos-e2e"
)
PROJECT_NAMES=(
  "LMS Fusion Front-End"
  "CMS Fusion Front-End"
  "POS E2E"
)

# ── Helpers ─────────────────────────────────────────────────────────

say()  { echo -e "${CYAN}[pre-push]${NC} $*"; }
ok()   { echo -e "${GREEN}[pre-push] ✓${NC} $*"; }
warn() { echo -e "${YELLOW}[pre-push] ⚠${NC} $*"; }
fail() { echo -e "${RED}[pre-push] ✗${NC} $*"; }

# ── Bypass check ────────────────────────────────────────────────────

if [[ "${SKIP_TESTS:-}" == "1" ]]; then
  warn "SKIP_TESTS=1 — bypassing all test checks"
  exit 0
fi

# ── Determine which projects to test ─────────────────────────────────

CHANGED_PROJECTS=()

if [[ -n "${TEST_PROJECTS:-}" ]]; then
  # User-specified projects (space-separated)
  for proj in $TEST_PROJECTS; do
    CHANGED_PROJECTS+=("projects/$proj")
  done
else
  # Auto-detect: get list of files being pushed
  while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
      # Branch is being deleted — nothing to push
      exit 0
    fi

    # Get range of commits being pushed
    if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
      # New branch — compare against the merge-base with the target branch
      range="$remote_ref...$local_sha"
    else
      range="$remote_sha..$local_sha"
    fi

    # Get changed files in this push
    if [[ -n "$range" ]]; then
      changed_files=$(git diff --name-only "$range" 2>/dev/null || echo "")
    else
      changed_files=""
    fi

    # Check each project
    for i in "${!PROJECT_PATHS[@]}"; do
      proj_path="${PROJECT_PATHS[$i]}"
      if echo "$changed_files" | grep -q "^$proj_path/"; then
        if [[ ! " ${CHANGED_PROJECTS[*]} " =~ " ${proj_path} " ]]; then
          CHANGED_PROJECTS+=("$proj_path")
        fi
      fi
    done
  done

  # Fallback: if we couldn't determine changes from push range,
  if [[ ${#CHANGED_PROJECTS[@]} -eq 0 ]]; then
    # Get all changed files since last push (or from main)
    changed_files=$(git diff --name-only @{push} 2>/dev/null || git diff --name-only HEAD~5 2>/dev/null || echo "")
    for i in "${!PROJECT_PATHS[@]}"; do
      proj_path="${PROJECT_PATHS[$i]}"
      if echo "$changed_files" | grep -q "^$proj_path/" || [[ -z "$changed_files" ]]; then
        CHANGED_PROJECTS+=("$proj_path")
      fi
    done
  fi
fi

# If no projects changed, skip
if [[ ${#CHANGED_PROJECTS[@]} -eq 0 ]]; then
  ok "No JS project changes detected — skipping tests"
  exit 0
fi

# ── Determine test script ───────────────────────────────────────────

if [[ "${TEST_FULL:-}" == "1" ]]; then
  TEST_SCRIPT="test:all"
  say "Running FULL test suite (unit + E2E) in changed projects..."
else
  TEST_SCRIPT="test"
  say "Running unit tests in changed projects..."
  say "(Use TEST_FULL=1 for unit + E2E, or SKIP_TESTS=1 to bypass)"
fi

# ── Run tests ───────────────────────────────────────────────────────

FAILED=()
PASSED=()

for proj_path in "${CHANGED_PROJECTS[@]}"; do
  proj_name=""
  for i in "${!PROJECT_PATHS[@]}"; do
    if [[ "${PROJECT_PATHS[$i]}" == "$proj_path" ]]; then
      proj_name="${PROJECT_NAMES[$i]}"
      break
    fi
  done
  say "Testing $proj_name ($proj_path)..."

  if [[ ! -d "$REPO_ROOT/$proj_path" ]]; then
    warn "$proj_name: directory not found — skipping"
    continue
  fi

  if [[ ! -f "$REPO_ROOT/$proj_path/package.json" ]]; then
    warn "$proj_name: no package.json — skipping"
    continue
  fi

  # Check if the script exists in package.json
  if ! node -e "const p=require('$REPO_ROOT/$proj_path/package.json'); process.exit(p.scripts && p.scripts['$TEST_SCRIPT'] ? 0 : 1)" 2>/dev/null; then
    warn "$proj_name: no '$TEST_SCRIPT' script — skipping"
    continue
  fi

  # Run the tests
  if (cd "$REPO_ROOT/$proj_path" && npm run --silent "$TEST_SCRIPT" 2>&1); then
    ok "$proj_name: tests passed"
    PASSED+=("$proj_name")
  else
    fail "$proj_name: tests FAILED"
    FAILED+=("$proj_name")
  fi
  echo ""
done

# ── Report ──────────────────────────────────────────────────────────

echo ""
if [[ ${#FAILED[@]} -gt 0 ]]; then
  fail "──────────────────────────────────────────"
  fail "Tests FAILED in: ${FAILED[*]}"
  fail ""
  fail "Push blocked. Options:"
  fail "  1. Fix the failures and try again"
  fail "  2. SKIP_TESTS=1 git push   (emergency bypass)"
  fail "  3. TEST_PROJECTS=\"...\" git push   (test specific project)"
  fail "──────────────────────────────────────────"
  exit 1
fi

if [[ ${#PASSED[@]} -gt 0 ]]; then
  ok "All tests passed: ${PASSED[*]}"
else
  ok "No tests to run"
fi

exit 0

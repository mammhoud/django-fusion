# Tinker Production Environment (.env.production.example)
# ============================================================
# Production-specific configuration template
# Copy to .env.production and fill in real values
# Never commit this file with real secrets
#
# Loaded automatically when TINKER_ENV=production
# See settings.production.yml for environment-specific Django overrides

TINKER_ENV=production
TINKER_DEBUG=false

# IMPORTANT: Generate a strong secret key for production
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
TINKER_SECRET_KEY=your-generated-secret-key-here

# Production domain names
TINKER_ALLOWED_HOSTS=tinker.example.com,www.tinker.example.com

# ============================================================
# PostgreSQL Database (Recommended for Production)
# ============================================================
DB_ENGINE=django.db.backends.postgresql
DB_HOST=your-db-host.example.com
DB_PORT=5432
DB_NAME=tinker_production_db
DB_USER=tinker_prod_user
DB_PASSWORD=very-secure-database-password

# ============================================================
# Email Configuration (SMTP)
# ============================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.your-sendgrid-api-key-here
DEFAULT_FROM_EMAIL=noreply@tinker.example.com

# ============================================================
# AI Models - Production Setup
# ============================================================
# Option 1: Use cloud-based models (Recommended for production)
# Anthropic Claude
ANTHROPIC_API_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=sk-ant-your-production-api-key

# OpenAI GPT
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-production-api-key

# Option 2: Use self-hosted Ollama (if running)
# OLLAMA_BASE_URL=http://ollama-service.internal:11434
# OLLAMA_MODEL=gemma3:4b

# ============================================================
# Security Settings (Production)
# ============================================================
CSRF_COOKIE_SECURE=true
SESSION_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true

# ============================================================
# Gunicorn Configuration (Production)
# ============================================================
TINKER_WORKERS=4

# ============================================================
# Caching (Production - Use Redis)
# ============================================================
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://redis-cache.internal:6379/1
# CACHE_TIMEOUT=3600

# ============================================================
# Logging (Production)
# ============================================================
# Configure log aggregation service if available
# LOG_LEVEL=INFO
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

#!/bin/bash
set -euo pipefail

###############################################################################
# BOOT CONTAINER
###############################################################################
echo "🚀 Django Entrypoint: Booting container..."

# ###############################################################################
# # PERMISSIONS
# ###############################################################################
# echo "📁 Ensuring correct file permissions..."

# if id django &>/dev/null; then
#     chown -R django:django /app || true
# else
#     echo "⚠️ User 'django' not found — skipping permission fixes."
# fi


###############################################################################
# INSTALL uv (if missing)
###############################################################################
if ! command -v uv &>/dev/null; then
    echo "🧩 Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="$HOME/.local/bin:$PATH"
else
    echo "✅ uv already installed: $(uv --version)"
fi

###############################################################################
# DJANGO INITIALIZATION
###############################################################################
if [ "${RUN_SETUP:-false}" = "true" ]; then
    echo "🛠️ Running Django setup..."

    echo "📦 Collecting static files..."
    uv run python com collectstatic --noinput || echo "⚠️ Failed to collect static files."

    echo "🗃️ Applying database migrations..."
    uv run python com migrate --noinput || echo "⚠️ Migrations failed."

    if [ -f "dump-data.json" ]; then
        echo "📥 Loading fixture data from dump-data.json..."
        uv run python -c "
import os, django
os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'configs.settings')
django.setup()
from django.db import connection
from django.core.management import call_command

with connection.cursor() as cursor:
    # Get all FK constraints across all tables
    cursor.execute('''
        SELECT tc.table_name, tc.constraint_name,
               kcu.column_name, ccu.table_name AS ref_table, ccu.column_name AS ref_col
        FROM information_schema.table_constraints AS tc
        JOIN information_schema.key_column_usage AS kcu
            ON tc.constraint_name = kcu.constraint_name
            AND tc.table_schema = kcu.table_schema
        JOIN information_schema.constraint_column_usage AS ccu
            ON ccu.constraint_name = tc.constraint_name
            AND ccu.table_schema = tc.table_schema
        WHERE tc.constraint_type = 'FOREIGN KEY'
        AND tc.table_schema = 'public';
    ''')
    constraints = cursor.fetchall()
    print(f'Found {len(constraints)} FK constraints, disabling...')
    for table, constraint, col, ref_table, ref_col in constraints:
        cursor.execute(f'ALTER TABLE \"{table}\" DROP CONSTRAINT IF EXISTS \"{constraint}\";')

call_command('loaddata', 'dump-data.json', ignorenonexistent=True, verbosity=1)

# Restore all FK constraints
with connection.cursor() as cursor:
    for table, constraint, col, ref_table, ref_col in constraints:
        try:
            cursor.execute(f'''
                ALTER TABLE \"{table}\"
                ADD CONSTRAINT \"{constraint}\"
                FOREIGN KEY (\"{col}\") REFERENCES \"{ref_table}\"(\"{ref_col}\")
                DEFERRABLE INITIALLY DEFERRED;
            ''')
        except Exception as e:
            print(f'Warning: Could not restore {constraint}: {e}')

print('✅ Fixture data loaded successfully.')
" 2>&1 || echo "⚠️ Fixture loading failed."
    fi

    if [ -n "${SUPERUSER_USERNAME:-}" ] && [ -n "${SUPERUSER_PASSWORD:-}" ]; then
        echo "👑 Ensuring superuser exists..."
        uv run python -m django_grep.scripts.superuser
    fi
fi

###############################################################################
# NODE BUILD
###############################################################################
echo "📦 Checking Node.js dependencies..."
if [ -f "package.json" ]; then
    echo "ℹ️ skipping Node build (managed by host or start script)."
else
    echo "ℹ️ No package.json found."
fi

###############################################################################
# START APPLICATION
###############################################################################
echo "🎯 Launching command: $*"
exec "$@"

# ============================================
# 🌐 ENVIRONMENT CONFIGURATION
# ============================================

# Core Environment
SERVER_ENV=demo                           # development, demo, staging, production
RUNNING_ENV=local                         # local, docker, kubernetes, cloud
MODULE=CMS                                # LMS, CMS, ECOMMERCE, CRM

# Django Settings
DEBUG=true
DJANGO_SECRET_KEY=dev-secret-key-change-this-in-production
DATABASE_URL=postgres://postgres:mk_pAssWord123@localhost:5432/db_structa

# Django Superuser (for initial setup)
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@structa.cloud
SUPERUSER_PASSWORD=mk_pAssWord123

# Feature Flags
VAULT_ENABLED_FOR_DYNACONF=false

# Email Configuration (SMTP)
EMAIL_STRATEGY=smtp
EMAIL_USER=admin@structa.cloud
EMAIL_PASSWORD=your-smtp-password-here
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=support@structa.cloud

# Structa Cloud Root Environment Configuration
# Copy this file to .env and fill in your values
# .env is git-ignored and should never be committed

# Django Settings
DJANGO_SETTINGS_MODULE=configs.settings.local
DEBUG=True
ENVIRONMENT=development

# Database (see compose/config/secrets.yml for passwords)
DB_ENGINE=django.db.backends.postgresql
# NOTE: legacy `DB_NAME=structa_cloud` removed. Per-site compose files
# and the shared task stack read DB_NAME_CTC / DB_NAME_LMS /
# DB_NAME_VRESUME / DB_NAME_CRM keys below.
DB_USER=postgres
DB_HOST=postgres
DB_PORT=5432
# DB_PASSWORD is stored in compose/config/secrets.yml

# Postgres credentials used by the per-site compose files and the shared
# task stack. Sites do NOT inline weak defaults for these values — missing
# .env entries cause loud failures in CI.
POSTGRES_USER=admin
POSTGRES_PASSWORD=postgres

# Per-site Postgres DB names. Each site's compose file reads the matching
# key (DB_NAME_CTC in `core/ctc-research/docker-compose.yml`, DB_NAME_LMS
# in `core/lms/docker-compose.yml`, DB_NAME_VRESUME in
# `core/VResume/docker-compose.yml`). Shared task stack reads DB_NAME
# directly (no `db_*` fallback; see tasks compose comments). Adding a new
# site requires: 1) adding a DB_NAME_<SITE> key here, 2) wiring the new
# compose file, 3) extending `core/cli.py:SITES`.
DB_NAME_CTC=db_ctc
DB_NAME_LMS=db_structa
DB_NAME_VRESUME=vresume
# CRM is referenced by `core/cli.py` (`SITES["crm"]`) but is not in this
# repository yet — declared so dev tooling can validate before/after CRM
# lands.
DB_NAME_CRM=db_crm

# Redis
REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD is stored in compose/config/secrets.yml

# Django Secret
# SECRET_KEY is stored in compose/config/secrets.yml

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False

# SMTP Configuration for POS-KO / Structa Cloud
SMTP_SERVER=smtp.gmail.com
SMTP_USERNAME=structa.cloud@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_RECIPIENT='Team <structa.cloud@gmail.com>'

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,*.structa.cloud

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# API Configuration
API_DEBUG=True
API_LOG_LEVEL=DEBUG

# Feature Flags
FEATURE_AI_ENABLED=False
FEATURE_MCP_SERVER=False

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# django-fusion Webpack Workspace
# Set to a workspace name from libs/django-fusion/webpack/workspaces/
# Or set FUSION_WEBPACK_WORKSPACE_PATH to a custom workspace config file
FUSION_WEBPACK_WORKSPACE=default

# File Storage
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

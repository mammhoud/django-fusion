# Structa Cloud Root Environment Configuration
# Copy this file to .env and fill in your values
# .env is git-ignored and should never be committed

# Django Settings
DJANGO_SETTINGS_MODULE=configs.settings.local
DEBUG=True
ENVIRONMENT=development

# Database (see compose/config/secrets.yml for passwords)
DB_ENGINE=django.db.backends.postgresql
# NOTE: legacy `DB_NAME=structa_cloud` removed. Per-site compose files
# and the shared task stack read DB_NAME_CTC / DB_NAME_LMS /
# DB_NAME_VRESUME / DB_NAME_CRM keys below.
DB_USER=postgres
DB_HOST=postgres
DB_PORT=5432
# DB_PASSWORD is stored in compose/config/secrets.yml

# Postgres credentials used by the per-site compose files and the shared
# task stack. Sites do NOT inline weak defaults for these values — missing
# .env entries cause loud failures in CI.
# Generated RANDOM defaults ship in application/databases/.env.example
# (copy with `make -C application/databases setup`); override them here.
POSTGRES_USER=admin
POSTGRES_PASSWORD=<generate-a-unique-secret>

# Shared Postgres container (application/databases/docker-compose.yml).
POSTGRES_DB=app_db
POSTGRES_PORT=5432

# Multiple databases created by the postgres init entrypoint
# (format: db:owner:password,db:owner:password,...). Set this to keep every
# credential in .env instead of the compose fallback. Affine's password is
# required and shared with application/proxy.
POSTGRES_DATABASES=db_precis_lms:structa:<password>,db_precis_ctc:structa:<password>,db_vresume:structa:<password>,coder:coder:<password>,db_loop_crm:structa:<password>,db_precis_landing:structa:<password>,affine:affine:<password>

# Coder control-plane database role (application/docker-compose.yml).
CODER_DB_USER=coder
CODER_DB_NAME=coder
CODER_DB_PASSWORD=<generate-a-unique-secret>

# Per-site Postgres DB names. Each site's compose file reads the matching
# key (DB_NAME_LANDING in `projects/structa.cloud/docker-compose.yml`,
# DB_NAME_CTC in `projects/precis/precis-ctc`, DB_NAME_CRM in loop-crm, ...).
# The shared task stack reads DB_NAME directly (see tasks compose comments).
# Adding a new site requires: 1) adding a DB_NAME_<SITE> key here, 2) wiring
# the new compose file, 3) extending `projects/cli.py:SITES`.
DB_NAME_LANDING=db_precis_landing
DB_NAME_CTC=db_ctc
DB_NAME_LMS=db_structa
DB_NAME_VRESUME=vresume
# CRM is referenced by `projects/cli.py` (`SITES["crm"]`) but is not in this
# repository yet — declared so dev tooling can validate before/after CRM
# lands.
DB_NAME_CRM=db_crm

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=<generate-a-unique-secret>

# Shared AFFiNE database role (required by application/tools/affine)
AFFINE_DB_PASSWORD=<generate-a-unique-secret>

# ── Self-hosted tools (application/tools/) ─────────────────────────────
# Canonical tools env: application/tools/.env.example (covers all tool
# composes, incl. commented-out ones). The values below mirror it as the
# repo-root fallback for existing deployments.
# Ollama + Open WebUI
OLLAMA_VERSION=latest
OLLAMA_PORT=11434
OPEN_WEBUI_VERSION=main
OPEN_WEBUI_SECRET_KEY=<generate-a-unique-secret>
# Adminer
ADMINER_VERSION=latest
ADMINER_DESIGN=hydra
# Mailpit
MAILPIT_VERSION=latest
MAILPIT_SMTP_PORT=1025
# Monitoring (Prometheus + Grafana)
PROMETHEUS_VERSION=latest
GRAFANA_VERSION=latest
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<generate-a-unique-secret>

# Django Secret
# SECRET_KEY is stored in compose/config/secrets.yml

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False

# SMTP Configuration for POS-KO / Structa Cloud
SMTP_SERVER=smtp.gmail.com
SMTP_USERNAME=structa.cloud@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_RECIPIENT='Team <structa.cloud@gmail.com>'

# Allowed Hosts (tools.structa.cloud routes the self-hosted tools)
ALLOWED_HOSTS=localhost,127.0.0.1,*.structa.cloud,tools.structa.cloud

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# API Configuration
API_DEBUG=True
API_LOG_LEVEL=DEBUG

# Feature Flags
FEATURE_AI_ENABLED=False
FEATURE_MCP_SERVER=False

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# django-fusion Webpack Workspace
# Set to a workspace name from libs/django-fusion/webpack/workspaces/
# Or set FUSION_WEBPACK_WORKSPACE_PATH to a custom workspace config file
FUSION_WEBPACK_WORKSPACE=default

# File Storage
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

# ── Django superuser (shared by all site containers) ──────────────────
# Read by `createsuperuser --noinput` and the per-site Makefile targets.
# All Django sites (precis-ctc, precis-dev, structa.cloud [precis-main], syntara, loop-crm)
# share these credentials; generate a unique secret per environment.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@structa.cloud
DJANGO_SUPERUSER_PASSWORD=<generate-a-unique-secret>

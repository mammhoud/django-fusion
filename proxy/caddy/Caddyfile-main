# Caddyfile – basic reverse proxy configuration for Coolify

# Global options block (optional)
{
    # Email used for Let's Encrypt certificates
    email admin@coolify.local
    # ACME CA (default Let's Encrypt production)
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# HTTP to HTTPS redirect
http:// {
    redir https://{host}{uri} permanent
}

# Main site proxy (replace with your actual domain names)
https://* {
    # Proxy to the appropriate backend service based on hostname
    @coolify host coolify.local www.coolify.local
    reverse_proxy @coolify coolify:80

    # Fallback static file serving (optional)
    file_server
}

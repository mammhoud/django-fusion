#!/usr/bin/env bash

### Remove database backups.
###
### Parameters:
###     <1> filename or pattern of backup(s) to remove
###     --database <name>  Remove all backups for specific database
###     --older-than <days> Remove backups older than specified days
###     --dry-run        Show what would be removed without actually removing
###
### Usage:
###     $ docker compose -f <environment>.yml (exec |run --rm) postgres rmbackup backup_file.sql.gz
###     $ docker compose -f <environment>.yml (exec |run --rm) postgres rmbackup --database db_staging
###     $ docker compose -f <environment>.yml (exec |run --rm) postgres rmbackup --older-than 7 --dry-run

set -o errexit
set -o pipefail
set -o nounset

working_dir="$(dirname ${0})"
source "${working_dir}/_sourced/constants.sh"
source "${working_dir}/_sourced/messages.sh"

# Parse command line arguments
REMOVE_PATTERN=""
REMOVE_DB=""
OLDER_THAN=0
DRY_RUN=false
POSITIONAL_ARGS=()

while [[ $# -gt 0 ]]; do
    case $1 in
        --database)
            REMOVE_DB="$2"
            shift 2
            ;;
        --older-than)
            OLDER_THAN="$2"
            shift 2
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        -*)
            message_error "Unknown option: $1"
            echo "Usage: rmbackup [--database <name>] [--older-than <days>] [--dry-run] [pattern]"
            exit 1
            ;;
        *)
            POSITIONAL_ARGS+=("$1")
            shift
            ;;
    esac
done

set -- "${POSITIONAL_ARGS[@]}"

# Get remove pattern
if [ -n "${1:-}" ]; then
    REMOVE_PATTERN="$1"
fi

if [ -z "$REMOVE_PATTERN" ] && [ -z "$REMOVE_DB" ] && [ "$OLDER_THAN" -eq 0 ]; then
    message_error "No removal criteria specified. Please provide a filename, database name, or age threshold."
    echo "Usage: rmbackup [--database <name>] [--older-than <days>] [--dry-run] [pattern]"
    exit 1
fi

# Build find command
FIND_CMD="find \"$BACKUP_DIR_PATH\" -name \"*.sql.gz\""

if [ -n "$REMOVE_DB" ]; then
    FIND_CMD="$FIND_CMD -name \"${REMOVE_DB}_*.sql.gz\""
elif [ -n "$REMOVE_PATTERN" ]; then
    # Check if pattern is a full filename or partial
    if [[ "$REMOVE_PATTERN" == *.sql.gz ]]; then
        FIND_CMD="$FIND_CMD -name \"$REMOVE_PATTERN\""
    else
        FIND_CMD="$FIND_CMD -name \"*${REMOVE_PATTERN}*\""
    fi
fi

if [ "$OLDER_THAN" -gt 0 ]; then
    FIND_CMD="$FIND_CMD -mtime +$OLDER_THAN"
fi

# Execute find command
files_to_remove=()
while IFS= read -r -d '' file; do
    files_to_remove+=("$file")
done < <(eval "$FIND_CMD -print0 2>/dev/null")

if [ ${#files_to_remove[@]} -eq 0 ]; then
    if [ -n "$REMOVE_DB" ]; then
        message_info "No backups found for database '$REMOVE_DB'"
    elif [ "$OLDER_THAN" -gt 0 ]; then
        message_info "No backups older than $OLDER_THAN days found"
    else
        message_info "No backups matching pattern '$REMOVE_PATTERN' found"
    fi
    exit 0
fi

# Show what will be removed
if [ "$DRY_RUN" = true ]; then
    message_welcome "DRY RUN - The following backups would be removed:"
    total_size=0
    for file in "${files_to_remove[@]}"; do
        size=$(du -h "$file" | cut -f1)
        echo "  $(basename "$file") (${size})"
        total_size=$(($total_size + $(stat -c%s "$file")))
    done
    echo -e "\nTotal: ${#files_to_remove[@]} file(s), $(numfmt --to=iec --suffix=B $total_size)"
    exit 0
fi

# Confirm removal
message_welcome "The following backups will be removed:"
for file in "${files_to_remove[@]}"; do
    echo "  $(basename "$file")"
done

if [ ${#files_to_remove[@]} -gt 5 ]; then
    read -p "Remove ${#files_to_remove[@]} backups? [y/N] " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        message_info "Operation cancelled."
        exit 0
    fi
else
    read -p "Continue? [y/N] " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        message_info "Operation cancelled."
        exit 0
    fi
fi

# Remove files
removed_count=0
for file in "${files_to_remove[@]}"; do
    if rm "$file"; then
        message_success "Removed: $(basename "$file")"
        removed_count=$((removed_count + 1))
    else
        message_error "Failed to remove: $(basename "$file")"
    fi
done

message_success "Successfully removed $removed_count backup file(s)"
# ============================================
# 🧪 CTC Research — Demo Docker environment
# Copy to .env on a demo host and replace all change-me values.
# ============================================
SERVER_ENV=demo
RUNNING_ENV=docker
MODULE=LMS
DJANGO_WEBSITE=ctc-research
WEBSITE=ctc-research
WEBSITE_NAME=ctc-research
DJANGO_SETTINGS_MODULE=settings

DEBUG=false
DJANGO_SECRET_KEY=change-me-demo-secret
HOST=0.0.0.0
PORT=5070
SITE_DOMAIN=ctc-research.com
DOMAIN_NAME=ctc-research.com
SSL_ENABLED=false
ALLOWED_HOSTS=ctc-research.com,www.ctc-research.com,arch.ctc-research.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://ctc-research.com,https://ctc-research.com,http://www.ctc-research.com,https://www.ctc-research.com,http://arch.ctc-research.com,https://arch.ctc-research.com
CORS_ALLOWED_ORIGINS=http://ctc-research.com,https://ctc-research.com,http://www.ctc-research.com,https://www.ctc-research.com,http://arch.ctc-research.com,https://arch.ctc-research.com

DB_ENGINE=django.db.backends.postgresql
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=db_ctc_demo
DB_USER=postgres
DB_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/3
CELERY_BROKER_URL=redis://:change-me@redis:6379/4
CELERY_RESULT_BACKEND=redis://:change-me@redis:6379/4

EMAIL_STRATEGY=mailtrap
MAILTRAP_HOST=smtp.mailtrap.io
MAILTRAP_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
DEFAULT_FROM_EMAIL=demo@ctc-research.com

SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@ctc-research.com
SUPERUSER_PASSWORD=change-me

RUN_SETUP=true
LOAD_FIXTURES=false
FORCE_LOAD_DUMPS=false
STRICT_PAGE_CONTENT=false
VAULT_ENABLED_FOR_DYNACONF=false

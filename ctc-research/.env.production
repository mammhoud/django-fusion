# ============================================
# 🚀 CTC Research — Production Docker environment
# Copy to .env on the production host and replace all change-me values.
# Do not commit real secrets or provider tokens.
# ============================================
SERVER_ENV=production
RUNNING_ENV=docker
MODULE=LMS
DJANGO_WEBSITE=ctc-research
WEBSITE=ctc-research
WEBSITE_NAME=ctc-research
DJANGO_SETTINGS_MODULE=settings

DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
HOST=0.0.0.0
PORT=5070
SITE_DOMAIN=ctc-research.com
DOMAIN_NAME=ctc-research.com
SSL_ENABLED=false
ALLOWED_HOSTS=ctc-research.com,www.ctc-research.com,arch.ctc-research.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://ctc-research.com,https://www.ctc-research.com,https://arch.ctc-research.com
CORS_ALLOWED_ORIGINS=https://ctc-research.com,https://www.ctc-research.com,https://arch.ctc-research.com

DB_ENGINE=django.db.backends.postgresql
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=db_ctc
DB_USER=postgres
DB_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/3
CELERY_BROKER_URL=redis://:change-me@redis:6379/4
CELERY_RESULT_BACKEND=redis://:change-me@redis:6379/4

EMAIL_STRATEGY=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USER=
EMAIL_PASSWORD=
DEFAULT_FROM_EMAIL=admin@ctc-research.com
REPORT_EMAIL_FROM=admin@ctc-research.com
REPORT_EMAIL_TO=admin@ctc-research.com
EMAILS_CSV_PATH=../emails.csv

GIT_REPO=ctc-website
GIT_USERNAME=
GIT_EMAIL=admin@example.com
GIT_TOKEN=
ADMIN_EMAIL=admin@example.com
DEMO_CONTAINER=django-demo
MAIN_CONTAINER=django-main
DEMO_BRANCH=dev
MAIN_BRANCH=main

SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@ctc-research.com
SUPERUSER_PASSWORD=change-me

RUN_SETUP=true
LOAD_FIXTURES=false
FORCE_LOAD_DUMPS=false
STRICT_PAGE_CONTENT=true
VAULT_ENABLED_FOR_DYNACONF=false

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

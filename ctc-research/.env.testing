# ============================================
# 🧪 TESTING ENVIRONMENT CONFIGURATION
# ============================================

# Core Environment
SERVER_ENV=testing
RUNNING_ENV=docker
MODULE=LMS

# Django Settings
DEBUG=true
DJANGO_SECRET_KEY=test-secret-key-for-testing-only

# Database Configuration - Test PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=db_ctc_test
DB_USER=postgres
DB_PASSWORD=change-me

# Security Settings
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Git Configuration
GIT_REPO=ctc-website
GIT_USERNAME=test_user
GIT_EMAIL=test@example.com
ADMIN_EMAIL=test@example.com

# Docker/Branch Configuration
DEMO_CONTAINER=django-demo
MAIN_CONTAINER=django-main
DEMO_BRANCH=dev
MAIN_BRANCH=main

# Django Superuser for testing
SUPERUSER_USERNAME=testadmin
SUPERUSER_EMAIL=testadmin@example.com
SUPERUSER_PASSWORD=testpassword123

# Feature Flags
VAULT_ENABLED_FOR_DYNACONF=false

# Email Configuration (Test)
EMAIL_STRATEGY=console
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=test@example.com

# Test-specific settings
TEST_RUNNER=django.test.runner.DiscoverRunner
TESTING=true

# ============================================
# 🧑‍💻 CTC Research — Development environment
# Copy to .env for local development or run with SERVER_ENV=development.
# ============================================
SERVER_ENV=development
RUNNING_ENV=local
MODULE=LMS
DJANGO_WEBSITE=ctc-research
WEBSITE=ctc-research
WEBSITE_NAME=ctc-research
DJANGO_SETTINGS_MODULE=settings

DEBUG=true
DJANGO_SECRET_KEY=dev-secret-key-change-me
HOST=0.0.0.0
PORT=5070
SITE_DOMAIN=localhost
DOMAIN_NAME=localhost
SSL_ENABLED=false
ALLOWED_HOSTS=localhost,127.0.0.1,ctc-research.com,www.ctc-research.com
CSRF_TRUSTED_ORIGINS=http://localhost:5070,http://127.0.0.1:5070,http://ctc-research.com,https://ctc-research.com
CORS_ALLOWED_ORIGINS=http://localhost:5070,http://127.0.0.1:5070,http://ctc-research.com,https://ctc-research.com

# Development uses SQLite unless DB_TYPE=postgres is set.
DB_TYPE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/3
CELERY_BROKER_URL=redis://localhost:6379/4
CELERY_RESULT_BACKEND=redis://localhost:6379/4

EMAIL_STRATEGY=console
DEFAULT_FROM_EMAIL=dev@ctc-research.com

SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@ctc-research.com
SUPERUSER_PASSWORD=change-me

RUN_SETUP=false
LOAD_FIXTURES=false
FORCE_LOAD_DUMPS=false
STRICT_PAGE_CONTENT=false
VAULT_ENABLED_FOR_DYNACONF=false

# django-fusion — library repository.
#
# Scope is the library only: no monorepo, no product tree, no services. Anything
# a consumer app generates (collectstatic output, its own logs, its own secrets)
# belongs in that consumer's .gitignore, not here.

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
eggs/
build/
dist/
sdist/
wheels/
develop-eggs/
downloads/
*.egg
.installed.cfg

# ── Virtual environments ──────────────────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── Testing ───────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/
*.orig

# ── Linting and type checking ─────────────────────────────────────────────
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
logs/

# ── Secrets and environment ───────────────────────────────────────────────
# Real configuration lives in the consuming project; the library ships only
# templates such as env.example.
.env
.env.local
*.env.backup*
secrets.yml

# ── Django-Webpack-Loader ─────────────────────────────────────────────────
# The library reads webpack-stats.json at runtime (see
# django_fusion.core.assets.component_map), but the file is always generated by
# the consumer's build.
node_modules/
static/bundles/*.js
static/bundles/*.css
static/bundles/*.map
static/bundles/fonts/
static/bundles/images/
!static/bundles/.gitkeep

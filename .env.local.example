# Local Development Environment Override
# Copy to .env.local for local development settings
# .env.local is git-ignored and takes precedence over .env

# Local Development Settings
DEBUG=True
ENVIRONMENT=development
RUNNING_ENV=docker

# Local Database (using compose services)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=structa_cloud_dev
DB_USER=postgres
# DB_PASSWORD comes from compose/config/secrets.yml

# Local Redis
REDIS_URL=redis://redis:6379/0

# Local Email (mailhog or console backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Local Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,*.local

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Logging
LOG_LEVEL=DEBUG
SENTRY_DSN=

# Feature Flags - Enable for development
FEATURE_AI_ENABLED=True
FEATURE_MCP_SERVER=True
FEATURE_DEBUG_TOOLBAR=True

# Wagtail Settings
WAGTAIL_ENABLE_UPDATE_CHECK=False

# Performance
CACHES_BACKEND=django.core.cache.backends.redis.RedisCache

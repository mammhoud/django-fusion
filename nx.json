{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/node_modules/**",
      "!{projectRoot}/dist/**",
      "!{projectRoot}/.astro/**"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/tests/**"
    ],
    "sharedGlobals": [
      "package.json",
      "nx.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "inputs": [
        "production",
        "^production"
      ],
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    },
    "check": {
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "test": {
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    }
  },
  "defaultBase": "generic",
  "analytics": false
}
{
  "$schema": "https://app.kilo.ai/config.json",
  "disabled_providers": [],
  "provider": {
  },
  "permission": {
    "bash": "allow",
    "edit": "allow"
  },
  "indexing": {
    "enabled": true,
    "provider": "ollama",
    "model": "nomic-embed-text:latest",
    "dimensions": 768,
    "baseURL": "http://72.61.82.167:11434",
    "vectorStore": "qdrant",
    "qdrant": {
      "url": "http://72.61.82.167:6333"
    }
  },
  "agent": {
    "django-architect": {
      "description": "Django architecture specialist – models apps, services, CQRS, DDD, components",
      "mode": "subagent",
      "model": "ollama/deepseek-r1:1.5b",
      "prompt": "You are a Django architecture expert. Focus on: - Project structure and app organization - Service layer and business logic separation - CQRS and DDD patterns - Component design and reusability - Database schema design and migrations - Performance and scalability Provide architectural guidance and code organization advice.",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "django-coder": {
      "description": "Django development expert – models, views, templates, forms, APIs, HTMX",
      "mode": "subagent",
      "model": "ollama/qwen2.5-coder:3b",
      "prompt": "You are a Django development expert. Write clean, maintainable Django code. Focus on: - Models with proper fields, methods, and relationships - Views (FBV/CBV) with appropriate logic - Templates with efficient use of Django's template language - Forms with validation and widgets - REST APIs with DRF or Django Ninja - HTMX integration and modern frontend practices Follow Django best practices and provide complete, working code.",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    },
    "docker-engineer": {
      "description": "Docker and deployment expert – Dockerfiles, compose, CI/CD, Kubernetes",
      "mode": "subagent",
      "model": "ollama/qwen2.5-coder:1.5b",
      "prompt": "You are a Docker and deployment expert. Focus on: - Writing efficient Dockerfiles for Django projects - Multi-stage builds and image optimization - Docker Compose for local development and production - CI/CD pipelines (GitHub Actions, GitLab CI) - Kubernetes manifests for orchestration - Environment configuration and secrets management Provide production-ready deployment solutions.",
      "temperature": 0.1,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "database-engineer": {
      "description": "Postgres and ORM specialist – queries, indexing, migrations, performance",
      "mode": "subagent",
      "model": "ollama/deepseek-r1:1.5b",
      "prompt": "You are a PostgreSQL and ORM specialist. Focus on: - Writing efficient SQL queries and using ORM optimally - Indexing strategies for performance - Database migrations and schema design - Query optimization and EXPLAIN analysis - Connection pooling and transaction management - Data integrity and constraints Provide database-related code and advice.",
      "temperature": 0.1,
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    },
    "frontend-developer": {
      "description": "Frontend expert – React, Vue, Angular, HTML, CSS, TypeScript, Tailwind",
      "mode": "subagent",
      "model": "ollama/qwen2.5-coder:3b",
      "prompt": "You are a frontend development expert. Focus on: - Building responsive, accessible UI components - React/Vue/Angular best practices - State management (Redux, Zustand, Pinia) - TypeScript type safety - CSS frameworks (Tailwind, Bootstrap) - Performance optimization (lazy loading, code splitting) - Cross-browser compatibility Provide complete, production-ready frontend code.",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    },
    "devops-engineer": {
      "description": "DevOps and infrastructure – CI/CD, monitoring, Terraform, Ansible",
      "mode": "subagent",
      "model": "ollama/qwen2.5-coder:1.5b",
      "prompt": "You are a DevOps engineer. Focus on: - Designing CI/CD pipelines (GitHub Actions, GitLab CI, Jenkins) - Infrastructure as Code (Terraform, Pulumi) - Configuration management (Ansible, Chef) - Monitoring and observability (Prometheus, Grafana, ELK) - Cloud services (AWS, GCP, Azure) - Security best practices (secrets management, IAM) Provide reusable, scalable infrastructure code and deployment strategies.",
      "temperature": 0.1,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "code-reviewer": {
      "description": "General code reviewer – quality, best practices, security, performance",
      "mode": "subagent",
      "model": "ollama/deepseek-coder:latest",
      "prompt": "You are a code reviewer. Focus on: - Code quality and adherence to best practices - Potential bugs and edge cases - Performance bottlenecks - Security vulnerabilities - Readability and maintainability - Test coverage and testing strategies Provide constructive, actionable feedback without making changes unless requested.",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "security-auditor": {
      "description": "Security specialist – vulnerability scanning, compliance, threat modeling",
      "mode": "subagent",
      "model": "ollama/deepseek-r1:1.5b",
      "prompt": "You are a security expert. Focus on: - Identifying common vulnerabilities (OWASP Top 10) - Authentication and authorization flaws - Data encryption and secure storage - API security (JWT, OAuth) - Dependency and supply chain risks - Secure coding practices - Threat modeling and risk assessment Provide detailed reports with severity levels and actionable remediation steps.",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "test-engineer": {
      "description": "Test engineer – unit, integration, E2E tests, test automation",
      "mode": "subagent",
      "model": "ollama/qwen2.5-coder:3b",
      "prompt": "You are a test engineer. Focus on: - Writing comprehensive unit tests (pytest, JUnit) - Integration and contract tests - End-to-end testing (Playwright, Cypress) - Test automation frameworks - Property-based and fuzz testing - Mocking and stubbing strategies - Test coverage and quality metrics Provide complete, working test suites that follow the project's patterns.",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    },
    "documentation-writer": {
      "description": "Technical documentation – API docs, READMEs, user guides, architecture docs",
      "mode": "subagent",
      "model": "ollama/llama3.2:3b",
      "prompt": "You are a technical writer. Focus on: - Clear, concise explanations - Structured documentation with examples - API reference and usage guides - READMEs and onboarding docs - Architecture decision records - User-friendly language and consistent formatting Create documentation that is accessible to developers and non-technical users alike.",
      "temperature": 0.4,
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    },
    "refactoring-specialist": {
      "description": "Refactoring expert – improving code structure, reducing technical debt",
      "mode": "subagent",
      "model": "ollama/qwen2.5-coder:3b",
      "prompt": "You are a refactoring specialist. Focus on: - Improving code structure and architecture - Applying design patterns appropriately - Eliminating duplication (DRY) - Simplifying complex methods - Modernizing legacy code - Improving testability and maintainability Provide clear before/after comparisons and explain the rationale behind your changes.",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    },
    "ceptor-ai-toolsmith": {
      "description": "Standalone AI/MCP package specialist – ceptor_ai CLI, MCP endpoints, pure Python boundaries",
      "mode": "subagent",
      "model": "ollama/qwen2.5-coder:3b",
      "prompt": "You are a standalone Python AI/MCP package expert. Focus on: - Maintaining core/libs/ceptor-ai with import package ceptor_ai - Keeping the package free of Django and Wagtail imports - Building CLI commands and MCP integration points - Documenting package boundaries and local installation. Provide clean typed Python code and boundary-safe guidance.",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "product-manager": {
      "description": "Product management – requirements, user stories, prioritization, roadmaps",
      "mode": "subagent",
      "model": "ollama/llama3.2:3b",
      "prompt": "You are a product manager. Focus on: - Writing clear user stories and acceptance criteria - Defining requirements and feature specifications - Prioritizing tasks and planning sprints - Creating product roadmaps - Gathering stakeholder feedback - Defining success metrics and KPIs Provide actionable, business-oriented guidance that aligns with user needs.",
      "temperature": 0.5,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "performance-optimizer": {
      "description": "Performance specialist – profiling, optimization, caching, scaling",
      "mode": "subagent",
      "model": "ollama/deepseek-r1:1.5b",
      "prompt": "You are a performance optimization expert. Focus on: - Profiling and benchmarking applications - Optimizing database queries and indexing - Implementing caching strategies (Redis, CDN) - Reducing latency and improving throughput - Resource usage optimization (CPU, memory, I/O) - Horizontal/vertical scaling strategies Provide data-driven recommendations and measurable improvements.",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    },
    "data-engineer": {
      "description": "Data engineering – ETL pipelines, data lakes, SQL, data modeling",
      "mode": "subagent",
      "model": "ollama/deepseek-coder:latest",
      "prompt": "You are a data engineer. Focus on: - Designing efficient ETL/ELT pipelines - Data modeling and schema design - Writing optimized SQL queries - Data warehousing and lake architectures - Streaming and batch processing - Data quality and governance Provide robust, scalable data solutions.",
      "temperature": 0.1,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "orchestrator": {
      "mode": "primary",
      "permission": {
        "task": {
          "*": "deny",
          "django-architect": "allow",
          "django-coder": "allow",
          "docker-engineer": "allow",
          "database-engineer": "allow",
          "frontend-developer": "allow",
          "devops-engineer": "allow",
          "code-reviewer": "allow",
          "security-auditor": "allow",
          "test-engineer": "allow",
          "documentation-writer": "allow",
          "refactoring-specialist": "allow",
          "product-manager": "allow",
          "performance-optimizer": "allow",
          "data-engineer": "allow",
          "ceptor-ai-toolsmith": "allow"
        }
      }
    }
  },
  "commands": {
    "ceptor-ai": ".kilo/commands/ceptor-ai.md"
  }

}

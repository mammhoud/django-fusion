      "code": "UPCOMING",
      "name": "Upcoming",
      "calculation_logic": "if due_date > today and status != 'COMPLETED'",
      "priority": 1
    }
  },
  {
    "model": "modules.derivedstatus",
    "pk": 2,
    "fields": {
      "code": "DUE_TODAY",
      "name": "Due Today",
      "calculation_logic": "if due_date == today and status != 'COMPLETED'",
      "priority": 2
    }
  },
  {
    "model": "modules.derivedstatus",
    "pk": 3,
    "fields": {
      "code": "OVERDUE",
      "name": "Overdue",
      "calculation_logic": "if due_date < today and status != 'COMPLETED'",
      "priority": 3
    }
  },
  {
    "model": "modules.derivedstatus",
    "pk": 4,
    "fields": {
      "code": "COMPLETED_ON_TIME",
      "name": "Completed On Time",
      "calculation_logic": "if completion_date <= due_date and status == 'COMPLETED'",
      "priority": 4
    }
  },
  {
    "model": "modules.derivedstatus",
    "pk": 5,
    "fields": {
      "code": "COMPLETED_LATE",
      "name": "Completed Late",
      "calculation_logic": "if completion_date > due_date and status == 'COMPLETED'",
      "priority": 5
    }
  },
  {
    "model": "modules.derivedstatus",
    "pk": 6,
    "fields": {
      "code": "NOT_STARTED",
      "name": "Not Started",
      "calculation_logic": "if status == 'SCHEDULED' and progress == 0",
      "priority": 6
    }
  },
  {
    "model": "modules.derivedstatus",
    "pk": 7,
    "fields": {
      "code": "IN_REVIEW",
      "name": "In Review",
      "calculation_logic": "if status == 'IN_PROGRESS' and review_required == true",
      "priority": 7
    }
  },
  {
    "model": "modules.derivedstatus",
    "pk": 8,
    "fields": {
      "code": "ACTION_REQUIRED",
      "name": "Action Required",
      "calculation_logic": "if requires_attention == true",
      "priority": 8
    }
  },
  {
    "model": "modules.derivedstatus",
    "pk": 9,
    "fields": {
      "code": "FOLLOW_UP_NEEDED",
      "name": "Follow Up Needed",

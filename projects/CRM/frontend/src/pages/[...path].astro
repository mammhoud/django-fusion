---
import Layout from '@/layouts/Layout.astro';
import AppShell from '@/components/AppShell.astro';
import PipelineBoard from '@/components/board/PipelineBoard';
import AiHub from '@/components/dashboard/AiHub';
import WorkspaceControls from '@/components/dashboard/WorkspaceControls';
import BillingPlan from '@/components/dashboard/BillingPlan';
import ReportCatalog from '@/components/dashboard/ReportCatalog';
import EmployeeDirectory from '@/components/dashboard/EmployeeDirectory';
import CommandPalette from '@/components/dashboard/CommandPalette';
import OnboardingTour from '@/components/dashboard/OnboardingTour';
import RevOpsDashboard from '@/components/dashboard/RevOpsDashboard';
import ResourceTable from '@/components/dashboard/ResourceTable';
import ContentCalendar from '@/components/dashboard/ContentCalendar';
import PipelineManager from '@/components/dashboard/PipelineManager';
import ModuleOverview from '@/components/dashboard/ModuleOverview';

export function getStaticPaths() {
  // Declared inside getStaticPaths: Astro hoists this function above the
  // frontmatter, so module-level constants are unreachable (and dropped)
  // here. The route catalog must live in this scope (or an imported module).
  // `/` is owned by the public marketing landing (src/pages/index.astro);
  // the app shell covers every authenticated workspace surface.
  const pages = [
    { path: '/overview/', title: 'Overview', kicker: 'RevOps', description: 'Revenue, publishing, and attribution at a glance.', module: 'overview' },
    { path: '/crm/', title: 'CRM', kicker: 'Sales', description: 'The relationship graph and pipeline operating system.', module: 'crm' },
    { path: '/crm/companies/', title: 'Companies', kicker: 'CRM · companies', description: 'Accounts, ownership, firmographics, and custom attributes.', module: 'crm' },
    { path: '/crm/contacts/', title: 'Contacts', kicker: 'CRM · contacts', description: 'People, roles, communication history, and account relationships.', module: 'crm' },
    { path: '/crm/pipelines/', title: 'Pipelines', kicker: 'CRM · pipelines', description: 'Configurable stages, probabilities, and forecasting views.', module: 'crm' },
    { path: '/crm/deals/', title: 'Deals', kicker: 'CRM · deals', description: 'Revenue opportunities connected to campaigns and touchpoints.', module: 'crm' },
    { path: '/crm/activities/', title: 'Activities', kicker: 'CRM · activities', description: 'Calls, emails, meetings, notes, tasks, and social interactions.', module: 'crm' },
    { path: '/marketing/', title: 'Marketing', kicker: 'Growth', description: 'Plan, approve, publish, and measure every channel from one calendar.', module: 'marketing' },
    { path: '/marketing/calendar/', title: 'Content calendar', kicker: 'Marketing · calendar', description: 'A visual queue for drafts, approvals, scheduled posts, and retries.', module: 'marketing' },
    { path: '/marketing/campaigns/', title: 'Campaigns', kicker: 'Marketing · campaigns', description: 'Group content, spend, performance, and influenced deals.', module: 'marketing' },
    { path: '/marketing/channels/', title: 'Channels', kicker: 'Marketing · channels', description: 'Connect provider accounts and see their publish and analytics capabilities.', module: 'marketing' },
    { path: '/marketing/media/', title: 'Media library', kicker: 'Marketing · media', description: 'Reusable image and video assets with alt text and post attachments.', module: 'marketing' },
    { path: '/marketing/approvals/', title: 'Approvals', kicker: 'Marketing · approvals', description: 'Review pending post approvals with the full moderation trail.', module: 'marketing' },
    { path: '/finance/', title: 'Finance', kicker: 'Finance · revenue control', description: 'Turn closed pipeline into invoices, payments, and recognized revenue without losing campaign context.', module: 'finance' },
    { path: '/finance/invoices/', title: 'Invoices', kicker: 'Finance · invoices', description: 'Issue customer invoices from real companies and deals, then keep payment state current.', module: 'finance' },
    { path: '/finance/payments/', title: 'Payments', kicker: 'Finance · payments', description: 'Record receipts against issued invoices and keep outstanding balances honest.', module: 'finance' },
    { path: '/finance/revenue/', title: 'Recognized revenue', kicker: 'Finance · recognized revenue', description: 'Review revenue events created from won pipeline and trace them back to campaigns and invoices.', module: 'finance' },
    { path: '/attribution/', title: 'Attribution', kicker: 'RevOps', description: 'See which content and conversations create pipeline revenue.', module: 'attribution' },
    { path: '/attribution/touchpoints/', title: 'Touchpoints', kicker: 'Attribution · touchpoints', description: 'Every social interaction credited toward a deal.', module: 'attribution' },
    { path: '/attribution/reports/', title: 'Revenue reports', kicker: 'Attribution · reports', description: 'First, last, linear, time-decay, and position-based revenue views.', module: 'attribution' },
    { path: '/settings/', title: 'Workspace', kicker: 'Workspace', description: 'Configure people, automations, integrations, and audit history.', module: 'workspace' },
    { path: '/settings/ledger/', title: 'Ledger settings', kicker: 'Workspace · ledger', description: 'Set the currency and timezone defaults used by finance records and reports.', module: 'workspace' },
    { path: '/settings/members/', title: 'Members & roles', kicker: 'Workspace · members', description: 'Seven role profiles keep sales, marketing, and RevOps permissions clear.', module: 'workspace' },
    { path: '/settings/workflows/', title: 'Workflows', kicker: 'Workspace · workflows', description: 'Cross-module triggers and actions executed by Dramatiq.', module: 'workspace' },
    { path: '/settings/integrations/', title: 'Integrations', kicker: 'Workspace · integrations', description: 'Provider-neutral OAuth and connector capabilities for publishing.', module: 'workspace' },
    { path: '/settings/custom-fields/', title: 'Custom fields', kicker: 'Workspace · custom fields', description: 'Twenty-style extensibility for tenant-specific objects and revenue metadata.', module: 'workspace' },
    { path: '/settings/audit/', title: 'Audit log', kicker: 'Workspace · audit', description: 'An append-only trail for revenue operations changes.', module: 'workspace' },
    { path: '/tasks/', title: 'Tasks', kicker: 'Operations · background jobs', description: 'Workflow, attribution, publishing, and finance jobs, from the shared audit trail.', module: 'tasks' },
    { path: '/settings/email/', title: 'Email inbox', kicker: 'Workspace · email', description: 'Connect Gmail or Outlook to sync inbound messages into the CRM timeline.', module: 'workspace' },
    { path: '/settings/custom-objects/', title: 'Custom objects', kicker: 'Workspace · data model', description: 'Add a new record type without a migration, using declarative fields with validated JSON rows.', module: 'workspace' },
    { path: '/settings/saved-views/', title: 'Saved views', kicker: 'Workspace · views', description: 'Your persisted list and kanban view configurations for every resource.', module: 'workspace' },
    { path: '/settings/import/', title: 'Import', kicker: 'Workspace · data', description: 'Import companies, contacts, and deals from a CSV upload, validated and workspace-scoped.', module: 'workspace' },
    { path: '/settings/plan/', title: 'Plan & billing', kicker: 'Workspace · billing', description: 'Subscription state, plan limits, seat usage, and the Stripe customer portal.', module: 'billing' },
    { path: '/ai/', title: 'AI Hub', kicker: 'Workspace · assisted operations', description: 'Consent-gated lead scoring, sales-email drafts, and social-post drafts.', module: 'ai' },
    { path: '/employees/', title: 'People', kicker: 'Workspace · people', description: 'Review member activity, ownership, publishing, and performance dossiers.', module: 'employees' },
    { path: '/reports/', title: 'Reports', kicker: 'RevOps · reports', description: 'The catalog of revenue, pipeline, publishing, employee, and billing reports.', module: 'reports' },
  ];
  return pages.map((page) => ({
    params: { path: page.path === '/' ? undefined : page.path.replace(/^\//, '').replace(/\/$/, '') },
    props: page,
  }));
}

const page = Astro.props;
// Bolt is the canonical API road. Set PUBLIC_API_PREFIX=/api/v1 when the
// optional django-bolt runtime is intentionally not installed.
const API_PREFIX = import.meta.env.PUBLIC_API_PREFIX ?? '/bolt';
// Page → Bolt resource table map. Pages with a registered resource render a
// live schema-aware fusion table below the highlight cards.
const RESOURCE_BY_PATH: Record<string, { resource: string; kicker: string }> = {
  '/crm/companies/': { resource: 'companies', kicker: 'Account directory' },
  '/crm/contacts/': { resource: 'contacts', kicker: 'People directory' },
  '/crm/deals/': { resource: 'deals', kicker: 'Pipeline board' },
  '/crm/pipelines/': { resource: 'pipelines', kicker: 'Pipeline configuration' },
  '/crm/activities/': { resource: 'activities', kicker: 'Activity stream' },
  '/marketing/campaigns/': { resource: 'campaigns', kicker: 'Campaign ledger' },
  '/marketing/channels/': { resource: 'channels', kicker: 'Connected channels' },
  '/marketing/calendar/': { resource: 'posts', kicker: 'Scheduled posts' },
  '/attribution/touchpoints/': { resource: 'touchpoints', kicker: 'Touchpoint ledger' },
  '/finance/invoices/': { resource: 'invoices', kicker: 'Receivable ledger' },
  '/finance/payments/': { resource: 'payments', kicker: 'Receipt ledger' },
  '/finance/revenue/': { resource: 'revenue', kicker: 'Recognized revenue' },
};
const tableSpec = RESOURCE_BY_PATH[page.path];
const isModuleOverview = ['/crm/', '/marketing/', '/finance/', '/attribution/'].includes(page.path);
const cards = page.module === 'overview'
  ? [
      { label: 'Twenty DNA · CRM', value: 'Relationship graph → pipeline', copy: 'Companies, contacts, activities, configurable stages, ownership, and deals.', href: '/crm/' },
      { label: 'Postiz DNA · publishing', value: 'Plan → approve → publish', copy: 'A channel-aware content calendar with media, approvals, and capabilities.', href: '/marketing/' },
      { label: 'RevOps · attribution', value: 'Touch → revenue', copy: 'Connect content and conversations to influenced revenue.', href: '/attribution/' },
    ]
  : page.module === 'marketing'
    ? [{ label: 'Content operations', value: 'Approval queue + publishing calendar', copy: 'Draft, review, schedule, publish, and retry without coupling the UI to a provider.', href: '/marketing/calendar/' }, { label: 'Provider surface', value: '12 platform families', copy: 'Explicit connector capabilities keep integrations replaceable.', href: '/settings/integrations/' }]
    : page.module === 'billing'
      ? [{ label: 'Subscription', value: 'Plan → checkout → active', copy: 'The workspace plan gates seats and features; checkout and the Stripe portal drive the lifecycle.', href: '/apis/billing/plans/' }]
      : page.module === 'reports'
        ? [{ label: 'Report surface', value: 'Revenue, pipeline, people, billing', copy: 'Every report is backed by live workspace data — no fabricated aggregates.', href: '/attribution/reports/' }]
    : page.module === 'workspace'
      ? [{ label: 'Automation', value: 'Cross-module workflows', copy: 'Dramatiq is the single execution boundary for publishing, analytics, and attribution.', href: '/settings/workflows/' }]
      : page.module === 'finance'
        ? [{ label: 'Revenue control', value: 'Invoice → payment → recognized revenue', copy: 'Closed-won deals can create an invoice and a campaign-linked revenue event without losing the sales trail.', href: '/finance/invoices/' }, { label: 'API surface', value: 'Three finance resources', copy: 'Invoices, payments, and revenue events are exposed through the same Bolt and compatibility contracts.', href: `${API_PREFIX}/invoices` }]
        : [{ label: 'Data surface', value: 'Ready for the API road', copy: 'Each domain screen can ship independently behind the canonical Bolt endpoints.', href: page.module === 'crm' ? `${API_PREFIX}/companies` : page.module === 'attribution' ? `${API_PREFIX}/touchpoints` : `${API_PREFIX}/dashboard` }];
---
<Layout title={`${page.title} · Loop CRM`}>
  <AppShell title={page.title} kicker={page.kicker} description={page.description} path={page.path}>
    {page.path === '/overview/' && <RevOpsDashboard client:load />}
    {isModuleOverview && <ModuleOverview module={page.module as 'crm' | 'marketing' | 'finance' | 'attribution'} client:load />}
    {page.path === '/crm/deals/' && <PipelineBoard client:load />}
    {page.path === '/settings/plan/' && <BillingPlan client:load />}
    {page.path === '/marketing/calendar/' && <ContentCalendar client:load />}
    {page.path === '/crm/pipelines/' && <PipelineManager client:load />}
    {(page.path === '/settings/' || page.path === '/settings/ledger/') && <WorkspaceControls client:load />}
    {page.path === '/reports/' && <ReportCatalog client:load />}
    {page.path === '/ai/' && <AiHub client:load />}
    {page.path === '/employees/' && <EmployeeDirectory client:load />}
    {page.path === '/overview/' && <OnboardingTour client:load />}
    <CommandPalette client:load />
    {!isModuleOverview && page.path !== '/overview/' && page.path !== '/crm/deals/' && page.path !== '/employees/' && page.path !== '/ai/' && page.path !== '/settings/' && page.path !== '/settings/ledger/' && (
    <section class="loop-page-cards" aria-label={`${page.title} highlights`}>
      {cards.map((card) => (
        <a class:list={['loop-page-card', cards.length === 1 && 'loop-page-card--wide']} href={card.href}>
          <span>{card.label}</span><strong>{card.value}</strong><p>{card.copy}</p><b aria-hidden="true">→</b>
        </a>
      ))}
    </section>
    )}
    {page.module === 'overview' && <section class="loop-workflow-strip"><span>Workflow catalog</span><strong>Lead capture · content approval · publish & attribute · deal won</strong></section>}
    {tableSpec && page.path !== '/marketing/calendar/' && page.path !== '/crm/pipelines/' && (
      <ResourceTable
        resource={tableSpec.resource}
        kicker={tableSpec.kicker}
        title={`${page.title} table`}
        client:load
      />
    )}
  </AppShell>
</Layout>
<style>
  .loop-module-overview { display:grid; gap:1.35rem; margin-top:2.8rem; padding:clamp(1.2rem,3vw,2rem); border:1px solid var(--loop-line); background:#0e0e0e; box-shadow:1rem 1rem 0 rgba(3,17,19,.38); }
  .loop-module-overview__head { display:flex; align-items:flex-start; justify-content:space-between; gap:2rem; }
  .loop-module-overview__kicker { color:var(--loop-accent); font:600 .61rem "JetBrains Mono",monospace; letter-spacing:.14em; text-transform:uppercase; }
  .loop-module-overview__head h2 { max-width:42rem; margin:.5rem 0 0; color:var(--loop-ink); font:900 clamp(1.5rem,3vw,2.7rem)/.95 "Bricolage Grotesque","Arial Black",sans-serif; letter-spacing:-.055em; text-transform:uppercase; }
  .loop-module-overview__head p { max-width:42rem; margin:.75rem 0 0; color:var(--loop-muted); line-height:1.6; }
  .loop-module-overview__total { display:grid; min-width:10rem; gap:.3rem; padding-left:1rem; border-left:2px solid var(--loop-accent); }
  .loop-module-overview__total strong { color:var(--loop-accent-bright); font:700 clamp(1.4rem,3vw,2.1rem)/1 "JetBrains Mono",monospace; }
  .loop-module-overview__total span { color:var(--loop-dim); font:600 .58rem "JetBrains Mono",monospace; letter-spacing:.08em; text-transform:uppercase; }
  .loop-module-overview__metrics { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1px; border:1px solid var(--loop-line); background:var(--loop-line); }
  .loop-module-overview__metrics a { position:relative; display:grid; gap:.5rem; min-height:7rem; padding:1rem; background:#121212; color:var(--loop-muted); text-decoration:none; transition:background .2s ease,transform .2s ease; }
  .loop-module-overview__metrics a:hover { background:#181818; transform:translateY(-2px); }
  .loop-module-overview__metrics span { font:600 .61rem "JetBrains Mono",monospace; letter-spacing:.08em; text-transform:uppercase; }
  .loop-module-overview__metrics strong { color:var(--loop-ink); font:700 1.55rem/1 "JetBrains Mono",monospace; }
  .loop-module-overview__metrics b { position:absolute; right:.8rem; bottom:.7rem; color:var(--loop-accent); font:500 .9rem "JetBrains Mono",monospace; }
  .loop-module-overview__actions { display:flex; flex-wrap:wrap; gap:.55rem; }
  .loop-module-overview__actions a { display:inline-flex; align-items:center; gap:.7rem; padding:.62rem .78rem; border:1px solid var(--loop-line); color:var(--loop-muted); font:600 .62rem "JetBrains Mono",monospace; letter-spacing:.06em; text-decoration:none; text-transform:uppercase; transition:border-color .2s ease,color .2s ease,transform .2s ease; }
  .loop-module-overview__actions a:hover { border-color:var(--loop-accent); color:var(--loop-accent-bright); transform:translateX(2px); }
  .loop-module-overview__actions b { color:var(--loop-accent); }
  .loop-module-overview--loading { min-height:16rem; }
  .loop-module-overview__loading-bar,.loop-module-overview__loading-grid i { background:linear-gradient(100deg,#111 40%,#252525 50%,#111 60%); background-size:200% 100%; animation:loop-module-shimmer 1.6s infinite; }
  .loop-module-overview__loading-bar { width:45%; height:1.8rem; }
  .loop-module-overview__loading-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:var(--loop-line); }
  .loop-module-overview__loading-grid i { min-height:7rem; }
  .loop-module-overview--error { border-color:#6f3430; }
  .loop-module-overview--error strong { color:var(--loop-accent-bright); font:700 .7rem "JetBrains Mono",monospace; letter-spacing:.1em; }
  .loop-module-overview--error p { margin:0; color:var(--loop-muted); }
  .loop-module-overview--error button { justify-self:start; padding:.65rem .8rem; border:1px solid var(--loop-accent); background:var(--loop-accent); color:#080808; font:700 .62rem "JetBrains Mono",monospace; text-transform:uppercase; cursor:pointer; }
  @keyframes loop-module-shimmer { to { background-position:-200% 0; } }
  @media(max-width:760px) { .loop-module-overview__head { flex-direction:column; gap:1rem; } .loop-module-overview__total { width:100%; padding:0; border-left:0; border-top:2px solid var(--loop-accent); padding-top:.7rem; } .loop-module-overview__metrics { grid-template-columns:repeat(2,minmax(0,1fr)); } .loop-module-overview__actions a { flex:1 1 100%; justify-content:space-between; } }
  @media(prefers-reduced-motion:reduce) { .loop-module-overview__loading-bar,.loop-module-overview__loading-grid i { animation:none; } }
  .loop-page-cards { display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); gap:1px; margin-top:3rem; background:var(--loop-line); border:1px solid var(--loop-line); } .loop-page-card { position:relative; display:flex; min-height:13rem; flex-direction:column; grid-column:span 5; padding:1.45rem; background:#0e0e0e; text-decoration:none; transition:background .25s ease; } .loop-page-card:nth-child(1) { grid-column:span 7; min-height:15rem; } .loop-page-card:nth-child(3) { grid-column:4 / span 5; margin-top:-2rem; } .loop-page-card:hover { background:#141414; } .loop-page-card span,.loop-workflow-strip span { color:var(--loop-accent); font:600 .62rem "JetBrains Mono",monospace; letter-spacing:.11em; text-transform:uppercase; } .loop-page-card span::before { content:">> "; color:var(--loop-dim); } .loop-page-card strong { display:block; margin-top:.9rem; color:var(--loop-ink); font-family:"Bricolage Grotesque","Arial Black",ui-sans-serif,sans-serif; font-size:clamp(1.3rem,2.4vw,1.8rem); font-weight:900; text-transform:uppercase; line-height:1; letter-spacing:-.045em; text-wrap:balance; } .loop-page-card p { max-width:34rem; margin:.65rem 0 0; color:var(--loop-muted); line-height:1.55; } .loop-page-card b { margin-top:auto; align-self:flex-end; color:var(--loop-accent-bright); font:500 1.25rem "JetBrains Mono",monospace; transition:transform .2s ease; } .loop-page-card:hover b { transform:translateX(4px); } .loop-workflow-strip { display:flex; flex-wrap:wrap; gap:1rem 2rem; align-items:baseline; margin-top:1rem; padding:1.1rem 1.3rem; border-left:3px solid var(--loop-accent); color:var(--loop-accent-bright); background:#0e0e0e; } .loop-workflow-strip span { font-size:.58rem; } .loop-workflow-strip strong { color:var(--loop-ink); font-weight:500; } @media(max-width:800px) { .loop-page-card,.loop-page-card--wide,.loop-page-card:nth-child(1),.loop-page-card:nth-child(3) { grid-column:span 12; margin-top:0; } }  @keyframes loop-rise { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
  .loop-page-cards > * { animation:loop-rise .6s cubic-bezier(.16,1,.3,1) both; }
  .loop-page-cards > *:nth-child(2) { animation-delay:70ms; }
  .loop-page-cards > *:nth-child(3) { animation-delay:140ms; }
  .loop-page-card:active { transform:translateY(1px) scale(.995); }
  @media(prefers-reduced-motion:reduce) { .loop-page-card,.loop-page-card b { transition:none; } .loop-page-cards > * { animation:none; } }
  .loop-controls { display:grid; gap:1.25rem; max-width:72rem; margin:clamp(2.75rem,6vw,5.5rem) 0 1rem; }
  .loop-controls__grid { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr); gap:1px; background:var(--loop-line); border:1px solid var(--loop-line); box-shadow:1rem 1rem 0 rgba(3,17,19,.38); }
  .loop-controls__panel { position:relative; display:flex; min-height:20rem; flex-direction:column; gap:1rem; overflow:hidden; padding:clamp(1.35rem,3vw,2.25rem); background:#0e0e0e; clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,0 100%); }
  .loop-controls__panel::after { position:absolute; right:1.2rem; top:1.2rem; width:1.1rem; height:1.1rem; border-top:1px solid var(--loop-line); border-right:1px solid var(--loop-line); content:""; opacity:.75; }
  .loop-controls__panel--wide { min-height:0; gap:1.15rem; }
  .loop-controls__kicker { color:var(--loop-accent); font:600 .61rem "JetBrains Mono",monospace; letter-spacing:.14em; text-transform:uppercase; }
  .loop-controls__panel h2 { max-width:26rem; margin:0; color:var(--loop-ink); font-family:"Bricolage Grotesque","Arial Black",ui-sans-serif,sans-serif; font-size:clamp(1.35rem,2.4vw,2rem); font-weight:900; letter-spacing:-.045em; line-height:.98; text-transform:uppercase; }
  .loop-controls__panel p,.loop-controls__status span { max-width:38rem; margin:0; color:var(--loop-muted); line-height:1.6; }
  .loop-controls__panel label { display:grid; gap:.45rem; color:var(--loop-dim); font:600 .62rem "JetBrains Mono",monospace; letter-spacing:.08em; text-transform:uppercase; }
  .loop-controls__panel input { width:100%; box-sizing:border-box; padding:.82rem .9rem; border:1px solid var(--loop-line); background:#080808; color:var(--loop-ink); font:600 .85rem "JetBrains Mono",monospace; transition:border-color .24s cubic-bezier(.32,.72,0,1),transform .24s cubic-bezier(.32,.72,0,1),background .24s cubic-bezier(.32,.72,0,1); }
  .loop-controls__panel input:hover { border-color:#4a4a4a; background:#0b0b0b; }
  .loop-controls__panel input:focus { border-color:var(--loop-accent); transform:translateX(2px); outline:0; }
  .loop-controls__status { display:grid; gap:.3rem; padding:1rem 1.1rem; border-left:2px solid var(--loop-accent); background:#121212; }
  .loop-controls__status b { color:var(--loop-accent-bright); font:700 .72rem "JetBrains Mono",monospace; letter-spacing:.04em; text-transform:uppercase; }
  .loop-controls__chips { display:flex; flex-wrap:wrap; gap:.5rem; max-width:62rem; }
  .loop-controls__chips span { padding:.52rem .62rem; border:1px solid var(--loop-line); color:var(--loop-muted); font:600 .6rem "JetBrains Mono",monospace; letter-spacing:.04em; text-transform:uppercase; transition:border-color .24s cubic-bezier(.32,.72,0,1),color .24s cubic-bezier(.32,.72,0,1),transform .24s cubic-bezier(.32,.72,0,1); }
  .loop-controls__chips span:hover { border-color:var(--loop-accent); color:var(--loop-accent-bright); transform:translateY(-2px); }
  .loop-controls .loop-button { align-self:flex-start; text-decoration:none; transition:transform .24s cubic-bezier(.32,.72,0,1),background .24s cubic-bezier(.32,.72,0,1),color .24s cubic-bezier(.32,.72,0,1); }
  .loop-controls .loop-button:hover { transform:translateX(3px); }
  .loop-controls .loop-button:active { transform:translate(3px,1px); }
  .loop-controls__message { margin:0; color:var(--loop-accent-bright); font:600 .7rem "JetBrains Mono",monospace; }
  @media(max-width:760px) { .loop-controls { margin-top:2.5rem; } .loop-controls__grid { grid-template-columns:1fr; box-shadow:.5rem .5rem 0 rgba(3,17,19,.38); } .loop-controls__panel { min-height:0; padding:1.25rem; } }
  @media(prefers-reduced-motion:reduce) { .loop-controls__panel input,.loop-controls__chips span,.loop-controls .loop-button { transition:none; } }
  .loop-calendar { display:grid; gap:1.25rem; margin-top:3rem; max-width:78rem; }
  .loop-calendar__toolbar { display:flex; align-items:end; justify-content:space-between; gap:1rem; padding:1.15rem 1.3rem; border:1px solid var(--loop-line); background:#0e0e0e; }
  .loop-calendar__toolbar > div { display:grid; gap:.45rem; }

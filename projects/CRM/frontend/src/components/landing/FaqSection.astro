---
import type { FaqItem, SectionHead } from '@/lib/landing';

interface Props {
  faq: FaqItem[];
  head?: SectionHead;
}
const { faq, head } = Astro.props;
---
{
  faq && faq.length > 0 && (
    <section id="faq" class="loop-faq">
      <div class="loop-section-head" x-data="{ shown: false }" x-intersect.once="shown = true" :class="shown && 'is-shown'">
        {head?.eyebrow && <p class="loop-eyebrow">{head.eyebrow}</p>}
        {head?.title && <h2>{head.title}</h2>}
        {head?.description && <p class="loop-section-lede">{head.description}</p>}
      </div>
      <div class="loop-faq__list">
        {faq.map((item) => (
          <details class="loop-faq__item">
            <summary><h3>{item.question}</h3></summary>
            {item.answer && <p>{item.answer}</p>}
          </details>
        ))}
      </div>
    </section>
  )
}

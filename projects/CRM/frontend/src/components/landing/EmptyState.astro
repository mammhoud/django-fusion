---
interface Props {
  error?: string;
}
const { error } = Astro.props;
---
<section class="loop-empty">
  <div class="loop-empty__box">
    <p class="loop-eyebrow">Content unavailable</p>
    <h1>Landing content is offline</h1>
    <p>The backend that serves this page did not respond{error ? ` (${error})` : ''}. Start the Django backend and reload to see the Wagtail-managed landing.</p>
  </div>
</section>

---
import { Button } from '@/components/ui/button';
import PipelineDemo from '@/components/demo/PipelineDemo';
import type { HeroData } from '@/lib/landing';

interface Props {
  hero: HeroData;
  visual?: boolean;
}
const { hero, visual = false } = Astro.props;

const primaryHref = hero.primary_cta?.href || '/accounts/signup/';
const primaryLabel = hero.primary_cta?.label || 'Start free';
const secondaryHref = hero.secondary_cta?.href || '/accounts/login/';
const secondaryLabel = hero.secondary_cta?.label || 'Sign in to your workspace';
---
<section class="loop-hero">
  <div class="loop-hero__copy">
    {hero.badge && <p class="loop-eyebrow">{hero.badge}</p>}
    <h1>{hero.title}{hero.accent && <span class="loop-accent-word"> {hero.accent}</span>}</h1>
    {hero.subtitle && <p class="loop-hero__lede">{hero.subtitle}</p>}
    {(hero.primary_cta || hero.secondary_cta) && (
      <div class="loop-hero__actions">
        {hero.primary_cta && (
          <Button asChild size="lg" variant={hero.primary_cta.style === 'outline' || hero.primary_cta.style === 'secondary' ? 'outline' : 'default'}>
            <a href={primaryHref}>{primaryLabel}</a>
          </Button>
        )}
        {hero.secondary_cta && (
          <Button asChild size="lg" variant="outline">
            <a href={secondaryHref}>{secondaryLabel}</a>
          </Button>
        )}
      </div>
    )}
    {hero.note && <p class="loop-hero__note">{hero.note}</p>}
  </div>
  {
    visual && (
      <div class="loop-hero__visual">
        <PipelineDemo client:load />
      </div>
    )
  }
</section>

# ================================================================
# Loop-CRM — Environment Configuration Example
# ================================================================
# Copy to .env and fill in values. Standalone Django + django-fusion
# config at projects/loop-crm/backend/settings.py.
# ================================================================

# ── Core ────────────────────────────────────────────────────────
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,loop-crm-backend,crm.structa.cloud,www.crm.structa.cloud
CSRF_TRUSTED_ORIGINS=https://crm.structa.cloud,https://www.crm.structa.cloud
DJANGO_SECURE_SSL_REDIRECT=0

# ── Database ────────────────────────────────────────────────────
# Local dev uses SQLite by default. Set USE_POSTGRES=1 for the
# PostgreSQL cluster the merge plan targets in production.
USE_POSTGRES=0
POSTGRES_DB=loop_crm
POSTGRES_USER=loop_crm
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ── Redis (cache + Dramatiq broker) ─────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── Ports ───────────────────────────────────────────────────────
# Backend Django dev server
LOOP_BACKEND_PORT=8000
# Astro frontend dev server (matches frontend/.env; see frontend/.env.example)
LOOP_FRONTEND_PORT=4321

# ── Fusion Render Mode ──────────────────────────────────────────
# True  = Django renders full HTML (render-first, SEO-friendly)
# False = JSON data APIs — Astro frontend renders from /api/v1/*
FUSION_RENDER_FIRST=0

# ── Allauth account security ────────────────────────────────────
ACCOUNT_EMAIL_VERIFICATION=optional
DEFAULT_FROM_EMAIL=Loop CRM <noreply@structa.cloud>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Enable only behind HTTPS in production.
SECURE_SSL_REDIRECT=0

# ── Social login (GitHub + Google OAuth) ────────────────────────
# Leave empty to hide the provider buttons on the login/signup pages.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Social publishing (redirect-OAuth connectors) ────────────────
# When set, the channels screen shows "Connect …" actions and the connector
# adapters publish with the stored tokens (refreshing them when they expire).
# Leave empty to keep the honest "not configured" state.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
# One Meta app can host Facebook Pages, Instagram professional accounts, and
# WhatsApp Business — scopes are requested per connect flow. The app must be
# in Live mode with the correct redirect URI (see SOCIAL_REDIRECT_BASE).
META_CLIENT_ID=
META_CLIENT_SECRET=
# TikTok Content Posting API app (client_key is the public app key).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# YouTube reuses the Google OAuth client; its consent screen must also list
# the youtube.upload and youtube.readonly scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Reddit script app — must be installed on the subreddit you moderate.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Override the redirect URI host for the OAuth callbacks. Defaults to the
# request host (works in dev through the Astro proxy); set this to the exact
# registered callback host in production, e.g. https://crm.structa.cloud
SOCIAL_REDIRECT_BASE=
# Public base URL for /media/ files. The media-capable publishers
# (Facebook, Instagram, TikTok, WhatsApp, YouTube) pull the attached image or
# video from this host, so it must be publicly reachable and serve MEDIA_URL.
# Leave empty (or unset) to keep media posts gated with a clear error.
PUBLIC_SITE_URL=
# Optional YouTube upload privacy: private (default), unlisted, or public.
# YouTube restricts new unverified API projects to private uploads.
YOUTUBE_PRIVACY_STATUS=private

# ── Email sync (Gmail + Outlook OAuth connectors) ───────────────
# When set, the email inbox shows "Connect Gmail / Connect Outlook" actions
# and the sync adapters fetch messages with the stored tokens (refreshing them
# when they expire). Leave empty to keep the honest "not configured" state.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# Override the redirect URI host for the email OAuth callbacks. Falls back to
# SOCIAL_REDIRECT_BASE, then to the request host. Set this to the exact
# registered callback host in production, e.g. https://crm.structa.cloud
EMAIL_REDIRECT_BASE=

# ── Stripe SaaS billing ─────────────────────────────────────────
# Leave STRIPE_SECRET_KEY empty to disable checkout/portal/webhook with an
# honest "billing not configured" state (the seeded trial keeps dev working).
# STRIPE_WEBHOOK_SECRET is only required to verify inbound webhook events.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Demo state ─────────────────────────────────────────────────
# Set DEMO_MODE=1 to run this deployment as a public preview: the login page
# shows the seeded demo account (demo@loop.dev / demo-pass-123) and the
# container entrypoint seeds the demo workspace on boot. The demo admin is a
# superuser. NEVER enable on a deployment with real customer data.
DEMO_MODE=0

# ── django-bolt API (optional) ──────────────────────────────────
# Install django-fusion[bolt] and the real django-bolt runtime to enable the
# canonical Rust-backed API at /bolt/. The Django /api/v1/ road remains as a
# compatibility fallback when Bolt is unavailable.
FUSION_BOLT_ENABLED=1
FUSION_BOLT_JWT_SECRET=replace-with-a-dedicated-random-signing-secret
FUSION_BOLT_JWT_ALGORITHM=HS256
FUSION_BOLT_TOKEN_TTL=3600
FUSION_BOLT_REFRESH_TTL=2592000
# Token issuance is user-bound on Loop-CRM: the caller must be signed in
# through allauth; arbitrary subject/device tokens are rejected.
# Optional second machine credential accepted via X-API-Key.
FUSION_BOLT_API_KEY=
FUSION_BOLT_API_KEY_HEADER=X-API-Key
FUSION_BOLT_JWT_ISSUER=loop-crm
FUSION_BOLT_JWT_AUDIENCE=
FUSION_BOLT_REFRESH_TTL=
FUSION_BOLT_TOKEN_TTL=

# ── Optional AI hub ─────────────────────────────────────────────
# Leave empty to keep AI operations deferred. The provider receives only the
# submitted brief after each workspace member enables explicit consent.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ── Django superuser ──────────────────────────────────────────
# Consumed by `createsuperuser --noinput` / `seed_demo --superuser`.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@structa.cloud
DJANGO_SUPERUSER_PASSWORD=<generate-a-unique-secret>

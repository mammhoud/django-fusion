---
import '../../styles/global.css';
import Sprite from '../../components/ui/icons/Sprite.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Self-Checkout · Formint POS</title>
    <script is:inline>
      (() => {
        try {
          const ui = JSON.parse(localStorage.getItem('formint-ui') || '{}');
          if (ui.mode === 'dark') document.documentElement.classList.add('dark');
        } catch {}
      })();
    </script>
  </head>
  <body
    x-data="kioskPage()"
    x-init="init()"
    class="min-h-screen"
  >
    <Sprite />
    <main class="mx-auto max-w-[80rem] px-4 py-5">
      <!-- ── Header ── -->
      <header class="flex items-center justify-between mb-4">
        <h1 class="text-2xl font-extrabold" style="color: var(--color-text-primary)">
          <span class="align-middle">Self-Checkout</span>
          <span class="tag tag--sm tag--primary ml-2 align-middle" x-text="'Kiosk ' + kioskName"></span>
        </h1>
        <div class="flex items-center gap-2">
          <button
            type="button"
            @click="resetForNextGuest()"
            class="btn btn-ghost btn-sm gap-1"
            title="Start a new order"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-refresh" /></svg>
            New order
          </button>
        </div>
      </header>

      <!-- ── Success state ── -->
      <div x-show="completed" class="mx-auto max-w-xl text-center py-24">
        <div class="mx-auto mb-5 h-16 w-16 rounded-full flex items-center justify-center" style="background: var(--color-success-soft, rgba(22,163,74,.15))">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-check" /></svg>
        </div>
        <h2 class="text-3xl font-extrabold mb-2" style="color: var(--color-text-primary)">Thank you!</h2>
        <p class="opacity-60 mb-6" x-text="'Order #' + completedSaleId + ' is being prepared.'"></p>
        <button type="button" @click="resetForNextGuest()" class="btn btn-primary btn-lg">
          Start another order
        </button>
      </div>

      <template x-if="!completed">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_22rem] gap-4 items-start">
          <!-- ── Catalog ── -->
          <section aria-label="Menu">
            <!-- Category rail -->
            <div class="flex flex-wrap gap-1.5 mb-3" role="tablist" aria-label="Categories">
              <button
                type="button"
                role="tab"
                @click="selectCategory('')"
                :aria-selected="activeCategory === ''"
                :class="'tag tag--sm cursor-pointer ' + (activeCategory === '' ? 'tag--primary' : 'tag--ghost')"
              >All</button>
              <template x-for="cat in categories" :key="cat.slug">
                <button
                  type="button"
                  role="tab"
                  @click="selectCategory(cat.slug)"
                  :aria-selected="activeCategory === cat.slug"
                  :class="'tag tag--sm cursor-pointer ' + (activeCategory === cat.slug ? 'tag--primary' : 'tag--ghost')"
                  x-text="cat.name"
                ></button>
              </template>
            </div>

            <!-- Loading -->
            <div x-show="isLoading" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
              <template x-for="i in 8" :key="i">
                <div class="skeleton-shimmer h-32 rounded-xl" aria-hidden="true"></div>
              </template>
            </div>

            <!-- Product grid -->
            <div x-show="!isLoading" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
              <template x-for="group in visibleGroups" :key="group.name">
                <template x-for="product in group.products" :key="product.id">
                  <button
                    type="button"
                    @click="addToCart(product)"
                    :disabled="!product.in_stock"
                    class="kiosk-tile text-left rounded-xl p-4 border transition-all duration-150 flex flex-col justify-between gap-2"
                    :style="tileStyle(product)"
                    :class="{ 'opacity-40 cursor-not-allowed': !product.in_stock, 'active:scale-[.97]': product.in_stock }"
                  >
                    <div class="min-w-0">
                      <div
                        x-show="product.image_url"
                        class="h-16 w-16 rounded-xl mb-2 bg-cover bg-center"
                        :style="'background-image: url(' + product.image_url + ')'"
                        role="img"
                        :aria-label="product.name"
                      ></div>
                      <p class="font-bold leading-tight" style="color: var(--color-text-primary)" x-text="product.name"></p>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="font-extrabold" style="color: var(--color-text-primary)" x-text="'$' + product.price.toFixed(2)"></span>
                      <span
                        x-show="!product.in_stock"
                        class="tag tag--sm tag--neutral"
                      >Out</span>
                      <svg x-show="product.in_stock" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--color-text-secondary)"><use href="#i-plus" /></svg>
                    </div>
                  </button>
                </template>
              </template>
            </div>

            <p x-show="!isLoading && visibleGroups.length === 0" class="text-center py-16 opacity-50 text-sm">
              No products in this category.
            </p>
          </section>

          <!-- ── Cart ── -->
          <aside class="card p-4 lg:sticky lg:top-4" aria-label="Cart">
            <div class="flex items-center justify-between mb-3">
              <h2 class="font-bold" style="color: var(--color-text-primary)">Your order</h2>
              <button
                type="button"
                @click="clearCart()"
                class="btn btn-ghost btn-sm text-xs"
                x-show="cartItems.length > 0"
              >Clear</button>
            </div>

            <div x-show="cartItems.length === 0" class="text-center py-10 opacity-50 text-sm">
              Tap a product to add it.
            </div>

            <div x-show="cartItems.length > 0" class="space-y-2 max-h-[45vh] overflow-y-auto">
              <template x-for="item in cartItems" :key="item.product_id">
                <div class="flex items-center gap-2 py-1.5">
                  <span class="flex-1 min-w-0">
                    <span class="block truncate text-sm font-medium" style="color: var(--color-text-primary)" x-text="item.product_name"></span>
                    <span class="text-xs opacity-50" x-text="'$' + item.unit_price.toFixed(2) + ' each'"></span>
                  </span>
                  <div class="flex items-center gap-1">
                    <button
                      type="button"
                      @click="changeQty(item, -1)"
                      class="btn btn-ghost btn-sm h-8 w-8 !p-0"
                      aria-label="Decrease quantity"
                    >
                      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-minus" /></svg>
                    </button>
                    <span class="w-6 text-center text-sm font-bold" x-text="item.quantity"></span>
                    <button
                      type="button"
                      @click="changeQty(item, 1)"
                      class="btn btn-ghost btn-sm h-8 w-8 !p-0"
                      aria-label="Increase quantity"
                    >
                      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plus" /></svg>
                    </button>
                  </div>
                  <span class="w-14 text-right text-sm font-bold" style="color: var(--color-text-primary)" x-text="'$' + item.line_total.toFixed(2)"></span>
                </div>
              </template>
            </div>

            <div class="border-t mt-3 pt-3 space-y-1.5 text-sm" style="border-color: var(--color-border-subtle)">
              <div class="flex justify-between opacity-60">
                <span>Subtotal</span>
                <span x-text="'$' + cart.subtotal.toFixed(2)"></span>
              </div>
              <div class="flex justify-between opacity-60">
                <span>Tax (8%)</span>
                <span x-text="'$' + cart.tax_amount.toFixed(2)"></span>
              </div>
              <div class="flex justify-between font-extrabold text-lg" style="color: var(--color-text-primary)">
                <span>Total</span>
                <span x-text="'$' + cart.total.toFixed(2)"></span>
              </div>
            </div>

            <button
              type="button"
              @click="checkout()"
              :disabled="cartItems.length === 0 || isCheckingOut"
              class="btn btn-primary w-full mt-4 btn-lg"
            >
              <span x-show="!isCheckingOut" x-text="'Pay $' + cart.total.toFixed(2)"></span>
              <span x-show="isCheckingOut" class="flex items-center gap-2">
                <span class="inline-block h-4 w-4 rounded-full border-2 border-t-transparent animate-spin" style="border-color: inherit"></span>
                Processing…
              </span>
            </button>

            <p x-show="error" class="text-sm mt-3 text-center" style="color: var(--color-error)" x-text="error"></p>
          </aside>
        </div>
      </template>
    </main>

    <script>
      import Alpine from 'alpinejs';

      document.addEventListener('alpine:init', () => {
        Alpine.data('kioskPage', () => ({
          sessionKey: '',
          kioskName: '1',
          categories: [],
          groups: [],
          activeCategory: '',
          cart: { items: [], subtotal: 0, tax_amount: 0, total: 0 },
          isLoading: true,
          isCheckingOut: false,
          completed: false,
          completedSaleId: '',
          error: '',

          get cartItems() {
            return this.cart.items || [];
          },

          get visibleGroups() {
            const items = this.groups.filter(g => g.products.length > 0);
            if (this.activeCategory) {
              const match = this.categories.find(c => c.slug === this.activeCategory);
              const name = match ? match.name : this.activeCategory;
              return items.filter(g => g.name === name);
            }
            return items;
          },

          tileStyle(product) {
            const border = product.border_color
              ? `border-color: ${product.border_color}55;`
              : 'border-color: var(--color-border-subtle);';
            return border;
          },

          async ensureSession() {
            if (this.sessionKey) return;
            try {
              const res = await fetch('/kiosk/sessions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name: this.kioskName }),
              });
              if (res.ok) {
                const data = await res.json();
                this.sessionKey = data.session_key;
              }
            } catch (e) {
              console.error('kiosk session error:', e);
            }
          },

          async loadCatalog() {
            this.isLoading = true;
            try {
              const res = await fetch('/kiosk/catalog');
              if (res.ok) {
                const data = await res.json();
                this.categories = data.categories || [];
                this.groups = Object.entries(data.groups || {}).map(([name, products]) => ({ name, products }));
              }
            } catch (e) {
              console.error('kiosk catalog error:', e);
            } finally {
              this.isLoading = false;
            }
          },

          async loadCart() {
            if (!this.sessionKey) return;
            try {
              const res = await fetch(`/kiosk/sessions/${this.sessionKey}`);
              if (res.ok) {
                const data = await res.json();
                this.cart = { items: data.items || [], subtotal: data.subtotal, tax_amount: data.tax_amount, total: data.total };
              }
            } catch (e) {
              console.error('kiosk cart load error:', e);
            }
          },

          selectCategory(slug) {
            this.activeCategory = slug;
          },

          async addToCart(product) {
            if (!product.in_stock) return;
            this.error = '';
            await this.ensureSession();
            try {
              const res = await fetch(`/kiosk/sessions/${this.sessionKey}/cart`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ product_id: product.id, quantity: 1 }),
              });
              if (res.ok) {
                const data = await res.json();
                this.cart = data.cart;
              } else {
                const err = await res.json().catch(() => ({}));
                this.error = err.error || 'Could not add item';
              }
            } catch (e) {
              this.error = 'Network error';
            }
          },

          async changeQty(item, delta) {
            this.error = '';
            const next = item.quantity + delta;
            try {
              const res = await fetch(`/kiosk/sessions/${this.sessionKey}/cart/${item.product_id}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ quantity: Math.max(next, 0) }),
              });
              if (res.ok) {
                const data = await res.json();
                this.cart = data.cart;
              } else if (next <= 0) {
                await this.loadCart();
              } else {
                const err = await res.json().catch(() => ({}));
                this.error = err.error || 'Could not update quantity';
                await this.loadCart();
              }
            } catch (e) {
              this.error = 'Network error';
            }
          },

          async clearCart() {
            this.error = '';
            try {
              const res = await fetch(`/kiosk/sessions/${this.sessionKey}/cart/clear`, { method: 'POST' });
              if (res.ok) {
                const data = await res.json();
                this.cart = data.cart;
              }
            } catch (e) {
              this.error = 'Network error';
            }
          },

          async checkout() {
            if (this.cartItems.length === 0 || this.isCheckingOut) return;
            this.error = '';
            this.isCheckingOut = true;
            await this.ensureSession();
            try {
              const res = await fetch(`/kiosk/sessions/${this.sessionKey}/checkout`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ payment_method: 'card' }),
              });
              if (res.ok) {
                const data = await res.json();
                this.completed = true;
                this.completedSaleId = data.sale_id;
              } else {
                const err = await res.json().catch(() => ({}));
                this.error = err.error || 'Checkout failed';
              }
            } catch (e) {
              this.error = 'Network error';
            } finally {
              this.isCheckingOut = false;
            }
          },

          resetForNextGuest() {
            this.completed = false;
            this.completedSaleId = '';
            this.sessionKey = '';
            this.cart = { items: [], subtotal: 0, tax_amount: 0, total: 0 };
            this.error = '';
          },

          async init() {
            this.kioskName = new URLSearchParams(window.location.search).get('kiosk') || '1';
            await this.loadCatalog();
            await this.ensureSession();
            await this.loadCart();
          },
        }));
      });

      Alpine.start();
    </script>
  </body>
</html>

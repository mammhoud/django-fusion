---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/ui/Icon.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
---

<Layout title="Tables & Floor · Formint POS">
  <div class="page-shell" x-data="tablesPage()" x-init="init()">
    <section class="hero">
      <SectionHeading level="h1" eyebrow="Restaurant operations · floor layouts + reservations" title="Tables &amp; Floor" />
      <p class="intro">
        Track every table across the floor, then book reservations without
        leaving the register.
      </p>
    </section>

    <!-- ── Floor summary ── -->
    <section class="card" aria-labelledby="floor-title">
      <SectionHeading title="Live occupancy" id="floor-title">
        <button slot="actions" class="btn btn-ghost btn-sm" @click="loadAll()">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-refresh" /></svg>
          Refresh
        </button>
      </SectionHeading>
      <div x-show="floorLoading" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <template x-for="i in 4" :key="i"><div class="skeleton-shimmer h-20 rounded-xl" aria-hidden="true"></div></template>
      </div>
      <div x-show="!floorLoading" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="stat-card"><span class="stat-card__title">Occupied</span><span class="stat-card__value" x-text="floor.occupied ?? 0" style="color: var(--color-warning)"></span></div>
        <div class="stat-card"><span class="stat-card__title">Free</span><span class="stat-card__value" x-text="floor.free ?? 0" style="color: var(--color-success)"></span></div>
        <div class="stat-card"><span class="stat-card__title">Reserved</span><span class="stat-card__value" x-text="floor.reserved ?? 0" style="color: var(--color-info)"></span></div>
        <div class="stat-card"><span class="stat-card__title">Total tables</span><span class="stat-card__value" x-text="tables.length"></span></div>
      </div>
    </section>

    <!-- ── Tables grid ── -->
    <section class="card mt-4" aria-labelledby="tables-title">
      <SectionHeading title="Tables" id="tables-title">
        <button slot="actions" class="btn btn-primary btn-sm gap-1" @click="openCreate()">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plus" /></svg>
          Add table
        </button>
      </SectionHeading>
      <div x-show="tablesLoading" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        <template x-for="i in 6" :key="i"><div class="skeleton-shimmer h-24 rounded-xl" aria-hidden="true"></div></template>
      </div>
      <div x-show="!tablesLoading && tables.length === 0" class="text-center py-10 opacity-50 text-sm">
        No tables yet. Add your first table to start the floor plan.
      </div>
      <div x-show="!tablesLoading && tables.length > 0" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        <template x-for="t in tables" :key="t.id">
          <div class="rounded-xl border p-4 flex flex-col gap-2" :style="'border-color: var(--color-border-subtle)'">
            <div class="flex items-center justify-between">
              <span class="font-bold" style="color: var(--color-text-primary)" x-text="t.name"></span>
              <span class="badge badge-sm" :class="statusBadge(t.status)" x-text="t.status"></span>
            </div>
            <p class="text-xs opacity-50" x-text="(t.section || 'floor') + ' · ' + (t.capacity || '-') + ' seats'"></p>
            <div class="flex gap-1 mt-auto">
              <button class="btn btn-ghost btn-xs" @click="occupy(t)" x-show="t.status === 'free'">Seat</button>
              <button class="btn btn-ghost btn-xs" @click="clearTable(t)" x-show="t.status === 'occupied'">Clear</button>
              <button class="btn btn-ghost btn-xs" @click="setStatus(t, t.status === 'cleaning' ? 'free' : 'cleaning')" x-text="t.status === 'cleaning' ? 'Open' : 'Clean'"></button>
            </div>
          </div>
        </template>
      </div>
    </section>

    <!-- ── Reservations ── -->
    <section class="card mt-4" aria-labelledby="res-title">
      <SectionHeading title="Reservations" id="res-title" />
      <div x-show="resLoading" class="space-y-2">
        <template x-for="i in 3" :key="i"><div class="skeleton-shimmer h-10 rounded-lg" aria-hidden="true"></div></template>
      </div>
      <div x-show="!resLoading && reservations.length === 0" class="text-center py-8 opacity-50 text-sm">
        No reservations yet.
      </div>
      <div x-show="!resLoading && reservations.length > 0" class="overflow-x-auto">
        <table class="fusion-table">
          <thead><tr><th>Guest</th><th>Party</th><th>Table</th><th>Time</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <template x-for="r in reservations" :key="r.id">
              <tr>
                <td x-text="r.guest_name || r.guest"></td>
                <td x-text="r.party_size || '-'"></td>
                <td x-text="r.table ? r.table.name || r.table : '-'"></td>
                <td x-text="shortDate(r.reservation_time)"></td>
                <td><span class="badge badge-sm" :class="resBadge(r.status)" x-text="r.status"></span></td>
                <td>
                  <button class="btn btn-ghost btn-xs" @click="reserveAction(r, 'cancel')" x-show="r.status === 'confirmed'">Cancel</button>
                  <button class="btn btn-ghost btn-xs" @click="reserveAction(r, 'seat')" x-show="r.status === 'confirmed'">Seat</button>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
      <p x-show="error" class="note mt-2" style="color: var(--color-error)" x-text="error"></p>
    </section>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';

  document.addEventListener('alpine:init', () => {
    Alpine.data('tablesPage', () => ({
      tables: [],
      reservations: [],
      floor: {},
      floorLoading: true,
      tablesLoading: true,
      resLoading: true,
      error: '',

      statusBadge(status) {
        return { free: 'badge-success', occupied: 'badge-warning', reserved: 'badge-info', cleaning: 'badge-neutral', closed: 'badge-neutral' }[status] || 'badge-neutral';
      },
      resBadge(status) {
        return { confirmed: 'badge-info', seated: 'badge-success', completed: 'badge-neutral', cancelled: 'badge-neutral', no_show: 'badge-error' }[status] || 'badge-neutral';
      },
      shortDate(iso) {
        if (!iso) return '-';
        return new Date(iso).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
      },

      async loadTables() {
        this.tablesLoading = true;
        try {
          const res = await fetch('/tables');
          if (res.ok) this.tables = await res.json();
        } catch { this.error = 'Could not load tables'; }
        this.tablesLoading = false;
      },
      async loadFloor() {
        this.floorLoading = true;
        try {
          const res = await fetch('/tables/floor');
          if (res.ok) this.floor = await res.json();
        } catch { /* optional */ }
        this.floorLoading = false;
      },
      async loadReservations() {
        this.resLoading = true;
        try {
          const res = await fetch('/reservations');
          if (res.ok) this.reservations = await res.json();
        } catch { this.error = 'Could not load reservations'; }
        this.resLoading = false;
      },
      async loadAll() {
        await Promise.all([this.loadTables(), this.loadFloor(), this.loadReservations()]);
      },
      async init() { await this.loadAll(); },

      async openCreate() {
        const name = prompt('Table name (e.g. T12):');
        if (!name) return;
        const section = prompt('Section (optional):') || '';
        const capacity = parseInt(prompt('Capacity:', '4'), 10) || 4;
        const res = await fetch('/tables', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, section, capacity }),
        });
        if (res.ok) { await this.loadTables(); await this.loadFloor(); }
        else this.error = 'Could not create table';
      },

      async occupy(t) {
        const res = await fetch(`/tables/${t.id}/occupy`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
        if (res.ok) await this.loadAll(); else this.error = 'Could not seat table (open sale required)';
      },
      async clearTable(t) {
        const res = await fetch(`/tables/${t.id}/clear`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
        if (res.ok) await this.loadAll(); else this.error = 'Could not clear table';
      },
      async setStatus(t, status) {
        const res = await fetch(`/tables/${t.id}/status`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status }) });
        if (res.ok) await this.loadAll(); else this.error = 'Status change failed';
      },
      async reserveAction(r, action) {
        const res = await fetch(`/reservations/${r.id}/${action}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
        if (res.ok) await this.loadReservations(); else this.error = `${action} failed`;
      },
    }));
  });

  Alpine.start();
</script>

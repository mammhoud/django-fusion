---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/ui/Icon.astro';
---

<Layout title="Data & Analytics · Formint POS">
  <div
    x-data="dataDashboard()"
    x-init="load()"
    class="max-w-[96rem] mx-auto p-4"
  >
    <!-- Header Bar -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
      <div>
        <h1 class="flex items-center gap-2 text-lg font-extrabold" style="color: var(--color-text-primary)">
          <Icon name="chart-line" class="h-5 w-5" style="color: var(--color-chart-1)" />
          Data & Analytics
        </h1>
        <p class="text-xs opacity-50 mt-0.5">Revenue trends, top sellers, and category mix from completed sales.</p>
      </div>
      <div class="flex items-center gap-2">
        <div class="flex items-center rounded-lg p-0.5" style="background: var(--color-surface-raised)">
          <button
            @click="switchPeriod(7)"
            :class="period === 7 ? 'btn btn-sm tag--primary' : 'btn btn-ghost btn-sm'"
            class="text-xs font-medium transition-all"
          >7d</button>
          <button
            @click="switchPeriod(30)"
            :class="period === 30 ? 'btn btn-sm tag--primary' : 'btn btn-ghost btn-sm'"
            class="text-xs font-medium transition-all"
          >30d</button>
          <button
            @click="switchPeriod(90)"
            :class="period === 90 ? 'btn btn-sm tag--primary' : 'btn btn-ghost btn-sm'"
            class="text-xs font-medium transition-all"
          >90d</button>
        </div>
        <button
          @click="compare = !compare"
          :class="compare ? 'btn btn-sm tag--primary' : 'btn btn-ghost btn-sm'"
          class="gap-1 transition-all"
          :title="compare ? 'Hide previous period' : 'Compare with previous period'"
        >
          <span class="inline-block w-2 h-2 rounded-full transition-all"
            :style="compare ? 'background:var(--color-chart-6);box-shadow:0 0 0 3px color-mix(in oklab, var(--color-chart-6) 25%, transparent)' : 'background:var(--color-text-secondary);opacity:.5'"></span>
          <span>Compare</span>
        </button>
        <button @click="load()" class="btn btn-ghost btn-sm gap-1" :disabled="loading">
          <span x-show="loading" class="inline-block h-3 w-3 animate-spin rounded-full border-2 border-current border-t-transparent"></span>
          <svg x-show="!loading" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-refresh" /></svg>
          <span>Refresh</span>
        </button>
      </div>
    </div>

    <!-- Loading skeleton -->
    <div x-show="loading" class="space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <template x-for="i in 3" :key="i">
          <div class="skeleton-shimmer h-24 rounded-xl" aria-hidden="true"></div>
        </template>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div class="skeleton-shimmer h-72 rounded-xl lg:col-span-2" aria-hidden="true"></div>
        <div class="skeleton-shimmer h-72 rounded-xl" aria-hidden="true"></div>
      </div>
    </div>

    <div x-show="!loading">
      <!-- KPI Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div class="card p-5 space-y-3">
          <div class="flex items-center gap-4">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center" style="background: color-mix(in oklab, var(--color-chart-1) 12%, transparent); color: var(--color-chart-1)">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-receipt" /></svg>
            </div>
            <div>
              <div class="text-2xl font-extrabold tabular-nums" x-text="summary.total_orders" style="color: var(--color-text-primary)">0</div>
              <div class="text-xs opacity-50 mt-0.5">Total Orders</div>
            </div>
          </div>
          <!-- Orders sparkline -->
          <svg x-show="daily.length > 1" viewBox="0 0 120 36" preserveAspectRatio="none" class="w-full h-9 block" aria-hidden="true">
            <path :d="sparkArea('orders')" fill="var(--color-chart-1)" opacity="0.12"></path>
            <path :d="sparkPath('orders')" fill="none" stroke="var(--color-chart-1)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></path>
            <path x-show="compare && prevHasData()" :d="prevSparkPath('orders')" fill="none" stroke="var(--color-chart-6)" stroke-width="1.5" stroke-dasharray="4 3" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" opacity="0.85"></path>
          </svg>
          <div x-show="daily.length > 1" class="flex justify-between text-[10px] opacity-40 tabular-nums">
            <span x-text="shortDate(daily[0].date)"></span>
            <span x-text="trendLabel(sparkValues('orders'))"></span>
            <span x-text="shortDate(daily[daily.length - 1].date)"></span>
          </div>
        </div>
        <div class="card p-5 space-y-3">
          <div class="flex items-center gap-4">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center" style="background: color-mix(in oklab, var(--color-chart-3) 12%, transparent); color: var(--color-chart-3)">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-banknote" /></svg>
            </div>
            <div>
              <div class="text-2xl font-extrabold tabular-nums" x-text="'$' + money(summary.total_revenue)" style="color: var(--color-text-primary)">$0</div>
              <div class="text-xs opacity-50 mt-0.5">Total Revenue</div>
            </div>
          </div>
          <!-- Revenue sparkline -->
          <svg x-show="daily.length > 1" viewBox="0 0 120 36" preserveAspectRatio="none" class="w-full h-9 block" aria-hidden="true">
            <path :d="sparkArea('revenue')" fill="var(--color-chart-3)" opacity="0.12"></path>
            <path :d="sparkPath('revenue')" fill="none" stroke="var(--color-chart-3)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></path>
            <path x-show="compare && prevHasData()" :d="prevSparkPath('revenue')" fill="none" stroke="var(--color-chart-6)" stroke-width="1.5" stroke-dasharray="4 3" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" opacity="0.85"></path>
          </svg>
          <div x-show="daily.length > 1" class="flex justify-between text-[10px] opacity-40 tabular-nums">
            <span x-text="shortDate(daily[0].date)"></span>
            <span x-text="trendLabel(sparkValues('revenue'))"></span>
            <span x-text="shortDate(daily[daily.length - 1].date)"></span>
          </div>
        </div>
        <div class="card p-5 space-y-3">
          <div class="flex items-center gap-4">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center" style="background: color-mix(in oklab, var(--color-chart-4) 12%, transparent); color: var(--color-chart-4)">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-trending-up" /></svg>
            </div>
            <div>
              <div class="text-2xl font-extrabold tabular-nums" x-text="'$' + money(summary.average_order_value)" style="color: var(--color-text-primary)">$0</div>
              <div class="text-xs opacity-50 mt-0.5">Avg Order Value</div>
            </div>
          </div>
          <!-- AOV sparkline -->
          <svg x-show="daily.length > 1" viewBox="0 0 120 36" preserveAspectRatio="none" class="w-full h-9 block" aria-hidden="true">
            <path :d="sparkArea('aov')" fill="var(--color-chart-4)" opacity="0.12"></path>
            <path :d="sparkPath('aov')" fill="none" stroke="var(--color-chart-4)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></path>
            <path x-show="compare && prevHasData()" :d="prevSparkPath('aov')" fill="none" stroke="var(--color-chart-6)" stroke-width="1.5" stroke-dasharray="4 3" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" opacity="0.85"></path>
          </svg>
          <div x-show="daily.length > 1" class="flex justify-between text-[10px] opacity-40 tabular-nums">
            <span x-text="shortDate(daily[0].date)"></span>
            <span x-text="trendLabel(sparkValues('aov'))"></span>
            <span x-text="shortDate(daily[daily.length - 1].date)"></span>
          </div>
        </div>
      </div>

      <!-- Sparkline legend (comparison mode) -->
      <div x-show="compare && prevHasData()" class="flex items-center gap-2 mb-4 text-[11px] opacity-60">
        <svg viewBox="0 0 40 8" class="w-10 h-2 block" aria-hidden="true">
          <path d="M 0 5 L 17 5" stroke="var(--color-text-secondary)" stroke-width="2" stroke-linecap="round"></path>
          <path d="M 23 5 L 40 5" stroke="var(--color-chart-6)" stroke-width="1.5" stroke-dasharray="4 3" stroke-linecap="round"></path>
        </svg>
        <span>solid = current period · dashed = previous period</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">
        <!-- Revenue bar chart -->
        <div class="card p-5 lg:col-span-2">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-bold" style="color: var(--color-text-primary)">Daily Revenue</h2>
            <div class="flex items-center gap-2">
              <span x-show="compare && compareDelta() !== null"
                class="tag tag--sm"
                :class="compareDelta() !== null && compareDelta() >= 0 ? 'tag--success' : 'tag--error'"
                x-text="compareDeltaText()"></span>
              <span class="text-[11px] opacity-40 tabular-nums" x-text="dailyRange()"></span>
            </div>
          </div>
          <div x-show="daily.length === 0" class="text-center py-14 opacity-50 text-sm">
            No completed sales in the selected period yet.
          </div>
          <div x-show="daily.length > 0" class="flex items-end gap-1.5 h-52 overflow-x-auto pb-1" style="min-width: 0;">
            <template x-for="(d, i) in daily" :key="d.date + i">
              <div class="group relative flex flex-col items-center flex-1 min-w-[22px] h-full" :title="barTitle(i)">
                <!-- Fixed-height bar area: both series anchored to the same baseline -->
                <div class="relative w-full flex-1 flex items-end justify-center">
                  <!-- Previous-period transparent overlay bar -->
                  <div
                    x-show="compare && prevRevenue(i) > 0"
                    class="absolute bottom-0 w-full rounded-t-md transition-all duration-300"
                    :style="'height:' + barHeight(prevRevenue(i)) + '%;background:linear-gradient(180deg, color-mix(in oklab, var(--color-chart-6) 55%, transparent), color-mix(in oklab, var(--color-chart-6) 12%, transparent));border-top:1px dashed var(--color-chart-6);'"
                  ></div>
                  <!-- Current-period bar -->
                  <div
                    class="relative w-full rounded-t-md transition-all duration-300 group-hover:opacity-80"
                    :style="'height:' + barHeight(d.revenue) + '%;' + (isPeak(d.revenue) ? 'background:linear-gradient(180deg, color-mix(in oklab, var(--color-chart-1) 78%, white), var(--color-chart-1));' : 'background:linear-gradient(180deg, color-mix(in oklab, var(--color-chart-1) 70%, transparent), var(--color-chart-1));')"
                  ></div>
                  <span class="absolute -top-5 text-[10px] font-bold tabular-nums opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap"
                    style="color: var(--color-text-primary)" x-text="'$' + money(d.revenue)"></span>
                </div>
                <span class="text-[9px] mt-1 opacity-40 tabular-nums shrink-0" x-text="shortDate(d.date)"></span>
              </div>
            </template>
          </div>
          <!-- Legend -->
          <div class="flex flex-wrap gap-4 mt-3 text-[11px] opacity-60">
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm" style="background:var(--color-chart-1)"></span> Current period</span>
            <span class="inline-flex items-center gap-1.5" x-show="compare"><span class="w-2.5 h-2.5 rounded-sm" style="background:var(--color-chart-6);opacity:.6"></span> Previous period</span>
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm" style="background:color-mix(in oklab, var(--color-chart-1) 60%, white)"></span> Peak day</span>
          </div>
        </div>

        <!-- Category distribution -->
        <div class="card p-5">
          <h2 class="text-sm font-bold mb-4" style="color: var(--color-text-primary)">Category Mix</h2>
          <div x-show="distribution.length === 0" class="text-center py-14 opacity-50 text-sm">No category data yet.</div>
          <div x-show="distribution.length > 0" class="space-y-3">
            <template x-for="c in distribution" :key="c.name">
              <div>
                <div class="flex justify-between text-xs mb-1">
                  <span class="font-medium truncate pr-2" style="color: var(--color-text-primary)" x-text="c.name"></span>
                  <span class="tabular-nums opacity-60" x-text="c.value + ' sold'"></span>
                </div>
                <div class="h-2 rounded-full overflow-hidden" style="background: var(--color-surface-raised)">
                  <div
                    class="h-full rounded-full transition-all duration-500"
                    :style="'width:' + pct(c.value) + '%; background:' + colorFor(c.name) + ';'"
                  ></div>
                </div>
              </div>
            </template>
          </div>
          <div class="mt-4 pt-3 border-t" style="border-color: var(--color-border-subtle)">
            <div class="flex justify-between text-xs">
              <span class="opacity-50">Top category</span>
              <span class="font-semibold" x-text="topCategory()" style="color: var(--color-text-primary)">-</span>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <!-- Top products -->
        <div class="card lg:col-span-2 overflow-hidden">
          <div class="flex items-center justify-between p-5 pb-3">
            <h2 class="flex items-center gap-1.5 text-sm font-bold" style="color: var(--color-text-primary)">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-chart-1)" aria-hidden="true"><use href="#i-chart-bar" /></svg>
              Top Products
            </h2>
            <div class="flex items-center gap-3">
              <span class="inline-flex items-center gap-1.5 text-[11px] opacity-60" x-show="compare">
                <span class="w-2.5 h-2.5 rounded-sm" style="background:var(--color-chart-6);opacity:.6"></span> Previous period
              </span>
              <a href="/pos/products/" class="text-xs font-medium hover:opacity-70 transition-opacity" style="color: var(--color-primary)">View all →</a>
            </div>
          </div>
          <div x-show="topProducts.length === 0" class="text-center py-12 opacity-50 text-sm">No sales yet.</div>
          <div x-show="topProducts.length > 0" class="overflow-x-auto">
            <table class="data-table">
              <thead>
                <tr>
                  <th>#</th><th>Product</th><th>Units Sold</th><th>Revenue</th>
                  <th class="w-40" x-show="compare">Previous</th>
                  <th class="w-32">Share</th>
                </tr>
              </thead>
              <tbody>
                <template x-for="(p, i) in topProducts" :key="p.name + i">
                  <tr>
                    <td class="px-4 py-2">
                      <span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-[11px] font-bold"
                        :class="i < 3 ? 'text-white' : ''"
                        :style="i < 3 ? 'background:var(--color-chart-1)' : 'background:var(--color-surface-raised);color:var(--color-text-secondary)'"
                        x-text="i + 1"></span>
                    </td>
                    <td class="px-4 py-2"><span class="text-xs font-medium" style="color: var(--color-text-primary)" x-text="p.name"></span></td>
                    <td class="px-4 py-2"><span class="text-xs tabular-nums" x-text="p.sales"></span></td>
                    <td class="px-4 py-2"><span class="text-xs tabular-nums font-semibold" style="color: var(--color-success)" x-text="'$' + money(p.revenue)"></span></td>
                    <!-- Previous-period column (comparison mode) -->
                    <td class="px-4 py-2" x-show="compare">
                      <template x-if="prevProductRevenue(p.name) > 0">
                        <div class="flex items-center gap-2">                            <div class="flex-1 min-w-[3.5rem]">
                            <div class="h-1.5 rounded-full overflow-hidden" style="background: var(--color-surface-raised)">
                              <div class="h-full rounded-full transition-all duration-500" :style="'width:' + prevShare(p.name) + '%;background:var(--color-chart-6);opacity:.55;'"></div>
                            </div>
                            <div class="flex items-center justify-between mt-0.5">
                              <span class="text-[10px] tabular-nums" style="color:var(--color-chart-6)" x-text="'$' + money(prevProductRevenue(p.name))"></span>
                              <span class="text-[10px] tabular-nums opacity-50" x-text="prevProductSales(p.name) + ' sold'"></span>
                            </div>
                          </div>
                          <span class="tag tag--sm shrink-0"
                            :class="prevDelta(p.name, p.revenue) >= 0 ? 'tag--success' : 'tag--error'"
                            x-text="prevDeltaLabel(p.name, p.revenue)"></span>
                        </div>
                      </template>
                      <template x-if="prevProductRevenue(p.name) <= 0">
                        <span class="text-[10px] opacity-40 italic" title="No sales in the previous period">-</span>
                      </template>
                    </td>
                    <td class="px-4 py-2">
                      <div class="flex items-center gap-2">
                        <div class="flex-1 h-1.5 rounded-full overflow-hidden" style="background: var(--color-surface-raised)">
                          <div class="h-full rounded-full" :style="'width:' + share(p.revenue) + '%;background:var(--color-chart-3);'"></div>
                        </div>
                        <span class="text-[10px] tabular-nums opacity-50 w-8 text-right" x-text="share(p.revenue) + '%'"></span>
                      </div>
                    </td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Recent transactions -->
        <div class="card p-5">
          <div class="flex items-center justify-between mb-4">
            <h2 class="flex items-center gap-1.5 text-sm font-bold" style="color: var(--color-text-primary)">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-chart-1)" aria-hidden="true"><use href="#i-clock" /></svg>
              Recent Transactions
            </h2>
            <a href="/pos/transactions/" class="text-xs font-medium hover:opacity-70 transition-opacity" style="color: var(--color-primary)">All →</a>
          </div>
          <div x-show="recent.length === 0" class="text-center py-12 opacity-50 text-sm">No recent transactions.</div>
          <div x-show="recent.length > 0" class="space-y-2">
            <template x-for="t in recent" :key="t.id">
              <a :href="'/pos/transactions/'" class="flex items-center justify-between p-2.5 rounded-lg no-underline transition-colors hover:bg-[var(--color-surface-hover)]">
                <div class="flex items-center gap-3 min-w-0">
                  <span class="flex-shrink-0 w-8 h-8 rounded-lg flex items-center justify-center"
                    style="background: color-mix(in oklab, var(--color-chart-1) 10%, transparent); color: var(--color-chart-1)">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-receipt" /></svg>
                  </span>
                  <div class="min-w-0">
                    <div class="text-xs font-medium truncate" style="color: var(--color-text-primary)" x-text="'#' + t.id + ' · ' + (t.items ? t.items.length : 0) + ' items'"></div>
                    <div class="text-[10px] opacity-50 tabular-nums" x-text="t.date + ' ' + (t.time || '')"></div>
                  </div>
                </div>
                <span class="text-xs font-bold tabular-nums shrink-0" style="color: var(--color-success)" x-text="'$' + money(t.total_amount)"></span>
              </a>
            </template>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  import { areaPath, seriesMax, seriesPoints, smoothLine, values } from '../../lib/sparkline';

  // Category bars use the design-token chart palette so they follow theme/dark mode.
  function chartColors(): string[] {
    const cs = getComputedStyle(document.documentElement);
    return ['1', '2', '3', '4', '5', '6', '7'].map((n) =>
      cs.getPropertyValue(`--color-chart-${n}`).trim() || `var(--color-chart-${n})`
    );
  }
  const CATEGORY_COLORS = chartColors();

  document.addEventListener('alpine:init', () => {
    Alpine.data('dataDashboard', () => ({
      loading: true,
      period: 30,
      compare: false,
      summary: { total_orders: 0, total_revenue: 0, average_order_value: 0 },
      previousSummary: { total_orders: 0, total_revenue: 0, average_order_value: 0 },
      daily: [],
      previousDaily: [],
      topProducts: [],
      previousTopProducts: {},   // lookup map: name → {sales, revenue} (prior window)
      distribution: [],
      recent: [],

      money(v) {
        return Number(v || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      },
      shortDate(d) {
        if (!d) return '';
        const parts = String(d).split('-');
        if (parts.length < 3) return String(d).slice(5);
        return `${parts[1]}/${parts[2]}`;
      },
      dailyRange() {
        if (!this.daily.length) return '';
        return `${this.shortDate(this.daily[0].date)} - ${this.shortDate(this.daily[this.daily.length - 1].date)}`;
      },
      prevRevenue(i) {
        const row = this.previousDaily[i];
        return row ? Number(row.revenue || 0) : 0;
      },
      maxRevenue() {
        const cur = this.daily.map((d: any) => Number(d.revenue || 0));
        if (this.compare) {
          cur.push(...this.previousDaily.map((p: any) => Number(p.revenue || 0)));
        }
        return Math.max(...cur, 1);
      },
      barHeight(v) {
        return Math.max((Number(v || 0) / this.maxRevenue()) * 100, 2);
      },
      isPeak(v) {
        return Number(v) === this.maxRevenue();
      },
      barTitle(i) {
        const d = this.daily[i];
        let t = `${d.date}, $${this.money(d.revenue)}, ${d.orders} orders`;
        if (this.compare && this.previousDaily[i]) {
          t += `\nPrevious: $${this.money(this.prevRevenue(i))}`;
        }
        return t;
      },
      compareDelta() {
        const cur = Number(this.summary.total_revenue || 0);
        const prev = Number(this.previousSummary.total_revenue || 0);
        if (prev <= 0) return null;
        return Math.round(((cur - prev) / prev) * 1000) / 10;
      },
      compareDeltaText() {
        const d = this.compareDelta();
        if (d === null) return 'vs prev';
        const sign = d > 0 ? '+' : '';
        return `${sign}${d}% vs prev`;
      },
      // ── sparkline helpers (shared lib: ../../lib/sparkline) ──────────
      // Data shaping + scale: series values, then a shared max across the
      // current + previous series (compare mode) so overlays are comparable.
      sparkValues(key: string) {
        return values(this.daily, key);
      },
      prevSparkValues(key: string) {
        return values(this.previousDaily, key);
      },
      sparkMax(key: string) {
        const cur = this.sparkValues(key);
        const all = this.compare ? [...cur, ...this.prevSparkValues(key)] : cur;
        return seriesMax(all);
      },
      // Paths: normalize + Catmull-Rom smooth (120×36 default viewBox).
      sparkPoints(key: string): number[][] {
        return seriesPoints(this.sparkValues(key), this.sparkMax(key));
      },
      prevSparkPoints(key: string): number[][] {
        return seriesPoints(this.prevSparkValues(key), this.sparkMax(key));
      },
      sparkPath(key: string) {
        return smoothLine(this.sparkPoints(key));
      },
      sparkArea(key: string) {
        return areaPath(this.sparkValues(key), this.sparkMax(key));
      },
      // Previous-period dashed overlay (same Catmull-Rom smoothing).
      prevSparkPath(key: string) {
        return smoothLine(this.prevSparkPoints(key));
      },
      prevHasData() {
        // Previous window may be zero-filled (e.g. 90d when seed spans 30d) —
        // don't draw a meaningless flat dashed line in that case.
        return this.previousDaily.some((p: any) =>
          Number(p.revenue || 0) > 0 || Number(p.orders || 0) > 0
        );
      },
      trendLabel(vals: number[]) {
        if (!vals || vals.length < 2) return '';
        const first = vals[0];
        const last = vals[vals.length - 1];
        if (first === last) return 'flat';
        const dir = last > first ? '↗' : '↘';
        if (first === 0) return dir;  // avoid infinite % when baseline is zero
        const pct = Math.round((Math.abs(last - first) / Math.abs(first)) * 100);
        return `${dir} ${Math.min(pct, 999)}%`;
      },
      maxDist() {
        return Math.max(...this.distribution.map((c: any) => Number(c.value || 0)), 1);
      },
      pct(v) {
        return Math.round((Number(v || 0) / this.maxDist()) * 100);
      },
      colorFor(name) {
        let h = 0;
        for (const ch of String(name)) h = (h * 31 + ch.charCodeAt(0)) % CATEGORY_COLORS.length;
        return CATEGORY_COLORS[h];
      },
      topCategory() {
        if (!this.distribution.length) return '-';
        const sorted = [...this.distribution].sort((a: any, b: any) => b.value - a.value);
        return sorted[0].name;
      },
      share(v) {
        const total = this.topProducts.reduce((s: number, p: any) => s + Number(p.revenue || 0), 0);
        return total ? Math.round((Number(v || 0) / total) * 100) : 0;
      },
      // ── previous-period product helpers (comparison column) ──────────
      prevProductRevenue(name) {
        const row = this.previousTopProducts[name];
        return row ? Number(row.revenue || 0) : 0;
      },
      prevProductSales(name) {
        const row = this.previousTopProducts[name];
        return row ? Number(row.sales || 0) : 0;
      },
      prevTotalRevenue() {
        return Object.values(this.previousTopProducts).reduce(
          (s: number, r: any) => s + Number(r.revenue || 0), 0);
      },
      prevShare(name) {
        // Denominator is the FULL previous-window total (not the current
        // top-10 total) — this bar answers "share of the previous period",
        // which is a different scale than the green Share column. Keep it.
        const total = this.prevTotalRevenue();
        return total ? Math.round((this.prevProductRevenue(name) / total) * 100) : 0;
      },
      prevDelta(name, cur) {
        const prev = this.prevProductRevenue(name);
        if (prev <= 0) return null;  // no prior sales — label shows '' (blank)
        return Math.round(((Number(cur || 0) - prev) / prev) * 1000) / 10;
      },
      prevDeltaLabel(name, cur) {
        const d = this.prevDelta(name, cur);
        if (d === null) return '';
        const sign = d > 0 ? '+' : '';
        return `${sign}${d}%`;
      },

      switchPeriod(days) {
        if (this.period === days) return;
        this.period = days;
        this.load();
      },

      async load() {
        this.loading = true;
        try {
          const [analyticsRes, txnRes] = await Promise.all([
            fetch(`/analytics?days=${this.period}`),
            fetch('/transactions?limit=6'),
          ]);
          if (analyticsRes.ok) {
            const a = await analyticsRes.json();
            this.summary = a.summary || this.summary;
            this.previousSummary = a.previous_summary || this.previousSummary;
            this.daily = a.daily_revenue || [];
            this.previousDaily = a.previous_daily_revenue || [];
            this.topProducts = a.top_products || [];
            this.previousTopProducts = a.previous_top_products || {};
            this.distribution = a.product_distribution || [];
          }
          if (txnRes.ok) {
            const t = await txnRes.json();
            this.recent = (t.data || t || []).slice(0, 6);
          }
        } catch (e) {
          console.error('Analytics load error:', e);
        } finally {
          this.loading = false;
        }
      },
    }));
  });
</script>

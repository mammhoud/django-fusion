---
import Layout from '../../layouts/Layout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
---

<Layout title="Purchase Orders · Formint POS">
  <div class="page-shell" x-data="poPage()" x-init="load()">
    <section class="hero">
      <SectionHeading level="h1" eyebrow="Reorder workflow · procurement" title="Purchase Orders" />
      <p class="intro">Create drafts, order from suppliers, and receive stock into inventory. It closes the loop from the inventory forecast.</p>
    </section>

    <section class="card">
      <SectionHeading title="All purchase orders">
        <button slot="actions" class="btn btn-primary btn-sm gap-1" @click="openCreate()">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plus" /></svg>
          Create PO
        </button>
      </SectionHeading>
      <div x-show="loading" class="space-y-2">
        <template x-for="i in 3" :key="i"><div class="skeleton-shimmer h-10 rounded-lg" aria-hidden="true"></div></template>
      </div>
      <div x-show="!loading && orders.length === 0" class="text-center py-10 opacity-50 text-sm">No purchase orders yet.</div>
      <div x-show="!loading && orders.length > 0" class="overflow-x-auto">
        <table class="fusion-table">
          <thead><tr><th>Reference</th><th>Supplier</th><th>Total</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <template x-for="o in orders" :key="o.id">
              <tr>
                <td x-text="o.reference_number || '#' + o.id"></td>
                <td x-text="o.supplier || '-'"></td>
                <td x-text="'$' + (o.total_amount ?? 0).toFixed(2)"></td>
                <td><span class="badge badge-sm" :class="badge(o.status)" x-text="o.status"></span></td>
                <td class="flex gap-1">
                  <button class="btn btn-ghost btn-xs" @click="act(o, 'order')" x-show="o.status === 'draft'">Order</button>
                  <button class="btn btn-ghost btn-xs" @click="act(o, 'receive')" x-show="o.status === 'ordered'">Receive</button>
                  <button class="btn btn-ghost btn-xs" @click="act(o, 'cancel')" x-show="o.status === 'draft' || o.status === 'ordered'">Cancel</button>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
      <p x-show="error" class="note mt-2" style="color: var(--color-error)" x-text="error"></p>
    </section>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';

  document.addEventListener('alpine:init', () => {
    Alpine.data('poPage', () => ({
      orders: [], loading: true, error: '',
      badge(s) { return { draft: 'badge-neutral', ordered: 'badge-info', received: 'badge-success', cancelled: 'badge-error' }[s] || 'badge-neutral'; },
      async load() {
        this.loading = true;
        try { const res = await fetch('/purchase-orders'); if (res.ok) this.orders = await res.json(); } catch { this.error = 'Could not load purchase orders'; }
        this.loading = false;
      },
      async openCreate() {
        const supplierId = prompt('Supplier id:');
        if (!supplierId) return;
        const productId = prompt('Product id:');
        if (!productId) return;
        const qty = parseInt(prompt('Quantity:', '10'), 10) || 10;
        const res = await fetch('/purchase-orders', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ supplier_id: parseInt(supplierId, 10), items: [{ product_id: parseInt(productId, 10), quantity: qty }] }),
        });
        if (res.ok) await this.load(); else this.error = 'Create failed (check supplier/product ids)';
      },
      async act(o, action) {
        const res = await fetch(`/purchase-orders/${o.id}/${action}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
        if (res.ok) await this.load(); else this.error = `${action} failed`;
      },
    }));
  });
  Alpine.start();
</script>

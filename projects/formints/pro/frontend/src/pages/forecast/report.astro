---
import Layout from '../../layouts/Layout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
---

<Layout title="Forecast · Formint POS">
  <div class="page-shell" x-data="forecastPage()" x-init="load()">
    <section class="hero">
      <SectionHeading level="h1" eyebrow="AI Forecasting · advisory analytics" title="Forecast" />
      <p class="intro">Demand projections, reorder recommendations, and stock advisories. Read-only, so the numbers never touch your register.</p>
    </section>

    <!-- Demand -->
    <section class="card" aria-labelledby="demand-title">
      <SectionHeading title="Top movers" id="demand-title">
        <button slot="actions" class="btn btn-ghost btn-sm" @click="load()">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-refresh" /></svg>
          Refresh</button>
      </SectionHeading>
      <div x-show="demandLoading" class="space-y-2">
        <template x-for="i in 5" :key="i"><div class="skeleton-shimmer h-10 rounded-lg" aria-hidden="true"></div></template>
      </div>
      <div x-show="!demandLoading && demand.products.length === 0" class="text-center py-8 opacity-50 text-sm">No sales history to forecast yet.</div>
      <div x-show="!demandLoading && demand.products.length > 0" class="overflow-x-auto">
        <table class="fusion-table">
          <thead><tr><th>Product</th><th>Daily avg</th><th>Trend</th><th>Projected 14d</th><th>Stock</th></tr></thead>
          <tbody>
            <template x-for="p in demand.products.slice(0, 12)" :key="p.product_id">
              <tr>
                <td x-text="p.product_name"></td>
                <td x-text="p.avg_daily_units"></td>
                <td><span class="badge badge-sm" :class="p.trend_factor >= 1 ? 'badge-success' : 'badge-neutral'" x-text="'×' + p.trend_factor"></span></td>
                <td x-text="p.projected_days_total"></td>
                <td x-text="p.current_stock"></td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Reorders -->
    <section class="card mt-4" aria-labelledby="reorder-title">
      <SectionHeading title="Reorder recommendations" id="reorder-title">
        <button slot="actions" class="btn btn-primary btn-sm" @click="openReorder()">Generate POs</button>
      </SectionHeading>
      <div x-show="!stockLoading && stock.reorders.length === 0" class="text-center py-8 opacity-50 text-sm">No reorders needed. Stock is healthy.</div>
      <div x-show="!stockLoading && stock.reorders.length > 0" class="overflow-x-auto">
        <table class="fusion-table">
          <thead><tr><th>Product</th><th>Stock</th><th>Cover</th><th>Suggested</th><th>Reason</th></tr></thead>
          <tbody>
            <template x-for="r in stock.reorders" :key="r.product_id">
              <tr>
                <td x-text="r.product_name"></td>
                <td x-text="r.current_stock"></td>
                <td x-text="r.days_of_cover ?? '-'"></td>
                <td><span class="font-bold" x-text="r.suggested_reorder_quantity"></span></td>
                <td class="text-xs opacity-60" x-text="r.reason"></td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
      <p x-show="error" class="note mt-2" style="color: var(--color-error)" x-text="error"></p>
    </section>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';

  document.addEventListener('alpine:init', () => {
    Alpine.data('forecastPage', () => ({
      demand: { products: [] }, stock: { reorders: [] },
      demandLoading: true, stockLoading: true, error: '',
      async loadDemand() {
        this.demandLoading = true;
        try { const res = await fetch('/forecast/demand'); if (res.ok) this.demand = await res.json(); } catch { /* optional */ }
        this.demandLoading = false;
      },
      async loadStock() {
        this.stockLoading = true;
        try { const res = await fetch('/forecast/stock'); if (res.ok) this.stock = await res.json(); } catch { /* optional */ }
        this.stockLoading = false;
      },
      async load() { await Promise.all([this.loadDemand(), this.loadStock()]); },
      async openReorder() {
        const supplierId = prompt('Supplier id (optional, defaults to first active):');
        const body: any = {};
        if (supplierId) body.supplier_id = parseInt(supplierId, 10);
        const res = await fetch('/forecast/inventory/reorder', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (res.ok) { this.error = ''; await this.loadStock(); }
        else { const err = await res.json().catch(() => ({})); this.error = err.error || 'Reorder failed'; }
      },
    }));
  });
  Alpine.start();
</script>

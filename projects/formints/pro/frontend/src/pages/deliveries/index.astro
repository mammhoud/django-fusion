---
import Layout from '../../layouts/Layout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
---

<Layout title="Deliveries · Formint POS">
  <div class="page-shell" x-data="deliveriesPage()" x-init="load()">
    <section class="hero">
      <SectionHeading level="h1" eyebrow="Delivery integration · platform connectors" title="Deliveries" />
      <p class="intro">Dispatch orders to Talabat / HungerStation / Careem, advance the lifecycle, and watch KPIs.</p>
    </section>

    <!-- Stats -->
    <section class="card" aria-labelledby="stats-title">
      <SectionHeading title="Delivery stats" id="stats-title">
        <button slot="actions" class="btn btn-ghost btn-sm" @click="load()">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-refresh" /></svg>
          Refresh</button>
      </SectionHeading>
      <div x-show="statsLoading" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <template x-for="i in 4" :key="i"><div class="skeleton-shimmer h-20 rounded-xl" aria-hidden="true"></div></template>
      </div>
      <div x-show="!statsLoading" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="stat-card"><span class="stat-card__title">Active</span><span class="stat-card__value" x-text="stats.active ?? 0"></span></div>
        <div class="stat-card"><span class="stat-card__title">Delivered</span><span class="stat-card__value" x-text="stats.delivered ?? 0" style="color: var(--color-success)"></span></div>
        <div class="stat-card"><span class="stat-card__title">Fee total</span><span class="stat-card__value" x-text="'$' + (stats.fee_total ?? 0).toFixed(2)"></span></div>
        <div class="stat-card"><span class="stat-card__title">Revenue</span><span class="stat-card__value" x-text="'$' + (stats.delivered_revenue ?? 0).toFixed(2)"></span></div>
      </div>
    </section>

    <!-- Orders -->
    <section class="card mt-4">
      <SectionHeading title="Delivery orders">
        <button slot="actions" class="btn btn-primary btn-sm" @click="openDispatch()">Dispatch</button>
      </SectionHeading>
      <div x-show="loading" class="space-y-2">
        <template x-for="i in 3" :key="i"><div class="skeleton-shimmer h-10 rounded-lg" aria-hidden="true"></div></template>
      </div>
      <div x-show="!loading && orders.length === 0" class="text-center py-10 opacity-50 text-sm">No delivery orders.</div>
      <div x-show="!loading && orders.length > 0" class="overflow-x-auto">
        <table class="fusion-table">
          <thead><tr><th>Ref</th><th>Provider</th><th>Customer</th><th>Fee</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <template x-for="o in orders" :key="o.id">
              <tr>
                <td x-text="o.order_id || o.provider_order_id || '#' + o.id"></td>
                <td x-text="o.provider || '-'"></td>
                <td x-text="o.customer_name || '-'"></td>
                <td x-text="'$' + (o.delivery_fee ?? 0).toFixed(2)"></td>
                <td><span class="badge badge-sm" :class="badge(o.status)" x-text="o.status"></span></td>
                <td class="flex gap-1">
                  <button class="btn btn-ghost btn-xs" @click="advance(o)" x-show="o.status === 'pending' || o.status === 'accepted' || o.status === 'preparing'">Advance</button>
                  <button class="btn btn-ghost btn-xs" @click="cancel(o)" x-show="o.status === 'pending' || o.status === 'accepted'">Cancel</button>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
      <p x-show="error" class="note mt-2" style="color: var(--color-error)" x-text="error"></p>
    </section>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';

  document.addEventListener('alpine:init', () => {
    Alpine.data('deliveriesPage', () => ({
      orders: [], stats: {}, loading: true, statsLoading: true, error: '',
      badge(s) {
        return { pending: 'badge-warning', accepted: 'badge-info', preparing: 'badge-info', out_for_delivery: 'badge-warning', delivered: 'badge-success', cancelled: 'badge-neutral', failed: 'badge-error' }[s] || 'badge-neutral';
      },
      async loadOrders() {
        this.loading = true;
        try { const res = await fetch('/deliveries'); if (res.ok) this.orders = await res.json(); } catch { this.error = 'Could not load deliveries'; }
        this.loading = false;
      },
      async loadStats() {
        this.statsLoading = true;
        try { const res = await fetch('/deliveries/stats'); if (res.ok) this.stats = await res.json(); } catch { /* optional */ }
        this.statsLoading = false;
      },
      async load() { await Promise.all([this.loadOrders(), this.loadStats()]); },
      async openDispatch() {
        const provider = prompt('Provider (talabat/hungerstation/careem/manual):') || 'manual';
        const customer = prompt('Customer name:') || 'Guest';
        const address = prompt('Delivery address:') || '';
        const body = { provider, customer_name: customer, delivery_address: address };
        const res = await fetch('/deliveries', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (res.ok) await this.load(); else this.error = 'Dispatch failed (check zone / provider)';
      },
      async advance(o) {
        const next = { pending: 'accepted', accepted: 'preparing', preparing: 'out_for_delivery' }[o.status];
        if (!next) return;
        const res = await fetch(`/deliveries/${o.id}/status`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: next }) });
        if (res.ok) await this.load(); else this.error = 'Advance failed';
      },
      async cancel(o) {
        const res = await fetch(`/deliveries/${o.id}/cancel`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
        if (res.ok) await this.load(); else this.error = 'Cancel failed';
      },
    }));
  });
  Alpine.start();
</script>

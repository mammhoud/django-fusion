---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/ui/Icon.astro';
---

<Layout title="Inventory · Formint POS">
  <div
    x-data="dataTable_inventory('inventory-table', '/inventory/')"
    x-init="init()"
    class="max-w-[96rem] mx-auto p-4"
  >
    <!-- Header Bar -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
      <h1 class="flex items-center gap-2 text-lg font-extrabold" style="color: var(--color-text-primary)">
        <Icon name="database" class="h-5 w-5" style="color: var(--color-primary)" />
        Inventory
      </h1>
      <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
        <input
          type="search"
          x-model="search"
          @input="filter()"
          placeholder="Search inventory…"
          class="input flex-1 sm:w-56 text-xs"
          aria-label="Search inventory"
        />
        <button
          @click="openAdd()"
          class="btn btn-primary btn-sm gap-1"
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plus" /></svg>
          Stock Move
        </button>
      </div>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
      <div class="stat-card">
        <span class="stat-card__title">Total Moves</span>
        <span class="stat-card__value" x-text="total" style="color: var(--color-primary)">0</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__title">Stock In</span>
        <span class="stat-card__value" x-text="items.filter(i => i.transaction_type==='in').length" style="color: var(--color-success)">0</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__title">Stock Out</span>
        <span class="stat-card__value" x-text="items.filter(i => i.transaction_type==='out').length" style="color: var(--color-warning)">0</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__title">Status</span>
        <span class="stat-card__value text-xs" x-text="loading ? 'Loading…' : 'Ready'" style="color: var(--color-success)">Ready</span>
      </div>
    </div>

    <!-- Type filter pills -->
    <div class="flex flex-wrap gap-1 mb-3" role="tablist">
      <template x-for="t in ['All','in','out','adjustment','return','transfer_out','transfer_in','waste','restock']" :key="t">
        <button @click="filterType = t === 'All' ? '' : t; page=1"
          :class="'btn btn-xs ' + ((filterType || 'All') === t ? 'btn-primary' : 'btn-ghost')"
          x-text="t === 'All' ? 'All Types' : t.replace(/_/g,' ').replace(/\b\w/g, l => l.toUpperCase())">
        </button>
      </template>
    </div>

    <!-- Data Table -->
    <div x-show="loading" class="space-y-2">
      <template x-for="i in 5" :key="i">
        <div class="skeleton-shimmer h-10 rounded" aria-hidden="true"></div>
      </template>
    </div>

    <div x-show="!loading && filteredItems.length === 0" class="text-center py-12 opacity-50 text-sm">
      No inventory records found.
      <span x-show="search || filterType"> Try a different filter.</span>
    </div>

    <div x-show="!loading && filteredItems.length > 0" class="card overflow-x-auto">
      <table class="data-table" role="grid">
        <thead>
          <tr><th>ID</th><th>Product</th><th>Qty</th><th>Type</th><th>Reference</th><th>Date</th><th>By</th><th class="w-20">Actions</th></tr>
        </thead>
        <tbody>
          <template x-for="item in pagedItems()" :key="item.id">
            <tr class="cursor-pointer hover:bg-[var(--color-surface-hover)]" @click="openEdit(item)">
              <td class="px-3 py-2"><span x-text="item.id" class="text-xs tabular-nums"></span></td>
              <td class="px-3 py-2"><span x-text="item.product_name || item.product || '-'" class="text-xs font-medium"></span></td>
              <td class="px-3 py-2"><span x-text="item.quantity" class="text-xs tabular-nums"></span></td>
              <td class="px-3 py-2">
                <span class="badge" :class="{ 'badge-soft-success': item.transaction_type==='in'||item.transaction_type==='restock', 'badge-soft-error': item.transaction_type==='out'||item.transaction_type==='waste', 'badge-soft-warning': item.transaction_type==='adjustment', 'badge-soft-info': item.transaction_type==='transfer_out'||item.transaction_type==='transfer_in'||item.transaction_type==='return' }" x-text="(item.transaction_type||'').replace(/_/g,' ').replace(/\b\w/g, l => l.toUpperCase())"></span>
              </td>
              <td class="px-3 py-2"><span x-text="item.reference || '-'" class="text-xs"></span></td>
              <td class="px-3 py-2"><span x-text="item.created_at || item.date || '-'" class="text-xs"></span></td>
              <td class="px-3 py-2"><span x-text="item.created_by || '-'" class="text-xs"></span></td>
              <td class="px-3 py-2">
                <div class="flex gap-1">
                  <button @click.stop="openEdit(item)" class="btn btn-ghost btn-xs px-1.5" title="Edit" aria-label="Edit"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-pencil" /></svg></button>
                  <button @click.stop="confirmDelete(item)" class="btn btn-ghost btn-xs px-1.5" title="Delete" aria-label="Delete"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-trash" /></svg></button>
                </div>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
      <!-- Pagination -->
      <div class="flex items-center justify-between p-3 border-t border-[var(--color-border-subtle)] text-xs">
        <span x-text="`Showing ${(page-1)*perPage + 1}–${Math.min(page*perPage, filteredItems.length)} of ${filteredItems.length}`"></span>
        <div class="flex gap-1">
          <button @click="page = Math.max(1, page-1)" :disabled="page === 1" class="btn btn-ghost btn-xs">← Prev</button>
          <button @click="page++" :disabled="page * perPage >= filteredItems.length" class="btn btn-ghost btn-xs">Next →</button>
        </div>
      </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div
      x-show="deleteTarget"
      x-transition.opacity
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/40"
      @click.self="deleteTarget = null"
    >
      <div class="card max-w-sm mx-4 p-6 text-center space-y-4">
        <p class="font-semibold">Delete this record?</p>
        <p class="text-sm opacity-60" x-text="deleteTarget?.product_name || deleteTarget?.id"></p>
        <div class="flex gap-2 justify-center">
          <button @click="deleteTarget = null" class="btn btn-ghost btn-sm">Cancel</button>
          <button @click="doDelete()" class="btn btn-error btn-sm">Delete</button>
        </div>
      </div>
    </div>

    <!-- Add/Edit Form Modal -->
    <div
      x-show="formOpen"
      x-transition.opacity.duration.200ms
      class="fixed inset-0 z-[60] flex items-start justify-center pt-[10vh] bg-black/50 px-4 overflow-y-auto"
      @click.self="closeForm()"
      @keydown.escape.window="closeForm()"
    >
      <div
        class="card w-full max-w-xl p-6 space-y-5 shadow-2xl"
        x-transition.scale.90.duration.200ms
        @click.stop
      >
        <div class="flex items-center justify-between">
          <h2 class="text-base font-bold" x-text="editingItem ? 'Edit Stock Move' : 'New Stock Move'"></h2>
          <button @click="closeForm()" class="btn btn-ghost btn-sm" aria-label="Close"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-x" /></svg></button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Product -->
          <div class="sm:col-span-2">
            <label class="text-xs font-medium opacity-70 mb-1 block">Product *</label>
            <select x-model="form.product_id" class="input w-full" required>
              <option value="">- Select product -</option>
              <template x-for="p in productList" :key="p.id">
                <option :value="p.id" x-text="p.name + ' (' + (p.stock_quantity??0) + ' in stock)'"></option>
              </template>
            </select>
          </div>
          <!-- Transaction Type -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Type *</label>
            <select x-model="form.transaction_type" class="input w-full" required>
              <option value="in">Stock In</option>
              <option value="out">Stock Out</option>
              <option value="adjustment">Adjustment</option>
              <option value="return">Return</option>
              <option value="transfer_out">Transfer Out</option>
              <option value="transfer_in">Transfer In</option>
              <option value="waste">Waste / Disposal</option>
              <option value="restock">Restock (from return)</option>
            </select>
          </div>
          <!-- Quantity -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Quantity *</label>
            <input type="number" x-model="form.quantity" class="input w-full" min="0" step="1" placeholder="0" required />
          </div>
          <!-- Reference -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Reference</label>
            <input type="text" x-model="form.reference" class="input w-full" placeholder="e.g. PO-1234" />
          </div>
          <!-- Created By -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Performed By</label>
            <input type="text" x-model="form.created_by" class="input w-full" placeholder="Staff name" />
          </div>
          <!-- Shipping Fee -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Shipping Fee</label>
            <input type="number" x-model="form.shipping_fee" class="input w-full" step="0.01" min="0" placeholder="0.00" />
          </div>
          <!-- Inventory ID -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Inventory Location</label>
            <input type="text" x-model="form.inventory_id" class="input w-full" placeholder="main" />
          </div>
          <!-- Notes -->
          <div class="sm:col-span-2">
            <label class="text-xs font-medium opacity-70 mb-1 block">Notes</label>
            <textarea x-model="form.notes" class="input w-full" rows="2" placeholder="Reason for stock move…"></textarea>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex gap-2 justify-end pt-2 border-t border-[var(--color-border-subtle)]">
          <button @click="closeForm()" class="btn btn-ghost btn-sm" :disabled="formSaving">Cancel</button>
          <button @click="doSave()" class="btn btn-primary btn-sm gap-1" :disabled="formSaving">
            <span x-show="formSaving" class="inline-block h-3 w-3 animate-spin rounded-full border-2 border-current border-t-transparent"></span>
            <span x-text="editingItem ? 'Update' : 'Record'"></span>
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';

  document.addEventListener('alpine:init', () => {
    Alpine.data('dataTable_inventory', (id, endpoint) => ({
      items: [],
      productList: [],
      loading: true,
      search: '',
      filterType: '',
      page: 1,
      perPage: 20,
      deleteTarget: null,
      formOpen: false,
      formSaving: false,
      editingItem: null,
      form: {
        product_id: '', transaction_type: 'in', quantity: '',
        reference: '', created_by: '', shipping_fee: '0',
        inventory_id: 'main', notes: '',
      },

      get total() { return this.items.length; },
      get filteredItems() {
        let list = this.items;
        if (this.search) {
          const q = this.search.toLowerCase();
          list = list.filter((i: any) => Object.values(i).some(v => String(v).toLowerCase().includes(q)));
        }
        if (this.filterType) list = list.filter((i: any) => i.transaction_type === this.filterType);
        return list;
      },
      get filteredCount() { return this.filteredItems.length; },
      pagedItems() {
        const start = (this.page - 1) * this.perPage;
        return this.filteredItems.slice(start, start + this.perPage);
      },

      async init() {
        await Promise.all([this.load(), this.loadProducts()]);
      },

      async load() {
        this.loading = true;
        try {
          const res = await fetch(endpoint as string);
          if (res.ok) {
            const data = await res.json();
            this.items = data.data || data || [];
          }
        } catch (e) {
          console.error('Load error:', e);
        } finally {
          this.loading = false;
        }
      },

      async loadProducts() {
        try {
          const res = await fetch('/products/');
          if (res.ok) {
            const data = await res.json();
            this.productList = data.data || data || [];
          }
        } catch (e) { /* non-critical */ }
      },

      filter() {
        this.page = 1;
      },

      resetForm() {
        this.form = {
          product_id: '', transaction_type: 'in', quantity: '',
          reference: '', created_by: '', shipping_fee: '0',
          inventory_id: 'main', notes: '',
        };
        this.editingItem = null;
      },

      openAdd() {
        this.resetForm();
        this.formOpen = true;
      },

      openEdit(item: any) {
        this.resetForm();
        this.editingItem = item;
        this.form = {
          product_id: item.product_id ?? item.product ?? '',
          transaction_type: item.transaction_type || 'in',
          quantity: item.quantity ?? '',
          reference: item.reference || '',
          created_by: item.created_by || '',
          shipping_fee: item.shipping_fee ?? '0',
          inventory_id: item.inventory_id || 'main',
          notes: item.notes || '',
        };
        this.formOpen = true;
      },

      closeForm() {
        if (this.formSaving) return;
        this.formOpen = false;
        this.resetForm();
      },

      async doSave() {
        if (!this.form.product_id || !this.form.quantity) {
          this.$store.ui.toast('Product and quantity are required', 'error');
          return;
        }
        this.formSaving = true;
        const payload = {
          product_id: parseInt(String(this.form.product_id)),
          transaction_type: this.form.transaction_type,
          quantity: parseInt(String(this.form.quantity)) || 0,
          reference: this.form.reference,
          created_by: this.form.created_by,
          shipping_fee: parseFloat(String(this.form.shipping_fee)) || 0,
          inventory_id: this.form.inventory_id || 'main',
          notes: this.form.notes,
        };

        try {
          let res;
          if (this.editingItem) {
            res = await fetch(`${endpoint}${this.editingItem.id}/`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
          } else {
            res = await fetch(endpoint as string, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
          }
          if (res.ok) {
            this.$store.ui.toast(this.editingItem ? 'Record updated' : 'Stock move recorded', 'success');
            this.closeForm();
            await this.load();
          } else {
            const err = await res.text();
            this.$store.ui.toast('Save failed: ' + (err || res.status), 'error');
          }
        } catch (e) {
          this.$store.ui.toast('Network error', 'error');
        } finally {
          this.formSaving = false;
        }
      },

      confirmDelete(item: any) {
        this.deleteTarget = item;
      },

      async doDelete() {
        if (!this.deleteTarget) return;
        const id = this.deleteTarget.id;
        this.deleteTarget = null;
        try {
          const res = await fetch(`${endpoint}${id}/`, { method: 'DELETE' });
          if (res.ok) {
            this.items = this.items.filter((i: any) => i.id !== id);
            this.$store.ui.toast('Deleted', 'success');
          }
        } catch (e) {
          this.$store.ui.toast('Delete failed', 'error');
        }
      },
    }));
  });
</script>

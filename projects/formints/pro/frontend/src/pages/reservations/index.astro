---
import Layout from '../../layouts/Layout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
---

<Layout title="Reservations · Formint POS">
  <div class="page-shell" x-data="reservationsPage()" x-init="load()">
    <section class="hero">
      <SectionHeading level="h1" eyebrow="Restaurant operations · bookings" title="Reservations" />
      <p class="intro">Book tables, seat confirmed reservations, and manage no-shows.</p>
    </section>

    <section class="card">
      <SectionHeading title="All reservations">
        <button slot="actions" class="btn btn-primary btn-sm gap-1" @click="openBook()">
          <span>+</span> Book table
        </button>
      </SectionHeading>

      <div x-show="loading" class="space-y-2">
        <template x-for="i in 3" :key="i"><div class="skeleton-shimmer h-10 rounded-lg" aria-hidden="true"></div></template>
      </div>
      <div x-show="!loading && items.length === 0" class="text-center py-10 opacity-50 text-sm">No reservations yet.</div>
      <div x-show="!loading && items.length > 0" class="overflow-x-auto">
        <table class="fusion-table">
          <thead><tr><th>Guest</th><th>Party</th><th>Table</th><th>Time</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <template x-for="r in items" :key="r.id">
              <tr>
                <td x-text="r.guest_name || r.guest || '-'"></td>
                <td x-text="r.party_size || '-'"></td>
                <td x-text="r.table?.name || r.table || '-'"></td>
                <td x-text="shortDate(r.reservation_time)"></td>
                <td><span class="badge badge-sm" :class="badge(r.status)" x-text="r.status"></span></td>
                <td class="flex gap-1">
                  <button class="btn btn-ghost btn-xs" @click="act(r, 'seat')" x-show="r.status === 'confirmed'">Seat</button>
                  <button class="btn btn-ghost btn-xs" @click="act(r, 'complete')" x-show="r.status === 'seated'">Complete</button>
                  <button class="btn btn-ghost btn-xs" @click="act(r, 'cancel')" x-show="r.status === 'confirmed'">Cancel</button>
                  <button class="btn btn-ghost btn-xs" @click="act(r, 'no-show')" x-show="r.status === 'confirmed'">No-show</button>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
      <p x-show="error" class="note mt-2" style="color: var(--color-error)" x-text="error"></p>
    </section>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';

  document.addEventListener('alpine:init', () => {
    Alpine.data('reservationsPage', () => ({
      items: [], loading: true, error: '',
      badge(s) { return { confirmed: 'badge-info', seated: 'badge-success', completed: 'badge-neutral', cancelled: 'badge-neutral', no_show: 'badge-error' }[s] || 'badge-neutral'; },
      shortDate(iso) { if (!iso) return '-'; return new Date(iso).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }); },
      async load() {
        this.loading = true;
        try {
          const res = await fetch('/reservations');
          if (res.ok) this.items = await res.json();
        } catch { this.error = 'Could not load reservations'; }
        this.loading = false;
      },
      async openBook() {
        const guest = prompt('Guest name:');
        if (!guest) return;
        const party = parseInt(prompt('Party size:', '2'), 10) || 2;
        const tableId = prompt('Table id (optional):');
        const time = prompt('Reservation time (ISO, optional):');
        const body: any = { guest_name: guest, party_size: party };
        if (tableId) body.table_id = parseInt(tableId, 10);
        if (time) body.reservation_time = time;
        const res = await fetch('/reservations', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (res.ok) await this.load(); else this.error = 'Booking failed (table may be occupied)';
      },
      async act(r, action) {
        const res = await fetch(`/reservations/${r.id}/${action}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
        if (res.ok) await this.load(); else this.error = `${action} failed`;
      },
    }));
  });
  Alpine.start();
</script>

---
/**
 * FusionForm — reusable form-field renderer (django-fusion forms as data).
 *
 * Consumes the server Components API (`/api/v1/components/forms/<resource>/`)
 * which returns field metadata (name, label, input_type, choices, required)
 * plus the declared layout. Renders semantic fields bound to an Alpine form
 * model, with per-field validation helpers and a submit slot.
 *
 * Usage:
 *   <FusionForm resource="product" formKey="productForm" />
 *   <FusionForm
 *     fields={[{name:'name',label:'Name',input_type:'text',required:true}]}
 *     layout={[['name','sku'],['price']]}
 *   />
 *
 * The Alpine data component is registered as `fusionFormComp` and drives:
 *   - `form[field]` values (two-way bound)
 *   - `errors[field]` messages from `validate()`
 *   - `submitForm(url)` → POST with CSRF + toast on the enclosing page
 */
interface FieldDef {
  name: string;
  label?: string;
  input_type?: string;
  required?: boolean;
  help_text?: string;
  choices?: { value: string; label: string }[];
}

interface Props {
  resource?: string;
  fields?: FieldDef[];
  layout?: string[][];
  formKey?: string;
  class?: string;
  'data-skeleton-label'?: string;
}

const {
  resource,
  fields: staticFields,
  layout: staticLayout,
  formKey = 'fusionForm',
  class: className = '',
  'data-skeleton-label': skeletonLabel,
} = Astro.props;

const dataResource = resource || null;
const initialFields = JSON.stringify(staticFields || null);
const initialLayout = JSON.stringify(staticLayout || null);
---

<div
  class={`fusion-form ${className}`.trim()}
  x-data="fusionFormComp({
    resource: $el.dataset.resource || null,
    initialFields: $el.dataset.fields || null,
    initialLayout: $el.dataset.layout || null,
    formKey: $el.dataset.formKey || 'fusionForm',
  })"
  x-init="init()"
  data-resource={dataResource}
  data-fields={initialFields !== 'null' ? initialFields : undefined}
  data-layout={initialLayout !== 'null' ? initialLayout : undefined}
  data-form-key={formKey}
  data-skeleton-label={skeletonLabel}
  x-cloak
>
  <!-- Loading skeleton -->
  <div x-show="loading" class="fusion-skeleton fusion-skeleton--form" aria-hidden="true" data-skeleton>
    <div class="fusion-skeleton--form__grid">
      <template x-for="i in 4" :key="i">
        <span class="fusion-skeleton__field">
          <span class="fusion-skeleton__line" style="width:40%;height:0.8rem" />
          <span class="fusion-skeleton__line" style="height:2.4rem" />
        </span>
      </template>
    </div>
  </div>

  <form x-show="!loading" @submit.prevent="onSubmit($event)" class="fusion-form__fields" novalidate>
    <template x-for="row in layoutRows" :key="row.join('-')">
      <div class="fusion-form__row" :class="row.length > 1 ? 'grid sm:grid-cols-2 gap-4' : ''">
        <template x-for="name in row" :key="name">
          <div class="fusion-form__field" :data-field="name">
            <label class="fusion-form__label" :for="name">
              <span x-text="fieldLabel(name)"></span>
              <span x-show="isRequired(name)" class="text-[var(--color-error)]" aria-hidden="true"> *</span>
            </label>
            <template x-if="fieldType(name) === 'textarea'">
              <textarea :id="name" :name="name" class="input w-full" rows="3"
                x-model="form[name]" :required="isRequired(name)"></textarea>
            </template>
            <template x-else-if="fieldType(name) === 'select'">
              <select :id="name" :name="name" class="input w-full"
                x-model="form[name]" :required="isRequired(name)">
                <option value="">- Select -</option>
                <template x-for="opt in fieldChoices(name)" :key="opt.value">
                  <option :value="opt.value" x-text="opt.label"></option>
                </template>
              </select>
            </template>
            <template x-else-if="fieldType(name) === 'checkbox'">
              <label class="flex items-center gap-3">
                <button type="button" @click="form[name] = !form[name]"
                  :class="form[name] && 'switch--on'" class="switch" role="switch" :aria-checked="form[name]">
                  <span class="switch__knob"></span>
                </button>
                <span class="text-xs opacity-60" x-text="form[name] ? 'Yes' : 'No'"></span>
              </label>
            </template>
            <template x-else>
              <input :id="name" :name="name" :type="fieldType(name)" class="input w-full"
                x-model="form[name]" :required="isRequired(name)" />
            </template>
            <p x-show="errors[name]" class="fusion-form__error" x-text="errors[name]"></p>
            <p x-show="helpText(name)" class="fusion-form__help" x-text="helpText(name)"></p>
          </div>
        </template>
      </div>
    </template>

    <div class="fusion-form__actions">
      <slot name="actions" />
    </div>
  </form>
</div>

<script>
  import Alpine from 'alpinejs';

  document.addEventListener('alpine:init', () => {
    Alpine.data('fusionFormComp', (config: any) => ({
      resource: config.resource,
      initialFields: config.initialFields ? JSON.parse(config.initialFields) : null,
      initialLayout: config.initialLayout ? JSON.parse(config.initialLayout) : null,
      formKey: config.formKey,
      fields: [] as any[],
      layoutRows: [] as string[][],
      form: {} as Record<string, any>,
      errors: {} as Record<string, string>,
      loading: true,

      get fieldMap() {
        return Object.fromEntries(this.fields.map((f: any) => [f.name, f]));
      },

      async init() {
        if (this.initialFields) {
          this.fields = this.initialFields;
          this.layoutRows = this.initialLayout && this.initialLayout.length
            ? this.initialLayout
            : [this.fields.map((f: any) => f.name)];
          this.resetForm();
          this.loading = false;
          return;
        }
        if (this.resource) await this.load();
      },

      async load() {
        this.loading = true;
        try {
          const { fusionForm } = await import('../../lib/fusion-api');
          const res = await fusionForm(this.resource as string);
          this.fields = res.data?.fields || [];
          this.layoutRows = res.data?.layout?.length
            ? res.data.layout
            : [this.fields.map((f: any) => f.name)];
          this.resetForm();
        } catch (e) {
          console.error('FusionForm load error:', e);
        } finally {
          this.loading = false;
        }
      },

      resetForm() {
        this.form = {};
        this.errors = {};
        this.fields.forEach((f: any) => {
          this.form[f.name] = f.input_type === 'checkbox' ? false : '';
        });
      },

      fieldLabel(name: string) {
        return this.fieldMap[name]?.label || name.replace(/_/g, ' ').replace(/\b\w/g, (m: string) => m.toUpperCase());
      },
      fieldType(name: string) {
        return this.fieldMap[name]?.input_type || 'text';
      },
      fieldChoices(name: string) {
        return this.fieldMap[name]?.choices || [];
      },
      isRequired(name: string) {
        return !!this.fieldMap[name]?.required;
      },
      helpText(name: string) {
        return this.fieldMap[name]?.help_text || '';
      },

      validate() {
        this.errors = {};
        let valid = true;
        this.fields.forEach((f: any) => {
          const value = this.form[f.name];
          if (f.required && (value === '' || value === null || value === undefined)) {
            this.errors[f.name] = `${f.label || f.name} is required`;
            valid = false;
          }
        });
        return valid;
      },

      onSubmit() {
        if (!this.validate()) return;
        // Parents read the form via the public `submit()` accessor or bind
        // @submit on the enclosing page — no event.detail wiring needed.
        return this.form;
      },

      // Expose for parent pages: <button @click="$store.fusionForm.submit()">
      submit() {
        if (!this.validate()) return false;
        return this.form;
      },
    }));
  });
</script>

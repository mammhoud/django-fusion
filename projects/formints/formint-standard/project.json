{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "formint-pos",
  "root": "projects/formints/formint-standard",
  "projectType": "application",
  "tags": ["product:formint-standard", "type:frontend", "stack:tauri+astro"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build", "cwd": "projects/formints/formint-standard" }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run check", "cwd": "projects/formints/formint-standard" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run test", "cwd": "projects/formints/formint-standard" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run dev", "cwd": "projects/formints/formint-standard" }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run preview", "cwd": "projects/formints/formint-standard" }
    },
    "tauri": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run tauri dev", "cwd": "projects/formints/formint-standard" }
    },
    "build-desktop": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build:desktop", "cwd": "projects/formints/formint-standard" }
    },
    "db-seed": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run db:seed", "cwd": "projects/formints/formint-standard" }
    },
    "db-reset": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run db:reset", "cwd": "projects/formints/formint-standard" }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run test:e2e", "cwd": "projects/formints/formint-standard" }
    }
  }
}

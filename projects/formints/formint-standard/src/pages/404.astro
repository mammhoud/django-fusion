---
// Unknown route — simple fallback that returns the user to the app.
const home = '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Not Found · Formint</title>
  </head>
  <body>
    <main style="font-family: system-ui; padding: 3rem 2rem; text-align: center">
      <h1 style="font-size: 1.5rem">Page not found</h1>
      <p style="color: #666">The page you're looking for doesn't exist.</p>
      <p>
        <a href={home} style="color: #ea580c">← Back to Formint</a>
      </p>
    </main>
  </body>
</html>

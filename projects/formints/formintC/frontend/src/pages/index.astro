---
import Layout from '@/layouts/Layout.astro';
import { fetchCatalog, FALLBACK_CATALOG } from '@/lib/api';

// Catalog fetched at build/dev from the Django backend, with a static fallback
// so `astro build` is never blocked by an offline backend.
let catalog = FALLBACK_CATALOG;
try {
  catalog = await fetchCatalog();
} catch (e) {
  catalog = FALLBACK_CATALOG;
}

const featured = catalog.products.filter((p) => p.is_featured).slice(0, 4);
const shop = catalog.shop;
---

<Layout title={shop.name} description={shop.tagline}>
  <!-- Hero — asymmetric split: copy left, floating mark right -->
  <section class="container-fusion grid items-center gap-12 pb-20 pt-16 lg:grid-cols-[1.1fr_0.9fr] lg:pt-24">
    <div>
      <p class="tag-marker mb-4 flex items-center gap-2">
        <span class="live-dot" aria-hidden="true"></span>
        Open now · Mon–Sun 7:00 → 19:00
      </p>
      <h1 class="font-display text-5xl font-bold leading-[1.02] tracking-tighter text-fu-ink md:text-6xl">
        {shop.tagline.split('.')[0]}.
        <span class="block text-fu-muted">Order ahead, pick up fast.</span>
      </h1>
      <p class="mt-6 max-w-[46ch] text-lg leading-relaxed text-fu-muted">
        A single shop page: menu, cart, checkout, and order status — served as
        finished HTML with HTMX swaps and Alpine micro-interactions. No SPA, no
        wait.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#menu" class="btn-primary">Browse the menu</a>
        <a href="/accounts/signup/" class="btn-ghost">Create an account</a>
      </div>
      <dl class="mt-12 grid max-w-md grid-cols-3 gap-6 border-t border-fu-line pt-6">
        <div>
          <dt class="font-mono text-[0.65rem] uppercase tracking-widest text-fu-muted">Roast</dt>
          <dd class="mt-1 font-display text-2xl font-bold text-fu-ink">weekly</dd>
        </div>
        <div>
          <dt class="font-mono text-[0.65rem] uppercase tracking-widest text-fu-muted">Pickup</dt>
          <dd class="mt-1 font-display text-2xl font-bold text-fu-ink">8 min</dd>
        </div>
        <div>
          <dt class="font-mono text-[0.65rem] uppercase tracking-widest text-fu-muted">Items</dt>
          <dd class="mt-1 font-display text-2xl font-bold text-fu-ink">{catalog.products.length}</dd>
        </div>
      </dl>
    </div>

    <!-- Floating mark — perpetual micro-interaction, isolated (transform-only) -->
    <div class="relative mx-auto w-full max-w-sm lg:max-w-none">
      <div class="float-slow relative mx-auto aspect-square w-64 rounded-[2.5rem] border border-fu-line bg-fu-card shadow-diffusion sm:w-80">
        <div class="absolute inset-0 flex items-center justify-center">
          <svg class="h-32 w-32" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <circle cx="16" cy="16" r="13" fill="hsl(var(--fu-link) / 0.12)" />
            <path d="M8 12l6 6-6 6" stroke="hsl(var(--fu-ink))" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="21" cy="13" r="3" fill="hsl(var(--fu-link))" />
            <path d="M21 16v7" stroke="hsl(var(--fu-link))" stroke-width="2.2" stroke-linecap="round" />
          </svg>
        </div>
        <span class="absolute right-6 top-6 h-2 w-2 rounded-full bg-fu-mark" style="animation: breathe 2.4s ease-in-out infinite"></span>
      </div>
      <div class="float-slow absolute -right-2 top-6 rounded-2xl border border-fu-line bg-fu-card px-4 py-3 shadow-diffusion" style="animation-delay: 0.6s">
        <p class="font-mono text-[0.6rem] uppercase tracking-widest text-fu-muted">Featured</p>
        <p class="text-sm font-semibold text-fu-ink">{featured[0]?.name || 'Espresso'}</p>
      </div>
      <div class="float-slow absolute -left-4 bottom-10 rounded-2xl border border-fu-line bg-fu-card px-4 py-3 shadow-diffusion" style="animation-delay: 1.2s">
        <p class="font-mono text-[0.6rem] uppercase tracking-widest text-fu-muted">Subtotal</p>
        <p class="font-mono text-sm font-bold text-fu-ink">$0.00</p>
      </div>
    </div>
  </section>

  <!-- Menu — category pills drive an HTMX product grid -->
  <section id="menu" class="border-t border-fu-line bg-fu-card/60 py-16">
    <div class="container-fusion">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="tag-marker">Menu</p>
          <h2 class="mt-1 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl">
            Choose your order
          </h2>
        </div>
        <p class="max-w-[38ch] text-sm text-fu-muted">
          Add items to your cart — the badge and drawer update via HTMX without a page reload.
        </p>
      </div>

      <!-- Category pills (HTMX-powered grid below) -->
      <div
        id="category-pills"
        class="mt-8 flex flex-wrap gap-2"
        x-data="{ active: '' }"
      >
        <button
          type="button"
          class="rounded-full border px-4 py-2 text-sm font-medium transition-colors"
          :class="active === '' ? 'border-fu-ink bg-fu-ink text-fu-paper' : 'border-fu-line text-fu-ink hover:bg-fu-line/40'"
          @click="active = ''; htmx.trigger('#product-grid', 'filterChanged')"
          data-category=""
        >
          All
        </button>
        {catalog.categories.map((c) => (
          <button
            type="button"
            class="rounded-full border px-4 py-2 text-sm font-medium transition-colors"
            :class="active === {`'${c.slug}'`} ? 'border-fu-ink bg-fu-ink text-fu-paper' : 'border-fu-line text-fu-ink hover:bg-fu-line/40'"
            @click="active = {`'${c.slug}'`}; htmx.trigger('#product-grid', 'filterChanged')"
            data-category={c.slug}
          >
            {c.name}
          </button>
        ))}
      </div>

      <!-- Product grid — swapped from the Django backend fragment -->
      <div
        id="product-grid"
        class="mt-6"
        hx-get="/shop/fragments/products/"
        hx-trigger="load, filterChanged from:#category-pills"
        hx-vals="js:{ category: document.querySelector('#category-pills [data-category].border-fu-ink')?.dataset.category || '' }"
        hx-swap="innerHTML"
        hx-indicator="#grid-indicator"
      >
        <!-- Fallback SSR grid (renders even before HTMX swaps) -->
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {catalog.products.map((p) => (
            <article class="group relative flex flex-col overflow-hidden rounded-3xl border border-fu-line/70 bg-fu-card p-4 shadow-diffusion transition-all duration-300 hover:-translate-y-1">
              <div class="mb-3 flex aspect-[4/3] items-center justify-center rounded-2xl bg-fu-line/30">
                <span class="font-mono text-3xl font-semibold text-fu-muted/50">{p.name.slice(0, 1)}</span>
              </div>
              <div class="flex flex-1 flex-col">
                <div class="flex items-start justify-between gap-2">
                  <h3 class="text-sm font-semibold leading-snug text-fu-ink">{p.name}</h3>
                  <span class="shrink-0 font-mono text-sm font-bold text-fu-ink">${p.price}</span>
                </div>
                {p.tags.length > 0 && (
                  <div class="mt-2 flex flex-wrap gap-1">
                    {p.tags.map((t) => (
                      <span class="rounded-full bg-fu-line/40 px-2 py-0.5 font-mono text-[0.6rem] uppercase tracking-wider text-fu-muted">{t}</span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
      <div id="grid-indicator" class="htmx-indicator mt-4">
        <div class="skeleton-shimmer h-1 w-32 rounded-full"></div>
      </div>
    </div>
  </section>

  <!-- Employee / account strip -->
  <section class="container-fusion py-16">
    <div class="grid gap-6 md:grid-cols-2">
      <a href="/orders/mine/" class="card-sheet group transition-all duration-300 hover:-translate-y-1">
        <p class="tag-marker">Customers</p>
        <h3 class="mt-2 font-display text-xl font-bold tracking-tight text-fu-ink">Your order history</h3>
        <p class="mt-2 text-sm text-fu-muted">Sign in to track every pickup, reorder favourites, and keep your details on file.</p>
        <span class="mt-4 inline-block text-sm font-semibold text-fu-link group-hover:text-fu-ink">View my orders →</span>
      </a>
      <a href="/employee/" class="card-sheet group transition-all duration-300 hover:-translate-y-1">
        <p class="tag-marker">Team</p>
        <h3 class="mt-2 font-display text-xl font-bold tracking-tight text-fu-ink">Staff desk</h3>
        <p class="mt-2 text-sm text-fu-muted">A live order inbox for the floor — new orders, prep queue, and daily totals, gated behind staff auth.</p>
        <span class="mt-4 inline-block text-sm font-semibold text-fu-link group-hover:text-fu-ink">Open the desk →</span>
      </a>
    </div>
  </section>
</Layout>

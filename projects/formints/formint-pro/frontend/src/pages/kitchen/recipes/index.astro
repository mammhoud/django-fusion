---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/ui/Icon.astro';
---

<Layout title="Recipes - Formint POS">
  <div x-data="recipesPage()" x-init="load()" class="max-w-[96rem] mx-auto p-4">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
      <h1 class="flex items-center gap-2 text-lg font-extrabold" style="color: var(--color-text-primary)">
        <Icon name="book" class="h-5 w-5" style="color: var(--color-chart-4)" />
        Recipes & Ingredients
      </h1>
      <div class="flex flex-wrap items-center gap-2">
        <input type="search" x-model="search" @input="page=1" placeholder="Search recipes..." class="input flex-1 sm:w-56 text-xs" />
        <button @click="tab='recipes'; openAdd()" class="btn btn-primary btn-sm gap-1"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plus" /></svg> Recipe</button>
        <button @click="tab='ingredients'; openAdd()" class="btn btn-ghost btn-sm gap-1"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plus" /></svg> Ingredient</button>
      </div>
    </div>
    <!-- Tabs -->
    <div class="tabs tabs-bordered mb-3">
      <button @click="tab='recipes'; page=1" :class="'tab tab-sm '+(tab==='recipes'?'tab-active':'')">Recipes</button>
      <button @click="tab='ingredients'; page=1" :class="'tab tab-sm '+(tab==='ingredients'?'tab-active':'')">Ingredients</button>
    </div>
    <div x-show="loading" class="space-y-2"><template x-for="i in 5" :key="i"><div class="skeleton-shimmer h-10 rounded"></div></template></div>

    <!-- Recipes Table -->
    <div x-show="!loading && tab==='recipes'" class="card overflow-x-auto">
      <table class="data-table" role="grid">
        <thead><tr><th>ID</th><th>Product</th><th>Recipe Name</th><th>Yield</th><th>Active</th><th class="w-20">Actions</th></tr></thead>
        <tbody>
          <template x-for="item in pagedRecipes()" :key="item.id">
            <tr class="cursor-pointer hover:bg-[var(--color-surface-hover)]">
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.id"></span></td>
              <td class="px-3 py-2"><span class="text-xs font-medium" x-text="prodName(item.product) || 'Product #'+item.product"></span></td>
              <td class="px-3 py-2"><span class="text-xs" x-text="item.name || '-'" ></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.yield_quantity"></span></td>
              <td class="px-3 py-2"><span class="badge" :class="item.is_active?'badge-soft-success':'badge-soft-error'" x-text="item.is_active?'Active':'Inactive'"></span></td>
              <td class="px-3 py-2"><div class="flex gap-1">
                <button @click.stop="openEdit(item)" class="btn btn-ghost btn-xs px-1.5" title="Edit" aria-label="Edit"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-pencil" /></svg></button>
                <button @click.stop="confirmDelete(item)" class="btn btn-ghost btn-xs px-1.5" title="Delete" aria-label="Delete"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-trash" /></svg></button>
              </div></td>
            </tr>
          </template>
        </tbody>
      </table>
      <div class="flex items-center justify-between p-3 border-t border-[var(--color-border-subtle)] text-xs">
        <span x-text="'Showing ' + ((page-1)*perPage + 1) + '-' + Math.min(page*perPage, filteredRecipes.length) + ' of ' + filteredRecipes.length"></span>
        <div class="flex gap-1">
          <button @click="page=Math.max(1,page-1)" :disabled="page===1" class="btn btn-ghost btn-xs">&larr; Prev</button>
          <button @click="page++" :disabled="page*perPage>=filteredRecipes.length" class="btn btn-ghost btn-xs">Next &rarr;</button>
        </div>
      </div>
    </div>

    <!-- Ingredients Table -->
    <div x-show="!loading && tab==='ingredients'" class="card overflow-x-auto">
      <table class="data-table" role="grid">
        <thead><tr><th>ID</th><th>Name</th><th>Unit</th><th>Stock</th><th>Reorder At</th><th>Cost/Unit</th><th>Active</th><th class="w-20">Actions</th></tr></thead>
        <tbody>
          <template x-for="item in pagedIngredients()" :key="item.id">
            <tr class="cursor-pointer hover:bg-[var(--color-surface-hover)]">
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.id"></span></td>
              <td class="px-3 py-2"><span class="text-xs font-medium" x-text="item.name"></span></td>
              <td class="px-3 py-2"><span class="text-xs" x-text="item.unit"></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums font-medium" :class="Number(item.current_quantity)<=Number(item.reorder_level)?'text-error':'text-success'" x-text="item.current_quantity"></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.reorder_level"></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="'$'+(Number(item.cost_per_unit)||0).toFixed(2)"></span></td>
              <td class="px-3 py-2"><span class="badge" :class="item.is_active?'badge-soft-success':'badge-soft-error'" x-text="item.is_active?'Active':'Inactive'"></span></td>
              <td class="px-3 py-2"><div class="flex gap-1">
                <button @click.stop="openEdit(item)" class="btn btn-ghost btn-xs px-1.5" title="Edit" aria-label="Edit"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-pencil" /></svg></button>
                <button @click.stop="confirmDelete(item)" class="btn btn-ghost btn-xs px-1.5" title="Delete" aria-label="Delete"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-trash" /></svg></button>
              </div></td>
            </tr>
          </template>
        </tbody>
      </table>
      <div class="flex items-center justify-between p-3 border-t border-[var(--color-border-subtle)] text-xs">
        <span x-text="'Showing ' + ((page-1)*perPage + 1) + '-' + Math.min(page*perPage, filteredIngredients.length) + ' of ' + filteredIngredients.length"></span>
        <div class="flex gap-1">
          <button @click="page=Math.max(1,page-1)" :disabled="page===1" class="btn btn-ghost btn-xs">&larr; Prev</button>
          <button @click="page++" :disabled="page*perPage>=filteredIngredients.length" class="btn btn-ghost btn-xs">Next &rarr;</button>
        </div>
      </div>
    </div>

    <div x-show="deleteTarget" x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-black/40" @click.self="deleteTarget=null">
      <div class="card max-w-sm mx-4 p-6 text-center space-y-4">
        <p class="font-semibold" x-text="deleteKind==='recipes' ? 'Delete this recipe?' : 'Delete this ingredient?'"></p>
        <p class="text-sm opacity-60 truncate" x-text="deleteTarget?.name || prodName(deleteTarget?.product) || '#'+deleteTarget?.id"></p>
        <div class="flex gap-2 justify-center">
          <button @click="deleteTarget=null" class="btn btn-ghost btn-sm">Cancel</button>
          <button @click="doDelete()" class="btn btn-error btn-sm">Delete</button>
        </div>
      </div>
    </div>

    <div x-show="formOpen" x-transition.opacity.duration.200ms class="fixed inset-0 z-[60] flex items-start justify-center pt-[8vh] bg-black/50 px-4 overflow-y-auto" @click.self="closeForm()" @keydown.escape.window="closeForm()">
      <div class="card w-full max-w-lg p-6 space-y-5 shadow-2xl" x-transition.scale.90.duration.200ms @click.stop>
        <div class="flex items-center justify-between"><h2 class="text-base font-bold" x-text="(editingItem ? 'Edit ' : 'New ') + (kind==='recipes' ? 'Recipe' : 'Ingredient')"></h2><button @click="closeForm()" class="btn btn-ghost btn-sm" aria-label="Close"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-x" /></svg></button></div>

        <!-- Recipe form -->
        <div x-show="kind==='recipes'" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2">
            <label class="text-xs font-medium opacity-70 mb-1 block">Product *</label>
            <select x-model="form.product" class="input w-full" required>
              <option value="">Select product…</option>
              <template x-for="prod in productList" :key="prod.id"><option :value="prod.id" x-text="prod.name"></option></template>
            </select>
          </div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Recipe name</label><input type="text" x-model="form.name" class="input w-full" placeholder="Optional (auto-derived from product)" /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Yield quantity</label><input type="number" min="0" step="0.01" x-model="form.yield_quantity" class="input w-full" /></div>
          <div class="sm:col-span-2"><label class="text-xs font-medium opacity-70 mb-1 block">Instructions</label><textarea x-model="form.instructions" class="input w-full" rows="4" placeholder="Steps to prepare…"></textarea></div>
          <div class="flex items-center gap-2 sm:col-span-2"><input type="checkbox" x-model="form.is_active" class="rounded" /><label class="text-xs font-medium opacity-70">Active recipe</label></div>
        </div>

        <!-- Ingredient form -->
        <div x-show="kind==='ingredients'" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Name *</label><input type="text" x-model="form.name" class="input w-full" placeholder="e.g. Whole milk" required /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Unit *</label><input type="text" x-model="form.unit" class="input w-full" placeholder="kg, liter, piece" required /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Current quantity</label><input type="number" step="0.001" x-model="form.current_quantity" class="input w-full" /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Reorder at</label><input type="number" step="0.001" x-model="form.reorder_level" class="input w-full" /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Reorder quantity</label><input type="number" step="0.001" x-model="form.reorder_quantity" class="input w-full" /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Cost per unit</label><input type="number" min="0" step="0.01" x-model="form.cost_per_unit" class="input w-full" /></div>
          <div class="flex items-center gap-2 sm:col-span-2"><input type="checkbox" x-model="form.is_active" class="rounded" /><label class="text-xs font-medium opacity-70">Active ingredient</label></div>
        </div>

        <div class="flex gap-2 justify-end pt-2 border-t border-[var(--color-border-subtle)]"><button @click="closeForm()" class="btn btn-ghost btn-sm" :disabled="formSaving">Cancel</button><button @click="doSave()" class="btn btn-primary btn-sm gap-1" :disabled="formSaving"><span x-show="formSaving" class="inline-block h-3 w-3 animate-spin rounded-full border-2 border-current border-t-transparent"></span><span x-text="editingItem ? 'Update' : 'Create'"></span></button></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  document.addEventListener('alpine:init', () => {
    Alpine.data('recipesPage', () => ({
      recipes: [], ingredients: [], productList: [], loading: true, search: '', tab: 'recipes', page: 1, perPage: 20,
      formOpen: false, formSaving: false, editingItem: null, kind: 'recipes', deleteTarget: null, deleteKind: 'recipes',
      form: {},
      get filteredRecipes() { let l = this.recipes; if (this.search) { const q = this.search.toLowerCase(); l = l.filter((i: any) => Object.values(i).some(v => String(v).toLowerCase().includes(q))); } return l; },
      get filteredIngredients() { let l = this.ingredients; if (this.search) { const q = this.search.toLowerCase(); l = l.filter((i: any) => Object.values(i).some(v => String(v).toLowerCase().includes(q))); } return l; },
      pagedRecipes() { const s = (this.page-1)*this.perPage; return this.filteredRecipes.slice(s, s+this.perPage); },
      pagedIngredients() { const s = (this.page-1)*this.perPage; return this.filteredIngredients.slice(s, s+this.perPage); },
      prodName(id: any) { const p = this.productList.find((x: any) => String(x.id) === String(id)); return p ? p.name : ''; },
      async load() { this.loading=true; try { const [rr, ri, rp] = await Promise.all([fetch('/recipes/').then(r=>r.ok?r.json():{data:[]}), fetch('/ingredients/').then(r=>r.ok?r.json():{data:[]}), fetch('/products/').then(r=>r.ok?r.json():{data:[]})]); this.recipes = rr.data || rr || []; this.ingredients = ri.data || ri || []; this.productList = rp.data || rp || []; } catch(e){} finally { this.loading=false; } },
      recipeForm() { return { product: '', name: '', instructions: '', yield_quantity: '1', is_active: true }; },
      ingredientForm() { return { name: '', unit: '', current_quantity: '', reorder_level: '', reorder_quantity: '', cost_per_unit: '', is_active: true }; },
      resetForm(kind: string) { this.kind = kind || this.tab; this.editingItem = null; this.form = this.kind === 'recipes' ? this.recipeForm() : this.ingredientForm(); },
      openAdd() { this.resetForm(this.tab); this.formOpen = true; },
      openEdit(item: any) { const kind = this.tab === 'ingredients' ? 'ingredients' : 'recipes'; this.resetForm(kind); this.editingItem = item; if (kind === 'recipes') { this.form = { product: item.product ?? '', name: item.name || '', instructions: item.instructions || '', yield_quantity: item.yield_quantity ?? '1', is_active: item.is_active !== false }; } else { this.form = { name: item.name || '', unit: item.unit || '', current_quantity: item.current_quantity ?? '', reorder_level: item.reorder_level ?? '', reorder_quantity: item.reorder_quantity ?? '', cost_per_unit: item.cost_per_unit ?? '', is_active: item.is_active !== false }; } this.formOpen = true; },
      closeForm() { if (this.formSaving) return; this.formOpen = false; this.editingItem = null; },
      async doSave() {
        if (this.kind === 'recipes') {
          if (!this.form.product) { this.$store.ui.toast('Product is required', 'error'); return; }
        } else if (!this.form.name.trim() || !this.form.unit.trim()) { this.$store.ui.toast('Name and unit are required', 'error'); return; }
        this.formSaving = true;
        let p: any;
        if (this.kind === 'recipes') {
          p = { product: this.form.product, name: this.form.name, instructions: this.form.instructions, yield_quantity: parseFloat(String(this.form.yield_quantity)) || 1, is_active: this.form.is_active };
        } else {
          p = { name: this.form.name, unit: this.form.unit, current_quantity: parseFloat(String(this.form.current_quantity)) || 0, reorder_level: parseFloat(String(this.form.reorder_level)) || 0, reorder_quantity: parseFloat(String(this.form.reorder_quantity)) || 0, cost_per_unit: parseFloat(String(this.form.cost_per_unit)) || 0, is_active: this.form.is_active };
        }
        const base = this.kind === 'recipes' ? '/recipes/' : '/ingredients/';
        const label = this.kind === 'recipes' ? 'Recipe' : 'Ingredient';
        try {
          let r;
          if (this.editingItem) { r = await fetch(base + this.editingItem.id + '/', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(p) }); }
          else { r = await fetch(base, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(p) }); }
          if (r.ok) { this.$store.ui.toast(this.editingItem ? label + ' updated' : label + ' created', 'success'); this.closeForm(); await this.load(); }
          else { const e = await r.text(); this.$store.ui.toast('Save failed: ' + (e || r.status), 'error'); }
        } catch(e) { this.$store.ui.toast('Network error', 'error'); }
        finally { this.formSaving = false; }
      },
      confirmDelete(item: any) { this.deleteKind = this.tab === 'ingredients' ? 'ingredients' : 'recipes'; this.deleteTarget = item; },
      async doDelete() { if (!this.deleteTarget) return; const id = this.deleteTarget.id; const kind = this.deleteKind; const base = kind === 'recipes' ? '/recipes/' : '/ingredients/'; this.deleteTarget = null; try { await fetch(base + id + '/', { method: 'DELETE' }); if (kind === 'recipes') { this.recipes = this.recipes.filter((i: any) => i.id !== id); } else { this.ingredients = this.ingredients.filter((i: any) => i.id !== id); } this.$store.ui.toast((kind === 'recipes' ? 'Recipe' : 'Ingredient') + ' deleted', 'success'); } catch(e) { this.$store.ui.toast('Failed', 'error'); } },
    }));
  });
</script>

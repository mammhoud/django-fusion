---
import '../../styles/global.css';

interface Props {
  slug: string;
}

const { slug } = Astro.params;
const locale = Astro.url.searchParams.get('locale') || 'en';
const branch = Astro.url.searchParams.get('branch') || '';
const table = Astro.url.searchParams.get('table') || '';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Menu · Formint POS</title>
    <script is:inline>
      (() => {
        try {
          const ui = JSON.parse(localStorage.getItem('formint-ui') || '{}');
          if (ui.mode === 'dark') document.documentElement.classList.add('dark');
        } catch {}
      })();
    </script>
  </head>
  <body
    x-data="menuView()"
    x-init="load()"
    data-slug={slug}
    data-locale={locale}
    data-branch={branch}
    data-table={table}
    class="min-h-screen"
  >
    <main class="max-w-2xl mx-auto px-4 py-8">
      <!-- Header: name + QR -->
      <header class="mb-8 text-center">
        <h1 class="text-2xl font-extrabold" style="color: var(--color-text-primary)" x-text="menu.name || 'Menu'"></h1>
        <p x-show="menu.description" class="text-sm mt-1 opacity-60" x-text="menu.description"></p>
        <div class="mt-4 inline-flex flex-col items-center gap-1">
          <img
            :src="qrUrl"
            alt="Menu QR code"
            width="140"
            height="140"
            class="rounded-lg border border-[var(--color-border-subtle)] bg-white p-1"
          />
          <span class="text-[11px] uppercase tracking-wide opacity-40" x-text="'Scan to order · ' + branchTableLabel"></span>
        </div>
      </header>

      <!-- Loading -->
      <div x-show="isLoading" class="space-y-3">
        <template x-for="i in 3" :key="i">
          <div class="skeleton-shimmer h-24 rounded-xl" aria-hidden="true"></div>
        </template>
      </div>

      <!-- Not found -->
      <div x-show="!isLoading && error" class="text-center py-16 opacity-60 text-sm" x-text="error"></div>

      <!-- Menu categories -->
      <div x-show="!isLoading && !error" class="space-y-8">
        <template x-for="cat in menu.categories" :key="cat.name">
          <section>
            <h2 class="text-sm font-bold uppercase tracking-wider mb-2" style="color: var(--color-text-secondary)" x-text="cat.name"></h2>
            <div class="divide-y divide-[var(--color-border-subtle)]">
              <template x-for="item in cat.items" :key="item.id">
                <div class="py-3 flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2">
                      <span class="font-medium" style="color: var(--color-text-primary)" x-text="item.name"></span>
                      <span x-show="item.is_featured" class="badge badge-primary badge-sm">★</span>
                    </div>
                    <p x-show="item.description" class="text-xs opacity-60 mt-0.5 line-clamp-2" x-text="item.description"></p>
                    <p x-show="item.allergens" class="text-[11px] mt-1 opacity-40" x-text="'Allergens: ' + item.allergens"></p>
                  </div>
                  <div class="text-right shrink-0">
                    <span class="font-bold" style="color: var(--color-text-primary)" x-text="item.currency + ' ' + item.price.toFixed(2)"></span>
                    <p x-show="item.preparation_time" class="text-[11px] opacity-40" x-text="'~' + item.preparation_time + ' min'"></p>
                  </div>
                </div>
              </template>
            </div>
          </section>
        </template>
      </div>
    </main>

    <script>
      import Alpine from 'alpinejs';

      document.addEventListener('alpine:init', () => {
        Alpine.data('menuView', () => ({
          menu: { name: '', description: '', categories: [] },
          isLoading: true,
          error: '',
          qrUrl: '',
          branchTableLabel: 'Public',

          async load() {
            const d = this.$root.dataset;
            const slug = d.slug;
            const locale = d.locale || 'en';
            const branch = d.branch || '';
            const table = d.table || '';

            const qp = new URLSearchParams({ locale });
            if (branch) qp.set('branch', branch);
            if (table) qp.set('table', table);
            this.qrUrl = `/menu/${slug}/qr?${qp.toString()}`;

            const parts = [];
            if (branch) parts.push('Branch ' + branch);
            if (table) parts.push('Table ' + table);
            this.branchTableLabel = parts.join(' · ') || 'Public';

            try {
              const res = await fetch(`/menu/${slug}/?locale=${locale}`);
              if (!res.ok) {
                this.error = 'This menu is not available yet.';
                return;
              }
              this.menu = await res.json();
            } catch (e) {
              this.error = 'Could not load the menu.';
            } finally {
              this.isLoading = false;
            }
          },
        }));
      });

      Alpine.start();
    </script>
  </body>
</html>

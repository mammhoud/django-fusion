---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/ui/Icon.astro';
---

<Layout title="Reports - Formint POS">
  <div x-data="reportsPage()" x-init="load()" class="max-w-[96rem] mx-auto p-4">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
      <div>
        <h1 class="flex items-center gap-2 text-lg font-extrabold" style="color: var(--color-text-primary)">
          <Icon name="chart-bar" class="h-5 w-5" style="color: var(--color-chart-1)" />
          Reports
        </h1>
        <p class="text-xs opacity-50 mt-0.5">Sales summary, payment breakdown, inventory health, and trends.</p>
      </div>
      <button @click="load()" class="btn btn-ghost btn-sm gap-1" :disabled="loading">
        <span x-show="loading" class="inline-block h-3 w-3 animate-spin rounded-full border-2 border-current border-t-transparent"></span>
        <svg x-show="!loading" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-refresh" /></svg>
        <span>Refresh</span>
      </button>
    </div>

    <!-- Loading skeleton -->
    <div x-show="loading" class="space-y-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <template x-for="i in 4" :key="i">
          <div class="skeleton-shimmer h-56 rounded-xl"></div>
        </template>
      </div>
    </div>

    <div x-show="!loading">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

        <!-- Sales Summary Card -->
        <div class="card p-4 space-y-3">
          <h2 class="flex items-center gap-1.5 font-semibold text-sm" style="color: var(--color-text-primary)">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-chart-3)" aria-hidden="true"><use href="#i-banknote" /></svg>
            Sales Summary
          </h2>
          <div class="grid grid-cols-2 gap-2">
            <div class="stat-card">
              <span class="stat-card__title">Total Revenue</span>
              <span class="stat-card__value" x-text="'$' + money(salesData.total_revenue)" style="color: var(--color-success)">$0</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__title">Transactions</span>
              <span class="stat-card__value" x-text="salesData.total_sales" style="color: var(--color-primary)">0</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__title">Avg Order</span>
              <span class="stat-card__value" x-text="'$' + money(salesData.avg_order_value)" style="color: var(--color-info)">$0.00</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__title">Tax Collected</span>
              <span class="stat-card__value" x-text="'$' + money(salesData.tax_collected)" style="color: var(--color-warning)">$0</span>
            </div>
          </div>

          <!-- Smooth revenue trend sparkline (last 7 days) -->
          <div class="pt-1">
            <div class="flex items-center justify-between mb-1">
              <p class="text-xs font-medium opacity-50">7-Day Revenue Trend</p>
              <span class="text-[10px] tabular-nums opacity-40" x-text="trendRange()"></span>
            </div>
            <svg x-show="trendData.length > 1" viewBox="0 0 120 36" preserveAspectRatio="none" class="w-full h-10 block" aria-hidden="true">
              <path :d="trendAreaPath()" fill="var(--color-chart-3)" opacity="0.12"></path>
              <path :d="trendLinePath()" fill="none" stroke="var(--color-chart-3)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></path>
            </svg>
            <div x-show="trendData.length <= 1" class="text-xs opacity-50 italic py-3">Not enough trend data yet.</div>
          </div>

          <!-- Payment method breakdown with revenue bars -->
          <div class="space-y-2 pt-1">
            <p class="text-xs font-medium opacity-50">Payment Methods</p>
            <div x-show="paymentMethods.length === 0" class="text-xs opacity-50 italic">No completed sales yet.</div>
            <template x-for="(pm, idx) in paymentMethods" :key="pm.method">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full flex-shrink-0" :style="'background:' + paymentColor(idx)"></span>
                  <span class="text-xs capitalize flex-1" x-text="pm.method" style="color: var(--color-text-primary)"></span>
                  <span class="text-xs tabular-nums font-semibold" x-text="'$' + money(pm.revenue)" style="color: var(--color-text-primary)"></span>
                  <span class="text-xs opacity-50 tabular-nums w-10 text-right" x-text="pm.count + ' tx'"></span>
                </div>
                <div class="flex items-center gap-2">
                  <div class="flex-1 h-2 rounded-full overflow-hidden" style="background: var(--color-surface-raised)">
                    <div class="h-full rounded-full transition-all duration-500"
                      :style="'width:' + pm.pct + '%;background:' + paymentColor(idx) + ';'"></div>
                  </div>
                  <span class="text-[10px] tabular-nums opacity-50 w-8 text-right" x-text="pm.pct + '%'"></span>
                </div>
              </div>
            </template>
          </div>
        </div>

        <!-- Top Products Card (from /analytics) -->
        <div class="card p-4 space-y-3">
          <h2 class="flex items-center gap-1.5 font-semibold text-sm" style="color: var(--color-text-primary)">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-chart-1)" aria-hidden="true"><use href="#i-chart-bar" /></svg>
            Top Products
          </h2>
          <div x-show="topProducts.length === 0" class="text-center py-12 opacity-50 text-sm">No sales data yet.</div>
          <div x-show="topProducts.length > 0" class="space-y-2">
            <template x-for="(p, idx) in topProducts" :key="p.name">
              <div class="flex items-center gap-3">
                <span class="text-xs font-bold tabular-nums w-5 text-right shrink-0"
                  :class="idx < 3 ? 'text-[var(--color-primary)]' : 'opacity-40'"
                  x-text="'#' + (idx + 1)"></span>
                <span class="flex-1 text-sm font-medium truncate" style="color: var(--color-text-primary)" x-text="p.name"></span>
                <span class="text-xs tabular-nums opacity-50" x-text="p.sales + ' sold'"></span>
                <span class="text-xs tabular-nums font-semibold" style="color: var(--color-success)" x-text="'$' + money(p.revenue)"></span>
              </div>
            </template>
          </div>
        </div>

        <!-- Tax Report Card -->
        <div class="card p-4 space-y-3">
          <h2 class="flex items-center gap-1.5 font-semibold text-sm" style="color: var(--color-text-primary)">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-chart-4)" aria-hidden="true"><use href="#i-receipt" /></svg>
            Tax Summary
          </h2>
          <div class="grid grid-cols-2 gap-2">
            <div class="stat-card">
              <span class="stat-card__title">Taxable Revenue</span>
              <span class="stat-card__value" x-text="'$' + money(taxData.taxable_sales)" style="color: var(--color-primary)">$0</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__title">Tax Collected</span>
              <span class="stat-card__value" x-text="'$' + money(taxData.tax_collected)" style="color: var(--color-warning)">$0</span>
            </div>
          </div>
          <div class="space-y-2 pt-1">
            <div class="flex justify-between text-xs">
              <span class="opacity-50">Effective Tax Rate</span>
              <span class="tabular-nums font-semibold" x-text="taxData.tax_rate + '%'" style="color: var(--color-text-primary)">8%</span>
            </div>
            <div class="flex justify-between text-xs">
              <span class="opacity-50">Transaction Count</span>
              <span class="tabular-nums" x-text="taxData.transactions" style="color: var(--color-text-primary)">0</span>
            </div>
            <div class="flex justify-between text-xs">
              <span class="opacity-50">Avg Tax / Order</span>
              <span class="tabular-nums font-mono" x-text="'$' + money(taxData.avg_tax)" style="color: var(--color-text-primary)">$0.00</span>
            </div>
          </div>
        </div>

        <!-- Inventory Health Card -->
        <div class="card p-4 space-y-3">
          <h2 class="flex items-center gap-1.5 font-semibold text-sm" style="color: var(--color-text-primary)">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-chart-5)" aria-hidden="true"><use href="#i-package" /></svg>
            Inventory Health
          </h2>
          <div class="grid grid-cols-2 gap-2">
            <div class="stat-card">
              <span class="stat-card__title">Total Products</span>
              <span class="stat-card__value" x-text="invData.total_products" style="color: var(--color-primary)">0</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__title">Inventory Value</span>
              <span class="stat-card__value" x-text="'$' + money(invData.total_inventory_value)" style="color: var(--color-success)">$0</span>
            </div>
          </div>
          <div class="space-y-2 pt-1">
            <div class="flex justify-between text-xs">
              <span class="opacity-50">Stock Movements</span>
              <span class="tabular-nums" style="color: var(--color-text-primary)">
                <span style="color: var(--color-success-strong)" x-text="invData.stock_in + ' in'">0 in</span>
                <span class="opacity-50 mx-1">·</span>
                <span style="color: var(--color-error-strong)" x-text="invData.stock_out + ' out'">0 out</span>
              </span>
            </div>
            <div class="flex justify-between text-xs">
              <span class="opacity-50">Low Stock Alerts</span>
              <span class="tabular-nums" x-text="invData.low_stock_count"
                :class="invData.low_stock_count > 0 ? 'font-semibold' : ''"
                :style="invData.low_stock_count > 0 ? 'color: var(--color-warning-strong)' : 'color: var(--color-text-primary)'">0</span>
            </div>
            <div class="flex justify-between text-xs">
              <span class="opacity-50">Recent Movements</span>
              <span class="tabular-nums" x-text="invData.recent_count" style="color: var(--color-text-primary)">0</span>
            </div>
            <!-- Low stock detail list -->
            <div x-show="lowStockItems.length > 0" class="pt-2 border-t" style="border-color: var(--color-border-subtle)">
              <p class="flex items-center gap-1 text-[11px] font-medium mb-1" style="color: var(--color-warning-strong)">
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-alert-triangle" /></svg>
                Low Stock Items
              </p>
              <template x-for="item in lowStockItems" :key="item.id">
                <div class="flex items-center justify-between text-[11px] py-0.5">
                  <span class="truncate pr-2" style="color: var(--color-text-primary)" x-text="item.name"></span>
                  <span class="tabular-nums shrink-0">
                    <span class="font-semibold" style="color: var(--color-warning-strong)" x-text="item.stock"></span>
                    <span class="opacity-50" x-text="' / ' + item.threshold"></span>
                  </span>
                </div>
              </template>
            </div>
          </div>
        </div>

        <!-- Daily Sales Trend (real data from /reports/sales) -->
        <div class="card p-4 space-y-3 lg:col-span-2">
          <div class="flex items-center justify-between">
            <h2 class="flex items-center gap-1.5 font-semibold text-sm" style="color: var(--color-text-primary)">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-chart-1)" aria-hidden="true"><use href="#i-chart-line" /></svg>
              Daily Sales Trend (Last 7 Days)
            </h2>
            <span class="text-[11px] opacity-40 tabular-nums" x-text="trendRange()"></span>
          </div>
          <div x-show="trendData.length === 0" class="text-center py-12 opacity-50 text-sm">No sales in the last 7 days.</div>
          <div x-show="trendData.length > 0">
            <!-- Smooth bezier line + area (Catmull-Rom via shared lib) -->
            <div class="relative h-44">
              <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="w-full h-full block" aria-hidden="true">
                <path :d="trendAreaPct()" fill="var(--color-chart-1)" opacity="0.12"></path>
                <path :d="trendLinePct()" fill="none" stroke="var(--color-chart-1)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></path>
              </svg>
              <!-- Per-day dots, aligned to the curve (hover for details) -->
              <template x-for="(day, i) in trendData" :key="day.date + i">
                <div class="absolute -translate-x-1/2 translate-y-1/2 group" :style="dotStyle(i)">
                  <div class="w-2.5 h-2.5 rounded-full transition-transform duration-200 group-hover:scale-150"
                    style="background:var(--color-chart-1);box-shadow:0 0 0 3px color-mix(in oklab, var(--color-chart-1) 25%, transparent)"></div>
                  <span class="absolute -top-8 left-1/2 -translate-x-1/2 text-[10px] font-bold tabular-nums whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity px-1.5 py-0.5 rounded-md pointer-events-none"
                    style="background:var(--color-surface-raised);color:var(--color-text-primary);box-shadow:0 2px 8px rgba(0,0,0,.12)"
                    x-text="'$' + money(day.total) + ' · ' + day.orders + ' orders'"></span>
                </div>
              </template>
            </div>
            <!-- Day labels, evenly spaced to match the dots -->
            <div class="flex justify-between mt-2 text-[10px] opacity-50">
              <template x-for="(day, i) in trendData" :key="'label-' + i">
                <span class="tabular-nums" x-text="day.label"></span>
              </template>
            </div>
            <!-- Legend -->
            <div class="flex flex-wrap gap-4 mt-3 text-[11px] opacity-60">
              <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm" style="background:var(--color-chart-1)"></span> Revenue (USD)</span>
              <span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-full" style="background:var(--color-chart-1)"></span> Daily value, hover for details</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  import { areaPath, linePath, seriesMax, seriesPoints, smoothLine, values } from '../../../lib/sparkline';

  // Categorical payment-method palette (chart tokens, see styles/tokens.css)
  const PAYMENT_COLORS = ['var(--color-chart-1)', 'var(--color-chart-3)', 'var(--color-chart-4)', 'var(--color-chart-5)', 'var(--color-chart-2)', 'var(--color-chart-7)'];

  document.addEventListener('alpine:init', () => {
    Alpine.data('reportsPage', () => ({
      loading: true,
      salesData: {},
      topProducts: [],
      taxData: { taxable_sales: 0, tax_collected: 0, tax_rate: 8, transactions: 0, avg_tax: 0 },
      invData: { total_products: 0, total_inventory_value: 0, stock_in: 0, stock_out: 0, low_stock_count: 0, recent_count: 0 },
      lowStockItems: [],
      trendData: [],
      paymentMethods: [],

      money(v) {
        return Number(v || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      },
      paymentColor(idx) {
        return PAYMENT_COLORS[idx % PAYMENT_COLORS.length];
      },
      trendRange() {
        if (!this.trendData.length) return '';
        return `${this.trendData[0].date} - ${this.trendData[this.trendData.length - 1].date}`;
      },
      // ── smooth sparkline/trend helpers (shared lib: ../../../lib/sparkline) ──
      trendValues() {
        // daily_trend rows are { date, total, orders, label } → metric('revenue')
        // reads row.total via the fallback.
        return values(this.trendData, 'revenue');
      },
      trendMax() {
        return seriesMax(this.trendValues());
      },
      // Compact KPI sparkline (120×36) for the Sales Summary card.
      trendLinePath() {
        return linePath(this.trendValues(), this.trendMax());
      },
      trendAreaPath() {
        return areaPath(this.trendValues(), this.trendMax());
      },
      // Full-width trend chart in a 0–100 percentage viewBox (matches the
      // flex columns, so dots align with the curve exactly).
      trendPts(): number[][] {
        return seriesPoints(this.trendValues(), this.trendMax(), { width: 100, height: 100, padY: 2 });
      },
      trendLinePct() {
        return smoothLine(this.trendPts());
      },
      trendAreaPct() {
        // Reuse the lib's area builder with the same 0–100 percentage space.
        return areaPath(this.trendValues(), this.trendMax(), { width: 100, height: 100, padY: 2 });
      },
      dotStyle(i: number) {
        const pts = this.trendPts();
        if (!pts[i]) return '';
        const [x, y] = pts[i];
        // SVG y is top-down; CSS bottom is bottom-up → flip.
        return `left:${x}%;bottom:${100 - y}%`;
      },

      async load() {
        this.loading = true;
        try {
          const [salesRes, invRes, analyticsRes] = await Promise.all([
            fetch('/reports/sales'),
            fetch('/reports/inventory'),
            fetch('/analytics'),
          ]);

          // ── Sales report ──
          if (salesRes.ok) {
            const s = await salesRes.json();
            this.salesData = s;

            // Payment methods with revenue bars
            const pmList: any[] = [];
            const byPayment = s.by_payment || {};
            const totalRev = Number(s.total_revenue || 0);
            for (const [method, data] of Object.entries(byPayment)) {
              const d = data as any;
              pmList.push({
                method,
                count: d.count || 0,
                revenue: Number(d.revenue || 0),
                pct: totalRev > 0 ? Math.round((Number(d.revenue || 0) / totalRev) * 100) : 0,
              });
            }
            pmList.sort((a, b) => b.revenue - a.revenue);
            this.paymentMethods = pmList;

            // Daily trend
            this.trendData = s.daily_trend || [];

            // Tax data (derived from sales report)
            const taxable = totalRev - (s.tax_collected || 0);
            this.taxData = {
              taxable_sales: Math.max(taxable, 0),
              tax_collected: s.tax_collected || 0,
              tax_rate: 8,
              transactions: s.total_sales || 0,
              avg_tax: (s.total_sales || 0) > 0 ? (s.tax_collected || 0) / s.total_sales : 0,
            };
          }

          // ── Inventory report ──
          if (invRes.ok) {
            const inv = await invRes.json();
            this.invData = {
              total_products: inv.total_products || 0,
              total_inventory_value: inv.total_inventory_value || 0,
              stock_in: inv.stock_in || 0,
              stock_out: inv.stock_out || 0,
              low_stock_count: (inv.low_stock_items || []).length,
              recent_count: (inv.recent_transactions || []).length,
            };
            this.lowStockItems = inv.low_stock_items || [];
          }

          // ── Top products (from analytics) ──
          if (analyticsRes.ok) {
            const a = await analyticsRes.json();
            this.topProducts = (a.top_products || []).slice(0, 6);
          }
        } catch (e) {
          console.error('Reports load error:', e);
        } finally {
          this.loading = false;
        }
      },
    }));
  });
</script>

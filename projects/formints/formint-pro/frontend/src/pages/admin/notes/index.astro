---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/ui/Icon.astro';
---

<Layout title="Notes - Formint POS">
  <div x-data="notesPage()" x-init="load()" class="max-w-[96rem] mx-auto p-4">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
      <h1 class="flex items-center gap-2 text-lg font-extrabold" style="color: var(--color-text-primary)">
        <Icon name="note" class="h-5 w-5" style="color: var(--color-primary)" />
        Notes
      </h1>
      <div class="flex flex-wrap items-center gap-2">
        <input type="search" x-model="search" @input="page=1" placeholder="Search notes..." class="input flex-1 sm:w-56 text-xs" />
        <button @click="openAdd()" class="btn btn-primary btn-sm gap-1">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plus" /></svg>
          New Note
        </button>
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
      <div class="stat-card"><span class="stat-card__title">Total</span><span class="stat-card__value" x-text="total" style="color: var(--color-primary)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Drafts</span><span class="stat-card__value" x-text="draftCount" style="color: var(--color-warning)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Saved</span><span class="stat-card__value" x-text="savedCount" style="color: var(--color-success)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Archived</span><span class="stat-card__value" x-text="archivedCount" style="color: var(--color-text-secondary)">0</span></div>
    </div>
    <div class="flex flex-wrap gap-1 mb-3">
      <template x-for="s in ['All','draft','saved','archived']" :key="s">
        <button @click="filterStatus=s==='All'?'':s; page=1" :class="'btn btn-xs '+((filterStatus||'All')===s?'btn-primary':'btn-ghost')" x-text="s==='All'?'All':s.charAt(0).toUpperCase()+s.slice(1)"></button>
      </template>
    </div>
    <div x-show="loading" class="space-y-2"><template x-for="i in 5" :key="i"><div class="skeleton-shimmer h-10 rounded"></div></template></div>
    <div x-show="!loading && filteredItems.length===0" class="text-center py-12 opacity-50 text-sm">No notes.</div>
    <div x-show="!loading && filteredItems.length>0" class="card overflow-x-auto">
      <table class="data-table" role="grid">
        <thead><tr><th>ID</th><th>Title</th><th>Reference Type</th><th>Reference ID</th><th>Status</th><th>Updated</th><th class="w-20">Actions</th></tr></thead>
        <tbody>
          <template x-for="item in pagedItems()" :key="item.id">
            <tr class="cursor-pointer hover:bg-[var(--color-surface-hover)]">
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.id"></span></td>
              <td class="px-3 py-2"><span class="text-xs font-medium" x-text="item.title || 'Untitled'"></span></td>
              <td class="px-3 py-2"><span class="text-xs" x-text="item.reference_type || '-'"></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.reference_id || '-'"></span></td>
              <td class="px-3 py-2">
                <span class="badge"
                  :class="{ 'badge-soft-warning': item.status==='draft', 'badge-soft-success': item.status==='saved', 'badge-soft-neutral': item.status==='archived' }"
                  x-text="item.status"></span>
              </td>
              <td class="px-3 py-2"><span class="text-xs opacity-50" x-text="item.updated_at?.slice(0,10) || '-'"></span></td>
              <td class="px-3 py-2"><div class="flex gap-1">
                <button @click.stop="openEdit(item)" class="btn btn-ghost btn-xs px-1.5" title="Edit" aria-label="Edit"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-pencil" /></svg></button>
                <button @click.stop="confirmDelete(item)" class="btn btn-ghost btn-xs px-1.5" title="Delete" aria-label="Delete"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-trash" /></svg></button>
              </div></td>
            </tr>
          </template>
        </tbody>
      </table>
      <div class="flex items-center justify-between p-3 border-t border-[var(--color-border-subtle)] text-xs">
        <span x-text="'Showing ' + ((page-1)*perPage + 1) + '-' + Math.min(page*perPage, filteredItems.length) + ' of ' + filteredItems.length"></span>
        <div class="flex gap-1">
          <button @click="page=Math.max(1,page-1)" :disabled="page===1" class="btn btn-ghost btn-xs">&larr; Prev</button>
          <button @click="page++" :disabled="page*perPage>=filteredItems.length" class="btn btn-ghost btn-xs">Next &rarr;</button>
        </div>
      </div>
    </div>

    <div x-show="deleteTarget" x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-black/40" @click.self="deleteTarget=null">
      <div class="card max-w-sm mx-4 p-6 text-center space-y-4">
        <p class="font-semibold">Delete this note?</p>
        <p class="text-sm opacity-60 truncate" x-text="(deleteTarget?.title || 'Note #'+deleteTarget?.id)"></p>
        <div class="flex gap-2 justify-center">
          <button @click="deleteTarget=null" class="btn btn-ghost btn-sm">Cancel</button>
          <button @click="doDelete()" class="btn btn-error btn-sm">Delete</button>
        </div>
      </div>
    </div>

    <div x-show="formOpen" x-transition.opacity.duration.200ms class="fixed inset-0 z-[60] flex items-start justify-center pt-[8vh] bg-black/50 px-4 overflow-y-auto" @click.self="closeForm()" @keydown.escape.window="closeForm()">
      <div class="card w-full max-w-lg p-6 space-y-5 shadow-2xl" x-transition.scale.90.duration.200ms @click.stop>
        <div class="flex items-center justify-between"><h2 class="text-base font-bold" x-text="editingItem ? 'Edit Note' : 'New Note'"></h2><button @click="closeForm()" class="btn btn-ghost btn-sm" aria-label="Close"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-x" /></svg></button></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Title</label><input type="text" x-model="form.title" class="input w-full" placeholder="Short title (optional)" /></div>
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Status</label>
            <select x-model="form.status" class="input w-full">
              <option value="draft">Draft</option>
              <option value="saved">Saved</option>
              <option value="archived">Archived</option>
            </select>
          </div>
          <div class="sm:col-span-2"><label class="text-xs font-medium opacity-70 mb-1 block">Content</label><textarea x-model="form.content" class="input w-full" rows="4" placeholder="Note body…"></textarea></div>
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Reference type</label>
            <select x-model="form.reference_type" class="input w-full">
              <option value="">General</option>
              <option value="cart">Cart</option>
              <option value="inventory">Inventory</option>
              <option value="count">Count</option>
              <option value="order">Order</option>
              <option value="customer">Customer</option>
            </select>
          </div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Reference ID</label><input type="number" min="0" x-model="form.reference_id" class="input w-full" placeholder="Optional entity id" /></div>
          <div class="sm:col-span-2"><label class="text-xs font-medium opacity-70 mb-1 block">Created by</label><input type="text" x-model="form.created_by" class="input w-full" placeholder="User / device name" /></div>
        </div>
        <div class="flex gap-2 justify-end pt-2 border-t border-[var(--color-border-subtle)]"><button @click="closeForm()" class="btn btn-ghost btn-sm" :disabled="formSaving">Cancel</button><button @click="doSave()" class="btn btn-primary btn-sm gap-1" :disabled="formSaving"><span x-show="formSaving" class="inline-block h-3 w-3 animate-spin rounded-full border-2 border-current border-t-transparent"></span><span x-text="editingItem ? 'Update' : 'Create'"></span></button></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  document.addEventListener('alpine:init', () => {
    Alpine.data('notesPage', () => ({
      items: [], loading: true, search: '', filterStatus: '', page: 1, perPage: 20, deleteTarget: null,
      formOpen: false, formSaving: false, editingItem: null,
      form: { title: '', content: '', status: 'draft', reference_type: '', reference_id: '', created_by: '' },
      get total() { return this.items.length; },
      get draftCount() { return this.items.filter((i: any) => i.status==='draft').length; },
      get savedCount() { return this.items.filter((i: any) => i.status==='saved').length; },
      get archivedCount() { return this.items.filter((i: any) => i.status==='archived').length; },
      get filteredItems() { let l = this.items; if (this.search) { const q = this.search.toLowerCase(); l = l.filter((i: any) => Object.values(i).some(v => String(v).toLowerCase().includes(q))); } if (this.filterStatus) l = l.filter((i: any) => i.status===this.filterStatus); return l; },
      pagedItems() { const s = (this.page-1)*this.perPage; return this.filteredItems.slice(s, s+this.perPage); },
      async load() { this.loading=true; try { const r = await fetch('/notes/'); if (r.ok) { const d = await r.json(); this.items = d.data || d || []; } } catch(e){} finally { this.loading=false; } },
      resetForm() { this.form = { title: '', content: '', status: 'draft', reference_type: '', reference_id: '', created_by: '' }; this.editingItem = null; },
      openAdd() { this.resetForm(); this.formOpen = true; },
      openEdit(item: any) { this.resetForm(); this.editingItem = item; this.form = { title: item.title || '', content: item.content || '', status: item.status || 'draft', reference_type: item.reference_type || '', reference_id: item.reference_id ?? '', created_by: item.created_by || '' }; this.formOpen = true; },
      closeForm() { if (this.formSaving) return; this.formOpen = false; this.resetForm(); },
      async doSave() {
        this.formSaving = true;
        const p = {
          title: this.form.title, content: this.form.content, status: this.form.status,
          reference_type: this.form.reference_type,
          reference_id: this.form.reference_id === '' || this.form.reference_id === null ? null : parseInt(String(this.form.reference_id), 10) || null,
          created_by: this.form.created_by,
        };
        try {
          let r;
          if (this.editingItem) { r = await fetch('/notes/' + this.editingItem.id + '/', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(p) }); }
          else { r = await fetch('/notes/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(p) }); }
          if (r.ok) { this.$store.ui.toast(this.editingItem ? 'Note updated' : 'Note created', 'success'); this.closeForm(); await this.load(); }
          else { const e = await r.text(); this.$store.ui.toast('Save failed: ' + (e || r.status), 'error'); }
        } catch(e) { this.$store.ui.toast('Network error', 'error'); }
        finally { this.formSaving = false; }
      },
      confirmDelete(item: any) { this.deleteTarget = item; },
      async doDelete() { if (!this.deleteTarget) return; const id = this.deleteTarget.id; this.deleteTarget = null; try { await fetch('/notes/' + id + '/', { method: 'DELETE' }); this.items = this.items.filter((i: any) => i.id !== id); this.$store.ui.toast('Note deleted', 'success'); } catch(e) { this.$store.ui.toast('Failed', 'error'); } },
    }));
  });
</script>

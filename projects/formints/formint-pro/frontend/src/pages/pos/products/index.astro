---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/ui/Icon.astro';
---

<Layout title="Products · Formint POS">
  <div
    x-data="dataTable_products('products-table', '/products/')"
    x-init="init()"
    class="max-w-[96rem] mx-auto p-4"
  >
    <!-- Header Bar -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
      <h1 class="flex items-center gap-2 text-lg font-extrabold" style="color: var(--color-text-primary)">
        <Icon name="package" class="h-5 w-5" style="color: var(--color-primary)" />
        Products
      </h1>
      <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
        <input
          type="search"
          x-model="search"
          @input="filter()"
          placeholder="Search products…"
          class="input flex-1 sm:w-56 text-xs"
          aria-label="Search products"
        />
        <button
          @click="openAdd()"
          class="btn btn-primary btn-sm gap-1"
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plus" /></svg>
          Add Product
        </button>
      </div>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
      <div class="stat-card">
        <span class="stat-card__title">Total</span>
        <span class="stat-card__value" x-text="total" style="color: var(--color-primary)">0</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__title">Filtered</span>
        <span class="stat-card__value" x-text="filteredCount" style="color: var(--color-info)">0</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__title">Active</span>
        <span class="stat-card__value" x-text="items.filter(i => i.is_active).length" style="color: var(--color-success)">0</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__title">Status</span>
        <span class="stat-card__value text-xs" x-text="loading ? 'Loading…' : 'Ready'" style="color: var(--color-success)">Ready</span>
      </div>
    </div>

    <!-- Data Table -->
    <div x-show="loading" class="space-y-2">
      <template x-for="i in 5" :key="i">
        <div class="skeleton-shimmer h-10 rounded" aria-hidden="true"></div>
      </template>
    </div>

    <div x-show="!loading && filteredItems.length === 0" class="text-center py-12 opacity-50 text-sm">
      No products found.
      <span x-show="search"> Try a different search.</span>
    </div>

    <div x-show="!loading && filteredItems.length > 0" class="card overflow-x-auto">
      <table class="data-table" role="grid">
        <thead>
          <tr><th>ID</th><th>Name</th><th>SKU</th><th>Price</th><th>Category</th><th>Stock</th><th>Status</th><th class="w-20">Actions</th></tr>
        </thead>
        <tbody>
          <template x-for="item in pagedItems()" :key="item.id">
            <tr class="cursor-pointer hover:bg-[var(--color-surface-hover)]" @click="openEdit(item)">
              <td class="px-3 py-2"><span x-text="item.id" class="text-xs tabular-nums"></span></td>
              <td class="px-3 py-2"><span x-text="item.name" class="text-xs font-medium"></span></td>
              <td class="px-3 py-2"><span x-text="item.sku || '-'" class="text-xs font-mono opacity-60"></span></td>
              <td class="px-3 py-2"><span x-text="'$' + Number(item.price || 0).toFixed(2)" class="text-xs tabular-nums"></span></td>
              <td class="px-3 py-2"><span class="text-xs" x-text="catName(item.category) || '-'"></span></td>
              <td class="px-3 py-2">
                <span class="badge" :class="(item.stock_quantity ?? 0) <= (item.low_stock_threshold ?? 10) ? 'badge-soft-error' : 'badge-soft-success'" x-text="item.stock_quantity ?? 0"></span>
              </td>
              <td class="px-3 py-2">
                <span class="badge" :class="item.is_active ? 'badge-soft-success' : 'badge-soft-error'" x-text="item.is_active ? 'Active' : 'Inactive'"></span>
              </td>
              <td class="px-3 py-2">
                <div class="flex gap-1">
                  <button @click.stop="openEdit(item)" class="btn btn-ghost btn-xs px-1.5" title="Edit" aria-label="Edit"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-pencil" /></svg></button>
                  <button @click.stop="confirmDelete(item)" class="btn btn-ghost btn-xs px-1.5" title="Delete" aria-label="Delete"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-trash" /></svg></button>
                </div>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
      <!-- Pagination -->
      <div class="flex items-center justify-between p-3 border-t border-[var(--color-border-subtle)] text-xs">
        <span x-text="`Showing ${(page-1)*perPage + 1}–${Math.min(page*perPage, filteredItems.length)} of ${filteredItems.length}`"></span>
        <div class="flex gap-1">
          <button @click="page = Math.max(1, page-1)" :disabled="page === 1" class="btn btn-ghost btn-xs">← Prev</button>
          <button @click="page++" :disabled="page * perPage >= filteredItems.length" class="btn btn-ghost btn-xs">Next →</button>
        </div>
      </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div
      x-show="deleteTarget"
      x-transition.opacity
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/40"
      @click.self="deleteTarget = null"
    >
      <div class="card max-w-sm mx-4 p-6 text-center space-y-4">
        <p class="font-semibold">Delete this product?</p>
        <p class="text-sm opacity-60" x-text="deleteTarget?.name || deleteTarget?.id"></p>
        <div class="flex gap-2 justify-center">
          <button @click="deleteTarget = null" class="btn btn-ghost btn-sm">Cancel</button>
          <button @click="doDelete()" class="btn btn-error btn-sm">Delete</button>
        </div>
      </div>
    </div>

    <!-- Add/Edit Form Modal -->
    <div
      x-show="formOpen"
      x-transition.opacity.duration.200ms
      class="fixed inset-0 z-[60] flex items-start justify-center pt-[10vh] bg-black/50 px-4 overflow-y-auto"
      @click.self="closeForm()"
      @keydown.escape.window="closeForm()"
    >
      <div
        class="card w-full max-w-2xl p-6 space-y-5 shadow-2xl"
        x-transition.scale.90.duration.200ms
        @click.stop
      >
        <div class="flex items-center justify-between">
          <h2 class="text-base font-bold" x-text="editingItem ? 'Edit Product' : 'New Product'"></h2>
          <button @click="closeForm()" class="btn btn-ghost btn-sm" aria-label="Close"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-x" /></svg></button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Name -->
          <div class="sm:col-span-2">
            <label class="text-xs font-medium opacity-70 mb-1 block">Product Name *</label>
            <input type="text" x-model="form.name" class="input w-full" placeholder="e.g. Cappuccino" required />
          </div>
          <!-- SKU -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">SKU</label>
            <input type="text" x-model="form.sku" class="input w-full" placeholder="e.g. COF-001" />
          </div>
          <!-- Barcode -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Barcode</label>
            <input type="text" x-model="form.barcode" class="input w-full" placeholder="Scan or type…" />
          </div>
          <!-- Price -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Price *</label>
            <input type="number" x-model="form.price" class="input w-full" step="0.01" min="0" placeholder="0.00" required />
          </div>
          <!-- Cost Price -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Cost Price</label>
            <input type="number" x-model="form.cost_price" class="input w-full" step="0.01" min="0" placeholder="0.00" />
          </div>
          <!-- Category -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Category</label>
            <select x-model="form.category" class="input w-full">
              <option value="">- None -</option>
              <template x-for="cat in categories" :key="cat.id">
                <option :value="cat.id" x-text="cat.name"></option>
              </template>
            </select>
          </div>
          <!-- Tax Rate -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Tax Rate</label>
            <select x-model="form.tax_rate" class="input w-full">
              <option value="standard">Standard Rate</option>
              <option value="reduced">Reduced Rate</option>
              <option value="exempt">Tax Exempt</option>
            </select>
          </div>
          <!-- Stock Qty -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Stock Quantity</label>
            <input type="number" x-model="form.stock_quantity" class="input w-full" min="0" step="1" placeholder="0" />
          </div>
          <!-- Low Stock Threshold -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Low Stock Alert</label>
            <input type="number" x-model="form.low_stock_threshold" class="input w-full" min="0" step="1" placeholder="10" />
          </div>
          <!-- Image URL -->
          <div class="sm:col-span-2">
            <label class="text-xs font-medium opacity-70 mb-1 block">Image URL</label>
            <input type="url" x-model="form.image_url" class="input w-full" placeholder="https://…" />
          </div>
          <!-- Description -->
          <div class="sm:col-span-2">
            <label class="text-xs font-medium opacity-70 mb-1 block">Description</label>
            <textarea x-model="form.description" class="input w-full" rows="2" placeholder="Product description…"></textarea>
          </div>
          <!-- Active toggle -->
          <div class="sm:col-span-2 flex items-center gap-3">
            <label class="text-xs font-medium opacity-70">Active</label>
            <button type="button" @click="form.is_active = !form.is_active" :class="form.is_active && 'switch--on'" class="switch" role="switch" :aria-checked="form.is_active"><span class="switch__knob"></span></button>
            <span class="text-xs opacity-60" x-text="form.is_active ? 'Yes' : 'No'"></span>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex gap-2 justify-end pt-2 border-t border-[var(--color-border-subtle)]">
          <button @click="closeForm()" class="btn btn-ghost btn-sm" :disabled="formSaving">Cancel</button>
          <button @click="doSave()" class="btn btn-primary btn-sm gap-1" :disabled="formSaving">
            <span x-show="formSaving" class="inline-block h-3 w-3 animate-spin rounded-full border-2 border-current border-t-transparent"></span>
            <span x-text="editingItem ? 'Update' : 'Create'"></span>
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';

  document.addEventListener('alpine:init', () => {
    Alpine.data('dataTable_products', (id, endpoint) => ({
      items: [],
      categories: [],
      loading: true,
      search: '',
      page: 1,
      perPage: 20,
      deleteTarget: null,
      formOpen: false,
      formSaving: false,
      editingItem: null,
      form: {
        name: '', sku: '', barcode: '', price: '', cost_price: '0',
        category: '', tax_rate: 'standard', stock_quantity: '0',
        low_stock_threshold: '10', image_url: '', description: '',
        is_active: true,
      },
      catName(id) {
        const c = this.categories.find((x) => String(x.id) === String(id));
        return c ? c.name : null;
      },

      get total() { return this.items.length; },
      get filteredItems() {
        const q = this.search.trim().toLowerCase();
        if (!q) return this.items;
        return this.items.filter((i: any) =>
          Object.values(i).some(v => String(v).toLowerCase().includes(q))
        );
      },
      get filteredCount() { return this.filteredItems.length; },
      pagedItems() {
        const start = (this.page - 1) * this.perPage;
        return this.filteredItems.slice(start, start + this.perPage);
      },

      async init() {
        await Promise.all([this.load(), this.loadCategories()]);
      },

      async load() {
        this.loading = true;
        try {
          const res = await fetch(endpoint as string);
          if (res.ok) {
            const data = await res.json();
            this.items = data.data || data || [];
          }
        } catch (e) {
          console.error('Load error:', e);
        } finally {
          this.loading = false;
        }
      },

      async loadCategories() {
        try {
          const res = await fetch('/categories/');
          if (res.ok) {
            const data = await res.json();
            this.categories = data.data || data || [];
          }
        } catch (e) { /* non-critical */ }
      },

      filter() {
        this.page = 1;
      },

      resetForm() {
        this.form = {
          name: '', sku: '', barcode: '', price: '', cost_price: '0',
          category: '', tax_rate: 'standard', stock_quantity: '0',
          low_stock_threshold: '10', image_url: '', description: '',
          is_active: true,
        };
        this.editingItem = null;
      },

      openAdd() {
        this.resetForm();
        this.formOpen = true;
      },

      openEdit(item: any) {
        this.resetForm();
        this.editingItem = item;
        this.form = {
          name: item.name || '',
          sku: item.sku || '',
          barcode: item.barcode || '',
          price: item.price ?? '',
          cost_price: item.cost_price ?? '0',
          category: item.category ?? item.category_id ?? '',
          tax_rate: item.tax_rate || 'standard',
          stock_quantity: item.stock_quantity ?? '0',
          low_stock_threshold: item.low_stock_threshold ?? '10',
          image_url: item.image_url || '',
          description: item.description || '',
          is_active: item.is_active !== false,
        };
        this.formOpen = true;
      },

      closeForm() {
        if (this.formSaving) return;
        this.formOpen = false;
        this.resetForm();
      },

      async doSave() {
        if (!this.form.name || !this.form.price) {
          this.$store.ui.toast('Name and price are required', 'error');
          return;
        }
        this.formSaving = true;
        const payload = {
          name: this.form.name,
          sku: this.form.sku || null,
          barcode: this.form.barcode || '',
          price: parseFloat(String(this.form.price)) || 0,
          cost_price: this.form.cost_price || 0,
          category_id: this.form.category || null,
          tax_rate: this.form.tax_rate,
          stock_quantity: parseInt(String(this.form.stock_quantity)) || 0,
          low_stock_threshold: parseInt(String(this.form.low_stock_threshold)) || 10,
          image_url: this.form.image_url || '',
          description: this.form.description || '',
          is_active: this.form.is_active,
        };

        try {
          let res;
          if (this.editingItem) {
            res = await fetch(`${endpoint}${this.editingItem.id}/`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
          } else {
            res = await fetch(endpoint as string, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
          }
          if (res.ok) {
            this.$store.ui.toast(this.editingItem ? 'Product updated' : 'Product created', 'success');
            this.closeForm();
            await this.load();
          } else {
            const err = await res.text();
            this.$store.ui.toast('Save failed: ' + (err || res.status), 'error');
          }
        } catch (e) {
          this.$store.ui.toast('Network error', 'error');
        } finally {
          this.formSaving = false;
        }
      },

      confirmDelete(item: any) {
        this.deleteTarget = item;
      },

      async doDelete() {
        if (!this.deleteTarget) return;
        const id = this.deleteTarget.id;
        this.deleteTarget = null;
        try {
          const res = await fetch(`${endpoint}${id}/`, { method: 'DELETE' });
          if (res.ok) {
            this.items = this.items.filter((i: any) => i.id !== id);
            this.$store.ui.toast('Deleted', 'success');
          }
        } catch (e) {
          this.$store.ui.toast('Delete failed', 'error');
        }
      },
    }));
  });
</script>

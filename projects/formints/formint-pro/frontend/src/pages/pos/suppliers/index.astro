---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/ui/Icon.astro';
---

<Layout title="Suppliers - Formint POS">
  <div x-data="suppliersPage()" x-init="load()" class="max-w-[96rem] mx-auto p-4">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
      <h1 class="flex items-center gap-2 text-lg font-extrabold" style="color: var(--color-text-primary)">
        <Icon name="truck" class="h-5 w-5" style="color: var(--color-primary)" />
        Suppliers
      </h1>
      <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
        <input type="search" x-model="search" @input="page=1" placeholder="Search suppliers..." class="input flex-1 sm:w-56 text-xs" />
        <button @click="openAdd()" class="btn btn-primary btn-sm gap-1"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plus" /></svg> Add Supplier</button>
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
      <div class="stat-card"><span class="stat-card__title">Total</span><span class="stat-card__value" x-text="total" style="color: var(--color-primary)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Active</span><span class="stat-card__value" x-text="activeCount" style="color: var(--color-success)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Purchase Orders</span><span class="stat-card__value" x-text="poCount" style="color: var(--color-info)">0</span></div>
    </div>
    <div x-show="loading" class="space-y-2"><template x-for="i in 5" :key="i"><div class="skeleton-shimmer h-10 rounded"></div></template></div>
    <div x-show="!loading && filteredItems.length === 0" class="text-center py-12 opacity-50 text-sm">No suppliers. <span x-show="search">Try a different search.</span></div>
    <div x-show="!loading && filteredItems.length > 0" class="card overflow-x-auto">
      <table class="data-table" role="grid">
        <thead><tr><th>ID</th><th>Name</th><th>Contact</th><th>Phone</th><th>Email</th><th>Tax ID</th><th>Terms</th><th>Status</th><th class="w-20">Actions</th></tr></thead>
        <tbody>
          <template x-for="item in pagedItems()" :key="item.id">
            <tr class="cursor-pointer hover:bg-[var(--color-surface-hover)]">
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.id"></span></td>
              <td class="px-3 py-2"><span class="text-xs font-medium" x-text="item.name"></span></td>
              <td class="px-3 py-2"><span class="text-xs" x-text="item.contact_name || '-'" ></span></td>
              <td class="px-3 py-2"><span class="text-xs" x-text="item.phone || '-'" ></span></td>
              <td class="px-3 py-2"><span class="text-xs" x-text="item.email || '-'" ></span></td>
              <td class="px-3 py-2"><span class="text-xs font-mono" x-text="item.tax_id || '-'" ></span></td>
              <td class="px-3 py-2"><span class="text-xs" x-text="item.payment_terms || '-'" ></span></td>
              <td class="px-3 py-2">
                <span class="badge"
                  :class="item.is_active ? 'badge-soft-success' : 'badge-soft-error'"
                  x-text="item.is_active ? 'Active' : 'Inactive'"></span>
              </td>
              <td class="px-3 py-2"><div class="flex gap-1">
                <button @click.stop="openEdit(item)" class="btn btn-ghost btn-xs px-1.5" title="Edit" aria-label="Edit"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-pencil" /></svg></button>
                <button @click.stop="confirmDelete(item)" class="btn btn-ghost btn-xs px-1.5" title="Delete" aria-label="Delete"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-trash" /></svg></button>
              </div></td>
            </tr>
          </template>
        </tbody>
      </table>
      <div class="flex items-center justify-between p-3 border-t border-[var(--color-border-subtle)] text-xs">
        <span x-text="'Showing ' + ((page-1)*perPage + 1) + '-' + Math.min(page*perPage, filteredItems.length) + ' of ' + filteredItems.length"></span>
        <div class="flex gap-1">
          <button @click="page = Math.max(1, page-1)" :disabled="page===1" class="btn btn-ghost btn-xs">&larr; Prev</button>
          <button @click="page++" :disabled="page*perPage >= filteredItems.length" class="btn btn-ghost btn-xs">Next &rarr;</button>
        </div>
      </div>
    </div>
    <div x-show="deleteTarget" x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-black/40" @click.self="deleteTarget=null">
      <div class="card max-w-sm mx-4 p-6 text-center space-y-4">
        <p class="font-semibold">Remove supplier?</p>
        <p class="text-sm opacity-60" x-text="deleteTarget?.name"></p>
        <div class="flex gap-2 justify-center">
          <button @click="deleteTarget=null" class="btn btn-ghost btn-sm">Cancel</button>
          <button @click="doDelete()" class="btn btn-error btn-sm">Remove</button>
        </div>
      </div>
    </div>

    <div x-show="formOpen" x-transition.opacity.duration.200ms class="fixed inset-0 z-[60] flex items-start justify-center pt-[8vh] bg-black/50 px-4 overflow-y-auto" @click.self="closeForm()" @keydown.escape.window="closeForm()">
      <div class="card w-full max-w-lg p-6 space-y-5 shadow-2xl" x-transition.scale.90.duration.200ms @click.stop>
        <div class="flex items-center justify-between"><h2 class="text-base font-bold" x-text="editingItem ? 'Edit Supplier' : 'New Supplier'"></h2><button @click="closeForm()" class="btn btn-ghost btn-sm" aria-label="Close"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-x" /></svg></button></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2"><label class="text-xs font-medium opacity-70 mb-1 block">Name *</label><input type="text" x-model="form.name" class="input w-full" placeholder="Northline Produce Co." required /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Contact name</label><input type="text" x-model="form.contact_name" class="input w-full" placeholder="Mara Ellison" /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Phone</label><input type="tel" x-model="form.phone" class="input w-full" placeholder="+1 312 555 0147" /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Email</label><input type="email" x-model="form.email" class="input w-full" placeholder="orders@northline.example" /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Tax ID</label><input type="text" x-model="form.tax_id" class="input w-full font-mono" placeholder="TX-88231" /></div>
          <div class="sm:col-span-2"><label class="text-xs font-medium opacity-70 mb-1 block">Payment terms</label><input type="text" x-model="form.payment_terms" class="input w-full" placeholder="Net 30" /></div>
          <div class="sm:col-span-2"><label class="text-xs font-medium opacity-70 mb-1 block">Address</label><textarea x-model="form.address" class="input w-full" rows="2" placeholder="Street, city, region"></textarea></div>
          <div class="flex items-center gap-2 sm:col-span-2"><input type="checkbox" x-model="form.is_active" class="rounded" /><label class="text-xs font-medium opacity-70">Active supplier</label></div>
        </div>
        <div class="flex gap-2 justify-end pt-2 border-t border-[var(--color-border-subtle)]"><button @click="closeForm()" class="btn btn-ghost btn-sm" :disabled="formSaving">Cancel</button><button @click="doSave()" class="btn btn-primary btn-sm gap-1" :disabled="formSaving"><span x-show="formSaving" class="inline-block h-3 w-3 animate-spin rounded-full border-2 border-current border-t-transparent"></span><span x-text="editingItem ? 'Update' : 'Create'"></span></button></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  document.addEventListener('alpine:init', () => {
    Alpine.data('suppliersPage', () => ({
      items: [], loading: true, search: '', page: 1, perPage: 20, deleteTarget: null,
      formOpen: false, formSaving: false, editingItem: null,
      form: { name: '', contact_name: '', phone: '', email: '', address: '', tax_id: '', payment_terms: '', is_active: true },
      get total() { return this.items.length; },
      get activeCount() { return this.items.filter((i: any) => i.is_active).length; },
      get poCount() { return this.items.length; },
      get filteredItems() {
        let list = this.items;
        if (this.search) { const q = this.search.toLowerCase(); list = list.filter((i: any) => Object.values(i).some(v => String(v).toLowerCase().includes(q))); }
        return list;
      },
      pagedItems() { const s = (this.page-1)*this.perPage; return this.filteredItems.slice(s, s+this.perPage); },
      async load() { this.loading=true; try { const r = await fetch('/suppliers/'); if (r.ok) { const d = await r.json(); this.items = d.data || d || []; } } catch(e){} finally { this.loading=false; } },
      resetForm() { this.form = { name: '', contact_name: '', phone: '', email: '', address: '', tax_id: '', payment_terms: '', is_active: true }; this.editingItem = null; },
      openAdd() { this.resetForm(); this.formOpen = true; },
      openEdit(item: any) { this.resetForm(); this.editingItem = item; this.form = { name: item.name || '', contact_name: item.contact_name || '', phone: item.phone || '', email: item.email || '', address: item.address || '', tax_id: item.tax_id || '', payment_terms: item.payment_terms || '', is_active: item.is_active !== false }; this.formOpen = true; },
      closeForm() { if (this.formSaving) return; this.formOpen = false; this.resetForm(); },
      async doSave() {
        if (!this.form.name.trim()) { this.$store.ui.toast('Supplier name is required', 'error'); return; }
        this.formSaving = true;
        const p = {
          name: this.form.name, contact_name: this.form.contact_name, phone: this.form.phone,
          email: this.form.email, address: this.form.address, tax_id: this.form.tax_id,
          payment_terms: this.form.payment_terms, is_active: this.form.is_active,
        };
        try {
          let r;
          if (this.editingItem) { r = await fetch('/suppliers/' + this.editingItem.id + '/', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(p) }); }
          else { r = await fetch('/suppliers/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(p) }); }
          if (r.ok) { this.$store.ui.toast(this.editingItem ? 'Supplier updated' : 'Supplier created', 'success'); this.closeForm(); await this.load(); }
          else { const e = await r.text(); this.$store.ui.toast('Save failed: ' + (e || r.status), 'error'); }
        } catch(e) { this.$store.ui.toast('Network error', 'error'); }
        finally { this.formSaving = false; }
      },
      confirmDelete(item: any) { this.deleteTarget = item; },
      async doDelete() { if (!this.deleteTarget) return; const id = this.deleteTarget.id; this.deleteTarget = null; try { await fetch('/suppliers/' + id + '/', { method: 'DELETE' }); this.items = this.items.filter((i: any) => i.id !== id); this.$store.ui.toast('Supplier removed', 'success'); } catch(e) { this.$store.ui.toast('Failed', 'error'); } },
    }));
  });
</script>

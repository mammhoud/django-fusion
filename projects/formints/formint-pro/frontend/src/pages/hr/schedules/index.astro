---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/ui/Icon.astro';
---

<Layout title="Schedules - Formint POS">
  <div x-data="schedulesPage()" x-init="load()" class="max-w-[96rem] mx-auto p-4">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
      <h1 class="flex items-center gap-2 text-lg font-extrabold" style="color: var(--color-text-primary)">
        <Icon name="calendar-stats" class="h-5 w-5" style="color: var(--color-chart-3)" />
        Schedules
      </h1>
      <div class="flex flex-wrap items-center gap-2">
        <input type="search" x-model="search" @input="page=1" placeholder="Search by employee..." class="input flex-1 sm:w-56 text-xs" />
        <button @click="openAdd()" class="btn btn-primary btn-sm gap-1"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plus" /></svg> Add Shift</button>
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
      <div class="stat-card"><span class="stat-card__title">Shifts</span><span class="stat-card__value" x-text="total" style="color: var(--color-primary)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Scheduled</span><span class="stat-card__value" x-text="scheduledCount" style="color: var(--color-info)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Completed</span><span class="stat-card__value" x-text="completedCount" style="color: var(--color-success)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Today</span><span class="stat-card__value" x-text="todayCount" style="color: var(--color-warning)">0</span></div>
    </div>
    <div class="flex flex-wrap gap-1 mb-3">
      <template x-for="s in ['All','scheduled','confirmed','completed','absent']" :key="s">
        <button @click="filterStatus=s==='All'?'':s; page=1" :class="'btn btn-xs '+((filterStatus||'All')===s?'btn-primary':'btn-ghost')" x-text="s==='All'?'All':s.charAt(0).toUpperCase()+s.slice(1)"></button>
      </template>
    </div>
    <div x-show="loading" class="space-y-2"><template x-for="i in 5" :key="i"><div class="skeleton-shimmer h-10 rounded"></div></template></div>
    <div x-show="!loading && filteredItems.length===0" class="text-center py-12 opacity-50 text-sm">No schedules.</div>
    <div x-show="!loading && filteredItems.length>0" class="card overflow-x-auto">
      <table class="data-table" role="grid">
        <thead><tr><th>ID</th><th>Employee</th><th>Day</th><th>Start</th><th>End</th><th>Status</th><th class="w-20">Actions</th></tr></thead>
        <tbody>
          <template x-for="item in pagedItems()" :key="item.id">
            <tr class="cursor-pointer hover:bg-[var(--color-surface-hover)]">
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.id"></span></td>
              <td class="px-3 py-2"><span class="text-xs font-medium" x-text="empName(item.employee) || 'Employee #'+item.employee"></span></td>
              <td class="px-3 py-2"><span class="text-xs capitalize" x-text="item.day_of_week"></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.start_time || '-'" ></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.end_time || '-'" ></span></td>
              <td class="px-3 py-2">
                <span class="badge"
                  :class="{ 'badge-soft-info':item.status==='scheduled', 'badge-soft-warning':item.status==='confirmed', 'badge-soft-success':item.status==='completed', 'badge-soft-error':item.status==='absent' }"
                  x-text="item.status"></span>
              </td>
              <td class="px-3 py-2"><div class="flex gap-1">
                <button @click.stop="openEdit(item)" class="btn btn-ghost btn-xs px-1.5" title="Edit" aria-label="Edit"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-pencil" /></svg></button>
                <button @click.stop="confirmDelete(item)" class="btn btn-ghost btn-xs px-1.5" title="Delete" aria-label="Delete"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-trash" /></svg></button>
              </div></td>
            </tr>
          </template>
        </tbody>
      </table>
      <div class="flex items-center justify-between p-3 border-t border-[var(--color-border-subtle)] text-xs">
        <span x-text="'Showing ' + ((page-1)*perPage + 1) + '-' + Math.min(page*perPage, filteredItems.length) + ' of ' + filteredItems.length"></span>
        <div class="flex gap-1">
          <button @click="page=Math.max(1,page-1)" :disabled="page===1" class="btn btn-ghost btn-xs">&larr; Prev</button>
          <button @click="page++" :disabled="page*perPage>=filteredItems.length" class="btn btn-ghost btn-xs">Next &rarr;</button>
        </div>
      </div>
    </div>

    <div x-show="deleteTarget" x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-black/40" @click.self="deleteTarget=null">
      <div class="card max-w-sm mx-4 p-6 text-center space-y-4">
        <p class="font-semibold">Delete this shift?</p>
        <p class="text-sm opacity-60" x-text="empName(deleteTarget?.employee) || 'Shift #'+deleteTarget?.id"></p>
        <div class="flex gap-2 justify-center">
          <button @click="deleteTarget=null" class="btn btn-ghost btn-sm">Cancel</button>
          <button @click="doDelete()" class="btn btn-error btn-sm">Delete</button>
        </div>
      </div>
    </div>

    <div x-show="formOpen" x-transition.opacity.duration.200ms class="fixed inset-0 z-[60] flex items-start justify-center pt-[8vh] bg-black/50 px-4 overflow-y-auto" @click.self="closeForm()" @keydown.escape.window="closeForm()">
      <div class="card w-full max-w-lg p-6 space-y-5 shadow-2xl" x-transition.scale.90.duration.200ms @click.stop>
        <div class="flex items-center justify-between"><h2 class="text-base font-bold" x-text="editingItem ? 'Edit Shift' : 'New Shift'"></h2><button @click="closeForm()" class="btn btn-ghost btn-sm" aria-label="Close"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-x" /></svg></button></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2">
            <label class="text-xs font-medium opacity-70 mb-1 block">Employee *</label>
            <select x-model="form.employee" class="input w-full" required>
              <option value="">Select employee…</option>
              <template x-for="emp in employeeList" :key="emp.id"><option :value="emp.id" x-text="emp.first_name + ' ' + emp.last_name"></option></template>
            </select>
          </div>
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Day *</label>
            <select x-model="form.day_of_week" class="input w-full" required>
              <option value="">Select day…</option>
              <option value="monday">Monday</option>
              <option value="tuesday">Tuesday</option>
              <option value="wednesday">Wednesday</option>
              <option value="thursday">Thursday</option>
              <option value="friday">Friday</option>
              <option value="saturday">Saturday</option>
              <option value="sunday">Sunday</option>
            </select>
          </div>
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Status</label>
            <select x-model="form.status" class="input w-full">
              <option value="scheduled">Scheduled</option>
              <option value="confirmed">Confirmed</option>
              <option value="completed">Completed</option>
              <option value="absent">Absent</option>
            </select>
          </div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Start time *</label><input type="time" x-model="form.start_time" class="input w-full" required /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">End time *</label><input type="time" x-model="form.end_time" class="input w-full" required /></div>
          <div class="sm:col-span-2"><label class="text-xs font-medium opacity-70 mb-1 block">Notes</label><textarea x-model="form.notes" class="input w-full" rows="2" placeholder="Optional shift notes"></textarea></div>
        </div>
        <div class="flex gap-2 justify-end pt-2 border-t border-[var(--color-border-subtle)]"><button @click="closeForm()" class="btn btn-ghost btn-sm" :disabled="formSaving">Cancel</button><button @click="doSave()" class="btn btn-primary btn-sm gap-1" :disabled="formSaving"><span x-show="formSaving" class="inline-block h-3 w-3 animate-spin rounded-full border-2 border-current border-t-transparent"></span><span x-text="editingItem ? 'Update' : 'Create'"></span></button></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  document.addEventListener('alpine:init', () => {
    Alpine.data('schedulesPage', () => ({
      items: [], employeeList: [], loading: true, search: '', filterStatus: '', page: 1, perPage: 20, deleteTarget: null,
      formOpen: false, formSaving: false, editingItem: null,
      form: { employee: '', day_of_week: 'monday', start_time: '', end_time: '', status: 'scheduled', notes: '' },
      get total() { return this.items.length; },
      get scheduledCount() { return this.items.filter((i: any) => i.status==='scheduled').length; },
      get completedCount() { return this.items.filter((i: any) => i.status==='completed').length; },
      get todayCount() { const d = new Date().toLocaleDateString('en-US',{weekday:'long'}).toLowerCase(); return this.items.filter((i: any) => i.day_of_week===d).length; },
      get filteredItems() { let l = this.items; if (this.search) { const q = this.search.toLowerCase(); l = l.filter((i: any) => Object.values(i).some(v => String(v).toLowerCase().includes(q))); } if (this.filterStatus) l = l.filter((i: any) => i.status===this.filterStatus); return l; },
      pagedItems() { const s = (this.page-1)*this.perPage; return this.filteredItems.slice(s, s+this.perPage); },
      empName(id: any) { const e = this.employeeList.find((x: any) => String(x.id) === String(id)); return e ? ((e.first_name || '') + ' ' + (e.last_name || '')).trim() : ''; },
      async load() { this.loading=true; try { const [r, e] = await Promise.all([fetch('/employee-schedules/'), fetch('/employees/')]); if (r.ok) { const d = await r.json(); this.items = d.data || d || []; } if (e.ok) { const d = await e.json(); this.employeeList = d.data || d || []; } } catch(e){} finally { this.loading=false; } },
      resetForm() { this.form = { employee: '', day_of_week: 'monday', start_time: '', end_time: '', status: 'scheduled', notes: '' }; this.editingItem = null; },
      openAdd() { this.resetForm(); this.formOpen = true; },
      openEdit(item: any) { this.resetForm(); this.editingItem = item; this.form = { employee: item.employee ?? '', day_of_week: item.day_of_week || 'monday', start_time: item.start_time || '', end_time: item.end_time || '', status: item.status || 'scheduled', notes: item.notes || '' }; this.formOpen = true; },
      closeForm() { if (this.formSaving) return; this.formOpen = false; this.resetForm(); },
      async doSave() {
        if (!this.form.employee) { this.$store.ui.toast('Employee is required', 'error'); return; }
        if (!this.form.day_of_week) { this.$store.ui.toast('Day is required', 'error'); return; }
        if (!this.form.start_time || !this.form.end_time) { this.$store.ui.toast('Start and end times are required', 'error'); return; }
        this.formSaving = true;
        const p = { employee: this.form.employee, day_of_week: this.form.day_of_week, start_time: this.form.start_time, end_time: this.form.end_time, status: this.form.status, notes: this.form.notes };
        try {
          let r;
          if (this.editingItem) { r = await fetch('/employee-schedules/' + this.editingItem.id + '/', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(p) }); }
          else { r = await fetch('/employee-schedules/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(p) }); }
          if (r.ok) { this.$store.ui.toast(this.editingItem ? 'Shift updated' : 'Shift created', 'success'); this.closeForm(); await this.load(); }
          else { const e = await r.text(); this.$store.ui.toast('Save failed: ' + (e || r.status), 'error'); }
        } catch(e) { this.$store.ui.toast('Network error', 'error'); }
        finally { this.formSaving = false; }
      },
      confirmDelete(item: any) { this.deleteTarget = item; },
      async doDelete() { if (!this.deleteTarget) return; const id = this.deleteTarget.id; this.deleteTarget = null; try { await fetch('/employee-schedules/' + id + '/', { method: 'DELETE' }); this.items = this.items.filter((i: any) => i.id !== id); this.$store.ui.toast('Shift deleted', 'success'); } catch(e) { this.$store.ui.toast('Failed', 'error'); } },
    }));
  });
</script>

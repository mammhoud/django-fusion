---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/ui/Icon.astro';
---

<Layout title="CRM Dashboard · Formint POS">
  <div
    x-data="crmDashboard()"
    x-init="load()"
    class="max-w-[96rem] mx-auto p-4"
  >
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
      <h1 class="flex items-center gap-2 text-lg font-extrabold" style="color: var(--color-text-primary)">
        <Icon name="chart-donut" class="h-5 w-5" style="color: var(--color-chart-1)" />
        CRM Dashboard
      </h1>
      <span class="tag tag--primary tag--sm">CRM · Full Edition</span>
    </div>

    <!-- Loading skeleton -->
    <div x-show="loading" class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
      <template x-for="i in 3" :key="i">
        <div class="skeleton-shimmer h-24 rounded-xl" aria-hidden="true"></div>
      </template>
    </div>

    <!-- KPI Cards -->
    <div x-show="!loading" class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
      <div class="card p-5 flex items-center gap-4">
        <div class="flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center" style="background: color-mix(in oklab, var(--color-chart-2) 12%, transparent); color: var(--color-chart-2)">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-building" /></svg>
        </div>
        <div>
          <div class="text-2xl font-extrabold" x-text="stats.companies" style="color: var(--color-text-primary)">0</div>
          <div class="text-xs opacity-50 mt-0.5">Companies</div>
        </div>
      </div>
      <div class="card p-5 flex items-center gap-4">
        <div class="flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center" style="background: color-mix(in oklab, var(--color-chart-3) 12%, transparent); color: var(--color-chart-3)">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-user" /></svg>
        </div>
        <div>
          <div class="text-2xl font-extrabold" x-text="stats.contacts" style="color: var(--color-text-primary)">0</div>
          <div class="text-xs opacity-50 mt-0.5">Contacts</div>
        </div>
      </div>
      <div class="card p-5 flex items-center gap-4">
        <div class="flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center" style="background: color-mix(in oklab, var(--color-chart-1) 12%, transparent); color: var(--color-chart-1)">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-briefcase" /></svg>
        </div>
        <div>
          <div class="text-2xl font-extrabold" x-text="stats.deals" style="color: var(--color-text-primary)">0</div>
          <div class="text-xs opacity-50 mt-0.5">Deals</div>
        </div>
      </div>
    </div>

    <!-- Quick Links -->
    <div x-show="!loading" class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a href="/crm/contacts" class="card p-4 no-underline hover:shadow-md transition-all group">
        <div class="flex items-center gap-3 mb-2">
          <Icon name="user" class="h-5 w-5" style="color: var(--color-chart-3)" />
          <span class="font-semibold text-sm" style="color: var(--color-text-primary)">Contacts</span>
        </div>
        <p class="text-xs opacity-50">Manage people and organizations in your CRM pipeline.</p>
        <span class="text-xs font-medium mt-2 inline-block group-hover:translate-x-1 transition-transform" style="color: var(--color-primary)">Browse →</span>
      </a>
      <a href="/crm/companies" class="card p-4 no-underline hover:shadow-md transition-all group">
        <div class="flex items-center gap-3 mb-2">
          <Icon name="building" class="h-5 w-5" style="color: var(--color-chart-2)" />
          <span class="font-semibold text-sm" style="color: var(--color-text-primary)">Companies</span>
        </div>
        <p class="text-xs opacity-50">View company profiles, industries, and associated contacts.</p>
        <span class="text-xs font-medium mt-2 inline-block group-hover:translate-x-1 transition-transform" style="color: var(--color-primary)">Browse →</span>
      </a>
      <a href="/crm/deals" class="card p-4 no-underline hover:shadow-md transition-all group">
        <div class="flex items-center gap-3 mb-2">
          <Icon name="briefcase" class="h-5 w-5" style="color: var(--color-chart-1)" />
          <span class="font-semibold text-sm" style="color: var(--color-text-primary)">Deals</span>
        </div>
        <p class="text-xs opacity-50">Track opportunities through your sales pipeline stages.</p>
        <span class="text-xs font-medium mt-2 inline-block group-hover:translate-x-1 transition-transform" style="color: var(--color-primary)">Browse →</span>
      </a>
    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  document.addEventListener('alpine:init', () => {
    Alpine.data('crmDashboard', () => ({
      loading: true,
      stats: { companies: 0, contacts: 0, deals: 0 },

      async load() {
        this.loading = true;
        try {
          const res = await fetch('/crm/dashboard');
          if (res.ok) {
            const data = await res.json();
            this.stats = data.data || data || { companies: 0, contacts: 0, deals: 0 };
          }
        } catch (e) { console.error(e); }
        finally { this.loading = false; }
      },
    }));
  });
</script>

---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/ui/Icon.astro';
---

<Layout title="Deals · CRM · Formint POS">
  <div
    x-data="crmDeals()"
    x-init="load()"
    class="max-w-[96rem] mx-auto p-4"
  >
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
      <h1 class="flex items-center gap-2 text-lg font-extrabold" style="color: var(--color-text-primary)">
        <Icon name="briefcase" class="h-5 w-5" style="color: var(--color-primary)" />
        Deals
      </h1>
      <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
        <input type="search" x-model="search" @input="page=1"
          placeholder="Search deals..." class="input flex-1 sm:w-56 text-xs" />
        <button @click="openAdd()" class="btn btn-primary btn-sm gap-1">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plus" /></svg>
          Add Deal
        </button>
      </div>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
      <div class="stat-card">
        <span class="stat-card__title">Total</span>
        <span class="stat-card__value" x-text="total" style="color: var(--color-primary)">0</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__title">Pipeline Value</span>
        <span class="stat-card__value" x-text="'$' + pipelineValue.toFixed(0)" style="color: var(--color-success)">$0</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__title">Won</span>
        <span class="stat-card__value" x-text="wonCount" style="color: var(--color-info)">0</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__title">Status</span>
        <span class="stat-card__value text-xs" x-text="loading ? 'Loading…' : 'Ready'" style="color: var(--color-success)">Ready</span>
      </div>
    </div>

    <!-- Loading skeleton -->
    <div x-show="loading" class="space-y-2">
      <template x-for="i in 5" :key="i">
        <div class="skeleton-shimmer h-10 rounded" aria-hidden="true"></div>
      </template>
    </div>

    <!-- Empty -->
    <div x-show="!loading && filteredItems.length === 0" class="text-center py-12 opacity-50 text-sm">
      No deals found. <span x-show="search">Try a different search.</span>
    </div>

    <!-- Table -->
    <div x-show="!loading && filteredItems.length > 0" class="card overflow-x-auto">
      <table class="data-table" role="grid">
        <thead>
          <tr><th>ID</th><th>Title</th><th>Contact</th><th>Stage</th><th>Value</th><th>Probability</th><th>Close Date</th><th class="w-20">Actions</th></tr>
        </thead>
        <tbody>
          <template x-for="item in pagedItems()" :key="item.id">
            <tr class="cursor-pointer hover:bg-[var(--color-surface-hover)]" @click="openEdit(item)">
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.id"></span></td>
              <td class="px-3 py-2"><span class="text-xs font-medium" x-text="item.title"></span></td>
              <td class="px-3 py-2"><span class="text-xs" x-text="contactName(item.contact) || contactName(item.contact_id) || '-'"></span></td>
              <td class="px-3 py-2">
                <span class="badge" :class="{ 'badge-soft-success': item.is_won, 'badge-soft-error': item.is_closed && !item.is_won, 'badge-soft-info': !!(stageName(item.stage) || stageName(item.stage_id)) && !item.is_won && !item.is_closed, 'badge-soft-neutral': !(stageName(item.stage) || stageName(item.stage_id)) && !item.is_won && !item.is_closed }" x-text="stageName(item.stage) || stageName(item.stage_id) || (item.is_won ? 'Won' : item.is_closed ? 'Lost' : 'New')"></span>
              </td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums font-medium" x-text="'$' + Number(item.value||0).toFixed(2)"></span></td>
              <td class="px-3 py-2">
                <div class="flex items-center gap-2">
                  <div class="flex-1 h-1.5 rounded-full bg-[var(--color-border-subtle)] max-w-[60px]">
                    <div class="h-full rounded-full transition-all" :style="'width:' + (item.probability||0) + '%'" :class="{ 'bg-[var(--color-success)]': item.probability >= 70, 'bg-[var(--color-warning)]': item.probability >= 30 && item.probability < 70, 'bg-[var(--color-error)]': item.probability < 30 }"></div>
                  </div>
                  <span class="text-xs tabular-nums" x-text="(item.probability||0) + '%'"></span>
                </div>
              </td>
              <td class="px-3 py-2"><span class="text-xs" x-text="item.expected_close_date || '-'"></span></td>
              <td class="px-3 py-2">
                <div class="flex gap-1">
                  <button @click.stop="openEdit(item)" class="btn btn-ghost btn-xs px-1.5" title="Edit" aria-label="Edit"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-pencil" /></svg></button>
                  <button @click.stop="confirmDelete(item)" class="btn btn-ghost btn-xs px-1.5" title="Delete" aria-label="Delete"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-trash" /></svg></button>
                </div>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
      <div class="flex items-center justify-between p-3 border-t border-[var(--color-border-subtle)] text-xs">
        <span x-text="'Showing ' + ((page-1)*perPage + 1) + '-' + Math.min(page*perPage, filteredItems.length) + ' of ' + filteredItems.length"></span>
        <div class="flex gap-1">
          <button @click="page = Math.max(1, page-1)" :disabled="page === 1" class="btn btn-ghost btn-xs">&larr; Prev</button>
          <button @click="page++" :disabled="page * perPage >= filteredItems.length" class="btn btn-ghost btn-xs">Next &rarr;</button>
        </div>
      </div>
    </div>

    <!-- Delete Modal -->
    <div x-show="deleteTarget" x-transition.opacity
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/40"
      @click.self="deleteTarget = null">
      <div class="card max-w-sm mx-4 p-6 text-center space-y-4">
        <p class="font-semibold">Delete this deal?</p>
        <p class="text-sm opacity-60" x-text="deleteTarget?.title"></p>
        <div class="flex gap-2 justify-center">
          <button @click="deleteTarget = null" class="btn btn-ghost btn-sm">Cancel</button>
          <button @click="doDelete()" class="btn btn-error btn-sm">Delete</button>
        </div>
      </div>
    </div>

    <!-- Add/Edit Form Modal -->
    <div
      x-show="formOpen"
      x-transition.opacity.duration.200ms
      class="fixed inset-0 z-[60] flex items-start justify-center pt-[6vh] bg-black/50 px-4 overflow-y-auto"
      @click.self="closeForm()"
      @keydown.escape.window="closeForm()"
    >
      <div class="card w-full max-w-xl p-6 space-y-5 shadow-2xl" x-transition.scale.90.duration.200ms @click.stop>
        <div class="flex items-center justify-between">
          <h2 class="text-base font-bold" x-text="editingItem ? 'Edit Deal' : 'New Deal'"></h2>
          <button @click="closeForm()" class="btn btn-ghost btn-sm" aria-label="Close"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-x" /></svg></button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2">
            <label class="text-xs font-medium opacity-70 mb-1 block">Deal Title *</label>
            <input type="text" x-model="form.title" class="input w-full" placeholder="e.g. Enterprise License Deal" required />
          </div>
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Contact</label>
            <select x-model="form.contact_id" class="input w-full">
              <option value="">- None -</option>
              <template x-for="c in contactList" :key="c.id">
                <option :value="c.id" x-text="(c.first_name||'') + ' ' + (c.last_name||'')"></option>
              </template>
            </select>
          </div>
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Pipeline *</label>
            <select x-model="form.pipeline_id" class="input w-full" required @change="onPipelineChange()">
              <option value="">- Select pipeline -</option>
              <template x-for="p in pipelineList" :key="p.id">
                <option :value="p.id" x-text="p.name"></option>
              </template>
            </select>
          </div>
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Stage</label>
            <select x-model="form.stage_id" class="input w-full" :disabled="!form.pipeline_id">
              <option value="">- Select stage -</option>
              <template x-for="s in activeStages()" :key="s.id">
                <option :value="s.id" x-text="s.name"></option>
              </template>
            </select>
          </div>
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Value ($) *</label>
            <input type="number" x-model="form.value" class="input w-full" step="0.01" min="0" placeholder="0.00" required />
          </div>
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Currency</label>
            <select x-model="form.currency" class="input w-full">
              <option value="USD">USD</option>
              <option value="EUR">EUR</option>
              <option value="GBP">GBP</option>
              <option value="SAR">SAR</option>
            </select>
          </div>
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Probability (%)</label>
            <input type="range" x-model="form.probability" class="w-full" min="0" max="100" step="5" />
            <div class="text-xs text-center mt-1" x-text="form.probability + '%'"></div>
          </div>
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Expected Close</label>
            <input type="date" x-model="form.expected_close_date" class="input w-full" />
          </div>
          <div class="sm:col-span-2">
            <label class="text-xs font-medium opacity-70 mb-1 block">Description</label>
            <textarea x-model="form.description" class="input w-full" rows="2" placeholder="Deal details…"></textarea>
          </div>
          <!-- Win/Loss -->
          <div class="sm:col-span-2 flex flex-wrap items-center gap-4">
            <label class="flex items-center gap-2 text-xs cursor-pointer">
              <input type="checkbox" x-model="form.is_won" class="rounded" />
              <span class="font-medium" style="color: var(--color-success)">Won</span>
            </label>
            <label class="flex items-center gap-2 text-xs cursor-pointer">
              <input type="checkbox" x-model="form.is_closed" class="rounded" />
              <span class="font-medium opacity-70">Closed</span>
            </label>
            <label class="flex items-center gap-2 text-xs cursor-pointer">
              <input type="checkbox" x-model="form.is_active" class="rounded" />
              <span class="font-medium opacity-70">Active</span>
            </label>
          </div>
        </div>

        <div class="flex gap-2 justify-end pt-2 border-t border-[var(--color-border-subtle)]">
          <button @click="closeForm()" class="btn btn-ghost btn-sm" :disabled="formSaving">Cancel</button>
          <button @click="doSave()" class="btn btn-primary btn-sm gap-1" :disabled="formSaving">
            <span x-show="formSaving" class="inline-block h-3 w-3 animate-spin rounded-full border-2 border-current border-t-transparent"></span>
            <span x-text="editingItem ? 'Update' : 'Create'"></span>
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  document.addEventListener('alpine:init', () => {
    Alpine.data('crmDeals', () => ({
      items: [], contactList: [], pipelineList: [], loading: true, search: '', page: 1, perPage: 20,
      deleteTarget: null,
      formOpen: false, formSaving: false, editingItem: null,
      form: {
        title: '', contact_id: '', pipeline_id: '', stage_id: '',
        value: '', currency: 'USD', probability: '10',
        expected_close_date: '', description: '',
        is_won: false, is_closed: false, is_active: true,
      },

      // ── id → name resolution over loaded reference lists ──
      contactName(id: any) {
        if (id === null || id === undefined || id === '') return '';
        const c = (this.contactList || []).find((x: any) => String(x.id) === String(id));
        return c ? ((c.first_name || '') + ' ' + (c.last_name || '')).trim() : '';
      },
      stagesOf(pipelineId: any): any[] {
        const p = (this.pipelineList || []).find((x: any) => String(x.id) === String(pipelineId));
        return p ? (p.stages || []) : [];
      },
      activeStages() { return this.stagesOf(this.form.pipeline_id); },
      stageName(id: any) {
        // Stages live nested under each pipeline's `stages` array; scan all.
        if (id === null || id === undefined || id === '') return '';
        for (const p of (this.pipelineList || [])) {
          const s = (p.stages || []).find((x: any) => String(x.id) === String(id));
          if (s) return s.name;
        }
        return '';
      },
      onPipelineChange() {
        // A stage belongs to a pipeline; reset the stage when it changes.
        const stillValid = this.stagesOf(this.form.pipeline_id)
          .some((s: any) => String(s.id) === String(this.form.stage_id));
        if (!stillValid) this.form.stage_id = '';
      },

      get total() { return this.items.length; },
      get pipelineValue() {
        return this.items
          .filter((i: any) => !i.is_closed || i.is_won)
          .reduce((s: number, i: any) => s + Number(i.value || 0), 0);
      },
      get wonCount() { return this.items.filter((i: any) => i.is_won).length; },
      get filteredItems() {
        let list = this.items;
        if (this.search) {
          const q = this.search.toLowerCase();
          list = list.filter((i: any) => Object.values(i).some(v => String(v).toLowerCase().includes(q)));
        }
        return list;
      },
      pagedItems() {
        const start = (this.page - 1) * this.perPage;
        return this.filteredItems.slice(start, start + this.perPage);
      },
      async load() {
        this.loading = true;
        try {
          const [res, c, p] = await Promise.all([
            fetch('/crm/deals'),
            fetch('/crm/contacts').then((r) => (r.ok ? r.json() : { data: [] })),
            fetch('/crm/pipelines').then((r) => (r.ok ? r.json() : { data: [] })),
          ]);
          if (res.ok) { const d = await res.json(); this.items = d.data || d || []; }
          this.contactList = c.data || c || [];
          this.pipelineList = p.data || p || [];
        } catch (e) { console.error(e); }
        finally { this.loading = false; }
      },

      resetForm() {
        this.form = {
          title: '', contact_id: '', pipeline_id: '', stage_id: '',
          value: '', currency: 'USD', probability: '10',
          expected_close_date: '', description: '',
          is_won: false, is_closed: false, is_active: true,
        };
        this.editingItem = null;
      },

      openAdd() { this.resetForm(); this.formOpen = true; },

      openEdit(item: any) {
        this.resetForm(); this.editingItem = item;
        this.form = {
          title: item.title || '',
          contact_id: item.contact ?? item.contact_id ?? '',
          pipeline_id: item.pipeline ?? item.pipeline_id ?? '',
          stage_id: item.stage ?? item.stage_id ?? '',
          value: item.value ?? '',
          currency: item.currency || 'USD',
          probability: item.probability ?? '10',
          expected_close_date: item.expected_close_date || '',
          description: item.description || '',
          is_won: item.is_won || false,
          is_closed: item.is_closed || false,
          is_active: item.is_active !== false,
        };
        this.formOpen = true;
      },

      closeForm() { if (this.formSaving) return; this.formOpen = false; this.resetForm(); },

      async doSave() {
        if (!this.form.title || !this.form.value) {
          this.$store.ui.toast('Title and value are required', 'error');
          return;
        }
        if (!this.form.pipeline_id) {
          this.$store.ui.toast('Pipeline is required', 'error');
          return;
        }
        this.formSaving = true;
        const payload = {
          title: this.form.title,
          contact_id: this.form.contact_id ? parseInt(String(this.form.contact_id)) : null,
          pipeline_id: parseInt(String(this.form.pipeline_id)),
          stage_id: this.form.stage_id ? parseInt(String(this.form.stage_id)) : null,
          value: parseFloat(String(this.form.value)) || 0,
          currency: this.form.currency,
          probability: parseInt(String(this.form.probability)) || 10,
          expected_close_date: this.form.expected_close_date || null,
          description: this.form.description,
          is_won: this.form.is_won,
          is_closed: this.form.is_closed,
          is_active: this.form.is_active,
        };
        try {
          let res;
          if (this.editingItem) {
            res = await fetch('/crm/deals/' + this.editingItem.id, {
              method: 'PUT', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
          } else {
            res = await fetch('/crm/deals', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
          }
          if (res.ok) {
            this.$store.ui.toast(this.editingItem ? 'Deal updated' : 'Deal added', 'success');
            this.closeForm(); await this.load();
          } else {
            const err = await res.text();
            this.$store.ui.toast('Save failed: ' + (err || res.status), 'error');
          }
        } catch (e) { this.$store.ui.toast('Network error', 'error'); }
        finally { this.formSaving = false; }
      },

      confirmDelete(item: any) { this.deleteTarget = item; },
      async doDelete() {
        if (!this.deleteTarget) return;
        const id = this.deleteTarget.id; this.deleteTarget = null;
        try {
          await fetch('/crm/deals/' + id, { method: 'DELETE' });
          this.items = this.items.filter((i: any) => i.id !== id);
          this.$store.ui.toast('Deleted', 'success');
        } catch (e) { this.$store.ui.toast('Failed', 'error'); }
      },
    }));
  });
</script>

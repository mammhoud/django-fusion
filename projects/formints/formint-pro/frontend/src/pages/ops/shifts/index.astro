---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/ui/Icon.astro';
---

<Layout title="Shifts · Operations · Formint POS">
  <div x-data="opsShifts()" x-init="load()" class="max-w-[96rem] mx-auto p-4">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
      <h1 class="flex items-center gap-2 text-lg font-extrabold" style="color: var(--color-text-primary)">
        <Icon name="clock" class="h-5 w-5" style="color: var(--color-chart-5)" />
        Shifts
      </h1>
      <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
        <input type="search" x-model="search" @input="page=1" placeholder="Search shifts..." class="input flex-1 sm:w-56 text-xs" />
        <button @click="openAdd()" class="btn btn-primary btn-sm gap-1"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plus" /></svg> Open Shift</button>
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
      <div class="stat-card"><span class="stat-card__title">Total</span><span class="stat-card__value" x-text="total" style="color: var(--color-primary)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Open</span><span class="stat-card__value" x-text="openCount" style="color: var(--color-warning)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Expected Today</span><span class="stat-card__value text-xs tabular-nums" x-text="'$' + expectedToday.toFixed(2)" style="color: var(--color-info)">$0</span></div>
      <div class="stat-card"><span class="stat-card__title">Status</span><span class="stat-card__value text-xs" x-text="shiftError ? 'Blocked' : (loading ? 'Loading…' : 'Ready')" style="color: shiftError ? 'var(--color-error)' : 'var(--color-success)'">Ready</span></div>
    </div>

    <div x-show="loading" class="space-y-2"><template x-for="i in 5" :key="i"><div class="skeleton-shimmer h-10 rounded" aria-hidden="true"></div></template></div>
    <div x-show="!loading && filteredItems.length === 0" class="text-center py-12 opacity-50 text-sm">No shifts found. <span x-show="search">Try a different search.</span></div>

    <div x-show="!loading && filteredItems.length > 0" class="card overflow-x-auto">
      <table class="data-table" role="grid">
        <thead><tr><th>ID</th><th>Employee</th><th>Status</th><th>Opening Cash</th><th>Closing Cash</th><th>Expected</th><th>Opened</th><th>Duration</th><th class="w-20">Actions</th></tr></thead>
        <tbody>
          <template x-for="item in pagedItems()" :key="item.id">
            <tr class="cursor-pointer hover:bg-[var(--color-surface-hover)]" @click="openEdit(item)">
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.id"></span></td>
              <td class="px-3 py-2"><span class="text-xs font-medium" x-text="empName(item.employee) || 'Employee #'+item.employee || '-'"></span></td>
              <td class="px-3 py-2"><span class="badge"
                :class="item.status==='open'?'badge-soft-success':'badge-soft-neutral'"
                x-text="item.status==='open'?'Open':'Closed'"></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="'$' + Number(item.opening_cash||0).toFixed(2)"></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.closing_cash ? '$' + Number(item.closing_cash).toFixed(2) : '-'" ></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.expected_cash ? '$' + Number(item.expected_cash).toFixed(2) : (item.status==='open' ? '—' : '—')" ></span></td>
              <td class="px-3 py-2"><span class="text-xs" x-text="item.opened_at || '-'" ></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="shiftDuration(item)"></span></td>
              <td class="px-3 py-2"><div class="flex gap-1"><button @click.stop="openEdit(item)" class="btn btn-ghost btn-xs px-1.5" title="Edit" aria-label="Edit"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-pencil" /></svg></button><button @click.stop="confirmDelete(item)" class="btn btn-ghost btn-xs px-1.5" title="Delete" aria-label="Delete"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-trash" /></svg></button></div></td>
            </tr>
          </template>
        </tbody>
      </table>
      <div class="flex items-center justify-between p-3 border-t border-[var(--color-border-subtle)] text-xs">
        <span x-text="'Showing ' + ((page-1)*perPage + 1) + '-' + Math.min(page*perPage, filteredItems.length) + ' of ' + filteredItems.length"></span>
        <div class="flex gap-1"><button @click="page=Math.max(1,page-1)" :disabled="page===1" class="btn btn-ghost btn-xs">&larr; Prev</button><button @click="page++" :disabled="page*perPage>=filteredItems.length" class="btn btn-ghost btn-xs">Next &rarr;</button></div>
      </div>
    </div>

    <div x-show="deleteTarget" x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-black/40" @click.self="deleteTarget=null">
      <div class="card max-w-sm mx-4 p-6 text-center space-y-4"><p class="font-semibold">Delete this shift?</p><p class="text-sm opacity-60" x-text="'Shift #' + deleteTarget?.id"></p><div class="flex gap-2 justify-center"><button @click="deleteTarget=null" class="btn btn-ghost btn-sm">Cancel</button><button @click="doDelete()" class="btn btn-error btn-sm">Delete</button></div></div>
    </div>

    <div x-show="formOpen" x-transition.opacity.duration.200ms class="fixed inset-0 z-[60] flex items-start justify-center pt-[8vh] bg-black/50 px-4 overflow-y-auto" @click.self="closeForm()" @keydown.escape.window="closeForm()">
      <div class="card w-full max-w-lg p-6 space-y-5 shadow-2xl" x-transition.scale.90.duration.200ms @click.stop>
        <div class="flex items-center justify-between"><h2 class="text-base font-bold" x-text="editingItem ? 'Edit Shift' : 'New Shift'"></h2><button @click="closeForm()" class="btn btn-ghost btn-sm" aria-label="Close"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-x" /></svg></button></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2"><label class="text-xs font-medium opacity-70 mb-1 block">Employee</label><select x-model="form.employee_id" class="input w-full" :disabled="editingItem && editingItem.status==='open'"><option value="">- Select -</option><template x-for="e in employeeList" :key="e.id"><option :value="e.id" x-text="e.first_name + ' ' + e.last_name + ' (' + (e.role||'') + ')'"></option></template></select></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Status</label><select x-model="form.status" class="input w-full"><option value="open">Open</option><option value="closed">Closed</option></select></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Opening Cash ($) *</label><input type="number" x-model="form.opening_cash" class="input w-full" step="0.01" min="0" placeholder="0.00" required /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Closing Cash ($)</label><input type="number" x-model="form.closing_cash" class="input w-full" step="0.01" min="0" placeholder="0.00" :disabled="form.status!=='closed'" /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Expected Cash ($)</label><input type="number" x-model="form.expected_cash" class="input w-full" step="0.01" min="0" placeholder="Auto-computed" :disabled="form.status!=='closed'" /></div>
          <div class="sm:col-span-2"><label class="text-xs font-medium opacity-70 mb-1 block">Notes</label><textarea x-model="form.notes" class="input w-full" rows="2" placeholder="Shift notes…"></textarea></div>
          <div x-show="shiftError" class="text-xs text-error rounded bg-[var(--color-error)]/10 px-3 py-2" x-text="shiftError"></div>
        </div>
        <div class="flex gap-2 justify-end pt-2 border-t border-[var(--color-border-subtle)]"><button @click="closeForm()" class="btn btn-ghost btn-sm" :disabled="formSaving">Cancel</button><button @click="doSave()" class="btn btn-primary btn-sm gap-1" :disabled="formSaving"><span x-show="formSaving" class="inline-block h-3 w-3 animate-spin rounded-full border-2 border-current border-t-transparent"></span><span x-text="editingItem?'Update':'Create'"></span></button></div>
      </div>
    </div>
  </div>
</Layout>

<script>import Alpine from 'alpinejs';document.addEventListener('alpine:init',()=>{Alpine.data('opsShifts',()=>({items:[],employeeList:[],loading:true,search:'',page:1,perPage:20,deleteTarget:null,formOpen:false,formSaving:false,editingItem:null,form:{employee_id:'',status:'open',opening_cash:'',closing_cash:'',expected_cash:'',notes:''},      get total(){return this.items.length},get filteredItems(){let l=this.items;if(this.search){const q=this.search.toLowerCase();l=l.filter((i:any)=>Object.values(i).some(v=>String(v).toLowerCase().includes(q)))}return l},pagedItems(){const s=(this.page-1)*this.perPage;return this.filteredItems.slice(s,s+this.perPage)},      empName(id:any){const e=this.employeeList.find((x:any)=>String(x.id)===String(id));return e?((e.first_name||'')+' '+(e.last_name||'')).trim():''},shiftDuration(item:any){if(!item)return '-';if(item.status==='closed'&&item.closed_at){const d=new Date(item.closed_at).getTime()-new Date(item.opened_at).getTime();if(!isNaN(d))return (Math.max(d,0)/3600000).toFixed(1)+'h'}return 'Ongoing'},expectedCash(shift:any){if(!shift||shift.status!=='open')return 0;const opened=new Date(String(shift.opened_at)).getTime();const windowStart=new Date(opened.getTime()-86400000).toISOString().slice(0,19).replace('T',' ');const windowEnd=new Date(opened.getTime()+86400000).toISOString().slice(0,19).replace('T',' ');return this._expectedCache?.(shift.id)?.[windowStart+'|'+windowEnd]??0},async load(){this.loading=true;this.shiftError=null;this._expectedCache={};try{const[r,e]=await Promise.all([fetch('/ops/shifts/'),fetch('/employees/')]);if(r.ok){const d=await r.json();this.items=d.data||d||[]}if(e.ok){const d=await e.json();this.employeeList=d.data||d||[]}}catch(e){console.error(e)}finally{this.loading=false}},resetForm(){this.form={employee_id:'',status:'open',opening_cash:'',closing_cash:'',expected_cash:'',notes:''};this.editingItem=null},openAdd(){this.resetForm();this.formOpen=true},      async openEdit(item:any){this.resetForm();this.editingItem=item;this.form={employee_id:item.employee_id??item.employee??'',status:item.status||'open',opening_cash:item.opening_cash??'',closing_cash:item.closing_cash??'',expected_cash:item.expected_cash?Number(item.expected_cash):'',notes:item.notes||''};this.formOpen=true;this.shiftError=null;if(item.status==='open'){this._expectedCache={};try{const r=await fetch('/sales/',{headers:{'X-Shift-Expected':'1'}});if(r.ok){this._expectedCache[item.id]={total:await r.json().then?.(j=>j.data?.total??0)}catch(e){0}}catch(e){this._expectedCache[item.id]={total:0}}},closeForm(){if(this.formSaving)return;this.formOpen=false;this.resetForm()},      async doSave(){
        if(!this.form.opening_cash){
          this.$store.ui.toast('Opening cash is required','error');
          return
        }
        this.shiftError=null;
        if(this.form.status==='closed'&&!this.form.closing_cash){
          this.$store.ui.toast('Closing cash is required to close a shift','error');
          return
        }
        if(this.form.status==='closed'){
          const expected=parseFloat(String(this.form.expected_cash))||0;
          if(this.form.closing_cash!==''&&Math.abs(parseFloat(String(this.form.closing_cash))-expected)>0.005){
            this.shiftError='Closing cash differs from expected by $'+(Math.abs(parseFloat(String(this.form.closing_cash))-expected).toFixed(2));
          }
        }
        if(this.shiftError)return;
        this.formSaving=true;
        const p={employee_id:this.form.employee_id?parseInt(String(this.form.employee_id)):null,status:this.form.status,opening_cash:parseFloat(String(this.form.opening_cash))||0,closing_cash:this.form.closing_cash!==''?parseFloat(String(this.form.closing_cash)):null,expected_cash:this.form.expected_cash!==''?parseFloat(String(this.form.expected_cash)):null,notes:this.form.notes};try{let r;if(this.editingItem){r=await fetch('/ops/shifts/'+this.editingItem.id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(p)})}else{r=await fetch('/ops/shifts/',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(p)})}if(r.ok){this.$store.ui.toast(this.editingItem?'Shift updated':'Shift opened','success');this.closeForm();await this.load()}else{const e=await r.text();this.$store.ui.toast('Save failed: '+(e||r.status),'error')}}catch(e){this.$store.ui.toast('Network error','error')}finally{this.formSaving=false}},      confirmDelete(item:any){this.deleteTarget=item},async doDelete(){if(!this.deleteTarget)return;if(this.deleteTarget.status==='open'){this.$store.ui.toast('Cannot delete an open shift; close it first','error');this.deleteTarget=null;return}const id=this.deleteTarget.id;this.deleteTarget=null;try{await fetch('/ops/shifts/'+id,{method:'DELETE'});this.items=this.items.filter((i:any)=>i.id!==id);this.$store.ui.toast('Deleted','success')}catch(e){this.$store.ui.toast('Failed','error')}}}))});</script>

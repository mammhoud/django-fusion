{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "formint-pos-frontend",
  "root": "projects/formints/formint-pro/frontend",
  "projectType": "application",
  "tags": ["product:formint-pro", "type:frontend", "stack:astro"],
  "implicitDependencies": ["formint-pro-server"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build", "cwd": "projects/formints/formint-pro/frontend" }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run check", "cwd": "projects/formints/formint-pro/frontend" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run test", "cwd": "projects/formints/formint-pro/frontend" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run dev", "cwd": "projects/formints/formint-pro/frontend" }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run preview", "cwd": "projects/formints/formint-pro/frontend" }
    }
  }
}

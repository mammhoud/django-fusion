# ================================================================
# Formint Pro — Frontend (Astro) Environment
# ================================================================
# Copy to `.env` and adjust. Read by astro.config.mjs (PORT,
# BACKEND_URL) for the dev server + proxy.
# ================================================================

# ── Ports & dev proxy ────────────────────────────────────────────
# Astro dev server port
PORT=4321
# Django ASGI backend origin for the dev proxy (HTMX, fusion APIs,
# server-compatible endpoints, WebSocket /ws). Change to the service
# name in Docker builds.
BACKEND_URL=http://127.0.0.1:8766

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Formint POS Professional",
  "version": "0.1.0",
  "identifier": "cloud.structa.formint.pos",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Formint POS Professional",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Structa Cloud",
    "copyright": "© 2026 Structa Cloud. All rights reserved.",
    "category": "Business",
    "shortDescription": "Arabic-first restaurant operations POS",
    "longDescription": "Formint POS Professional is an offline-capable restaurant point-of-sale application with Django business services, an Astro interface, and native Tauri integrations.",
    "externalBin": ["binaries/formint-backend"],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}

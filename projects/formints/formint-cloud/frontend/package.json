{
  "name": "formint-cloud",
  "private": true,
  "version": "0.1.0",
  "description": "Formint Cloud — Community UI wired to the Formint Cloud Django backend",
  "author": "mammhoud <structa.cloud@gmail.com>",
  "license": "AGPL-3.0",
  "homepage": "https://structa.cloud",
  "repository": {
    "type": "git",
    "url": "https://github.com/mammhoud/POS"
  },
  "keywords": [
    "restaurant-management",
    "pos-system",
    "point-of-sale",
    "app",
    "cross-platform",
    "offline",
    "offline-first",
    "desktop-app",
    "tauri",
    "tauri-app",
    "react",
    "desktop-app",
    "typescript",
    "rust",
    "sqlite",
    "inventory-management",
    "sales-tracking",
    "analytics",
    "dashboard",
    "transaction-management",
    "business-management",
    "restaurant",
    "cafe-management",
    "food-service",
    "hospitality",
    "small-business",
    "retail",
    "open-source",
    "agpl",
    "privacy-focused",
    "local-storage",
    "self-hosted",
    "lightweight",
    "modern-ui",
    "dark-mode",
    "electron-alternative"
  ],
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:desktop": "pnpm tauri dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "tauri": "tauri",
    "lint:contrast": "node scripts/lint-contrast.mjs",
    "lint:contrast:fix": "node scripts/lint-contrast.mjs --fix",
    "prebuild": "PROJECT_ROOT=. node ../scripts/dev/update-year.cjs && PROJECT_ROOT=. node ../scripts/dev/ensure-db.cjs",
    "predev": "node ../scripts/dev/kill-port.cjs && PROJECT_ROOT=. node ../scripts/dev/update-year.cjs && PROJECT_ROOT=. node ../scripts/dev/ensure-db.cjs",
    "build:desktop": "pnpm build && pnpm tauri build && PROJECT_ROOT=. node ../scripts/publish/generate-checksums.cjs",
    "build:android": "pnpm tauri android build && PROJECT_ROOT=. node ../scripts/publish/generate-checksums.cjs",
    "build:ios": "pnpm tauri ios build && PROJECT_ROOT=. node ../scripts/publish/generate-checksums.cjs",
    "build:all": "node ../scripts/publish/build-all.cjs",
    "build:server": "PROJECT_ROOT=. node ../scripts/publish/build-server.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test",
    "checksums": "PROJECT_ROOT=. node ../scripts/publish/generate-checksums.cjs",
    "verify": "node ../scripts/publish/verify-checksum.cjs",
    "db:seed": "cargo run --manifest-path src-tauri/Cargo.toml --bin seed",
    "db:reset": "rm -f restaurant.db && cargo run --manifest-path src-tauri/Cargo.toml --bin seed"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@formints/client": "file:../../packages/formints-client",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "astro": "^5.18.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "flyonui": "^2.4.1",
    "gsap": "^3.15.0",
    "i18next": "^26.3.6",
    "jspdf": "^2.5.2",
    "lucide-react": "^1.28.0",
    "pnpm": "^11.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.9",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.15.0",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "baseline-browser-mapping": "^2.10.43",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}

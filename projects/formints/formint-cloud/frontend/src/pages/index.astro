---
// Formint Cloud — marketing landing page.
//
// This is the public-facing surface of the cloud product. It is a static,
// server-rendered Astro page (no React island): the app itself lives behind
// the "Launch the app" CTA, which routes to /dashboard where the existing
// auth gate takes over. Keeping the landing island-free keeps LCP lean and
// matches the output: 'static' config.
//
// Design: dark-tech copper-crest identity, extracted from the product's only
// real brand assets: the Formint crest (copper gradient #EA580C → #9A3412,
// amber spark #F59E0B) and the self-hosted Outfit type family.
//
// Section layout families (no repeats): split hero → bento grid → editions
// strip → full-width statement band → CTA band. Motion is IntersectionObserver
// scroll reveals + a slow crest ring rotation, both gated by
// prefers-reduced-motion. One accent (copper) locked across the whole page.
// Zero em-dashes in copy.

import '../../assets/styles/fonts/outfit.css';
import '../../assets/styles/fonts/roboto.css';
// Vite types SVG imports as an Astro component union; we only need the URL.
import crest from '../../assets/images/formint-crest.svg';
const crestUrl: string = (crest as unknown as { src: string }).src ?? String(crest);

const year = new Date().getFullYear();

// ── Bento cells ── Real shipped features of the Pro/Cloud editions.
const features = [
  {
    icon: 'ri-cloud-line',
    title: 'Multi-terminal sync',
    body: 'Changes on one register broadcast to every other terminal in real time, with conflict resolution when two floors disagree.',
    tint: true,
    photo: false,
  },
  {
    icon: 'ri-wifi-off-line',
    title: 'Offline queue',
    body: 'Sales recorded while the cloud is unreachable flush automatically when the connection returns. Nothing rings twice.',
    tint: false,
    photo: false,
  },
  {
    icon: 'ri-scan-2-line',
    title: 'Barcode scanning',
    body: 'Point a scanner at any label and the item lands in the sale. SKU fallback covers legacy tickets.',
    tint: false,
    photo: false,
  },
  {
    icon: 'ri-gift-line',
    title: 'Gift cards',
    body: 'Issue, redeem, reload, and void cards against a full ledger, with expiry and balance guards built in.',
    tint: false,
    photo: false,
  },
  {
    icon: 'ri-scissors-line',
    title: 'Split and merge',
    body: 'Split a check across a table, or fold tabs back together, without losing a line item.',
    tint: false,
    photo: false,
  },
  {
    icon: 'ri-restaurant-line',
    title: 'Built for the floor',
    body: 'Kitchen display stations, QR menus, loyalty, and gaming-center sessions are part of the same ticket.',
    tint: false,
    photo: true,
  },
];

// Picsum seed keeps the photo stable across builds; the copper scrim keeps it
// inside the page palette. Replace with real brand photography before launch.
const floorPhoto = 'https://picsum.photos/seed/formint-floor/1200/900';

// ── Editions ── The three real product editions.
const editions = [
  {
    name: 'Community',
    tagline: 'Single terminal essentials',
    points: ['Core POS sale flow', 'Local products and inventory', 'Receipt and ticket printing'],
    featured: false,
  },
  {
    name: 'Pro',
    tagline: 'Multi-terminal operations',
    points: ['Real-time terminal sync', 'Offline queue with retry', 'Barcode scanning and gift cards', 'Gaming center sessions'],
    featured: true,
  },
  {
    name: 'Cloud',
    tagline: 'Master data across branches',
    points: ['Cloud master data and sync', 'Multi-branch dashboard', 'Conflict and queue management', 'Device token provisioning'],
    featured: false,
  },
];
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Formint Cloud · Point of Sale for busy kitchens</title>
    <meta
      name="description"
      content="Multi-terminal point of sale with offline-safe sales, barcode scanning, gift cards, and a cloud dashboard across every branch."
    />
    <link rel="icon" type="image/svg+xml" href="/Logo.svg" />
    <link rel="alternate icon" type="image/svg+xml" href="/Logo.png.placeholder.svg" />

    <!-- Theme is locked to dark: the copper crest is a dark-ink mark, and the
         product UI behind the CTA is dark-first as well. -->
    <style>
      :root {
        color-scheme: dark;
        --ink: #09090b;
        --ink-raised: #101013;
        --ink-line: rgba(244, 244, 245, 0.08);
        --paper: #f4f4f5;
        --paper-muted: rgba(244, 244, 245, 0.62);
        --paper-faint: rgba(244, 244, 245, 0.38);
        --copper: #ea580c;
        --copper-bright: #fb923c;
        --copper-deep: #9a3412;
        --amber: #f59e0b;
        --radius-card: 1rem;
        --radius-pill: 999px;
      }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--ink);
        color: var(--paper);
        font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      ::selection { background: rgba(234, 88, 12, 0.35); color: #fff; }

      /* Display type: self-hosted Outfit. */
      .display { font-family: 'Outfit', 'Roboto', sans-serif; letter-spacing: -0.02em; }

      /* ── Grain overlay: fixed, pointer-events-none only ── */
      .grain {
        position: fixed; inset: 0; z-index: 60; pointer-events: none;
        opacity: 0.05;
        background-image: url('/bg-texture.svg');
        background-size: 180px 180px;
        mix-blend-mode: overlay;
      }

      /* ── Copper crest ring: slow rotation, transform-only, reduced-motion gated ── */
      .crest-ring { animation: crestSpin 26s linear infinite; transform-origin: center; }
      .crest-spark { animation: crestPulse 2.4s ease-in-out infinite; transform-origin: center; }
      @keyframes crestSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
      @keyframes crestPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }

      /* ── Scroll reveal: opacity + translate, IO-driven, reduced-motion gated ── */
      .reveal { opacity: 0; transform: translateY(18px); transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
      .reveal.is-in { opacity: 1; transform: none; }

      /* ── Hairline utility (sparse dividers, never per-row) ── */
      .hairline { border-color: var(--ink-line); }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .crest-ring, .crest-spark { animation: none; }
        .reveal { opacity: 1; transform: none; transition: none; }
      }
    </style>
  </head>

  <body>
    <div class="grain" aria-hidden="true"></div>

    <!-- ── Nav: single line, ≤80px ── -->
    <header class="sticky top-0 z-50 border-b hairline bg-zinc-950/80 backdrop-blur-md">
      <nav class="mx-auto flex h-16 max-w-[1400px] items-center justify-between px-5 md:px-8" aria-label="Main">
        <a href="/" class="flex items-center gap-2.5" aria-label="Formint home">
          <img src={crestUrl} alt="" class="h-8 w-8 object-contain" width="32" height="32" />
          <span class="display text-lg font-semibold tracking-tight">Formint</span>
        </a>
        <div class="flex items-center gap-6">
          <a href="#features" class="hidden text-sm font-medium text-zinc-400 transition-colors hover:text-zinc-100 sm:block">Features</a>
          <a href="#editions" class="hidden text-sm font-medium text-zinc-400 transition-colors hover:text-zinc-100 sm:block">Editions</a>
          <a
            href="/dashboard"
            class="inline-flex h-10 items-center rounded-full bg-zinc-100 px-5 text-sm font-semibold text-zinc-900 transition-all hover:bg-white active:scale-[0.98]"
          >
            Sign in
          </a>
        </div>
      </nav>
    </header>

    <main>
      <!-- ── Hero: asymmetric split, copy left / crest right ── -->
      <section class="relative mx-auto flex min-h-[100dvh] max-w-[1400px] flex-col items-center gap-12 px-5 pb-16 pt-16 md:px-8 lg:flex-row lg:gap-10 lg:pt-24">
        <!-- Copper glow behind the crest, right side -->
        <div class="pointer-events-none absolute right-[-10%] top-1/2 hidden h-[560px] w-[560px] -translate-y-1/2 rounded-full lg:block" aria-hidden="true">
          <div class="h-full w-full rounded-full bg-[radial-gradient(circle,rgba(234,88,12,0.22),transparent_62%)]"></div>
        </div>

        <div class="relative z-10 max-w-2xl">
          <h1 class="display text-5xl font-bold leading-[1.05] md:text-6xl">
            The point of sale for a busy floor
          </h1>
          <p class="mt-6 max-w-[46ch] text-lg leading-relaxed text-zinc-400">
            Multi-terminal sync, offline-safe sales, and a cloud dashboard across every branch. Built for restaurants that never close.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href="/dashboard"
              class="inline-flex h-12 items-center justify-center rounded-full bg-[#c2410c] px-7 text-base font-semibold text-white transition-all hover:bg-[#ea580c] active:scale-[0.98]"
            >
              Launch the app
            </a>
            <a
              href="#features"
              class="inline-flex h-12 items-center justify-center rounded-full border border-zinc-800 px-7 text-base font-semibold text-zinc-200 transition-colors hover:border-zinc-600"
            >
              See features
            </a>
          </div>
        </div>

        <!-- Crest visual: the real brand mark, with a slow copper ring -->
        <div class="relative z-10 flex w-full max-w-md items-center justify-center lg:max-w-lg">
          <div class="relative">
            <div class="pointer-events-none absolute -inset-10 rounded-full bg-[radial-gradient(circle,rgba(245,158,11,0.16),transparent_70%)]" aria-hidden="true"></div>
            <div class="crest-ring relative block" aria-hidden="true">
              <img src={crestUrl} alt="" class="h-64 w-64 object-contain drop-shadow-[0_24px_48px_rgba(234,88,12,0.28)] md:h-80 md:w-80" width="320" height="320" />
            </div>
            <span class="crest-spark absolute right-2 top-2 h-3 w-3 rounded-full bg-[#f59e0b]" aria-hidden="true"></span>
          </div>
        </div>
      </section>

      <!-- ── Feature bento: 5+1 cells, mixed sizes, copper-tinted variation ── -->
      <section id="features" class="mx-auto max-w-[1400px] px-5 py-24 md:px-8 md:py-32">
        <div class="reveal max-w-2xl">
          <h2 class="display text-4xl font-bold md:text-5xl">Everything a busy floor needs</h2>
          <p class="mt-5 text-lg leading-relaxed text-zinc-400">
            The features below are shipped today across the Pro and Cloud editions, not roadmap promises.
          </p>
        </div>

        <div class="mt-14 grid grid-cols-1 gap-4 md:grid-cols-6">
          {features.map((f, i) => {
            // Bento rhythm fills every row of the 6-col grid: wide+tall pair
            // (4+2), then two equal pairs (3+3, 3+3). No empty cells.
            const span = i === 0 ? 'md:col-span-4' : i === 1 ? 'md:col-span-2' : 'md:col-span-3';
            const base = 'reveal rounded-2xl border transition-colors hover:border-zinc-600';
            if (f.photo) {
              return (
                <article class:list={[span, base, 'relative min-h-[300px] overflow-hidden border-zinc-800']} style={`transition-delay:${i * 45}ms`}>
                  <img src={floorPhoto} alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
                  <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(9,9,11,0.15),rgba(9,9,11,0.85))]" aria-hidden="true"></div>
                  <div class="relative z-10 flex h-full flex-col justify-end p-7 md:p-8">
                    <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-zinc-900/80 text-lg text-zinc-200" aria-hidden="true">
                      <i class={f.icon}></i>
                    </span>
                    <h3 class="display mt-4 text-xl font-semibold">{f.title}</h3>
                    <p class="mt-2 text-[15px] leading-relaxed text-zinc-300">{f.body}</p>
                  </div>
                </article>
              );
            }
            const bg = f.tint
              ? 'bg-[linear-gradient(160deg,rgba(234,88,12,0.16),rgba(154,34,18,0.05))] border-[#ea580c]/25'
              : 'bg-[#101013] border-zinc-800/80';
            return (
              <article class:list={[span, base, 'p-7 md:p-8', bg]} style={`transition-delay:${i * 45}ms`}>
                <span class={`inline-flex h-11 w-11 items-center justify-center rounded-xl text-lg ${f.tint ? 'bg-[#ea580c]/20 text-[#fb923c]' : 'bg-zinc-800/60 text-zinc-300'}`} aria-hidden="true">
                  <i class={f.icon}></i>
                </span>
                <h3 class="display mt-5 text-xl font-semibold">{f.title}</h3>
                <p class="mt-2.5 text-[15px] leading-relaxed text-zinc-400">{f.body}</p>
              </article>
            );
          })}
        </div>
      </section>

      <!-- ── Editions strip: Pro featured, asymmetric columns ── -->
      <section id="editions" class="border-y hairline bg-[#0c0c0f]">
        <div class="mx-auto max-w-[1400px] px-5 py-24 md:px-8 md:py-32">
          <div class="reveal max-w-2xl">
            <h2 class="display text-4xl font-bold md:text-5xl">Three editions. One data model.</h2>
            <p class="mt-5 text-lg leading-relaxed text-zinc-400">
              Start on a single register and grow to a cloud-managed multi-branch operation without re-entering data.
            </p>
          </div>

          <div class="mt-14 grid grid-cols-1 items-stretch gap-4 lg:grid-cols-3">
            {editions.map((ed, i) => (
              <article
                class:list={[
                  'reveal flex flex-col rounded-2xl border p-8',
                  ed.featured
                    ? 'border-[#ea580c]/40 bg-[linear-gradient(160deg,rgba(234,88,12,0.14),rgba(9,9,11,0.9))] shadow-[0_24px_60px_-20px_rgba(234,88,12,0.35)] lg:scale-[1.03]'
                    : 'border-zinc-800/80 bg-[#101013]',
                ]}
                style={`transition-delay:${i * 60}ms`}
              >
                <div class="flex items-baseline justify-between gap-3">
                  <h3 class="display text-2xl font-semibold">{ed.name}</h3>
                  {ed.featured && (
                    <span class="rounded-full bg-[#c2410c] px-3 py-1 text-xs font-semibold text-white">Current pick</span>
                  )}
                </div>
                <p class="mt-1.5 text-sm font-medium text-zinc-500">{ed.tagline}</p>
                <ul class="mt-6 space-y-3">
                  {ed.points.map((p) => (
                    <li class="text-[15px] leading-relaxed text-zinc-300">{p}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ── Full-width statement band: sync architecture ── -->
      <section class="mx-auto max-w-[1400px] px-5 py-24 md:px-8 md:py-32">
        <div class="reveal max-w-3xl">
          <h2 class="display text-4xl font-bold leading-[1.05] md:text-6xl">One register. Every branch.</h2>
          <p class="mt-6 max-w-[62ch] text-lg leading-relaxed text-zinc-400">
            Terminals pull a change feed from the cloud master, apply it in dependency order, and push local changes back with retry and backoff. The offline queue holds every sale until the connection returns.
          </p>
          <p class="mt-4 max-w-[62ch] text-[15px] leading-relaxed text-zinc-500">
            No sync loops. No double ring-ups. Conflicts surface in the cloud dashboard for a manager to resolve.
          </p>
        </div>
      </section>

      <!-- ── CTA band: copper, one message, one CTA ── -->
      <section class="mx-auto max-w-[1400px] px-5 pb-24 md:px-8 md:pb-32">
        <div class="reveal relative overflow-hidden rounded-3xl border border-[#ea580c]/30 bg-[linear-gradient(120deg,rgba(234,88,12,0.22),rgba(154,34,18,0.08),rgba(9,9,11,0.6))] px-6 py-20 text-center md:px-12 md:py-24">
          <div class="pointer-events-none absolute -top-24 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(245,158,11,0.2),transparent_70%)]" aria-hidden="true"></div>
          <div class="relative z-10 mx-auto max-w-2xl">
            <h2 class="display text-4xl font-bold md:text-5xl">Ready to run your floor on Formint</h2>
            <p class="mt-5 text-lg leading-relaxed text-zinc-300">
              The app is live. Open the dashboard and start a sale in under a minute.
            </p>
            <a
              href="/dashboard"
              class="mt-9 inline-flex h-12 items-center justify-center rounded-full bg-zinc-100 px-8 text-base font-semibold text-zinc-900 transition-all hover:bg-white active:scale-[0.98]"
            >
              Launch the app
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- ── Footer: brand, minimal links, no version strings ── -->
    <footer class="border-t hairline">
      <div class="mx-auto flex max-w-[1400px] flex-col items-center justify-between gap-6 px-5 py-10 md:flex-row md:px-8">
        <div class="flex items-center gap-2.5">
          <img src={crestUrl} alt="" class="h-7 w-7 object-contain" width="28" height="28" />
          <span class="display text-base font-semibold">Formint Cloud</span>
        </div>
        <p class="text-sm text-zinc-500">© {year} Structa Cloud. Point of sale for busy kitchens.</p>
        <a href="/dashboard" class="text-sm font-medium text-zinc-400 transition-colors hover:text-zinc-100">Sign in</a>
      </div>
    </footer>

    <!-- ── Scroll reveal: IntersectionObserver only (no scroll listeners) ── -->
    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>

---
import '../../assets/styles/index.css';
import AppIsland from '../AppIsland';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Formint', description = 'Formint — Point of Sale System' } =
  Astro.props;

// Astro's file-based routing: each page path maps to an .astro file, so the
// pathname below is the route the AppShell island should render.
const route = Astro.url.pathname;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/Logo.svg" />
    <link rel="alternate icon" type="image/png" href="/Logo.png" />
    <meta name="description" content={description} />
    <title>{title} · Formint</title>

    <!-- Set theme + language before the page renders to prevent a flash of the
         wrong theme / text direction. Mirrors the FlyonUI theme map used by
         ThemeContext (variant + mode → data-theme). -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme-mode') || localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var mode = saved === 'dark' ? 'dark' : saved === 'light' ? 'light' : prefersDark ? 'dark' : 'light';
          var variant = localStorage.getItem('theme-variant') || 'perplexity';
          var theme =
            variant === 'default' ? mode
            : variant === 'perplexity' ? (mode === 'dark' ? 'perplexity-dark' : 'perplexity')
            : variant + '-' + mode;
          document.documentElement.classList.add(mode);
          document.documentElement.setAttribute('data-theme', theme);
          var lang = localStorage.getItem('language') || 'en';
          document.documentElement.lang = lang;
          document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
        } catch (e) {}
      })();
    </script>

    <!-- Pre-island branded splash — replaced by React on first commit. -->
    <style is:global>
      .formint-splash {
        position: fixed; inset: 0; display: flex; flex-direction: column;
        align-items: center; justify-content: center; gap: 1.25rem;
        background: #ffffff; color: #1e293b;
        font-family: Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      html.dark .formint-splash { background: #0f172a; color: #e2e8f0; }
      .formint-splash img { width: 84px; height: 84px; object-fit: contain; filter: drop-shadow(0 10px 24px rgb(234 88 12 / 0.25)); }
      .formint-splash .formint-name { font-size: 1.35rem; font-weight: 700; letter-spacing: 0.02em; }
      .formint-splash .formint-bar { width: 180px; height: 3px; border-radius: 999px; overflow: hidden; background: rgb(148 163 184 / 0.25); }
      .formint-splash .formint-bar::after {
        content: ''; display: block; height: 100%; width: 40%; border-radius: 999px;
        background: #ea580c;
        animation: formint-slide 1.1s ease-in-out infinite;
      }
      html.dark .formint-splash .formint-bar { background: rgb(148 163 184 / 0.25); }
      @keyframes formint-slide { 0% { transform: translateX(-110%); } 100% { transform: translateX(290%); } }
    </style>
  </head>

  <body>
    <div id="root">
      <div class="formint-splash" id="formint-splash">
        <img src="/Logo.svg" alt="Formint" />
        <div class="formint-name">Formint</div>
        <div class="formint-bar"></div>
      </div>
    </div>

    <!-- The whole app chrome + page content hydrates client-side inside this
         island; `client:only` skips SSR because Tauri APIs aren't available
         at build time. AppIsland restores the provider stack (auth, theme,
         language, currency, modals) around AppShell. -->
    <AppIsland route={route} client:only="react" />
  </body>
</html>

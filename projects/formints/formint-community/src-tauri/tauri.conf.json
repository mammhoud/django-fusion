{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Formints Community",
  "version": "0.1.0",
  "identifier": "com.mammhoud.formint-community",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Formints Community",
        "width": 1200,
        "height": 800,
        "center": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Structa Cloud",
    "copyright": "© 2026 Structa Cloud. All rights reserved.",
    "category": "Business",
    "shortDescription": "Formints Community — Point of Sale System",
    "longDescription": "Formints Community is a free, offline-first point-of-sale system for managing restaurant sales, inventory, analytics, and more. Built with Tauri, React, and Rust.",
    "homepage": "https://structa.cloud",
    "licenseFile": "../LICENSE",
    "icon": [
      "../assets/icons/icon.png",
      "../assets/icons/32x32.png",
      "../assets/icons/128x128.png",
      "../assets/icons/128x128@2x.png",
      "../assets/icons/256x256.png",
      "../assets/icons/512x512.png",
      "../assets/icons/icon.icns",
      "../assets/icons/icon.ico"
    ],
    "externalBin": [
      "binaries/pos-server"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installerIcon": "../assets/icons/icon.ico"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      }
    },
    "iOS": {},
    "android": {}
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    },
    "shell": {
      "open": true
    }
  }
}

---
/**
 * ScrollMotion — GSAP ScrollTrigger choreography for the storefront.
 *
 * Renders no markup; ships a bundled module script that:
 *   1. Pins the showcase section title on the left while the product gallery
 *      scrubs upward beside it (Scroll Pinning — GSAP Split).
 *   2. Applies the Image Scale & Fade paradigm: media starts at scale 0.8 /
 *      opacity 0.35 and grows to full as it enters; darkens and fades as it
 *      leaves the viewport (transform + opacity only).
 *   3. Re-initialises after HTMX swaps the product grid, killing stale
 *      triggers first so detached nodes never accumulate.
 *
 * Motion is gated behind gsap.matchMedia so `prefers-reduced-motion` users
 * get a static, fully readable layout, and every tween uses only transform
 * and opacity (hardware-accelerated).
 */
---

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Registry of active triggers so re-inits can clean up before re-arming.
  const imageTriggers: gsap.core.Tween[] = [];
  const killImageTriggers = () => {
    while (imageTriggers.length) {
      const t = imageTriggers.pop();
      if (!t) {
        continue;
      }
      t.scrollTrigger?.kill();
      t.kill();
    }
  };

  const initShowcase = () => {
    const section = document.querySelector<HTMLElement>('[data-showcase-pin]');
    const track = document.querySelector<HTMLElement>('[data-showcase-track]');
    if (!section || !track) {
      return;
    }

    // The track is a vertical stack on desktop; we translate it upward so
    // the pinned title stays while cards scrub past.
    const mm = gsap.matchMedia();
    mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
      const distance = () => Math.max(track.scrollHeight - section.clientHeight + 160, 0);
      const tween = gsap.to(track, {
        y: () => -distance(),
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: () => `+=${distance()}`,
          scrub: 1,
          pin: true,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });
      return () => {
        tween.scrollTrigger?.kill();
        tween.kill();
      };
    });
  };

  const initImageFade = (scope: Element | Document = document) => {
    const imgs = scope.querySelectorAll<HTMLElement>('[data-gsap-media]');
    if (!imgs.length) {
      return;
    }

    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      imgs.forEach((el) => {
        const tween = gsap.fromTo(
          el,
          { scale: 0.8, opacity: 0.35 },
          {
            scale: 1,
            opacity: 1,
            ease: 'none',
            scrollTrigger: {
              trigger: el,
              start: 'top 92%',
              end: 'bottom 20%',
              scrub: 1.2,
            },
          },
        );
        imageTriggers.push(tween);
      });
      return () => killImageTriggers();
    });
  };

  const init = () => {
    initShowcase();
    initImageFade();
    ScrollTrigger.refresh();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }

  // HTMX replaced the product grid — kill stale triggers, re-arm the new nodes.
  document.addEventListener('htmx:afterSwap', (e) => {
    const target = (e as CustomEvent).detail?.target as HTMLElement | undefined;
    if (target?.id === 'product-grid') {
      killImageTriggers();
      initImageFade(target);
      ScrollTrigger.refresh();
    }
  });
</script>

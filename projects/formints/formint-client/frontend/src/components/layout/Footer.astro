---
interface Props {
  shopName?: string;
}
const { shopName = 'The Daily Grind' } = Astro.props;
---

<footer class="border-t border-fu-line bg-fu-card">
  <div class="container-fusion grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="font-mono text-sm font-semibold tracking-tight text-fu-ink">{shopName}</p>
      <p class="mt-3 max-w-[40ch] text-sm leading-relaxed text-fu-muted">
        Roasted in small batches, brewed to order. This storefront runs on the
        AHA stack — Astro renders, HTMX swaps, Alpine hydrates.
      </p>
      <div class="mt-4 flex items-center gap-2">
        <span class="live-dot" aria-hidden="true"></span>
        <span class="font-mono text-[0.65rem] uppercase tracking-widest text-fu-muted">Open now · Mon–Sun 7:00 → 19:00</span>
      </div>
    </div>

    <div>
      <p class="tag-marker mb-3">Menu</p>
      <ul class="space-y-2 text-sm text-fu-muted">
        <li><a href="/#menu" class="transition-colors hover:text-fu-ink">Full menu</a></li>
        <li><a href="/#coffee" class="transition-colors hover:text-fu-ink">Coffee</a></li>
        <li><a href="/#breakfast" class="transition-colors hover:text-fu-ink">Breakfast</a></li>
        <li><a href="/#lunch" class="transition-colors hover:text-fu-ink">Lunch</a></li>
      </ul>
    </div>

    <div>
      <p class="tag-marker mb-3">Account</p>
      <ul class="space-y-2 text-sm text-fu-muted">
        <li><a href="/accounts/login/" class="transition-colors hover:text-fu-ink">Sign in</a></li>
        <li><a href="/accounts/signup/" class="transition-colors hover:text-fu-ink">Create account</a></li>
        <li><a href="/orders/mine/" class="transition-colors hover:text-fu-ink">My orders</a></li>
        <li><a href="/employee/" class="transition-colors hover:text-fu-ink">Staff desk</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-fu-line">
    <div class="container-fusion flex flex-col items-center justify-between gap-2 py-6 sm:flex-row">
      <p class="font-mono text-[0.65rem] uppercase tracking-widest text-fu-muted">
        © 2026 {shopName} · Structa Cloud
      </p>
      <p class="font-mono text-[0.65rem] uppercase tracking-widest text-fu-muted">
        Astro · HTMX · Alpine · Django
      </p>
    </div>
  </div>
</footer>

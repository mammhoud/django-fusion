---
// LoginModal — sign-in powered by django-allauth headless API (mirrors
// precis-landing's modal on the same contract):
//   POST /api/auth/browser/v1/auth/login   { email, password }
//   GET  /api/auth/browser/v1/auth/session
//   DELETE /api/auth/browser/v1/auth/session
---

<div
  x-data="{
    open: false, email: '', password: '', loading: false, error: '',
    async submit() {
      this.loading = true; this.error = '';
      try {
        // Django CSRF — without the X-CSRFToken header this POST returns 403.
        // If the token cookie has not arrived yet (grid fragment still loading),
        // seed it with a fragment GET before submitting.
        if (!window.FormintCsrf?.getToken?.()) {
          try { await fetch('/shop/fragments/products/', { headers: { Accept: 'text/html' } }); } catch (e) {}
        }
        const res = await fetch('/api/auth/browser/v1/auth/login', {
          method: 'POST', credentials: 'include',
          headers: window.FormintCsrf?.headers?.({ Accept: 'application/json' }) || { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: this.email, password: this.password }),
        });
        if (res.status === 200 || res.status === 201) {
          this.open = false; this.email = ''; this.password = '';
          window.dispatchEvent(new CustomEvent('fusion:toast', { detail: { message: 'Signed in. Welcome back.', kind: 'success' } }));
          setTimeout(() => location.reload(), 700);
        } else {
          const data = await res.json().catch(() => ({}));
          const errors = data?.errors || [];
          this.error = errors.map((e) => e.message).join(' ') || 'Sign-in failed. Check your email and password.';
        }
      } catch (e) {
        this.error = 'Network error. Please try again.';
      } finally {
        this.loading = false;
      }
    },
  }"
  @keydown.escape.window="open = false"
  @fusion:open-login.window="open = true"
>
  <div
    x-show="open"
    x-cloak
    style="display:none"
    x-transition:enter="transition ease-[cubic-bezier(0.32,0.72,0,1)] duration-500"
    x-transition:enter-start="opacity-0 scale-[0.98]"
    x-transition:enter-end="opacity-100 scale-100"
    x-transition:leave="transition ease-[cubic-bezier(0.32,0.72,0,1)] duration-200"
    x-transition:leave-start="opacity-100 scale-100"
    x-transition:leave-end="opacity-0 scale-[0.98]"
    class="fixed inset-0 z-[90] flex items-center justify-center bg-fu-ink/40 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="Sign in"
    @click.self="open = false"
  >
    <!-- Double-bezel modal — hairline shell + inset card -->
    <div class="bezel w-full max-w-md">
      <div class="bezel-core p-7 sm:p-8">
        <div class="mb-6 flex items-start justify-between gap-4">
          <div>
            <p class="eyebrow">Account</p>
            <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-fu-ink">Sign in</h2>
            <p class="mt-1 text-sm text-fu-muted">django-allauth headless · the AHA stack, no SPA</p>
          </div>
          <button type="button" @click="open = false" class="group flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-fu-line text-fu-muted transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-fu-ink/30 hover:text-fu-ink active:scale-95" aria-label="Close">
            <svg class="h-4 w-4 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>

        <form @submit.prevent="submit()" class="space-y-4">
          <div>
            <label for="login-email" class="mb-1.5 block font-mono text-[0.65rem] uppercase tracking-wider text-fu-muted">Email</label>
            <input id="login-email" type="email" required autocomplete="email" x-model="email" class="input-field" placeholder="you@example.com" />
          </div>
          <div>
            <label for="login-password" class="mb-1.5 block font-mono text-[0.65rem] uppercase tracking-wider text-fu-muted">Password</label>
            <input id="login-password" type="password" required autocomplete="current-password" x-model="password" class="input-field" placeholder="••••••••" />
          </div>

          <p x-show="error" x-cloak x-transition class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-600 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-400" role="alert" x-text="error"></p>

          <button type="submit" class="btn-primary group w-full disabled:opacity-60" :disabled="loading">
            <span x-show="!loading">Sign in</span>
            <span x-show="loading" x-cloak>Signing in…</span>
            <span class="btn-island" aria-hidden="true">
              <svg x-show="!loading" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              <svg x-show="loading" x-cloak class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M12 3a9 9 0 109 9"/></svg>
            </span>
          </button>
        </form>

        <p class="mt-6 text-center text-xs text-fu-muted">
          New here? <a href="/accounts/signup/" class="font-medium text-fu-link hover:text-fu-ink">Create an account</a>
          <span class="mx-2 text-fu-line" aria-hidden="true">|</span>
          <a href="/accounts/password/reset/" class="font-medium text-fu-link hover:text-fu-ink">Forgot password?</a>
        </p>
      </div>
    </div>
  </div>
</div>

---
// Toast — listens for `fusion:toast` window events (used by the LoginModal
// and cart actions) and renders a transient pill.
---

<div
  x-data="{
    toasts: [],
    push(message, kind) {
      const id = Date.now() + Math.random();
      this.toasts.push({ id, message, kind: kind || 'success' });
      setTimeout(() => { this.toasts = this.toasts.filter((t) => t.id !== id); }, 3200);
    },
    init() {
      window.addEventListener('fusion:toast', (e) => {
        const detail = e.detail || {};
        this.push(detail.message || 'Done.', detail.kind);
      });
    },
  }"
  class="pointer-events-none fixed bottom-6 right-6 z-[95] flex flex-col gap-2"
  aria-live="polite"
>
  <template x-for="t in toasts" :key="t.id">
    <div
      x-show="true"
      x-transition:enter="transition ease-[cubic-bezier(0.32,0.72,0,1)] duration-500"
      x-transition:enter-start="opacity-0 translate-y-4 scale-[0.98]"
      x-transition:enter-end="opacity-100 translate-y-0 scale-100"
      x-transition:leave="transition ease-[cubic-bezier(0.32,0.72,0,1)] duration-300"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 translate-y-2"
      class="pointer-events-auto flex items-center gap-3 rounded-full border border-fu-line/60 bg-fu-card px-5 py-3 text-sm font-medium text-fu-ink shadow-[0_20px_40px_-20px_hsl(var(--fu-shadow)/0.3),inset_0_1px_0_hsl(0_0%_100%/0.7)] dark:shadow-[0_20px_40px_-20px_hsl(var(--fu-shadow)/0.6),inset_0_1px_0_hsl(0_0%_100%/0.1)]"
    >
      <span
        class="h-2 w-2 rounded-full"
        x-bind:class="t.kind === 'error' ? 'bg-rose-500' : t.kind === 'info' ? 'bg-sky-500' : 'bg-emerald-500'"
      ></span>
      <span x-text="t.message"></span>
    </div>
  </template>
</div>

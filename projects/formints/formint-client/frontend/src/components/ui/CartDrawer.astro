---
// Cart drawer — Alpine controls the open/close state; the body is an HTMX
// fragment swapped from the Django backend (/shop/fragments/cart/drawer/).
// The cart count badge in the header listens for `cartUpdated` events.
---

<div
  x-data="{ open: false }"
  @fusion:open-cart.window="open = true"
  @keydown.escape.window="open = false"
>
  <!-- Backdrop -->
  <div
    x-show="open"
    x-cloak
    style="display:none"
    x-transition:enter="transition ease-[cubic-bezier(0.32,0.72,0,1)] duration-500"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-[cubic-bezier(0.32,0.72,0,1)] duration-300"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-[70] bg-fu-ink/40 backdrop-blur-sm"
    @click="open = false"
    aria-hidden="true"
  ></div>

  <!-- Panel — double-bezel: hairline shell + inset core -->
  <div
    x-show="open"
    x-cloak
    style="display:none"
    x-transition:enter="transition ease-[cubic-bezier(0.32,0.72,0,1)] duration-500"
    x-transition:enter-start="translate-x-[110%]"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-[cubic-bezier(0.32,0.72,0,1)] duration-300"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="translate-x-[110%]"
    class="bezel drawer-shell fixed inset-y-3 right-3 z-[80] flex w-full max-w-md flex-col backdrop-blur-xl"
    role="dialog"
    aria-modal="true"
    aria-label="Shopping cart"
  >
    <div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-[calc(2rem-0.375rem)] bg-fu-card">
      <div class="flex items-center justify-between border-b border-fu-line px-6 py-5">
        <div>
          <p class="eyebrow">Your cart</p>
          <h2 class="mt-2 font-display text-xl font-bold tracking-tight text-fu-ink">Shopping cart</h2>
        </div>
        <button
          type="button"
          @click="open = false"
          class="group flex h-10 w-10 items-center justify-center rounded-full border border-fu-line text-fu-muted transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-fu-ink/30 hover:text-fu-ink active:scale-95"
          aria-label="Close cart"
        >
          <svg class="h-4 w-4 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- HTMX body — swapped on every cartUpdated -->
      <div id="cart-drawer" class="flex-1 overflow-y-auto px-6 py-4">
        <div hx-get="/shop/fragments/cart/drawer/" hx-trigger="load, cartUpdated from:body" hx-swap="innerHTML" class="h-full">
          <div class="flex h-full flex-col items-center justify-center gap-3 py-16">
            <div class="skeleton-shimmer h-8 w-8 rounded-full"></div>
            <p class="font-mono text-xs uppercase tracking-widest text-fu-muted">Loading cart…</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

---
import Layout from '@/layouts/Layout.astro';
import { SHOP_NAME, SHOP_OPEN_HOURS } from '@/lib/site';
---

<!-- Custom 404 — paper field, oversized editorial type, one clear way back. -->
<Layout title="Page not found" description={`That page isn't on the ${SHOP_NAME} menu.`}>
  <section class="relative overflow-hidden pb-28 pt-8 lg:pb-40 lg:pt-12">
    <!-- Ambient washes over the paper field — no dead flat background. -->
    <div class="cta-wash pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

    <div class="container-fusion relative">
      <div class="max-w-6xl">
        <p class="eyebrow">
          <span class="live-dot" aria-hidden="true"></span>
          {SHOP_OPEN_HOURS}
        </p>
        <h1 class="mt-7 font-display font-bold text-hero tracking-tighter text-fu-ink">
          404.
          <span class="block text-fu-muted">Not on the menu.</span>
        </h1>
        <p class="mt-7 max-w-[46ch] text-lg leading-relaxed text-fu-muted">
          Whatever you were after isn't here — the page may have moved, or the
          link was ground a little too fine. The counter is still open.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href="/#menu"
            class="btn-primary group"
          >
            Back to the menu
            <span class="btn-island" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7m0 0H8m9 0v9"/></svg>
            </span>
          </a>
          <a
            href="/"
            class="btn-ghost group"
          >
            Start at the counter
            <span class="btn-island" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            </span>
          </a>
        </div>

        <p class="mt-14 font-mono text-[0.65rem] uppercase tracking-[0.18em] text-fu-muted">
          Error 404 · {SHOP_NAME}
        </p>
      </div>
    </div>
  </section>
</Layout>

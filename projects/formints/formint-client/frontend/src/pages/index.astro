---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import Card from '@/components/ui/Card.astro';
import Skeleton from '@/components/ui/Skeleton.astro';
import ScrollMotion from '@/components/ScrollMotion.astro';
import { fetchCatalog, FALLBACK_CATALOG } from '@/lib/api';

// Catalog fetched at build/dev from the Django backend, with a static fallback
// so `astro build` is never blocked by an offline backend.
let catalog = FALLBACK_CATALOG;
try {
  catalog = await fetchCatalog();
} catch (e) {
  catalog = FALLBACK_CATALOG;
}

const featured = catalog.products.filter((p) => p.is_featured).slice(0, 4);
const shop = catalog.shop;

// Hero art — the lead featured product's photo, art-directed. Falls back to a
// seeded editorial shot if the product carries no image.
const heroProduct = featured.find((p) => p.image_url) || featured[0];
const heroImg = heroProduct?.image_url || 'https://picsum.photos/seed/formint-espresso/1200/1200';

// Marquee band copy — menu vocabulary, kinetic typography.
const marqueeWords = [
  'Espresso',
  'Flat White',
  'Cold Brew',
  'Pour Over',
  'Almond Croissant',
  'Shakshuka',
  'Matcha Latte',
  'Harissa Bowl',
];

// Craft accordion panels.
const craftPanels = [
  {
    title: 'The roast',
    caption: 'Weekly batches',
    body: 'Single-origin beans roasted in-house every Monday. The menu follows the season, not the other way around.',
    img: 'https://picsum.photos/seed/formint-roast/1200/1600',
    alt: 'Freshly roasted coffee beans',
  },
  {
    title: 'The kitchen',
    caption: 'Before sunrise',
    body: 'Pastry lamination starts at 4 a.m. Everything from the shakshuka to the cardamom buns is made on the premises.',
    img: 'https://picsum.photos/seed/formint-kitchen/1200/1600',
    alt: 'Pastry being laminated in the kitchen',
  },
  {
    title: 'The pickup',
    caption: 'Eight minutes',
    body: 'Order ahead and your ticket is queued before you arrive. Average wait from door to cup is under eight minutes.',
    img: 'https://picsum.photos/seed/formint-pickup/1200/1600',
    alt: 'A finished order ready for pickup',
  },
];

// Word-on-the-street carousel (client-safe: only `i` is referenced by Alpine).
const voices = [
  {
    name: 'Priya Raghavan',
    role: 'Regular since 2022',
    quote: 'The pour-over changes weekly and the board always tells you exactly what you are getting. I have never once been handed a lukewarm cup.',
    img: 'https://picsum.photos/seed/formint-priya/400/400',
  },
  {
    name: 'Tomás Herrera',
    role: 'Rides past on the commute',
    quote: 'I order the flat white from the bus stop and it is ready when I walk in. Eight minutes, every single time.',
    img: 'https://picsum.photos/seed/formint-tomas/400/400',
  },
  {
    name: 'Aisha Okafor',
    role: 'Brings the whole team',
    quote: 'The harissa chicken bowl is the reason our office meetings happen here now. Half the order list is on the wall of fame.',
    img: 'https://picsum.photos/seed/formint-aisha/400/400',
  },
];
---

<Layout title={shop.name} description={shop.tagline}>
  <!-- ════════════════════════════════════════════════════════════════════
       ATTENTION — Artistic asymmetry hero. Text pulled left on an ultra-wide
       container; the art piece floats in from the bottom right and overlaps
       the type. No stamps on the text, no pills under it, no raw stats.
       ════════════════════════════════════════════════════════════════════ -->
  <section class="container-fusion grid items-center gap-14 pb-24 pt-4 lg:grid-cols-[1.05fr_0.95fr] lg:gap-8 lg:pb-32 lg:pt-8">
    <div class="relative z-10 max-w-5xl">
      <p class="eyebrow reveal" x-data x-intersect="$el.classList.add('is-visible')">
        <span class="live-dot" aria-hidden="true"></span>
        Open now · Mon–Sun 7:00 → 19:00
      </p>
      <h1
        class="reveal mt-7 max-w-5xl font-display font-bold text-hero tracking-tighter text-fu-ink"
        x-data
        x-intersect="$el.classList.add('is-visible')"
      >
        {shop.tagline.split('.')[0]}.
        <span class="block text-fu-muted">Brewed to the table.</span>
      </h1>
      <p class="reveal reveal-stagger-1 mt-7 max-w-[46ch] text-lg leading-relaxed text-fu-muted" x-data x-intersect="$el.classList.add('is-visible')">
        A single shop page that works like the counter does: pick from the
        menu, order ahead, and your ticket is queued before you arrive. No
        app, no wait, no small talk required.
      </p>
      <div class="reveal reveal-stagger-2 mt-10 flex flex-wrap gap-4" x-data x-intersect="$el.classList.add('is-visible')">
        <Button href="#menu">
          Browse the menu
          <span class="btn-island" aria-hidden="true">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </span>
        </Button>
        <Button href="/accounts/signup/" variant="outline">
          Create an account
          <span class="btn-island" aria-hidden="true">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </span>
        </Button>
      </div>
    </div>

    <!-- Floating art — overlaps the text column from the bottom right. -->
    <div class="relative mx-auto w-full max-w-sm lg:-ml-10 lg:mt-16 lg:max-w-none" x-data x-intersect="$el.classList.add('is-visible')">
      <div class="reveal bezel">
        <div class="bezel-core relative flex aspect-square items-center justify-center overflow-hidden">
          <img
            src={heroImg}
            alt={heroProduct?.name || 'Featured pour'}
            class="h-full w-full object-cover contrast-110 saturate-[0.85] transition-transform duration-[1200ms] ease-[cubic-bezier(0.32,0.72,0,1)] hover:scale-[1.03]"
            loading="eager"
          />
          <div class="absolute inset-0 bg-fu-ink/10" aria-hidden="true"></div>
          <span class="absolute right-7 top-7 h-2.5 w-2.5 rounded-full bg-fu-mark" style="animation: breathe 2.4s ease-in-out infinite"></span>
        </div>
      </div>
      <!-- Floating caption card — product identity, not stats. -->
      <div class="float-slow absolute -left-6 bottom-10 rounded-2xl border border-fu-line/70 bg-fu-card px-4 py-3 shadow-diffusion sm:-left-10" style="animation-delay: 0.6s">
        <Badge variant="mark">Featured</Badge>
        <p class="mt-2 text-sm font-semibold text-fu-ink">{heroProduct?.name || 'Espresso'}</p>
      </div>
      <div class="float-slow absolute -right-2 top-10 rounded-full border border-fu-line/70 bg-fu-card px-4 py-2 font-mono text-[0.65rem] uppercase tracking-widest text-fu-muted shadow-diffusion" style="animation-delay: 1.2s">
        Roasted weekly
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       INTEREST (transition) — kinetic typographic marquee. Pure vocabulary,
       no meta-labels; a full-bleed band between the hero and the menu.
       ════════════════════════════════════════════════════════════════════ -->
  <section class="overflow-hidden border-y border-fu-line bg-fu-card/40 py-9" aria-hidden="true">
    <div class="marquee-track items-baseline gap-10 font-display text-5xl font-bold uppercase tracking-tighter text-fu-line/80 md:text-7xl">
      {[...marqueeWords, ...marqueeWords].map((w, i) => (
        <span class:list={['whitespace-nowrap', i % 2 === 1 ? 'text-fu-link/40' : '']}>
          {w}
          <span class="mx-6 inline-block h-2 w-2 translate-y-[-0.35em] rounded-full bg-fu-mark/70 md:mx-10"></span>
        </span>
      ))}
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       DESIRE (1) — GSAP scroll pinning. The headline pins on the left while
       the featured gallery scrubs upward beside it (data-showcase-pin /
       data-showcase-track). Static fallback without JS or with reduced
       motion: a plain two-column layout.
       ════════════════════════════════════════════════════════════════════ -->
  <section class="container-fusion py-28 lg:py-40" data-showcase-pin>
    <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <div class="lg:flex lg:items-start lg:self-start">
        <div class="reveal" x-data x-intersect="$el.classList.add('is-visible')">
          <p class="eyebrow">Fresh this week</p>
          <h2 class="mt-4 font-display text-4xl font-bold tracking-tighter text-fu-ink md:text-5xl">
            The showcase
          </h2>
          <p class="mt-5 max-w-[38ch] text-sm leading-relaxed text-fu-muted">
            Four things worth crossing the street for. Pulled straight from
            this week's roast, with the pastry case close behind.
          </p>
          <div class="mt-8 h-px w-24 bg-fu-ink/20" aria-hidden="true"></div>
          <p class="mt-8 font-mono text-[0.65rem] uppercase tracking-[0.18em] text-fu-muted">
            {featured.length} picks · {catalog.categories.length} menu sections
          </p>
        </div>
      </div>

      <!-- Scrubbed gallery — pinned on lg, plain stack everywhere else. -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-1" data-showcase-track>
        {featured.map((p) => (
          <a
            href="#menu"
            class="group relative block overflow-hidden rounded-[1.75rem] border border-fu-line/60 bg-fu-card transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1 hover:shadow-[0_24px_48px_-24px_hsl(var(--fu-shadow)/0.25)] active:scale-[0.99] lg:odd:ml-auto lg:odd:w-[88%] lg:even:w-[88%]"
          >
            <div class="relative flex aspect-[16/10] items-center justify-center overflow-hidden bg-fu-line/25">
              {p.image_url ? (
                <img
                  src={p.image_url}
                  alt={p.name}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-[1.05]"
                />
              ) : (
                <span class="font-display text-6xl font-bold text-fu-muted/40">{p.name.slice(0, 1)}</span>
              )}
              <span class="absolute left-4 top-4 h-1.5 w-1.5 rounded-full bg-fu-mark opacity-0 transition-opacity duration-500 group-hover:opacity-100"></span>
            </div>
            <div class="flex items-start justify-between gap-3 p-5">
              <div class="min-w-0">
                <h3 class="truncate font-semibold leading-snug text-fu-ink">{p.name}</h3>
                {p.tags.length > 0 && (
                  <p class="mt-1 truncate font-mono text-[0.6rem] uppercase tracking-wider text-fu-muted">{p.tags.slice(0, 2).join(' · ')}</p>
                )}
              </div>
              <span class="shrink-0 font-mono text-sm font-bold text-fu-ink">${p.price}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       INTEREST — the menu. Gapless bento (grid-flow-dense, math-verified:
       24 products = 7 rows × 4 cols with the lead card spanning 2×2 and one
       card spanning 2 cols — zero dead cells). Category pills drive the
       HTMX grid below; the backend fragment swaps in with the same classes.
       ════════════════════════════════════════════════════════════════════ -->
  <section id="menu" class="border-t border-fu-line bg-fu-card/50 py-28 lg:py-36">
    <div class="container-fusion">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="reveal" x-data x-intersect="$el.classList.add('is-visible')">
          <p class="eyebrow">Menu</p>
          <h2 class="mt-4 font-display text-4xl font-bold tracking-tighter text-fu-ink md:text-5xl">
            Choose your order
          </h2>
        </div>
        <p class="reveal reveal-stagger-1 max-w-[38ch] text-sm leading-relaxed text-fu-muted" x-data x-intersect="$el.classList.add('is-visible')">
          Add items to your cart — the badge and drawer update via HTMX without a page reload.
        </p>
      </div>

      <!-- Category pills (HTMX-powered grid below) -->
      <div
        id="category-pills"
        class="reveal reveal-stagger-2 mt-10 flex flex-wrap gap-2"
        x-data="{ active: '' }"
        x-intersect="$el.classList.add('is-visible')"
      >
        <button
          type="button"
          class="rounded-full border px-5 py-2 text-sm font-medium transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-95"
          :class="active === '' ? 'border-fu-ink bg-fu-ink text-fu-paper shadow-[0_8px_20px_-8px_hsl(var(--fu-shadow)/0.4)] dark:shadow-[0_8px_20px_-8px_hsl(var(--fu-shadow)/0.6)]' : 'border-fu-line text-fu-ink hover:bg-fu-line/40'"
          @click="active = ''; htmx.ajax('GET', '/shop/fragments/products/', { target: '#product-grid', swap: 'innerHTML', values: { category: '' } })"
          data-category=""
        >
          All
        </button>
        {catalog.categories.map((c) => (
          <button
            type="button"
            class="rounded-full border px-5 py-2 text-sm font-medium transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-95"
            :class="active === $el.dataset.category ? 'border-fu-ink bg-fu-ink text-fu-paper shadow-[0_8px_20px_-8px_hsl(var(--fu-shadow)/0.4)] dark:shadow-[0_8px_20px_-8px_hsl(var(--fu-shadow)/0.6)]' : 'border-fu-line text-fu-ink hover:bg-fu-line/40'"
            @click="active = $el.dataset.category; htmx.ajax('GET', '/shop/fragments/products/', { target: '#product-grid', swap: 'innerHTML', values: { category: $el.dataset.category } })"
            data-category={c.slug}
          >
            {c.name}
          </button>
        ))}
      </div>

      <!-- Product grid — swapped from the Django backend fragment -->
      <div
        id="product-grid"
        class="mt-10"
        hx-get="/shop/fragments/products/"
        hx-trigger="load"
        hx-swap="innerHTML"
        hx-indicator="#grid-indicator"
      >
        <!-- Fallback SSR grid (renders even before HTMX swaps) — gapless bento -->
        <div class="grid grid-flow-dense grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {catalog.products.map((p, i) => (
            <Card
              hover
              class:list={[
                'group flex h-full flex-col overflow-hidden',
                // Bento rhythm (math-verified for 24 items on lg: lead 2×2 +
                // one 2-col card = 28 cells = 7 rows × 4 cols, no dead cells).
                i === 0 ? 'lg:col-span-2 lg:row-span-2' : '',
                i === 5 ? 'lg:col-span-2' : '',
              ]}
            >
              <div
                data-gsap-media
                class:list={[
                  'relative flex items-center justify-center overflow-hidden bg-fu-line/25',
                  i === 0 ? 'aspect-[16/10] lg:aspect-auto lg:flex-1' : 'aspect-[4/3]',
                ]}
              >
                {p.image_url ? (
                  <img
                    src={p.image_url}
                    alt={p.name}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-[1.04]"
                  />
                ) : (
                  <span class:list={['font-display font-bold text-fu-muted/40', i === 0 ? 'text-7xl' : 'text-4xl']}>{p.name.slice(0, 1)}</span>
                )}
                {p.compare_at_price && (
                  <span class="absolute left-4 top-4 z-10 rounded-full bg-fu-mark px-2.5 py-1 font-mono text-[0.62rem] font-semibold uppercase tracking-wider text-fu-ink">
                    offer
                  </span>
                )}
                <span class="absolute left-4 top-4 h-1.5 w-1.5 rounded-full bg-fu-mark opacity-0 transition-opacity duration-500 group-hover:opacity-100"></span>
              </div>
              <div class="flex flex-1 flex-col p-5">
                <div class="flex items-start justify-between gap-3">
                  <h3 class:list={['font-semibold leading-snug text-fu-ink', i === 0 ? 'text-xl' : 'text-sm']}>{p.name}</h3>
                  <span class="shrink-0 font-mono text-sm font-bold text-fu-ink">${p.price}</span>
                </div>
                {i === 0 && <p class="mt-2 max-w-[36ch] text-sm leading-relaxed text-fu-muted">{p.description}</p>}
                {p.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {p.tags.map((t) => (
                      <span class="rounded-full bg-fu-line/40 px-2.5 py-0.5 font-mono text-[0.6rem] uppercase tracking-wider text-fu-muted">{t}</span>
                    ))}
                  </div>
                )}
              </div>
            </Card>
          ))}
        </div>
      </div>
      <div id="grid-indicator" class="htmx-indicator mt-6">
        <Skeleton class="h-1 w-32 rounded-full" />
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       DESIRE (2) — horizontal accordion. Three slices of the craft; the
       active panel widens on hover/focus via data-active grid templates.
       Falls back to a clean stack on mobile, equal thirds without JS.
       ════════════════════════════════════════════════════════════════════ -->
  <section class="container-fusion py-28 lg:py-40">
    <div class="reveal" x-data x-intersect="$el.classList.add('is-visible')">
      <p class="eyebrow">The craft</p>
      <h2 class="mt-4 max-w-3xl font-display text-4xl font-bold tracking-tighter text-fu-ink md:text-5xl">
        Roast, kitchen, pickup — one continuous counter
      </h2>
    </div>

    <div
      class="accordion-grid reveal reveal-stagger-1 mt-12"
      x-data="{ active: '0' }"
      :data-active="active"
      x-intersect="$el.classList.add('is-visible')"
    >
      {craftPanels.map((p, i) => (
        <article
          data-panel={i}
          class="group relative flex min-h-[22rem] flex-col justify-end overflow-hidden rounded-[1.75rem] border border-fu-line/60 bg-fu-card"
          @mouseenter="active = $el.dataset.panel"
          @focusin="active = $el.dataset.panel"
        >
          <img
            src={p.img}
            alt={p.alt}
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover opacity-80 contrast-110 saturate-[0.8] transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-[1.04] group-hover:opacity-90"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-fu-ink/85 via-fu-ink/25 to-transparent" aria-hidden="true"></div>
          <div class="relative p-6 text-fu-paper sm:p-8">
            <p class="font-mono text-[0.65rem] uppercase tracking-[0.18em] text-fu-paper/70">{p.caption}</p>
            <h3 class="mt-2 font-display text-2xl font-bold tracking-tight">{p.title}</h3>
            <p
              class="mt-3 max-w-[38ch] text-sm leading-relaxed text-fu-paper/85 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"
              :class="active === $el.closest('[data-panel]').dataset.panel ? 'translate-y-0 opacity-100' : 'pointer-events-none translate-y-2 opacity-0 md:hidden'"
            >
              {p.body}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       DESIRE (3) — testimonial carousel. Overlapping portraits + minimal
       quotes, arrow driven. Alpine keeps it dependency-free; only the
       index `i` lives in the client scope.
       ════════════════════════════════════════════════════════════════════ -->
  <section
    class="border-y border-fu-line bg-fu-card/40 py-28 lg:py-36"
    x-data={`{ i: 0, next() { this.i = (this.i + 1) % 3; }, prev() { this.i = (this.i - 1 + 3) % 3; } }`}
  >
    <div class="container-fusion grid items-center gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <div class="reveal" x-data x-intersect="$el.classList.add('is-visible')">
        <p class="eyebrow">Word on the street</p>
        <h2 class="mt-4 max-w-[22ch] font-display text-4xl font-bold tracking-tighter text-fu-ink md:text-5xl">
          Regulars, quoted
        </h2>
        <div class="mt-10 flex items-center gap-3">
          <button
            type="button"
            @click="prev()"
            aria-label="Previous testimonial"
            class="flex h-11 w-11 items-center justify-center rounded-full border border-fu-line bg-fu-card text-fu-ink transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-fu-ink/40 active:scale-95"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg>
          </button>
          <button
            type="button"
            @click="next()"
            aria-label="Next testimonial"
            class="flex h-11 w-11 items-center justify-center rounded-full border border-fu-line bg-fu-card text-fu-ink transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-fu-ink/40 active:scale-95"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </button>
          <p class="ml-2 font-mono text-xs uppercase tracking-widest text-fu-muted" x-text="('0' + (i + 1)) + ' / 03'">01 / 03</p>
        </div>
      </div>

      <div class="reveal reveal-stagger-1" x-data x-intersect="$el.classList.add('is-visible')">
        <!-- Overlapping portraits — the active face leads the stack. -->
        <div class="relative mb-8 flex h-16 items-center">
          {voices.map((v, vi) => (
            <img
              data-voice={vi}
              src={v.img}
              alt={v.name}
              class="h-16 w-16 rounded-full border-2 border-fu-paper object-cover grayscale contrast-125 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"
              :class="i === Number($el.dataset.voice) ? '-ml-0 z-10 scale-110 border-fu-link grayscale-0' : '-ml-4 opacity-70'"
              style={`z-index: ${voices.length - vi}`}
            />
          ))}
        </div>

        <!-- Quote — cross-fades between voices. -->
        <div class="relative min-h-[14rem]">
          {voices.map((v, vi) => (
            <blockquote
              data-voice={vi}
              class="absolute inset-0 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"
              :class="i === Number($el.dataset.voice) ? 'translate-y-0 opacity-100' : 'pointer-events-none translate-y-3 opacity-0'"
            >
              <p class="font-display text-2xl font-bold leading-snug tracking-tight text-fu-ink md:text-3xl">
                “{v.quote}”
              </p>
              <footer class="mt-6">
                <p class="text-sm font-semibold text-fu-ink">{v.name}</p>
                <p class="mt-0.5 font-mono text-[0.65rem] uppercase tracking-widest text-fu-muted">{v.role}</p>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </div>
  </section>


---
import Layout from '@/layouts/Layout.astro';
import ContactForm from '@/components/blocks/ContactForm.astro';
import Toast from '@/components/ui/Toast.astro';
---

<Layout
  title="Contact Us"
  description="Get in touch with the Fusion team — we reply within one business day."
>
  <!-- Hero -->
  <section class="section-hero py-16">
    <div class="container-fusion">
      <div class="mx-auto max-w-2xl text-center">
        <span class="badge mb-6 inline-flex border border-white/20 bg-white/10 text-white backdrop-blur-sm">Contact</span>
        <h1 class="mb-4 text-4xl font-bold md:text-5xl">Contact Us</h1>
        <p class="text-lg text-white/70">
          We&apos;d love to hear from you. Send a message and we&apos;ll get back to you soon.
        </p>
      </div>
    </div>
  </section>

  <div class="py-14">
    <ContactForm />
  </div>

  <Toast />
</Layout>

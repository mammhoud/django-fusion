---
import Accordion from '@/components/ui/Accordion.astro';

interface Props {
  heading?: string;
  intro?: string;
  items?: { question: string; answer: string }[];
  /** Whether to render the search bar. */
  searchable?: boolean;
}

const defaultItems = [
  {
    question: 'What is the AHA stack?',
    answer:
      'AHA stands for Astro + HTMX + Alpine.js — a lightweight alternative to heavy SPA frameworks. Astro renders server-side HTML, HTMX swaps fragments from the Django backend, and Alpine.js powers local interactivity. No Redux, no decoder, no FusionProxy needed for most pages.',
  },
  {
    question: 'How do I get started?',
    answer:
      'Create a free account in seconds, browse the course catalog, and enroll in any course that catches your eye. Your progress syncs automatically across devices.',
  },
  {
    question: 'Are there any hidden fees?',
    answer:
      'No. The Starter plan is free forever with no credit card required. Paid plans are billed monthly or yearly and you can cancel anytime from your dashboard.',
  },
  {
    question: 'Can I switch plans later?',
    answer:
      'Absolutely. You can upgrade or downgrade at any time — changes apply immediately and we prorate any differences on your next invoice.',
  },
  {
    question: 'Do you offer team or enterprise pricing?',
    answer:
      'Yes. The Team plan includes SSO, role management, custom branding and a dedicated success manager. Contact us for volume discounts and custom requirements.',
  },
  {
    question: 'Is my data secure?',
    answer:
      'Security is our priority. All sessions use django-allauth best practices, forms are CSRF-protected, and traffic is served over HTTPS with Let’s Encrypt certificates.',
  },
];

const {
  heading = 'Frequently asked questions',
  intro = 'Everything you need to know about the product and billing.',
  items = defaultItems,
  searchable = true,
} = Astro.props;

/** Items serialised into the Alpine scope so filtering + counter share one source of truth. */
const itemsJson = JSON.stringify(items);
---

<section id="faq" class="bg-fu-muted py-20">
  <div class="container-fusion">
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <span class="badge-primary mb-4">FAQ</span>
      {heading && <h2 class="mb-4 text-3xl font-bold text-fu-text md:text-4xl">{heading}</h2>}
      {intro && <p class="text-fu-text/60">{intro}</p>}
    </div>

    <!-- Shared Alpine scope: search query + the items themselves -->
    <div class="mx-auto max-w-2xl" x-data={`{ query: '', items: ${itemsJson} }`}>
      {searchable && (
        <div class="mb-10">
          <div class="relative">
            <svg class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-fu-text/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.3-4.3M17 10a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input
              type="search"
              x-model="query"
              class="input-field !pl-11 !py-3.5"
              placeholder="Search FAQs..."
              aria-label="Search frequently asked questions"
            />
          </div>
          <p
            class="mt-3 text-center text-sm text-fu-text/50"
            x-show="query.length > 0"
            x-cloak
            x-text="`${items.filter(i => i.question.toLowerCase().includes(query.toLowerCase()) || i.answer.toLowerCase().includes(query.toLowerCase())).length} item(s) match`"
          ></p>
        </div>
      )}

      <div class="space-y-3">
        {items.map((item, i) => (
          <div
            x-show={`query === '' || items[${i}].question.toLowerCase().includes(query.toLowerCase()) || items[${i}].answer.toLowerCase().includes(query.toLowerCase())`}
            x-cloak
          >
            <Accordion items={[item]} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

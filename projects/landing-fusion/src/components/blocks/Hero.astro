---
interface Props {
  badge?: string;
  heading?: string;
  intro?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const {
  badge = 'Powered by the AHA stack',
  heading = 'Learn Without Limits',
  intro = 'Master new skills with expert-led courses, interactive content, and a community of learners.',
  primaryCta = { label: 'Explore Features', href: '/#features' },
  secondaryCta = { label: 'Get Started Free', href: '/#cta' },
} = Astro.props;
---

<section class="section-hero">
  <div class="container-fusion py-20 md:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <span
        class="badge reveal inline-flex border border-white/20 bg-white/10 text-white backdrop-blur-sm"
        x-data x-intersect="$el.classList.add('reveal-visible')" x-cloak
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        {badge}
      </span>

      <h1
        class="reveal mb-6 text-4xl font-bold leading-tight md:text-6xl"
        x-data x-intersect="$el.classList.add('reveal-visible')"
      >
        {heading}
      </h1>

      <p
        class="reveal mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-white/70 md:text-xl"
        x-data x-intersect="$el.classList.add('reveal-visible')"
        style="transition-delay: 100ms"
      >
        {intro}
      </p>

      <div
        class="reveal flex flex-col justify-center gap-4 sm:flex-row"
        x-data x-intersect="$el.classList.add('reveal-visible')"
        style="transition-delay: 200ms"
      >
        <a href={primaryCta.href} class="btn-white !px-8 !py-3.5 text-base">
          {primaryCta.label}
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
        <a href={secondaryCta.href} class="btn !px-8 !py-3.5 text-base text-white ring-2 ring-inset ring-white/40 hover:bg-white/10">
          {secondaryCta.label}
        </a>
      </div>

      <!-- Social proof -->
      <p
        class="reveal mt-12 text-sm text-white/50"
        x-data x-intersect="$el.classList.add('reveal-visible')"
        style="transition-delay: 300ms"
      >
        Trusted by <span class="font-semibold text-white/80">5,000+</span> learners worldwide
      </p>
    </div>
  </div>
</section>

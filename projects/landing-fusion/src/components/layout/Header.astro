---
import { navLinks, siteConfig } from '@/lib/site';

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  if (href.startsWith('/#')) return pathname === '/' || pathname === '/index';
  return pathname.startsWith(href.split('#')[0]);
};
---

<header
  class="sticky top-0 z-50 border-b border-fu-border bg-fu-card/90 backdrop-blur-md"
  x-data="{ open: false }"
>
  <div class="container-fusion">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 text-xl font-bold text-fu-primary" aria-label={siteConfig.name}>
        <svg class="h-8 w-8" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <defs>
            <linearGradient id="logo-g" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#7c3aed"/>
              <stop offset="1" stop-color="#4c1d95"/>
            </linearGradient>
          </defs>
          <rect width="32" height="32" rx="8" fill="url(#logo-g)"/>
          <path d="M16 6l8 4-8 4-8-4 8-4zm0 9l6 3v5l-6 3-6-3v-5l6-3z" fill="#fff"/>
        </svg>
        <span>{siteConfig.name}</span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden items-center gap-6 md:flex" aria-label="Main">
        {navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class:list={[
                'text-sm font-medium transition-colors duration-200',
                active
                  ? 'text-fu-primary'
                  : 'text-fu-text/70 hover:text-fu-primary',
              ]}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- CTA + Theme toggle -->
      <div class="hidden items-center gap-3 md:flex">
        <a href="/#pricing" class="btn-secondary !py-2 !px-4 text-sm">Log In</a>
        <a href="/#cta" class="btn-primary !py-2 !px-4 text-sm">Get Started</a>
      </div>

      <!-- Mobile menu button -->
      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-lg text-fu-text transition-colors hover:bg-fu-muted md:hidden"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        :aria-expanded="open.toString()"
        @click="open = !open"
      >
        <svg x-show="!open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg x-show="open" x-cloak class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div x-show="open" x-cloak x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0 -translate-y-2"
       x-transition:enter-end="opacity-100 translate-y-0"
       x-transition:leave="transition ease-in duration-150"
       x-transition:leave-start="opacity-100 translate-y-0"
       x-transition:leave-end="opacity-0 -translate-y-2"
       class="border-t border-fu-border bg-fu-card md:hidden">
    <nav class="container-fusion space-y-1 py-4" aria-label="Mobile">
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            @click="open = false"
            class:list={[
              'block rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              active
                ? 'bg-fu-primary/10 text-fu-primary'
                : 'text-fu-text/70 hover:bg-fu-muted hover:text-fu-primary',
            ]}
          >
            {link.label}
          </a>
        );
      })}
      <hr class="my-2 border-fu-border" />
      <a href="/#pricing" @click="open = false" class="block rounded-lg px-3 py-2 text-sm font-medium text-fu-primary">Log In</a>
      <a href="/#cta" @click="open = false" class="btn-primary mt-2 w-full">Get Started</a>
    </nav>
  </div>
</header>

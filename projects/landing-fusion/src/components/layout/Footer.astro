---
import { footerColumns, siteConfig } from '@/lib/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-fu-border bg-fu-text text-fu-muted dark:bg-fu-card">
  <div class="container-fusion py-12">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      <!-- Brand -->
      <div>
        <a href="/" class="mb-4 flex items-center gap-2 text-lg font-bold text-white">
          <svg class="h-7 w-7" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <defs>
              <linearGradient id="logo-g" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#7c3aed"/>
                <stop offset="1" stop-color="#4c1d95"/>
              </linearGradient>
            </defs>
            <rect width="32" height="32" rx="8" fill="url(#logo-g)"/>
            <path d="M16 6l8 4-8 4-8-4 8-4zm0 9l6 3v5l-6 3-6-3v-5l6-3z" fill="#fff"/>
          </svg>
          <span>{siteConfig.name}</span>
        </a>
        <p class="text-sm leading-relaxed opacity-80">
          {siteConfig.tagline}. Server-rendered HTML with HTMX and Alpine.js — no heavy SPA.
        </p>
      </div>

      <!-- Link groups -->
      {footerColumns.map((column) => (
        <div>
          <h3 class="mb-4 text-sm font-semibold text-white">{column.title}</h3>
          <ul class="space-y-2">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="text-sm opacity-80 transition-colors duration-200 hover:text-white hover:opacity-100"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 border-t border-white/10 pt-8 text-center text-sm opacity-70">
      <p>
        &copy; {year} {siteConfig.author}. All rights reserved. ·
        <a href="https://github.com/mammhoud" class="hover:text-white" target="_blank" rel="noopener noreferrer">GitHub</a>
        {' · '}
        <a href="https://mammhoud.github.io" class="hover:text-white" target="_blank" rel="noopener noreferrer">Portfolio</a>
      </p>
    </div>
  </div>
</footer>

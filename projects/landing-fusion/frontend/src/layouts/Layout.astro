---
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { siteConfig, THEME_STORAGE_KEY } from '@/lib/site';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  ogImage = siteConfig.ogImage,
} = Astro.props;

const pageTitle = title === siteConfig.name ? siteConfig.name : `${title} · ${siteConfig.name}`;
const canonical = new URL(Astro.url.pathname, siteConfig.url).href;

// THEME_STORAGE_KEY is used inside the FOUC-free inline head script below,
// which the type-checker does not see — keep this explicit reference.
void THEME_STORAGE_KEY;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteConfig.url).href} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteConfig.url).href} />

    <!-- Theme color -->
    <meta name="theme-color" content="#FCFCFA" />

    <!--
      FOUC-free theme init (ASTRO_MIGRATION_PLAN §5.1).
      Runs synchronously before first paint: reads THEME_STORAGE_KEY from
      localStorage (system preference on first visit) and applies the class
      to <html>, which drives the `dark:` variant. Runs on every page load,
      so the choice persists and syncs across pages/tabs.
    -->
    <script is:inline define:vars={{ THEME_STORAGE_KEY }}>
      (function () {
        var root = document.documentElement;
        var stored = null;
        try {
          stored = localStorage.getItem(THEME_STORAGE_KEY);
        } catch (e) {
          /* storage unavailable (private mode / file://) — fall through */
        }
        var prefersDark =
          window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var dark = stored ? stored === 'dark' : prefersDark;
        root.classList.remove('light', 'dark');
        root.classList.add(dark ? 'dark' : 'light');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', dark ? '#131312' : '#fcfcfa');
      })();
    </script>

    <!-- Fonts: the document voice (Bricolage display / Public Sans body / JetBrains Mono data) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Public+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="is-hydrating">
    <!--
      Default loading state (skeleton). Two mechanisms, both on by default:

      1. Alpine hydrate fallback — while `body.is-hydrating`, regions marked
         `[data-hydrate-skeleton]` render their skeleton instead of the
         x-cloak'd interactive content. The class is removed on
         `alpine:initialized` below, so interactive blocks never flash empty.

      2. HTMX in-flight indicator — `#htmx-global-indicator` shows a
         skeleton overlay whenever any hx-request is pending (fragments
         stream in from the Django backend via apps/handlers).
    -->
    <div
      id="htmx-global-indicator"
      class="fixed inset-0 z-50 items-center justify-center bg-fu-paper/80 backdrop-blur-sm"
      aria-hidden="true"
    >
      <div class="container-fusion grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <span class="fusion-skeleton__card"></span>
        <span class="fusion-skeleton__card"></span>
        <span class="fusion-skeleton__card"></span>
      </div>
    </div>

    <div class="flex min-h-screen flex-col">
      <Header />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>

    <!-- AHA runtime: HTMX + Alpine (bundled, not CDN) -->
    <script>
      import htmx from 'htmx.org';
      import Alpine from 'alpinejs';
      import collapse from '@alpinejs/collapse';
      import intersect from '@alpinejs/intersect';

      // Expose globals for hx-* attributes and htmx:event listeners
      window.htmx = htmx;
      window.Alpine = Alpine;
      Alpine.plugin(collapse);
      Alpine.plugin(intersect);

      // Global toast store (used by ContactForm, CTA blocks)
      document.addEventListener('alpine:init', () => {
        Alpine.store('toast', {
          visible: false,
          message: '',
          variant: 'success',
          timeout: 0 as number | ReturnType<typeof setTimeout>,
          show(message: string, variant = 'success', duration = 3500) {
            this.message = message;
            this.variant = variant;
            this.visible = true;
            clearTimeout(this.timeout);
            this.timeout = setTimeout(() => (this.visible = false), duration);
          },
        });
      });

      // HTMX error handling (ASTRO_MIGRATION_PLAN §13.5) → Alpine toast
      document.body.addEventListener('htmx:responseError', () => {
        window.Alpine?.store('toast').show('Something went wrong — please try again.', 'error');
      });

      // Hydration complete → swap skeletons for real content (§6.4). Removes
      // `body.is-hydrating`, which CSS uses to show [data-hydrate-skeleton]
      // placeholders instead of the x-cloak'd interactive regions.
      document.addEventListener('alpine:initialized', () => {
        document.body.classList.remove('is-hydrating');
      });
      // Safety net: if Alpine never boots (slow network / script error), drop
      // the skeleton state after 3s so content is never hidden forever.
      setTimeout(() => document.body.classList.remove('is-hydrating'), 3000);

      // Global HTMX in-flight indicator. HTMX only adds `.htmx-request` to
      // the *requesting* element (or elements wired via hx-indicator), so we
      // toggle the class on the indicator explicitly for every request.
      const htmxIndicator = document.getElementById('htmx-global-indicator');
      document.addEventListener('htmx:beforeRequest', () => htmxIndicator?.classList.add('htmx-request'));
      document.addEventListener('htmx:afterRequest', () => htmxIndicator?.classList.remove('htmx-request'));
      document.addEventListener('htmx:responseError', () => htmxIndicator?.classList.remove('htmx-request'));

      // Live-fragment fallback (LiveFragment.astro): if an HTMX request for a
      // backend fragment fails, replace its target with the quiet fallback so
      // the section never sits empty or shows the skeleton forever. One
      // listener for all instances — kept here so it is bundled once, not
      // inlined per component.
      document.addEventListener('htmx:responseError', (event) => {
        const target = (event as CustomEvent).detail?.elt as HTMLElement | null;
        if (!target || !target.matches('[data-live-fragment] .live-fragment__target')) return;
        const fallback = target.querySelector<HTMLTemplateElement>('[data-fragment-fallback]');
        if (fallback) target.innerHTML = fallback.innerHTML;
      });

      Alpine.start();

      // Analytics hook for View Transitions (ASTRO_MIGRATION_PLAN §13.7)
      document.addEventListener('astro:page-load', () => {
        if (typeof window.gtag === 'function') {
          window.gtag('config', 'G-XXXXXXXXXX', { page_path: window.location.pathname });
        }
      });
    </script>
  </body>
</html>

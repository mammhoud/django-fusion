---
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import CookieConsent from '@/components/ui/CookieConsent.astro';
import { THEME_STORAGE_KEY, fallbackSiteName, ogImage as fallbackOgImage } from '@/lib/site';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Backend-fetched navigation items (from /apis/navigation/). */
  navItems?: { label: string; href: string; external?: boolean }[];
  /** Backend-fetched site settings (from /apis/site/settings/). */
  siteSettings?: {
    site_name?: string;
    site_tagline?: string;
    logo_url?: string | null;
    footer_description?: string;
    footer_copyright?: string;
    footer_link_groups?: { title: string; links: { label: string; url: string }[] }[];
    social_links?: { platform: string; label: string; url: string; icon_class: string }[];
  };
  /** Backend-fetched page data for the current route (from /apis/pages/<slug>/). */
  pageData?: import('@/lib/api').PageData | null;
  /** Slug of the current page, used as the cache key in the Redux pageSlice. */
  pageSlug?: string;
}

const {
  title = '',
  description = '',
  ogImage = fallbackOgImage,
  navItems,
  siteSettings,
  pageData = null,
  pageSlug = '',
} = Astro.props;

const siteName = siteSettings?.site_name || fallbackSiteName;
const pageTitle = title && title !== siteName ? `${title} \u00b7 ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, 'https://structa.cloud').href;

void THEME_STORAGE_KEY;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, 'https://structa.cloud').href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, 'https://structa.cloud').href} />

    <meta name="theme-color" content="#FCFCFA" />

    <script is:inline define:vars={{ THEME_STORAGE_KEY }}>
      (function () {
        var root = document.documentElement;
        var stored = null;
        try { stored = localStorage.getItem(THEME_STORAGE_KEY); } catch (e) {}
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var dark = stored ? stored === 'dark' : prefersDark;
        root.classList.remove('light', 'dark');
        root.classList.add(dark ? 'dark' : 'light');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', dark ? '#131312' : '#fcfcfa');
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Public+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="is-hydrating">
    <!-- HTMX global in-flight indicator — shows a branded skeleton overlay
         while hx- requests are pending.  Toggled by htmx-bootstrap.ts via
         the `.htmx-request` class.  Respects reduced-motion preference. -->
    <div
      id="htmx-global-indicator"
      class="htmx-indicator-overlay"
      aria-hidden="true"
      role="status"
      aria-live="polite"
    >
      <!-- Progress bar (top edge) -->
      <div class="htmx-indicator-progress" aria-hidden="true">
        <div class="htmx-indicator-progress__bar"></div>
      </div>

      <!-- Request target label — shows which region is being swapped -->
      <p class="htmx-indicator__target" id="htmx-indicator-target" aria-hidden="true"></p>

      <!-- Branded skeleton: hero → stats → cards mirrors a full page layout -->
      <div class="htmx-indicator-skeleton">
        <!-- Hero skeleton -->
        <div class="htmx-indicator-skeleton__hero">
          <span class="fusion-skeleton__line fusion-skeleton__line--tag" style="width:10rem;margin-inline:auto"></span>
          <span class="fusion-skeleton__line fusion-skeleton__line--hero"></span>
          <span class="fusion-skeleton__line" style="width:55%"></span>
          <div class="htmx-indicator-skeleton__ctas">
            <span class="fusion-skeleton__line fusion-skeleton__line--btn" style="width:9rem"></span>
            <span class="fusion-skeleton__line fusion-skeleton__line--btn" style="width:8rem;opacity:0.6"></span>
          </div>
        </div>

        <!-- Stats row skeleton -->
        <div class="htmx-indicator-skeleton__stats">
          {[1,2,3,4].map(() => (
            <span class="htmx-indicator-skeleton__stat">
              <span class="fusion-skeleton__line fusion-skeleton__line--stat-value" style="width:4rem"></span>
              <span class="fusion-skeleton__line" style="width:70%"></span>
            </span>
          ))}
        </div>

        <!-- Card grid skeleton -->
        <div class="htmx-indicator-skeleton__cards">
          {[1,2,3].map(() => (
            <span class="fusion-skeleton__card"></span>
          ))}
        </div>
      </div>

      <!-- Footer hint — switches between "Loading…" and elapsed time -->
      <p class="htmx-indicator__hint" id="htmx-indicator-hint">
        <span class="htmx-indicator__pulse" aria-hidden="true"></span>
        Loading&hellip;
      </p>
    </div>

    <div class="flex min-h-screen flex-col">
      <Header siteName={siteName} navItems={navItems} />
      <main class="flex-1">
        <slot />
      </main>
      <Footer siteSettings={siteSettings} siteName={siteName} />
    </div>

    <CookieConsent />

    <!-- SSR data bridge → Redux initial state (site + page) -->
    <script type="application/json" id="fusion-site-data">
      {JSON.stringify({ siteSettings: siteSettings ?? null, navItems: navItems ?? [], pageData: pageData ?? null, pageSlug: pageSlug ?? '' })}
    </script>

    <!-- Redux store + toast + hydration guard — replaces Alpine toast store.

         NOTE: The slice definitions below are the canonical runtime source.
         The files in lib/store/ (pageSlice.ts, siteSlice.ts, toastSlice.ts)
         serve as type-safe reference copies for TypeScript imports.
         Keep both in sync when changing reducer logic. -->
    <script>
      import { configureStore, createSlice } from '@reduxjs/toolkit';

      // ── Read SSR data from JSON bridge ─────────────────────────────────
      let ssrSiteSettings = null;
      let ssrNavItems = [];
      let ssrPageData = null;
      let ssrPageSlug = '';
      try {
        const el = document.getElementById('fusion-site-data');
        if (el) {
          const data = JSON.parse(el.textContent || '{}');
          ssrSiteSettings = data.siteSettings;
          ssrNavItems = data.navItems;
          ssrPageData = data.pageData;
          ssrPageSlug = data.pageSlug;
        }
      } catch { /* use defaults */ }

      // ── Inline Redux store with toast + site slices ────────────────────
      const toastSlice = createSlice({
        name: 'toast',
        initialState: { visible: false, message: '', variant: 'success' as string },
        reducers: {
          showToast(state, action) {
            state.message = action.payload.message;
            state.variant = action.payload.variant || 'success';
            state.visible = true;
          },
          hideToast(state) { state.visible = false; },
        },
      });

      const siteSlice = createSlice({
        name: 'site',
        initialState: {
          theme: 'light' as string,
          loaded: !!ssrSiteSettings,
          settings: ssrSiteSettings,
          navigation: ssrNavItems,
          error: null as string | null,
        },
        reducers: {
          setTheme(state, action) {
            state.theme = action.payload;
            try { localStorage.setItem('fusion-theme', action.payload); } catch { /* noop */ }
          },
          setLoaded(state) { state.loaded = true; },
          setSettings(state, action) { state.settings = action.payload; },
          setNavigation(state, action) { state.navigation = action.payload; },
          setError(state, action) { state.error = action.payload; },
        },
      });

      const pageSlice = createSlice({
        name: 'page',
        initialState: {
          current: ssrPageData,
          cache: (ssrPageData && ssrPageSlug) ? { [ssrPageSlug]: ssrPageData } : {},
          loading: false,
          error: null as string | null,
        },
        reducers: {
          setPageData(state, action) {
            const { slug, data } = action.payload;
            state.current = data;
            state.cache[slug] = data;
            state.loading = false; state.error = null;
          },
          setPageLoading(state) { state.loading = true; },
          setPageError(state, action) { state.error = action.payload; state.loading = false; },
        },
      });

      const { showToast, hideToast } = toastSlice.actions;
      const { setTheme, setLoaded, setSettings, setNavigation, setError } = siteSlice.actions;

      const reduxStore = configureStore({
        reducer: { toast: toastSlice.reducer, site: siteSlice.reducer, page: pageSlice.reducer },
      });

      // Expose globally for components (Toast.astro, ThemeToggle, HTMX error handler)
      (window as any).__reduxStore = reduxStore;
      (window as any).__showToast = (message: string, variant = 'success') => {
        reduxStore.dispatch(showToast({ message, variant }));
        setTimeout(() => reduxStore.dispatch(hideToast()), 3500);
      };

      // ── Theme sync: Redux → DOM ───────────────────────────────────────
      reduxStore.subscribe(() => {
        const { site: siteState } = reduxStore.getState();
        const root = document.documentElement;
        const isDark = siteState.theme === 'dark';
        root.classList.toggle('dark', isDark);
        root.classList.toggle('light', !isDark);
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', isDark ? '#131312' : '#fcfcfa');
      });

      // ── Hydration skeleton removal ────────────────────────────────────
      document.addEventListener('alpine:initialized', () => {
        document.body.classList.remove('is-hydrating');
        reduxStore.dispatch(setLoaded());
      });
      setTimeout(() => {
        document.body.classList.remove('is-hydrating');
        reduxStore.dispatch(setLoaded());
      }, 3000);
    </script>

    <!-- HTMX bootstrap is now loaded per-page via <HtmxBootstrap /> —
         only pages that use LiveFragment or NewsletterSubscribe pay the ~61 KB cost. -->
  </body>
</html>

---
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import CookieConsent from '@/components/ui/CookieConsent.astro';
import { THEME_STORAGE_KEY, fallbackSiteName, ogImage as fallbackOgImage } from '@/lib/site';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Backend-fetched navigation items (from /apis/navigation/). */
  navItems?: { label: string; href: string; external?: boolean }[];
  /** Backend-fetched site settings (from /apis/site/settings/). */
  siteSettings?: {
    site_name?: string;
    site_tagline?: string;
    logo_url?: string | null;
    footer_description?: string;
    footer_copyright?: string;
    footer_link_groups?: { title: string; links: { label: string; url: string }[] }[];
    social_links?: { platform: string; label: string; url: string; icon_class: string }[];
  };
}

const {
  title = '',
  description = '',
  ogImage = fallbackOgImage,
  navItems,
  siteSettings,
} = Astro.props;

const siteName = siteSettings?.site_name || fallbackSiteName;
const pageTitle = title && title !== siteName ? `${title} \u00b7 ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, 'https://structa.cloud').href;

void THEME_STORAGE_KEY;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, 'https://structa.cloud').href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, 'https://structa.cloud').href} />

    <meta name="theme-color" content="#FCFCFA" />

    <script is:inline define:vars={{ THEME_STORAGE_KEY }}>
      (function () {
        var root = document.documentElement;
        var stored = null;
        try { stored = localStorage.getItem(THEME_STORAGE_KEY); } catch (e) {}
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var dark = stored ? stored === 'dark' : prefersDark;
        root.classList.remove('light', 'dark');
        root.classList.add(dark ? 'dark' : 'light');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', dark ? '#131312' : '#fcfcfa');
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Public+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="is-hydrating">
    <div
      id="htmx-global-indicator"
      class="fixed inset-0 z-50 items-center justify-center bg-fu-paper/80 backdrop-blur-sm"
      aria-hidden="true"
    >
      <div class="container-fusion grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <span class="fusion-skeleton__card"></span>
        <span class="fusion-skeleton__card"></span>
        <span class="fusion-skeleton__card"></span>
      </div>
    </div>

    <div class="flex min-h-screen flex-col">
      <Header siteName={siteName} navItems={navItems} />
      <main class="flex-1">
        <slot />
      </main>
      <Footer siteSettings={siteSettings} siteName={siteName} />
    </div>

    <CookieConsent />

    <!-- Toast store + hydration guard — runs before any Alpine component hydrates -->
    <script>
      import Alpine from 'alpinejs';

      document.addEventListener('alpine:init', () => {
        Alpine.store('toast', {
          visible: false,
          message: '',
          variant: 'success',
          timeout: 0 as number | ReturnType<typeof setTimeout>,
          show(message: string, variant = 'success', duration = 3500) {
            this.message = message;
            this.variant = variant;
            this.visible = true;
            clearTimeout(this.timeout);
            this.timeout = setTimeout(() => (this.visible = false), duration);
          },
        });
      });

      // Remove hydration skeleton after Alpine finishes initializing
      document.addEventListener('alpine:initialized', () => {
        document.body.classList.remove('is-hydrating');
      });
      // Safety net — remove skeleton after 3s regardless
      setTimeout(() => document.body.classList.remove('is-hydrating'), 3000);
    </script>

    <!-- HTMX bootstrap is now loaded per-page via <HtmxBootstrap /> —
         only pages that use LiveFragment or NewsletterSubscribe pay the ~61 KB cost. -->
  </body>
</html>

---
/** Back-to-top button — appears after scrolling past 400px.
 *  Uses Alpine.js for scroll detection + smooth scroll.
 */
interface Props { threshold?: number; }
const { threshold = 400 } = Astro.props;
---

<button
  client:idle
  type="button"
  x-data="{ visible: false, threshold: ${threshold} }"
  x-init="() => { const cb = () => { visible = window.scrollY > threshold }; window.addEventListener('scroll', cb, { passive: true }); }"
  x-show="visible"
  x-transition:enter="transition ease-out duration-200"
  x-transition:enter-start="opacity-0 translate-y-4"
  x-transition:enter-end="opacity-100 translate-y-0"
  x-transition:leave="transition ease-in duration-150"
  x-transition:leave-start="opacity-100 translate-y-0"
  x-transition:leave-end="opacity-0 translate-y-4"
  x-cloak
  @click="window.scrollTo({ top: 0, behavior: 'smooth' })"
  aria-label="Back to top"
  class="fixed bottom-6 right-6 z-40 flex h-11 w-11 items-center justify-center rounded-full border border-fu-line bg-fu-paper text-fu-ink shadow-lg transition-all hover:border-fu-link hover:text-fu-link hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fu-primary"
>
  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
  </svg>
</button>

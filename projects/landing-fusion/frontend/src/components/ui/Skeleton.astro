---
/**
 * Skeleton — the default "content is on its way" placeholder.
 *
 * Renders shimmering block placeholders that mirror the final layout, so the
 * page does not jump when the real content arrives. Three roles:
 *
 *   line  — a text line (title/paragraph/subtitle)
 *   card  — a block/card surface
 *   hero  — a hero-scale title line
 *
 * Combined with two default loading states (both on unless `visible="false"`):
 *
 *   1. HTMX in-flight — `#htmx-global-indicator` in Layout.astro shows a
 *      skeleton overlay whenever any hx-request is pending (HTMX adds the
 *      `.htmx-request` class to the indicator). Fragments from the Django
 *      backend (apps/handlers) swap in when the request completes.
 *
 *   2. Alpine hydrate fallback — while `body` has the `is-hydrating` class
 *      (added pre-paint, removed on `alpine:initialized`), blocks wrapped in
 *      `[data-hydrate-skeleton]` show this skeleton instead of their
 *      `x-cloak`'d interactive content. So an Alpine-powered region never
 *      flashes as empty/static before its JS boots.
 */
interface Props {
  /** Placeholder role — controls size/shape defaults. */
  variant?: 'line' | 'card' | 'hero';
  /** Optional explicit width (e.g. '12rem' / '70%'). */
  width?: string;
  /** Optional explicit height (e.g. '9rem'). */
  height?: string;
  /** Number of identical placeholders to render (for lists/grids). */
  count?: number;
  /** Rows of lines to stack (variant="line" only). */
  lines?: number;
  /** Set false to suppress (e.g. after hydration completes). */
  visible?: boolean;
  class?: string;
}

const {
  variant = 'line',
  width,
  height,
  count = 1,
  lines = 1,
  visible = true,
  class: className = '',
} = Astro.props;

const style = [width && `width:${width}`, height && `height:${height}`]
  .filter(Boolean)
  .join(';');
const placeholders = Array.from({ length: count });
const lineRows = Array.from({ length: lines });
---

{
  visible && (
    <span
      class={`fusion-skeleton fusion-skeleton--${variant} ${className}`}
      aria-hidden="true"
      data-skeleton
      style={style || undefined}
    >
      {variant === 'line' &&
        lineRows.map((_, i) => <span class="fusion-skeleton__line" style={i === 0 ? 'width:92%' : undefined} />)}
      {variant === 'hero' && (
        <>
          <span class="fusion-skeleton__line fusion-skeleton__line--hero" />
          <span class="fusion-skeleton__line" style="width:64%" />
          <span class="fusion-skeleton__line" style="width:42%" />
        </>
      )}
      {variant === 'card' &&
        placeholders.map(() => (
          <span class="fusion-skeleton__card" style={style ? `width:${width};height:${height}` : undefined} />
        ))}
    </span>
  )
}

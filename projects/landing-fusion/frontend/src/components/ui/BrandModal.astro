---
/**
 * BrandModal — the brandkit story for ONE product, opened from product
 * tooltips/cards. Mirrors the backend base.html brand modal (same API, same
 * markup semantics); on the Astro road it lives once in Layout.
 *
 * Trigger contract (works on BOTH render roads, no Alpine scope needed):
 *   - any element with `data-open-brand="<slug>"` opens the modal (delegated
 *     click handler below), and
 *   - the `fusion:open-brand` window event with `detail.slug` also opens it.
 *
 * The board data comes from GET /apis/brand/ (derived from the catalog +
 * BRAND_SPEC on the backend), so page + modal + /brand/ can never drift.
 * BrandPage.display_mode (page / modal / both) decides whether the
 * "Full brand page" link is offered.
 */
import { browserEndpoint } from '@/lib/site';

const brandUrl = browserEndpoint('/apis/brand/');
---

<div
  x-data="{
    open: false,
    loading: false,
    boards: [],
    board: null,
    // SVG glyphs per mark — defined in a real <script> block below (Astro's
    // compiler unescapes \' inside static HTML attributes, which would break
    // these single-quoted strings; window.__FUSION_MARKS survives untouched).
    // The || {} keeps the modal degradable if that inline script ever gets
    // blocked (CSP) — matching the __FUSION_BRAND_URL fallback style.
    marks: window.__FUSION_MARKS || {},
    async open(slug) {
      if (!slug) return;
      this.open = true;
      this.loading = true;
      this.board = null;
      try {
        if (!this.boards.length) {
          const res = await fetch(window.__FUSION_BRAND_URL || '/apis/brand/');
          const data = await res.json();
          this.boards = data.boards || [];
        }
        this.board = this.boards.find((b) => b.slug === slug) || null;
      } catch (e) {
        this.board = null;
      } finally {
        this.loading = false;
      }
    },
    close() { this.open = false; },
  }"
  @keydown.escape.window="open = false"
  @fusion:open-brand.window="open($event.detail.slug)"
>
  <div
    x-show="open"
    x-cloak
    style="display:none"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-[85] flex items-center justify-center bg-fu-ink/50 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="Brand"
    @click.self="open = false"
  >
    <div class="w-full max-w-lg rounded-2xl border border-fu-line bg-fu-paper shadow-2xl" style="max-height:85dvh;overflow-y:auto;">
      <div x-show="loading" x-cloak class="px-8 py-14 text-center font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-muted">loading brand…</div>

      <template x-if="!loading && board">
        <div>
          <!-- Lockup -->
          <div class="flex items-start justify-between gap-4 border-b border-fu-line p-6">
            <div class="flex items-center gap-3.5">
              <span class="product-logo" :data-brand="(board.brand || 'formints').toLowerCase()" style="width:2.75rem;height:2.75rem;">
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" x-html="marks[board.mark] || marks['orbit']"></svg>
              </span>
              <div>
                <p class="tag-marker mb-1">brand · identity</p>
                <h2 class="font-display text-xl font-bold tracking-tight text-fu-ink" x-text="board.name"></h2>
                <p class="mt-0.5 font-mono text-[0.6rem] uppercase tracking-[0.14em] text-fu-muted" x-text="board.role"></p>
              </div>
            </div>
            <button type="button" @click="close()" aria-label="Close" class="rounded-md p-2 text-fu-muted transition-colors hover:bg-fu-line/40 hover:text-fu-ink">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>

          <!-- Construction geometry on the blueprint grid -->
          <div class="relative grid min-h-[10rem] place-items-center" style="background-image:linear-gradient(hsl(var(--fu-line) / .55) 1px,transparent 1px),linear-gradient(90deg,hsl(var(--fu-line) / .55) 1px,transparent 1px);background-size:1rem 1rem;">
            <div class="absolute left-0 right-0 top-1/2 h-px bg-fu-line"></div>
            <div class="absolute bottom-0 left-1/2 top-0 w-px bg-fu-line"></div>
            <div class="relative z-10 rounded-xl shadow-[0_0_0_6px_hsl(var(--fu-card))]">
              <span class="product-logo" :data-brand="(board.brand || 'formints').toLowerCase()" style="width:3.5rem;height:3.5rem;">
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" x-html="marks[board.mark] || marks['orbit']"></svg>
              </span>
            </div>
          </div>

          <!-- The brand story -->
          <div class="p-6">
            <p class="mb-5 font-display text-[1.05rem] font-semibold leading-snug text-fu-ink" x-text="board.essence"></p>
            <div class="space-y-3 text-sm">
              <div class="flex items-baseline gap-3">
                <span class="w-[5.5rem] flex-none font-mono text-[0.6rem] uppercase tracking-[0.14em] text-fu-muted">metaphor</span>
                <span class="text-fu-ink/85" x-text="board.metaphor"></span>
              </div>
              <div class="flex items-baseline gap-3">
                <span class="w-[5.5rem] flex-none font-mono text-[0.6rem] uppercase tracking-[0.14em] text-fu-muted">construction</span>
                <span class="text-fu-ink/85" x-text="board.construction"></span>
              </div>
              <div class="flex items-baseline gap-3">
                <span class="w-[5.5rem] flex-none font-mono text-[0.6rem] uppercase tracking-[0.14em] text-fu-muted">voice</span>
                <span class="text-fu-ink/85" x-text="board.voice"></span>
              </div>
              <div class="flex items-center gap-3">
                <span class="w-[5.5rem] flex-none font-mono text-[0.6rem] uppercase tracking-[0.14em] text-fu-muted">palette</span>
                <div class="grid w-full grid-cols-5 gap-1.5">
                  <template x-for="(swatch, i) in (board.swatches || [])" :key="i">
                    <div class="flex flex-col items-stretch gap-1" :title="swatch.token">
                      <div class="aspect-square rounded-md border border-fu-line" :style="swatch.style"></div>
                      <span class="truncate text-center font-mono text-[0.55rem] uppercase tracking-[0.08em] text-fu-muted" x-text="swatch.token"></span>
                    </div>
                  </template>
                </div>
              </div>
            </div>
            <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 border-t border-fu-line pt-4">
              <a :href="board.href || '/products/'" class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-link transition-colors hover:text-fu-link-dark">See the product →</a>
              <a href="/brand/" class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-muted transition-colors hover:text-fu-ink">Full brand page →</a>
            </div>
          </div>
        </div>
      </template>

      <div x-show="!loading && !board" x-cloak class="px-8 py-14 text-center text-sm text-fu-muted">No brand data for this product yet.</div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ brandUrl }}>
  window.__FUSION_BRAND_URL = brandUrl;
  // Brand glyphs per mark style — plain JS so backslash escapes survive.
  // Mirrors product_logo.html / ProductLogo.astro.
  window.__FUSION_MARKS = {
    crest: '<path d=\'M16 2.5l11.5 4v9.5c0 6.8-4.9 11.6-11.5 13.5C9.4 27.6 4.5 22.8 4.5 16.5V6.5L16 2.5z\' stroke-linejoin=\'round\'/><path d=\'M9.5 19.5h13\' stroke-linecap=\'round\'/><path d=\'M11.8 14.8l2.9 2.9 5.8-6.3\' stroke-linecap=\'round\' stroke-linejoin=\'round\'/>',
    ribbon: '<path d=\'M4 8.5h24v7.5a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V8.5z\' stroke-linejoin=\'round\'/><path d=\'M10.5 19.5l2.4 4.5M16 19.5v4.5M21.5 19.5l-2.4 4.5\' stroke-linecap=\'round\' stroke-linejoin=\'round\'/><path d=\'M12.5 12.5l2.6 2.6 5-5.4M15.1 15.1V9\' stroke-linecap=\'round\' stroke-linejoin=\'round\'/>',
    isometric: '<path d=\'M16 3l11 6v14L16 29 5 23V9l11-6z\' stroke-linejoin=\'round\'/><path d=\'M5 9l11 6 11-6M16 15v14\' stroke-linejoin=\'round\'/><path d=\'M16 10.5l5.8 3.2v6.6L16 23.5l-5.8-3.2v-6.6l5.8-3.2z\' stroke-linejoin=\'round\'/><path d=\'M10.2 13.7l5.8 3.2 5.8-3.2M16 16.9v6.6\' stroke-linejoin=\'round\'/>',
    orbit: '<circle cx=\'16\' cy=\'16\' r=\'2.6\' fill=\'currentColor\' stroke=\'none\'/><ellipse cx=\'16\' cy=\'16\' rx=\'10.5\' ry=\'4.2\' transform=\'rotate(-24 16 16)\' stroke-linejoin=\'round\'/><ellipse cx=\'16\' cy=\'16\' rx=\'10.5\' ry=\'4.2\' transform=\'rotate(24 16 16)\' stroke-linejoin=\'round\'/><circle cx=\'25.2\' cy=\'12.4\' r=\'1.4\' fill=\'currentColor\' stroke=\'none\'/>',
    ascent: '<path d=\'M4 26h7v-7h7v-7h7\' stroke-linecap=\'round\' stroke-linejoin=\'round\'/><path d=\'M24.8 12.2l2.4 2.4 4-4.4\' stroke-linecap=\'round\' stroke-linejoin=\'round\'/><path d=\'M4 6v20\' stroke-linecap=\'round\'/>',
  };
  // Delegated trigger — any [data-open-brand="<slug>"] element (product
  // lockups, cards, tooltips) opens the brand modal without needing an Alpine
  // scope. Mirrors the backend base.html handler so both roads share one
  // contract. preventDefault stops card anchors from navigating.
  document.addEventListener('click', function (e) {
    var t = e.target && e.target.closest ? e.target.closest('[data-open-brand]') : null;
    if (t) {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('fusion:open-brand', {
        detail: { slug: t.getAttribute('data-open-brand') },
      }));
    }
  });
</script>

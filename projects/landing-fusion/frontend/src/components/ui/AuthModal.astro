---
// AuthModal — Alpine-powered login/register modal that fetches allauth
// templates via HTMX from the Django backend. Works identically on both
// the Astro dev server (proxied) and the backend road.
// Props:
//   - authUrl: base URL for allauth (default '/accounts/login/')
//   - label: trigger button text (default 'Sign in')
//   - variant: 'primary' | 'secondary' | 'ghost' (default 'ghost')
interface Props {
  authUrl?: string;
  label?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
}
const { authUrl = '/accounts/login/', label = 'Sign in', variant = 'ghost' } = Astro.props;

const variantStyles = {
  primary: 'bg-fu-ink text-white hover:bg-fu-ink/90',
  secondary: 'rounded-lg border border-fu-line bg-fu-card px-4 py-2 text-sm font-medium text-fu-ink hover:bg-fu-surface',
  ghost: 'text-sm font-medium text-fu-muted hover:text-fu-ink',
};
const btnClass = variantStyles[variant] || variantStyles.ghost;
---
<div x-data="{ open: false, loading: false }" x-id="['auth-modal']">
  <button type="button" @click="open = true"
          class:list={"inline-flex items-center gap-1.5 transition-colors", btnClass}>
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0"/>
    </svg>
    {label}
  </button>

  <!-- Modal overlay -->
  <div x-show="open" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4" @click.self="open = false" style="display:none">
    <!-- Modal card -->
    <div x-show="open" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100 scale-100" x-transition:leave-end="opacity-0 scale-95" class="relative w-full max-w-md overflow-hidden rounded-xl border border-fu-line bg-fu-card shadow-2xl" style="display:none">
      <!-- Close button -->
      <button type="button" @click="open = false"
              class="absolute right-3 top-3 rounded-md p-1 text-fu-muted hover:text-fu-ink hover:bg-fu-surface transition-colors">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>

      <!-- Content container — HTMX swaps the allauth fragment here -->
      <div class="p-6"
           hx-get={authUrl}
           hx-trigger="load"
           hx-target="this"
           hx-swap="innerHTML"
           hx-headers='{"HX-Request": "true"}'
           x-init="setTimeout(() => { if (window.htmx) window.htmx.process($el); }, 50)">
        <!-- Skeleton while loading -->
        <div class="animate-pulse space-y-4">
          <div class="mx-auto mb-4 h-6 w-32 rounded bg-fu-surface"></div>
          <div class="space-y-2">
            <div class="h-4 w-16 rounded bg-fu-surface"></div>
            <div class="h-10 rounded-lg bg-fu-surface"></div>
          </div>
          <div class="space-y-2">
            <div class="h-4 w-20 rounded bg-fu-surface"></div>
            <div class="h-10 rounded-lg bg-fu-surface"></div>
          </div>
          <div class="h-10 rounded-lg bg-fu-surface"></div>
        </div>
      </div>
    </div>
  </div>
</div>

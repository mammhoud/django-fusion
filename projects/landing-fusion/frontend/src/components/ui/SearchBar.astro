---
/** Search bar — Alpine.js live-filter search with keyboard shortcut (⌘K).
 *
 * Emits a custom 'search-input' event so parent components can react.
 * Press ⌘K / Ctrl+K to focus the search input.
 */
interface Props {
  placeholder?: string;
  /** CSS class for the wrapper */
  class?: string;
  /** Whether to show the ⌘K shortcut badge */
  showShortcut?: boolean;
}

const { placeholder = 'Search...', class: cls = '', showShortcut = true } = Astro.props;
---

<div
  client:idle
  class={`fusion-search relative ${cls}`}
  x-data="{
    query: '',
    focused: false,
    clear() { this.query = ''; this.$refs.input.focus(); },
  }"
  @keydown.window.cmd.k.prevent="$refs.input.focus()"
  @keydown.window.ctrl.k.prevent="$refs.input.focus()"
>
  <label for="fusion-search-input" class="sr-only">Search</label>

  {/* Search icon */}
  <svg
    class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-fu-muted/60 transition-colors"
    :class="focused ? 'text-fu-link' : ''"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
  </svg>

  <input
    id="fusion-search-input"
    x-ref="input"
    type="search"
    x-model="query"
    @focus="focused = true"
    @blur="focused = false"
    @input="$dispatch('search-input', { query: $event.target.value })"
    placeholder={placeholder}
    autocomplete="off"
    class="w-full rounded-lg border border-fu-line bg-fu-paper py-2.5 pl-10 pr-10 text-sm text-fu-ink placeholder:text-fu-muted/50 transition-colors focus:border-fu-link focus:outline-none focus:ring-1 focus:ring-fu-link"
  />

  {/* Clear button */}
  <button
    type="button"
    x-show="query.length > 0"
    x-transition:enter="transition ease-out duration-100"
    x-transition:enter-start="opacity-0 scale-75"
    x-transition:enter-end="opacity-100 scale-100"
    x-cloak
    @click="clear()"
    class="absolute right-10 top-1/2 flex h-5 w-5 -translate-y-1/2 items-center justify-center rounded text-fu-muted/60 hover:text-fu-ink transition-colors"
    aria-label="Clear search"
  >
    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  {/* ⌘K shortcut badge */}
  {showShortcut && (
    <kbd
      x-show="!focused && query.length === 0"
      class="pointer-events-none absolute right-3 top-1/2 hidden -translate-y-1/2 rounded border border-fu-line/60 px-1.5 py-0.5 font-mono text-[0.6rem] font-semibold text-fu-muted/50 sm:inline-block"
      aria-hidden="true"
    >
      ⌘K
    </kbd>
  )}
</div>

---
/** Full-page loading screen — shown during initial Alpine.js hydration.
 *  Includes the fusion logo mark and a subtle pulsing animation.
 */
interface Props {
  message?: string;
}
const { message = 'Loading...' } = Astro.props;
---

<div
  client:idle
  id="page-loader"
  class="fixed inset-0 z-[100] flex flex-col items-center justify-center gap-6 bg-fu-paper"
  aria-label="Loading"
  role="status"
>
  {/* Logo mark */}
  <div class="animate-pulse">
    <svg class="h-12 w-12" viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <rect width="32" height="32" rx="6" fill="#1A1917"/>
      <path d="M12 8L6 14l6 6" stroke="#0B57D0" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M20 8l6 6-6 6" stroke="#0B57D0" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M18 6l-4 20" stroke="#FFE14D" stroke-width="2.2" fill="none" stroke-linecap="round"/>
    </svg>
  </div>

  {/* Spinner */}
  <div class="flex items-center gap-3">
    <span class="h-2 w-2 animate-bounce rounded-full bg-fu-link" style="animation-delay: 0ms" aria-hidden="true"></span>
    <span class="h-2 w-2 animate-bounce rounded-full bg-fu-link" style="animation-delay: 150ms" aria-hidden="true"></span>
    <span class="h-2 w-2 animate-bounce rounded-full bg-fu-link" style="animation-delay: 300ms" aria-hidden="true"></span>
  </div>

  <p class="tag-marker">{message}</p>
</div>

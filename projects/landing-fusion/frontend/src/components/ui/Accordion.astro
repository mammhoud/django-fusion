---
interface Item {
  question: string;
  answer: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div
  class="space-y-3"
  x-data="{ open: null, toggle(id) { this.open = this.open === id ? null : id; } }"
>
  {items.map((item, i) => (
    <div
      class="card overflow-hidden transition-shadow"
      :class="open === ${i} ? 'ring-2 ring-fu-primary/20' : ''"
    >
      <button
        type="button"
        class="flex w-full items-center justify-between gap-4 px-6 py-4 text-left"
        @click="toggle(${i})"
        :aria-expanded="(open === ${i}).toString()"
      >
        <span class="text-sm font-semibold text-fu-text">{item.question}</span>
        <svg
          class="h-5 w-5 flex-shrink-0 text-fu-primary transition-transform duration-300"
          :class="open === ${i} ? 'rotate-180' : ''"
          fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
      <div x-show="open === ${i}" x-collapse>
        <p class="px-6 pb-5 text-sm leading-relaxed text-fu-text/70">{item.answer}</p>
      </div>
    </div>
  ))}
</div>

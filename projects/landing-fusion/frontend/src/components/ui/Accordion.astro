---
interface Item {
  question: string;
  answer: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div
  client:idle
  class="space-y-3"
  x-data="{ open: null, toggle(id) { this.open = this.open === id ? null : id; } }"
>
  {items.map((item, i) => (
    <div
      class="card overflow-hidden transition-shadow"
      :class={`open === ${i} ? 'border-fu-link ring-1 ring-fu-link/25' : ''`}
    >
      <button
        type="button"
        class="flex w-full items-center gap-4 px-5 py-4 text-left"
        @click={`toggle(${i})`}
        :aria-expanded={`(open === ${i}).toString()`}
      >
        <span class="shrink-0 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-fu-link" aria-hidden="true">
          Q{String(i + 1).padStart(2, '0')}
        </span>
        <span class="flex-1 font-display text-[0.98rem] font-semibold text-fu-ink">{item.question}</span>
        <svg
          class="h-4 w-4 flex-shrink-0 text-fu-muted transition-transform duration-300"
          :class={`open === ${i} ? 'rotate-180 text-fu-link' : ''`}
          fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
      <div x-show={`open === ${i}`} x-collapse>
        <div class="flex gap-4 px-5 pb-5 pl-[4.2rem]">
          <p class="text-sm leading-relaxed text-fu-muted">{item.answer}</p>
        </div>
      </div>
    </div>
  ))}
</div>

---
import PricingCard from '@/components/ui/PricingCard.astro';

export interface Plan {
  name: string;
  price: number;
  period: string;
  description: string;
  features: string[];
  highlighted?: boolean;
  cta: { label: string; href: string };
}

interface Props {
  heading?: string;
  intro?: string;
  plans?: Plan[];
  /** Render the pricing grid without its own <section> wrapper (used when folded into Features). */
  folded?: boolean;
}

const defaultPlans: Plan[] = [
  {
    name: 'Starter',
    price: 0,
    period: 'forever',
    description: 'For evaluating the stack on your own.',
    features: [
      'Static landing pages',
      'Community support',
      'Basic analytics',
      'Open-source license',
    ],
    cta: { label: 'Start free', href: '/#cta' },
  },
  {
    name: 'Pro',
    price: 29,
    period: 'per month',
    description: 'For teams shipping production sites.',
    highlighted: true,
    features: [
      'Wagtail page builder',
      'HTMX dynamic fragments',
      'Priority support',
      'Custom domains',
      'Team roles',
    ],
    cta: { label: 'Go Pro', href: '/#cta' },
  },
  {
    name: 'Enterprise',
    price: 99,
    period: 'per month',
    description: 'For organizations with real traffic.',
    features: [
      'Everything in Pro',
      'SSO & audit logs',
      'Dedicated success manager',
      'Custom branding',
      'API access',
    ],
    cta: { label: 'Contact sales', href: '/contact' },
  },
];

const {
  heading = 'Pricing, printed clearly',
  intro = 'No hidden fees, no per-seat math. Pick a sheet, ship a site.',
  plans = defaultPlans,
  folded = false,
} = Astro.props;
---

{folded ? (
  <div id="pricing" class="mt-16 sm:mt-20 border-t border-fu-line pt-14 sm:pt-16">
    <div class="pricing__header">
      <p class="tag-marker mb-4">pricing</p>
      <h2 class="page-section__title">{heading}</h2>
      <p class="text-fu-muted">{intro}</p>
    </div>

    <div class="pricing__grid">
      {plans.map((plan) => <PricingCard plan={plan} />)}
    </div>
  </div>
) : (
  <section id="pricing" class="pricing">
    <div class="container-fusion">
      <div class="pricing__header">
        <p class="tag-marker mb-4">pricing</p>
        <h2 class="page-section__title">{heading}</h2>
        <p class="text-fu-muted">{intro}</p>
      </div>

      <div class="pricing__grid">
        {plans.map((plan) => <PricingCard plan={plan} />)}
      </div>
    </div>
  </section>
)}

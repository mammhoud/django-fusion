---
import Pricing from '@/components/blocks/Pricing.astro';
import type { Plan } from '@/components/blocks/Pricing.astro';

interface Feature {
  icon: 'rocket' | 'bolt' | 'shield' | 'users' | 'chart' | 'globe';
  title: string;
  description: string;
}

interface Props {
  heading?: string;
  intro?: string;
  features?: Feature[];
  /** Optional pricing section folded into the bottom of this section. */
  pricing?: { heading?: string; intro?: string; plans?: Plan[] };
}

const defaultFeatures: Feature[] = [
  {
    icon: 'rocket',
    title: 'Server-rendered by default',
    description: 'Astro renders every page to HTML at build time. The browser downloads finished markup — no client boot, no first-paint spinner.',
  },
  {
    icon: 'bolt',
    title: 'HTMX fragments',
    description: 'Dynamic regions stream from Django as HTML fragments over plain HTTP. No JSON API, no decoder, no state layer to keep in sync.',
  },
  {
    icon: 'shield',
    title: 'Alpine micro-interactions',
    description: 'A toggle or an accordion should not cost a framework. Alpine adds interactivity in-place, only where the page actually needs it.',
  },
  {
    icon: 'chart',
    title: '0 KB of framework JS',
    description: 'No React, no hydration script, no node_modules in the critical path. Your pages feel instant because they ship as documents.',
  },
  {
    icon: 'globe',
    title: 'SEO is free',
    description: 'Search engines read the finished page, not a shell. Content, headings and links are in the first byte of the response.',
  },
  {
    icon: 'users',
    title: 'Built for teams',
    description: 'Wagtail-editable blocks in Django, Astro components in the frontend, one mental model: HTML in, HTML out.',
  },
];

const {
  heading = 'Everything is a document',
  intro = 'No hidden layers between your content and the browser. The AHA stack — Astro, HTMX, Alpine — renders the web the way it was meant to ship.',
  features = defaultFeatures,
  pricing,
} = Astro.props;

const iconPaths: Record<Feature['icon'], string> = {
  rocket: 'M14.053 4.197a1 1 0 011.306.615l1.386 4.324 4.324 1.386a1 1 0 010 1.895l-4.324 1.386-1.386 4.324a1 1 0 01-1.895 0l-1.386-4.324-4.324-1.386a1 1 0 010-1.895l4.324-1.386 1.386-4.324a1 1 0 011.11-.615z',
  bolt: 'M13 10V3L4 14h7v7l9-11h-7z',
  shield: 'M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z',
  users: 'M17 20h5v-2a3 3 0 00-4.1-2.7M9 20H4v-2a3 3 0 015.1-2M12 16a4 4 0 100-8 4 4 0 000 8zm5-3a3 3 0 100-6',
  chart: 'M3 21h18M6 17v-5M11 17V7M16 17v-9M21 17v-3',
  globe: 'M12 21a9 9 0 100-18 9 9 0 000 18zm-9-9h18M12 3c2.5 2.5 3.5 5.5 3.5 9S14.5 18.5 12 21c-2.5-2.5-3.5-5.5-3.5-9S9.5 5.5 12 3z',
};
---

<section id="features" class="doc-sheet bg-fu-paper py-20 md:py-24">
  <div class="container-fusion">
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <p class="tag-marker mb-4">features</p>
      <h2 class="mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl">{heading}</h2>
      <p class="text-fu-muted">{intro}</p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature, i) => (
        <div
          class="card reveal group relative p-6 pt-7 hover:-translate-y-0.5"
          x-data x-intersect="$el.classList.add('reveal-visible')"
          style={`transition-delay: ${i * 60}ms`}
        >
          <span class="absolute right-4 top-3 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-fu-muted/70" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div class="mb-5 inline-flex h-10 w-10 items-center justify-center rounded-md border border-fu-line bg-fu-card text-fu-link transition-colors duration-300 group-hover:border-fu-link">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[feature.icon]} />
            </svg>
          </div>
          <h3 class="mb-2 font-display text-[1.05rem] font-semibold text-fu-ink">{feature.title}</h3>
          <p class="text-sm leading-relaxed text-fu-muted">{feature.description}</p>
        </div>
      ))}
    </div>

    {pricing && <Pricing folded {...pricing} />}
  </div>
</section>

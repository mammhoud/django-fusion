---
import Accordion from '@/components/ui/Accordion.astro';
import Skeleton from '@/components/ui/Skeleton.astro';

interface Props {
  heading?: string;
  intro?: string;
  items?: { question: string; answer: string }[];
  /** Whether to render the search bar. */
  searchable?: boolean;
}

const defaultItems = [
  {
    question: 'What exactly is the AHA stack?',
    answer:
      'AHA stands for Astro + HTMX + Alpine.js, a lightweight alternative to heavy SPA frameworks. Astro renders server-side HTML, HTMX swaps fragments from the Django backend, and Alpine.js powers local interactivity. No Redux, no decoder, no client-side router needed for most pages.',
  },
  {
    question: 'Do I need to write JavaScript?',
    answer:
      'Not for the page itself. Your content is HTML; interactions are declared with small hx-* and x-* attributes. Alpine is 15 KB, and you only load it on pages that actually use it.',
  },
  {
    question: 'How is this different from a React or Vue site?',
    answer:
      'A React site sends a shell plus a bundle, then builds the page in the browser. Fusion sends the finished HTML in one response. Less to download, less to run, and search engines read exactly what your visitors see.',
  },
  {
    question: 'Can I still build dynamic dashboards?',
    answer:
      'Yes. HTMX streams HTML fragments from Django over plain HTTP — the same technology as your landing page. Dynamic regions stay server-rendered, so there is never a second, parallel API to maintain.',
  },
  {
    question: 'What about team and enterprise needs?',
    answer:
      'The Enterprise sheet includes SSO, audit logs, custom branding and a dedicated success manager. Contact us for volume discounts and custom requirements.',
  },
  {
    question: 'Is my data secure?',
    answer:
      'Sessions use django-allauth best practices, forms are CSRF-protected, and traffic is served over HTTPS with Let’s Encrypt certificates.',
  },
];

const {
  heading = 'Questions, answered in plain HTML',
  intro = 'The honest answers to the questions technical buyers ask.',
  items = defaultItems,
  searchable = true,
} = Astro.props;

/** Items serialised into the Alpine scope so filtering + counter share one source of truth. */
const itemsJson = JSON.stringify(items);
---

<section id="faq" class="faq">
  <div class="container-fusion">
    <div class="faq__header">
      {heading && <h2 class="page-section__title">{heading}</h2>}
      {intro && <p class="text-fu-muted">{intro}</p>}
    </div>

    <div data-hydrate-skeleton>
      <Skeleton variant="faq-list" count={items.length} />
    </div>

    <div data-hydrate-content class="mx-auto max-w-2xl" client:idle x-data={`{ query: '', items: ${itemsJson} }`}>
      {searchable && (
        <div class="faq__search">
          <div class="relative">
            <svg class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-fu-muted/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.3-4.3M17 10a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input
              type="search"
              x-model="query"
              class="input-field !pl-11 !py-3"
              placeholder="Search the FAQ…"
              aria-label="Search frequently asked questions"
            />
          </div>
          <p
            class="mt-3 text-center font-mono text-[0.72rem] uppercase tracking-wider text-fu-muted"
            x-show="query.length > 0"
            x-cloak
            x-text="`${items.filter(i => i.question.toLowerCase().includes(query.toLowerCase()) || i.answer.toLowerCase().includes(query.toLowerCase())).length} match(es)`"
          ></p>
        </div>
      )}

      <div class="faq__list">
        {items.map((item, i) => (
          <div
            x-show={`query === '' || items[${i}].question.toLowerCase().includes(query.toLowerCase()) || items[${i}].answer.toLowerCase().includes(query.toLowerCase())`}
            x-cloak
          >
            <Accordion items={[item]} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

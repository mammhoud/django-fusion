---
interface Props {
  heading?: string;
  intro?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  heading = 'Ship the document, not the app',
  intro = 'One HTTP response, finished HTML. Start building on Fusion CMS today — no framework to learn, no bundle to wait for.',
  ctaLabel = 'Create free account',
  ctaHref = '/#cta',
} = Astro.props;
---

<section id="cta" class="doc-sheet reg-marks overflow-hidden bg-[#1a1917] py-20 text-[#f0eee8] md:py-24">
  <div class="container-fusion">
    <div class="mx-auto max-w-3xl text-center">
      <p class="tag-marker mb-5 !text-[#b0aba0]">cta</p>
      <h2 class="mb-4 font-display text-3xl font-bold tracking-tight md:text-4xl">{heading}</h2>
      <p class="mx-auto mb-9 max-w-xl text-lg leading-relaxed text-[#b0aba0]">{intro}</p>
      <div class="flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href={ctaHref}
          class="btn-primary !px-8 !py-3.5 text-base"
          @click.prevent="$store.toast.show('Account created. Check your inbox.')"
        >
          {ctaLabel}
        </a>
        <a
          href="/contact"
          class="btn !px-8 !py-3.5 text-base text-[#f0eee8] ring-1 ring-inset ring-[#f0eee8]/40 hover:bg-[#f0eee8]/5"
        >
          Talk to sales
        </a>
      </div>
      <p class="mt-8">
        <span class="status-line !text-[#b0aba0]"><span class="dot" aria-hidden="true"></span>ready when you are · text/html</span>
      </p>
    </div>
  </div>
</section>

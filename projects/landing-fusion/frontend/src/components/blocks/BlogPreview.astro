---
import Skeleton from '@/components/ui/Skeleton.astro';

interface BlogPost {
  title: string;
  slug: string;
  excerpt: string;
  date: string;
  author?: string;
  category?: string;
  image?: string;
  readTime?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  posts: BlogPost[];
  /** Link to the full blog index */
  viewAllHref?: string;
}

const { eyebrow, title = 'From the blog', description, posts, viewAllHref = '/blog/' } = Astro.props;
---

<section class="doc-sheet bg-fu-paper py-20 md:py-24">
  <div data-hydrate-skeleton>
    <Skeleton variant="blog-grid" />
  </div>
  <div data-hydrate-content>
    <div class="container-fusion">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          {eyebrow && <p class="tag-marker mb-4 reveal" x-data x-intersect="$el.classList.add('reveal-visible')" x-cloak>{eyebrow}</p>}
          <h2 class="font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl reveal" x-data x-intersect="$el.classList.add('reveal-visible')">{title}</h2>
          {description && <p class="mt-3 max-w-xl text-fu-muted reveal" x-data x-intersect="$el.classList.add('reveal-visible')" style="transition-delay: 50ms">{description}</p>}
        </div>
        {viewAllHref && (
          <a href={viewAllHref} class="btn-secondary shrink-0 reveal" x-data x-intersect="$el.classList.add('reveal-visible')">
            View all posts
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        )}
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, i) => (
          <a
            href={`/blog/${post.slug}/`}
            class="card reveal group overflow-hidden hover:-translate-y-1"
            x-data x-intersect="$el.classList.add('reveal-visible')"
            style={`transition-delay: ${i * 80}ms`}
          >
            {post.image && (
              <div class="h-48 overflow-hidden bg-fu-card">
                <img src={post.image} alt={post.title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
              </div>
            )}
            <div class="p-5">
              <div class="mb-3 flex items-center gap-3 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-fu-muted">
                {post.category && <span class="text-fu-link">{post.category}</span>}
                {post.readTime && <span>{post.readTime}</span>}
                <time>{post.date}</time>
              </div>
              <h3 class="mb-2 font-display text-[1.05rem] font-semibold text-fu-ink transition-colors group-hover:text-fu-link">{post.title}</h3>
              <p class="text-sm leading-relaxed text-fu-muted">{post.excerpt}</p>
              {post.author && (
                <p class="mt-4 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-fu-muted/70">By {post.author}</p>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

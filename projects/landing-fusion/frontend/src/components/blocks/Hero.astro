---
import Skeleton from '@/components/ui/Skeleton.astro';

// Fusion CMS hero — "the page as its own document."
//
// Signature element: a real View Source toggle (Alpine) that flips the
// rendered hero to its own literal markup, proving the AHA-stack pitch:
// this page IS server-rendered HTML. The source shown is the actual hero
// markup, generated from the same props, so it's always truthful.

interface Props {
  eyebrow?: string;
  heading?: string;
  accent?: string;
  intro?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  status?: string;
}

const {
  eyebrow = 'server-rendered · zero heavy SPA',
  heading = 'Your website, delivered as',
  accent = 'plain HTML',
  intro =
    'Fusion CMS renders every page as server-rendered HTML — no 500&nbsp;KB JavaScript bundle, no hydration, no client framework to babysit. What the browser downloads is what your server sent.',
  primaryCta = { label: 'Start building', href: '/#cta' },
  secondaryCta = { label: 'Read the docs', href: '/about' },
  status = '200 OK · text/html · 0 KB client JS',
} = Astro.props;

const sourceMarkup = [
  '<!doctype html>',
  '<html lang="en">',
  '  <head>',
  '    <meta charset="utf-8" />',
  '    <title>Fusion CMS</title>',
  '    <meta name="description" content="Your website, delivered as plain HTML." />',
  '  </head>',
  '  <body>',
  '    <header>',
  `      <h1>${heading} ${accent}</h1>`,
  `      <p>${intro.replace(/&nbsp;/g, ' ')}</p>`,
  `      <a href="${primaryCta.href}">${primaryCta.label}</a>`,
  '    </header>',
  '  </body>',
  '</html>',
].join('\n');
---

<section class="section-hero reg-marks overflow-hidden">
  <!-- Skeleton while Alpine boots (x-intersect reveals) — component-matched height -->
  <div data-hydrate-skeleton>
    <Skeleton variant="hero-section" />
  </div>
  <div data-hydrate-content>
  <div class="container-fusion py-20 md:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="tag-marker reveal mb-5"
        x-data x-intersect="$el.classList.add('reveal-visible')" x-cloak
      >
        {eyebrow}
      </p>

      <h1
        class="reveal mb-6 font-display text-[2.6rem] font-bold leading-[1.05] tracking-tight md:text-6xl"
        x-data x-intersect="$el.classList.add('reveal-visible')"
      >
        {heading}{' '}
        <span class="relative inline-block whitespace-nowrap">
          <span class="relative z-10">{accent}</span>
          <!-- Marker underline — the one use of the marker accent -->
          <span class="absolute inset-x-[-0.08em] bottom-[0.06em] z-0 h-[0.34em] rounded-sm bg-fu-mark/70" aria-hidden="true"></span>
        </span>
      </h1>

      <p
        class="reveal mx-auto mb-9 max-w-xl text-[1.05rem] leading-relaxed text-fu-muted md:text-lg"
        x-data x-intersect="$el.classList.add('reveal-visible')"
        style="transition-delay: 100ms"
      >
        {intro}
      </p>

      <div
        class="reveal flex flex-col items-center justify-center gap-3 sm:flex-row"
        x-data x-intersect="$el.classList.add('reveal-visible')"
        style="transition-delay: 200ms"
      >
        <a href={primaryCta.href} class="btn-primary !px-7 !py-3">
          {primaryCta.label}
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
        <a href={secondaryCta.href} class="btn-secondary !px-7 !py-3">
          {secondaryCta.label}
        </a>
      </div>

      <!-- Status line — reads like a server response -->
      <p
        class="reveal mt-8 flex items-center justify-center"
        x-data x-intersect="$el.classList.add('reveal-visible')"
        style="transition-delay: 260ms"
      >
        <span class="status-line"><span class="dot" aria-hidden="true"></span>{status}</span>
      </p>
    </div>

    <!-- ── View Source toggle: the signature ───────────────────────── -->
    <div
      class="reveal mx-auto mt-14 max-w-2xl"
      client:load
      x-data="{ showSource: false }"
      x-intersect="$el.classList.add('reveal-visible')"
      style="transition-delay: 320ms"
    >
      <div class="mb-3 flex items-center justify-between gap-3">
        <p class="tag-marker">view-source:fusion-cms</p>
        <button
          type="button"
          class="btn-secondary !h-9 !px-4 !py-0 font-mono text-xs uppercase tracking-wider"
          @click="showSource = !showSource"
          :aria-expanded="showSource.toString()"
          aria-controls="hero-source"
        >
          <svg x-show="!showSource" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6v6m-9 3l9-9"/>
          </svg>
          <svg x-show="showSource" x-cloak class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 5l16 16M4 21L20 5"/>
          </svg>
          <span x-text="showSource ? 'Back to rendered' : 'View source'"></span>
        </button>
      </div>

      <!-- Rendered state -->
      <div id="hero-source" x-show="!showSource">
        <div class="source-panel" aria-hidden="true">
          <code><span class="tok-com">&lt;!-- the hero, as it ships to the browser --&gt;</span></code>
        </div>
      </div>

      <!-- Source state -->
      <div x-show="showSource" x-cloak>
        <pre class="source-panel" role="region" aria-label="Source of this hero section"><code>{sourceMarkup}</code></pre>
        <p class="mt-2 text-center font-mono text-[0.7rem] uppercase tracking-wider text-fu-muted">
          That&apos;s it. One HTTP response, no framework.
        </p>
      </div>
    </div>
  </div>
  </div>
</section>

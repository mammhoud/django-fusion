---
import Skeleton from '@/components/ui/Skeleton.astro';

// Structa Cloud hero — "the page as its own document."
//
// Signature element: the hero's right column is its OWN literal source, shown
// by default, proving the AHA-stack pitch: this page IS server-rendered HTML.
// The source is generated from the same props that render the hero, so it is
// always truthful. A toggle flips to a miniature rendered view.

interface Props {
  eyebrow?: string;
  heading?: string;
  accent?: string;
  intro?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  status?: string;
  /** 'cinematic' — ultra-wide centered hero (home road). */
  variant?: 'default' | 'cinematic';
}

const {
  eyebrow = 'structa.cloud · full-stack engineering',
  heading = 'Platforms that ship as',
  accent = 'documents',
  intro =
    'Structa Cloud renders every page as server-rendered HTML. No 500 KB bundle, no hydration, no framework.',
  primaryCta = { label: 'Explore the stack', href: '/products' },
  secondaryCta = { label: 'About the engineer', href: '/about' },
  status = '200 OK · text/html',
  variant = 'default',
} = Astro.props;

const cinematic = variant === 'cinematic';

// Entrance ownership: the default road reveals via Alpine x-intersect (the
// site-wide blur-fade-up language); the cinematic road lets GSAP own the
// hero intro, so the Alpine reveal wiring is dropped there entirely — two
// animators must never fight over the same opacity/transform.
const revealWiring = cinematic
  ? {}
  : {
      'x-data': '',
      'x-intersect': "$el.classList.add('reveal-visible')",
    };

// Plain-text intro for the source block and the rendered mini-view.
const plainIntro = intro.replace(/&nbsp;/g, ' ');

const sourceMarkup = [
  '<!doctype html>',
  '<html lang="en">',
  '  <head>',
  '    <meta charset="utf-8" />',
  `    <title>${heading} ${accent}</title>`,
  `    <meta name="description" content="${plainIntro}" />`,
  '  </head>',
  '  <body>',
  '    <header>',
  `      <h1>${heading} ${accent}</h1>`,
  `      <p>${plainIntro}</p>`,
  `      <a href="${primaryCta.href}">${primaryCta.label}</a>`,
  '    </header>',
  '  </body>',
  '</html>',
].join('\n');
---

<section class={`hero${cinematic ? ' hero--cinematic' : ''}`} data-gsap={cinematic ? 'hero-intro' : undefined}>
  <!-- Registration corners — the sheet is printed, not rendered. -->
  <span class="hero__corner-tl" aria-hidden="true"></span>
  <span class="hero__corner-br" aria-hidden="true"></span>
  <!-- Skeleton while Alpine boots (x-intersect reveals) — component-matched height -->
  <div data-hydrate-skeleton>
    <Skeleton variant="hero-section" />
  </div>
  <div data-hydrate-content>
  <div class="hero__inner">
    <div class="hero__content">
      <p
        class="hero__eyebrow"
        x-cloak={cinematic ? undefined : ''}
        {...revealWiring}
        data-gsap={cinematic ? 'hero-child' : undefined}
      >
        {eyebrow}
      </p>

      <h1
        class="hero__heading"
        {...revealWiring}
        data-gsap={cinematic ? 'hero-child' : undefined}
      >
        {heading}{' '}
        <span class="hero__accent">
          <span class="relative z-10">{accent}</span>
          <span class="hero__accent-mark" aria-hidden="true"></span>
        </span>
      </h1>

      <p
        class="hero__intro"
        {...revealWiring}
        style={cinematic ? undefined : 'transition-delay: 100ms'}
        data-gsap={cinematic ? 'hero-child' : undefined}
      >
        {intro}
      </p>

      <div
        class="hero__actions"
        {...revealWiring}
        style={cinematic ? undefined : 'transition-delay: 200ms'}
        data-gsap={cinematic ? 'hero-child' : undefined}
      >
        <!-- Magnetic wrapper — the CTA drifts toward the cursor (≤6px) and
             snaps back on leave via the Alpine 'magnetic' component
             (registered in alpine.js). Transform lives on the wrapper so the
             button's own :active press-scale and btn-chip arrow stay
             untouched. -->
        <span
          class="btn-magnetic"
          x-data="magnetic"
          @pointerenter="active = true; center()"
          @pointermove="track($event)"
          @pointerleave="leave()"
          :class="active && 'btn-magnetic--tracking'"
          :style="`transform: translate3d(${mx}px, ${my}px, 0)`"
        >
          <a href={primaryCta.href} class="btn-primary btn-chip !px-6 !py-2.5">
            {primaryCta.label}
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </span>
        <span
          class="btn-magnetic"
          x-data="magnetic"
          @pointerenter="active = true; center()"
          @pointermove="track($event)"
          @pointerleave="leave()"
          :class="active && 'btn-magnetic--tracking'"
          :style="`transform: translate3d(${mx}px, ${my}px, 0)`"
        >
          <a href={secondaryCta.href} class="btn-secondary !px-7 !py-3">
            {secondaryCta.label}
          </a>
        </span>
      </div>
    </div>

    {cinematic ? null : (
    <!-- ── View Source panel: the hero's own markup, shown by default ── -->
    <div
      class="hero__source-toggle"
      x-data="{ showSource: true }"
      x-intersect="$el.classList.add('reveal-visible')"
      style="transition-delay: 240ms"
    >
      <div class="hero__source-chrome">
        <span class="hero__source-path">view-source:structa.cloud/</span>
        <span class="hero__source-status">
          <span class="status-line"><span class="dot" aria-hidden="true"></span>{status}</span>
          <span class="hero__source-kb">0 KB client JS</span>
        </span>
      </div>

      <div id="hero-source">
        <!-- Source view — rendered server-side so it reads without JS. -->
        <div x-show="showSource">
          <pre class="source-panel source-panel--bezel" role="region" aria-label="Source of this hero section"><code>{sourceMarkup}</code></pre>
        </div>

        <!-- Rendered view — the real hero, miniaturized. -->
        <div x-show="!showSource" x-cloak class="source-panel source-panel--render" aria-hidden="true">
          <div class="source-panel__doc">
            <p class="source-panel__tag">rendered · index.html</p>
            <h3 class="source-panel__h1">{heading} <span class="source-panel__accent">{accent}</span></h3>
            <p class="source-panel__intro">{plainIntro}</p>
            <div class="source-panel__actions">
              <span class="source-panel__btn source-panel__btn--primary">{primaryCta.label}</span>
              <span class="source-panel__btn source-panel__btn--ghost">{secondaryCta.label}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="hero__source-actions">
        <button
          type="button"
          class="btn-secondary !h-8 !px-3.5 !py-0 font-mono text-[0.68rem] uppercase tracking-wider"
          @click="showSource = !showSource"
          :aria-expanded="showSource.toString()"
          aria-controls="hero-source"
        >
          <span x-text="showSource ? 'Rendered view' : 'View source'"></span>
        </button>
        <p class="hero__source-caption">One HTTP response, no framework.</p>
      </div>
    </div>
    )}
  </div>
  </div>

  <!-- Scroll sentinel for the sticky header — zero-height element at the
       bottom of the hero. x-intersect (IntersectionObserver, not a scroll
       listener) tells the header when the hero has been scrolled past so it
       can tighten its background and grow a soft shadow. Mirrors the
       sentinel in the Django hero.html block template. -->
  <div
    x-data
    aria-hidden="true"
    style="height:0;pointer-events:none;"
    x-intersect:enter="$dispatch('fusion:header-scrolled', { scrolled: false })"
    x-intersect:leave="$dispatch('fusion:header-scrolled', { scrolled: true })"
  ></div>
</section>

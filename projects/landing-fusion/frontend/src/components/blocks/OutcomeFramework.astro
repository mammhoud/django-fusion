---
interface Metric {
  value: string;
  label: string;
  detail: string;
}

interface Outcome {
  title: string;
  problem: string;
  solution: string;
  outcome: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  intro?: string;
  metrics?: Metric[];
  problems?: string[];
  outcomes?: Outcome[];
  ctaHref?: string;
}

const {
  eyebrow = 'outcomes · not a service list',
  heading = 'Build faster. Scale smarter. Spend less.',
  intro = 'A practical path from operational friction to durable momentum — discover the constraint, design the system, automate the repeatable work, then keep improving it.',
  metrics = [
    { value: 'HTML', label: 'content first', detail: 'Make the message available on first paint.' },
    { value: '1 HTTP', label: 'delivery contract', detail: 'Ship finished HTML before enhancement.' },
    { value: 'Lean', label: 'progressive enhancement', detail: 'Use interactivity where it earns its place.' },
    { value: 'Clear', label: 'handoff-ready systems', detail: 'Keep the next decision visible to the team.' },
  ],
  problems = [
    'Manual processes consume engineering time that should go to product work.',
    'Deployments are slow or risky because environments are not repeatable.',
    'Cloud spend grows faster than visibility into what drives it.',
    'Monitoring is reactive, while useful AI opportunities remain unexplored.',
  ],
  outcomes = [
    {
      title: 'AI workflow systems',
      problem: 'Teams lose hours to repetitive research, support, and operations work.',
      solution: 'We map the workflow, add secure agents where they help, and keep a human approval path.',
      outcome: 'More useful work completed without adding operational complexity.',
    },
    {
      title: 'Cloud & delivery engineering',
      problem: 'Infrastructure changes are difficult to reproduce and releases feel fragile.',
      solution: 'We turn environments, CI/CD, observability, and recovery into explicit, reviewable systems.',
      outcome: 'Faster releases with clearer ownership and fewer surprises.',
    },
    {
      title: 'Cost & reliability review',
      problem: 'Spend and incidents are treated as separate problems after the fact.',
      solution: 'We connect usage, architecture, alerts, and operating habits into one improvement backlog.',
      outcome: 'Better decisions backed by evidence rather than guesswork.',
    },
  ],
  ctaHref = '/contact/',
} = Astro.props;
---

<section id="outcomes" class="doc-sheet bg-fu-card py-20 md:py-28" aria-labelledby="outcomes-heading">
  <div class="container-fusion">
    <div class="mx-auto max-w-3xl text-center">
      <p class="tag-marker mb-4">{eyebrow}</p>
      <h2 id="outcomes-heading" class="font-display text-3xl font-bold tracking-tight text-fu-ink md:text-5xl">{heading}</h2>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-fu-muted md:text-lg">{intro}</p>
    </div>

    <div class="mt-12 grid gap-px overflow-hidden rounded-xl border border-fu-line bg-fu-line sm:grid-cols-2 lg:grid-cols-4" aria-label="Engineering signals">
      {metrics.map((metric, index) => (
        <div class="bg-fu-card p-6" data-outcome-metric={index}>
          <p class="font-mono text-3xl font-semibold tracking-tight text-fu-link md:text-4xl">{metric.value}</p>
          <p class="mt-3 font-display text-base font-semibold text-fu-ink">{metric.label}</p>
          <p class="mt-1 text-sm leading-relaxed text-fu-muted">{metric.detail}</p>
        </div>
      ))}
    </div>

    <div class="mt-20 grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
      <div class="lg:sticky lg:top-28">
        <p class="tag-marker mb-4">the friction</p>
        <h3 class="font-display text-2xl font-bold tracking-tight text-fu-ink md:text-3xl">Your team should not have to fight the system.</h3>
        <p class="mt-4 text-sm leading-relaxed text-fu-muted">Start with the business constraint, not a technology shopping list. The right architecture is the one that makes the next decision easier.</p>
        <a href={ctaHref} class="btn-secondary mt-7 inline-flex">Show me the solution <span aria-hidden="true">→</span></a>
      </div>
      <ul class="grid gap-3" aria-label="Common engineering constraints">
        {problems.map((problem, index) => (
          <li class="card flex items-start gap-4 p-5 md:p-6">
            <span class="font-mono text-xs text-fu-link">0{index + 1}</span>
            <span class="text-sm leading-relaxed text-fu-ink md:text-base">{problem}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-24" aria-labelledby="delivery-heading">
      <div class="mb-8 max-w-2xl">
        <p class="tag-marker mb-4">the delivery path</p>
        <h3 id="delivery-heading" class="font-display text-2xl font-bold tracking-tight text-fu-ink md:text-3xl">A system you can understand at every step.</h3>
      </div>
      <ol class="grid gap-3 md:grid-cols-5">
        {['Discover', 'Design', 'Automate', 'Scale', 'Optimize'].map((step, index) => (
          <li class="relative border border-fu-line bg-fu-paper p-5 md:min-h-36">
            <span class="font-mono text-xs text-fu-link">0{index + 1}</span>
            <h4 class="mt-8 font-display text-lg font-semibold text-fu-ink">{step}</h4>
            {index < 4 && <span class="absolute right-4 top-1/2 hidden -translate-y-1/2 text-fu-link md:block" aria-hidden="true">→</span>}
          </li>
        ))}
      </ol>
    </div>

    <div class="mt-24" aria-labelledby="services-heading">
      <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <p class="tag-marker mb-4">outcome-led services</p>
          <h3 id="services-heading" class="font-display text-2xl font-bold tracking-tight text-fu-ink md:text-3xl">The technology is only valuable when the result is clear.</h3>
        </div>
        <a href="/services/" class="font-mono text-xs uppercase tracking-[0.14em] text-fu-link hover:text-fu-link-dark">Explore services →</a>
      </div>
      <div class="grid gap-5 lg:grid-cols-3">
        {outcomes.map((item, index) => (
          <article class="card flex flex-col p-6 md:p-7" data-outcome-service={index}>
            <span class="font-mono text-xs text-fu-link">0{index + 1} · {item.title}</span>
            <div class="mt-7 space-y-4 text-sm leading-relaxed">
              <p><strong class="text-fu-ink">Problem.</strong> <span class="text-fu-muted">{item.problem}</span></p>
              <p><strong class="text-fu-ink">Approach.</strong> <span class="text-fu-muted">{item.solution}</span></p>
              <p class="border-t border-fu-line pt-4"><strong class="text-fu-link">Outcome.</strong> <span class="text-fu-ink">{item.outcome}</span></p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="mt-24 grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="tag-marker mb-4">architecture, made visible</p>
        <h3 class="font-display text-2xl font-bold tracking-tight text-fu-ink md:text-3xl">A clear route from a user request to a useful result.</h3>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-fu-muted">Good architecture is a business communication tool. It shows where traffic flows, where decisions happen, and where resilience is designed in.</p>
      </div>
      <div class="rounded-xl border border-fu-line bg-fu-ink p-5 text-fu-paper md:p-6" aria-label="Reference architecture">
        <div class="grid grid-cols-2 gap-2 text-center font-mono text-[0.65rem] uppercase tracking-[0.12em] sm:grid-cols-4">
          {['Users', 'Edge', 'Platform', 'Data + AI'].map((node, index) => (
            <div class="flex items-center gap-2">
              <span class="flex-1 rounded-md border border-fu-paper/20 px-2 py-3 text-fu-paper/90">{node}</span>
              {index < 3 && <span class="hidden text-fu-mark sm:block" aria-hidden="true">→</span>}
            </div>
          ))}
        </div>
        <p class="mt-5 border-t border-fu-paper/15 pt-4 text-center text-xs leading-relaxed text-fu-paper/65">Cloudflare · load balancing · Kubernetes · services · databases · secure AI workflows</p>
      </div>
    </div>

    <div class="mt-24 grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start" x-data="{ engineers: 8, hours: 4, rate: 85, get annual() { return Math.round(this.engineers * this.hours * this.rate * 52); } }">
      <div>
        <p class="tag-marker mb-4">illustrative ROI model</p>
        <h3 class="font-display text-2xl font-bold tracking-tight text-fu-ink md:text-3xl">Make the cost of friction visible.</h3>
        <p class="mt-4 text-sm leading-relaxed text-fu-muted">A directional estimate, not a promise. Use it to frame a better conversation about repetitive work and where automation could pay back.</p>
      </div>
      <div class="card p-6 md:p-8" data-roi-model>
        <div class="grid gap-5 sm:grid-cols-3">
          <label class="text-sm text-fu-muted">People affected<input class="input-field mt-2" type="number" min="1" max="500" x-model.number="engineers" /></label>
          <label class="text-sm text-fu-muted">Hours lost / week<input class="input-field mt-2" type="number" min="1" max="80" x-model.number="hours" /></label>
          <label class="text-sm text-fu-muted">Hourly rate (USD)<input class="input-field mt-2" type="number" min="1" max="1000" x-model.number="rate" /></label>
        </div>
        <div class="mt-7 border-t border-fu-line pt-6">
          <p class="font-mono text-xs uppercase tracking-[0.14em] text-fu-muted">illustrative annual recovered labor value</p>
          <p class="mt-2 font-display text-4xl font-bold text-fu-link" data-roi-output x-text="`$${annual.toLocaleString()}`">$141,440</p>
          <p class="mt-2 text-xs text-fu-muted">USD estimate from the inputs above × 52 weeks — not a guaranteed saving. Validate the assumptions with your team.</p>
        </div>
      </div>
    </div>

    <div class="mt-24 grid gap-3 md:grid-cols-2" aria-label="Common questions">
      {[
        ['Can you work with our existing infrastructure?', 'Yes. Start with what is already running; improve the constraints that matter before introducing a new platform.'],
        ['How long does an engagement take?', 'The first step is a focused assessment. The delivery plan then separates quick wins from deeper platform work.'],
        ['How do you secure AI workflows?', 'Use least privilege, explicit data boundaries, audit trails, human approval, and provider controls appropriate to the workload.'],
        ['Do you provide ongoing support?', 'Support can include observability, release confidence, cost reviews, and a clear operating handoff to your team.'],
      ].map(([question, answer]) => (
        <details class="group rounded-lg border border-fu-line bg-fu-card p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display font-semibold text-fu-ink">{question}<span class="text-fu-link transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-fu-muted">{answer}</p>
        </details>
      ))}
    </div>

    <div class="mt-16 flex flex-col items-start justify-between gap-5 rounded-xl border border-fu-link/30 bg-fu-link/5 p-6 md:flex-row md:items-center md:p-8">      <div><p class="tag-marker mb-2">next step</p><h3 class="font-display text-xl font-semibold text-fu-ink">Ready to reduce friction and scale with confidence?</h3><p class="mt-2 text-sm text-fu-muted">Bring one constraint. Leave with a clearer assessment path.</p></div><a href="/contact/?topic=infrastructure-and-ai-assessment" data-assessment-cta class="btn-primary shrink-0">Get my free assessment <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

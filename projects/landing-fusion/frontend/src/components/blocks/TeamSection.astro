---
import Skeleton from '@/components/ui/Skeleton.astro';

interface TeamMember {
  name: string;
  role: string;
  image?: string;
  initials: string;
  bio?: string;
  links?: { platform: string; url: string; label: string }[];
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  members: TeamMember[];
}

const { eyebrow, title = 'The team', description, members } = Astro.props;
---

<section class="team">
  <div data-hydrate-skeleton>
    <Skeleton variant="team-grid" />
  </div>
  <div data-hydrate-content>
    <div class="container-fusion">
      <div class="team__header">
        {eyebrow && <p class="tag-marker mb-4 reveal" x-data x-intersect="$el.classList.add('reveal-visible')" x-cloak>{eyebrow}</p>}
        <h2 class="page-section__title reveal" x-data x-intersect="$el.classList.add('reveal-visible')">{title}</h2>
        {description && <p class="mt-3 sm:mt-4 text-fu-muted reveal" x-data x-intersect="$el.classList.add('reveal-visible')" style="transition-delay: 50ms">{description}</p>}
      </div>

      <div class="team__grid">
        {members.map((member, i) => (
          <div
            class="team__card"
            x-data x-intersect="$el.classList.add('reveal-visible')"
            style={`transition-delay: ${i * 75}ms`}
          >
            <div class="team__avatar">
              {member.image ? (
                <img src={member.image} alt={member.name} class="h-full w-full rounded-full object-cover" loading="lazy" />
              ) : (
                <span class="font-display text-lg sm:text-xl font-bold">{member.initials}</span>
              )}
            </div>

            <h3 class="team__name">{member.name}</h3>
            <p class="team__role">{member.role}</p>

            {member.bio && <p class="team__bio">{member.bio}</p>}

            {member.links && member.links.length > 0 && (
              <div class="team__links">
                    {link.platform === 'github' && (
                      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                    )}
                    {link.platform === 'linkedin' && (
                      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    )}
                    {link.platform === 'website' && (
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6v6m-9 3l9-9"/></svg>
                    )}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

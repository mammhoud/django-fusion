---
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import LanguageSwitcher from '@/components/ui/LanguageSwitcher.astro';

interface NavChild {
  label: string;
  href: string;
  active?: boolean;
}

interface NavLink {
  label: string;
  href: string;
  active?: boolean;
  external?: boolean;
  /** Dropdown subpages (live Wagtail children) — hover menu on desktop. */
  children?: NavChild[];
}

interface Props {
  siteName?: string;
  /** Backend-fetched nav items (from /apis/navigation/). Falls back to a sensible default. */
  navItems?: NavLink[];
}

const { siteName = 'Structa Cloud', navItems } = Astro.props;

const pathname = Astro.url.pathname;
const navTranslationKey = (href: string) => {
  const path = href.split('#')[0].replace(/\/$/, '') || '/';
  const keys: Record<string, string> = {
    '/': 'nav_home', '/services': 'nav_services', '/products': 'nav_products',
    '/blog': 'nav_blog', '/pricing': 'nav_pricing', '/about': 'nav_about',
    '/contact': 'nav_contact', '/faq': 'nav_faq', '/brand': 'nav_brand',
    '/features': 'nav_features',
  };
  return keys[path];
};

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  if (href.startsWith('/#')) return pathname === '/' || pathname === '/index';
  return pathname.startsWith(href.split('#')[0]);
};

const displayNav = navItems && navItems.length > 0
  ? navItems
  : [
    { label: 'Home', href: '/' },
    { label: 'Services', href: '/services/' },
    { label: 'Products', href: '/products/' },
    { label: 'Blog', href: '/blog/' },
    { label: 'Pricing', href: '/pricing/' },
    { label: 'About', href: '/about/' },
    { label: 'Contact', href: '/contact/' },
  ];
---

<header
  class="sticky top-0 z-50 border-b border-fu-line backdrop-blur-md transition ease-[var(--fu-ease-out)] duration-300 motion-reduce:transition-none"
  x-data="{ open: false, scrolled: false, authed: false, user: null, authLoading: true,
    async checkAuth() {
      try {
        const res = await fetch('/apis/auth/status/', { credentials: 'include', headers: { Accept: 'application/json' } });
        if (res.ok) {
          const data = await res.json();
          this.authed = data.authenticated;
          this.user = data.user;
        }
      } catch (e) { /* offline or backend down — stay logged-out */ }
      finally { this.authLoading = false; }
    },
    async logout() {
      try {
        await fetch(window.__FUSION_AUTH?.session || '/api/auth/browser/v1/auth/session', {
          method: 'DELETE', credentials: 'include',
          headers: { Accept: 'application/json' },
        });
      } catch (e) { /* best-effort */ }
      window.location.href = '/';
    },
    userInitial() { return this.user?.display?.[0]?.toUpperCase() || '?'; },
    init() { this.checkAuth(); },
  }"
  x-bind:style="scrolled
    ? 'background-color: hsl(var(--fu-paper) / 0.98); box-shadow: 0 1px 0 hsl(var(--fu-line) / 0.6), 0 14px 36px -20px hsl(var(--fu-ink) / 0.45);'
    : 'background-color: hsl(var(--fu-paper) / 0.92); box-shadow: 0 1px 0 hsl(var(--fu-line) / 0.6), 0 12px 32px -24px hsl(var(--fu-ink) / 0.4)'"
  @fusion:header-scrolled.window="scrolled = $event.detail.scrolled"
>
  <div class="container-fusion">
    <div class="flex h-16 items-center justify-between">
      <!-- Wordmark: angle-bracket logo for Structa Cloud -->
      <a href="/" class="flex items-center gap-2.5 font-mono text-[0.95rem] font-semibold tracking-tight text-fu-ink" aria-label={siteName}>
        <svg class="h-7 w-7" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect width="32" height="32" rx="6" fill="#1A1917"/>
          <path d="M12 8L6 14l6 6" stroke="#0B57D0" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M20 8l6 6-6 6" stroke="#0B57D0" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M18 6l-4 20" stroke="#FFE14D" stroke-width="2.2" fill="none" stroke-linecap="round"/>
        </svg>
        <span>{siteName}</span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden items-center gap-7 md:flex" aria-label="Main">
        {displayNav.map((link) => {
          const active = isActive(link.href);
          const hasChildren = !!(link.children && link.children.length > 0);
          return (
            <div
              class="relative"
              x-data="{
                open: false,
                hoverTimer: null as ReturnType<typeof setTimeout> | null,
                openSoon() { this.cancelClose(); this.hoverTimer = setTimeout(() => { this.open = true; }, 120); },
                cancelClose() { if (this.hoverTimer) { clearTimeout(this.hoverTimer); this.hoverTimer = null; } },
                closeSoon() { this.cancelClose(); this.hoverTimer = setTimeout(() => { this.open = false; }, 180); },
                toggle(e) { this.cancelClose(); this.open = !this.open; if (this.open && e) { e.preventDefault(); } },
                close() { this.cancelClose(); this.open = false; },
              }"
              @mouseenter="openSoon()"
              @mouseleave="closeSoon()"
              @focusin="openSoon()"
              @focusout="closeSoon()"
              @click.outside="close()"
              @keydown.escape.window="open = false"
            >
              <a
                href={link.href}
                class:list={[
                  'nav-link flex items-center gap-1 text-[0.9rem]',
                  active ? 'nav-link--active font-medium text-fu-ink' : 'text-fu-muted hover:text-fu-ink',
                ]}
                aria-haspopup={hasChildren ? 'true' : undefined}
                x-bind:aria-expanded={hasChildren ? 'open.toString()' : undefined}
                @click="toggle($event)"
              >
                <span data-i18n={navTranslationKey(link.href)}>{link.label}</span>
                {hasChildren && (
                  <svg class="h-3 w-3 text-fu-muted transition-transform duration-200" :class="open && 'rotate-180'" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                )}
              </a>
              {hasChildren && (
                <div
                  x-show="open"
                  x-cloak
                  x-transition:enter="transition ease-out duration-150"
                  x-transition:enter-start="opacity-0 translate-y-1"
                  x-transition:enter-end="opacity-100 translate-y-0"
                  x-transition:leave="transition ease-in duration-100"
                  x-transition:leave-start="opacity-100"
                  x-transition:leave-end="opacity-0"
                  class="absolute left-0 top-full z-40 pt-2"
                  @mouseenter="cancelClose()"
                  @mouseleave="closeSoon()"
                >
                  <div class="min-w-[13rem] rounded-xl border border-fu-line bg-fu-paper p-1.5 shadow-xl">
                    {link.children!.map((child) => (
                      <a
                        href={child.href}
                        @click="close()"
                        class:list={[
                          'flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-[0.85rem] transition-colors',
                          child.active ? 'bg-fu-line/40 font-medium text-fu-ink' : 'text-fu-muted hover:bg-fu-card hover:text-fu-ink',
                        ]}
                      >
                        <span>{child.label}</span>
                        {child.active && <span class="text-fu-link" aria-hidden="true">✓</span>}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </nav>

      <!-- CTA + Theme toggle (desktop) -->
      <div class="hidden items-center gap-3 md:flex">
        <span class="status-line mr-1 hidden lg:inline-flex"><span class="dot" aria-hidden="true"></span><span data-i18n="status_online">online</span></span>
        <LanguageSwitcher />
        <ThemeToggle />
        <!-- Logged out: Log In + Get Started -->
        <template x-if="!authLoading && !authed">
          <div class="flex items-center gap-3">
            <button type="button" class="btn-secondary !h-9 !px-4 !py-0 text-[0.85rem]" @click="$dispatch('fusion:open-login')">            <span data-i18n="nav_login">Log In</span></button>
            <a href="/contact/" class="btn-primary !h-9 !px-4 !py-0 text-[0.85rem]" data-i18n="nav_get_started">Get Started</a>
          </div>
        </template>
        <!-- Logged in: user dropdown -->
        <template x-if="!authLoading && authed">
          <div class="relative" x-data="{ userMenu: false }" @keydown.escape.window="userMenu = false">
            <button type="button"
              class="flex items-center gap-2 rounded-full border border-fu-line bg-fu-card px-3 py-1.5 text-sm font-medium text-fu-ink transition-all hover:border-fu-link/50 hover:shadow-sm"
              @click="userMenu = !userMenu"
              aria-haspopup="true"
              :aria-expanded="userMenu.toString()">
              <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-fu-link text-xs font-bold text-white" x-text="userInitial()"></span>
              <span class="hidden lg:inline max-w-[120px] truncate" x-text="user?.display"></span>
              <svg class="h-3.5 w-3.5 text-fu-muted transition-transform" :class="userMenu && 'rotate-180'" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div x-show="userMenu" x-cloak
              x-transition:enter="transition ease-out duration-150"
              x-transition:enter-start="opacity-0 scale-95 -translate-y-1"
              x-transition:enter-end="opacity-100 scale-100 translate-y-0"
              x-transition:leave="transition ease-in duration-100"
              x-transition:leave-start="opacity-100"
              x-transition:leave-end="opacity-0"
              @click.self="userMenu = false"
              class="absolute right-0 mt-2 w-56 rounded-xl border border-fu-line bg-fu-paper p-2 shadow-xl">
              <div class="border-b border-fu-line px-3 pb-2.5 pt-1.5">
                <p class="text-sm font-medium text-fu-ink" x-text="user?.display"></p>
                <p class="text-xs text-fu-muted truncate" x-text="user?.email"></p>
              </div>
              <div class="mt-1.5 space-y-0.5">
                <a href="/profile" @click="userMenu = false" class="flex items-center gap-2.5 rounded-md px-3 py-2 text-sm text-fu-ink transition-colors hover:bg-fu-card hover:text-fu-link">
                  <svg class="h-4 w-4 text-fu-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                  <span data-i18n="nav_profile">Profile</span>
                </a>
                <a href="/learning/dashboard/" @click="userMenu = false" class="flex items-center gap-2.5 rounded-md px-3 py-2 text-sm text-fu-ink transition-colors hover:bg-fu-card hover:text-fu-link">
                  <svg class="h-4 w-4 text-fu-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19.5A2.5 2.5 0 016.5 17H20M4 19.5A2.5 2.5 0 014 17V5a2.5 2.5 0 012.5-2.5H20v17H6.5A2.5 2.5 0 014 19.5z"/></svg>
                  <span>Learning dashboard</span>
                </a>
                <a href="/accounts/email/" @click="userMenu = false" class="flex items-center gap-2.5 rounded-md px-3 py-2 text-sm text-fu-ink transition-colors hover:bg-fu-card hover:text-fu-link">
                  <svg class="h-4 w-4 text-fu-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  <span data-i18n="profile_email_addresses">Email addresses</span>
                </a>
                <a href="/accounts/password/change/" @click="userMenu = false" class="flex items-center gap-2.5 rounded-md px-3 py-2 text-sm text-fu-ink transition-colors hover:bg-fu-card hover:text-fu-link">
                  <svg class="h-4 w-4 text-fu-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                  <span data-i18n="profile_change_password">Change password</span>
                </a>
                <a href="/accounts/2fa/" @click="userMenu = false" class="flex items-center gap-2.5 rounded-md px-3 py-2 text-sm text-fu-ink transition-colors hover:bg-fu-card hover:text-fu-link">
                  <svg class="h-4 w-4 text-fu-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                  <span data-i18n="profile_security_mfa">Security &amp; MFA</span>
                </a>
              </div>
              <hr class="my-1.5 border-fu-line" />
              <button type="button" @click="userMenu = false; logout()" class="flex w-full items-center gap-2.5 rounded-md px-3 py-2 text-sm text-red-500 transition-colors hover:bg-red-50">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                <span data-i18n="nav_sign_out">Sign out</span>
              </button>
            </div>
          </div>
        </template>
        <!-- Loading: subtle placeholder -->
        <template x-if="authLoading">
          <span class="inline-block h-4 w-16 animate-fusion-pulse rounded bg-fu-line/60"></span>
        </template>
      </div>

      <!-- Mobile controls: theme toggle + menu button -->
      <div class="flex items-center gap-2 md:hidden">
        <ThemeToggle />
        <button
          type="button"
          class="flex h-10 w-10 items-center justify-center rounded-md text-fu-ink transition-colors hover:bg-fu-line/40"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          :aria-expanded="open.toString()"
          @click="open = !open"
        >
          <svg x-show="!open" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg x-show="open" x-cloak class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div x-show="open" x-cloak x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0 -translate-y-2"
       x-transition:enter-end="opacity-100 translate-y-0"
       x-transition:leave="transition ease-in duration-150"
       x-transition:leave-start="opacity-100 translate-y-0"
       x-transition:leave-end="opacity-0 -translate-y-2"
       class="border-t border-fu-line bg-fu-paper md:hidden">
    <nav class="container-fusion space-y-1 py-4" aria-label="Mobile">
      {displayNav.map((link) => {
        const active = isActive(link.href);
        const hasChildren = !!(link.children && link.children.length > 0);
        return (
          <div x-data="{ sub: false }">
            <a
              href={link.href}
              @click="open = false"
              class:list={[
                'flex items-center justify-between rounded-md px-3 py-2 text-[0.9rem] transition-colors',
                active
                  ? 'bg-fu-line/40 font-medium text-fu-ink'
                  : 'text-fu-muted hover:bg-fu-line/30 hover:text-fu-ink',
              ]}
            >
              <span data-i18n={navTranslationKey(link.href)}>{link.label}</span>
              {hasChildren && (
                <svg class="h-3.5 w-3.5 text-fu-muted transition-transform duration-200" :class="sub && 'rotate-180'" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true" @click.stop.prevent="sub = !sub">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              )}
            </a>
            {hasChildren && (
              <div x-show="sub" x-cloak x-collapse class="ml-3 mt-1 space-y-1 border-l border-fu-line pl-3">
                {link.children!.map((child) => (
                  <a
                    href={child.href}
                    @click="open = false"
                    class:list={[
                      'block rounded-md px-3 py-2 text-[0.85rem] transition-colors',
                      child.active ? 'text-fu-link font-medium' : 'text-fu-muted hover:bg-fu-line/30 hover:text-fu-ink',
                    ]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        );
      })}
      <hr class="my-2 border-fu-line" />
      <template x-if="!authed">
        <div>
          <button type="button" @click="open = false; $dispatch('fusion:open-login')" class="btn-secondary mt-2 w-full"><span data-i18n="nav_login">Log In</span></button>
          <a href="/contact/" @click="open = false" class="btn-primary mt-2 w-full" data-i18n="nav_get_started">Get Started</a>
        </div>
      </template>
      <template x-if="authed">
        <div>
          <div class="flex items-center gap-3 px-3 py-2">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-fu-link text-xs font-bold text-white" x-text="userInitial()"></span>
            <div>
              <p class="text-sm font-medium text-fu-ink" x-text="user?.display"></p>
              <p class="text-xs text-fu-muted" x-text="user?.email"></p>
            </div>
          </div>
          <a href="/profile" @click="open = false" class="block rounded-md px-3 py-2 text-sm text-fu-ink hover:bg-fu-card"><span data-i18n="nav_profile">Profile</span></a>
          <a href="/learning/dashboard/" @click="open = false" class="block rounded-md px-3 py-2 text-sm text-fu-ink hover:bg-fu-card">Learning dashboard</a>
          <a href="/accounts/email/" @click="open = false" class="block rounded-md px-3 py-2 text-sm text-fu-ink hover:bg-fu-card"><span data-i18n="profile_email_addresses">Email addresses</span></a>
          <a href="/accounts/password/change/" @click="open = false" class="block rounded-md px-3 py-2 text-sm text-fu-ink hover:bg-fu-card"><span data-i18n="profile_change_password">Change password</span></a>
          <a href="/accounts/2fa/" @click="open = false" class="block rounded-md px-3 py-2 text-sm text-fu-ink hover:bg-fu-card"><span data-i18n="profile_security_mfa">Security &amp; MFA</span></a>
          <button type="button" @click="open = false; logout()" class="mt-1 block w-full rounded-md px-3 py-2 text-left text-sm text-red-500 hover:bg-red-50"><span data-i18n="nav_sign_out">Sign out</span></button>
        </div>
      </template>
    </nav>
  </div>
</header>

---
import Layout from '@/layouts/Layout.astro';

const sections = [
  {
    heading: '1. Information we collect',
    body: 'We collect information you provide directly, such as your name, email address, and account details, as well as usage data like pages visited and course progress. We never sell your personal information to third parties.',
  },
  {
    heading: '2. How we use your information',
    body: 'Your information is used to operate and improve the platform, personalize your learning experience, process payments, send service communications, and respond to support requests.',
  },
  {
    heading: '3. Cookies and tracking',
    body: 'We use essential cookies to keep you signed in (django-allauth sessions) and to remember your language preference. Optional analytics cookies help us understand aggregate usage — you can disable them in your browser settings.',
  },
  {
    heading: '4. Data sharing',
    body: 'We share data only with trusted service providers that help us operate the platform (hosting, payments, email delivery), under strict data-processing agreements, and when required by law.',
  },
  {
    heading: '5. Data retention',
    body: 'We retain your data only as long as necessary to provide the service or as required by law. You may request deletion of your account and associated data at any time by contacting support.',
  },
  {
    heading: '6. Your rights',
    body: 'Depending on your jurisdiction, you may have rights to access, correct, or delete your personal data, and to object to or restrict certain processing. Contact us to exercise these rights.',
  },
  {
    heading: '7. Contact',
    body: 'For privacy questions, email structa.cloud@gmail.com or write to 123 Fusion Lane, Suite 400. We respond to all privacy requests within 30 days.',
  },
];
---

<Layout
  title="Privacy Policy"
  description="How Fusion CMS collects, uses, and protects your personal information."
>
  <section class="bg-fu-paper py-16">
    <div class="container-fusion">
      <div class="mx-auto max-w-3xl">
        <div class="mb-12 text-center">
          <p class="tag-marker mb-4">legal</p>
          <h1 class="mb-4 font-display text-4xl font-bold tracking-tight text-fu-ink">Privacy Policy</h1>
          <p class="font-mono text-[0.78rem] uppercase tracking-wider text-fu-muted">Last updated: August 3, 2026</p>
        </div>

        <div class="card space-y-10 p-8 md:p-12">
          {sections.map((section) => (
            <section>
              <h2 class="mb-3 font-display text-xl font-semibold text-fu-ink">{section.heading}</h2>
              <div class="prose-fusion">
                <p>{section.body}</p>
              </div>
            </section>
          ))}
        </div>

        <div class="mt-8 text-center">
          <a href="/" class="font-medium text-fu-link transition-colors hover:text-fu-link-dark">
            &larr; Back to Home
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import FAQ from '@/components/blocks/FAQ.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
---

<Layout
  title="FAQ"
  description="Answers to the most common questions about the Fusion platform, billing and the AHA stack."
>
  <!-- Hero -->
  <section class="section-hero reg-marks overflow-hidden py-16">
    <div class="container-fusion">
      <div class="mx-auto max-w-2xl text-center">
        <p class="tag-marker mb-5">help</p>
        <h1 class="mb-4 font-display text-4xl font-bold tracking-tight md:text-5xl">Frequently Asked Questions</h1>
        <p class="text-lg text-fu-muted">
          Can&apos;t find what you&apos;re looking for? <a href="/contact" class="font-medium text-fu-link underline underline-offset-2 hover:text-fu-link-dark">Contact support</a>.
        </p>
      </div>
    </div>
  </section>

  <FAQ heading="" intro="" searchable={true} />

  <CTA heading="Still have questions?" intro="Our team is happy to help you get started." ctaLabel="Contact Support" ctaHref="/contact" />
  <Toast />
</Layout>

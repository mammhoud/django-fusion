---
import Layout from '@/layouts/Layout.astro';
import FAQ from '@/components/blocks/FAQ.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import ContentError from '@/components/ui/ContentError.astro';
import ProductLogo from '@/components/ui/ProductLogo.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData, cachedPricing } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData, PricingData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
let pricingData: PricingData | undefined;
try {
  [siteSettings, navData, pageData, pricingData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('faq'), cachedPricing(),
  ]);
} catch { /* use fallbacks */ }

const pageCta = pageData?.cta;
const pageFaq = (pageData?.faq as any[] | undefined);

const faqItems = pageFaq?.map((f: any) => ({
  question: String(f.question || ''),
  answer: String(f.answer || ''),
}));

// Product tabs: one tab per live product plus a "General" tab.
const products = pricingData?.products ?? [];
const productTabs = [
  { slug: 'general', title: 'General', logo: null },
  ...products.map((p) => ({ slug: p.slug, title: p.title, logo: p.logo_style })),
];

// Categorise FAQ items: any item whose question or answer mentions a product
// slug gets grouped under that product; everything else is "general".
function categoriseFaq(items: { question: string; answer: string }[]) {
  const groups: Record<string, { question: string; answer: string }[]> = { general: [] };
  for (const tab of productTabs) {
    if (tab.slug !== 'general') groups[tab.slug] = [];
  }
  for (const item of items) {
    const lower = `${item.question} ${item.answer}`.toLowerCase();
    let matched = false;
    for (const tab of productTabs) {
      if (tab.slug !== 'general' && lower.includes(tab.slug)) {
        groups[tab.slug].push(item);
        matched = true;
        break;
      }
    }
    if (!matched) groups.general.push(item);
  }
  return groups;
}

const faqGroups = faqItems?.length ? categoriseFaq(faqItems) : null;
const defaultSlug = productTabs[0]?.slug || 'general';
---

<Layout title={pageData?.title || 'FAQ'} description={pageData?.search_description || 'Frequently asked questions about structa.cloud, django-fusion, ceptor-ai, and the AHA stack.'} navItems={navData?.nav_items} siteSettings={siteSettings} pageData={pageData} pageSlug="faq">
  <section class='section-hero reg-marks overflow-hidden py-16'>
    <div class='container-fusion'>
      <div class='mx-auto max-w-2xl text-center'>
        <p class='tag-marker mb-5'>faq</p>
        <h1 class='mb-4 font-display text-4xl font-bold tracking-tight md:text-5xl'>Frequently asked questions</h1>
        <p class='text-lg text-fu-muted'>The honest answers to the questions technical buyers ask: the stack, the products, the editions, and the fine print.</p>
      </div>
    </div>
  </section>

  {faqGroups ? (
  <section class='doc-sheet bg-fu-paper py-16 md:py-20'>
    <div class='container-fusion'>
      <div x-data={`{ active: '${defaultSlug}' }`} class="mx-auto max-w-3xl">
        <!-- Product tabs -->
        <div class='pricing-tabs mb-12 justify-center' role='tablist' aria-label='FAQ categories'>
          {productTabs.map((tab) => (
            <button
              type='button'
              class='pricing-tab'
              role='tab'
              aria-selected={tab.slug === defaultSlug}
              :aria-selected={`active === '${tab.slug}'`}
              @click={`active = '${tab.slug}'`}
            >
              {tab.logo ? <span class="product-logo"><ProductLogo style={tab.logo} /></span> : null}
              {tab.title}
              <span class='font-mono text-[0.62rem] text-fu-muted'>
                ({faqGroups[tab.slug]?.length || 0})
              </span>
            </button>
          ))}
        </div>

        <!-- FAQ panels per tab -->
        {productTabs.map((tab) => {
          const items = faqGroups[tab.slug] || [];
          return (
            <div
              role='tabpanel'
              aria-hidden={tab.slug !== defaultSlug}
              :aria-hidden={`active !== '${tab.slug}'`}
              x-show={`active === '${tab.slug}'`}
              x-cloak
            >
              {items.length ? (
                <FAQ items={items} heading={tab.title} searchable={true} />
              ) : (
                <div class='py-12 text-center'>
                  <p class='text-fu-muted'>No questions yet for {tab.title}. <a href='/contact' class='font-medium text-fu-link hover:text-fu-ink'>Ask us one</a>.</p>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </section>
  ) : (
    <div class='py-14'>
      {faqItems?.length ? <FAQ items={faqItems} /> : <ContentError label="FAQ data unavailable" />}
    </div>
  )}

  <CTA heading={pageCta?.title || 'Still have questions?'} intro={pageCta?.subtitle || "Reach out through the contact form or open an issue on GitHub."} ctaLabel={pageCta?.primary_cta?.label || 'Contact us'} ctaHref={pageCta?.primary_cta?.href || '/contact'} />
  <Toast />
</Layout>

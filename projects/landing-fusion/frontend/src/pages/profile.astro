---
import Layout from '@/layouts/Layout.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation } from '@/lib/api';
import type { SiteSettings, NavigationData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
try {
  [siteSettings, navData] = await Promise.all([cachedSiteSettings(), cachedNavigation()]);
} catch { /* use fallbacks */ }
---

<Layout
  title="Profile"
  description="Your structa.cloud account: email addresses, security settings, social connections, and API keys."
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageSlug="profile"
>
  <section class="section-hero reg-marks overflow-hidden py-16">
    <div class="container-fusion">
      <div class="mx-auto max-w-2xl">
        <p class="tag-marker mb-4">account</p>
        <h1 class="mb-4 font-display text-4xl font-bold tracking-tight md:text-5xl">Profile</h1>
        <p class="text-fu-muted">Manage your account, email addresses, security settings, and social connections.</p>
      </div>
    </div>
  </section>

  <!-- Auth-gated content: the Astro build renders the static shell; the Alpine
       client fetches session state and shows the correct panel. -->
  <section class="py-14">
    <div class="container-fusion">
      <div
        client:load
        class="mx-auto max-w-3xl"
        x-data="{
          authed: false,
          user: null as { email: string; display: string } | null,
          loading: true,
          async init() {
            try {
              const res = await fetch('/apis/auth/status/', { credentials: 'include', headers: { Accept: 'application/json' } });
              if (res.ok) {
                const data = await res.json();
                this.authed = data.authenticated;
                this.user = data.user;
              }
            } catch (e) { /* offline */ }
            finally { this.loading = false; }
          },
        }"
      >
        <!-- Loading state -->
        <template x-if="loading">
          <div class="space-y-5">
            <div class="card p-8 animate-fusion-pulse">
              <div class="flex items-center gap-4">
                <span class="h-14 w-14 rounded-full bg-fu-line/60"></span>
                <div class="space-y-2">
                  <span class="block h-5 w-32 rounded bg-fu-line/60"></span>
                  <span class="block h-4 w-48 rounded bg-fu-line/40"></span>
                </div>
              </div>
            </div>
            <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
              {[1,2,3,4].map(() => (
                <div class="card p-6 animate-fusion-pulse">
                  <span class="block h-4 w-24 rounded bg-fu-line/60 mb-3"></span>
                  <span class="block h-8 w-full rounded bg-fu-line/40"></span>
                </div>
              ))}
            </div>
          </div>
        </template>

        <!-- Not authenticated -->
        <template x-if="!loading && !authed">
          <div class="card p-10 text-center">
            <div class="mx-auto mb-5 inline-flex h-14 w-14 items-center justify-center rounded-full border border-fu-line bg-fu-card text-fu-muted">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <h2 class="mb-2 font-display text-xl font-semibold text-fu-ink">Sign in to view your profile</h2>
            <p class="mb-6 text-sm text-fu-muted">You need to be signed in to access account settings, email management, and security options.</p>
            <div class="flex items-center justify-center gap-3">
              <button type="button" class="btn-primary" @click="$dispatch('fusion:open-login')">Sign in</button>
              <a href="/accounts/signup/" class="btn-secondary">Create account</a>
            </div>
          </div>
        </template>

        <!-- Authenticated: profile dashboard -->
        <template x-if="!loading && authed">
          <div class="space-y-8">
            <!-- User card -->
            <div class="card p-6 sm:p-8">
              <div class="flex flex-wrap items-center gap-4">
                <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-fu-link text-lg font-bold text-white" x-text="user?.display?.[0]?.toUpperCase() || '?'"></span>
                <div>
                  <h2 class="font-display text-xl font-semibold text-fu-ink" x-text="user?.display"></h2>
                  <p class="text-sm text-fu-muted" x-text="user?.email"></p>
                </div>
                <a href="/accounts/logout/" class="ml-auto btn-secondary !h-9 !px-4 !py-0 text-[0.85rem]">Sign out</a>
              </div>
            </div>

            <!-- Account management cards -->
            <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
              <!-- Email addresses -->
              <a href="/accounts/email/" class="card group flex items-start gap-4 p-5 transition-all hover:-translate-y-0.5 hover:border-fu-link/40">
                <span class="inline-flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-md border border-fu-line bg-fu-card text-fu-muted transition-colors group-hover:border-fu-link/50 group-hover:text-fu-link">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </span>
                <div>
                  <h3 class="font-display text-[1.05rem] font-semibold text-fu-ink transition-colors group-hover:text-fu-link">Email addresses</h3>
                  <p class="mt-1 text-sm text-fu-muted">Add, remove, or change the email addresses on your account. Set a primary address for notifications.</p>
                </div>
              </a>

              <!-- Change password -->
              <a href="/accounts/password/change/" class="card group flex items-start gap-4 p-5 transition-all hover:-translate-y-0.5 hover:border-fu-link/40">
                <span class="inline-flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-md border border-fu-line bg-fu-card text-fu-muted transition-colors group-hover:border-fu-link/50 group-hover:text-fu-link">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                  </svg>
                </span>
                <div>
                  <h3 class="font-display text-[1.05rem] font-semibold text-fu-ink transition-colors group-hover:text-fu-link">Change password</h3>
                  <p class="mt-1 text-sm text-fu-muted">Update your password. You will need your current password to make changes.</p>
                </div>
              </a>

              <!-- Security & MFA -->
              <a href="/accounts/2fa/" class="card group flex items-start gap-4 p-5 transition-all hover:-translate-y-0.5 hover:border-fu-link/40">
                <span class="inline-flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-md border border-fu-line bg-fu-card text-fu-muted transition-colors group-hover:border-fu-link/50 group-hover:text-fu-link">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                  </svg>
                </span>
                <div>
                  <h3 class="font-display text-[1.05rem] font-semibold text-fu-ink transition-colors group-hover:text-fu-link">Security &amp; MFA</h3>
                  <p class="mt-1 text-sm text-fu-muted">Set up two-factor authentication with TOTP authenticator apps or WebAuthn passkeys.</p>
                </div>
              </a>

              <!-- Social connections -->
              <a href="/accounts/social/connections/" class="card group flex items-start gap-4 p-5 transition-all hover:-translate-y-0.5 hover:border-fu-link/40">
                <span class="inline-flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-md border border-fu-line bg-fu-card text-fu-muted transition-colors group-hover:border-fu-link/50 group-hover:text-fu-link">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 20V10M12 20V4M6 20v-6"/>
                  </svg>
                </span>
                <div>
                  <h3 class="font-display text-[1.05rem] font-semibold text-fu-ink transition-colors group-hover:text-fu-link">Social connections</h3>
                  <p class="mt-1 text-sm text-fu-muted">Connect or disconnect your GitHub and Google accounts for faster sign-in.</p>
                </div>
              </a>
            </div>

            <!-- API Keys info -->
            <div class="card p-6">
              <h3 class="mb-2 font-display text-[1.05rem] font-semibold text-fu-ink">API access</h3>
              <p class="text-sm text-fu-muted">
                Your session uses django-allauth with server-side cookies. For programmatic access,
                use the headless API endpoints at <code class="rounded bg-fu-card px-1.5 py-0.5 font-mono text-[0.8rem] text-fu-link">/api/auth/browser/v1/auth/login</code>.
                Sessions persist across the Astro frontend and Django backend via shared cookies.
              </p>
            </div>
          </div>
        </template>
      </div>
    </div>
  </section>

  <Toast />
</Layout>

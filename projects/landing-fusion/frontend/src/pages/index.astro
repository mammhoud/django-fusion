---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import Stats from '@/components/blocks/Stats.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import ContentError from '@/components/ui/ContentError.astro';
import LiveFragment from '@/components/ui/LiveFragment.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';
import { browserEndpoint } from '@/lib/site';

// The HTMX demo fetches the backend ping fragment — always point at the
// configured backend (Django), never same-origin (the Astro host has no
// /fragment/ping/ route and would 404).
const pingEndpoint = browserEndpoint('/fragment/ping/');
const hasBackend = Boolean(import.meta.env.PUBLIC_FUSION_API_URL || import.meta.env.PUBLIC_BROWSER_API_URL);

// ── Fetch backend-owned content at build time ──
let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;

try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(),
    cachedNavigation(),
    cachedPageData('home'),
  ]);
} catch {
  // Backend unreachable — page-level components render explicit error states.
}

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const pageStats = (pageData?.stats as any[] | undefined);
const pageFeatures = (pageData?.features as any[] | undefined);

// ── Presentation mapping for backend-owned content ──
const techStats = pageStats?.map((s: any) => ({
  label: String(s.label || ''),
  value: Number(s.value || 0),
  suffix: String(s.suffix || ''),
}));

const stackItems = pageFeatures?.map((f: any) => ({
  icon: String(f.icon || 'M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z'),
  title: String(f.title || ''),
  description: String(f.description || ''),
}));

const productCards = (pageData?.products || []).map((product: any) => ({
  name: String(product.title || ''),
  tag: String(product.category || ''),
  description: String(product.excerpt || product.tagline || ''),
  href: String(product.href || `/products/${product.slug}/`),
  icon: String(product.logo_style || ''),
  external: String(product.href || '').startsWith('http'),
}));
---

<Layout
  title={pageData?.title}
  description={pageData?.search_description}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="home"
>
  <Hero
    eyebrow={pageHero?.badge}
    heading={pageHero?.title}
    accent={pageHero?.accent || 'documents'}
    intro={pageHero?.subtitle}
    primaryCta={pageHero?.primary_cta ? { label: pageHero.primary_cta.label, href: pageHero.primary_cta.href } : undefined}
    secondaryCta={pageHero?.secondary_cta ? { label: pageHero.secondary_cta.label, href: pageHero.secondary_cta.href } : undefined}
    status='200 OK · text/html'
    variant='cinematic'
  />

  <!-- Tech Stats — renders only when the backend provides stats (HomePage is a slim page by design) -->
  {techStats?.length ? <Stats stats={techStats} /> : null}

  <!-- The Stack — what runs under the hood (renders only when the backend
       provides features; the home page is a slim page by design) -->
  {stackItems?.length ? (() => {
    const featured = stackItems[0];
    const rest = stackItems.slice(1);
    const lastSpans = rest.length > 0 && rest.length % 2 === 1;
    return (
  <section class='doc-sheet bg-fu-paper py-20 md:py-24'>
    <div class='container-fusion'>
      <div class='mb-14 max-w-2xl'>
        <h2 class='font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>
          {pageFeatures?.[0]?.title || pageData?.title || 'One monorepo, six projects'}
        </h2>
        <p class='mt-3 max-w-xl text-fu-muted'>
          {pageFeatures?.[0]?.description || pageData?.search_description || 'Every site, library, and tool shares one repository, one config, one CI pipeline.'}
        </p>
      </div>

      <div class='grid grid-cols-1 gap-5 md:grid-cols-2'>
        <div
          class='reveal card-gradient group relative flex flex-col gap-5 p-6 md:col-span-2 md:flex-row md:items-center md:gap-8 md:p-8'
          x-data x-intersect='`$el.classList.add("reveal-visible")`'
        >
          <div class='inline-flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-md border border-fu-paper/15 bg-fu-paper/10 text-fu-link'>
            <svg class='h-6 w-6' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='1.8' aria-hidden='true'>
              <path stroke-linecap='round' stroke-linejoin='round' d={featured.icon} />
            </svg>
          </div>
          <div>
            <h3 class='mb-2 font-display text-[1.05rem] font-semibold text-fu-paper'>{featured.title}</h3>
            <p class='text-sm leading-relaxed text-fu-paper/75'>{featured.description}</p>
          </div>
        </div>

        {rest.map((item: any, i: number) => {
          const isLast = i === rest.length - 1;
          return (
            <div
              class:list={[
                'reveal card group relative p-6',
                isLast && lastSpans ? 'md:col-span-2' : '',
              ]}
              x-data x-intersect='`$el.classList.add("reveal-visible")`'
              style={`--reveal-i: ${i + 1}`}
            >
              <div class='mb-4 inline-flex h-10 w-10 items-center justify-center rounded-md border border-fu-line bg-fu-card text-fu-link transition-colors duration-300 group-hover:border-fu-link'>
                <svg class='h-5 w-5' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='1.8' aria-hidden='true'>
                  <path stroke-linecap='round' stroke-linejoin='round' d={item.icon} />
                </svg>
              </div>
              <h3 class='mb-2 font-display text-[1.05rem] font-semibold text-fu-ink'>{item.title}</h3>
              <p class='text-sm leading-relaxed text-fu-muted'>{item.description}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>
    );
  })() : null}

  <!-- Products preview — GSAP-pinned editorial rail: header pins on the
       left while the product rows scroll past it (wide screens). The
       rows also stagger-rise as they enter. -->
  <section id='products' data-gsap='rail' class='doc-sheet bg-fu-paper py-28 md:py-40 overflow-x-hidden'>
    <div class='container-fusion overflow-x-hidden'>
      <div class='grid gap-10 md:grid-cols-12 md:gap-14'>
      <div data-gsap='rail-head' class='md:col-span-4'>
        <p class='tag-marker mb-4'>products</p>
        <h2 class='font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>
          {pageData?.title || 'What we ship'}
        </h2>
        <p class='mt-3 max-w-xl text-fu-muted'>
          {pageData?.search_description || 'Open-source libraries, cloud platforms, and desktop apps from one codebase.'}
        </p>
      </div>

      <div data-gsap='rail-rows' class='md:col-span-8'>
        {productCards.map((product: any, i: number) => (
          <a
            href={product.href}
            target={product.external ? '_blank' : undefined}
            rel={product.external ? 'noopener noreferrer' : undefined}
            class='group grid grid-cols-1 gap-1.5 border-t border-fu-line px-0 py-6 transition-colors duration-300 hover:bg-fu-card md:grid-cols-12 md:items-baseline md:gap-6 md:px-4 md:py-7'
            data-gsap='rail-row'
          >
            <span class='font-display text-xl font-semibold tracking-tight text-fu-ink transition-colors duration-300 group-hover:text-fu-link md:col-span-4 md:text-2xl'>
              {product.name}
              {product.external && (
                <svg class='ml-2 inline h-4 w-4 text-fu-muted' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2' aria-hidden='true'>
                  <path stroke-linecap='round' stroke-linejoin='round' d='M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6v6m-9 3l9-9' />
                </svg>
              )}
            </span>
            <p class='font-mono text-[0.65rem] uppercase tracking-[0.16em] text-fu-muted md:col-span-3'>
              {product.tag}
            </p>
            <p class='text-sm leading-relaxed text-fu-muted md:col-span-4'>
              {product.description}
            </p>
            <span class='hidden items-center justify-end text-fu-muted transition-all duration-300 group-hover:translate-x-0.5 group-hover:text-fu-link md:col-span-1 md:flex' aria-hidden='true'>
              <svg class='h-4 w-4' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2'>
                <path stroke-linecap='round' stroke-linejoin='round' d='M9 5l7 7-7 7'/>
              </svg>
            </span>
          </a>
        ))}
      </div>
      </div>
    </div>
  </section>

  <!-- Framework proof — gapless bento: one tall feature cell (HTMX) + a
       stacked rail (Alpine + theme). grid-flow-dense guarantees no dead
       cells; the cells rise (scale 0.92 -> 1) and dim as they leave. -->
  <section class='doc-sheet bg-fu-paper py-28 md:py-40'>
    <div class='container-fusion'>
      <div class='mb-16 max-w-2xl'>
        <h2 class='font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>
          This page is the framework
        </h2>
        <p data-gsap='scrub' class='mt-3 max-w-xl text-fu-muted'>
          No React, no Vue, no Svelte. Server-rendered HTML with HTMX for dynamic regions and Alpine.js for micro-interactions. Try the demos below.
        </p>
      </div>

      <div class='grid grid-flow-dense grid-cols-1 gap-6 lg:grid-cols-6'>
        <!-- HTMX: Fragment Swap — the tall feature cell -->
        <div data-gsap='rise' class='card flex flex-col p-6 lg:col-span-4 lg:row-span-2'>
          <h3 class='mb-3 font-display text-[1.05rem] font-semibold text-fu-ink'>HTMX: Fragment Swap</h3>
          <p class='mb-4 max-w-md text-sm text-fu-muted'>Click the button. An HTML fragment streams from the backend via HTMX, swapping the content without a page reload.</p>
          <div class='mb-4 flex-1 rounded-md border border-fu-line bg-fu-card p-4 font-mono text-sm' id='htmx-demo-target'>
            <span class='text-fu-muted'>Click &quot;Fetch from server&quot; to see HTMX in action.</span>
          </div>
          {hasBackend ? (
            <button class='btn-secondary w-full' hx-get={pingEndpoint} hx-target='#htmx-demo-target' hx-swap='innerHTML'>
              Fetch from server
            </button>
          ) : (
            <p class='live-fragment__fallback'>Server demo unavailable in this static build.</p>
          )}
        </div>

        <!-- Alpine: Counter -->
        <div data-gsap='rise' class='card flex flex-col p-6 lg:col-span-2' x-data="{ count: 0 }">
          <h3 class='mb-3 font-display text-[1.05rem] font-semibold text-fu-ink'>Alpine.js: Reactive State</h3>
          <p class='mb-4 text-sm text-fu-muted'>A self-contained counter. Zero server calls, zero framework.</p>
          <div class='mt-auto flex items-center justify-center gap-4'>
            <button class='btn-secondary !h-10 !w-10 !p-0' @click='count = Math.max(0, count - 1)' aria-label='Decrement'>−</button>
            <span class='font-mono text-3xl font-bold text-fu-ink tabular-nums' x-text='count'>0</span>
            <button class='btn-secondary !h-10 !w-10 !p-0' @click='count++' aria-label='Increment'>+</button>
          </div>
        </div>

        <!-- Theme persistence -->
        <div data-gsap='rise' class='card flex flex-col p-6 lg:col-span-2' x-data="{ storedTheme: '' }" x-init="storedTheme = localStorage.getItem('fusion-theme') || 'system default'">
          <h3 class='mb-3 font-display text-[1.05rem] font-semibold text-fu-ink'>Theme: localStorage</h3>
          <p class='mb-4 text-sm text-fu-muted'>Your theme preference persists across sessions via localStorage, applied before first paint. No flash, no cookie banner.</p>
          <div class='mt-auto rounded-md border border-fu-line bg-fu-card p-4'>
            <p class='font-mono text-sm'>
              <span class='text-fu-muted'>Current: </span>
              <span class='font-semibold text-fu-link' x-text='storedTheme'>system default</span>
            </p>
            <p class='mt-2 font-mono text-[0.7rem] uppercase tracking-wider text-fu-muted'>
              Toggle via the header theme button
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HTMX → backend: server-rendered fragment replaces this region -->
  {pageData ? <LiveFragment route='/' /> : <ContentError label="Live fragment unavailable" showHomeLink={false} />}

  <CTA
    heading={pageCta?.title}
    intro={pageCta?.subtitle}
    ctaLabel={pageCta?.primary_cta?.label}
    ctaHref={pageCta?.primary_cta?.href}
    secondaryCta={pageCta?.secondary_cta ? { label: pageCta.secondary_cta.label, href: pageCta.secondary_cta.href } : undefined}
  />

  <Toast />
  <HtmxBootstrap />
</Layout>

<script>
  import '../lib/home-motion';
</script>

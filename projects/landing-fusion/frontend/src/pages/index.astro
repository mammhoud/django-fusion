---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import Stats from '@/components/blocks/Stats.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import ContentError from '@/components/ui/ContentError.astro';
import LiveFragment from '@/components/ui/LiveFragment.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import ProductLogo from '@/components/ui/ProductLogo.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData, cachedCourses } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData, CourseCard } from '@/lib/api';

// ── Fetch backend-owned content at build time ──
let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
let coursesData: { courses: CourseCard[] } | undefined;

try {
  [siteSettings, navData, pageData, coursesData] = await Promise.all([
    cachedSiteSettings(),
    cachedNavigation(),
    cachedPageData('home'),
    cachedCourses(),
  ]);
} catch {
  // Backend unreachable — page-level components render explicit error states.
}

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const pageStats = (pageData?.stats as any[] | undefined);
const pageFeatures = (pageData?.features as any[] | undefined);

// ── Presentation mapping for backend-owned content ──
const techStats = pageStats?.map((s: any) => ({
  label: String(s.label || ''),
  value: Number(s.value || 0),
  suffix: String(s.suffix || ''),
}));

const stackItems = pageFeatures?.map((f: any) => ({
  icon: String(f.icon || 'M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z'),
  title: String(f.title || ''),
  description: String(f.description || ''),
}));

// Home preview cards — the backend already curates this list for home
// (subproducts like vResume are excluded via show_on_home), so we render
// every product the API returns as a simple themed card, matching the
// /products/ grid style instead of the old editorial rail.
const productCards = (pageData?.products || []).map((product: any) => ({
  title: String(product.title || ''),
  slug: String(product.slug || ''),
  tag: String(product.category || ''),
  description: String(product.excerpt || product.tagline || ''),
  tagline: String(product.tagline || ''),
  version: String(product.version || ''),
  href: String(product.href || `/products/${product.slug}/`),
  logo_style: String(product.logo_style || ''),
  status: String(product.status || ''),
  editions: Array.isArray(product.editions) ? product.editions : [],
  tech: Array.isArray(product.tech) ? product.tech : [],
  external: String(product.href || '').startsWith('http'),
}));
const courseCards = coursesData?.courses || [];
---

<Layout
  title={pageData?.title}
  description={pageData?.search_description}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="home"
>
  <Hero
    eyebrow={pageHero?.badge}
    heading={pageHero?.title}
    accent={pageHero?.accent || 'documents'}
    intro={pageHero?.subtitle}
    primaryCta={pageHero?.primary_cta ? { label: pageHero.primary_cta.label, href: pageHero.primary_cta.href } : undefined}
    secondaryCta={pageHero?.secondary_cta ? { label: pageHero.secondary_cta.label, href: pageHero.secondary_cta.href } : undefined}
    status='200 OK · text/html'
    variant='cinematic'
  />

  <!-- Optional backend stats — the home keeps the entry experience focused. -->
  {techStats?.length ? <Stats stats={techStats} /> : null}

  <!-- Optional backend feature emphasis — content appears only when seeded. -->
  {stackItems?.length ? (() => {
    const featured = stackItems[0];
    const rest = stackItems.slice(1);
    const lastSpans = rest.length > 0 && rest.length % 2 === 1;
    return (
  <section class='doc-sheet bg-fu-paper py-20 md:py-24'>
    <div class='container-fusion'>
      <div class='mb-14 max-w-2xl'>
        <h2 class='font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>
          {pageFeatures?.[0]?.title || pageData?.title || 'One monorepo, six projects'}
        </h2>
        <p class='mt-3 max-w-xl text-fu-muted'>
          {pageFeatures?.[0]?.description || pageData?.search_description || 'Every site, library, and tool shares one repository, one config, one CI pipeline.'}
        </p>
      </div>

      <div class='grid grid-cols-1 gap-5 md:grid-cols-2'>
        <div
          class='reveal card-gradient group relative flex flex-col gap-5 p-6 md:col-span-2 md:flex-row md:items-center md:gap-8 md:p-8'
          x-data x-intersect='`$el.classList.add("reveal-visible")`'
        >
          <div class='inline-flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-md border border-fu-paper/15 bg-fu-paper/10 text-fu-link'>
            <svg class='h-6 w-6' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='1.8' aria-hidden='true'>
              <path stroke-linecap='round' stroke-linejoin='round' d={featured.icon} />
            </svg>
          </div>
          <div>
            <h3 class='mb-2 font-display text-[1.05rem] font-semibold text-fu-paper'>{featured.title}</h3>
            <p class='text-sm leading-relaxed text-fu-paper/75'>{featured.description}</p>
          </div>
        </div>

        {rest.map((item: any, i: number) => {
          const isLast = i === rest.length - 1;
          return (
            <div
              class:list={[
                'reveal card group relative p-6',
                isLast && lastSpans ? 'md:col-span-2' : '',
              ]}
              x-data x-intersect='`$el.classList.add("reveal-visible")`'
              style={`--reveal-i: ${i + 1}`}
            >
              <div class='mb-4 inline-flex h-10 w-10 items-center justify-center rounded-md border border-fu-line bg-fu-card text-fu-link transition-colors duration-300 group-hover:border-fu-link'>
                <svg class='h-5 w-5' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='1.8' aria-hidden='true'>
                  <path stroke-linecap='round' stroke-linejoin='round' d={item.icon} />
                </svg>
              </div>
              <h3 class='mb-2 font-display text-[1.05rem] font-semibold text-fu-ink'>{item.title}</h3>
              <p class='text-sm leading-relaxed text-fu-muted'>{item.description}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>
    );
  })() : null}

  <!-- Products preview — a simple responsive card grid (the same themed
       cards as /products/, curated by the backend: subproducts like vResume
       never appear here). One column on phones, two on small screens,
       three on wide ones. -->
  <section id='products' class='doc-sheet bg-fu-paper py-20 md:py-28'>
    <div class='container-fusion'>
      <div class='mb-12 max-w-2xl'>
        <p class='tag-marker mb-4'>products</p>
        <h2 class='font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>
          {pageData?.title || 'What we ship'}
        </h2>
        <p class='mt-3 max-w-xl text-fu-muted'>
          {pageData?.search_description || 'Open-source libraries, cloud platforms, and desktop apps from one codebase.'}
        </p>
      </div>

      <div class='grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3'>
        {productCards.map((product: any, i: number) => (
          <a href={product.href} target={product.external ? '_blank' : undefined} rel={product.external ? 'noopener noreferrer' : undefined} class='card reveal group flex flex-col gap-3 p-6 hover:-translate-y-0.5' x-data x-intersect='`$el.classList.add("reveal-visible")`' style={`--reveal-i: ${i}`}>
            <div class='flex items-start justify-between gap-3'>
              <ProductLogo style={product.logo_style} />
              <div class='flex flex-col items-end gap-1.5'>
                <div class='flex items-center gap-1.5'>
                  {product.status === 'development' && <span class='badge-dev'>under development</span>}
                  <button
                    type='button'
                    data-open-brand={product.slug}
                    aria-label={`${product.title} brand kit`}
                    title='Brand kit — the story behind the mark'
                    class='inline-flex h-7 w-7 items-center justify-center rounded-full border border-fu-line bg-fu-card text-fu-muted transition-colors hover:border-fu-link/50 hover:text-fu-link'
                  >
                    <svg class='h-3.5 w-3.5' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2' aria-hidden='true'><circle cx='12' cy='12' r='9'/><path stroke-linecap='round' d='M12 11v5M12 8h.01'/></svg>
                  </button>
                </div>
                <span class='badge badge-primary'>{product.tag || 'product'}</span>
              </div>
            </div>
            <h3 class='font-display text-[1.05rem] font-semibold text-fu-ink transition-colors group-hover:text-fu-link'>{product.title}</h3>
            {product.version && <p class='font-mono text-[0.62rem] uppercase tracking-[0.14em] text-fu-muted'>{product.version}</p>}
            {product.tagline && <p class='text-sm leading-relaxed text-fu-muted'>{product.tagline}</p>}
            {!product.tagline && product.description && <p class='text-sm leading-relaxed text-fu-muted'>{product.description}</p>}
            {product.editions?.length ? (
              <div class='flex flex-wrap gap-1.5'>
                {product.editions.slice(0, 3).map((ed: any) => (
                  <span class='edition-chip'>{ed.name} <strong>{ed.price}</strong></span>
                ))}
                {product.editions.length > 3 && <span class='inline-flex items-center px-1 font-mono text-[0.62rem] text-fu-muted'>+{product.editions.length - 3}</span>}
              </div>
            ) : null}
            <div class='mt-auto flex flex-wrap items-center gap-2 pt-2'>
              <span class='font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-link'>View product →</span>
              {product.tech?.length ? (
                <span class='inline-flex items-center gap-1 rounded-full border border-fu-line bg-fu-card px-2.5 py-0.5 font-mono text-[0.6rem] uppercase tracking-[0.12em] text-fu-muted'>
                  {product.tech[0]}{product.tech.length > 1 ? ` +${product.tech.length - 1}` : ''}
                </span>
              ) : null}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Courses — backend-owned learning paths replace the former framework demo. -->
  <section id='courses' class='doc-sheet bg-fu-paper py-28 md:py-40'>
    <div class='container-fusion'>
      <div class='mb-14 flex flex-col justify-between gap-6 md:flex-row md:items-end'>
        <div class='max-w-2xl'>
          <p class='tag-marker mb-4'>learning</p>
          <h2 class='font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>Learn by shipping.</h2>
          <p class='mt-3 max-w-xl text-fu-muted'>Practical courses for founders, product teams, and builders who want clear progress from the first lesson to a working release.</p>
        </div>
        <a href='/learning/' class='btn-secondary shrink-0'>Browse all courses <span aria-hidden='true'>→</span></a>
      </div>

      {courseCards.length ? (
        <div class='grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3'>
          {courseCards.map((course: CourseCard, i: number) => (
            <article data-gsap='rise' class='card reveal group flex flex-col p-6' x-data x-intersect='`$el.classList.add("reveal-visible")`' style={`--reveal-i: ${i}`}>
              <div class='mb-6 flex items-start justify-between gap-3'>
                <span class='badge badge-primary'>{course.is_free ? 'free access' : `$${course.price}`}</span>
                {course.is_featured && <span class='badge-dev'>featured path</span>}
              </div>
              <h3 class='font-display text-xl font-semibold tracking-tight text-fu-ink transition-colors group-hover:text-fu-link'>
                <a href={course.href}>{course.title}</a>
              </h3>
              <p class='mt-3 flex-1 text-sm leading-relaxed text-fu-muted'>{course.short_description}</p>
              <div class='mt-6 grid grid-cols-2 gap-3 border-y border-fu-line py-4 font-mono text-[0.62rem] uppercase tracking-[0.12em] text-fu-muted'>
                <span><strong class='block text-fu-ink'>{course.lesson_count}</strong> lessons</span>
                <span><strong class='block text-fu-ink'>{course.duration_hours}</strong> hours</span>
              </div>
              <div class='mt-4 flex items-center justify-between gap-3'>
                <span class='text-xs text-fu-muted'>{course.difficulty} · {course.instructor}</span>
                <a href={course.href} class='font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-link'>Open course →</a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class='card p-8 text-center text-sm text-fu-muted'>Courses are being prepared. Check the learning catalog soon.</div>
      )}
    </div>
  </section>

  <!-- HTMX → backend: server-rendered fragment replaces this region -->
  {pageData ? <LiveFragment route='/' /> : <ContentError label="Live fragment unavailable" showHomeLink={false} />}

  <CTA
    heading={pageCta?.title}
    intro={pageCta?.subtitle}
    ctaLabel={pageCta?.primary_cta?.label}
    ctaHref={pageCta?.primary_cta?.href}
    secondaryCta={pageCta?.secondary_cta ? { label: pageCta.secondary_cta.label, href: pageCta.secondary_cta.href } : undefined}
  />

  <Toast />
  <HtmxBootstrap />
</Layout>

<script>
  import '../lib/home-motion';
</script>

---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
>
  <section class="section-hero py-24 md:py-32">
    <div class="container-fusion">
      <div class="mx-auto max-w-2xl text-center">
        <div class="mb-6 text-8xl font-black text-white/20 md:text-9xl">404</div>
        <h1 class="mb-4 text-3xl font-bold text-white md:text-4xl">Page not found</h1>
        <p class="mb-10 text-lg text-white/70">
          The page you&apos;re looking for doesn&apos;t exist or has been moved. Let&apos;s get you back on track.
        </p>
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          <a href="/" class="btn-white !px-8 !py-3.5">Back to Home</a>
          <a href="/contact" class="btn !px-8 !py-3.5 text-white ring-2 ring-inset ring-white/40 hover:bg-white/10">
            Contact Support
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import CTA from '@/components/blocks/CTA.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import ContentError from '@/components/ui/ContentError.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData, fetchPageList } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';

export async function getStaticPaths() {
  const list = await fetchPageList();
  const slugs = list.pages
    .filter((p) => p.type === 'BlogPostPage')
    .map((p) => p.slug);
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData(slug!),
  ]);
} catch { /* use fallbacks */ }

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const body = String(pageData?.body || '');
const category = String(pageData?.category || '');
const readTime = String(pageData?.read_time || '');
const postDate = String(pageData?.post_date || '');
const excerpt = String(pageData?.excerpt || '');
const heroScreenshot = String(pageData?.hero_screenshot_url || '');
const variants = (pageData?.variants as any[] | undefined) ?? [];
const snippets = (pageData?.snippets as any[] | undefined) ?? [];
---

<Layout
  title={pageData?.title || 'Blog post'}
  description={excerpt || pageData?.search_description || 'A structa.cloud blog post on the AHA stack.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug={slug}
>
  <Breadcrumb
    items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }]}
    current={pageData?.title || 'Blog post'}
  />

  <Hero
    eyebrow={category || 'insights · server-first rendering'}
    heading={pageHero?.title || pageData?.title || 'Blog post'}
    accent=''
    intro={pageHero?.subtitle || excerpt}
    primaryCta={pageHero?.primary_cta ? { label: pageHero.primary_cta.label, href: pageHero.primary_cta.href } : { label: '← All posts', href: '/blog' }}
    secondaryCta={pageHero?.secondary_cta ? { label: pageHero.secondary_cta.label, href: pageHero.secondary_cta.href } : { label: 'Contact us', href: '/contact/' }}
    status={`200 OK · ${readTime || 'text/html'}${postDate ? ` · ${postDate}` : ''} · one document`}
  />

  {heroScreenshot && (
    <section class='container-fusion' style='padding-top:2rem'>
      <div class='max-w-4xl'>
        <img
          src={heroScreenshot}
          alt={`${pageData?.title || 'Post'} screenshot`}
          loading='lazy'
          class='block w-full rounded-2xl border border-fu-line shadow-[0_20px_60px_-30px_rgba(0,0,0,0.35)]'
        />
      </div>
    </section>
  )}

  {body ? (
    <article class='doc-sheet bg-fu-paper py-16 md:py-20'>
      <div class='container-fusion'>
        <div class='mx-auto max-w-2xl'>
          <div class='mb-10 flex flex-wrap items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-muted'>
            {category && <span class='text-fu-link'>{category}</span>}
            {readTime && <span>{readTime}</span>}
            {postDate && <time datetime={postDate}>{postDate}</time>}
            <a href='/blog' class='ml-auto text-fu-link no-underline hover:text-fu-link-dark'>← All posts</a>
          </div>
          <div
            class='prose-fusion'
            style='color:hsl(var(--fu-ink));font-size:1.0625rem;line-height:1.85;'
            set:html={body}
          />
        </div>
      </div>

      {variants.length ? (
        <section class='container-fusion' style='padding-top:4rem'>
          <div class='mx-auto max-w-4xl'>
            <div class='mb-8 max-w-2xl'>
              <span class='tag-marker'>variants &amp; screenshots</span>
              <h3 class='mt-3 font-display text-2xl font-bold tracking-tight text-fu-ink'>See it in each edition</h3>
              <p class='mt-1 text-sm text-fu-muted'>A screenshot per variant — open any one to jump straight to the live preview.</p>
            </div>
            <div class='grid grid-cols-1 gap-6 md:grid-cols-2'>
              {variants.map((v: any) => (
                <figure class='card overflow-hidden'>
                  {v.screenshot_url ? (
                    <img src={String(v.screenshot_url)} alt={String(v.caption || v.name || '')} loading='lazy' class='w-full' />
                  ) : (
                    <div class='post-variant__frame' aria-hidden='true'>
                      <div class='post-variant__chrome'><span></span><span></span><span></span></div>
                      <div class='post-variant__screen'>
                        <span class='post-variant__mark'>{String(v.name || '').slice(0, 18)}</span>
                        <span class='post-variant__line'></span>
                        <span class='post-variant__line post-variant__line--short'></span>
                      </div>
                    </div>
                  )}
                  <figcaption class='p-5'>
                    <p class='font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-muted'>{String(v.name || '')}</p>
                    {v.caption && <p class='mt-1 text-sm text-fu-text/70'>{String(v.caption)}</p>}
                    {v.link_href && (
                      <a href={String(v.link_href)} class='mt-3 inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-link no-underline hover:text-fu-link-dark'>
                        {String(v.link_label || 'Open')} ↗
                      </a>
                    )}
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        </section>
      ) : null}

      {snippets.length ? (
        <section class='container-fusion' style='padding-top:4rem'>
          <div class='mx-auto max-w-4xl'>
            <div class='mb-8 max-w-2xl'>
              <span class='tag-marker'>code sections</span>
              <h3 class='mt-3 font-display text-2xl font-bold tracking-tight text-fu-ink'>The code</h3>
              <p class='mt-1 text-sm text-fu-muted'>The full code this deep dive walks through — copy the patterns into your own project.</p>
            </div>
            <div class='grid grid-cols-1 gap-6 lg:grid-cols-2'>
              {snippets.map((snip: any) => (
                <figure class='card overflow-hidden'>
                  <figcaption class='flex items-center justify-between border-b border-fu-line bg-fu-card px-4 py-2.5'>
                    <span class='font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-ink'>{String(snip.title || '')}</span>
                    {snip.language && <span class='font-mono text-[0.65rem] uppercase tracking-[0.14em] text-fu-muted'>{String(snip.language)}</span>}
                  </figcaption>
                  <pre class='overflow-x-auto bg-[#0d0d0d] p-4 font-mono text-[0.78rem] leading-relaxed' style='color:#e6e6e6;'><code>{String(snip.code || '')}</code></pre>
                </figure>
              ))}
            </div>
          </div>
        </section>
      ) : null}

      <!-- Auth-gated comment section (real API: GET/POST /apis/blog/<slug>/comments/) -->
      <div class='container-fusion mt-16 pt-12 border-t border-fu-line'>
        <div
          class='mx-auto max-w-2xl'
          data-slug={slug}
          x-data="{
            slug: $root.dataset.slug || '',
            authed: false,
            user: null as { email: string; display: string } | null,
            loading: true,
            comment: '',
            comments: [] as { name: string; text: string; date: string }[],
            busy: false,
            async init() {
              try {
                const [statusRes, listRes] = await Promise.all([
                  fetch('/apis/auth/status/', { credentials: 'include', headers: { Accept: 'application/json' } }),
                  fetch(`/apis/blog/${this.slug}/comments/`, { headers: { Accept: 'application/json' } }),
                ]);
                if (statusRes.ok) {
                  const data = await statusRes.json();
                  this.authed = data.authenticated;
                  this.user = data.user;
                }
                if (listRes.ok) {
                  const data = await listRes.json();
                  this.comments = (data.comments || []).map((c: any) => ({
                    name: c.display || c.author || 'Reader',
                    text: c.body,
                    date: (c.created_at || '').split('T')[0],
                  }));
                }
              } catch (e) { /* offline */ }
              finally { this.loading = false; }
            },
            async submitComment() {
              if (!this.comment.trim()) return;
              this.busy = true;
              try {
                const res = await fetch(`/apis/blog/${this.slug}/comments/`, {
                  method: 'POST',
                  credentials: 'include',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ body: this.comment.trim() }),
                });
                if (res.ok) {
                  const created = await res.json();
                  this.comments.unshift({
                    name: created.display || created.author || 'Reader',
                    text: created.body,
                    date: (created.created_at || '').split('T')[0],
                  });
                  this.comment = '';
                  window.__showToast?.('Comment added. Thanks for your input!', 'success');
                } else {
                  window.__showToast?.('Comment failed to post — sign in and try again.', 'error');
                }
              } catch (e) {
                window.__showToast?.('Network error — your comment was not posted.', 'error');
              }
              finally { this.busy = false; }
            },
          }"
        >
          <h3 class='mb-6 font-display text-xl font-semibold text-fu-ink'>Comments</h3>

          <!-- Not logged in -->
          <template x-if='!loading && !authed'>
            <div class='card p-6 text-center'>
              <p class='mb-3 text-sm text-fu-muted'>Sign in to join the conversation.</p>
              <button type='button' class='btn-secondary' @click="$dispatch('fusion:open-login')">Sign in</button>
            </div>
          </template>

          <!-- Comment form (logged in) -->
          <template x-if='!loading && authed'>
            <div class='mb-8'>
              <form @submit.prevent='submitComment()' class='space-y-3'>
                <textarea
                  x-model='comment'
                  rows='3'
                  class='input-field'
                  placeholder='Share your thoughts...'
                  required
                  :disabled='busy'
                ></textarea>
                <button type='submit' class='btn-primary !px-6 !py-2 text-sm' :disabled='busy'>
                  <span x-show='!busy'>Post comment</span>
                  <span x-show='busy' x-cloak>Posting…</span>
                </button>
              </form>
              <p class='mt-2 font-mono text-[0.65rem] text-fu-muted'>
                Commenting as <span class='font-semibold text-fu-ink' x-text='user?.display'></span>
              </p>
            </div>
          </template>

          <!-- Comments list -->
          <template x-if='comments.length'>
            <div class='space-y-4'>
              <template x-for='c in comments' :key='c.date'>
                <div class='card p-4'>
                  <div class='mb-1 flex items-center gap-2'>
                    <span class='inline-flex h-7 w-7 items-center justify-center rounded-full bg-fu-link text-[0.65rem] font-bold text-white' x-text='c.name[0]?.toUpperCase()'></span>
                    <span class='text-sm font-medium text-fu-ink' x-text='c.name'></span>
                    <span class='font-mono text-[0.65rem] text-fu-muted' x-text='c.date'></span>
                  </div>
                  <p class='text-sm leading-relaxed text-fu-ink' x-text='c.text'></p>
                </div>
              </template>
            </div>
          </template>

          <!-- Loading -->
          <template x-if='loading'>
            <div class='space-y-3 animate-fusion-pulse'>
              <span class='block h-20 rounded-md bg-fu-line/40'></span>
              <span class='block h-4 w-24 rounded bg-fu-line/60'></span>
            </div>
          </template>
        </div>
      </div>
    </article>
  ) : <ContentError label="Post body unavailable" />}

  <CTA
    heading={pageCta?.title || 'Most of our builds are open source'}
    intro={pageCta?.subtitle || 'Explore more posts on the AHA stack.'}
    ctaLabel={pageCta?.primary_cta?.label || 'Back to the blog'}
    ctaHref={pageCta?.primary_cta?.href || '/blog'}
  />
  <Toast />
  <HtmxBootstrap />
</Layout>

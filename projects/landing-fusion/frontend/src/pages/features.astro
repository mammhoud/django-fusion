---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import Stats from '@/components/blocks/Stats.astro';
import Features from '@/components/blocks/Features.astro';
import Testimonials from '@/components/blocks/Testimonials.astro';
import FAQ from '@/components/blocks/FAQ.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import LiveFragment from '@/components/ui/LiveFragment.astro';
import Skeleton from '@/components/ui/Skeleton.astro';

// Features is a full document (like /about): hero → capabilities → stats →
// features (+ folded pricing) → testimonials → faq → live backend fragment →
// cta. BEM custom classes (.page__*, .capability__*) pair with the theme
// utilities; the live-fragment section is the AHA-stack proof (HTMX swaps in
// the Wagtail-rendered component).

const capabilities = [
  {
    title: 'Server-rendered by default',
    text: 'Every page ships as finished HTML in one response. No client boot, no first-paint spinner — what the browser downloads is what the server sent.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    title: 'HTMX fragments from Django',
    text: 'Dynamic regions are plain HTML fragments served by Wagtail through django-fusion handlers. No JSON API, no decoder, no second state layer.',
    icon: 'M4 5h16v14H4z M4 12h16',
  },
  {
    title: 'Alpine micro-interactions',
    text: 'A toggle or an accordion should not cost a framework. Alpine hydrates interactivity in-place — 15 KB, loaded only where the page needs it.',
    icon: 'M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z',
  },
  {
    title: '0 KB of framework JS',
    text: 'No React, no hydration script, no node_modules in the critical path. Pages feel instant because they ship as documents.',
    icon: 'M17 21v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM21 21v-2a4 4 0 00-3-3.87',
  },
  {
    title: 'SEO is free',
    text: 'Search engines read the finished page, not a shell. Content, headings and links are in the first byte of the response.',
    icon: 'M3 3v18h18M7 15l4-4 3 3 5-6',
  },
  {
    title: 'Editable by editors',
    text: 'Every section is a Wagtail StreamField block in the backend — content teams edit blocks, not markup, and the templates render them identically.',
    icon: 'M12 2a10 10 0 100 20 10 10 0 000-20zM2 12h20',
  },
];
---

<Layout
  title="Features"
  description="The full Fusion CMS capability document — the AHA stack, stats, pricing, proof, and the live backend-fragment demo."
>
  <Hero
    eyebrow="features · the full capability document"
    heading="The stack, shipped as"
    accent="plain HTML"
    intro="Fusion CMS is Astro + HTMX + Alpine.js — a server-first rendering stack with a Wagtail backend underneath. This page documents every capability, folded like the About page, ending with a live fragment fetched straight from Django."
    primaryCta={{ label: 'See the products', href: '/products' }}
    secondaryCta={{ label: 'Read the FAQ', href: '/features#faq' }}
    status="200 OK · text/html · every capability in one response"
  />

  <!-- Capabilities (mission-style section, BEM classes) -->
  <section class="page-section doc-sheet bg-fu-paper py-20 md:py-24">
    <div class="container-fusion">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <p class="tag-marker mb-4">capabilities</p>
        <h2 class="mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl">What the stack does</h2>
        <p class="text-fu-muted">Six capabilities, each one keeping the page a document.</p>
      </div>

      <div class="capability__grid grid grid-cols-1 gap-5 md:grid-cols-3">
        {capabilities.map((cap, i) => (
          <div class="capability__card card reveal p-6" x-data x-intersect="$el.classList.add('reveal-visible')" style={`transition-delay: ${i * 80}ms`}>
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-md border border-fu-line bg-fu-card text-fu-link">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={cap.icon} />
              </svg>
            </div>
            <h3 class="mb-2 font-display text-[1.05rem] font-semibold text-fu-ink">{cap.title}</h3>
            <p class="text-sm leading-relaxed text-fu-muted">{cap.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Stats />

  <!-- Features with pricing folded in (the section ends with the pricing grid) -->
  <Features
    heading="Everything is a document"
    intro="No hidden layers between your content and the browser. The AHA stack — Astro, HTMX, Alpine — renders the web the way it was meant to ship."
    pricing={{
      heading: 'Pricing, printed clearly',
      intro: 'No hidden fees, no per-seat math. Pick a sheet, ship a site.',
    }}
  />

  <Testimonials />

  <FAQ />

  <!-- HTMX → backend: skeleton while the Wagtail fragment loads, then the
       django-fusion handler's server-rendered component swaps in. -->
  <LiveFragment route="/features/" />

  <CTA
    heading="Ship the document, not the app"
    intro="One HTTP response, finished HTML. Start building on Fusion CMS today — no framework to learn, no bundle to wait for."
  />

  <Toast />
</Layout>

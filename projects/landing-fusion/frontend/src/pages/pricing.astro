---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import ContentError from '@/components/ui/ContentError.astro';
import ProductLogo from '@/components/ui/ProductLogo.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData, cachedPricing } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData, PricingData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
let pricingData: PricingData | undefined;
try {
  [siteSettings, navData, pageData, pricingData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('pricing'), cachedPricing(),
  ]);
} catch { /* use fallbacks */ }

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;

// Per-product editions from /apis/pricing/ (excludes hidden products).
const products = pricingData?.products ?? [];

// Edition card treatment per tier — mirrors the Django edition.html block.
function editionCardClass(tier: string): string {
  if (tier === 'featured') return 'edition__card--featured md:-translate-y-1';
  if (tier === 'managed') return 'edition__card--managed overflow-hidden';
  if (tier === 'outline') return 'edition__card--outline';
  return '';
}
---


<Layout
  title={pageData?.title || 'Pricing'}
  description={pageData?.search_description || 'Every structa.cloud product with its editions and pricing: Formints POS, Precis LMS, Loop CMS, and vResume. Community editions are open source.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="pricing"
>
  <Hero
    eyebrow={pageHero?.badge || 'pricing · printed clearly'}
    heading={pageHero?.title || 'Pricing'}
    accent='printed clearly'
    intro={pageHero?.subtitle || 'Every product, its editions, one price sheet. Community editions are open source.'}
    primaryCta={pageHero?.primary_cta ? { label: pageHero.primary_cta.label, href: pageHero.primary_cta.href } : { label: 'See Formints', href: '/products/formint-pos/#editions' }}
    secondaryCta={pageHero?.secondary_cta ? { label: pageHero.secondary_cta.label, href: pageHero.secondary_cta.href } : { label: 'Contact sales', href: '/contact/' }}
    status='200 OK · text/html · the whole price sheet in one response'
  />

  {products.length ? (
  <section id='pricing' class='doc-sheet bg-fu-paper py-20 md:py-24'>
    <div class='container-fusion'>
      <div class='mb-12 max-w-2xl'>
        <p class='tag-marker mb-4'>pricing · per product</p>
        <h2 class='mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>Pick a product, see its editions</h2>
        <p class='text-fu-muted'>Every edition with its price, period and capabilities. Community editions are open source. The rest are quoted per deployment or per month.</p>
      </div>

      <div x-data="{ active: '${products[0].slug}' }">
        <div class='pricing-tabs' role='tablist' aria-label='Products'>
          {products.map((product) => (
            <button
              type='button'
              class='pricing-tab'
              role='tab'
              aria-selected={product.slug === products[0].slug}
              :aria-selected={`active === '${product.slug}'`}
              @click={`active = '${product.slug}'`}
            >
              <ProductLogo style={product.logo_style} />
              {product.title}
            </button>
          ))}
        </div>

        {products.map((product) => (
          <!-- Visibility: Alpine x-show toggles inline display; x-cloak hides
               panels before Alpine boots (same pattern as the FAQ accordion). -->
          <div
            class='pricing-panel mt-12'
            role='tabpanel'
            aria-hidden={product.slug !== products[0].slug}
            :aria-hidden={`active !== '${product.slug}'`}
            x-show={`active === '${product.slug}'`}
            x-cloak
          >
            <div class='mb-10 max-w-2xl'>
              <div class='flex flex-wrap items-center gap-3'>
                <h3 class='font-display text-2xl font-bold tracking-tight text-fu-ink'>{product.title}</h3>
                {product.status === 'development' && <span class='badge-dev'>under development</span>}
              </div>
              {product.version && <p class='mt-1 font-mono text-[0.62rem] uppercase tracking-[0.14em] text-fu-muted'>{product.version}</p>}
              {product.tagline && <p class='mt-2 text-sm text-fu-muted'>{product.tagline}</p>}
            </div>

            <div class:list={['grid grid-cols-1 items-stretch gap-6 md:grid-cols-2', product.editions.length === 4 ? 'xl:grid-cols-4' : product.editions.length === 2 ? 'lg:grid-cols-2' : 'lg:grid-cols-3']}>
              {product.editions.map((ed) => (
                <div class:list={['card edition__card relative flex flex-col p-6 sm:p-8', editionCardClass(ed.tier)]}>
                  {ed.tier === 'featured' && <span class='badge-primary absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap'>most shipped</span>}
                  {ed.tier === 'managed' && <span class='managed-ribbon' aria-hidden='true'>managed</span>}
                  <p class='tag-marker mb-1'>{ed.name}</p>
                  {ed.tagline && <p class='mb-6 text-sm text-fu-muted'>{ed.tagline}</p>}
                  <div class='mb-7 flex flex-wrap items-baseline gap-2'>
                    {ed.offer_old_price && <span class='offer-old-price'>{ed.offer_old_price}</span>}
                    <span class='font-mono text-[2rem] font-semibold tracking-tight text-fu-ink'>{ed.price}</span>
                    {ed.period && <span class='font-mono text-xs uppercase tracking-wider text-fu-muted'>{ed.period}</span>}
                    {ed.offer_label && <span class='badge-offer self-center'>{ed.offer_label}</span>}
                  </div>
                  {ed.features?.length ? (
                    <ul class='mb-8 space-y-2.5 border-t border-fu-line pt-6 text-sm'>
                      {ed.features.map((f) => (
                        <li class='flex items-start gap-2.5'>
                          <svg class='mt-0.5 h-3.5 w-3.5 flex-shrink-0 text-fu-link' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2.5' aria-hidden='true'>
                            <path stroke-linecap='round' stroke-linejoin='round' d='M5 13l4 4L19 7'/>
                          </svg>
                          <span class='text-fu-ink/80'>{f}</span>
                        </li>
                      ))}
                    </ul>
                  ) : null}
                  <div class='mt-auto flex flex-wrap gap-2'>
                    <a href={`/products/${product.slug}/#editions`} class:list={['w-full', ed.tier === 'featured' ? 'btn-primary' : 'btn-secondary']}>See {product.title} →</a>
                    <a href={ed.preview_href || `/products/${product.slug}/preview/${ed.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/`} class='w-full text-center font-mono text-[0.65rem] uppercase tracking-[0.14em] text-fu-link transition-colors hover:text-fu-ink'>Preview this edition →</a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  ) : <ContentError label="Pricing data unavailable" />}

  <!-- Choosing guide — related products + edition guidance -->
  <section class='doc-sheet bg-fu-card py-16 md:py-20'>
    <div class='container-fusion'>
      <div class='mb-10 max-w-2xl'>
        <p class='tag-marker mb-4'>how to choose</p>
        <h2 class='mb-3 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>Start where the work starts</h2>
        <p class='text-fu-muted'>Every product follows the same edition ladder — open source first, then commercial tiers that add production workflows. Pick the rung that matches your team today.</p>
      </div>
      <div class='grid grid-cols-1 gap-5 md:grid-cols-3'>
        <div class='card p-6'>
          <p class='tag-marker mb-1'>rung one</p>
          <h3 class='mb-2 font-display text-lg font-semibold text-fu-ink'>Start open source</h3>
          <p class='text-sm leading-relaxed text-fu-muted'>Community editions of every product are free and public. Try the real thing before you buy.</p>
          <a href='/products/' class='mt-4 inline-block font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-link transition-colors hover:text-fu-ink'>Browse products →</a>
        </div>
        <div class='card p-6'>
          <p class='tag-marker mb-1'>rung two</p>
          <h3 class='mb-2 font-display text-lg font-semibold text-fu-ink'>Grow to a paid tier</h3>
          <p class='text-sm leading-relaxed text-fu-muted'>Standard, Pro, and Solo editions add production workflows, support, and the features teams hit a wall on.</p>
          <a href='/features/' class='mt-4 inline-block font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-link transition-colors hover:text-fu-ink'>See the stack →</a>
        </div>
        <div class='card p-6'>
          <p class='tag-marker mb-1'>rung three</p>
          <h3 class='mb-2 font-display text-lg font-semibold text-fu-ink'>Go managed</h3>
          <p class='text-sm leading-relaxed text-fu-muted'>Custom editions are quoted per deployment — hosted, monitored, and supported for you.</p>
          <a href='/contact/' class='mt-4 inline-block font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-link transition-colors hover:text-fu-ink'>Contact sales →</a>
        </div>
      </div>
      <div class='mt-10 flex flex-wrap items-center gap-3'>
        <span class='font-mono text-[0.62rem] uppercase tracking-[0.16em] text-fu-muted'>related:</span>
        <a href='/features/' class='rounded-full border border-fu-line bg-fu-paper px-3.5 py-1.5 text-sm text-fu-ink transition-colors hover:border-fu-link/50 hover:text-fu-link'>The stack</a>
        <a href='/faq/' class='rounded-full border border-fu-line bg-fu-paper px-3.5 py-1.5 text-sm text-fu-ink transition-colors hover:border-fu-link/50 hover:text-fu-link'>The FAQ</a>
        <a href='/products/' class='rounded-full border border-fu-line bg-fu-paper px-3.5 py-1.5 text-sm text-fu-ink transition-colors hover:border-fu-link/50 hover:text-fu-link'>All products</a>
        <a href='/blog/' class='rounded-full border border-fu-line bg-fu-paper px-3.5 py-1.5 text-sm text-fu-ink transition-colors hover:border-fu-link/50 hover:text-fu-link'>From the blog</a>
      </div>
    </div>
  </section>

  <section class='container-fusion py-10 text-center'>
    <p class='text-fu-muted'>Still deciding? <a href='/faq/' class='font-medium text-fu-link underline underline-offset-2 transition-colors hover:text-fu-ink'>Read the FAQ</a>, the honest answers to the questions buyers ask.</p>
  </section>

  <CTA
    heading={pageCta?.title || 'Most of our builds are open source'}
    intro={pageCta?.subtitle || 'Community editions of every product and the core libraries are public on GitHub. Standard, Pro, and Custom editions are commercial.'}
    ctaLabel={pageCta?.primary_cta?.label || 'View on GitHub'}
    ctaHref={pageCta?.primary_cta?.href || 'https://github.com/mammhoud'}
  />
  <Toast />
  <HtmxBootstrap />
</Layout>

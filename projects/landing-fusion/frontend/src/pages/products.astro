---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import Stats from '@/components/blocks/Stats.astro';
import Testimonials from '@/components/blocks/Testimonials.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import LiveFragment from '@/components/ui/LiveFragment.astro';
import ContentError from '@/components/ui/ContentError.astro';
import ProductLogo from '@/components/ui/ProductLogo.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('products'),
  ]);
} catch { /* use fallbacks */ }

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const pageStats = (pageData?.stats as any[] | undefined);
const pageTestimonials = (pageData?.testimonials as any[] | undefined);

const productStats = pageStats?.map((s: any) => ({
  label: String(s.label || ''), value: Number(s.value || 0), suffix: String(s.suffix || ''),
}));

// Product cards — one per live, non-hidden ProductPage child, enriched by the
// backend (category, logo, status, editions, tech, excerpt). The product line
// and the repo project grid are merged here: every product IS a project in
// this repo, so the section carries the “Projects in this repo” heading.
type ProductCard = NonNullable<PageData['products']>[number];
const productCards = (pageData?.products as ProductCard[] | undefined) ?? [];

// The flagship gets the featured treatment — Formints (the deepest product
// with four editions) when present, otherwise the first card in the tree.
const featuredProduct =
  productCards.find((c) => c.slug === 'forge-pos') ?? productCards[0];
const restProducts = productCards.filter((c) => c !== featuredProduct);
---


<Layout title={pageData?.title || 'Products'} description={pageData?.search_description || 'The full structa.cloud catalog: Formints, Precis LMS, Loop, Syntara, and vResume — every product with its editions, pricing, and tech stack.'} navItems={navData?.nav_items} siteSettings={siteSettings} pageData={pageData} pageSlug="products">
  <Hero
    eyebrow={pageHero?.badge || 'products · the full catalog'}
    heading={pageHero?.title || 'Most of what we build, shipped as'}
    accent='open source'
    intro={pageHero?.subtitle || 'Every product with its editions, pricing, and tech stack, from one monorepo.'}
    primaryCta={pageHero?.primary_cta ? { label: pageHero.primary_cta.label, href: pageHero.primary_cta.href } : { label: 'See the editions', href: '/products/forge-pos/#editions' }}
    secondaryCta={pageHero?.secondary_cta ? { label: pageHero.secondary_cta.label, href: pageHero.secondary_cta.href } : { label: 'Browse the repo', href: 'https://github.com/mammhoud' }}
    status='200 OK · text/html · the full catalog in one response'
  />
  {productStats?.length ? <Stats stats={productStats} /> : <ContentError label="Stats data unavailable" />}

  <!-- The merged catalog — every product is a project in this repo -->
  {productCards.length ? (
  <section id='products' class='doc-sheet bg-fu-paper py-16 md:py-20'>
    <div class='container-fusion'>
      <div class='mb-14 max-w-2xl'>
        <p class='tag-marker mb-4'>projects in this repo</p>
        <h2 class='mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>Projects in this repo</h2>
        <p class='mb-6 text-fu-muted'>Every product with its editions, pricing, and tech stack — from one monorepo.</p>
        <a href='https://github.com/mammhoud' class='inline-flex items-center gap-1.5 font-mono text-[0.72rem] uppercase tracking-[0.16em] text-fu-link transition-colors hover:text-fu-link-dark'>
          Browse the monorepo on GitHub
          <span aria-hidden='true'>→</span>
        </a>
      </div>

      {featuredProduct && (
      <a href={featuredProduct.href} class='card reveal group mb-6 flex flex-col gap-6 p-6 hover:-translate-y-0.5 md:flex-row md:items-center md:gap-10 md:p-8' x-data x-intersect='`$el.classList.add("reveal-visible")`'>
        <div class='md:w-1/2'>
          <div class='mb-3 flex flex-wrap items-center gap-2'>
            <ProductLogo style={featuredProduct.logo_style} />
            <span class='badge-primary badge'>{featuredProduct.category || 'application'}</span>
            {featuredProduct.status === 'development' && <span class='badge-dev'>under development</span>}
            {featuredProduct.editions?.length ? (<span class='font-mono text-[0.65rem] uppercase tracking-[0.16em] text-fu-live'>flagship · {featuredProduct.editions.length} editions</span>) : (<span class='font-mono text-[0.65rem] uppercase tracking-[0.16em] text-fu-live'>flagship</span>)}
            <button
              type='button'
              data-open-brand={featuredProduct.slug}
              aria-label={`${featuredProduct.title} brand kit`}
              title='Brand kit — the story behind the mark'
              class='inline-flex h-8 w-8 items-center justify-center rounded-full border border-fu-line bg-fu-card text-fu-muted transition-colors hover:border-fu-link/50 hover:text-fu-link'
            >
              <svg class='h-3.5 w-3.5' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2' aria-hidden='true'><circle cx='12' cy='12' r='9'/><path stroke-linecap='round' d='M12 11v5M12 8h.01'/></svg>
            </button>
          </div>
          <h3 class='mb-2 font-display text-2xl font-bold tracking-tight text-fu-ink transition-colors group-hover:text-fu-link md:text-3xl'>{featuredProduct.title}</h3>
          {featuredProduct.tagline && <p class='mb-3 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-muted'>{featuredProduct.tagline}</p>}
          {featuredProduct.excerpt && <p class='text-sm leading-relaxed text-fu-muted'>{featuredProduct.excerpt}</p>}
        </div>
        <div class='flex flex-col gap-4 md:w-1/2'>
          {featuredProduct.editions?.length ? (
            <div class='grid grid-cols-1 gap-2.5 sm:grid-cols-2'>
              {featuredProduct.editions.map((ed) => (
                <div class='flex items-baseline justify-between gap-2 rounded-md border border-fu-line bg-fu-card px-3.5 py-2.5'>
                  <span class='text-sm font-medium text-fu-ink'>{ed.name}</span>
                  <span class='font-mono text-[0.7rem] text-fu-muted'>{ed.price}{ed.period ? ` ${ed.period.replace(/^\//, '')}` : ''}</span>
                </div>
              ))}
            </div>
          ) : null}
          <div class='flex flex-wrap items-center gap-2'>
            {featuredProduct.tech?.slice(0, 5).map((t) => (
              <span class='inline-flex items-center rounded-md border border-fu-line bg-fu-card px-2.5 py-1 font-mono text-[0.68rem] text-fu-muted'>{t}</span>
            ))}
          </div>
          <span class='mt-auto font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-link'>View product →</span>
        </div>
      </a>
      )}

      <div class='grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3'>
        {restProducts.map((card, i) => (
          <a href={card.href} class='card reveal group flex flex-col gap-3 p-6 hover:-translate-y-0.5' x-data x-intersect='`$el.classList.add("reveal-visible")`' style={`--reveal-i: ${i}`}>
            <div class='flex items-start justify-between gap-3'>
              <ProductLogo style={card.logo_style} />
              <div class='flex flex-col items-end gap-1.5'>
                <div class='flex items-center gap-1.5'>
                  {card.status === 'development' && <span class='badge-dev'>under development</span>}
                  <button
                    type='button'
                    data-open-brand={card.slug}
                    aria-label={`${card.title} brand kit`}
                    title='Brand kit — the story behind the mark'
                    class='inline-flex h-7 w-7 items-center justify-center rounded-full border border-fu-line bg-fu-card text-fu-muted transition-colors hover:border-fu-link/50 hover:text-fu-link'
                  >
                    <svg class='h-3.5 w-3.5' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2' aria-hidden='true'><circle cx='12' cy='12' r='9'/><path stroke-linecap='round' d='M12 11v5M12 8h.01'/></svg>
                  </button>
                </div>
                <span class='badge badge-primary'>{card.category || 'product'}</span>
              </div>
            </div>
            <h3 class='font-display text-[1.05rem] font-semibold text-fu-ink transition-colors group-hover:text-fu-link'>{card.title}</h3>
            {card.tagline && <p class='text-sm leading-relaxed text-fu-muted'>{card.tagline}</p>}
            {card.editions?.length ? (
              <div class='flex flex-wrap gap-1.5'>
                {card.editions.slice(0, 3).map((ed) => (
                  <span class='edition-chip'>{ed.name} <strong>{ed.price}</strong></span>
                ))}
                {card.editions.length > 3 && <span class='inline-flex items-center px-1 font-mono text-[0.62rem] text-fu-muted'>+{card.editions.length - 3}</span>}
              </div>
            ) : null}
            <span class='mt-auto pt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-link'>View product →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  ) : <ContentError label="Product data unavailable" />}

  <Testimonials testimonials={pageTestimonials?.map((t: any) => ({ quote: String(t.quote || ''), author: String(t.author || ''), role: String(t.role || '') }))} />
  <LiveFragment route='/products/' />
  <CTA heading={pageCta?.title || 'Most of our builds are open source'} intro={pageCta?.subtitle || 'Community editions of every product and the core libraries are public on GitHub. Standard, Pro, and Cloud editions are commercial.'} ctaLabel={pageCta?.primary_cta?.label || 'View on GitHub'} ctaHref={pageCta?.primary_cta?.href || 'https://github.com/mammhoud'} />
  <Toast />
  <HtmxBootstrap />
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import BlogPreview from '@/components/blocks/BlogPreview.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import ContentError from '@/components/ui/ContentError.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('blog'),
  ]);
} catch { /* use fallbacks */ }

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const pageBlog = (pageData?.blog as any[] | undefined);

const posts = pageBlog?.map((p: any) => ({
  title: String(p.title || ''),
  slug: String(p.slug || ''),
  excerpt: String(p.excerpt || ''),
  date: String(p.date || ''),
  category: String(p.category || ''),
  readTime: String(p.read_time || ''),
}));
---


<Layout
  title={pageData?.title || 'Blog'}
  description={pageData?.search_description || 'The structa.cloud blog: notes on the AHA stack, Astro, HTMX, Alpine, Wagtail, and shipping server-rendered sites.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="blog"
>
  <Hero
    eyebrow={pageHero?.badge || 'insights · server-first rendering'}
    heading={pageHero?.title || 'The Blog'}
    accent='server-first'
    intro={pageHero?.subtitle || 'Notes on the AHA stack: Astro, HTMX, Alpine, and shipping server-rendered sites that stay fast.'}
    primaryCta={pageHero?.primary_cta ? { label: pageHero.primary_cta.label, href: pageHero.primary_cta.href } : { label: 'Explore products', href: '/products' }}
    secondaryCta={pageHero?.secondary_cta ? { label: pageHero.secondary_cta.label, href: pageHero.secondary_cta.href } : { label: 'Contact us', href: '/contact' }}
    status='200 OK · text/html · every post in one response'
  />

  {posts?.length ? (
    <BlogPreview
      eyebrow='insights'
      title='From the blog'
      description='Notes on the AHA stack, Wagtail, HTMX, and shipping server-rendered sites that stay fast.'
      posts={posts}
    />
  ) : <ContentError label="Blog posts unavailable" />}

  <CTA
    heading={pageCta?.title || 'Most of our builds are open source'}
    intro={pageCta?.subtitle || 'Community editions of every product and the core libraries are public on GitHub. Standard, Pro, and Cloud editions are commercial.'}
    ctaLabel={pageCta?.primary_cta?.label || 'View on GitHub'}
    ctaHref={pageCta?.primary_cta?.href || 'https://github.com/mammhoud'}
  />
  <Toast />
  <HtmxBootstrap />
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import { cachedSiteSettings, cachedNavigation } from '@/lib/api';
import type { SiteSettings, NavigationData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
try {
  [siteSettings, navData] = await Promise.all([cachedSiteSettings(), cachedNavigation()]);
} catch { /* use fallbacks */ }
---

<Layout
  title="The Founder"
  description="Mahmoud Ezzat Moustafa: full-stack developer, open-source contributor, and the engineer behind structa.cloud."
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageSlug="about/founder"
>
  <div class='container-fusion pt-8'>
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }]} current='Founder' />
  </div>

  <section class='section-hero reg-marks overflow-hidden py-16'>
    <div class='container-fusion'>
      <div class='mx-auto max-w-2xl'>
        <p class='tag-marker mb-4'>about · the founder</p>
        <h1 class='mb-4 font-display text-4xl font-bold tracking-tight text-fu-ink md:text-5xl'>Mahmoud Ezzat Moustafa</h1>
        <p class='text-lg text-fu-muted'>Full-stack developer, open-source contributor, and the engineer behind structa.cloud. Django, Wagtail, and AI-powered systems.</p>
      </div>
    </div>
  </section>

  <section class='doc-sheet bg-fu-paper py-16 md:py-20'>
    <div class='container-fusion'>
      <div class='mx-auto max-w-2xl space-y-10'>
        <div class='card p-8 flex flex-col sm:flex-row items-start gap-5'>
          <div class='flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-full border border-fu-line bg-fu-card font-mono text-xl font-bold text-fu-link'>MEM</div>
          <div>
            <h2 class='mb-2 font-display text-xl font-semibold text-fu-ink'>The engineer</h2>
            <p class='text-sm leading-relaxed text-fu-muted'>
              Mahmoud Ezzat Moustafa is a full-stack developer specializing in Python/Django, Wagtail CMS, and AI tooling.
              He builds server-rendered platforms that ship as documents, with no heavy SPAs or framework overhead.
              Every project in the structa.cloud monorepo carries his signature: finished HTML in one response.
            </p>
          </div>
        </div>

        <div class='card p-8'>
          <h2 class='mb-3 font-display text-xl font-semibold text-fu-ink'>Tech stack</h2>
          <div class='flex flex-wrap gap-2'>
            {['Python', 'Django', 'Wagtail', 'django-fusion', 'ceptor-ai', 'Astro', 'HTMX', 'Alpine.js', 'Tauri 2', 'Rust', 'React', 'PostgreSQL', 'Redis', 'Docker', 'Traefik', 'GitHub Actions'].map((t) => (
              <span class='inline-flex items-center rounded-md border border-fu-line bg-fu-card px-3 py-1.5 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-muted'>{t}</span>
            ))}
          </div>
        </div>

        <div class='grid grid-cols-1 gap-5 sm:grid-cols-2'>
          <a href='https://github.com/mammhoud' target='_blank' rel='noopener' class='card group flex items-center gap-4 p-5 transition-all hover:-translate-y-0.5'>
            <span class='inline-flex h-10 w-10 items-center justify-center rounded-md border border-fu-line bg-fu-card text-fu-muted transition-colors group-hover:text-fu-link'>
              <svg class='h-5 w-5' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='1.8'><path stroke-linecap='round' stroke-linejoin='round' d='M12 2C6.48 2 2 6.58 2 12.2c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.85.09-.66.35-1.12.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9v2.82c0 .27.18.6.69.49A10.22 10.22 0 0 0 22 12.2C22 6.58 17.52 2 12 2z'/></svg>
            </span>
            <div>
              <span class='font-display text-[1.05rem] font-semibold text-fu-ink transition-colors group-hover:text-fu-link'>GitHub</span>
              <p class='text-xs text-fu-muted'>github.com/mammhoud</p>
            </div>
          </a>
          <a href='https://linkedin.com/in/mammhoud' target='_blank' rel='noopener' class='card group flex items-center gap-4 p-5 transition-all hover:-translate-y-0.5'>
            <span class='inline-flex h-10 w-10 items-center justify-center rounded-md border border-fu-line bg-fu-card text-fu-muted transition-colors group-hover:text-fu-link'>
              <svg class='h-5 w-5' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='1.8'><path stroke-linecap='round' stroke-linejoin='round' d='M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 6a2 2 0 100-4 2 2 0 000 4z'/></svg>
            </span>
            <div>
              <span class='font-display text-[1.05rem] font-semibold text-fu-ink transition-colors group-hover:text-fu-link'>LinkedIn</span>
              <p class='text-xs text-fu-muted'>linkedin.com/in/mammhoud</p>
            </div>
          </a>
        </div>

        <div class='card p-8'>
          <h2 class='mb-3 font-display text-xl font-semibold text-fu-ink'>Contact</h2>
          <p class='text-sm leading-relaxed text-fu-muted'>
            Open to collaboration, consulting, and new projects. Reach out at
            <a href='mailto:structa.cloud@gmail.com' class='font-medium text-fu-link hover:text-fu-ink'> structa.cloud@gmail.com</a> or through the
            <a href='/contact/' class='font-medium text-fu-link hover:text-fu-ink'> contact form</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTA
    heading="Built in the open"
    intro="The full monorepo is public on GitHub. Community editions are free, Pro editions are commercial."
    ctaLabel="View on GitHub"
    ctaHref="https://github.com/mammhoud"
  />
  <Toast />
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import ContactForm from '@/components/blocks/ContactForm.astro';
import Toast from '@/components/ui/Toast.astro';
---

<Layout
  title="Contact Us"
  description="Get in touch with the Fusion team — we reply within one business day."
>
  <!-- Hero -->
  <section class="section-hero reg-marks overflow-hidden py-16">
    <div class="container-fusion">
      <div class="mx-auto max-w-2xl text-center">
        <p class="tag-marker mb-5">contact</p>
        <h1 class="mb-4 font-display text-4xl font-bold tracking-tight md:text-5xl">Contact Us</h1>
        <p class="text-lg text-fu-muted">
          We&apos;d love to hear from you. Send a message and we&apos;ll get back to you soon.
        </p>
      </div>
    </div>
  </section>

  <div class="py-14">
    <ContactForm />
  </div>

  <Toast />
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import { contentSlug } from '@/lib/slug';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';

export async function getStaticPaths() {
  // Product detail pages are generated from the page list in [slug].astro.
  // Preview subpages use the same product slugs — edition values come from
  // the product's editions list. We produce one preview page per edition.
  const { fetchPageList } = await import('@/lib/api');
  const list = await fetchPageList();
  const productSlugs = list.pages.filter((p) => p.type === 'ProductPage').map((p) => p.slug);

  const paths: { params: { slug: string; edition: string } }[] = [];
  for (const slug of productSlugs) {
    try {
      const pageData = await cachedPageData(slug);
      const editions = (pageData?.editions as any[] | undefined) || [];
      for (const ed of editions) {
        const editionName = contentSlug(String(ed.name || ''));
        if (editionName) {
          paths.push({ params: { slug, edition: editionName } });
        }
      }
    } catch (error) {
    throw new Error(`Unable to load product preview paths for ${slug}: ${String(error)}`);
  }
  }
  return paths;
}

const { slug, edition } = Astro.params;

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData(slug!),
  ]);
} catch (error) {
  throw new Error(`Unable to load preview data for ${slug}: ${String(error)}`);
}

const pageEditions = (pageData?.editions as any[] | undefined) || [];
const editionData = pageEditions.find(
  (e: any) => contentSlug(String(e.name || '')) === edition
);
const otherEditions = pageEditions.filter(
  (e: any) => contentSlug(String(e.name || '')) !== edition
);

const editionName = editionData ? String(editionData.name || edition) : edition;
---

<Layout
  title={`${editionName} · ${pageData?.title || slug}`}
  description={editionData?.tagline || `${editionName} edition of ${pageData?.title || slug}`}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug={slug}
>
  <Hero
    eyebrow={`edition preview · ${pageData?.title || slug}`}
    heading={editionName}
    accent=''
    intro={editionData?.tagline || ''}
    primaryCta={editionData?.cta_label ? { label: editionData.cta_label, href: editionData.cta_href || '/contact' } : { label: 'Back to product', href: `/products/${slug}` }}
    status='200 OK · edition preview'
  />

  {editionData ? (
    <section class='doc-sheet bg-fu-paper py-12 md:py-16'>
      <div class='container-fusion'>
        <div class='card max-w-lg p-6 sm:p-8'>
          <div class='mb-6 flex items-baseline gap-2'>
            <span class='font-mono text-[2rem] font-semibold tracking-tight text-fu-ink'>{editionData.price || 'Free'}</span>
            {editionData.period && <span class='font-mono text-xs uppercase tracking-wider text-fu-muted'>{editionData.period}</span>}
          </div>
          {editionData.features?.length > 0 && (
            <ul class='mb-6 space-y-2.5 border-t border-fu-line pt-6 text-sm'>
              {editionData.features.map((f: string) => (
                <li class='flex items-start gap-2.5'>
                  <svg class='mt-0.5 h-3.5 w-3.5 flex-shrink-0 text-fu-link' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2.5' aria-hidden='true'>
                    <path stroke-linecap='round' stroke-linejoin='round' d='M5 13l4 4L19 7'/>
                  </svg>
                  <span class='text-fu-ink/80'>{f}</span>
                </li>
              ))}
            </ul>
          )}
          {editionData.cta_label && (
            <a href={editionData.cta_href || '/contact'} class='btn-primary w-full sm:w-auto'>
              {editionData.cta_label}
            </a>
          )}
        </div>

        {otherEditions.length > 0 && (
          <div class='mt-8'>
            <p class='mb-3 text-xs font-medium uppercase tracking-wider text-fu-muted'>Other editions of {pageData?.title || slug}</p>
            <div class='flex flex-wrap gap-2'>
              {otherEditions.map((ed: any) => {
                const edSlug = contentSlug(String(ed.name || ''));
                return (
                  <a href={`/products/${slug}/preview/${edSlug}/`} class='inline-flex items-center rounded-full border border-fu-line bg-fu-card px-3 py-1.5 text-sm text-fu-ink transition-colors hover:border-fu-link/40 hover:text-fu-link'>
                    {ed.name}
                  </a>
                );
              })}
            </div>
          </div>
        )}

        <div class='mt-10'>
          <a href={`/products/${slug}/`} class='font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-link transition-colors hover:text-fu-ink'>
            ← Back to {pageData?.title || slug}
          </a>
        </div>
      </div>
    </section>
  ) : (
    <section class='doc-sheet bg-fu-paper py-20'>
      <div class='container-fusion text-center'>
        <h2 class='font-display text-xl font-bold text-fu-ink'>Edition not found</h2>
        <p class='mt-2 text-fu-muted'>The edition "{edition}" does not exist on {pageData?.title || slug}.</p>
        <a href={`/products/${slug}/`} class='btn-primary mt-6 inline-block'>Back to product</a>
      </div>
    </section>
  )}

  <CTA
    heading='Explore the full product line'
    ctaLabel='All products'
    ctaHref='/products/'
  />
  <Toast />
  <HtmxBootstrap />
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import Stats from '@/components/blocks/Stats.astro';
import Features from '@/components/blocks/Features.astro';
import Testimonials from '@/components/blocks/Testimonials.astro';
import FAQ from '@/components/blocks/FAQ.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';

// ── Fetch from backend, fall back to static content ──
let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('about'),
  ]);
} catch { /* use fallbacks */ }

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const pageStats = (pageData?.stats as any[] | undefined);
const pageFeatures = (pageData?.features as any[] | undefined);
const pageTestimonials = (pageData?.testimonials as any[] | undefined);
const pageFaq = (pageData?.faq as any[] | undefined);

// ── Fallbacks ──
const bioStats = pageStats?.map((s: any) => ({ label: String(s.label || ''), value: Number(s.value || 0), suffix: String(s.suffix || '') })) ?? [
  { label: 'Years coding', value: 5, suffix: '+' },
  { label: 'Open-source repos', value: 15, suffix: '+' },
  { label: 'Blog posts', value: 18, suffix: '' },
  { label: 'Production sites', value: 4, suffix: '+' },
];

const skills = pageFeatures?.map((f: any) => ({
  icon: String(f.icon || 'M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z'),
  title: String(f.title || ''),
  description: String(f.description || ''),
})) ?? [
  { icon: 'M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z', title: 'Python & Django', description: 'Django 5.2, Wagtail 7.4, django-allauth, django-fusion component system, REST APIs, and database design with PostgreSQL and MongoDB.' },
  { icon: 'M13 10V3L4 14h7v7l9-11h-7z', title: 'AI & Machine Learning', description: 'Natural language processing, computer vision, predictive modeling, MCP agents, and AI-powered business solutions.' },
  { icon: 'M4 5h16v14H4z M4 12h16', title: 'Cloud & DevOps', description: 'Traefik + Docker + Nginx orchestration, CI/CD pipelines, Let\'s Encrypt SSL, GitHub Actions.' },
  { icon: 'M17 21v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM21 21v-2a4 4 0 00-3-3.87', title: 'Full-Stack Architecture', description: 'Monorepo design, component systems, HTMX fragment rendering, Astro SSG, Alpine.js, Tauri 2 + Rust.' },
  { icon: 'M3 3v18h18M7 15l4-4 3 3 5-6', title: 'Data Engineering', description: 'Web scraping, ETL pipelines, data analysis, Django ORM outside web projects.' },
  { icon: 'M12 2a10 10 0 100 20 10 10 0 000-20zM2 12h20', title: 'Open Source & Writing', description: '18 technical blog posts on MCP, AI, Django, architecture. 15+ public repositories.' },
];

const missionValues = [
  { title: 'Server-rendered by default', text: 'Every page ships as finished HTML. No heavy SPA, no hydration overhead — just the web as it was designed to work.' },
  { title: 'Open source first', text: 'All core libraries are public. django-fusion, ceptor-ai, and django-bolt are open for contribution and use.' },
  { title: 'Boring technology wins', text: 'Django, PostgreSQL, HTML, CSS — proven tools that keep working. No framework churn, no maintenance treadmill.' },
];

const testimonialItems = pageTestimonials?.map((t: any) => ({
  quote: String(t.quote || ''),
  author: String(t.author || ''),
  role: String(t.role || ''),
})) ?? [
  { quote: "The switch from a heavy React SPA to HTMX fragments cut our page load time in half. django-fusion's component system made the migration straightforward.", author: 'Sarah Mitchell', role: 'CTO, EduStart' },
  { quote: 'Alpine.js replaced all our custom UI state code. The FAQ accordion and modals took an afternoon instead of a week.', author: 'David Chen', role: 'Lead Developer, LearnLoop' },
  { quote: 'Server-rendered HTML means perfect SEO without any extra work. Our blog traffic doubled within a month.', author: 'Amira Hassan', role: 'Marketing Director, SkillBridge' },
];

const faqItems = pageFaq?.map((f: any) => ({
  question: String(f.question || ''),
  answer: String(f.answer || ''),
})) ?? [
  { question: 'Who is behind structa.cloud?', answer: 'Mahmoud Ezzat Moustafa — a full-stack developer and open-source contributor specializing in Python/Django, AI tools, and cloud architecture.' },
  { question: 'What is the AHA stack?', answer: 'AHA stands for Astro + HTMX + Alpine.js — a server-first rendering stack. Astro generates static/dynamic HTML, HTMX streams server-rendered fragments, and Alpine.js powers local interactivity.' },
  { question: 'Are the libraries production-ready?', answer: 'Yes. django-fusion, ceptor-ai, and django-bolt power structa.cloud\'s own production sites including vResume, Cypercloud, and the landing pages themselves.' },
  { question: 'Can I contribute?', answer: 'Absolutely. All libraries are on GitHub at github.com/mammhoud. Open issues, submit PRs, or reach out for collaboration.' },
  { question: 'What AI capabilities are available?', answer: 'ceptor-ai provides an MCP server for AI agent communication, a chat client, and BEM-to-component conversion. It powers the Cypercloud platform.' },
  { question: 'How is this different from a typical CMS?', answer: 'Most CMS platforms serve a JSON API to a React SPA. Structa Cloud serves finished HTML in one response. Less complexity, better performance.' },
];
---

<Layout
  title={pageData?.title || 'About'}
  description={pageData?.search_description || 'Mahmoud Ezzat Moustafa — full-stack developer, open-source contributor, and the engineer behind structa.cloud.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
>
  <Hero
    eyebrow={pageHero?.badge || 'about · the engineer behind the code'}
    heading={pageHero?.title || 'Mahmoud Ezzat'}
    accent='Moustafa'
    intro={pageHero?.subtitle || "Full-stack developer and open-source contributor specializing in Python/Django, AI tools, and cloud architecture. I build server-rendered platforms that ship as documents — no heavy SPAs, no framework overhead, just the web working the way it should."}
    primaryCta={pageHero?.primary_cta ? { label: pageHero.primary_cta.label, href: pageHero.primary_cta.href } : { label: 'View GitHub', href: 'https://github.com/mammhoud' }}
    secondaryCta={pageHero?.secondary_cta ? { label: pageHero.secondary_cta.label, href: pageHero.secondary_cta.href } : { label: 'Read the blog', href: 'https://mammhoud.github.io' }}
    status='200 OK · text/html · the engineer, in one response'
  />

  <Stats stats={bioStats} />

  <!-- Mission -->
  <section class='doc-sheet bg-fu-paper py-20 md:py-24'>
    <div class='container-fusion'>
      <div class='mx-auto mb-14 max-w-2xl text-center'>
        <p class='tag-marker mb-4'>philosophy</p>
        <h2 class='mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>Why I build this way</h2>
        <p class='text-fu-muted'>Three principles guide every project: server-render by default, open source first, and choose boring technology that keeps working.</p>
      </div>
      <div class='grid grid-cols-1 gap-5 md:grid-cols-3'>
        {missionValues.map((value, i) => (
          <div class='card reveal p-6' x-data x-intersect='`$el.classList.add("reveal-visible")`' style={`transition-delay: ${i * 80}ms`}>
            <div class='mb-4 inline-flex h-10 w-10 items-center justify-center rounded-md border border-fu-line bg-fu-card text-fu-link'>
              <svg class='h-5 w-5' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='1.8' aria-hidden='true'>
                <path stroke-linecap='round' stroke-linejoin='round'
                  d={i === 0 ? 'M12 3v18M3 12h18M12 7l1.5 3 3 1.5-3 1.5L12 17l-1.5-3-3-1.5 3-1.5L12 7z'
                    : i === 1 ? 'M13 10V3L4 14h7v7l9-11h-7z'
                    : 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'} />
              </svg>
            </div>
            <h3 class='mb-2 font-display text-[1.05rem] font-semibold text-fu-ink'>{value.title}</h3>
            <p class='text-sm leading-relaxed text-fu-muted'>{value.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills -->
  <Features
    heading='The stack, in detail'
    intro='From Django backends to AI agents, these are the technologies that power structa.cloud.'
    features={skills.map((s) => ({
      icon: 'rocket' as const,
      title: s.title,
      description: s.description,
      _iconPath: s.icon,
    }))}
  />

  <Testimonials testimonials={testimonialItems} />
  <FAQ items={faqItems} />

  <CTA
    heading={pageCta?.title || "Let's build together"}
    intro={pageCta?.subtitle || 'Open to collaboration, consulting, and new projects. Reach out on GitHub, LinkedIn, or through the contact form.'}
    ctaLabel={pageCta?.primary_cta?.label || 'Get in touch'}
    ctaHref={pageCta?.primary_cta?.href || '/contact'}
  />

  <Toast />
</Layout>

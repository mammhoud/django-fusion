---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import Stats from '@/components/blocks/Stats.astro';
import Features from '@/components/blocks/Features.astro';
import Testimonials from '@/components/blocks/Testimonials.astro';
import ContentError from '@/components/ui/ContentError.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';

// ── Fetch from backend — no hardcoded fallbacks ──
let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
let backendError = false;

try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('about'),
  ]);
} catch {
  backendError = true;
}

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const pageStats = (pageData?.stats as any[] | undefined);
const pageFeatures = (pageData?.features as any[] | undefined);
const pageTestimonials = (pageData?.testimonials as any[] | undefined);
const pageBody = pageData?.body;

// ── Derived from backend data only — no hardcoded arrays ──
const bioStats = pageStats?.map((s: any) => ({
  label: String(s.label || ''),
  value: Number(s.value || 0),
  suffix: String(s.suffix || ''),
}));

const skills = pageFeatures?.map((f: any) => ({
  icon: String(f.icon || ''),
  title: String(f.title || ''),
  description: String(f.description || ''),
}));

const testimonialItems = pageTestimonials?.map((t: any) => ({
  quote: String(t.quote || ''),
  author: String(t.author || ''),
  role: String(t.role || ''),
}));

// ── Page-level error: backend unreachable — show full error ──
const hasAnyData = pageData || siteSettings || navData;
const hasHero = pageHero?.title || pageHero?.badge;
---

<Layout
  title={pageData?.title}
  description={pageData?.search_description}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="about"
>
  {
    backendError || !hasAnyData ? (
      <ContentError label="About page data unavailable" showHomeLink={true} />
    ) : (
      <>
        {
          hasHero ? (
            <Hero
              eyebrow={pageHero!.badge}
              heading={pageHero!.title}
              accent="Moustafa"
              intro={pageHero!.subtitle}
              primaryCta={pageHero!.primary_cta ? { label: pageHero!.primary_cta.label, href: pageHero!.primary_cta.href } : undefined}
              secondaryCta={pageHero!.secondary_cta ? { label: pageHero!.secondary_cta.label, href: pageHero!.secondary_cta.href } : undefined}
              status="200 OK · text/html · the engineer, in one response"
            />
          ) : (
            <ContentError label="Hero data unavailable" showHomeLink={false} />
          )
        }

        <!-- About subpages: team, startup, founder -->
        <section class="container-fusion -mt-4 pb-2">
          <div class="flex flex-wrap items-center justify-center gap-4 text-center">
            <a href="/about/team/" class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-link underline underline-offset-4 transition-colors hover:text-fu-ink">
              Meet the team →
            </a>
            <span class="text-fu-line" aria-hidden="true">|</span>
            <a href="/about/startup/" class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-link underline underline-offset-4 transition-colors hover:text-fu-ink">
              The startup →
            </a>
            <span class="text-fu-line" aria-hidden="true">|</span>
            <a href="/about/founder/" class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-link underline underline-offset-4 transition-colors hover:text-fu-ink">
              The founder →
            </a>
          </div>
        </section>

        {bioStats?.length ? <Stats stats={bioStats} /> : <ContentError label="Stats data unavailable" showHomeLink={false} />}

        <!-- Mission — driven by backend RichText body -->
        {pageBody ? (
          <section class="doc-sheet bg-fu-paper py-20 md:py-24">
            <div class="container-fusion">
              <div class="mx-auto max-w-2xl prose-fusion" set:html={pageBody} />
            </div>
          </section>
        ) : (
          <ContentError label="Mission content unavailable" showHomeLink={false} />
        )}

        {skills?.length ? (
          <Features
            heading="The stack, in detail"
            intro="From Django backends to AI agents, these are the technologies that power structa.cloud."
            features={skills.map((s) => ({
              icon: 'rocket' as const,
              title: s.title,
              description: s.description,
              _iconPath: s.icon,
            }))}
          />
        ) : (
          <ContentError label="Skills data unavailable" showHomeLink={false} />
        )}

        {testimonialItems?.length ? (
          <Testimonials testimonials={testimonialItems} />
        ) : (
          <ContentError label="Testimonials unavailable" showHomeLink={false} />
        )}

        {
          pageCta ? (
            <CTA
              heading={pageCta.title}
              intro={pageCta.subtitle}
              ctaLabel={pageCta.primary_cta?.label}
              ctaHref={pageCta.primary_cta?.href}
            />
          ) : (
            <ContentError label="CTA data unavailable" showHomeLink={false} />
          )
        }
      </>
    )
  }

  <Toast />
</Layout>

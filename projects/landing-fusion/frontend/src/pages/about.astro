---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import Stats from '@/components/blocks/Stats.astro';
import Features from '@/components/blocks/Features.astro';
import Testimonials from '@/components/blocks/Testimonials.astro';
import FAQ from '@/components/blocks/FAQ.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';

// About is the full document: the story, the stack, the pricing — all in one page.
// The home page now points here for depth ("read the docs" / "see everything").

const missionValues = [
  {
    title: 'Accessibility first',
    text: 'Knowledge should be open to everyone. We build with progressive enhancement so the content works everywhere.',
  },
  {
    title: 'Performance matters',
    text: 'Every kilobyte counts. Server-rendered HTML with a sprinkle of Alpine.js keeps our pages instantly responsive.',
  },
  {
    title: 'Simplicity wins',
    text: 'We prefer boring, maintainable technology over clever abstractions. The AHA stack is our happy medium.',
  },
];
---

<Layout
  title="About"
  description="The full Fusion CMS story — our mission, the numbers, the features, pricing, and what teams say about the AHA stack."
>
  <Hero
    eyebrow="about · the whole document"
    heading="The web, shipped as"
    accent="plain HTML"
    intro="Fusion CMS started with a simple belief: a marketing site should be a document, not an app shell. Everything that used to live on one landing page now lives here — the mission, the numbers, the features, the pricing, and the proof."
    primaryCta={{ label: 'See the features', href: '/about#features' }}
    secondaryCta={{ label: 'Read the FAQ', href: '/about#faq' }}
    status="200 OK · text/html · the full story in one response"
  />

  <!-- Mission -->
  <section class="doc-sheet bg-fu-paper py-20 md:py-24">
    <div class="container-fusion">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <p class="tag-marker mb-4">mission</p>
        <h2 class="mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl">Why we build this way</h2>
        <p class="text-fu-muted">
          We believe great software should be fast, simple, and open. Three principles carry every decision.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        {missionValues.map((value, i) => (
          <div class="card reveal p-6" x-data x-intersect="$el.classList.add('reveal-visible')" style={`transition-delay: ${i * 80}ms`}>
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-md border border-fu-line bg-fu-card text-fu-link">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d={i === 0 ? 'M12 3v18M3 12h18M12 7l1.5 3 3 1.5-3 1.5L12 17l-1.5-3-3-1.5 3-1.5L12 7z'
                    : i === 1 ? 'M13 10V3L4 14h7v7l9-11h-7z'
                    : 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'} />
              </svg>
            </div>
            <h3 class="mb-2 font-display text-[1.05rem] font-semibold text-fu-ink">{value.title}</h3>
            <p class="text-sm leading-relaxed text-fu-muted">{value.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Stats />

  <!-- Features with pricing folded in (the section ends with the pricing grid) -->
  <Features
    heading="Everything is a document"
    intro="No hidden layers between your content and the browser. The AHA stack — Astro, HTMX, Alpine — renders the web the way it was meant to ship."
    pricing={{
      heading: 'Pricing, printed clearly',
      intro: 'No hidden fees, no per-seat math. Pick a sheet, ship a site.',
    }}
  />

  <Testimonials />

  <FAQ />

  <CTA
    heading="Ship the document, not the app"
    intro="One HTTP response, finished HTML. Start building on Fusion CMS today — no framework to learn, no bundle to wait for."
  />

  <Toast />
</Layout>

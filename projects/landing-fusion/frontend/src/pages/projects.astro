---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import Stats from '@/components/blocks/Stats.astro';
import Features from '@/components/blocks/Features.astro';
import Testimonials from '@/components/blocks/Testimonials.astro';
import FAQ from '@/components/blocks/FAQ.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import LiveFragment from '@/components/ui/LiveFragment.astro';

// Projects is a full document (like /about): hero → projects grid → stats →
// features (+ folded pricing) → testimonials → faq → live backend fragment →
// cta. Each card lists the repo's projects with their edition and features
// flagged shared (reused across the monorepo) or own (standalone). BEM
// custom classes (.project__*) pair with the theme utilities; the
// live-fragment section fetches the Wagtail-rendered component via HTMX.

const repoProjects = [
  {
    name: 'Fusion CMS',
    edition: 'Wagtail backend',
    category: 'website',
    path: 'projects/landing-fusion/backend',
    text: 'The Wagtail content engine behind every landing page — StreamField sections rendered server-side by django-fusion handlers.',
    features: [
      { label: 'django-fusion fragment pipeline', shared: true },
      { label: 'HTMX fragment rendering', shared: true },
      { label: 'Wagtail StreamField blocks', shared: false },
    ],
  },
  {
    name: 'Fusion Sites',
    edition: 'Astro frontend',
    category: 'website',
    path: 'projects/landing-fusion/frontend',
    text: 'The AHA shell — Astro SSG, HTMX fragment swaps, Alpine micro-interactions. Zero framework JS in the critical path.',
    features: [
      { label: 'Astro SSG', shared: false },
      { label: 'HTMX + Alpine runtime', shared: true },
      { label: 'Fusion design tokens', shared: true },
    ],
  },
  {
    name: 'Forge POS',
    edition: 'Minimal · Solo · Full',
    category: 'product',
    path: 'projects/pos/forge-pos',
    text: 'A desktop point-of-sale app in three editions — Tauri 2 + Rust core with a React/Vite frontend and SQLite storage.',
    features: [
      { label: 'Tauri 2 + Rust core', shared: true },
      { label: 'SQLite schema', shared: true },
      { label: 'Kitchen display', shared: false },
      { label: 'Employee scheduling', shared: false },
    ],
  },
  {
    name: 'django-fusion',
    edition: 'library · generic',
    category: 'library',
    path: 'libs/django-fusion',
    text: 'The component system + routing framework shared by every site — PageHandler views, fragment rendering, and comp templates.',
    features: [
      { label: 'Component registry', shared: true },
      { label: 'FragmentHandlerMixin', shared: true },
      { label: 'Wagtail blocks bridge', shared: true },
    ],
  },
  {
    name: 'ceptor-ai',
    edition: 'library · generic',
    category: 'library',
    path: 'libs/ceptor-ai',
    text: 'AI chat client + MCP server used by the Cypercloud platform and agent tooling.',
    features: [
      { label: 'MCP server', shared: true },
      { label: 'Chat client', shared: true },
    ],
  },
  {
    name: 'Cypercloud',
    edition: 'AI platform',
    category: 'product',
    path: 'projects/cypercloud',
    text: 'The AI chat customizer platform — ceptor-ai powered chat embedded into customer sites.',
    features: [
      { label: 'ceptor-ai chat', shared: true },
      { label: 'Customizer UI', shared: false },
    ],
  },
];
---

<Layout
  title="Projects"
  description="The full project document — the monorepo at a glance, editions, shared vs standalone features, and the live backend-fragment demo."
>
  <Hero
    eyebrow="projects · the monorepo inventory"
    heading="Everything we build, shipped as"
    accent="one monorepo"
    intro="Every project in the structa.cloud repo, its edition, and what it shares. Features marked shared are reused across the monorepo; the rest are standalone products. This page then fetches a live fragment straight from the backend."
    primaryCta={{ label: 'See the features', href: '/features' }}
    secondaryCta={{ label: 'Read the FAQ', href: '/projects#faq' }}
    status="200 OK · text/html · every project in one response"
  />

  <!-- Project cards (BEM classes) -->
  <section class="page-section doc-sheet bg-fu-paper py-20 md:py-24">
    <div class="container-fusion">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <p class="tag-marker mb-4">projects</p>
        <h2 class="mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl">Projects in this repo</h2>
        <p class="text-fu-muted">Six projects, one pipeline — <span class="font-mono text-[0.72rem] uppercase tracking-[0.14em] text-fu-live">shared</span> features are reused, <span class="font-mono text-[0.72rem] uppercase tracking-[0.14em] text-fu-muted">own</span> features are standalone.</p>
      </div>

      <div class="project__grid grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {repoProjects.map((project, i) => (
          <article class="project__card card reveal p-6" x-data x-intersect="$el.classList.add('reveal-visible')" style={`transition-delay: ${i * 80}ms`}>
            <div class="project__head mb-1 flex items-center justify-between gap-3">
              <p class="tag-marker project__category">{project.category}</p>
              {project.edition && (
                <span class="badge-primary badge project__edition">{project.edition}</span>
              )}
            </div>
            <h3 class="mb-0.5 font-display text-[1.05rem] font-semibold text-fu-ink project__name">{project.name}</h3>
            <p class="mb-3 font-mono text-[0.65rem] uppercase tracking-[0.16em] text-fu-muted project__path">{project.path}</p>
            <p class="mb-4 text-sm leading-relaxed text-fu-muted project__text">{project.text}</p>
            <ul class="project__features flex flex-col gap-1.5">
              {project.features.map((feature) => (
                <li class={`project__feature flex items-baseline gap-2 text-[0.8rem] text-fu-ink/80 ${feature.shared ? 'project__feature--shared' : ''}`}>
                  <span class="text-fu-link">•</span>
                  <span>{feature.label}</span>
                  <span
                    class={`project__feature-tag ml-auto font-mono text-[0.6rem] uppercase tracking-[0.12em] ${feature.shared ? 'text-fu-live' : 'text-fu-muted'}`}
                  >
                    {feature.shared ? 'shared' : 'own'}
                  </span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Stats />

  <!-- Features with pricing folded in (the section ends with the pricing grid) -->
  <Features
    heading="Everything is a document"
    intro="No hidden layers between your content and the browser. The AHA stack — Astro, HTMX, Alpine — renders the web the way it was meant to ship."
    pricing={{
      heading: 'Pricing, printed clearly',
      intro: 'No hidden fees, no per-seat math. Pick a sheet, ship a site.',
    }}
  />

  <Testimonials />

  <FAQ />

  <!-- HTMX → backend: skeleton while the Wagtail fragment loads, then the
       django-fusion handler's server-rendered component swaps in. -->
  <LiveFragment route="/projects/" />

  <CTA
    heading="Ship the document, not the app"
    intro="One HTTP response, finished HTML. Start building on Fusion CMS today — no framework to learn, no bundle to wait for."
  />

  <Toast />
</Layout>

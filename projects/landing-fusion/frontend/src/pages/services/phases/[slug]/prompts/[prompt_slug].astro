---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import { cachedNavigation, cachedPageData, cachedSiteSettings, fetchPageList } from '@/lib/api';
import type { NavigationData, PageData, SiteSettings } from '@/lib/api';

export async function getStaticPaths() {
  const list = await fetchPageList();
  const promptPages = list.pages.filter((page) => page.type === 'PromptPage');
  const paths: { params: { slug: string; prompt_slug: string } }[] = [];
  for (const prompt of promptPages) {
    try {
      const promptData = await cachedPageData(prompt.slug);
      const phase = promptData.phase;
      if (phase?.slug) paths.push({ params: { slug: phase.slug, prompt_slug: prompt.slug } });
    } catch { /* skip incomplete content */ }
  }
  return paths;
}

const { slug, prompt_slug } = Astro.params;
let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData(prompt_slug!),
  ]);
} catch { /* use content fallback */ }
const parentPhaseMismatch = Boolean(pageData?.phase && pageData.phase.slug !== slug);
---

<Layout
  title={pageData?.title || 'Implementation prompt'}
  description={pageData?.search_description || pageData?.title || 'A reusable Structa Cloud implementation prompt.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug={`prompt:${prompt_slug}`}
>
  {parentPhaseMismatch && <meta http-equiv="refresh" content="0;url=/404" />}
  <Breadcrumb
    items={[
      { label: 'Home', href: '/' },
      { label: 'Services', href: '/services/' },
      ...(pageData?.phase ? [{ label: pageData.phase.title, href: pageData.phase.href }] : []),
    ]}
    current={pageData?.title || 'Implementation prompt'}
  />

  <Hero
    eyebrow={`implementation prompt${pageData?.tool ? ` · ${pageData.tool}` : ''}`}
    heading={pageData?.title || 'Implementation prompt'}
    accent='reusable brief'
    intro={pageData?.hero?.subtitle || ''}
    primaryCta={pageData?.phase ? { label: `Back to ${pageData.phase.title}`, href: pageData.phase.href } : { label: 'See all services', href: '/services/' }}
    status='200 OK · Wagtail prompt'
  />

  <article class='doc-sheet bg-fu-paper py-16 md:py-24'>
    <div class='container-fusion'>
      <section class='mx-auto max-w-3xl rounded-xl border border-fu-line bg-fu-card p-6 md:p-8'>
        <p class='tag-marker'>prompt</p>
        <div class='prompt-copy mt-4 whitespace-pre-wrap font-mono text-sm leading-7 text-fu-ink'>{pageData?.prompt || 'Prompt content unavailable.'}</div>
      </section>
      <div class='mx-auto mt-8 grid max-w-3xl gap-6 md:grid-cols-2'>
        {pageData?.context && <section class='rounded-xl border border-fu-line bg-fu-card p-6'><p class='tag-marker'>context</p><div class='prose-fusion mt-4 text-fu-muted' set:html={pageData.context} /></section>}
        {pageData?.output && <section class='rounded-xl border border-fu-line bg-fu-card p-6'><p class='tag-marker'>expected output</p><div class='prose-fusion mt-4 text-fu-muted' set:html={pageData.output} /></section>}
      </div>
    </div>
  </article>
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import ContentError from '@/components/ui/ContentError.astro';
import ProductLogo from '@/components/ui/ProductLogo.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import { BRAND_SPEC } from '@/lib/brand';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;   // the BrandPage (editable hero/cta + display_mode)
let productsData: PageData | undefined; // the ProductsPage catalog (boards)
try {
  [siteSettings, navData, pageData, productsData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('brand'), cachedPageData('products'),
  ]);
} catch { /* use fallbacks */ }

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const productCards = (productsData?.products as any[] | undefined) ?? [];

// Join the API cards with the brand story — one identity board per product.
const boards = productCards
  .map((card) => ({ ...card, ...(BRAND_SPEC[card.slug] ?? {}) }))
  .filter((b) => b.essence);

// Map a palette token to the CSS variable backing its swatch.
// Brand tokens (formints/precis/…) use --brand-*; system tokens map to fu-*.
function swatchVar(token: string): string {
  const system: Record<string, string> = {
    paper: '--fu-paper', ink: '--fu-ink', line: '--fu-line',
    link: '--fu-link', live: '--fu-live', mark: '--fu-mark',
  };
  return system[token] ? `hsl(var(${system[token]}))` : `hsl(var(--brand-${token}))`;
}
---

<Layout
  title="Brand kit"
  description="The structa.cloud brand system — five constructed marks, one family: Formints, Precis LMS, Loop, Syntara, and vResume."

  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="brand"
>
  <Hero
    eyebrow={pageHero?.badge || 'brand · identity'}
    heading={pageHero?.title || 'One family, five marks'}
    accent='five marks'
    intro={pageHero?.subtitle || 'Every product carries its own constructed mark — a symbol built from what it does, not a generic glyph. Same system, five distinct identities.'}
    primaryCta={pageHero?.primary_cta ? { label: pageHero.primary_cta.label, href: pageHero.primary_cta.href } : { label: 'See the products', href: '/products' }}
    secondaryCta={pageHero?.secondary_cta ? { label: pageHero.secondary_cta.label, href: pageHero.secondary_cta.href } : { label: 'Pricing', href: '/pricing' }}
    status="200 OK · text/html · the identity system, in one response"
  />

  {boards.length ? (
  <section class='doc-sheet bg-fu-paper py-16 md:py-20'>
    <div class='container-fusion'>
      <div class='mb-12 max-w-2xl'>
        <p class='tag-marker mb-4'>brand · per product</p>
        <h2 class='mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>The product family</h2>
        <p class='text-fu-muted'>Each board shows the lockup, the construction logic of the mark, the one-line essence, the typographic voice, and the colour system the brand sits in.</p>
      </div>

      <div class='grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3'>
        {boards.map((board, i) => (
          <article class='brand-board reveal' x-data x-intersect='`$el.classList.add("reveal-visible")`' style={`--reveal-i: ${i}`}>
            <div class='brand-board__lockup'>
              <div class='brand-board__mark'>
                <ProductLogo style={board.mark} />
              </div>
              <div>
                <h3 class='brand-board__name'>{board.name}</h3>
                <p class='brand-board__role'>{board.role}</p>
              </div>
            </div>

            <div class='brand-board__construction'>
              <ProductLogo style={board.mark} />
            </div>

            <div class='brand-board__body'>
              <p class='brand-board__essence'>{board.essence}</p>
              <div class='brand-board__spec'>
                <div class='brand-board__spec-row'>
                  <span class='brand-board__spec-label'>metaphor</span>
                  <span class='brand-board__spec-value'>{board.metaphor}</span>
                </div>
                <div class='brand-board__spec-row'>
                  <span class='brand-board__spec-label'>construction</span>
                  <span class='brand-board__spec-value'>{board.construction}</span>
                </div>
                <div class='brand-board__spec-row'>
                  <span class='brand-board__spec-label'>voice</span>
                  <span class='brand-board__spec-value'>{board.voice}</span>
                </div>
                <div class='brand-board__spec-row'>
                  <span class='brand-board__spec-label'>palette</span>
                  <div class='brand-swatches'>
                    {board.palette.map((token: string, si: number) => (
                      <div class:list={['brand-swatch', si === 0 ? 'brand-swatch--accent' : '']} style={`background:${swatchVar(token)}`} title={token}></div>
                    ))}
                  </div>
                </div>
              </div>
              <div class='mt-5 border-t border-fu-line pt-4'>
                <a href={board.href} class='font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-link transition-colors hover:text-fu-link-dark'>See the product →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  ) : <ContentError label="Brand data unavailable" />}

  <CTA
    heading={pageCta?.title || 'One family, five marks'}
    intro={pageCta?.subtitle || 'Community editions of every product are open source. Explore the code, open issues, or contribute.'}
    ctaLabel={pageCta?.primary_cta?.label || 'View on GitHub'}
    ctaHref={pageCta?.primary_cta?.href || 'https://github.com/mammhoud'}
  />
  <Toast />
  <HtmxBootstrap />
</Layout>

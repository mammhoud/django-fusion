# ============================================
# 🌐 LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# ============================================
# This file is used by the dev container for local development
# It extends the base .env file with development-specific overrides

# ============================================
# Core Environment
# ============================================
SERVER_ENV=development
RUNNING_ENV=local
MODULE=CMS

# ============================================
# Django Development Settings
# ============================================
DEBUG=true
DJANGO_SECRET_KEY=dev-secret-key-not-for-production
DJANGO_SETTINGS_MODULE=settings

# ============================================
# Server Configuration
# ============================================
SERVER_TYPE=django
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=debug

# ============================================
# Database Configuration (SQLite for local dev)
# ============================================
# Matches GitHub Actions testing environment
DB_TYPE=sqlite
DATABASE_URL=sqlite:///db.sqlite3

# ============================================
# Domain & Hosts
# ============================================
DOMAIN=localhost:8000
SITE_DOMAIN=localhost:8000
WAGTAILADMIN_BASE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,django-dev
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ============================================
# Django Superuser (for local development)
# ============================================
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@localhost
SUPERUSER_PASSWORD=admin123

# ============================================
# Email (Console Backend for local dev)
# ============================================
EMAIL_STRATEGY=console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_USER=admin@localhost
EMAIL_PASSWORD=not-needed-for-console
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=admin@localhost

# ============================================
# Cache Configuration (local memory cache)
# ============================================
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
REDIS_URL=

# ============================================
# Celery Configuration (disabled for local)
# ============================================
CELERY_ALWAYS_EAGER=true
CELERY_EAGER_PROPAGATES=true

# ============================================
# Setup Flags
# ============================================
RUN_SETUP=true
BUILD_ASSETS_ON_START=auto

# ============================================
# Feature Flags
# ============================================
VAULT_ENABLED_FOR_DYNACONF=false

# ============================================
# Media Files
# ============================================
MEDIA_ROOT=/app/assets/media
MEDIA_URL=/media/

# ============================================
# Static Files
# ============================================
STATIC_ROOT=/app/staticfiles
STATIC_URL=/static/

# ============================================
# Logging
# ============================================
LOG_DIR=/app/logs

# ============================================
# Third-party Service Integration
# ============================================
# Disable external services in local development
ENABLE_ANALYTICS=false
ENABLE_ERROR_TRACKING=false
ENABLE_PERFORMANCE_MONITORING=false

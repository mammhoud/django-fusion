{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "syntara",
  "root": "projects/syntara",
  "projectType": "application",
  "tags": ["product:syntara", "type:backend", "stack:django+webpack"],
  "implicitDependencies": ["customizer", "django-fusion-assets"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "make build", "cwd": "projects/syntara" }
    },
    "check": {
      "executor": "nx:run-commands",
      "inputs": ["backend", "^production"],
      "cache": true,
      "options": { "command": "make check", "cwd": "projects/syntara" }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["backend", "^production"],
      "cache": true,
      "options": { "command": "make test", "cwd": "projects/syntara" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "make run", "cwd": "projects/syntara" }
    },
    "build-collect": {
      "executor": "nx:run-commands",
      "options": { "command": "make build-collect", "cwd": "projects/syntara" }
    }
  }
}

#!/bin/bash
set -o errexit
set -o pipefail
set -o nounset

APP_HOME="${APP_HOME:-/app}"
cd "$APP_HOME"

HOST="${HOST:-0.0.0.0}"
PORT="${PORT:-5070}"
WORKERS="${WORKERS:-4}"
RELOAD="${RELOAD:-false}"
LOG_LEVEL="${LOG_LEVEL:-info}"
# Auto-recycle workers to flush stale in-memory state (template caches,
# cached.Loader entries, accumulated per-worker caches) after they have
# served MAX_REQUESTS requests. Jitter spreads restarts across workers
# so a thundering herd is avoided. Set MAX_REQUESTS=0 to disable.
# NOTE: --max-requests kills the worker process after N requests. For pure
# HTTP this is harmless (the request completes first), but long-lived ASGI
# responses (e.g. Channels/WebSocket consumers) will be severed when the
# worker reboots. Set MAX_REQUESTS=0 in that deployment.
MAX_REQUESTS="${MAX_REQUESTS:-1000}"
MAX_REQUESTS_JITTER="${MAX_REQUESTS_JITTER:-100}"
SITE_NAME="${DJANGO_SITE:-${DJANGO_WEBSITE:-${WEBSITE:-${PROJECT_PATH:-ctc-research}}}}"
SITE_DIR_NAME="${PROJECT_PATH:-$SITE_NAME}"
if [ ! -d "${APP_HOME}/${SITE_DIR_NAME}" ] && [ "$SITE_NAME" = "vresume" ]; then
    SITE_DIR_NAME="VResume"
fi


   
# Import the site-local server.py via PYTHONPATH instead of using the site
# directory as a dotted package (hyphenated names are not importable).
export PYTHONPATH="${APP_HOME}/${SITE_DIR_NAME}/www:${APP_HOME}/${SITE_DIR_NAME}:${APP_HOME}:${PYTHONPATH:-}"
APP_MODULE="${APP_MODULE:-server:application}"
case "$APP_MODULE" in
    "${SITE_NAME}.server:application"|\
    "${SITE_DIR_NAME}.server:application"|\
    "${PROJECT_PATH:-}.server:application")
        echo "⚠️  Normalizing APP_MODULE=${APP_MODULE} to server:application; site names are paths, not Python packages."
        APP_MODULE="server:application"
        ;;
esac
WATCH_DIRS="${WATCH_DIRS:-${APP_HOME}/${SITE_DIR_NAME}/www,${APP_HOME}/configs}"
SERVER_TYPE="${SERVER_TYPE:-${RUNSERVER:-gunicorn}}"
LOG_DIR="${LOG_DIR:-${APP_HOME}/logs}"
ACCESS_LOG="${ACCESS_LOG:-${LOG_DIR}/${SERVER_TYPE}-access.log}"
ERROR_LOG="${ERROR_LOG:-${LOG_DIR}/${SERVER_TYPE}-error.log}"

mkdir -p "$LOG_DIR"

# NOTE: uv sync is intentionally skipped here — dependencies are installed
# at image build time. Running uv sync on a live container conflicts with
# the read-only libs mount and adds unnecessary startup latency.

echo "🚀 Starting ${SERVER_TYPE}: ${APP_MODULE} on ${HOST}:${PORT}"
echo "🏥 Health: http://${HOST}:${PORT}/health/"
echo "📝 Access log: ${ACCESS_LOG}"
echo "📝 Error log: ${ERROR_LOG}"

# NOTE: The uvicorn branch below intentionally does NOT apply
# --max-requests / --limit-max-requests. The reload branch watches the
# filesystem for re-launch; the non-reload branch requires a process
# restart — note that `kill -HUP` is only honored as a reload trigger
# uvicorn-side when RELOAD=true. Adding the same limits here can be done
# in a follow-up.
if [ "$SERVER_TYPE" = "uvicorn" ]; then
    if [ "$RELOAD" = "true" ]; then
        ARGS=(
            "$APP_MODULE"
            "--host" "$HOST"
            "--port" "$PORT"
            "--reload"
            "--log-level" "debug"
            "--access-log"
        )
        IFS=',' read -ra DIR_ARRAY <<< "$WATCH_DIRS"
        for dir in "${DIR_ARRAY[@]}"; do
            dir_clean=$(echo "$dir" | xargs)
            [ -d "$dir_clean" ] && ARGS+=("--reload-dir" "$dir_clean")
        done
    else
        ARGS=(
            "$APP_MODULE"
            "--host" "$HOST"
            "--port" "$PORT"
            "--workers" "$WORKERS"
            "--log-level" "$LOG_LEVEL"
            "--access-log"
        )
    fi
    exec uvicorn "${ARGS[@]}" 2>> "$ERROR_LOG"
fi

if [ "$SERVER_TYPE" = "gunicorn" ]; then
    # Set PYTHONPATH for workers - use --env to pass it explicitly
    # Note: Gunicorn's --env flag passes the environment variable to workers
    export PYTHONPATH="${APP_HOME}/${SITE_DIR_NAME}/www:${APP_HOME}/${SITE_DIR_NAME}:${APP_HOME}"
    # Remove duplicate entries and trailing colons
    PYTHONPATH=$(echo "$PYTHONPATH" | tr ':' '\n' | awk '!seen[$0]++' | tr '\n' ':' | sed 's/:$//')
    ARGS=(
        "$APP_MODULE"
        "--bind" "${HOST}:${PORT}"
        "--workers" "$WORKERS"
        "--worker-class" "uvicorn.workers.UvicornWorker"
        "--max-requests" "$MAX_REQUESTS"
        "--max-requests-jitter" "$MAX_REQUESTS_JITTER"
        "--log-level" "$LOG_LEVEL"
        "--access-logfile" "$ACCESS_LOG"
        "--error-logfile" "$ERROR_LOG"
        "--capture-output"
        "--env" "PYTHONPATH=${PYTHONPATH}"
    )
    [ "$RELOAD" = "true" ] && ARGS+=("--reload")
    exec gunicorn "${ARGS[@]}"
fi

echo "Unsupported SERVER_TYPE='${SERVER_TYPE}'. Use 'gunicorn' or 'uvicorn'." >&2
exit 2

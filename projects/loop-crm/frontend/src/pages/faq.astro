---
// FAQ — data-driven from GET /apis/pages/faq/ (Wagtail → JSON).
import LandingLayout from '@/layouts/LandingLayout.astro';
import HeroSection from '@/components/landing/HeroSection.astro';
import FaqSection from '@/components/landing/FaqSection.astro';
import CtaSection from '@/components/landing/CtaSection.astro';
import EmptyState from '@/components/landing/EmptyState.astro';
import { fetchPage } from '@/lib/landing';

const { ok, page, error } = await fetchPage('faq');

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Pricing', href: '/pricing/' },
  { label: 'Source', href: 'https://github.com/mammhoud/structa.cloud' },
];
---
<LandingLayout title={page?.seo_title || 'FAQ — Loop CRM'} description={page?.search_description || 'Loop CRM frequently asked questions.'} navLinks={navLinks}>
  {
    !ok || !page ? (
      <EmptyState error={error} />
    ) : (
      <>
        {page.hero && <HeroSection hero={page.hero} />}
        {page.faq && <FaqSection faq={page.faq} head={page.faq_head} />}
        {page.cta && <CtaSection cta={page.cta} />}
      </>
    )
  }
</LandingLayout>

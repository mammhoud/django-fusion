---
// Landing homepage — data-driven from GET /apis/pages/home/ (Wagtail → JSON).
// No hard-coded landing copy: sections render only when the page payload
// provides them; when the backend is unreachable an explicit empty state is
// shown instead of resurrecting static content.
import LandingLayout from '@/layouts/LandingLayout.astro';
import HeroSection from '@/components/landing/HeroSection.astro';
import PricingSection from '@/components/landing/PricingSection.astro';
import FaqSection from '@/components/landing/FaqSection.astro';
import CtaSection from '@/components/landing/CtaSection.astro';
import { iconSvg } from '@/lib/icons';
import { fetchPage } from '@/lib/landing';

const { ok, page, error } = await fetchPage('home');
---
<LandingLayout
  title={page?.seo_title || 'Loop CRM · from social impression to closed deal'}
  description={page?.search_description || 'Loop CRM unifies CRM, social publishing, attribution, and finance. From social impression to closed deal, one platform, one source of truth.'}
>
  {
    !ok || !page ? (
      <section class="loop-empty">
        <div class="loop-empty__box">
          <p class="loop-eyebrow">Content unavailable</p>
          <h1>Landing content is offline</h1>
          <p>The backend that serves this page did not respond{error ? ` (${error})` : ''}. Start the Django backend and reload to see the Wagtail-managed landing.</p>
        </div>
      </section>
    ) : (
      <>
        {page.hero && <HeroSection hero={page.hero} visual />}

        {
          page.dna && page.dna.length > 0 && (
            <section class="loop-dna" aria-label="Project heritage">
              {page.dna.map((item) => (
                <div class="loop-dna__item"><span class="loop-dna__key">{item.label}</span><strong>{item.value}</strong></div>
              ))}
            </section>
          )
        }

        {
          page.features && page.features.length > 0 && (
            <section id="modules" class="loop-modules">
              <div class="loop-section-head" x-data="{ shown: false }" x-intersect.once="shown = true" :class="shown && 'is-shown'">
                {page.features_head?.eyebrow && <p class="loop-eyebrow">{page.features_head.eyebrow}</p>}
                {page.features_head?.title && <h2>{page.features_head.title}</h2>}
                {page.features_head?.description && <p class="loop-section-lede">{page.features_head.description}</p>}
              </div>
              <div class="loop-modules__grid">
                {page.features.map((mod, i) => (
                  <a
                    class:list={['loop-module', i === 0 && 'loop-module--wide', i === 2 && 'loop-module--tall']}
                    href={mod.href || '/crm/'}
                    x-data="{ shown: false }"
                    x-intersect.once="shown = true"
                    :class="shown && 'is-shown'"
                  >
                    <span class="loop-module__icon" set:html={iconSvg(mod.icon || 'crm', 20)} />
                    {mod.label && <span class="loop-module__label">{mod.label}</span>}
                    <h3>{mod.title}</h3>
                    {mod.description && <p>{mod.description}</p>}
                    <span class="loop-module__more">Open {mod.label || 'module'} <b aria-hidden="true">→</b></span>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        {
          page.steps && page.steps.length > 0 && (
            <section id="how" class="loop-how">
              <div class="loop-section-head" x-data="{ shown: false }" x-intersect.once="shown = true" :class="shown && 'is-shown'">
                {page.steps_head?.eyebrow && <p class="loop-eyebrow">{page.steps_head.eyebrow}</p>}
                {page.steps_head?.title && <h2>{page.steps_head.title}</h2>}
                {page.steps_head?.description && <p class="loop-section-lede">{page.steps_head.description}</p>}
              </div>
              <ol class="loop-steps">
                {page.steps.map((step) => (
                  <li class="loop-step" x-data="{ shown: false }" x-intersect.once="shown = true" :class="shown && 'is-shown'">
                    <span class="loop-step__n" aria-hidden="true">{step.number}</span>
                    <div><h3>{step.title}</h3>{step.copy && <p>{step.copy}</p>}</div>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          page.stats && page.stats.length > 0 && (
            <section class="loop-stats-band">
              <div class="loop-section-head" x-data="{ shown: false }" x-intersect.once="shown = true" :class="shown && 'is-shown'">
                {page.stats_head?.eyebrow && <p class="loop-eyebrow">{page.stats_head.eyebrow}</p>}
                {page.stats_head?.title && <h2>{page.stats_head.title}</h2>}
                {page.stats_head?.description && <p class="loop-section-lede">{page.stats_head.description}</p>}
              </div>
              <div class="loop-stats-grid">
                {page.stats.map((stat) => (
                  <div class="loop-stat"><strong>{stat.value}{stat.suffix}</strong><span>{stat.label}</span></div>
                ))}
              </div>
            </section>
          )
        }

        {page.pricing && <PricingSection pricing={page.pricing} head={page.pricing_head} />}
        {page.faq && <FaqSection faq={page.faq} head={page.faq_head} />}
        {page.cta && <CtaSection cta={page.cta} />}
      </>
    )
  }
</LandingLayout>

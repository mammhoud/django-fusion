---
// Loop-CRM base layout — global head + HTMX/Alpine bootstrapping.
// React islands (RevOps board, pipeline) mount their own Redux <Provider>
// via a client-side island component; the layout itself stays Astro-native so
// Astro's <slot /> keeps working (you can't nest Astro slots inside a React
// component). Mirrors landing-fusion's Layout.astro with a CRM-tuned theme.
import '../styles/globals.css';
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Loop CRM connects social touchpoints, customer relationships, and influenced revenue in one workspace." />
    <meta name="theme-color" content="#0b1114" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%23142a27'/%3E%3Cpath d='M19 32a13 13 0 1 1 6 10' fill='none' stroke='%23b6e3d1' stroke-width='6' stroke-linecap='round'/%3E%3Cpath d='m38 20 8 1-3 7' fill='none' stroke='%238bcbb5' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <title>{Astro.props.title ?? 'Loop CRM'}</title>
    <slot name="head" />
  </head>
  <body class="loop-site-body" hx-boost="true" hx-target="#loop-app-content" hx-select="#loop-app-content" hx-swap="outerHTML" hx-indicator="#loop-app-loader">
    <div id="loop-app-loader" class="loop-app-loader" aria-hidden="true"></div>
    <slot />
    <script>
      // HTMX bundled by Vite (no raw /node_modules/ path that would 404 in a
      // static build).
      import 'htmx.org';
    </script>
  </body>
</html>

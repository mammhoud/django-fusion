# Loop-CRM frontend environment (all values overridable, defaults shown)
# Dev server port for the Astro frontend.
PORT=4321
# Django backend origin the dev proxy forwards /api, /admin, /fragment to.
BACKEND_URL=http://127.0.0.1:8000
# Canonical public site URL (SEO/sitemap).
PUBLIC_SITE_URL=https://crm.structa.cloud
# Browser-visible backend base for the data-API road (Redux store).
PUBLIC_BACKEND_URL=http://127.0.0.1:8000
# Canonical API prefix. Set /api/v1 for the Django compatibility road when
# django-fusion[bolt] is not installed.
PUBLIC_API_PREFIX=/bolt
# Used after a Bolt 401/404 or when the Bolt runtime is unavailable.
PUBLIC_API_FALLBACK_PREFIX=/api/v1

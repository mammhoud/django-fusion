digraph model_graph {
  // Dotfile by Django-Extensions graph_models
  // Created: 2026-09-06 02:04
  

  fontname = "Roboto"
  fontsize = 8
  splines  = true
  rankdir = "TB"
  

  node [
    fontname = "Roboto"
    fontsize = 8
    shape = "plaintext"
  ]

  edge [
    fontname = "Roboto"
    fontsize = 8
  ]


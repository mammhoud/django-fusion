---
/** Breadcrumb navigation — schema.org compliant.
 *
 * Usage:
 *   <Breadcrumb items={[{label:"Home",href:"/"},{label:"About",href:"/about/"}]} current="About" />
 */
interface BreadcrumbItem { label: string; href: string; }
interface Props {
  items: BreadcrumbItem[];
  current?: string;
  class?: string;
}
const { items, current, class: cls } = Astro.props;
---

<nav aria-label="Breadcrumb" class={cls}>
  <ol
    class="flex flex-wrap items-center gap-1.5 font-mono text-[0.72rem] uppercase tracking-[0.12em] text-fu-muted"
    itemscope
    itemtype="https://schema.org/BreadcrumbList"
  >
    {items.map((item, i) => {
      const isLast = i === items.length - 1 && !current;
      return (
        <li
          class="flex items-center gap-1.5"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/ListItem"
        >
          <meta itemprop="position" content={String(i + 1)} />
          {isLast ? (
            <span class="text-fu-ink font-medium" itemprop="name" aria-current="page">
              {item.label}
            </span>
          ) : (
            <a
              href={item.href}
              class="transition-colors hover:text-fu-link"
              itemprop="item"
            >
              <span itemprop="name">{item.label}</span>
            </a>
          )}
          {!isLast && (
            <svg class="h-3 w-3 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          )}
        </li>
      );
    })}
    {current && (
      <li class="text-fu-ink font-medium" aria-current="page">
        {!items.length ? null : (
          <svg class="mr-1.5 inline h-3 w-3 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        )}
        {current}
      </li>
    )}
  </ol>
</nav>

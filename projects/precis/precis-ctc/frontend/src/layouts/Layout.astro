---
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import CookieConsent from '@/components/ui/CookieConsent.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import LoginModal from '@/components/ui/LoginModal.astro';
import { THEME_STORAGE_KEY, fallbackSiteName, ogImage as fallbackOgImage, siteUrl } from '@/lib/site';

/**
 * Resolve the SEO metadata for the current page from backend data.
 *
 * Per-page Wagtail fields (seo_title / search_description) win; the site
 * defaults (SiteSettings — meta description/keywords/author, og:type, og
 * image, twitter handle, robots, canonical origin) fill the gaps. The only
 * hardcoded value is the config-level origin (siteUrl) and the brand
 * fallback used when the backend is entirely unreachable at build time.
 */
interface SeoMeta {
  title: string;
  description: string;
  keywords: string;
  author: string;
  ogType: string;
  ogImage: string;
  twitterHandle: string;
  robots: string;
  canonical: string;
}

function resolveSeo(pageData: Props['pageData'], siteSettings: Props['siteSettings'], fallbackTitle: string, fallbackDescription: string, fallbackImage: string): SeoMeta {
  const pageSeo = pageData?.seo as Record<string, string> | undefined;
  const title = pageSeo?.title || pageData?.title || fallbackTitle;
  const description = pageSeo?.description || fallbackDescription;
  const ogImage = pageSeo?.og_image_url || siteSettings?.og_image_url || fallbackImage;
  const canonicalOrigin = siteSettings?.canonical_url || siteUrl;
  return {
    title,
    description,
    keywords: pageSeo?.keywords || siteSettings?.meta_keywords || '',
    author: pageSeo?.author || siteSettings?.meta_author || '',
    ogType: pageSeo?.og_type || siteSettings?.og_type || 'website',
    ogImage,
    twitterHandle: pageSeo?.twitter_handle || siteSettings?.twitter_handle || '',
    robots: pageSeo?.robots || siteSettings?.robots || 'index, follow',
    canonical: `${canonicalOrigin.replace(/\/+$/, '')}${Astro.url.pathname}`,
  };
}
import { cachedAssets } from '@/lib/api';
import AssetPreload from '@/components/ui/AssetPreload.astro';
import SkeletonBridge from '@/components/ui/SkeletonBridge.astro';
import '../styles/globals.css';
import faviconPath from '@assets/static/images/favicon-enhanced.svg';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Backend-fetched navigation items (from /apis/navigation/). */
  navItems?: { label: string; href: string; external?: boolean }[];
  /** Backend-fetched site settings (from /apis/site/settings/). */
  siteSettings?: {
    site_name?: string;
    site_tagline?: string;
    logo_url?: string | null;
    meta_keywords?: string;
    meta_author?: string;
    og_type?: string;
    og_image_url?: string | null;
    twitter_handle?: string;
    robots?: string;
    canonical_url?: string;
    footer_description?: string;
    footer_copyright?: string;
    footer_link_groups?: { title: string; links: { label: string; url: string }[] }[];
    social_links?: { platform: string; label: string; url: string; icon_class: string }[];
  };
  /** Backend-fetched page data for the current route (from /apis/pages/<slug>/). */
  pageData?: import('@/lib/api').PageData | null;
  /** Slug of the current page, used as the cache key in the Redux pageSlice. */
  pageSlug?: string;
  /** Visual family for the global navigation and page header treatment. */
  pageVariant?: 'home' | 'research' | 'learning' | 'archive' | 'legal' | 'network' | 'contact' | 'product';
}

const {
  title = '',
  description = '',
  ogImage = fallbackOgImage,
  navItems,
  siteSettings,
  pageData = null,
  pageSlug = '',
  pageVariant,
} = Astro.props;

const resolvedPageVariant = pageVariant || (
  pageSlug === 'home' || !pageSlug ? 'home' :
  pageSlug.startsWith('course') || pageSlug === 'courses' || pageSlug === 'about/education' ? 'learning' :
  pageSlug.startsWith('blog') || pageSlug === 'documents' || pageSlug === 'events' ? 'archive' :
  pageSlug === 'privacy' ? 'legal' :
  pageSlug === 'team' || pageSlug.startsWith('profile') ? 'network' :
  pageSlug === 'contact' ? 'contact' :
  pageSlug.startsWith('product') || pageSlug === 'products' ? 'product' :
  'research'
);

let assetManifest: Awaited<ReturnType<typeof cachedAssets>> | null = null;
try {
  assetManifest = await cachedAssets();
} catch {
  // The document remains renderable when the backend asset API is unavailable.
}

const siteName = siteSettings?.site_name || fallbackSiteName;
const seo = resolveSeo(pageData, siteSettings, title || siteName, description, ogImage);
const pageTitle = seo.title && seo.title !== siteName ? `${seo.title} \u00b7 ${siteName}` : siteName;
const canonical = seo.canonical;

// Single source of truth for the two content-delivery roads: the effective
// render mode (server-rendered components vs data APIs) comes from the assets
// manifest (fusion_render_first) served by GET /apis/assets/, and the merged
// manifest itself carries the CSS/fonts/scripts AssetPreload preloads. Both
// are bridged into Redux so the whole app reads one config source. The
// content pointers describe the current page on each road.
const contentSlug = pageSlug || 'home';
const renderMode = assetManifest
  ? {
      fusion_render_first: assetManifest.fusion_render_first,
      mode: (assetManifest.fusion_render_first ? 'fusion-render' : 'data-api') as 'fusion-render' | 'data-api',
      content: { html: `/fragment/pages/${contentSlug}/`, data: `/apis/pages/${contentSlug}/` },
    }
  : null;

// The SSR bridge payload. Serialized here (frontmatter) and injected with
// set:html below: Astro never evaluates template expressions inside inline
// or module script tags, so the JSON must be pre-built and escaped so that
// embedded closing-tag sequences in page content cannot break the script.
const bridgeJson = JSON.stringify({
  siteSettings: siteSettings ?? null,
  navItems: navItems ?? [],
  pageData: pageData ?? null,
  pageSlug: pageSlug ?? '',
  renderMode: renderMode ?? null,
  assets: assetManifest ?? null,
}).replace(/</g, '\\u003c');

void THEME_STORAGE_KEY;
---

<!doctype html>    <html lang={pageData?.language || 'en'} id="ctc-root" data-language={pageData?.language || 'en'} data-page-slug={contentSlug}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={seo.description} />
    {seo.keywords ? <meta name="keywords" content={seo.keywords} /> : null}
    {seo.author ? <meta name="author" content={seo.author} /> : null}
    <meta name="robots" content={seo.robots} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={seo.ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={new URL(seo.ogImage, siteUrl).href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={new URL(seo.ogImage, siteUrl).href} />
    {seo.twitterHandle ? <meta name="twitter:site" content={`@${seo.twitterHandle}`} /> : null}

    <meta name="theme-color" content="#F8FAFB" />

    <script is:inline define:vars={{ THEME_STORAGE_KEY }}>
      (function () {
        var root = document.documentElement;
        // Reveal motion is progressive enhancement: content stays visible
        // unless JavaScript explicitly opts the document into motion.
        root.classList.add('js');
        // Scroll reveals are enabled only after Alpine confirms its
        // directives are available. Until then the server-rendered document
        // remains fully readable — including when Alpine fails to load, so
        // x-intersect reveals can never strand content at opacity 0.
        document.addEventListener('alpine:init', function () {
          root.classList.add('fusion-motion-ready');
        }, { once: true });
        var stored = null;
        try { stored = localStorage.getItem(THEME_STORAGE_KEY); } catch (e) {}
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var dark = stored ? stored === 'dark' : prefersDark;
        root.classList.remove('light', 'dark');
        root.classList.add(dark ? 'dark' : 'light');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', dark ? '#0F172A' : '#F8FAFB');
      })();
    </script>

    <!-- Keep document metadata and RTL direction aligned with the persisted
         Django/Wagtail language before the static shell paints. -->
    <script is:inline>
      (function () {
        var supported = ['en', 'sv', 'fr', 'de', 'es', 'ar', 'pt-br'];
        var code = null;
        try {
          code = new URLSearchParams(window.location.search).get('lang') || sessionStorage.getItem('ctc_lang') || localStorage.getItem('ctc_lang') || document.cookie.match(/(?:^|; )django_language=([^;]+)/)?.[1];
        } catch (e) {}
        if (!supported.includes(code)) code = document.documentElement.getAttribute('lang') || 'en';
        document.documentElement.setAttribute('lang', code);
        document.documentElement.setAttribute('dir', code === 'ar' ? 'rtl' : 'ltr');
        document.documentElement.dataset.language = code;
      })();
    </script>

    <!-- Site-wide runtime localization: the static shell is baked in the
         build language; when the visitor requests another locale via ?lang=,
         storage, or cookie, hydrate visible copy from the authoritative
         localized Wagtail API (see lib/runtime-locale.ts). Every page opts
         in through data-l10n attributes; chrome (header/footer/catalog)
         translates via the bundled UI_COPY dictionary. -->
    <script>
      import { syncRuntimeLocale } from '../lib/runtime-locale';
      syncRuntimeLocale(document.documentElement.dataset.pageSlug || 'home');
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href={faviconPath.src} />
    <AssetPreload manifest={assetManifest} />
  </head>
  <body class="is-hydrating">
    <!-- HTMX global in-flight indicator — shows a branded skeleton overlay
         while hx- requests are pending.  Toggled by htmx-bootstrap.ts via
         the `.htmx-request` class.  Respects reduced-motion preference. -->
    <div
      id="htmx-global-indicator"
      class="htmx-indicator-overlay"
      aria-hidden="true"
      role="status"
      aria-live="polite"
    >
      <!-- Progress bar (top edge) -->
      <div class="htmx-indicator-progress" aria-hidden="true">
        <div class="htmx-indicator-progress__bar"></div>
      </div>

      <!-- Request target label — shows which region is being swapped -->
      <p class="htmx-indicator__target" id="htmx-indicator-target" aria-hidden="true"></p>

      <!-- Branded skeleton: hero → stats → cards mirrors a full page layout -->
      <div class="htmx-indicator-skeleton">
        <!-- Hero skeleton -->
        <div class="htmx-indicator-skeleton__hero">
          <span class="fusion-skeleton__line fusion-skeleton__line--tag" style="width:10rem;margin-inline:auto"></span>
          <span class="fusion-skeleton__line fusion-skeleton__line--hero"></span>
          <span class="fusion-skeleton__line" style="width:55%"></span>
          <div class="htmx-indicator-skeleton__ctas">
            <span class="fusion-skeleton__line fusion-skeleton__line--btn" style="width:9rem"></span>
            <span class="fusion-skeleton__line fusion-skeleton__line--btn" style="width:8rem;opacity:0.6"></span>
          </div>
        </div>

        <!-- Stats row skeleton -->
        <div class="htmx-indicator-skeleton__stats">
          {[1,2,3,4].map(() => (
            <span class="htmx-indicator-skeleton__stat">
              <span class="fusion-skeleton__line fusion-skeleton__line--stat-value" style="width:4rem"></span>
              <span class="fusion-skeleton__line" style="width:70%"></span>
            </span>
          ))}
        </div>

        <!-- Card grid skeleton -->
        <div class="htmx-indicator-skeleton__cards">
          {[1,2,3].map(() => (
            <span class="fusion-skeleton__card"></span>
          ))}
        </div>
      </div>

      <!-- Footer hint — switches between "Loading…" and elapsed time -->
      <p class="htmx-indicator__hint" id="htmx-indicator-hint">
        <span class="htmx-indicator__pulse" aria-hidden="true"></span>
        One moment&hellip; bringing in the latest content.
      </p>
    </div>

    <div class="flex min-h-screen flex-col">
      <Header siteName={siteName} navItems={navItems} logoUrl={siteSettings?.logo_url || "/static/images/logo-enhanced.svg"} pageVariant={resolvedPageVariant} />
      <main class="flex-1 pt-24 md:pt-28">
        <slot />
      </main>
      <Footer siteSettings={siteSettings} siteName={siteName} />
    </div>

    <LoginModal />

    <CookieConsent />

    <!-- SSR data bridge → Redux initial state (site + page + config).
         Injected via set:html so Astro emits the pre-serialized JSON verbatim
         (template expressions are never evaluated inside <script> tags). -->
    <Fragment set:html={`<script type="application/json" id="fusion-site-data">${bridgeJson}</script>`} />

    <!-- Skeleton → hydration pipeline: renders backend-driven skeletons,
         lazy-loads per-component JS/CSS, and swaps on htmx:afterSettle.
         Degrades gracefully when the Django road's globals are absent. -->
    <SkeletonBridge />

    <!-- Typed Redux runtime — the single client store for SSR site/page data. -->
    <script>
      import '../lib/store/init';
    </script>

    <!-- Fusion modular bundle — scroll reveal, smooth anchors, fragment
         hydration + typed module re-exports (see src/fusion/). -->
    <script>
      import '../fusion';
    </script>

    <!-- Load the small interaction layer globally so the newsletter signup in
         the footer works on every page, including pages without other live
         content. -->
    <HtmxBootstrap />
  </body>
</html>

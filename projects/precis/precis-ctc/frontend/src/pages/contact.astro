---
import Layout from '@/layouts/Layout.astro';
import ContactForm from '@/components/blocks/ContactForm.astro';
import PageHeader from '@/components/blocks/PageHeader.astro';
import NewsletterSubscribe from '@/components/blocks/NewsletterSubscribe.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import ContentError from '@/components/ui/ContentError.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation, cachedContact } from '@/lib/api';
import type { SiteSettings, NavigationData, ContactData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let contactData: ContactData | undefined;
try {
  [siteSettings, navData, contactData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedContact(),
  ]);
} catch { /* use fallbacks */ }

const methods = contactData?.methods;
---

<Layout title={contactData?.title || 'Contact · unavailable'} description={contactData?.description || 'Backend contact content unavailable.'} navItems={navData?.nav_items} siteSettings={siteSettings} pageSlug="contact">
  {contactData ? (
    <>
      <PageHeader
        eyebrow="contact · ctc research"
        title={contactData.title}
        intro={contactData.description}
        variant="contact"
        index="08"
        primaryCta={{ label: 'Send a research brief', href: '#contact-form' }}
        secondaryCta={{ label: 'Browse services', href: '/services/' }}
      />
      <div id="contact-form" class='py-14'>
        <ContactForm methods={methods} formTitle={contactData.form_title} formDescription={contactData.form_description} fields={contactData.fields} />
      </div>
      <NewsletterSubscribe />
    </>
  ) : <ContentError label="Contact content is unavailable from the backend." />}
  <Toast />
  <HtmxBootstrap />
</Layout>

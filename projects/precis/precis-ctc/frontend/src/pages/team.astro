---
import Layout from '@/layouts/Layout.astro';
import TeamSection from '@/components/blocks/TeamSection.astro';
import PageHeader from '@/components/blocks/PageHeader.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData, TeamMember } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('team'),
  ]);
} catch { /* use fallbacks */ }

// Map the backend team_members shape onto TeamSection's props. Names and
// bios come from the localized TeamPage — no hardcoded members anywhere.
const members = (pageData?.team_members || []).map((m: TeamMember) => ({
  name: m.name || '',
  role: m.position || '',
  image: m.photo?.url,
  initials: (m.name || '').split(/\s+/).map((p) => p[0]).join('').slice(0, 2).toUpperCase(),
  bio: m.bio,
  links: [
    m.linkedin ? { platform: 'linkedin', url: m.linkedin, label: 'LinkedIn' } : null,
    m.twitter ? { platform: 'website', url: m.twitter, label: 'Twitter' } : null,
    m.facebook ? { platform: 'website', url: m.facebook, label: 'Facebook' } : null,
  ].filter(Boolean) as { platform: string; url: string; label: string }[],
}));
---

<Layout
  title={pageData?.title || 'Our Team'}
  description={pageData?.search_description || 'Meet the team behind CTC Research.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="team"
>
  <PageHeader
    eyebrow="the research network"
    title={pageData?.team_title || 'Meet the team'}
    intro={pageData?.team_subtitle || 'Academic, clinical, and analytical collaborators connected by a shared research method.'}
    variant="network"
    index="06"
    status="200 OK · research network"
    primaryCta={{ label: 'Work with the team', href: '/contact/' }}
    secondaryCta={{ label: 'Our approach', href: '/about/research/' }}
  />

  {members.length ? (
    <TeamSection
      eyebrow="the team"
      title={pageData?.team_title || 'Meet the team'}
      description={pageData?.team_subtitle}
      members={members}
    />
  ) : (
    <section class="team doc-sheet bg-fu-paper py-20 md:py-28">
      <div class="container-fusion team__header">
        <p class="tag-marker mb-4">the research network</p>
        <h2 class="font-display text-4xl font-bold tracking-tight text-fu-ink md:text-5xl">Meet the research network</h2>
        <p class="mt-4 text-fu-muted">Our academic, clinical, and analytical collaborators are introduced as each profile is ready. Start with the research question and we will connect the right expertise.</p>
        <a class="btn-primary mt-8 inline-flex" href="/contact/">Work with the team</a>
      </div>
    </section>
  )}

  <Toast />
</Layout>

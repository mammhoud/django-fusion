---
import Layout from '@/layouts/Layout.astro';
import FAQ from '@/components/blocks/FAQ.astro';
import PageHeader from '@/components/blocks/PageHeader.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('faq'),
  ]);
} catch { /* use fallbacks */ }

const pageCta = pageData?.cta;
const pageFaq = (pageData?.faq as any[] | undefined);

// All content is Wagtail-driven — no hardcoded fallback copy. The backend
// seeds FAQ items into the Wagtail page for this slug (exposed via
// /apis/pages/faq/); an empty list renders nothing rather than static text.
const faqItems = pageFaq?.length ? pageFaq.map((f: any) => ({
  question: String(f.question || ''),
  answer: String(f.answer || ''),
})) : [];
---

<Layout title={pageData?.title || 'FAQ'} description={pageData?.search_description || 'Frequently asked questions about CTC Research — clinical research, evidence synthesis, and health innovation.'} navItems={navData?.nav_items} siteSettings={siteSettings} pageData={pageData} pageSlug="faq">
  <PageHeader
    eyebrow="faq · ctc research"
    title="Frequently asked questions"
    intro="Everything you need to know about CTC Research — learning paths, research programs, and evidence services."
    variant="research"
    index="09"
    primaryCta={{ label: 'Contact the center', href: '/contact/' }}
    secondaryCta={{ label: 'Browse courses', href: '/courses/' }}
  />

  {faqItems.length ? (
  <div class='py-14'>
    <FAQ items={faqItems} />
  </div>
  ) : null}

  <CTA heading={pageCta?.title || 'Still have questions?'} intro={pageCta?.subtitle || 'Reach out through the contact form and we will get back to you.'} ctaLabel={pageCta?.primary_cta?.label || 'Contact us'} ctaHref={pageCta?.primary_cta?.href || '/contact/'} />
  <Toast />
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import FAQ from '@/components/blocks/FAQ.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('faq'),
  ]);
} catch { /* use fallbacks */ }

const pageCta = pageData?.cta;
const pageFaq = (pageData?.faq as any[] | undefined);

const faqItems = pageFaq?.length ? pageFaq.map((f: any) => ({
  question: String(f.question || ''),
  answer: String(f.answer || ''),
})) : [
  { question: 'Can you help define a clinical research question?', answer: 'Yes. We translate a clinical need into a focused question, estimand, protocol, and outcome definition before analysis begins.' },
  { question: 'Do you support systematic reviews and evidence synthesis?', answer: 'Our evidence workflow covers search strategy, screening, extraction, appraisal, synthesis, and transparent reporting.' },
  { question: 'Do you provide medical and scientific writing support?', answer: 'We help research teams structure methods and results, clarify the discussion, and prepare publication-ready manuscripts.' },
  { question: 'Are your courses designed for clinicians and researchers?', answer: 'Yes. The learning paths use applied examples from clinical research, biostatistics, medical AI, and publication integrity.' },
  { question: 'How do we start a research collaboration?', answer: 'Send the research question, current protocol or dataset summary, and intended outcome through the contact page. We will propose a focused next step.' },
];
---

<Layout title={pageData?.title || 'FAQ'} description={pageData?.search_description || 'Frequently asked questions about CTC Research — medical AI, clinical evidence, and health innovation.'} navItems={navData?.nav_items} siteSettings={siteSettings} pageData={pageData} pageSlug="faq">
  <section class='section-hero reg-marks overflow-hidden py-16'>
    <div class='container-fusion'>
      <div class='mx-auto max-w-2xl text-center'>
        <p class='tag-marker mb-5'>faq</p>
        <h1 class='mb-4 font-display text-4xl font-bold tracking-tight md:text-5xl'>Frequently asked questions</h1>
        <p class='text-lg text-fu-muted'>Everything you need to know about CTC Research — learning paths, research programs, and evidence services.</p>
      </div>
    </div>
  </section>

  <div class='py-14'>
    <FAQ items={faqItems} />
  </div>

  <CTA heading={pageCta?.title || 'Still have questions?'} intro={pageCta?.subtitle || 'Reach out through the contact form and we will get back to you.'} ctaLabel={pageCta?.primary_cta?.label || 'Contact us'} ctaHref={pageCta?.primary_cta?.href || '/contact'} />
  <Toast />
</Layout>

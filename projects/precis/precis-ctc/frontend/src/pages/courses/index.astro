---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import CTA from '@/components/blocks/CTA.astro';
import ContentError from '@/components/ui/ContentError.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import { cachedSiteSettings, cachedNavigation, fetchCourseList } from '@/lib/api';
import type { CourseCard, CourseListData, NavigationData, SiteSettings } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let catalog: CourseListData | undefined;
try {
  [siteSettings, navData, catalog] = await Promise.all([
    cachedSiteSettings(),
    cachedNavigation(),
    fetchCourseList(),
  ]);  } catch {
    // The backend-owned error state below is rendered when content cannot be loaded.
  }

const courses = catalog?.data ?? [];
const totalCourses = catalog?.pagination.total ?? courses.length;
const formatDifficulty = (value: string) => value.replace(/\b\w/g, (char) => char.toUpperCase());
const formatPrice = (value: number) =>
  value > 0 ? `$${Number(value).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}` : 'Free';
const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
---

<Layout
  title="Courses"
  description="CTC Research courses help clinicians, researchers, and medical writers make stronger decisions — from protocol to publication. Clinical trial design, biostatistics, evidence synthesis, medical AI, and scientific writing."
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageSlug="courses"
>
  <Hero
    eyebrow="ctc research · medical learning"
    heading="Build evidence that"
    accent="moves medicine forward"
    intro="Practical courses for clinicians, researchers, medical writers, and data teams working at the intersection of rigorous science and responsible technology."
    primaryCta={{ label: 'Browse the catalog', href: '#catalog' }}
    secondaryCta={{ label: 'Explore research services', href: '/services/' }}
    variant="learning"
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Courses' }]}
  />

  <section id="catalog" class="doc-sheet bg-fu-surface py-20 md:py-24">
    <div class="container-fusion">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <p class="tag-marker mb-4">the catalog</p>
        <div class="flex items-center justify-center gap-3">
          <h2 class="mb-0 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl">Research, from protocol to publication</h2>
        </div>
        <p class="mt-3 text-fu-muted">Each course combines methodological clarity with practical workflows you can apply to your next study, review, dataset, or manuscript.</p>
        <p class="mt-4 inline-block border-2 border-fu-ink bg-fu-paper px-4 py-1.5 font-mono text-[0.72rem] uppercase tracking-[0.16em] text-fu-link">
          <span class="font-semibold">{totalCourses}</span> courses in catalog · search · filter · sort
        </p>
      </div>

      {courses.length ? (
        <div
          class="catalog"
          x-data="courseCatalog()"
          data-view="grid"
        >
          <!-- ═══ Toolbar — counter · search · view toggle · filter toggle ═══ -->
          <div class="catalog__toolbar">
            <p class="catalog__counter" aria-live="polite">
              <span x-text="`${count}`">0</span> / <span x-text="`${total}`">0</span> courses
              <span class="catalog__counter-active" x-show="activeCount > 0" x-cloak>
                · <span x-text="`${activeCount}`">0</span> active filter<span x-text="activeCount === 1 ? '' : 's'"></span>
              </span>
            </p>

            <div class="catalog__tools">
              <div class="catalog__search">
                <svg class="catalog__search-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.4"/>
                  <path d="M9.5 9.5L13 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
                <input
                  type="search"
                  class="catalog__search-input"
                  placeholder="Search courses…"
                  data-i18n-placeholder="catalog_search"
                  x-model="q"
                  @input="apply()"
                  aria-label="Search courses"
                />
                <kbd class="catalog__search-kbd">/</kbd>
              </div>

              <div class="catalog__view-toggle" role="group" aria-label="Layout">
                <button
                  type="button"
                  class="catalog__view-btn"
                  :class="{ 'is-active': view === 'grid' }"
                  @click="setView('grid')"
                  aria-label="Grid view"
                  :aria-pressed="view === 'grid' ? 'true' : 'false'"
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <rect x="1" y="1" width="5" height="5" stroke="currentColor" stroke-width="1.3"/>
                    <rect x="8" y="1" width="5" height="5" stroke="currentColor" stroke-width="1.3"/>
                    <rect x="1" y="8" width="5" height="5" stroke="currentColor" stroke-width="1.3"/>
                    <rect x="8" y="8" width="5" height="5" stroke="currentColor" stroke-width="1.3"/>
                  </svg>
                  <span class="catalog__view-label" data-i18n="catalog_grid">Grid</span>
                </button>
                <button
                  type="button"
                  class="catalog__view-btn"
                  :class="{ 'is-active': view === 'list' }"
                  @click="setView('list')"
                  aria-label="List view"
                  :aria-pressed="view === 'list' ? 'true' : 'false'"
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M1 3h12M1 7h12M1 11h12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                  </svg>
                  <span class="catalog__view-label" data-i18n="catalog_list">List</span>
                </button>
              </div>

              <button type="button" class="catalog__filter-toggle" @click="showFilters = !showFilters" :aria-expanded="showFilters.toString()">
                <span data-i18n="catalog_filters">Filters</span>
                <span class="catalog__filter-count" x-show="activeCount > 0" x-cloak x-text="activeCount">0</span>
                <svg class="catalog__filter-chevron" :class="{ 'is-open': showFilters }" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- ═══ Filter panel — collapsible, responsive ═══ -->
          <div class="catalog__filters" x-show="showFilters" x-cloak
            x-transition:enter="catalog-fade" x-transition:enter-start="catalog-fade-start"
            x-transition:enter-end="catalog-fade-end" x-transition:leave="catalog-fade"
            x-transition:leave-start="catalog-fade-end" x-transition:leave-end="catalog-fade-start">
            <div class="catalog__filter-group">
              <span class="catalog__filter-label" data-i18n="catalog_sort">Sort by</span>
              <select class="catalog__select" x-model="sort" @change="apply()" aria-label="Sort courses">
                <option value="default">Default</option>
                <option value="rating">Rating (high → low)</option>
                <option value="price-asc">Price (low → high)</option>
                <option value="price-desc">Price (high → low)</option>
                <option value="duration">Duration (shortest)</option>
                <option value="title">Title (A–Z)</option>
              </select>
            </div>

            <div class="catalog__filter-group">
              <span class="catalog__filter-label" data-i18n="catalog_difficulty">Difficulty</span>
              <div class="catalog__options">
                <template x-for="opt in options.difficulties" :key="opt">
                  <label class="catalog__option">
                    <input type="checkbox" :value="opt" x-model="difficulty" @change="apply()" />
                    <span x-text="opt"></span>
                  </label>
                </template>
              </div>
            </div>

            <div class="catalog__filter-group">
              <span class="catalog__filter-label" data-i18n="catalog_language">Language</span>
              <select class="catalog__select" x-model="language" @change="apply()" aria-label="Filter by language">
                <option value="" data-i18n="catalog_all_languages">All languages</option>
                <template x-for="opt in options.languages" :key="opt">
                  <option :value="opt" x-text="opt.toUpperCase()"></option>
                </template>
              </select>
            </div>

            <div class="catalog__filter-group">
              <span class="catalog__filter-label" data-i18n="catalog_specialization">Specialization</span>
              <select class="catalog__select" x-model="spec" @change="apply()" aria-label="Filter by specialization">
                <option value="" data-i18n="catalog_all_specializations">All specializations</option>
                <template x-for="opt in options.specs" :key="opt">
                  <option :value="opt" x-text="opt"></option>
                </template>
              </select>
            </div>

            <div class="catalog__filter-group catalog__filter-group--wide">
              <span class="catalog__filter-label" data-i18n="catalog_topics">Topics</span>
              <div class="catalog__chips">
                <template x-for="opt in options.tags" :key="opt">
                  <button type="button" class="catalog__chip" :class="{ 'is-active': tags.includes(opt) }" @click="toggleTag(opt)">
                    <span x-text="opt"></span>
                  </button>
                </template>
              </div>
            </div>

            <div class="catalog__filter-group">
              <span class="catalog__filter-label" data-i18n="catalog_offer">Offer</span>
              <select class="catalog__select" x-model="offer" @change="apply()" aria-label="Filter by price">
                <option value="all" data-i18n="catalog_free_paid">Free &amp; paid</option>
                <option value="free" data-i18n="catalog_free_only">Free only</option>
                <option value="paid" data-i18n="catalog_paid_only">Paid only</option>
              </select>
            </div>

            <div class="catalog__filter-group">
              <span class="catalog__filter-label" data-i18n="catalog_extras">Extras</span>
              <div class="catalog__options">
                <label class="catalog__option">
                  <input type="checkbox" x-model="cert" @change="apply()" />
                  <span data-i18n="catalog_certificate">Certificate included</span>
                </label>
              </div>
            </div>

            <div class="catalog__filter-actions">
              <button type="button" class="catalog__clear" @click="clear()">
                <span data-i18n="catalog_clear">Clear all filters</span>
              </button>
            </div>
          </div>

          <!-- ═══ Course grid / list ═══ -->
          <div class="catalog__grid">
            {courses.map((course: CourseCard, index: number) => {
              const price = Number(course.price || 0);
              const isFree = price === 0;
              const specs = (course.specializations || []).map(slugify).join(' ');
              const tags = (course.tags || []).map(slugify).join(' ');
              return (
                <a
                  href={`/courses/${course.slug}/`}
                  class="c-course"
                  data-difficulty={(course.difficulty || '').toLowerCase()}
                  data-language={(course.language || '').toLowerCase()}
                  data-specs={specs}
                  data-tags={tags}
                  data-price={price}
                  data-rating={Number(course.rating || 0)}
                  data-duration={Number(course.duration || 0)}
                  data-cert={course.has_certificate ? '1' : '0'}
                  data-free={isFree ? '1' : '0'}
                  data-search={`${course.title} ${course.short_description || ''}`.toLowerCase()}
                  style={`--c-index: ${String(index + 1).padStart(2, '0')}`}
                >
                  <div class="c-course__head">
                    <span class="c-course__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    <span class="badge-primary">{formatDifficulty(course.difficulty)}</span>
                    {course.is_featured && <span class="c-course__featured">featured</span>}
                  </div>

                  <div class="c-course__body">
                    <h3 class="c-course__title">{course.title}</h3>
                    <p class="c-course__desc">{course.short_description}</p>
                    {tags && (
                      <div class="c-course__tags">
                        {(course.tags || []).slice(0, 3).map((tag: string) => <span class="c-course__tag">{tag}</span>)}
                      </div>
                    )}
                  </div>

                  <div class="c-course__meta">
                    <span class="c-course__meta-item c-course__meta-item--lang">{String(course.language).toUpperCase()}</span>
                    <span class="c-course__meta-item">
                      {Number(course.rating || 0) > 0
                        ? <>{'★'.repeat(Math.min(5, Math.round(Number(course.rating))))} {Number(course.rating).toFixed(1)}</>
                        : <span class="c-course__meta-muted">new</span>}
                    </span>
                    <span class="c-course__meta-item">{course.duration}h</span>
                    <span class="c-course__meta-item c-course__meta-item--price">{formatPrice(price)}</span>
                    <span class="c-course__cta">View course →</span>
                  </div>
                </a>
              );
            })}
          </div>

          <!-- ═══ Empty state — no JS fallback never shows this ═══ -->
          <div class="catalog__empty" x-show="count === 0" x-cloak>
            <p class="tag-marker mb-3">no matches</p>
            <h3 class="mb-2 font-display text-xl font-semibold text-fu-ink" data-i18n="catalog_no_matches">No courses match your filters</h3>
            <p class="mb-5 text-sm text-fu-muted">Try a different search term or remove some filters.</p>
            <button type="button" class="btn-secondary" @click="clear()">Clear all filters</button>
          </div>
        </div>
      ) : (
        <ContentError label="Course catalog temporarily unavailable" />
      )}
    </div>
  </section>

  <CTA
    heading="Turn your next study into trusted evidence"
    intro="Bring your research question, protocol, dataset, or manuscript. CTC Research helps teams move from complexity to clarity."
    ctaLabel="Talk to the research team"
    ctaHref="/contact/"
  />
  <HtmxBootstrap />
</Layout>

<style is:global>
  /* ==================================================================
     COURSE CATALOG — industrial Swiss print toolbar + filters
     Carbon frames, mono telemetry labels, square corners, hard shadows.
     ================================================================== */
  .catalog { position: relative; }

  /* ── Toolbar ─────────────────────────────────────────────────────── */
  .catalog__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: 1.5rem;
    padding: 0.75rem 1rem;
    border: 2px solid var(--fu-ink);
    background: hsl(var(--fu-paper));
  }
  .catalog__counter {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: hsl(var(--fu-ink));
    margin: 0;
  }
  .catalog__counter-active { color: hsl(var(--fu-link)); }
  .catalog__tools { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }

  .catalog__search { position: relative; display: flex; align-items: center; }
  .catalog__search-icon {
    position: absolute;
    left: 0.7rem;
    color: hsl(var(--fu-muted));
    pointer-events: none;
  }
  .catalog__search-input {
    min-width: 200px;
    padding: 0.5rem 0.75rem 0.5rem 2.1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: hsl(var(--fu-ink));
    background: hsl(var(--fu-card));
    border: 2px solid var(--fu-ink);
    outline: none;
    transition: border-color 0.15s ease;
  }
  .catalog__search-input:focus { border-color: hsl(var(--fu-link)); }
  .catalog__search-input::placeholder { color: hsl(var(--fu-muted)); }
  .catalog__search-kbd {
    position: absolute;
    right: 0.55rem;
    padding: 0 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: hsl(var(--fu-muted));
    border: 1px solid hsl(var(--fu-line));
    background: hsl(var(--fu-paper));
  }

  .catalog__view-toggle {
    display: inline-flex;
    border: 2px solid var(--fu-ink);
    background: hsl(var(--fu-card));
  }
  .catalog__view-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: hsl(var(--fu-muted));
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .catalog__view-btn + .catalog__view-btn { border-left: 2px solid var(--fu-ink); }
  .catalog__view-btn:hover { color: hsl(var(--fu-ink)); }
  .catalog__view-btn.is-active {
    color: hsl(var(--fu-paper));
    background: hsl(var(--fu-ink));
  }
  .catalog__view-label { display: inline; }
  @media (max-width: 480px) { .catalog__view-label { display: none; } }

  .catalog__filter-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: hsl(var(--fu-ink));
    background: hsl(var(--fu-card));
    border: 2px solid var(--fu-ink);
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .catalog__filter-toggle:hover { background: hsl(var(--fu-paper)); }
  .catalog__filter-count {
    min-width: 1.1rem;
    padding: 0.05rem 0.3rem;
    font-size: 0.62rem;
    text-align: center;
    color: hsl(var(--fu-paper));
    background: hsl(var(--fu-link));
  }
  .catalog__filter-chevron { color: hsl(var(--fu-muted)); transition: transform 0.2s ease; }
  .catalog__filter-chevron.is-open { transform: rotate(180deg); }

  /* ── Filter panel ────────────────────────────────────────────────── */
  .catalog__filters {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem 1.25rem;
    margin-bottom: 1.75rem;
    padding: 1.25rem;
    border: 2px solid var(--fu-ink);
    background: hsl(var(--fu-surface));
  }
  .catalog__filter-group { display: flex; flex-direction: column; gap: 0.5rem; }
  .catalog__filter-group--wide { grid-column: span 6; }
  .catalog__filter-label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: hsl(var(--fu-muted));
  }
  .catalog__select {
    width: 100%;
    padding: 0.45rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: hsl(var(--fu-ink));
    background: hsl(var(--fu-card));
    border: 2px solid var(--fu-ink);
    border-radius: 0;
    outline: none;
    cursor: pointer;
  }
  .catalog__select:focus { border-color: hsl(var(--fu-link)); }
  .catalog__options { display: flex; flex-direction: column; gap: 0.35rem; }
  .catalog__option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: hsl(var(--fu-ink));
    cursor: pointer;
  }
  .catalog__option input {
    width: 0.95rem;
    height: 0.95rem;
    accent-color: hsl(var(--fu-link));
    cursor: pointer;
  }
  .catalog__chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .catalog__chip {
    padding: 0.3rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: hsl(var(--fu-muted));
    background: hsl(var(--fu-card));
    border: 1.5px solid var(--fu-ink);
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .catalog__chip:hover { color: hsl(var(--fu-ink)); }
  .catalog__chip.is-active {
    color: hsl(var(--fu-paper));
    background: hsl(var(--fu-ink));
  }
  .catalog__filter-actions {
    grid-column: 1 / -1;
    display: flex;
    justify-content: flex-end;
    padding-top: 0.75rem;
    border-top: 1px solid hsl(var(--fu-line));
  }
  .catalog__clear {
    padding: 0.4rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: hsl(var(--fu-ink));
    background: transparent;
    border: 2px solid var(--fu-ink);
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .catalog__clear:hover { color: hsl(var(--fu-paper)); background: hsl(var(--fu-ink)); }

  @media (max-width: 1024px) {
    .catalog__filters { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .catalog__filter-group--wide { grid-column: span 3; }
  }
  @media (max-width: 640px) {
    .catalog__filters { grid-template-columns: 1fr 1fr; }
    .catalog__filter-group--wide { grid-column: span 2; }
    .catalog__filter-actions { grid-column: 1 / -1; }
  }
  @media (max-width: 420px) {
    .catalog__filters { grid-template-columns: 1fr; }
    .catalog__filter-group--wide { grid-column: 1; }
    .catalog__search-input { min-width: 0; width: 100%; }
    .catalog__search { flex: 1; }
  }

  /* Alpine transitions */
  .catalog-fade { transition: opacity 0.18s ease, transform 0.18s ease; }
  .catalog-fade-start { opacity: 0; transform: translateY(-6px); }
  .catalog-fade-end { opacity: 1; transform: translateY(0); }

  /* ── Course cards — carbon plate, telemetry index, hard shadow ───── */
  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .c-course {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 1.25rem;
    background: hsl(var(--fu-card));
    border: 2px solid var(--fu-ink);
    text-decoration: none;
    transition: box-shadow 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }
  .c-course:hover {
    background: hsl(var(--fu-paper));
    box-shadow: 5px 5px 0 0 var(--fu-ink);
    transform: translate(-2px, -2px);
  }
  .c-course.is-hidden { display: none; }

  .c-course__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
  }
  .c-course__index {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: hsl(var(--fu-muted));
    letter-spacing: 0.08em;
    margin-right: auto;
  }
  .c-course__featured {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: hsl(var(--fu-link));
    border-bottom: 1.5px solid hsl(var(--fu-link));
  }
  .c-course__body { flex: 1; }
  .c-course__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
    color: hsl(var(--fu-ink));
  }
  .c-course__desc {
    margin: 0 0 0.9rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: hsl(var(--fu-muted));
  }
  .c-course__tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .c-course__tag {
    padding: 0.18rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;

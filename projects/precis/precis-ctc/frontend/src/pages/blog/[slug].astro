---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import CTA from '@/components/blocks/CTA.astro';
import ContentError from '@/components/ui/ContentError.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation, fetchBlogPosts, fetchBlogPost } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData, BlogPostData } from '@/lib/api';

export async function getStaticPaths() {
  // Build-time content is optional: Docker/CI can build the static shell
  // before Django is running. Seeded slugs keep known detail routes available
  // in that mode; a live backend still supplies the authoritative list.
  try {
    const list = await fetchBlogPosts();
    if (list.data.length) return list.data.map((post) => ({ params: { slug: post.slug } }));
  } catch {
    // The backend may be starting after the Astro build.
  }
  return [];
}

const { slug } = Astro.params;

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let postData: BlogPostData | undefined;
try {
  [siteSettings, navData, postData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), fetchBlogPost(slug!),
  ]);
} catch { /* use fallbacks */ }

// Adapt the live BlogPost payload to the shared article layout contract.
// No article body is synthesized in Astro; an unavailable backend payload
// renders the backend-owned content error below.
const pageData: PageData | undefined = postData ? {
  id: postData.id,
  slug: postData.slug,
  title: postData.title,
  type: 'BlogPost',
  show_in_nav: false,
  seo_title: postData.title,
  search_description: postData.meta_description || postData.excerpt,
  body: postData.content,
  excerpt: postData.excerpt,
  category: postData.categories[0]?.name || '',
  read_time: `${postData.reading_time} min read`,
  post_date: postData.published_date || '',
} : undefined;
const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const body = String(pageData?.body || '');
const category = String(pageData?.category || '');
const readTime = String(pageData?.read_time || '');
const postDate = String(pageData?.post_date || '');
const excerpt = String(pageData?.excerpt || '');
---

<Layout
  title={pageData?.title || 'Blog post'}
  description={excerpt || pageData?.search_description || 'A CTC Research blog post on medical AI and health innovation.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug={slug}
>
  <Hero
    eyebrow={category || 'insights · medical research learning'}
    heading={pageHero?.title || pageData?.title || 'Blog post'}
    accent=''
    intro={pageHero?.subtitle || excerpt}
    primaryCta={pageHero?.primary_cta ? { label: pageHero.primary_cta.label, href: pageHero.primary_cta.href } : { label: '← All posts', href: '/blog' }}
    secondaryCta={pageHero?.secondary_cta ? { label: pageHero.secondary_cta.label, href: pageHero.secondary_cta.href } : { label: 'Contact us', href: '/contact' }}
    variant="archive"
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: pageHero?.title || pageData?.title || 'Blog post' }]}
  />

  {body ? (
    <article class='doc-sheet bg-fu-paper py-16 md:py-20'>
      <div class='container-fusion'>
        <div class='mx-auto max-w-2xl'>
          <div class='mb-10 flex flex-wrap items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fu-muted'>
            {category && <span class='text-fu-link'>{category}</span>}
            {readTime && <span>{readTime}</span>}
            {postDate && <time datetime={postDate}>{postDate}</time>}
            <a href='/blog/' class='ml-auto text-fu-link no-underline hover:text-fu-link-dark'>← All posts</a>
          </div>
          <div
            class='prose-fusion'
            style='color:hsl(var(--fu-ink));font-size:1.0625rem;line-height:1.85;'
            set:html={body}
          />
        </div>
      </div>

      <!-- Precis comments use the existing moderated BlogComment model. Public
           readers see approved comments; signed-in readers can submit a
           pending comment without exposing it before moderation. -->
      <section class='container-fusion mt-16 border-t border-fu-line pt-12'>
        <div
          class='mx-auto max-w-2xl'
          data-slug={slug}
          data-live={postData ? 'true' : 'false'}
          x-data="{
            slug: $root.dataset.slug || '',
            live: $root.dataset.live === 'true',
            authed: false,
            loading: true,
            comment: '',
            comments: [],
            busy: false,
            async init() {
              try {
                const statusRes = await fetch('/apis/auth/status/', { credentials: 'include', headers: { Accept: 'application/json' } });
                if (statusRes.ok) this.authed = Boolean((await statusRes.json()).authenticated);
                if (this.live) {
                  const commentsRes = await fetch(`/apis/blog/${this.slug}/comments/`, { headers: { Accept: 'application/json' } });
                  if (commentsRes.ok) this.comments = (await commentsRes.json()).comments || [];
                }
              } catch (error) { /* public content remains usable offline */ }
              finally { this.loading = false; }
            },
            async submitComment() {
              if (!this.comment.trim()) return;
              this.busy = true;
              try {
                const response = await fetch(`/apis/blog/${this.slug}/comments/`, {
                  method: 'POST',
                  credentials: 'include',
                  headers: {
                    'Content-Type': 'application/json',
                    Accept: 'application/json',
                    'X-CSRFToken': decodeURIComponent(document.cookie.match(/(?:^|; )csrftoken=([^;]+)/)?.[1] || ''),
                  },
                  body: JSON.stringify({ body: this.comment.trim() }),
                });
                if (response.status === 202) {
                  this.comment = '';
                  window.__showToast?.('Comment submitted for moderation.', 'success');
                } else if (response.status === 401) {
                  window.__showToast?.('Sign in to leave a comment.', 'error');
                } else {
                  window.__showToast?.('Comment could not be submitted.', 'error');
                }
              } catch (error) {
                window.__showToast?.('Network error — your comment was not posted.', 'error');
              } finally { this.busy = false; }
            },
          }"
        >
          <div class='mb-6 flex items-end justify-between gap-4'>
            <div><span class='tag-marker'>conversation</span><h3 class='mt-2 font-display text-xl font-semibold text-fu-ink'>Comments</h3></div>
            <span class='font-mono text-[0.65rem] uppercase tracking-[0.14em] text-fu-muted' x-text="`${comments.length} approved`"></span>
          </div>

          <template x-if='!loading && comments.length'>
            <div class='mb-8 space-y-4'>
              <template x-for='comment in comments' :key='comment.id'>
                <article class='card p-5'>
                  <div class='mb-2 flex items-center justify-between gap-3'><strong class='text-sm text-fu-ink' x-text='comment.display || comment.author'></strong><time class='font-mono text-[0.65rem] text-fu-muted' x-text='(comment.created_at || "").split("T")[0]'></time></div>
                  <p class='text-sm leading-relaxed text-fu-muted' x-text='comment.body'></p>
                </article>
              </template>
            </div>
          </template>

          <template x-if='!loading && !comments.length'>
            <p class='mb-8 text-sm text-fu-muted'>No approved comments yet. Start the conversation.</p>
          </template>

          <template x-if='!loading && authed'>
            <form @submit.prevent='submitComment()' class='card space-y-3 p-5'>
              <label for='precis-comment' class='tag-marker'>leave a comment</label>
              <textarea id='precis-comment' x-model='comment' rows='3' maxlength='2000' required :disabled='busy' class='input-field' placeholder='Share a thoughtful note…'></textarea>
              <div class='flex items-center justify-between gap-3'><span class='font-mono text-[0.65rem] text-fu-muted'>Reviewed before publication</span><button type='submit' class='btn-primary !px-5 !py-2 text-sm' :disabled='busy' x-text='busy ? "Submitting…" : "Post comment"'></button></div>
            </form>
          </template>

          <template x-if='!loading && !authed'>
            <div class='card flex flex-wrap items-center justify-between gap-4 p-5'><p class='text-sm text-fu-muted'>Sign in to join the conversation.</p><button type='button' class='btn-secondary !px-5 !py-2 text-sm' @click='$dispatch("fusion:open-login")'>Sign in</button></div>
          </template>
        </div>
      </section>
    </article>
  ) : <ContentError label="Post body unavailable" />}

  <CTA
    heading={pageCta?.title || 'Everything is open source'}
    intro={pageCta?.subtitle || 'Explore more posts from CTC Research.'}
    ctaLabel={pageCta?.primary_cta?.label || 'Back to the blog'}
    ctaHref={pageCta?.primary_cta?.href || '/blog'}
  />
  <Toast />
  <HtmxBootstrap />
</Layout>

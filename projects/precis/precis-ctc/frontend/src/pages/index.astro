---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import Stats from '@/components/blocks/Stats.astro';
import OutcomeFramework from '@/components/blocks/OutcomeFramework.astro';
import HomeSlider from '@/components/blocks/HomeSlider.astro';
import CTA from '@/components/blocks/CTA.astro';import Toast from '@/components/ui/Toast.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData, cachedMediaManifest, CONTENT_LANGUAGE } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';
import { teaserCopy } from '@/lib/teaser-translations';

// ── Fetch from backend (SSG build-time), fall back to static content ──
let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
let mediaManifest: Awaited<ReturnType<typeof cachedMediaManifest>> | undefined;

try {
  [siteSettings, navData, pageData, mediaManifest] = await Promise.all([
    cachedSiteSettings(),
    cachedNavigation(),
    cachedPageData('home'),
    cachedMediaManifest(),
  ]);
} catch {
  // Backend unreachable — use hardcoded fallbacks below
}

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const hasEditorialHero = Boolean(pageHero?.title && pageHero?.subtitle && pageHero?.primary_cta?.href);
const pageStats = (pageData?.stats as any[] | undefined);
const methods = pageData?.methods as string[] | undefined;

// Media gallery items for the hero panel — from the seeded AboutPage gallery
// (media_items), localized. Rendered only when the backend provides them.
const pageGallery = (pageData?.gallery as any[] | undefined)?.map((g: any) => ({
  src: g.image?.image?.url || g.image?.url || '',
  alt: g.image?.alternative_text || g.caption || '',
  embedUrl: g.video?.embed_url || '',
  caption: String(g.caption || '').replace(/<[^>]+>/g, ''),
  category: g.category || '',
})).filter((g) => Boolean(g.src || g.embedUrl));
const archiveGallery = mediaManifest?.items
  .filter((item) => item.media_type === 'image')
  .slice(0, 6)
  .map((item) => ({
    src: item.src,
    alt: item.alt,
    caption: item.caption,
    category: item.category,
  }));
const heroGallery = pageGallery?.length ? pageGallery : archiveGallery;
const sliderImages = (heroGallery || []).filter((item) => Boolean(item.src)).slice(0, 4);
const agendaSlides = [
  {
    eyebrow: 'clinical evidence',
    title: 'From question to protocol',
    text: 'Start with the clinical need, make the estimand explicit, and build a study record the whole team can inspect.',
    href: '/services/',
    cta: 'Explore services',
    image: sliderImages[0]?.src,
    alt: sliderImages[0]?.alt,
  },
  {
    eyebrow: 'responsible medical AI',
    title: 'Make data useful and accountable',
    text: 'Evaluate clinical data and AI systems with attention to bias, validation, safety, and implementation in care.',
    href: '/courses/',
    cta: 'View the course',
    image: sliderImages[1]?.src,
    alt: sliderImages[1]?.alt,
  },
  {
    eyebrow: 'evidence synthesis',
    title: 'Turn uncertainty into a record',
    text: 'Use reproducible search, appraisal, extraction, and reporting to give decisions the context they need.',
    href: '/courses/',
    cta: 'Build the method',
    image: sliderImages[2]?.src,
    alt: sliderImages[2]?.alt,
  },
  {
    eyebrow: 'education and training',
    title: 'Learn the method behind the result',
    text: 'Short, applied learning paths help clinicians, researchers, and medical writers take the next defensible step.',
    href: '/courses/',
    cta: 'Browse courses',
    image: sliderImages[3]?.src,
    alt: sliderImages[3]?.alt,
  },
];

// ── Fallbacks (used when backend is unreachable at build time) ──
const techStats = pageStats?.map((s: any) => ({
  label: String(s.label || ''),
  value: Number(s.value || 0),
  suffix: String(s.suffix || ''),
}));

// Seeded research programs — the three pillars from the HomePage `summary`
// about block (service_items). Rendered only when the backend provides them;
// there is deliberately no hardcoded program list in the frontend.
const aboutBlock = (pageData?.features as any[] | undefined)?.find((f: any) => f.type === 'about');
const serviceItems = (aboutBlock?.service_items || []).map((s: any) => ({
  title: String(s.title || ''),
  description: String(s.description || ''),
  iconClass: String(s.icon_class || ''),
}));

// Seeded vision copy — the CTA why_choose_section (title + description).
const visionBlock = (pageCta as any[] | undefined)?.find((c: any) => c.type === 'why_choose_section');
const visionTitle = String(visionBlock?.title || '');
const visionDescription = String(visionBlock?.description || '');
const visionSubtitle = String(visionBlock?.subtitle || '');
---

<Layout
  title={pageData?.title || 'CTC Research'}
  description={pageData?.search_description || 'CTC Research — a medical research center for clinical evidence, biostatistics, and responsible medical AI.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="home"
>
  <Hero
    eyebrow={pageHero?.badge || 'ctc research · medical research center'}
    heading={hasEditorialHero ? pageHero?.title : 'Turn clinical data into'}
    accent={hasEditorialHero && pageHero?.accent ? pageHero.accent : 'trusted evidence'}
    intro={hasEditorialHero && pageHero?.subtitle ? pageHero.subtitle : 'A research center for clinicians, biostatisticians, and medical writers — protocols, evidence synthesis, and responsible AI, reduced to method.'}
    primaryCta={hasEditorialHero && pageHero?.primary_cta ? { label: pageHero.primary_cta.label, href: pageHero.primary_cta.href } : { label: 'Start your learning path', href: '/courses/' }}
    secondaryCta={hasEditorialHero && pageHero?.secondary_cta ? { label: pageHero.secondary_cta.label, href: pageHero.secondary_cta.href } : { label: 'Browse courses', href: '/courses/' }}
    status='200 OK · text/html · the center, in one response'
    gallery={heroGallery}
    variant="home"
  />

  <HomeSlider slides={agendaSlides} />

  <!-- Why-choose methods — seeded on HomePage.CTA (why_choose_section) and
       rendered from the localized page data, never hardcoded. -->
  {methods?.length ? (
  <section class='doc-sheet bg-fu-card py-20 md:py-24'>
    <div class='container-fusion'>
      <div class='mb-12 max-w-2xl'>
        <p class='eyebrow-pill mb-5'>what we do</p>
        <h2 class='mb-4 font-display text-4xl font-light tracking-tight text-fu-ink md:text-5xl'>Our methods</h2>
      </div>
      <div class='grid grid-cols-1 gap-5 md:grid-cols-3'>
        {methods.map((method: string, i: number) => (
          <div class='card reveal p-7' x-data x-intersect='`$el.classList.add("reveal-visible")`' style={`transition-delay: ${i * 80}ms`}>
            <span class='mb-4 block font-mono text-[0.65rem] uppercase tracking-[0.14em] text-fu-teal'>{String(i + 1).padStart(2, '0')}</span>
            <p class='font-display text-lg font-normal text-fu-ink'>{method}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  ) : null}

  <!-- Research programs — the three seeded pillars (Mastery / Capability /
       Impact). Rendered only when the backend seeds them; never hardcoded. -->
  {serviceItems.length ? (
  <section id='programs' class='doc-sheet bg-fu-paper py-24 md:py-32'>
    <div class='container-fusion'>
      <div class='mb-16 flex flex-col items-start justify-between gap-6 md:flex-row md:items-end'>
        <div class='max-w-2xl'>
          <p class='eyebrow-pill mb-5'>{visionSubtitle || 'research programs'}</p>
          <h2 class='mb-4 font-display text-4xl font-light tracking-tight text-fu-ink md:text-5xl'>
            {visionTitle || 'Three pillars, one research agenda'}
          </h2>
          <p class='text-fu-muted'>
            {visionDescription || 'Every program at the center is organized around three pillars — mastery, capability, and impact — so education and research stay connected to measurable health outcomes.'}
          </p>
        </div>
        <p class='hidden shrink-0 font-mono text-[0.62rem] uppercase tracking-[0.22em] text-fu-muted md:block'>
          mastery · capability · impact
        </p>
      </div>

      <div class='grid grid-cols-1 gap-5 md:grid-cols-3'>
        {serviceItems.map((item: any, i: number) => (
          <div
            class={`card reveal group relative p-8 pt-10 ${i === 1 ? 'md:translate-y-8' : ''}`}
            x-data x-intersect='`$el.classList.add("reveal-visible")`'
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <span class='absolute right-6 top-4 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-fu-muted/70' aria-hidden='true'>
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class='mb-5 inline-flex h-12 w-12 items-center justify-center rounded-full border border-fu-teal/25 bg-fu-teal/5 text-fu-teal transition-all duration-500 group-hover:border-fu-teal group-hover:bg-fu-teal/10' style='transition-timing-function: cubic-bezier(0.34,1.56,0.64,1)'>
              <svg class='h-6 w-6' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='1.5' aria-hidden='true'>
                <path stroke-linecap='round' stroke-linejoin='round' d={i === 0
                  ? 'M12 21s-7-4.35-7-11a7 7 0 1114 0c0 6.65-7 11-7 11zM12 12a2.5 2.5 0 100-5 2.5 2.5 0 000 5z'
                  : i === 1
                  ? 'M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z'
                  : 'M3.05 11a9 9 0 0117.9 0M3.05 13a9 9 0 0117.9 0M12 21a8.5 8.5 0 010-17 8.5 8.5 0 010 17z'} />
              </svg>
            </div>
            <h3 class='mb-2 font-display text-xl font-normal text-fu-ink'>{item.title}</h3>
            <p class='max-w-lg text-sm leading-relaxed text-fu-muted'>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  ) : null}

  <!-- Outcome-led learning layer: visible progress, learner friction, the
       learning path, product response, architecture proof, and FAQs. -->
  <OutcomeFramework />

  <!-- Tech Stats — renders only when the backend provides stats (HomePage is a slim page by design) -->
  {techStats?.length ? <Stats stats={techStats} /> : null}

  <!-- The homepage content is already rendered from the build-time page data
       above. Do not issue a second HTMX request for the whole page: the
       backend page-fragment API returns a JSON Fusion pointer, not HTML, and
       swapping it here would replace valid content with a document/API error. -->

  <!-- Single distinct learning entry (once-only contract — mirrors the
       Django road teaser in home/main.html; the backend HTMX fragment does
       NOT include it, so a swap can never double it). Copy follows the build
       language (PUBLIC_CONTENT_LANGUAGE → CONTENT_LANGUAGE) like the Django
       road's gettext catalogs. -->
  <section class='doc-sheet bg-fu-paper py-20 md:py-24' data-learning-teaser>
    <div class='container-fusion max-w-3xl text-center'>
      <p class='tag-marker mb-4'>{teaserCopy(CONTENT_LANGUAGE).marker}</p>
      <h2 class='mb-3 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>{teaserCopy(CONTENT_LANGUAGE).title}</h2>
      <p class='mx-auto mb-6 max-w-xl text-fu-muted'>
        {teaserCopy(CONTENT_LANGUAGE).intro}
      </p>
      <a href='/courses/' class='btn-primary group !px-7 !py-3 text-sm'>
        {teaserCopy(CONTENT_LANGUAGE).cta}
        <span class='flex h-6 w-6 items-center justify-center rounded-full bg-fu-teal/10 text-fu-teal transition-transform duration-500 group-hover:translate-x-0.5' style='transition-timing-function: cubic-bezier(0.34,1.56,0.64,1)'>
          <svg class='h-3 w-3' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2.4' aria-hidden='true'><path stroke-linecap='round' stroke-linejoin='round' d='M9 5l7 7-7 7'/></svg>
        </span>
      </a>
    </div>
  </section>

  <!-- The homepage is already rendered from the page-data response above.
       Do not request `/fragment/pages/home/` a second time: that backend
       component is an enhancement road, not a prerequisite for the document,
       and showing its 503 fallback made a healthy page look broken. -->

  <CTA
    heading={pageCta?.title || 'Advance health through research'}
    intro={pageCta?.subtitle || 'Join clinicians, biostatisticians, and medical writers building trusted evidence — start a learning path or partner with the center.'}
    ctaLabel={pageCta?.primary_cta?.label || 'Browse courses'}
    ctaHref={pageCta?.primary_cta?.href || '/courses/'}
  />

  <Toast />
  <HtmxBootstrap />
</Layout>

<script>
  import '../lib/home-motion';
</script>

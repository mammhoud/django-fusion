---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import Stats from '@/components/blocks/Stats.astro';
import Features from '@/components/blocks/Features.astro';
import Testimonials from '@/components/blocks/Testimonials.astro';
import FAQ from '@/components/blocks/FAQ.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('projects'),
  ]);
} catch { /* use fallbacks */ }

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const pageProjects = (pageData?.projects as any[] | undefined);

const repoProjects = pageProjects?.length ? pageProjects.map((p: any) => ({
  name: String(p.name || ''),
  edition: String(p.edition || ''),
  category: String(p.category || 'program'),
  path: String(p.path || ''),
  text: String(p.description || p.text || ''),
  features: (p.features as any[] | undefined)?.map((f: any) => ({
    label: String(f.label || ''),
    shared: Boolean(f.shared),
  })) ?? [],
})) : [
  { name: 'Clinical evidence programs', edition: 'research', category: 'program', path: 'protocol → analysis → publication', text: 'Applied support for teams designing and reporting clinical studies.', features: [{ label: 'Protocol review', shared: true }, { label: 'Evidence synthesis', shared: true }] },
  { name: 'Medical writing studio', edition: 'writing', category: 'program', path: 'question → manuscript', text: 'Editorial and methodological guidance for clear, publishable scientific writing.', features: [{ label: 'Methods clarity', shared: true }, { label: 'Reporting review', shared: false }] },
  { name: 'Responsible medical AI', edition: 'analytics', category: 'program', path: 'data → validation → care', text: 'A research track for evaluating clinical data and AI systems responsibly.', features: [{ label: 'Bias and validation', shared: true }, { label: 'Implementation planning', shared: false }] },
];
---

<Layout title={pageData?.title || 'Projects'} description={pageData?.search_description || 'The full project document — the monorepo at a glance.'} navItems={navData?.nav_items} siteSettings={siteSettings} pageData={pageData} pageSlug="projects">
  <Hero eyebrow={pageHero?.badge || 'projects · research programs'} heading={pageHero?.title || 'Programs and research'} accent='evidence you can build on' intro={pageHero?.subtitle || 'Learning paths, research programs, and evidence services from CTC Research.'} primaryCta={{ label: 'See the features', href: '/features' }} secondaryCta={{ label: 'Read the FAQ', href: '/projects#faq' }} status='200 OK · text/html · every program in one response' />

  {repoProjects.length ? (
  <section class='page-section doc-sheet bg-fu-paper py-20 md:py-24'>
    <div class='container-fusion'>
      <div class='mx-auto mb-14 max-w-2xl text-center'>
        <p class='tag-marker mb-4'>projects</p>
        <h2 class='mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>Projects in this repo</h2>
        <p class='text-fu-muted'>Six projects, one pipeline — <span class='font-mono text-[0.72rem] uppercase tracking-[0.14em] text-fu-live'>shared</span> features are reused, <span class='font-mono text-[0.72rem] uppercase tracking-[0.14em] text-fu-muted'>own</span> features are standalone.</p>
      </div>
      <div class='project__grid grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3'>
        {repoProjects!.map((project, i) => (
          <article class='project__card card reveal p-6' x-data x-intersect='$el.classList.add("reveal-visible")' style={`transition-delay: ${i * 80}ms`}>
            <div class='project__head mb-1 flex items-center justify-between gap-3'>
              <p class='tag-marker project__category'>{project.category}</p>
              {project.edition && (<span class='badge-primary badge project__edition'>{project.edition}</span>)}
            </div>
            <h3 class='mb-0.5 font-display text-[1.05rem] font-semibold text-fu-ink project__name'>{project.name}</h3>
            <p class='mb-3 font-mono text-[0.65rem] uppercase tracking-[0.16em] text-fu-muted project__path'>{project.path}</p>
            <p class='mb-4 text-sm leading-relaxed text-fu-muted project__text'>{project.text}</p>
            <ul class='project__features flex flex-col gap-1.5'>
              {project.features.map((feature) => (
                <li class={`project__feature flex items-baseline gap-2 text-[0.8rem] text-fu-ink/80 ${feature.shared ? 'project__feature--shared' : ''}`}>
                  <span class='text-fu-link'>•</span><span>{feature.label}</span>
                  <span class={`project__feature-tag ml-auto font-mono text-[0.6rem] uppercase tracking-[0.12em] ${feature.shared ? 'text-fu-live' : 'text-fu-muted'}`}>{feature.shared ? 'shared' : 'own'}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>
  ) : null}

  <Stats />
  <Features heading='Evidence you can build on' intro='Structured methods, reproducible reviews, and responsible data analytics.' />
  <Testimonials />
  <FAQ />
  <!-- Project content is already rendered from page data; avoid requesting
       the full Astro document into an inner HTMX target. -->
  <CTA heading={pageCta?.title || 'Advance health through research'} intro={pageCta?.subtitle || 'Join clinicians, biostatisticians, and medical writers building trusted evidence.'} ctaLabel={pageCta?.primary_cta?.label || 'Get started'} ctaHref={pageCta?.primary_cta?.href || '/courses/'} />
  <Toast />
  <HtmxBootstrap />
</Layout>

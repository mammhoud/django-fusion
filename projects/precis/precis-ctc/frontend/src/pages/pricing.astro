---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import Pricing from '@/components/blocks/Pricing.astro';
import FAQ from '@/components/blocks/FAQ.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('pricing'),
  ]);
} catch { /* use fallbacks */ }

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const pagePricing = (pageData?.pricing as any[] | undefined);
const pageFaq = (pageData?.faq as any[] | undefined);

// All content is Wagtail-driven — no hardcoded fallback copy. The backend
// seeds pricing tiers + FAQ into the Wagtail page for this slug (exposed via
// /apis/pages/pricing/); empty sections render nothing.
const plans = (pagePricing ?? []).flatMap((block: any) =>
  ((block?.tiers || []) as any[]).map((t: any) => ({
    name: String(t.name || ''),
    price: Number(String(t.price || '0').replace(/[^0-9.]/g, '') || 0),
    period: String(t.period || '').replace(/^\//, ''),
    description: String(t.description || ''),
    features: (t.features || []) as string[],
    highlighted: Boolean(t.featured),
    cta: { label: String(t.cta_label || 'Get started'), href: String(t.cta_href || '/#cta') },
  })),
);
const resolvedPlans = plans;

const faqItems = pageFaq?.length ? pageFaq.map((f: any) => ({
  question: String(f.question || ''),
  answer: String(f.answer || ''),
})) : [];
---


<Layout
  title={pageData?.title || 'Pricing'}
  description={pageData?.search_description || 'CTC Research programs and pricing — start free and scale as you grow.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="pricing"
>
  <Hero
    eyebrow={pageHero?.badge || 'pricing · printed clearly'}
    heading={pageHero?.title || 'Pricing'}
    accent='printed clearly'
    intro={pageHero?.subtitle || 'Simple, transparent pricing — start free and scale as you grow. No hidden fees, cancel anytime.'}
    primaryCta={pageHero?.primary_cta ? { label: pageHero.primary_cta.label, href: pageHero.primary_cta.href } : { label: 'Start free', href: '/#cta' }}
    secondaryCta={pageHero?.secondary_cta ? { label: pageHero.secondary_cta.label, href: pageHero.secondary_cta.href } : { label: 'Contact sales', href: '/contact' }}
    variant="product"
  />

  {resolvedPlans.length ? (
    <Pricing
      heading='Simple, transparent pricing'
      intro='Start free and scale as you grow. No hidden fees, cancel anytime.'
      plans={resolvedPlans}
    />
  ) : null}

  {faqItems.length ? (
    <FAQ
      heading='Pricing questions, answered'
      intro='The honest answers to the questions buyers ask.'
      items={faqItems}
    />
  ) : null}

  <CTA
    heading={pageCta?.title || 'Advance health through research'}
    intro={pageCta?.subtitle || 'Join clinicians, biostatisticians, and medical writers building trusted evidence.'}
    ctaLabel={pageCta?.primary_cta?.label || 'Browse courses'}
    ctaHref={pageCta?.primary_cta?.href || '/courses/'}
  />
  <Toast />
  <HtmxBootstrap />
</Layout>

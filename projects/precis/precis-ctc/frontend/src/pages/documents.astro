---
import Layout from '@/layouts/Layout.astro';
import ContentError from '@/components/ui/ContentError.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import { cachedSiteSettings, cachedNavigation, fetchPublications, CONTENT_LANGUAGE } from '@/lib/api';
import type { NavigationData, PublicationListData, SiteSettings } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let library: PublicationListData | undefined;
try {
  [siteSettings, navData, library] = await Promise.all([
    cachedSiteSettings(),
    cachedNavigation(),
    fetchPublications(CONTENT_LANGUAGE),
  ]);
} catch {
  // The backend error state below is the only rendered response when the CMS
  // cannot provide the document library.
}
---

<Layout
  title={library ? 'Research documents' : 'Research documents · unavailable'}
  description={library?.guidance.body || 'Wagtail-managed guidance for clinical research and academic writing.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageSlug="documents"
>
  {library ? (
    <>
      <section class="documents-hero doc-sheet bg-fu-paper py-20 md:py-28">
        <div class="container-fusion documents-hero__inner">
          <div class="documents-hero__copy">
            <p class="tag-marker mb-5">research library · {library.language}</p>
            <h1 class="font-display text-5xl font-light leading-[1.02] tracking-tight text-fu-ink md:text-7xl">Documents for the next defensible step.</h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-fu-muted">{library.guidance.body}</p>
          </div>
          <div class="documents-hero__signal" aria-label={`${library.total} documents published`}>
            <span class="documents-hero__signal-value">{String(library.total).padStart(2, '0')}</span>
            <span class="documents-hero__signal-label">published<br />documents</span>
          </div>
        </div>
      </section>

      <section class="documents-guidance doc-sheet bg-fu-card py-16 md:py-20">
        <div class="container-fusion">
          <div class="documents-guidance__header">
            <p class="tag-marker mb-4">a short route through the record</p>
            <h2 class="page-section__title">{library.guidance.title}</h2>
          </div>
          <ol class="documents-guidance__steps">
            {library.guidance.steps.map((step, index) => (
              <li class="documents-guidance__step">
                <span class="documents-guidance__index">{String(index + 1).padStart(2, '0')}</span>
                <span>{step}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="documents-library doc-sheet bg-fu-paper py-20 md:py-28">
        <div class="container-fusion">
          <div class="documents-library__header">
            <div>
              <p class="tag-marker mb-4">latest from the center</p>
              <h2 class="page-section__title">Research guidance</h2>
            </div>
            <p class="documents-library__count">{library.total} in {library.language}</p>
          </div>
          {library.documents.length ? (
            <div class="documents-library__grid">
              {library.documents.map((document, index) => (
                <article class="documents-card" style={`--documents-card-delay: ${index * 70}ms`}>
                  <div class="documents-card__meta">
                    <span>{document.category || 'Research guidance'}</span>
                    {document.published_at && <time datetime={document.published_at}>{document.published_at.slice(0, 10)}</time>}
                  </div>
                  <h3 class="documents-card__title">{document.title}</h3>
                  <div class="documents-card__abstract" set:html={document.abstract} />
                  <p class="documents-card__authors">{document.authors}</p>
                  {document.external_url ? (
                    <a class="documents-card__link" href={document.external_url} target="_blank" rel="noopener noreferrer">Open source record <span aria-hidden="true">↗</span></a>
                  ) : (
                    <span class="documents-card__status">Wagtail editorial record</span>
                  )}
                </article>
              ))}
            </div>
          ) : (
            <ContentError label="The backend has no published documents for this language." />
          )}
        </div>
      </section>
    </>
  ) : (
    <ContentError label="The research library is unavailable from the backend." />
  )}
  <HtmxBootstrap />
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import ContentError from '@/components/ui/ContentError.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData, EventItem } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('events'),
  ]);
} catch { /* use fallbacks */ }

const events: EventItem[] = pageData?.events || [];

const formatDate = (iso: string | null | undefined): string => {
  if (!iso) return '';
  try {
    return new Date(iso).toLocaleDateString('en-US', {
      year: 'numeric', month: 'short', day: 'numeric',
    });
  } catch {
    return '';
  }
};

const heading = pageData?.hero?.title || pageData?.title || 'Upcoming Events';
const subtitle = pageData?.hero?.subtitle || pageData?.search_description || '';
---

<Layout
  title={heading}
  description={pageData?.search_description || 'Workshops and symposia from CTC Research.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="events"
>
  <section class="mx-auto w-full max-w-6xl px-4 py-20 md:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="tag-marker mb-4">ctc research &middot; events</p>
      <h1 class="font-display text-4xl font-light leading-[1.05] tracking-tight text-fu-ink md:text-5xl">{heading}</h1>
      {subtitle && <p class="mt-4 text-fu-muted">{subtitle}</p>}
    </div>

    {events.length ? (
      <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {events.map((ev, i) => (
          <article
            class="group flex flex-col rounded-2xl border border-fu-line bg-fu-card/80 p-6 transition-colors duration-500 hover:border-fu-link/40"
            style={`transition-timing-function: cubic-bezier(0.32,0.72,0,1); transition-delay: ${i * 60}ms`}
            x-data
            x-intersect="$el.classList.add('reveal-visible')"
          >
            <div class="mb-3 flex items-center gap-3">
              {ev.event_type_label && (
                <span class="rounded-full bg-fu-teal/10 px-3 py-1 font-mono text-[0.62rem] uppercase tracking-[0.16em] text-fu-teal">
                  {ev.event_type_label}
                </span>
              )}
              {ev.start_date && (
                <time class="font-mono text-xs text-fu-muted" datetime={ev.start_date}>
                  {formatDate(ev.start_date)}
                </time>
              )}
            </div>
            <h2 class="font-display text-xl font-medium leading-snug text-fu-ink">{ev.title}</h2>
            {ev.location && <p class="mt-1 text-sm text-fu-muted">{ev.location}</p>}
            {ev.description && <p class="mt-3 text-sm leading-relaxed text-fu-muted">{ev.description}</p>}
          </article>
        ))}
      </div>
    ) : (
      <div class="mt-14">
        <ContentError label="No upcoming events" />
      </div>
    )}
  </section>

  <Toast />
</Layout>

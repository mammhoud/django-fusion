---
import Layout from '@/layouts/Layout.astro';
import EventCard from '@/components/blocks/EventCard.astro';
import PageHeader from '@/components/blocks/PageHeader.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData, EventItem } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('events'),
  ]);
} catch { /* use fallbacks */ }

const events: EventItem[] = pageData?.events || [];

const heading = pageData?.hero?.title || pageData?.title || 'Upcoming Events';
const subtitle = pageData?.hero?.subtitle || pageData?.search_description || '';
---

<Layout
  title={heading}
  description={pageData?.search_description || 'Workshops and symposia from CTC Research.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="events"
>
  <PageHeader
    eyebrow="ctc research · events"
    title={heading}
    intro={subtitle || 'Workshops, symposia, and academic writing sessions from the research network.'}
    variant="archive"
    index="07"
    status="200 OK · research calendar"
    primaryCta={{ label: 'Ask about events', href: '/contact/' }}
    secondaryCta={{ label: 'Browse courses', href: '/courses/' }}
  />

  <section class="mx-auto w-full max-w-6xl px-4 py-20 md:py-28">
    {events.length ? (
      <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {events.map((ev, i) => (
          <EventCard event={ev} index={i} />
        ))}
      </div>
    ) : (
      <div class="fu-event-grid__empty mt-14 border-2 border-fu-ink bg-fu-card p-8 text-center">
        <p class="tag-marker mb-3">calendar</p>
        <h2 class="font-display text-2xl text-fu-ink">The next research session is being scheduled</h2>
        <p class="mx-auto mt-3 max-w-xl text-fu-muted">Join the mailing list or contact the center for upcoming workshops, symposia, and academic writing sessions.</p>
        <a class="btn-secondary mt-6 inline-flex" href="/contact/">Ask about events</a>
      </div>
    )}
  </section>

  <Toast />
</Layout>

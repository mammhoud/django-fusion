---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import CounterCard from '@/components/blocks/CounterCard.astro';
import CertificateCard from '@/components/blocks/CertificateCard.astro';
import Features from '@/components/blocks/Features.astro';
import Testimonials from '@/components/blocks/Testimonials.astro';
import FAQ from '@/components/blocks/FAQ.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData, cachedMediaManifest } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';

// ── Fetch from backend, fall back to static content ──
let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
let mediaManifest: Awaited<ReturnType<typeof cachedMediaManifest>> | undefined;
try {
  [siteSettings, navData, pageData, mediaManifest] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('about'), cachedMediaManifest(),
  ]);
} catch { /* use fallbacks */ }

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const pageStats = (pageData?.stats as any[] | undefined);
const pageTestimonials = (pageData?.testimonials as any[] | undefined);
const pageFaq = (pageData?.faq as any[] | undefined);
const pageCounters = (pageData?.counters as any[] | undefined);
const pageGallery = (pageData?.gallery as any[] | undefined);
const experienceDesc = pageData?.experience_description;
const videoLink = pageData?.video_link;
const methods = pageData?.methods as string[] | undefined;

// ── Mapped from backend data (no hardcoded fallbacks) ──
// AboutPage seeds counters (not the generic `stats` field) — prefer them.
const bioCounters = (pageCounters?.length ? pageCounters : pageStats)?.map((s: any) => ({
  label: String(s.label || ''),
  value: Number(s.number ?? s.value ?? 0),
  suffix: String(s.suffix || ''),
}));

const pageGalleryItems = pageGallery?.map((g: any) => ({
  type: String(g.media_type || 'image'),
  src: g.image?.image?.url || g.image?.url || '',
  alt: g.image?.alternative_text || g.caption || '',
  embedUrl: g.video?.embed_url || '',
  caption: String(g.caption || '').replace(/<[^>]+>/g, ''),
  category: g.category || '',
}));
const archiveGalleryItems = mediaManifest?.items.slice(0, 18).map((item) => ({
  type: item.media_type,
  src: item.media_type === 'image' ? item.src : '',
  alt: item.alt,
  embedUrl: item.media_type === 'video' ? item.src : '',
  caption: item.caption,
  category: item.category,
}));
const galleryItems = pageGalleryItems?.length ? pageGalleryItems : archiveGalleryItems;

// All content is Wagtail-driven — no hardcoded fallback copy. The backend
// seeds mission/skills/faq blocks into AboutPage.facts (localized per
// language) and /apis/pages/about/ exposes them under mission_values /
// skills / faq. Empty sections render nothing rather than static strings.
const skills = (pageData?.skills as any[] | undefined) || [];
const missionValues = (pageData?.mission_values as any[] | undefined) || [];

const testimonialItems = pageTestimonials?.length ? pageTestimonials.map((t: any) => ({
  quote: String(t.quote || ''),
  author: String(t.author || ''),
  role: String(t.role || ''),
})) : [];

const faqItems = (pageFaq?.length ? pageFaq : (pageData?.faq as any[] | undefined))?.map((f: any) => ({
  question: String(f.question || ''),
  answer: String(f.answer || ''),
})) || [];
---

<Layout
  title={pageData?.title || 'About'}
  description={pageData?.search_description || 'CTC Research — a global center of excellence for clinical research, evidence synthesis, and health innovation.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="about"
>
  <Hero
    eyebrow={pageHero?.badge || 'about · ctc research'}
    heading={pageHero?.title || 'CTC Research'}
    accent='medical research center'
    intro={pageHero?.subtitle || 'A globally recognized center of excellence advancing health and well-being through interdisciplinary innovation and high-impact research.'}
    primaryCta={pageHero?.primary_cta ? { label: pageHero.primary_cta.label, href: pageHero.primary_cta.href } : { label: 'Explore courses', href: '/courses/' }}
    secondaryCta={pageHero?.secondary_cta ? { label: pageHero.secondary_cta.label, href: pageHero.secondary_cta.href } : { label: 'Meet the team', href: '/team/' }}
    gallery={galleryItems}
    variant="research"
  />

  <CounterCard
    counters={bioCounters?.length ? bioCounters : undefined}
    heading="The center, in numbers"
    intro="A concise view of the research, training, and writing work supported by CTC Research."
  />

  <section class='about-subpage about-subpage--directory doc-sheet bg-fu-card py-16 md:py-20' data-localized-block='directory'>
    <div class='container-fusion'>
      <div class='about-subpage__intro'>
        <p class='tag-marker mb-4'>about CTC Research</p>
        <h2 class='page-section__title'>Explore the center</h2>
        <p class='text-fu-muted'>Read how we work, how we teach, and how research teams can work with us.</p>
      </div>
      <div class='about-subpage__grid about-subpage__grid--compact'>
        <a class='about-subpage__card about-subpage__card--link' href='/about/research/'>
          <span class='about-subpage__index'>01</span>
          <h3>Research approach</h3>
          <p>Protocols, evidence synthesis, and publication practice.</p>
          <span class='about-subpage__arrow' aria-hidden='true'>→</span>
        </a>
        <a class='about-subpage__card about-subpage__card--link' href='/about/education/'>
          <span class='about-subpage__index'>02</span>
          <h3>Education and training</h3>
          <p>Courses for clinicians, researchers, biostatisticians, and medical writers.</p>
          <span class='about-subpage__arrow' aria-hidden='true'>→</span>
        </a>
      </div>
    </div>
  </section>

  {missionValues.length ? (
  <section class='doc-sheet bg-fu-paper py-20 md:py-24' data-localized-block='mission'>
    <div class='container-fusion'>
      <div class='mx-auto mb-14 max-w-2xl text-center'>
        <p class='tag-marker mb-4'>{pageData?.mission_subtitle || 'philosophy'}</p>
        <h2 class='mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>{pageData?.mission_title || 'Why CTC Research'}</h2>
        {pageData?.mission_intro ? <p class='text-fu-muted'>{pageData.mission_intro}</p> : null}
      </div>
      <div class='grid grid-cols-1 gap-5 md:grid-cols-3'>
        {missionValues.map((value, i) => (
          <div class='card reveal p-6' x-data x-intersect="$el.classList.add('reveal-visible')" style={`transition-delay: ${i * 80}ms`}>
            <div class='mb-4 inline-flex h-10 w-10 items-center justify-center rounded-md border border-fu-line bg-fu-card text-fu-link'>
              <svg class='h-5 w-5' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='1.8' aria-hidden='true'>
                <path stroke-linecap='round' stroke-linejoin='round'
                  d={i === 0 ? 'M12 3v18M3 12h18M12 7l1.5 3 3 1.5-3 1.5L12 17l-1.5-3-3-1.5 3-1.5L12 7z'
                    : i === 1 ? 'M13 10V3L4 14h7v7l9-11h-7z'
                    : 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'} />
              </svg>
            </div>
            <h3 class='mb-2 font-display text-[1.05rem] font-semibold text-fu-ink'>{value.title}</h3>
            <p class='text-sm leading-relaxed text-fu-muted'>{value.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  ) : null}

  <CertificateCard
    heading='Credentials that travel'
    intro='Every program at the center issues a verifiable completion record, from evidence synthesis to biostatistics for clinical teams.'
  />

  {skills.length ? (
  <Features
    heading={pageData?.skills_title || 'What we do, in detail'}
    intro={pageData?.skills_intro || 'From protocol design to publication integrity, these are the capabilities that power CTC Research.'}
    features={skills.map((s) => ({
      icon: 'rocket' as const,
      title: s.title,
      description: s.description,
      _iconPath: s.icon_class || s.icon || '',
    }))}
  />
  ) : null}

  {testimonialItems.length ? <Testimonials testimonials={testimonialItems} /> : null}
  {faqItems.length ? <FAQ items={faqItems} /> : null}

  {methods?.length ? (
  <section class='doc-sheet bg-fu-card py-20 md:py-28'>
    <div class='container-fusion'>
      <div class='mb-12 max-w-2xl'>
        <p class='eyebrow-pill mb-5'>what we do</p>
        <h2 class='mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>Our methods</h2>
      </div>
      <div class='grid grid-cols-1 gap-5 md:grid-cols-3'>
        {methods.map((method: string, i: number) => (
          <div class='card reveal p-6' x-data x-intersect="$el.classList.add('reveal-visible')" style={`transition-delay: ${i * 80}ms`}>
            <span class='mb-4 block font-mono text-[0.65rem] uppercase tracking-[0.14em] text-fu-teal'>{String(i + 1).padStart(2, '0')}</span>
            <p class='font-display text-lg font-normal text-fu-ink'>{method}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  ) : null}

  {experienceDesc || videoLink ? (
  <section class='doc-sheet bg-fu-paper py-20 md:py-28'>
    <div class='container-fusion max-w-3xl'>
      {experienceDesc ? <div class='text-lg leading-relaxed text-fu-muted' set:html={experienceDesc} /> : null}
      {videoLink ? (
        <a href={videoLink} target='_blank' rel='noopener noreferrer' class='btn-secondary mt-8 inline-flex items-center gap-2'>
          <svg class='h-5 w-5' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='1.8' aria-hidden='true'><path stroke-linecap='round' stroke-linejoin='round' d='M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z'/><path stroke-linecap='round' stroke-linejoin='round' d='M21 12a9 9 0 11-18 0 9 9 0 0118 0z'/></svg>
          Watch video
        </a>
      ) : null}
    </div>
  </section>
  ) : null}

  {galleryItems?.length ? (
  <section class='doc-sheet bg-fu-card py-20 md:py-28'>
    <div class='container-fusion'>
      <div class='mb-12 max-w-2xl'>
        <p class='eyebrow-pill mb-5'>gallery</p>
        <h2 class='mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>Snapshots</h2>
      </div>
      <div class='grid grid-flow-dense grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3'>
        {galleryItems.map((item: any, i: number) => (
          <div class='card reveal group overflow-hidden' x-data x-intersect="$el.classList.add('reveal-visible')" style={`transition-delay: ${i * 60}ms`}>
            <div class='aspect-square overflow-hidden bg-fu-line/40'>
              {item.src ? (
                <img src={item.src} alt={item.alt || item.caption} loading='lazy' class='h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105' />
              ) : item.embedUrl ? (
                <div class='flex h-full w-full items-center justify-center bg-fu-ink/5 text-fu-teal'>
                  <a href={item.embedUrl} target='_blank' rel='noopener noreferrer' aria-label='Play video'>
                    <svg class='h-10 w-10' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='1.6' aria-hidden='true'><path stroke-linecap='round' stroke-linejoin='round' d='M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z'/><path stroke-linecap='round' stroke-linejoin='round' d='M21 12a9 9 0 11-18 0 9 9 0 0118 0z'/></svg>
                  </a>
                </div>
              ) : null}
            </div>
            {(item.caption || item.category) ? (
              <div class='p-4'>
                {item.category ? <span class='mb-2 inline-block rounded-full bg-fu-teal/10 px-3 py-1 text-xs font-medium text-fu-teal'>{item.category}</span> : null}
                {item.caption ? <p class='text-sm text-fu-muted'>{item.caption}</p> : null}
              </div>
            ) : null}
          </div>
        ))}
      </div>
    </div>
  </section>
  ) : null}

  <CTA
    heading={pageCta?.title || "Let's advance health together"}
    intro={pageCta?.subtitle || 'Partner with us on clinical research, evidence synthesis, and health innovation — or join a learning path.'}
    ctaLabel={pageCta?.primary_cta?.label || 'Get in touch'}
    ctaHref={pageCta?.primary_cta?.href || '/contact/'}
  />

  <Toast />
</Layout>

<script>
  // The CTC frontend is intentionally static for fast delivery. When a
  // visitor requests a locale with ?lang=, hydrate the visible About page
  // from the authoritative localized Wagtail API instead of serving the
  // English build artifact unchanged.
  const SUPPORTED = ['en', 'sv', 'fr', 'de', 'es', 'ar', 'pt-br'];
  const UI_COPY = {
    en: { directory: 'Explore the center', directoryIntro: 'Read how we work, how we teach, and how research teams can work with us.', research: 'Research approach', researchText: 'Protocols, evidence synthesis, and publication practice.', education: 'Education and training', educationText: 'Courses for clinicians, researchers, biostatisticians, and medical writers.', counters: 'The center, in numbers', counterIntro: 'A concise view of the research, training, and writing work supported by CTC Research.', credentials: 'Credentials that travel', credentialsIntro: 'Every program at the center issues a verifiable completion record, from evidence synthesis to biostatistics for clinical teams.', faq: 'Questions, answered clearly', ctaFallback: 'Let’s advance health together', ctaIntro: 'Partner with us on clinical research, evidence synthesis, and health innovation — or join a learning path.', ctaLabel: 'Get in touch' },
    ar: { directory: 'استكشف المركز', directoryIntro: 'تعرّف إلى طريقة عملنا وتعليمنا وكيف يمكن لفرق البحث التعاون معنا.', research: 'منهج البحث', researchText: 'تصميم البروتوكولات وتجميع الأدلة وممارسة النشر.', education: 'التعليم والتدريب', educationText: 'دورات للأطباء والباحثين والإحصائيين الحيويين والكتّاب الطبيين.', counters: 'المركز بالأرقام', counterIntro: 'لمحة موجزة عن البحث والتدريب والكتابة التي يدعمها مركز سي تي سي للبحث.', credentials: 'شهادات تمتد معك', credentialsIntro: 'يصدر كل برنامج في المركز سجلاً قابلاً للتحقق عند إتمامه، من تجميع الأدلة إلى الإحصاء الحيوي للفرق السريرية.', faq: 'أسئلة وإجابات واضحة', ctaFallback: 'لنتقدم بالصحة معاً', ctaIntro: 'تعاون معنا في البحث السريري والأدلة السريرية والابتكار الصحي، أو ابدأ مساراً تعليمياً.', ctaLabel: 'تواصل معنا' },
    de: { directory: 'Das Zentrum entdecken', directoryIntro: 'Erfahren Sie, wie wir arbeiten, lehren und mit Forschungsteams zusammenarbeiten.', research: 'Forschungsansatz', researchText: 'Protokolle, Evidenzsynthese und Publikationspraxis.', education: 'Bildung und Training', educationText: 'Kurse für Ärzte, Forschende, Biostatistiker und medizinische Autoren.', counters: 'Das Zentrum in Zahlen', counterIntro: 'Ein kompakter Überblick über die von CTC Research unterstützte Forschung, Ausbildung und wissenschaftliche Arbeit.', credentials: 'Zertifikate, die bleiben', credentialsIntro: 'Jedes Programm stellt einen überprüfbaren Abschlussnachweis aus.', faq: 'Fragen, klar beantwortet', ctaFallback: 'Gemeinsam Gesundheit voranbringen', ctaIntro: 'Arbeiten Sie mit uns an klinischer Forschung, klinischer Evidenz und Innovation.', ctaLabel: 'Kontakt aufnehmen' },
    es: { directory: 'Explora el centro', directoryIntro: 'Conoce cómo trabajamos, cómo enseñamos y cómo colaboramos con equipos de investigación.', research: 'Enfoque de investigación', researchText: 'Protocolos, síntesis de evidencia y práctica editorial.', education: 'Educación y formación', educationText: 'Cursos para clínicos, investigadores, bioestadísticos y escritores médicos.', counters: 'El centro en cifras', counterIntro: 'Una visión breve de la investigación, formación y escritura que apoya CTC Research.', credentials: 'Credenciales que te acompañan', credentialsIntro: 'Cada programa emite un registro verificable de finalización.', faq: 'Preguntas con respuestas claras', ctaFallback: 'Avancemos juntos la salud', ctaIntro: 'Colabora con nosotros en investigación clínica, evidencia clínica e innovación sanitaria.', ctaLabel: 'Contacta con nosotros' },
    fr: { directory: 'Découvrir le centre', directoryIntro: 'Découvrez notre façon de travailler, d’enseigner et de collaborer avec les équipes de recherche.', research: 'Approche de recherche', researchText: 'Protocoles, synthèse des données probantes et publication.', education: 'Éducation et formation', educationText: 'Des formations pour cliniciens, chercheurs, biostatisticiens et rédacteurs médicaux.', counters: 'Le centre en chiffres', counterIntro: 'Un aperçu concis des travaux de recherche, de formation et de rédaction soutenus par CTC Research.', credentials: 'Des attestations qui vous suivent', credentialsIntro: 'Chaque programme délivre un relevé de réussite vérifiable.', faq: 'Des réponses claires à vos questions', ctaFallback: 'Faisons progresser la santé ensemble', ctaIntro: 'Collaborez avec nous sur la recherche clinique, les données cliniques et l’innovation en santé.', ctaLabel: 'Nous contacter' },
    'pt-br': { directory: 'Explore o centro', directoryIntro: 'Veja como trabalhamos, ensinamos e colaboramos com equipes de pesquisa.', research: 'Abordagem de pesquisa', researchText: 'Protocolos, síntese de evidências e publicação científica.', education: 'Educação e treinamento', educationText: 'Cursos para clínicos, pesquisadores, bioestatísticos e redatores médicos.', counters: 'O centro em números', counterIntro: 'Uma visão concisa da pesquisa, formação e redação apoiadas pela CTC Research.', credentials: 'Credenciais que acompanham você', credentialsIntro: 'Cada programa emite um registro verificável de conclusão.', faq: 'Perguntas respondidas com clareza', ctaFallback: 'Vamos avançar a saúde juntos', ctaIntro: 'Colabore conosco em pesquisa clínica, evidências clínicas e inovação em saúde.', ctaLabel: 'Fale conosco' },
    sv: { directory: 'Utforska centret', directoryIntro: 'Läs om hur vi arbetar, undervisar och samarbetar med forskarteam.', research: 'Forskningsansats', researchText: 'Protokoll, evidenssyntes och publiceringsarbete.', education: 'Utbildning och träning', educationText: 'Kurser för kliniker, forskare, biostatistiker och medicinska skribenter.', counters: 'Centret i siffror', counterIntro: 'En kort översikt över den forskning, utbildning och skrivning som CTC Research stöder.', credentials: 'Meriter som följer med', credentialsIntro: 'Varje program ger ett verifierbart intyg efter slutförande.', faq: 'Frågor med tydliga svar', ctaFallback: 'Låt oss utveckla hälsan tillsammans', ctaIntro: 'Samarbeta med oss kring klinisk forskning, klinisk evidens och hälsoinnovation.', ctaLabel: 'Kontakta oss' },
  };

  const stripHtml = (value: unknown): string => String(value || '').replace(/<[^>]*>/g, '').trim();
  const setText = (root: Element | null, selector: string, value: unknown): void => {
    const node = root?.querySelector(selector);
    if (node && value) node.textContent = String(value);
  };
  const setMany = (root: Element | null, selector: string, values: unknown[]): void => {
    root?.querySelectorAll(selector).forEach((node: Element, index: number) => {
      if (values[index]) node.textContent = String(values[index]);
    });
  };

  async function syncLocalizedAbout() {
    const requested = new URLSearchParams(window.location.search).get('lang')?.toLowerCase();
    if (!requested || !SUPPORTED.includes(requested) || requested === 'en') return;
    try {
      // The public site can briefly return a gateway response while Django and
      // the proxy warm their caches. Retry a bounded number of times so a
      // localized request never silently falls back to the English static shell.
      let data: Record<string, any> | null = null;
      for (let attempt = 0; attempt < 3 && !data; attempt += 1) {
        try {
          const response: Response = await window.fetch(`/apis/pages/about/?lang=${encodeURIComponent(requested)}&locale_refresh=1`, {
            cache: 'no-store',
            headers: { Accept: 'application/json' },
          });
          if (response.ok) {
            const candidate: Record<string, any> = await response.json() as Record<string, any>;
            if (candidate.language === requested) data = candidate;
          }
        } catch (error) {
          // Retry transient network failures; the final catch below preserves
          // the usable static page if the backend remains unavailable.
        }
        if (!data && attempt < 2) await new Promise((resolve) => setTimeout(resolve, 250 * (attempt + 1)));
      }
      if (!data) return;
      const copy = UI_COPY[requested as keyof typeof UI_COPY] || UI_COPY.en;
      const hero = document.querySelector('[data-localized-block="hero"]');
      const heroData = data.hero || {};
      setText(hero, '.hero__eyebrow', heroData.badge);
      setText(hero, '.hero__heading', heroData.title || data.title);
      setText(hero, '.hero__intro', heroData.subtitle || data.mission_intro || stripHtml(data.experience_description));
      setMany(hero, '.hero__actions a', [heroData.primary_cta?.label, heroData.secondary_cta?.label]);

      const directory = document.querySelector('[data-localized-block="directory"]');
      setText(directory, 'h2', copy.directory);
      setText(directory, '.about-subpage__intro p:last-child', copy.directoryIntro);
      setMany(directory, '.about-subpage__card h3', [copy.research, copy.education]);
      setMany(directory, '.about-subpage__card p', [copy.researchText, copy.educationText]);

      const counters = document.querySelector('.fu-counter');
      setText(counters, '.fu-counter__header h2', copy.counters);
      setText(counters, '.fu-counter__header p', copy.counterIntro);

      const mission = document.querySelector('[data-localized-block="mission"]');
      // The mission block's title/subtitle are plain utility-class headings
      // (not `.page-section__title` like the Features/FAQ blocks), so target
      // them by their actual markup inside the centered intro container.
      setText(mission, '.mx-auto .tag-marker', data.mission_subtitle);
      setText(mission, '.mx-auto h2', data.mission_title);
      setText(mission, '.mx-auto p.text-fu-muted', data.mission_intro);
      setMany(mission, '.card h3', (data.mission_values || []).map((item: { title: string }) => item.title));
      setMany(mission, '.card p', (data.mission_values || []).map((item: { text: string }) => item.text));

      const skills = document.querySelector('[data-localized-block="skills"]');
      setText(skills, '.page-section__title', data.skills_title);
      setText(skills, '.features__header p.text-fu-muted', data.skills_intro);
      setMany(skills, '.features__title', (data.skills || []).map((item: { title: string }) => item.title));
      setMany(skills, '.features__text', (data.skills || []).map((item: { description: string }) => item.description));

      const faq = document.querySelector('[data-localized-block="faq"]');
      setText(faq, '.page-section__title', copy.faq);
      const faqItems = data.faq || [];
      faq?.querySelectorAll('.faq__list > div').forEach((item, index) => {
        const question = item.querySelector('button span.flex-1');
        const answer = item.querySelector('button ~ div p');
        if (faqItems[index]) {
          if (question) question.textContent = faqItems[index].question;
          if (answer) answer.textContent = faqItems[index].answer;
          (item as HTMLElement).hidden = false;
        } else (item as HTMLElement).hidden = true;
      });

      const cta = document.querySelector('[data-localized-block="cta"]');
      setText(cta, '.cta__heading', data.cta?.title || copy.ctaFallback);
      setText(cta, '.cta__intro', data.cta?.subtitle || copy.ctaIntro);
      setText(cta, '.cta__actions a:first-child', data.cta?.primary_cta?.label || copy.ctaLabel);

      document.documentElement.setAttribute('lang', requested);
      document.documentElement.setAttribute('dir', requested === 'ar' ? 'rtl' : 'ltr');
      document.documentElement.dataset.language = requested;
      document.documentElement.dataset.localizedReady = requested;
      document.title = data.title || document.title;
      document.querySelector('meta[name="description"]')?.setAttribute('content', data.seo?.description || data.mission_intro || '');
    } catch (error) {
      console.warn('Localized About content could not be loaded', error);
    }
  }

  syncLocalizedAbout();
</script>

---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import CounterCard from '@/components/blocks/CounterCard.astro';
import CertificateCard from '@/components/blocks/CertificateCard.astro';
import Features from '@/components/blocks/Features.astro';
import Testimonials from '@/components/blocks/Testimonials.astro';
import FAQ from '@/components/blocks/FAQ.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';

// ── Fetch from backend, fall back to static content ──
let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('about'),
  ]);
} catch { /* use fallbacks */ }

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const pageStats = (pageData?.stats as any[] | undefined);
const pageFeatures = (pageData?.features as any[] | undefined);
const pageTestimonials = (pageData?.testimonials as any[] | undefined);
const pageFaq = (pageData?.faq as any[] | undefined);
const pageCounters = (pageData?.counters as any[] | undefined);
const pageGallery = (pageData?.gallery as any[] | undefined);
const experienceDesc = pageData?.experience_description;
const videoLink = pageData?.video_link;
const methods = pageData?.methods as string[] | undefined;

// ── Mapped from backend data (no hardcoded fallbacks) ──
// AboutPage seeds counters (not the generic `stats` field) — prefer them.
const bioCounters = (pageCounters?.length ? pageCounters : pageStats)?.map((s: any) => ({
  label: String(s.label || ''),
  value: Number(s.number ?? s.value ?? 0),
  suffix: String(s.suffix || ''),
}));

const galleryItems = pageGallery?.map((g: any) => ({
  type: String(g.media_type || 'image'),
  src: g.image?.image?.url || g.image?.url || '',
  alt: g.image?.alternative_text || g.caption || '',
  embedUrl: g.video?.embed_url || '',
  caption: String(g.caption || '').replace(/<[^>]+>/g, ''),
  category: g.category || '',
}));

const skills = pageFeatures?.length ? pageFeatures.map((f: any) => ({
  icon: String(f.icon || 'M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z'),
  title: String(f.title || ''),
  description: String(f.description || ''),
})) : [
  { icon: 'M12 3v18M3 12h18', title: 'Clinical study design', description: 'Translate the clinical need into a focused question, protocol, and analysis plan.' },
  { icon: 'M4 5h16M4 12h16M4 19h10', title: 'Evidence synthesis', description: 'Make search, appraisal, extraction, and uncertainty visible to the whole team.' },
  { icon: 'M3 20V4m0 16h18M7 16l3-5 3 3 5-8', title: 'Biostatistics and analytics', description: 'Use appropriate methods to interpret clinical data and communicate effect estimates.' },
  { icon: 'M4 4h16v16H4zM8 8h8M8 12h8M8 16h5', title: 'Scientific writing', description: 'Shape clear methods, results, discussion, and reporting for academic readers.' },
];

const missionValues = [
  { title: 'Interdisciplinary research', text: 'Medical AI, biostatistics, and clinical evidence synthesis in one center — from protocol design to publication integrity.' },
  { title: 'Evidence you can build on', text: 'Structured methods, reproducible reviews, and responsible data analytics that turn research intent into trusted evidence.' },
  { title: 'Learning that sticks', text: 'Courses and certificates shaped for clinicians, biostatisticians, and medical writers — with a visible next action at every step.' },
];

const testimonialItems = pageTestimonials?.length ? pageTestimonials.map((t: any) => ({
  quote: String(t.quote || ''),
  author: String(t.author || ''),
  role: String(t.role || ''),
})) : [{
  quote: 'The strongest part of the process was seeing the reasoning documented from question to manuscript.',
  author: 'Clinical research partner',
  role: 'Evidence program · CTC Research',
}];

const faqItems = pageFaq?.length ? pageFaq.map((f: any) => ({
  question: String(f.question || ''),
  answer: String(f.answer || ''),
})) : [
  { question: 'What makes the CTC approach different?', answer: 'We connect clinical context, transparent methods, evidence quality, and publication practice instead of treating them as separate handoffs.' },
  { question: 'Can you work with an existing protocol or manuscript?', answer: 'Yes. We can review a draft, strengthen the analysis plan, or help the team identify the next defensible research step.' },
];
---

<Layout
  title={pageData?.title || 'About'}
  description={pageData?.search_description || 'CTC Research — a global center of excellence for medical AI, clinical research, and health innovation.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="about"
>
  <Hero
    eyebrow={pageHero?.badge || 'about · ctc research'}
    heading={pageHero?.title || 'CTC Research'}
    accent='medical research center'
    intro={pageHero?.subtitle || 'A globally recognized center of excellence advancing health and well-being through interdisciplinary innovation, medical AI, and high-impact research.'}
    primaryCta={pageHero?.primary_cta ? { label: pageHero.primary_cta.label, href: pageHero.primary_cta.href } : { label: 'Explore courses', href: '/courses/' }}
    secondaryCta={pageHero?.secondary_cta ? { label: pageHero.secondary_cta.label, href: pageHero.secondary_cta.href } : { label: 'Meet the team', href: '/team/' }}
    status='200 OK · text/html · the center, in one response'
    gallery={galleryItems}
  />

  <CounterCard
    counters={bioCounters?.length ? bioCounters : undefined}
    heading="The center, in numbers"
    intro="A concise view of the research, training, and writing work supported by CTC Research."
  />

  <section class='about-subpage about-subpage--directory doc-sheet bg-fu-card py-16 md:py-20'>
    <div class='container-fusion'>
      <div class='about-subpage__intro'>
        <p class='tag-marker mb-4'>about CTC Research</p>
        <h2 class='page-section__title'>Explore the center</h2>
        <p class='text-fu-muted'>Read how we work, how we teach, and how research teams can work with us.</p>
      </div>
      <div class='about-subpage__grid about-subpage__grid--compact'>
        <a class='about-subpage__card about-subpage__card--link' href='/about/research/'>
          <span class='about-subpage__index'>01</span>
          <h3>Research approach</h3>
          <p>Protocols, evidence synthesis, medical AI, and publication practice.</p>
          <span class='about-subpage__arrow' aria-hidden='true'>→</span>
        </a>
        <a class='about-subpage__card about-subpage__card--link' href='/about/education/'>
          <span class='about-subpage__index'>02</span>
          <h3>Education and training</h3>
          <p>Courses for clinicians, researchers, biostatisticians, and medical writers.</p>
          <span class='about-subpage__arrow' aria-hidden='true'>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class='doc-sheet bg-fu-paper py-20 md:py-24'>
    <div class='container-fusion'>
      <div class='mx-auto mb-14 max-w-2xl text-center'>
        <p class='tag-marker mb-4'>philosophy</p>
        <h2 class='mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>Why CTC Research</h2>
        <p class='text-fu-muted'>Three principles guide every program: interdisciplinary research, evidence you can build on, and learning that sticks.</p>
      </div>
      <div class='grid grid-cols-1 gap-5 md:grid-cols-3'>
        {missionValues.map((value, i) => (
          <div class='card reveal p-6' x-data x-intersect='`$el.classList.add("reveal-visible")`' style={`transition-delay: ${i * 80}ms`}>
            <div class='mb-4 inline-flex h-10 w-10 items-center justify-center rounded-md border border-fu-line bg-fu-card text-fu-link'>
              <svg class='h-5 w-5' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='1.8' aria-hidden='true'>
                <path stroke-linecap='round' stroke-linejoin='round'
                  d={i === 0 ? 'M12 3v18M3 12h18M12 7l1.5 3 3 1.5-3 1.5L12 17l-1.5-3-3-1.5 3-1.5L12 7z'
                    : i === 1 ? 'M13 10V3L4 14h7v7l9-11h-7z'
                    : 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'} />
              </svg>
            </div>
            <h3 class='mb-2 font-display text-[1.05rem] font-semibold text-fu-ink'>{value.title}</h3>
            <p class='text-sm leading-relaxed text-fu-muted'>{value.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CertificateCard
    heading='Credentials that travel'
    intro='Every program at the center issues a verifiable completion record, from evidence synthesis to biostatistics for clinical teams.'
  />

  {skills.length ? (
  <Features
    heading='What we do, in detail'
    intro='From protocol design to publication integrity, these are the capabilities that power CTC Research.'
    features={skills.map((s) => ({
      icon: 'rocket' as const,
      title: s.title,
      description: s.description,
      _iconPath: s.icon,
    }))}
  />
  ) : null}

  <Testimonials testimonials={testimonialItems} />
  <FAQ items={faqItems} />

  {methods?.length ? (
  <section class='doc-sheet bg-fu-card py-20 md:py-28'>
    <div class='container-fusion'>
      <div class='mb-12 max-w-2xl'>
        <p class='eyebrow-pill mb-5'>what we do</p>
        <h2 class='mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>Our methods</h2>
      </div>
      <div class='grid grid-cols-1 gap-5 md:grid-cols-3'>
        {methods.map((method: string, i: number) => (
          <div class='card reveal p-6' x-data x-intersect='`$el.classList.add("reveal-visible")`' style={`transition-delay: ${i * 80}ms`}>
            <span class='mb-4 block font-mono text-[0.65rem] uppercase tracking-[0.14em] text-fu-teal'>{String(i + 1).padStart(2, '0')}</span>
            <p class='font-display text-lg font-normal text-fu-ink'>{method}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  ) : null}

  {experienceDesc || videoLink ? (
  <section class='doc-sheet bg-fu-paper py-20 md:py-28'>
    <div class='container-fusion max-w-3xl'>
      {experienceDesc ? <div class='text-lg leading-relaxed text-fu-muted' set:html={experienceDesc} /> : null}
      {videoLink ? (
        <a href={videoLink} target='_blank' rel='noopener noreferrer' class='btn-secondary mt-8 inline-flex items-center gap-2'>
          <svg class='h-5 w-5' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='1.8' aria-hidden='true'><path stroke-linecap='round' stroke-linejoin='round' d='M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z'/><path stroke-linecap='round' stroke-linejoin='round' d='M21 12a9 9 0 11-18 0 9 9 0 0118 0z'/></svg>
          Watch video
        </a>
      ) : null}
    </div>
  </section>
  ) : null}

  {galleryItems?.length ? (
  <section class='doc-sheet bg-fu-card py-20 md:py-28'>
    <div class='container-fusion'>
      <div class='mb-12 max-w-2xl'>
        <p class='eyebrow-pill mb-5'>gallery</p>
        <h2 class='mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>Snapshots</h2>
      </div>
      <div class='grid grid-flow-dense grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3'>
        {galleryItems.map((item: any, i: number) => (
          <div class='card reveal group overflow-hidden' x-data x-intersect='`$el.classList.add("reveal-visible")`' style={`transition-delay: ${i * 60}ms`}>
            <div class='aspect-square overflow-hidden bg-fu-line/40'>
              {item.src ? (
                <img src={item.src} alt={item.alt || item.caption} loading='lazy' class='h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105' />
              ) : item.embedUrl ? (
                <div class='flex h-full w-full items-center justify-center bg-fu-ink/5 text-fu-teal'>
                  <a href={item.embedUrl} target='_blank' rel='noopener noreferrer' aria-label='Play video'>
                    <svg class='h-10 w-10' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='1.6' aria-hidden='true'><path stroke-linecap='round' stroke-linejoin='round' d='M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z'/><path stroke-linecap='round' stroke-linejoin='round' d='M21 12a9 9 0 11-18 0 9 9 0 0118 0z'/></svg>
                  </a>
                </div>
              ) : null}
            </div>
            {(item.caption || item.category) ? (
              <div class='p-4'>
                {item.category ? <span class='mb-2 inline-block rounded-full bg-fu-teal/10 px-3 py-1 text-xs font-medium text-fu-teal'>{item.category}</span> : null}
                {item.caption ? <p class='text-sm text-fu-muted'>{item.caption}</p> : null}
              </div>
            ) : null}
          </div>
        ))}
      </div>
    </div>
  </section>
  ) : null}

  <CTA
    heading={pageCta?.title || "Let's advance health together"}
    intro={pageCta?.subtitle || 'Partner with us on medical AI research, clinical evidence, and health innovation — or join a learning path.'}
    ctaLabel={pageCta?.primary_cta?.label || 'Get in touch'}
    ctaHref={pageCta?.primary_cta?.href || '/contact'}
  />

  <Toast />
</Layout>

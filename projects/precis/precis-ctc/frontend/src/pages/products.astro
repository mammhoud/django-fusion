---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import Stats from '@/components/blocks/Stats.astro';
import Testimonials from '@/components/blocks/Testimonials.astro';
import FAQ from '@/components/blocks/FAQ.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import ProductGrid from '@/components/ui/ProductGrid.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('products'),
  ]);
} catch { /* use fallbacks */ }

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const pageStats = (pageData?.stats as any[] | undefined);
const pageTestimonials = (pageData?.testimonials as any[] | undefined);
const pageFaq = (pageData?.faq as any[] | undefined);
const productCards = (pageData?.products?.length ? pageData.products : [
  { title: 'Research design', slug: 'research-design', tagline: 'From clinical question to analysis-ready protocol.', href: '/services/' },
  { title: 'Evidence synthesis', slug: 'evidence-synthesis', tagline: 'Reproducible reviews for decisions that need context.', href: '/courses/systematic-reviews-evidence-synthesis/' },
  { title: 'Scientific writing', slug: 'scientific-writing', tagline: 'Clear manuscripts, methods, and publication planning.', href: '/courses/scientific-medical-manuscript-writing/' },
]) as { title: string; slug: string; tagline: string; href: string }[];

const productStats = pageStats?.length ? pageStats.map((s: any) => ({
  label: String(s.label || ''), value: Number(s.value || 0), suffix: String(s.suffix || ''),
})) : [
  { label: 'Research domains', value: 4, suffix: '' },
  { label: 'Evidence workflows', value: 6, suffix: '' },
  { label: 'Course pathways', value: 6, suffix: '' },
  { label: 'Publication focus', value: 1, suffix: '' },
];
---

<Layout title={pageData?.title || 'Products'} description={pageData?.search_description || 'Programs and services from CTC Research — medical AI, clinical research, and health innovation.'} navItems={navData?.nav_items} siteSettings={siteSettings} pageData={pageData} pageSlug="products">
  <Hero eyebrow={pageHero?.badge || 'products · programs & services'} heading={pageHero?.title || 'Programs & services'} accent='for health innovation' intro={pageHero?.subtitle || 'Learning paths, research programs, and evidence services from a medical research center.'} primaryCta={pageHero?.primary_cta ? { label: pageHero.primary_cta.label, href: pageHero.primary_cta.href } : { label: 'Browse courses', href: '/courses/' }} secondaryCta={pageHero?.secondary_cta ? { label: pageHero.secondary_cta.label, href: pageHero.secondary_cta.href } : { label: 'Contact us', href: '/contact/' }} status='200 OK · text/html · the full program line in one response' variant="product" />
  <Stats stats={productStats} />

  <!-- Program cards grid — one card per ProductPage child (links to detail pages) -->
  {productCards?.length ? (
  <section id='products' class='doc-sheet bg-fu-paper py-16 md:py-20'>
    <div class='container-fusion'>
      <div class='mx-auto mb-12 max-w-2xl text-center'>
        <p class='tag-marker mb-4'>the program line</p>
        <h2 class='mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>Every program, one page each</h2>
        <p class='text-fu-muted'>Each program gets a reference page — learning paths, research services, and the evidence you can build on.</p>
      </div>
      <ProductGrid products={productCards} />
    </div>
  </section>
  ) : null}

  <Testimonials testimonials={pageTestimonials?.map((t: any) => ({ quote: String(t.quote || ''), author: String(t.author || ''), role: String(t.role || '') }))} />
  <FAQ items={pageFaq?.map((f: any) => ({ question: String(f.question || ''), answer: String(f.answer || '') }))} />
  <CTA heading={pageCta?.title || 'Advance health through research'} intro={pageCta?.subtitle || 'Join clinicians, biostatisticians, and medical writers building trusted evidence.'} ctaLabel={pageCta?.primary_cta?.label || 'Browse courses'} ctaHref={pageCta?.primary_cta?.href || '/courses/'} />
  <Toast />
  <HtmxBootstrap />
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import Stats from '@/components/blocks/Stats.astro';
import Testimonials from '@/components/blocks/Testimonials.astro';
import FAQ from '@/components/blocks/FAQ.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import ContentError from '@/components/ui/ContentError.astro';
import ProductGrid from '@/components/ui/ProductGrid.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('products'),
  ]);
} catch { /* use fallbacks */ }

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const pageStats = (pageData?.stats as any[] | undefined);
const pageTestimonials = (pageData?.testimonials as any[] | undefined);
const pageFaq = (pageData?.faq as any[] | undefined);
const productCards = (pageData?.products as { title: string; slug: string; tagline: string; href: string }[] | undefined);

const productStats = pageStats?.map((s: any) => ({
  label: String(s.label || ''), value: Number(s.value || 0), suffix: String(s.suffix || ''),
}));

interface ProductLine { name: string; id: string; tag: string; description: string; features: string[]; tech: string[]; href: string; cta: string; external?: boolean; }
const productLines: ProductLine[] = [
  { name: 'django-fusion', id: 'django-fusion', tag: 'component system · routing · fragment rendering', description: 'The backbone of every structa.cloud site. A component registry, HtmxDetails request detection, PageHandler views, and {% comp %} templates shared across all Django projects.', features: ['Component registry with lazy template resolution', 'HTMX request detection (HX-Request, HX-Target, HX-Trigger)', 'Unified fragment/layout render pipeline', 'PaginatedComponentView with HTMX pagination', 'Wagtail FusionPage integration', 'Server-Sent Events (SSE) support'], tech: ['Python', 'Django', 'Wagtail', 'HTMX'], href: 'https://github.com/mammhoud/django-fusion', cta: 'View on GitHub', external: true },
  { name: 'ceptor-ai', id: 'ceptor-ai', tag: 'AI chat client · MCP server · agent generation', description: 'An AI chat client with a Model Context Protocol (MCP) server. Powers BEM-to-component conversion and agent-assisted code generation.', features: ['MCP server for AI agent communication', 'AI chat client with multi-model support', 'BEM converter: design → component structure', 'Agent generation: prompts → code scaffolding', 'Template customization through prompt engineering'], tech: ['Python', 'MCP', 'AI/ML', 'Node.js'], href: 'https://github.com/mammhoud/ceptor-ai', cta: 'View on GitHub', external: true },
  { name: 'django-bolt', id: 'django-bolt', tag: 'Rust-backed API · high performance', description: 'A high-performance Rust-backed API framework for Django. BoltAPI integrates with Django models while leveraging Rust\'s performance.', features: ['Rust-powered API framework', 'BoltAPI: fast, concurrent request handling', 'Seamless Django ORM compatibility', 'Performance-optimized serialization'], tech: ['Rust', 'Python', 'Django', 'API'], href: 'https://github.com/dj-bolt/django-bolt', cta: 'View on GitHub', external: true },
  { name: 'vResume', id: 'vresume', tag: 'cloud resume platform · SaaS', description: 'A cloud-hosted resume builder. Create, update, and publish professional resumes with modern templates. Live at vresume.structa.cloud.', features: ['Modern resume templates with live preview', 'Cloud-hosted with custom domain support', 'PDF export with professional formatting', 'CI/CD pipeline for automated deployments'], tech: ['Django', 'Wagtail', 'Next.js', 'Cloud'], href: 'https://vresume.structa.cloud', cta: 'Launch vResume', external: true },
  { name: 'Forge POS', id: 'forge-pos', tag: 'desktop POS · Tauri 2 + Rust · three editions', description: 'A desktop point-of-sale application in three editions: Minimal (SQLite), Solo (embedded Python), and Full (multi-terminal + cloud CRM).', features: ['Three editions: Minimal, Solo, Full', 'Tauri 2 + Rust core with React/Vite frontend', 'SQLite storage with migration support', 'Kitchen display, employee scheduling (Full)', 'Time-bucketed KPI dashboards', 'Email-based support chat with MCP gating'], tech: ['Rust', 'Tauri 2', 'React', 'TypeScript', 'SQLite'], href: '/projects#forge-pos', cta: 'See project details' },
];
---

<Layout title={pageData?.title || 'Products'} description={pageData?.search_description || 'Structa Cloud products — django-fusion, ceptor-ai, django-bolt, vResume, and Forge POS.'} navItems={navData?.nav_items} siteSettings={siteSettings} pageData={pageData} pageSlug="products">
  <Hero eyebrow={pageHero?.badge || 'products · the full product line'} heading={pageHero?.title || 'Everything we build, shipped as'} accent='open source' intro={pageHero?.subtitle || 'Five products from one monorepo — three open-source libraries, one cloud platform, and a desktop POS in three editions.'} primaryCta={pageHero?.primary_cta ? { label: pageHero.primary_cta.label, href: pageHero.primary_cta.href } : { label: 'View on GitHub', href: 'https://github.com/mammhoud' }} secondaryCta={pageHero?.secondary_cta ? { label: pageHero.secondary_cta.label, href: pageHero.secondary_cta.href } : { label: 'See projects', href: '/projects' }} status='200 OK · text/html · the full product line in one response' />
  {productStats?.length ? <Stats stats={productStats} /> : <ContentError label="Stats data unavailable" />}

  <!-- Product pages grid — one card per ProductPage child (links to detail pages) -->
  {productCards?.length ? (
  <section id='products' class='doc-sheet bg-fu-paper py-16 md:py-20'>
    <div class='container-fusion'>
      <div class='mx-auto mb-12 max-w-2xl text-center'>
        <p class='tag-marker mb-4'>the product line</p>
        <h2 class='mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>Every product, one page each</h2>
        <p class='text-fu-muted'>Each product gets a reference page — editions &amp; pricing, tech stack, and snippets/models you can reuse.</p>
      </div>
      <!-- The catalog grid — server-rendered at build time, then kept in sync
           with the Redux products slice by the client ProductGrid. -->
      <ProductGrid products={productCards} />
    </div>
  </section>
  ) : null}

  <section class='doc-sheet bg-fu-paper py-20 md:py-24'>
    <div class='container-fusion'>
      <div class='mx-auto mb-14 max-w-2xl text-center'>
        <p class='tag-marker mb-4'>the line</p>
        <h2 class='mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>From libraries to platforms</h2>
        <p class='text-fu-muted'>Three libraries form the foundation. One platform shows what it can do in production. One desktop app proves the stack works everywhere.</p>
      </div>
      <div class='space-y-8'>
        {productLines.map((product, i) => (
          <div id={product.id} class='card reveal p-8' x-data x-intersect='`$el.classList.add("reveal-visible")`' style={`transition-delay: ${i * 80}ms`}>
            <div class='flex flex-col gap-6 lg:flex-row lg:items-start'>
              <div class='flex-1'>
                <p class='mb-1 font-mono text-[0.65rem] uppercase tracking-[0.16em] text-fu-muted'>{product.tag}</p>
                <h3 class='mb-3 font-display text-2xl font-bold tracking-tight text-fu-ink'>{product.name}</h3>
                <p class='mb-5 text-fu-muted leading-relaxed'>{product.description}</p>
                <div class='mb-5'>
                  <h4 class='mb-2 font-mono text-[0.7rem] uppercase tracking-[0.16em] text-fu-ink'>Features</h4>
                  <ul class='grid grid-cols-1 gap-1.5 sm:grid-cols-2'>
                    {product.features.map((feature) => (<li class='flex items-baseline gap-2 text-sm text-fu-muted'><span class='text-fu-link flex-shrink-0'>•</span><span>{feature}</span></li>))}
                  </ul>
                </div>
                <div class='flex flex-wrap items-center gap-2'>
                  {product.tech.map((t) => (<span class='inline-flex items-center rounded-md border border-fu-line bg-fu-card px-2.5 py-1 font-mono text-[0.68rem] text-fu-muted'>{t}</span>))}
                </div>
              </div>
              <div class='flex flex-col items-start gap-3 lg:w-48'>
                <a href={product.href} target={product.external ? '_blank' : undefined} rel={product.external ? 'noopener noreferrer' : undefined} class='btn-primary w-full justify-center'>
                  {product.cta}
                  {product.external && (<svg class='ml-1 h-4 w-4' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2' aria-hidden='true'><path stroke-linecap='round' stroke-linejoin='round' d='M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6v6m-9 3l9-9' /></svg>)}
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Testimonials testimonials={pageTestimonials?.map((t: any) => ({ quote: String(t.quote || ''), author: String(t.author || ''), role: String(t.role || '') }))} />
  <FAQ items={pageFaq?.map((f: any) => ({ question: String(f.question || ''), answer: String(f.answer || '') }))} />
  <!-- Product content is already rendered from page data; avoid requesting
       the full Astro document into an inner HTMX target. -->
  <CTA heading={pageCta?.title || 'Everything is open source'} intro={pageCta?.subtitle || 'All structa.cloud libraries are public on GitHub. Explore the code, open issues, or contribute.'} ctaLabel={pageCta?.primary_cta?.label || 'View on GitHub'} ctaHref={pageCta?.primary_cta?.href || 'https://github.com/mammhoud'} />
  <Toast />
  <HtmxBootstrap />
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation } from '@/lib/api';

let siteSettings;
let navData;
try {
  [siteSettings, navData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(),
  ]);
} catch { /* The shell remains available while the API recovers. */ }
---

<Layout
  title="Founder"
  description="The founder behind CTC Research — a clinician and researcher building rigorous, reproducible medical evidence."
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageSlug="about"
>
  <Hero
    eyebrow="about · founder & leadership"
    heading="Built by clinicians who"
    accent="read the methods first"
    intro="CTC Research was founded by a clinician-researcher who kept asking one question: can the evidence behind this decision be checked?"
    primaryCta={{ label: 'Meet the team', href: '/team/' }}
    secondaryCta={{ label: 'View services', href: '/services/' }}
    variant="research"
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }, { label: 'Founder' }]}
  />

  <section class="about-subpage doc-sheet bg-fu-card py-20 md:py-28">
    <div class="container-fusion">
      <div class="about-subpage__intro">
        <p class="tag-marker mb-4">the founder</p>
        <h2 class="page-section__title">A research record, built in the open</h2>
        <p class="text-fu-muted">CTC Research grew out of clinical practice and academic work — the same standards we teach and the same checks we run on every project.</p>
      </div>
      <div class="about-subpage__grid">
        <article class="about-subpage__card">
          <span class="about-subpage__index">01</span>
          <h3>Clinical grounding</h3>
          <p>Every methodology we teach starts from a real clinical question — the decision a clinician actually has to make with the evidence available.</p>
        </article>
        <article class="about-subpage__card">
          <span class="about-subpage__index">02</span>
          <h3>Reproducible by design</h3>
          <p>Protocols, analysis plans, and reporting checklists are first-class documents here, not afterthoughts of a finished study.</p>
        </article>
        <article class="about-subpage__card">
          <span class="about-subpage__index">03</span>
          <h3>Mentorship over gatekeeping</h3>
          <p>Research improves when more people can check it. Our courses and services exist to move teams from consuming evidence to producing it.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="about-subpage doc-sheet bg-fu-paper py-20 md:py-28">
    <div class="container-fusion about-subpage__split">
      <div>
        <p class="tag-marker mb-4">what we stand for</p>
        <h2 class="page-section__title">Evidence that survives scrutiny</h2>
      </div>
      <ul class="about-subpage__list">
        <li>Every conclusion cites its source; every source can be checked</li>
        <li>Statistical rigor over narrative certainty</li>
        <li>Medical AI judged by clinical validity, not demo polish</li>
        <li>Scientific writing that reports limitations as clearly as findings</li>
        <li>Open methods, reproducible pipelines, and honest peer review</li>
      </ul>
    </div>
  </section>

  <CTA
    heading="Work with a team that checks its work"
    intro="Bring your protocol, dataset, or manuscript — the founder and the research team will help you make the evidence defensible."
    ctaLabel="Start a conversation"
    ctaHref="/contact/"
  />
  <Toast />
</Layout>

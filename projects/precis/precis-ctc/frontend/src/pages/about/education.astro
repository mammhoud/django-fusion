---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import CertificateCard from '@/components/blocks/CertificateCard.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';

let siteSettings;
let navData;
let pageData;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('about')
  ]);
} catch { /* The shell remains available while the API recovers. */ }
---

<Layout
  title="Education and training"
  description="Academic courses and practical training in medical research, biostatistics, medical AI, and scientific writing."
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="about"
>
  <Hero
    eyebrow="about · education"
    heading="Learn the method"
    accent="behind the result"
    intro="CTC Research courses help clinicians, researchers, and medical writers make stronger decisions from protocol to publication."
    primaryCta={{ label: 'Browse courses', href: '/courses/' }}
    secondaryCta={{ label: 'See credentials', href: '#credentials' }}
    status="200 OK · academic learning"
  />

  <section class="about-subpage doc-sheet bg-fu-card py-20 md:py-28">
    <div class="container-fusion">
      <div class="about-subpage__intro">
        <p class="tag-marker mb-4">learning design</p>
        <h2 class="page-section__title">Training built around real research work</h2>
        <p class="text-fu-muted">Short lessons, applied exercises, and completion records make the learning path useful on the next study, not only on the final quiz.</p>
      </div>
      <div class="about-subpage__grid">
        <article class="about-subpage__card">
          <span class="about-subpage__index">01</span>
          <h3>Study design</h3>
          <p>Move from an important clinical question to a feasible, ethical, and analysis-ready protocol.</p>
        </article>
        <article class="about-subpage__card">
          <span class="about-subpage__index">02</span>
          <h3>Evidence literacy</h3>
          <p>Read research critically, synthesize findings, and explain uncertainty without flattening it.</p>
        </article>
        <article class="about-subpage__card">
          <span class="about-subpage__index">03</span>
          <h3>Publication practice</h3>
          <p>Write clear methods, results, and discussion sections that meet the expectations of academic readers.</p>
        </article>
      </div>
    </div>
  </section>

  <div id="credentials">
    <CertificateCard
      heading="Credentials for the next study"
      intro="Choose a focused learning path and leave with a record of the methods you can apply."
    />
  </div>

  <CTA
    heading="Choose your next research skill"
    intro="Start with the course that matches your role, then build toward a complete evidence workflow."
    ctaLabel="Browse courses"
    ctaHref="/courses/"
  />
  <Toast />
</Layout>

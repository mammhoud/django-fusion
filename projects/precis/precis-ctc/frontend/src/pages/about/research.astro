---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';

let siteSettings;
let navData;
let pageData;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('about')
  ]);
} catch { /* The shell remains available while the API recovers. */ }
---

<Layout
  title="Research approach"
  description="CTC Research's approach to clinical evidence, medical AI, and reproducible academic research."
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="about"
>
  <Hero
    eyebrow="about · research approach"
    heading="Research that can be"
    accent="checked"
    intro="We connect the research question, the data, the analysis plan, and the final manuscript so every decision can be understood and repeated."
    primaryCta={{ label: 'Discuss a study', href: '/contact/' }}
    secondaryCta={{ label: 'View services', href: '/services/' }}
    status="200 OK · reproducible evidence"
    variant="research"
  />

  <section class="about-subpage doc-sheet bg-fu-card py-20 md:py-28">
    <div class="container-fusion">
      <div class="about-subpage__intro">
        <p class="tag-marker mb-4">our method</p>
        <h2 class="page-section__title">A research record, not a black box</h2>
        <p class="text-fu-muted">Our teams make the reasoning behind a result visible. That makes collaboration easier and publication stronger.</p>
      </div>
      <div class="about-subpage__grid">
        <article class="about-subpage__card">
          <span class="about-subpage__index">01</span>
          <h3>Define the question</h3>
          <p>Translate a clinical need into a focused question, estimand, protocol, and outcome definition before analysis begins.</p>
        </article>
        <article class="about-subpage__card">
          <span class="about-subpage__index">02</span>
          <h3>Audit the evidence</h3>
          <p>Assess study quality, missingness, bias, and applicability with a documented evidence-synthesis workflow.</p>
        </article>
        <article class="about-subpage__card">
          <span class="about-subpage__index">03</span>
          <h3>Report the result</h3>
          <p>Turn analysis into a manuscript, decision brief, or teaching resource that states its limits as clearly as its findings.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="about-subpage doc-sheet bg-fu-paper py-20 md:py-28">
    <div class="container-fusion about-subpage__split">
      <div>
        <p class="tag-marker mb-4">research domains</p>
        <h2 class="page-section__title">Where we work</h2>
      </div>
      <ul class="about-subpage__list">
        <li>Clinical trial design and protocol development</li>
        <li>Systematic reviews and evidence synthesis</li>
        <li>Biostatistics and clinical data analytics</li>
        <li>Responsible medical AI and implementation research</li>
        <li>Scientific and medical manuscript writing</li>
      </ul>
    </div>
  </section>

  <CTA
    heading="Bring us the research question"
    intro="We can help shape the protocol, strengthen the evidence, or prepare the work for publication."
    ctaLabel="Start a conversation"
    ctaHref="/contact/"
  />
  <Toast />
</Layout>

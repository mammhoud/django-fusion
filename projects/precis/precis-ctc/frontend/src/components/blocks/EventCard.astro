---
// EventCard — BEM block for symposia, workshops, and research events.
// Adapted from .archives/theme/components/EventCard.html (Histudy LMS),
// re-skinned to the CTC Blue/Teal clinical theme.
interface EventItem {
  title: string;
  start_date?: string | null;
  location?: string;
  description?: string;
  event_type_label?: string;
  image?: string;
}

interface Props {
  event: EventItem;
  index?: number;
}

const { event, index = 0 } = Astro.props;

const fmt = (iso?: string | null) => {
  if (!iso) return '';
  try {
    const d = new Date(iso);
    return {
      day: d.toLocaleDateString('en-US', { day: '2-digit' }),
      month: d.toLocaleDateString('en-US', { month: 'short' }),
      full: d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
    };
  } catch {
    return '';
  }
};
const date = fmt(event.start_date);
---

<article
  class="fu-event-card group"
  x-data
  x-intersect="$el.classList.add('reveal-visible')"
  style={`--reveal-delay: ${index * 70}ms`}
>
  <div class="fu-event-card__media">
    {event.image ? (
      <img src={event.image} alt={event.title} loading="lazy" class="fu-event-card__img" />
    ) : (
      <div class="fu-event-card__placeholder" aria-hidden="true">CTC</div>
    )}
    {date && (
      <div class="fu-event-card__date" aria-hidden="true">
        <span class="fu-event-card__day">{date.day}</span>
        <span class="fu-event-card__month">{date.month}</span>
      </div>
    )}
  </div>

  <div class="fu-event-card__body">
    {event.event_type_label && <span class="fu-event-card__type">{event.event_type_label}</span>}

    <ul class="fu-event-card__meta">
      {event.location && (
        <li>
          <svg class="fu-event-card__meta-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-4.35-7-11a7 7 0 1114 0c0 6.65-7 11-7 11zM12 12a2.5 2.5 0 100-5 2.5 2.5 0 000 5z" />
          </svg>
          {event.location}
        </li>
      )}
      {date && (
        <li>
          <svg class="fu-event-card__meta-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {date.full}
        </li>
      )}
    </ul>

    <h3 class="fu-event-card__title">{event.title}</h3>
    {event.description && <p class="fu-event-card__text">{event.description}</p>}

    <a class="fu-event-card__cta" href="/contact/">
      Register
      <svg class="fu-event-card__cta-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</article>

---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  variant?: 'home' | 'research' | 'learning' | 'archive' | 'legal' | 'network' | 'contact' | 'product';
  index?: string;
  status?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const {
  eyebrow,
  title,
  intro = '',
  variant = 'research',
  index = '01',
  status = '200 OK · text/html',
  primaryCta,
  secondaryCta,
} = Astro.props;
---

<section class:list={['page-header', `page-header--${variant}`, 'reg-marks']} data-page-header={variant}>
  <div class="page-header__inner container-fusion">
    <div class="page-header__index" aria-hidden="true">{index}</div>
    <div class="page-header__copy">
      <p class="page-header__eyebrow">{eyebrow}</p>
      <h1 class="page-header__title">{title}</h1>
      {intro ? <p class="page-header__intro">{intro}</p> : null}
      {(primaryCta || secondaryCta) ? (
        <div class="page-header__actions">
          {primaryCta ? <a class="btn-primary" href={primaryCta.href}>{primaryCta.label} <span aria-hidden="true">→</span></a> : null}
          {secondaryCta ? <a class="btn-secondary" href={secondaryCta.href}>{secondaryCta.label}</a> : null}
        </div>
      ) : null}
      <p class="page-header__status"><span class="status-line"><span class="dot" aria-hidden="true"></span>{status}</span></p>
    </div>
    <div class="page-header__rail" aria-hidden="true">
      <span class="page-header__rail-line"></span>
      <span class="page-header__rail-mark">CTC / {variant.toUpperCase()}</span>
      <span class="page-header__rail-line"></span>
    </div>
  </div>
</section>

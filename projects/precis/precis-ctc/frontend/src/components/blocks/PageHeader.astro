---
import { publicHref } from '@/lib/site';
import Breadcrumb from '@/components/blocks/Breadcrumb.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  variant?: 'home' | 'research' | 'learning' | 'archive' | 'legal' | 'network' | 'contact' | 'product';
  index?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  /** Optional override; defaults to Home / <title>. */
  breadcrumbs?: { label: string; href?: string }[];
  /** Runtime-l10n key for the h1 (contact page: "contact.title"). */
  titleL10n?: string;
  /** Runtime-l10n key for the intro (contact page: "contact.description"). */
  introL10n?: string;
}

const {
  eyebrow,
  title,
  intro = '',
  variant = 'research',
  index = '01',
  primaryCta,
  secondaryCta,
  breadcrumbs = [{ label: 'Home', href: '/' }, { label: title }],
} = Astro.props;
---

<section class:list={['page-header', `page-header--${variant}`, 'reg-marks']} data-page-header={variant}>
  <div class="page-header__inner container-fusion">
    <div class="page-header__index" aria-hidden="true">{index}</div>
    <div class="page-header__copy">
      <Breadcrumb items={breadcrumbs} />
      <p class="page-header__eyebrow">{eyebrow}</p>
      <h1 class="page-header__title" data-l10n={Astro.props.titleL10n || undefined}>{title}</h1>
      {intro ? <p class="page-header__intro" data-l10n={Astro.props.introL10n || undefined}>{intro}</p> : null}
      {(primaryCta || secondaryCta) ? (
        <div class="page-header__actions">
          {primaryCta ? <a class="btn-primary" href={publicHref(primaryCta.href)}>{primaryCta.label} <span aria-hidden="true">→</span></a> : null}
          {secondaryCta ? <a class="btn-secondary" href={publicHref(secondaryCta.href)}>{secondaryCta.label}</a> : null}
        </div>
      ) : null}
    </div>
    <div class="page-header__rail" aria-hidden="true">
      <span class="page-header__rail-line"></span>
      <span class="page-header__rail-mark">CTC / {variant.toUpperCase()}</span>
      <span class="page-header__rail-line"></span>
    </div>
  </div>
</section>

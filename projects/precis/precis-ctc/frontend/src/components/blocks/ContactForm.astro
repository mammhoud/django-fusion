---
import { fusionApiUrl } from '@/lib/site';
import type { ContactFormField } from '@/lib/api';

interface ContactMethod {
  type: string;
  label: string;
  value: string;
  href: string;
}

interface Props {
  methods?: ContactMethod[];
  formTitle?: string;
  formDescription?: string;
  sectionTitle?: string;
  sectionDescription?: string;
  fields?: ContactFormField[];
}

const {
  methods: propMethods,
  formTitle = 'Send us a message',
  formDescription = 'Fill out the form and our team will get back to you.',
  sectionTitle = 'Get in touch',
  sectionDescription = 'Have a question or want to work with us? Send a message and we\'ll reply within one business day.',
  fields: propFields,
} = Astro.props;

// Contact methods come exclusively from the backend ContactPage (per locale).
// No hardcoded contact details: an empty list simply renders the form.
const methods: ContactMethod[] = propMethods && propMethods.length > 0 ? propMethods : [];

// Fields come exclusively from the backend ContactPage (editor-managed, per
// locale). No hardcoded field fallback.
const fields: ContactFormField[] = propFields && propFields.length > 0 ? propFields : [];

const contactEndpoint = `${fusionApiUrl.replace(/\/+$/, '')}/fragment/contact/`;

// Alpine form state built in frontmatter — Astro does NOT interpolate `${...}`
// inside quoted attributes, so the endpoint is baked in at build time.
const formXData = `{ submitting: false, async submit() {
  this.submitting = true;
  const fd = new FormData(this.$el);
  const body = Object.fromEntries(fd.entries());
  try {
    const res = await fetch('${contactEndpoint}', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'HX-Request': 'true' },
      body: JSON.stringify(body),
    });
    if (res.ok) {
      this.$el.reset();
      $store.toast.show('Message sent successfully! We\u2019ll get back to you soon.');
    } else {
      $store.toast.show('Failed to send message. Please try again.', 'error');
    }
  } catch {
    $store.toast.show('Network error \u2014 please try again in a moment.', 'error');
  } finally {
    this.submitting = false;
  }
} }`;
const methodIcons: Record<string, string> = {
  email: 'M3 8l7.5 5L18 8M4 19h16a1 1 0 001-1V6a1 1 0 00-1-1H4a1 1 0 00-1 1v12a1 1 0 001 1z',
  phone: 'M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012 4.2 2 2 0 014 2h3a2 2 0 012 1.7c.1 1 .4 2 .7 2.9a2 2 0 01-.5 2.1L8 10a16 16 0 006 6l1.3-1.2a2 2 0 012.1-.5c.9.3 1.9.6 2.9.7a2 2 0 011.7 2z',
  address: 'M17.7 2.9A8 8 0 0010 21a8 8 0 007.7-18.1zM10 11a2 2 0 100-4 2 2 0 000 4z',
  hours: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
};
---

<section id="contact" class="contact-form">
  <div class="container-fusion">
    <div class="contact-form__grid">
      <div class="contact-form__info">
        <div>
          <p class="tag-marker mb-4">contact</p>
          <h2 class="mb-2 font-display text-3xl font-bold tracking-tight text-fu-ink">{sectionTitle}</h2>
          <p class="text-fu-muted">{sectionDescription}</p>
        </div>
        {methods.map((method) => (
          <div class="card flex items-start gap-4 p-5">
            <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-md border border-fu-line bg-fu-card text-fu-link">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={methodIcons[method.type] || methodIcons.email} /></svg>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-fu-ink">{method.label}</h3>
              {method.href ? <a href={method.href} class="text-sm text-fu-muted transition-colors hover:text-fu-link">{method.value}</a> : <p class="text-sm text-fu-muted">{method.value}</p>}
            </div>
          </div>
        ))}
      </div>

      <div class="contact-form__form">
        <form
          class="card p-8"
          x-data={formXData}
          @submit.prevent="submit()"
          novalidate
        >
          <div class="mb-7 border-b border-fu-line pb-5">
            <h3 class="font-display text-2xl font-semibold tracking-tight text-fu-ink">{formTitle}</h3>
            <p class="mt-2 text-sm leading-relaxed text-fu-muted">{formDescription}</p>
          </div>

          <div class="contact-form__fields">
            {fields.map((field) => {
              const isTextarea = field.field_type === 'textarea';
              return isTextarea ? (
                <div class="mb-6">
                  <label for={`cf-${field.name}`} class="form-label">{field.label}</label>
                  <textarea id={`cf-${field.name}`} name={field.name} rows="5" class="input-field resize-none" placeholder={field.placeholder || ''} required={field.required ? true : undefined}></textarea>
                </div>
              ) : (
                <div>
                  <label for={`cf-${field.name}`} class="form-label">{field.label}</label>
                  <input id={`cf-${field.name}`} name={field.name} type={(field.field_type || 'text') as 'text' | 'email'} class="input-field" placeholder={field.placeholder || ''} required={field.required ? true : undefined} />
                </div>
              );
            })}
          </div>

          <button type="submit" class="btn-primary w-full" :disabled="submitting">
            <svg x-show="submitting" x-cloak class="h-5 w-5 animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.4 0 0 5.4 0 12h4z"></path></svg>
            <span x-show="!submitting">Send Message</span><span x-show="submitting" x-cloak>Sending...</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

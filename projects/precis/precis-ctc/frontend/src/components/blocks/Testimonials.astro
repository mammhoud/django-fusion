---
import Skeleton from '@/components/ui/Skeleton.astro';

interface Testimonial {
  quote: string;
  author: string;
  role: string;
  company?: string;
  avatar?: string;
  link?: { label: string; href: string };
}

interface Props {
  heading?: string;
  intro?: string;
  testimonials?: Testimonial[];
}

const defaultTestimonials: Testimonial[] = [
  {
    quote:
      'The evidence-synthesis training changed how our group writes protocols. Every study now starts with a reproducible method, not a blank page.',
    author: 'Dr. Laurens van Kleef',
    role: 'Postdoctoral Researcher',
    company: 'Erasmus MC',
    link: { label: 'Read case study', href: '/blog/' },
  },
  {
    quote:
      'As a medical writer, the structured-review workflow saves me weeks per manuscript. Clear method, clear reporting, no ambiguity.',
    author: 'Maya Okafor',
    role: 'Medical Writer',
    company: 'Independent',
    link: { label: 'Read case study', href: '/blog/' },
  },
  {
    quote:
      'The biostatistics track gave our clinicians a shared language with the data team. Study design is now a collaboration, not a handoff.',
    author: 'Dr. Sofia Reyes',
    role: 'Clinical Research Lead',
    company: 'Northwell Research',
    link: { label: 'Read case study', href: '/blog/' },
  },
];

const {
  heading = 'The work, reviewed by researchers',
  intro = 'Clinicians, biostatisticians, and medical writers on what changed when the method got structured.',
  testimonials = defaultTestimonials,
} = Astro.props;

const initials = (name: string) =>
  name
    .split(' ')
    .map((n) => n[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

<section class="fu-testimonials">
  <div class="container-fusion">
    <div class="fu-testimonials__header">
      <p class="tag-marker mb-4">reviews</p>
      <h2 class="page-section__title">{heading}</h2>
      <p class="text-fu-muted">{intro}</p>
    </div>

    <div data-hydrate-skeleton>
      <Skeleton variant="testimonials-carousel" />
    </div>

    <div data-hydrate-content class="fu-testimonials__carousel" x-data={`{ active: 0, total: ${testimonials.length} }`}>
      <div class="overflow-hidden">
        <div class="flex transition-transform duration-500 ease-out" :style="`transform: translateX(-${active * 100}%)`">
          {testimonials.map((t) => (
            <div class="w-full flex-shrink-0 px-1">
              <figure class="fu-testimonials__card">
                <span class="fu-testimonials__index" aria-hidden="true">
                  {String(testimonials.indexOf(t) + 1).padStart(2, '0')} / {String(testimonials.length).padStart(2, '0')}
                </span>

                <div class="fu-testimonials__rating" aria-label="Rated 5 out of 5">
                  <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M10 15l-5.9 3.1 1.1-6.6L.5 6.9l6.6-1L10 0l2.9 5.9 6.6 1-4.7 4.6 1.1 6.6z" />
                  </svg>
                  5.0 / 5.0
                </div>

                <blockquote class="fu-testimonials__quote">
                  &ldquo;{t.quote}&rdquo;
                </blockquote>

                <figcaption class="fu-testimonials__author">
                  <div class="fu-testimonials__avatar">
                    {t.avatar ? (
                      <img src={t.avatar} alt={t.author} width="48" height="48" loading="lazy" />
                    ) : (
                      initials(t.author)
                    )}
                  </div>
                  <div class="fu-testimonials__client">
                    <div class="fu-testimonials__name">{t.author}</div>
                    <div class="fu-testimonials__role">
                      {t.role}
                      {t.company && (
                        <>
                          <span class="fu-testimonials__company-sep" aria-hidden="true"> · </span>
                          <em>{t.company}</em>
                        </>
                      )}
                    </div>
                  </div>
                </figcaption>

                {t.link && (
                  <a class="fu-testimonials__link" href={t.link.href}>
                    {t.link.label}
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4-4 4M21 12H3" />
                    </svg>
                  </a>
                )}
              </figure>
            </div>
          ))}
        </div>
      </div>

      <div class="fu-testimonials__controls">
        <button
          type="button"
          class="btn-secondary !h-10 !w-10 !p-0"
          @click="active = active > 0 ? active - 1 : total - 1"
          aria-label="Previous testimonial"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <div class="flex gap-2">
          {testimonials.map((testimonial, i) => (
            <button
              type="button"
              class="h-1.5 rounded-full transition-all duration-300"
              :class={`active === ${i} ? 'w-7 bg-fu-link' : 'w-4 bg-fu-line hover:bg-fu-link/50'`}
              @click={`active = ${i}`}
              :aria-label={`Go to testimonial ${i + 1}`}
              title={testimonial.author}
            ></button>
          ))}
        </div>
        <button
          type="button"
          class="btn-secondary !h-10 !w-10 !p-0"
          @click="active = active < total - 1 ? active + 1 : 0"
          aria-label="Next testimonial"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

        .hero-ghost__blue { fill: #61C4F2; }
        .hero-ghost__pale { fill: #8BBCDB; }
        .hero-ghost__white { fill: #FFFFFF; }
        .hero-ghost__coral { fill: #F86464; }
      </style>

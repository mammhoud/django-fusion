---
import Skeleton from '@/components/ui/Skeleton.astro';
import MediaGallery from '@/components/ui/MediaGallery.astro';

// ═══════════════════════════════════════════════════════════════════
// CTC Research hero — brand-kit treatment (high-end-visual-design §3B)
// Editorial Luxury × Asymmetric Editorial Split: massive Fraunces serif
// on the left, a media/evidence panel on the right.
// Motion: spring cubic-bezier reveals; the evidence line sweeps in.
// The right-hand panel is a media gallery when `gallery` items are
// provided (from the seeded AboutPage gallery), otherwise a medical
// evidence panel — never a code block.
// ═══════════════════════════════════════════════════════════════════

interface GalleryItem {
  src: string;
  alt: string;
  caption: string;
  category: string;
  embedUrl?: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  accent?: string;
  intro?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  status?: string;
  /** Optional media gallery items for the right-hand panel. */
  gallery?: GalleryItem[];
  /** Optional evidence points shown when no gallery is provided. */
  evidence?: { value: string; label: string }[];
}

const {
  eyebrow = 'server-rendered · zero heavy SPA',
  heading = 'Your website, delivered as',
  accent = 'plain HTML',
  intro =
    'CTC Research advances health through interdisciplinary innovation — medical AI, clinical evidence, and high-impact research, delivered as fast, server-rendered documents.',
  primaryCta = { label: 'Start building', href: '/#cta' },
  secondaryCta = { label: 'Read the docs', href: '/about' },
  status = '200 OK · text/html · 0 KB client JS',
  gallery = [],
  evidence = [
    { value: '17+', label: 'years of research' },
    { value: '6', label: 'course programs' },
    { value: '7', label: 'languages' },
  ],
} = Astro.props;

const showGallery = gallery.length > 0;
---

<section class="hero">
  <!-- Skeleton while Alpine boots (x-intersect reveals) — component-matched height -->
  <div data-hydrate-skeleton>
    <Skeleton variant="hero-section" />
  </div>
  <div data-hydrate-content>
  <div class="hero__inner">
    <!-- ghost Protocol Mark watermark -->
    <svg class="hero__ghost" viewBox="0 0 200 200" fill="none" aria-hidden="true">
      <circle cx="98" cy="92" r="9" stroke="#1f8a70" stroke-width="3"/>
      <rect x="60" y="40" width="16" height="128" fill="currentColor"/>
      <rect x="76" y="40" width="56" height="16" fill="currentColor"/>
      <rect x="76" y="84" width="44" height="16" fill="currentColor"/>
      <line x1="36" y1="178" x2="152" y2="178" stroke="#c9962e" stroke-width="3"/>
    </svg>

    <div class="hero__content">
      <p
        class="hero__eyebrow"
        x-data x-intersect="$el.classList.add('reveal-visible')" x-cloak
      >
        {eyebrow}
      </p>

      <h1
        class="hero__heading"
        x-data x-intersect="$el.classList.add('reveal-visible')"
      >
        {heading}{' '}
        <span class="hero__accent">
          <span class="relative z-10">{accent}</span>
          <span class="hero__accent-mark" aria-hidden="true"></span>
        </span>
      </h1>

      <p
        class="hero__intro"
        x-data x-intersect="$el.classList.add('reveal-visible')"
        style="transition-delay: 100ms"
      >
        {intro}
      </p>

      <div
        class="hero__actions"
        x-data x-intersect="$el.classList.add('reveal-visible')"
        style="transition-delay: 200ms"
      >
        <a href={primaryCta.href} class="btn-primary group relative !px-8 !py-3.5 overflow-hidden">
          <span class="relative z-10">{primaryCta.label}</span>
          <span class="absolute inset-0 z-0 -translate-x-full bg-fu-link-dark transition-transform duration-500 group-hover:translate-x-0" style="transition-timing-function: cubic-bezier(0.32,0.72,0,1)" aria-hidden="true"></span>
          <span class="relative z-10 flex h-7 w-7 items-center justify-center rounded-full bg-white/15 transition-transform duration-500 group-hover:translate-x-0.5 group-hover:-translate-y-[1px]" style="transition-timing-function: cubic-bezier(0.34,1.56,0.64,1)">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </span>
        </a>
        <a href={secondaryCta.href} class="btn-secondary !px-8 !py-3.5">
          {secondaryCta.label}
        </a>
      </div>

      <p
        class="hero__status"
        x-data x-intersect="$el.classList.add('reveal-visible')"
        style="transition-delay: 260ms"
      >
        <span class="status-line"><span class="dot" aria-hidden="true"></span>{status}</span>
      </p>
    </div>

    <!-- ── Right-hand panel: media gallery OR medical evidence (no code) ── -->
    <div
      class="hero__source-toggle"
      x-data x-intersect="$el.classList.add('reveal-visible')"
      style="transition-delay: 320ms"
    >
      <div class="bezel">
        <div class="bezel__core">
          {showGallery ? (
            <div class="hero__gallery">
              <p class="tag-marker !text-fu-teal">media · ctc research</p>
              <MediaGallery items={gallery} compact bare />
            </div>
          ) : (
            <div class="hero__evidence">
              <p class="tag-marker !text-fu-teal">evidence · ctc research</p>
              <p class="hero__evidence-title">A center built on method</p>
              <p class="hero__evidence-text">
                Clinical trial design, biostatistics, evidence synthesis, and
                responsible medical AI — protocols reduced to reproducible method.
              </p>
              <div class="hero__evidence-grid">
                {evidence.map((point) => (
                  <div class="hero__evidence-item">
                    <span class="hero__evidence-value">{point.value}</span>
                    <span class="hero__evidence-label">{point.label}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
  </div>
</section>

    <div class="hero__content">
      {showBreadcrumb && (
        <div class="hero__breadcrumb" x-data x-intersect="$el.classList.add('reveal-visible')">
          <Breadcrumb items={breadcrumbs} />
        </div>
      )}
      <p
        class="hero__eyebrow"
        x-data x-intersect="$el.classList.add('reveal-visible')"
        data-l10n="hero.badge"
      >
        {eyebrow}
      </p>

      <h1
        class="hero__heading"
        x-data x-intersect="$el.classList.add('reveal-visible')"
      >
        <span data-l10n="hero.title">{heading}</span>{' '}
        <span class="hero__accent">
          <span class="relative z-10" data-l10n="hero.accent">{accent}</span>
          <span class="hero__accent-mark" aria-hidden="true"></span>
        </span>
      </h1>

      <p
        class="hero__intro"
        x-data x-intersect="$el.classList.add('reveal-visible')"
        style="transition-delay: 100ms"
        data-l10n="hero.subtitle"
      >
        {intro}
      </p>

      <div
        class="hero__actions"
        x-data x-intersect="$el.classList.add('reveal-visible')"
        style="transition-delay: 200ms"
      >
        <a href={primaryCta.href} class="btn-primary group relative !px-8 !py-3.5 overflow-hidden">
          <span class="relative z-10" data-l10n="hero.cta1">{primaryCta.label}</span>
          <span class="absolute inset-0 z-0 -translate-x-full bg-fu-link-dark transition-transform duration-500 group-hover:translate-x-0" style="transition-timing-function: cubic-bezier(0.32,0.72,0,1)" aria-hidden="true"></span>
          <span class="relative z-10 flex h-7 w-7 items-center justify-center rounded-full bg-white/15 transition-transform duration-500 group-hover:translate-x-0.5 group-hover:-translate-y-[1px]" style="transition-timing-function: cubic-bezier(0.34,1.56,0.64,1)">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </span>
        </a>
        <a href={secondaryCta.href} class="btn-secondary !px-8 !py-3.5" data-l10n="hero.cta2">
          {secondaryCta.label}
        </a>
      </div>

    </div>

    <!-- ── Right-hand panel: media gallery OR medical evidence (no code) ── -->
    <div class="hero__evidence-panel">
      <div class="bezel">
        <div class="bezel__core">
          {showGallery ? (
            <div class="hero__gallery">
              <p class="tag-marker !text-fu-teal">media · ctc research</p>
              <MediaGallery items={gallery} compact bare />
            </div>
          ) : (
            <div class="hero__evidence">
              <p class="tag-marker !text-fu-teal">evidence · ctc research</p>
              <p class="hero__evidence-title" data-l10n="home_chrome.evidence_panel.title">{evidenceTitle}</p>
              <p class="hero__evidence-text" data-l10n="home_chrome.evidence_panel.text">
                {evidenceText}
              </p>
              <div class="hero__evidence-grid">
                {evidence.map((point, index) => (
                  <div class="hero__evidence-item">
                    <span class="hero__evidence-value">{point.value}</span>
                    <span class="hero__evidence-label" data-l10n={`home_chrome.evidence_panel.stats.${index}.label`}>{point.label}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
  </div>
</section>

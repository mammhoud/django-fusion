---
import Skeleton from '@/components/ui/Skeleton.astro';
import MediaGallery from '@/components/ui/MediaGallery.astro';
import Breadcrumb from '@/components/blocks/Breadcrumb.astro';

// ═══════════════════════════════════════════════════════════════════
// CTC Research hero — brand-kit treatment (high-end-visual-design §3B)
// Editorial Luxury × Asymmetric Editorial Split: massive Fraunces serif
// on the left, a media/evidence panel on the right.
// Motion: spring cubic-bezier reveals; the evidence line sweeps in.
// The right-hand panel is a media gallery when `gallery` items are
// provided (from the seeded AboutPage gallery), otherwise a medical
// evidence panel — never a code block.
// ═══════════════════════════════════════════════════════════════════

interface GalleryItem {
  src: string;
  alt: string;
  caption: string;
  category: string;
  embedUrl?: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  accent?: string;
  intro?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  /** Optional media gallery items for the right-hand panel. */
  gallery?: GalleryItem[];
  /** Optional evidence points shown when no gallery is provided. */
  evidence?: { value: string; label: string }[];
  /** CMS evidence panel copy (HomePage.home_chrome → evidence_panel). */
  evidenceTitle?: string;
  evidenceText?: string;
  /** Page-specific visual treatment for the shared hero component. */
  variant?: 'home' | 'research' | 'learning' | 'archive' | 'legal' | 'network' | 'contact' | 'product';
  /** Optional breadcrumb override; defaults to Home / <heading>. */
  breadcrumbs?: { label: string; href?: string }[];
}

const {
  eyebrow = 'ctc research · medical research center',
  heading = 'Clear evidence for',
  accent = 'better health decisions',
  intro =
    'A medical research center that helps clinicians, researchers, and medical writers ask better questions, design sound studies, and publish results people can trust.',
  primaryCta = { label: 'Browse courses', href: '/courses/' },
  secondaryCta = { label: 'About the center', href: '/about/' },
  gallery = [],
  evidence = [
    { value: '17+', label: 'years of research' },
    { value: '6', label: 'course programs' },
    { value: '7', label: 'languages' },
  ],
  evidenceTitle = 'Evidence you can rely on',
  evidenceText =
    'The center supports clinical studies, evidence reviews, and medical writing — so health decisions rest on a solid foundation.',
  variant = 'research',
  breadcrumbs = [{ label: 'Home', href: '/' }, { label: heading }],
} = Astro.props;

const showGallery = gallery.length > 0;
const showBreadcrumb = breadcrumbs.length > 1;
---

<section class:list={["hero", `hero--${variant}`]} data-page-variant={variant} data-localized-block="hero">
  <!-- Skeleton while Alpine boots (x-intersect reveals) — component-matched height -->
  <div data-hydrate-skeleton>
    <Skeleton variant="hero-section" />
  </div>
  <div data-hydrate-content>
  <div class="hero__inner">
    <!-- Laboratory illustration watermark -->
    <svg class="hero__ghost" viewBox="0 0 122.88 112.48" fill="none" aria-hidden="true" role="img">

---
interface Props {
  siteName?: string;
  siteSettings?: {
    site_tagline?: string;
    footer_description?: string;
    footer_copyright?: string;
    footer_link_groups?: { title: string; links: { label: string; url: string }[] }[];
  };
}

const { siteName = 'CTC Research', siteSettings } = Astro.props;
const year = new Date().getFullYear();

const footerGroups = siteSettings?.footer_link_groups?.length
  ? siteSettings.footer_link_groups
  : [
    { title: 'Learning', links: [{ label: 'Courses', url: '/courses' }, { label: 'About', url: '/about' }, { label: 'Services', url: '/services' }] },
    { title: 'Support', links: [{ label: 'Contact', url: '/contact' }, { label: 'FAQ', url: '/faq' }, { label: 'Privacy', url: '/privacy' }] },
  ];
---

<footer class="doc-sheet border-t border-fu-line bg-fu-paper text-fu-muted">
  <div class="container-fusion py-20 md:py-24">
    <div class="grid grid-cols-1 gap-14 md:grid-cols-12">
      <!-- Brand column -->
      <div class="md:col-span-5">
        <a href="/" class="mb-5 inline-flex items-center gap-3 font-mono font-semibold text-fu-ink">
          <svg class="h-9 w-9" viewBox="0 0 200 200" fill="none" aria-hidden="true">
            <circle cx="98" cy="92" r="9" stroke="#1f8a70" stroke-width="5"/>
            <line x1="98" y1="44" x2="98" y2="120" stroke="#1f8a70" stroke-width="2" opacity=".55"/>
            <line x1="62" y1="92" x2="120" y2="92" stroke="#1f8a70" stroke-width="2" opacity=".55"/>
            <rect x="60" y="40" width="16" height="128" fill="currentColor"/>
            <rect x="76" y="40" width="56" height="16" fill="currentColor"/>
            <rect x="76" y="84" width="44" height="16" fill="currentColor"/>
            <line x1="36" y1="178" x2="152" y2="178" stroke="#C9962E" stroke-width="5"/>
            <path d="M150 170 L164 178 L150 186 Z" fill="#C9962E"/>
          </svg>
          <span class="uppercase tracking-[0.28em]">{siteName}</span>
        </a>
        <p class="mb-4 max-w-sm text-sm leading-relaxed">
          {siteSettings?.footer_description || 'Medical-research professional education. Evidence you can build on.'}
        </p>
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-fu-teal">protocol → conclusion</p>
      </div>

      <!-- Link groups -->
      {footerGroups.map((column) => (
        <div class="md:col-span-2 md:col-start-auto">
          <h3 class="mb-5 font-mono text-[0.62rem] uppercase tracking-[0.22em] text-fu-ink">{column.title}</h3>
          <ul class="space-y-3">
            {column.links.map((link) => (
              <li>
                <a href={link.url} class="text-sm text-fu-muted transition-colors duration-300 hover:text-fu-teal" style="transition-timing-function: cubic-bezier(0.32,0.72,0,1)">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Evidence line footer rule -->
      <div class="md:col-span-12">
        <div class="flex items-center gap-4" aria-hidden="true">
          <span class="h-px flex-1 bg-fu-line"></span>
          <span class="h-1.5 w-1.5 rounded-full bg-fu-amber"></span>
          <span class="h-px w-24 bg-fu-amber/50"></span>
          <span class="h-1.5 w-1.5 rounded-full bg-fu-teal"></span>
          <span class="h-px flex-1 bg-fu-line"></span>
        </div>
        <div class="mt-7 flex flex-col items-center justify-between gap-3 sm:flex-row">
          <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em]">&copy; {year} {siteName} · medical research center</p>
          <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-fu-muted">ctc-research.com · evidence you can build on</p>
        </div>
      </div>
    </div>
  </div>
</footer>

---
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import LanguageSwitcher from '@/components/ui/LanguageSwitcher.astro';

interface Props {
  siteName?: string;
  logoUrl?: string;
  /** Backend-fetched nav items (from /apis/navigation/). Falls back to a sensible default. */
  navItems?: {
    label: string;
    href: string;
    active?: boolean;
    external?: boolean;
    children?: { label: string; href: string; active?: boolean }[];
  }[];
  /** Page family used to vary the navigation treatment without changing its contract. */
  pageVariant?: 'home' | 'research' | 'learning' | 'archive' | 'legal' | 'network' | 'contact' | 'product';
}

const { siteName = 'CTC Research', logoUrl, navItems, pageVariant = 'home' } = Astro.props;

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  if (href.startsWith('/#')) return pathname === '/' || pathname === '/index';
  return pathname.startsWith(href.split('#')[0]);
};

const displayNav = navItems && navItems.length > 0
  ? navItems
  : [
    { label: 'Home', href: '/' },
    { label: 'Courses', href: '/courses/' },
    { label: 'About', href: '/about/' },
    { label: 'Services', href: '/services/' },
    { label: 'Team', href: '/team/' },
    { label: 'Events', href: '/events/' },
    { label: 'Contact', href: '/contact/' },
  ];
---

<!-- ═══ Fluid Island nav — floating glass pill, detached from the top (§5A) ═══ -->
<header
  class:list={["fixed inset-x-0 top-4 z-[60] px-4", `site-header--${pageVariant}`]}
  data-page-variant={pageVariant}
  x-data="{
    open: false,
    authed: false,
    user: null,
    authLoading: true,
    userMenu: false,
    async checkAuth() {
      try {
        const res = await fetch('/apis/auth/status/', { credentials: 'include', headers: { Accept: 'application/json' } });
        if (res.ok) {
          const data = await res.json();
          this.authed = data.authenticated;
          this.user = data.user;
        }
      } catch (e) { /* offline or backend down — stay logged-out */ }
      finally { this.authLoading = false; }
    },
    async logout() {
      try {
        const csrfToken = window.__FUSION_AUTH?.ensureCsrfToken
          ? await window.__FUSION_AUTH.ensureCsrfToken()
          : decodeURIComponent(document.cookie.match(/(?:^|; )csrftoken=([^;]+)/)?.[1] || '');
        await fetch(window.__FUSION_AUTH?.session || '/api/auth/browser/v1/auth/session', {
          method: 'DELETE', credentials: 'include',
          headers: { Accept: 'application/json', 'X-CSRFToken': csrfToken },
        });
      } catch (e) { /* best-effort */ }
      window.location.href = '/';
    },
    userInitial() { return this.user?.display?.[0]?.toUpperCase() || '?'; },
    init() { this.checkAuth(); },
  }"
>
  <div class="site-nav-island mx-auto flex w-max max-w-full items-center gap-5 rounded-full border border-fu-line/80 bg-fu-card/85 px-4 py-2.5 shadow-[0_18px_44px_-22px_rgba(0,0,0,0.35)] backdrop-blur-xl transition-colors duration-500"
       style="transition-timing-function: cubic-bezier(0.32,0.72,0,1)">
    <!-- CTC Research Centre logo -->
    <a href="/" class="flex items-center gap-2.5 font-mono text-[0.92rem] font-semibold tracking-tight text-fu-ink" aria-label={siteName}>
      <img src={logoUrl || "/static/images/logo-enhanced.svg"} alt="" class="h-10 w-10 object-contain" />
      <span class="uppercase tracking-[0.18em]">{siteName}</span>
    </a>

    <!-- Desktop nav — detached pill links; items with children open a
         hover/click dropdown (About → founder / research / education / team /
         services), mirroring the Precis Landing navigation contract. -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {displayNav.map((link) => {
        const active = isActive(link.href);
        const hasChildren = !!(link.children && link.children.length > 0);
        return (
          <div
            class="relative"
            x-data="{
              open: false,
              hoverTimer: null,
              openSoon() { this.cancelClose(); this.hoverTimer = setTimeout(() => { this.open = true; }, 120); },
              cancelClose() { if (this.hoverTimer) { clearTimeout(this.hoverTimer); this.hoverTimer = null; } },
              closeSoon() { this.cancelClose(); this.hoverTimer = setTimeout(() => { this.open = false; }, 180); },
              toggle(e) { this.cancelClose(); this.open = !this.open; if (this.open && e) { e.preventDefault(); } },
              close() { this.cancelClose(); this.open = false; },
            }"
            @mouseenter="openSoon()"
            @mouseleave="closeSoon()"
            @focusin="openSoon()"
            @focusout="closeSoon()"
            @click.outside="close()"
            @keydown.escape.window="open = false"
          >
            <a
              href={link.href}
              class:list={[
                'inline-flex items-center gap-1 rounded-full px-3.5 py-1.5 text-[0.82rem] transition-all duration-500',
                active
                  ? 'bg-fu-teal/10 font-medium text-fu-teal'
                  : 'text-fu-muted hover:bg-fu-teal/5 hover:text-fu-ink',
              ]}
              style="transition-timing-function: cubic-bezier(0.32,0.72,0,1)"
              aria-haspopup={hasChildren ? 'true' : undefined}
              :aria-expanded={hasChildren ? 'open.toString()' : undefined}
              @click="toggle($event)"
            >
              {link.label}
              {hasChildren && (
                <svg class="h-3 w-3 text-fu-muted transition-transform duration-200" :class="open && 'rotate-180'" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              )}
            </a>
            {hasChildren && (
              <div
                x-show="open"
                x-cloak
                x-transition:enter="transition ease-out duration-150"
                x-transition:enter-start="opacity-0 translate-y-1"
                x-transition:enter-end="opacity-100 translate-y-0"
                x-transition:leave="transition ease-in duration-100"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="absolute left-0 top-full z-40 pt-2"
                @mouseenter="cancelClose()"
                @mouseleave="closeSoon()"
              >
                <div class="min-w-[13rem] rounded-2xl border border-fu-line bg-fu-paper p-1.5 shadow-xl">
                  {link.children!.map((child) => (
                    <a
                      href={child.href}
                      @click="close()"
                      class:list={[
                        'flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-[0.85rem] transition-colors',
                        child.active ? 'bg-fu-line/40 font-medium text-fu-ink' : 'text-fu-muted hover:bg-fu-card hover:text-fu-ink',
                      ]}
                    >
                      <span>{child.label}</span>
                      {child.active && <span class="text-fu-link" aria-hidden="true">✓</span>}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        );
      })}
    </nav>

    <!-- CTA + auth + theme toggle + language (desktop) -->
    <div class="hidden items-center gap-2.5 md:flex">
      <LanguageSwitcher />
      <ThemeToggle />
      <!-- Loading: subtle placeholder -->
      <template x-if="authLoading">
        <span class="inline-block h-4 w-16 animate-fusion-pulse rounded bg-fu-line/60"></span>
      </template>
      <!-- Logged out: Log In -->
      <template x-if="!authLoading && !authed">
        <button
          type="button"
          class="rounded-full px-4 py-2 text-[0.82rem] font-medium text-fu-muted transition-all duration-500 hover:bg-fu-teal/5 hover:text-fu-ink"
          style="transition-timing-function: cubic-bezier(0.32,0.72,0,1)"
          @click="$dispatch('fusion:open-login')"
        >
          <span data-i18n="nav_login">Log In</span>
        </button>
      </template>
      <!-- Logged in: user dropdown -->
      <template x-if="!authLoading && authed">
        <div class="relative" @keydown.escape.window="userMenu = false">
          <button
            type="button"
            class="flex items-center gap-2 rounded-full border border-fu-line/80 bg-fu-card px-3 py-1.5 text-sm font-medium text-fu-ink transition-all duration-500 hover:border-fu-link/50"
            style="transition-timing-function: cubic-bezier(0.32,0.72,0,1)"
            @click="userMenu = !userMenu"
            aria-haspopup="true"
            :aria-expanded="userMenu.toString()"
          >
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-fu-link text-xs font-bold text-white" x-text="userInitial()"></span>
            <span class="hidden max-w-[120px] truncate lg:inline" x-text="user?.display"></span>
            <svg class="h-3.5 w-3.5 text-fu-muted transition-transform duration-300" :class="userMenu && 'rotate-180'" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div x-show="userMenu" x-cloak
            x-transition:enter="transition ease-out duration-150"
            x-transition:enter-start="opacity-0 scale-95 -translate-y-1"
            x-transition:enter-end="opacity-100 scale-100 translate-y-0"
            x-transition:leave="transition ease-in duration-100"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            @click.self="userMenu = false"
            class="absolute right-0 mt-2 w-56 rounded-2xl border border-fu-line bg-fu-paper p-2 shadow-xl">
            <div class="border-b border-fu-line px-3 pb-2.5 pt-1.5">
              <p class="text-sm font-medium text-fu-ink" x-text="user?.display"></p>
              <p class="truncate text-xs text-fu-muted" x-text="user?.email"></p>
            </div>
            <div class="mt-1.5 space-y-0.5">
              <a href="/profile/" @click="userMenu = false" class="flex items-center gap-2.5 rounded-md px-3 py-2 text-sm text-fu-ink transition-colors hover:bg-fu-card hover:text-fu-link">
                <svg class="h-4 w-4 text-fu-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                <span data-i18n="nav_profile">Profile</span>
              </a>
              <a href="/accounts/email/" @click="userMenu = false" class="flex items-center gap-2.5 rounded-md px-3 py-2 text-sm text-fu-ink transition-colors hover:bg-fu-card hover:text-fu-link">
                <svg class="h-4 w-4 text-fu-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <span data-i18n="profile_email_addresses">Email addresses</span>
              </a>
              <a href="/accounts/password/change/" @click="userMenu = false" class="flex items-center gap-2.5 rounded-md px-3 py-2 text-sm text-fu-ink transition-colors hover:bg-fu-card hover:text-fu-link">
                <svg class="h-4 w-4 text-fu-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span data-i18n="profile_change_password">Change password</span>
              </a>
              <a href="/accounts/2fa/" @click="userMenu = false" class="flex items-center gap-2.5 rounded-md px-3 py-2 text-sm text-fu-ink transition-colors hover:bg-fu-card hover:text-fu-link">
                <svg class="h-4 w-4 text-fu-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                <span data-i18n="profile_security_mfa">Security &amp; MFA</span>
              </a>
            </div>
            <hr class="my-1.5 border-fu-line" />
            <button type="button" @click="userMenu = false; logout()" class="flex w-full items-center gap-2.5 rounded-md px-3 py-2 text-sm text-red-500 transition-colors hover:bg-red-50">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
              <span data-i18n="nav_sign_out">Sign out</span>
            </button>
          </div>
        </div>
      </template>
      <a
        href="/#cta"
        class="group relative inline-flex items-center gap-2 overflow-hidden rounded-full bg-fu-link px-5 py-2 text-[0.82rem] font-semibold text-white transition-all duration-500 active:scale-[0.97]"
        style="transition-timing-function: cubic-bezier(0.32,0.72,0,1)"
      >
        <span class="relative z-10">Get Started</span>
        <!-- button-in-button trailing icon (§4B) -->
        <span class="relative z-10 flex h-6 w-6 items-center justify-center rounded-full bg-white/15 transition-transform duration-500 group-hover:translate-x-0.5 group-hover:-translate-y-[1px]" style="transition-timing-function: cubic-bezier(0.34,1.56,0.64,1)">
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/>
          </svg>
        </span>
      </a>
    </div>

    <!-- Mobile controls: language + theme toggle + morphing hamburger -->
    <div class="flex items-center gap-1.5 md:hidden">
      <LanguageSwitcher />
      <ThemeToggle />
      <button
        type="button"
        class="relative flex h-10 w-10 items-center justify-center rounded-full text-fu-ink transition-colors hover:bg-fu-teal/10"
        aria-label="Toggle navigation menu"
        :aria-expanded="open.toString()"
        @click="open = !open"
      >
        <!-- hamburger → X morph: two lines rotate/translate, middle fades -->
        <span class="absolute h-0.5 w-5 rounded-full bg-current transition-all duration-500" style="transition-timing-function: cubic-bezier(0.34,1.56,0.64,1)"
              :class="open ? 'rotate-45' : '-translate-y-[4px]'"></span>
        <span class="absolute h-0.5 w-5 rounded-full bg-current transition-all duration-300" style="transition-timing-function: cubic-bezier(0.32,0.72,0,1)"
              x-show="!open"></span>
        <span class="absolute h-0.5 w-5 rounded-full bg-current transition-all duration-500" style="transition-timing-function: cubic-bezier(0.34,1.56,0.64,1)"
              :class="open ? '-rotate-45' : 'translate-y-[4px]'"></span>
      </button>
    </div>
  </div>

  <!-- ═══ Mobile menu — screen-filling glass overlay, staggered mask reveal ═══ -->
  <div
    x-show="open"
    x-cloak
    x-transition:enter="transition ease-[cubic-bezier(0.32,0.72,0,1)] duration-500"
    x-transition:enter-start="opacity-0 scale-[0.98] backdrop-blur-0"
    x-transition:enter-end="opacity-100 scale-100 backdrop-blur-xl"
    x-transition:leave="transition ease-[cubic-bezier(0.32,0.72,0,1)] duration-300"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-[59] flex flex-col items-center justify-center gap-1 bg-fu-paper/90 backdrop-blur-3xl md:hidden"
  >
    <nav class="flex flex-col items-center gap-2" aria-label="Mobile">
      {displayNav.map((link, i) => {
        const active = isActive(link.href);
        const hasChildren = !!(link.children && link.children.length > 0);
        return (
          <div
            class="flex flex-col items-center"
            x-data="{ sub: false }"
            x-show="open"
            x-transition:enter="transition"
            x-transition:enter-start="opacity-0 translate-y-8"
            x-transition:enter-end="opacity-100 translate-y-0"
            style={`transition-delay: ${100 + i * 60}ms; transition-timing-function: cubic-bezier(0.32,0.72,0,1)`}
          >
            <a
              href={link.href}
              @click="open = false"
              class:list={[
                'inline-flex items-center gap-2 px-6 py-2 font-display text-3xl font-light text-fu-ink transition-all duration-700',
                active ? 'text-fu-teal' : 'hover:text-fu-teal',
              ]}
            >
              {link.label}
              {hasChildren && (
                <svg class="h-4 w-4 text-fu-muted transition-transform duration-200" :class="sub && 'rotate-180'" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true" @click.stop.prevent="sub = !sub">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              )}
            </a>
            {hasChildren && (
              <div x-show="sub" x-cloak x-collapse class="mt-1 flex flex-col items-center gap-1 border-l-0 text-center">
                {link.children!.map((child) => (
                  <a
                    href={child.href}
                    @click="open = false"
                    class:list={[
                      'px-5 py-1.5 font-mono text-[0.78rem] uppercase tracking-[0.12em] transition-colors',
                      child.active ? 'text-fu-teal font-medium' : 'text-fu-muted hover:text-fu-ink',
                    ]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        );
      })}
    </nav>
    <div class="mt-8 flex items-center gap-3">
      <template x-if="!authed">
        <button
          type="button"
          @click="open = false; $dispatch('fusion:open-login')"
          class="btn-secondary !px-7 !py-3"
        >
          <span data-i18n="nav_login">Log In</span>
        </button>
      </template>
      <template x-if="authed">
        <button
          type="button"
          @click="open = false; logout()"
          class="btn-secondary !px-7 !py-3"
        >
          <span data-i18n="nav_sign_out">Sign out</span>
        </button>
      </template>
      <a href="/#cta" @click="open = false" class="btn-primary !px-7 !py-3">Get Started</a>
    </div>
    <p class="absolute bottom-10 font-mono text-[0.62rem] uppercase tracking-[0.24em] text-fu-muted">
      ctc research · medical evidence
    </p>
  </div>
</header>

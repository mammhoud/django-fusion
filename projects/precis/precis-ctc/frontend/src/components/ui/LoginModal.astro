---
/**
 * LoginModal — sign-in powered by django-allauth headless API.
 *
 * The React reference (cms-fusion) consumed JSON login endpoints via RTK
 * Query. On the AHA stack the same contract is served by allauth headless:
 *   POST /api/auth/browser/v1/auth/login   { email, password }
 *   GET  /api/auth/browser/v1/auth/session
 *   DELETE /api/auth/browser/v1/auth/session  (logout)
 *   GET  /accounts/github/login/ (social; allauth provider flow)
 *
 * The modal is Alpine-managed: email/password posts JSON with credentials,
 * social buttons hit the provider redirect (302 → OAuth), and a session
 * check drives the logged-in "sign out" state in the header.
 *
 * Mirrors precis-landing's LoginModal.astro (the two frontends share the
 * same headless auth contract served by apps/auth adapters).
 */
import { browserApiUrl, browserEndpoint } from '@/lib/site';

const apiBase = browserApiUrl.replace(/\/$/, '');
const loginUrl = browserEndpoint('/api/auth/browser/v1/auth/login');
const sessionUrl = browserEndpoint('/api/auth/browser/v1/auth/session');
const logoutUrl = browserEndpoint('/api/auth/browser/v1/auth/session');

const providers = [
  { id: 'github', label: 'GitHub', icon: 'M12 2C6.48 2 2 6.58 2 12.2c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.85.09-.66.35-1.12.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9v2.82c0 .27.18.6.69.49A10.22 10.22 0 0 0 22 12.2C22 6.58 17.52 2 12 2z' },
  { id: 'google', label: 'Google', icon: 'M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z' },
];

const providersJson = JSON.stringify(providers);
---

<!-- API endpoints + providers are injected as window globals via define:vars
     (Astro does NOT interpolate ${...} inside quoted attribute strings, so the
     Alpine x-data below reads them at runtime instead). -->
<script is:inline define:vars={{ loginUrl, sessionUrl, logoutUrl, apiBase, providersJson }}>
  window.__FUSION_AUTH = {
    login: loginUrl,
    session: sessionUrl,
    logout: logoutUrl,
    apiBase: apiBase,
    providers: JSON.parse(providersJson),
  };
</script>

<div
  x-data="{
    open: false,
    email: '',
    password: '',
    loading: false,
    error: '',
    providers: window.__FUSION_AUTH?.providers || [],
    async submit() {
      this.loading = true;
      this.error = '';
      try {
        const res = await fetch(window.__FUSION_AUTH.login, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ email: this.email, password: this.password }),
        });
        if (res.status === 200 || res.status === 201) {
          this.open = false;
          this.email = '';
          this.password = '';
          window.__showToast?.('Signed in. Welcome back!', 'success');
          setTimeout(() => location.reload(), 700);
        } else {
          const data = await res.json().catch(() => ({}));
          const errors = data?.errors || [];
          this.error = errors.map((e) => e.message).join(' ') || 'Sign-in failed. Check your email and password.';
        }
      } catch (e) {
        this.error = 'Network error. Please try again.';
      } finally {
        this.loading = false;
      }
    },
    social(provider) {
      // Use allauth's normal provider route. It owns the OAuth state,
      // callback URL, and configured SocialApp, just like the server-rendered
      // `{% provider_login_url %}` buttons.
      const next = encodeURIComponent(window.location.pathname + window.location.search);
      window.location.href = '/accounts/' + encodeURIComponent(provider) + '/login/?next=' + next;
    },
  }"
  @keydown.escape.window="open = false"
  @fusion:open-login.window="open = true"
>
  <!-- Trigger: the header wires its Log In button to this via the
       fusion:open-login window event (Alpine $dispatch bubbles to window). -->

  <!-- Backdrop + dialog — pre-hidden with inline display:none to prevent FOUC
       before Alpine initializes. x-show toggles it once Alpine is ready. -->
  <div
    x-show="open"
    x-cloak
    style="display:none"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-[80] flex items-center justify-center bg-fu-ink/50 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="Sign in"
    @click.self="open = false"
  >
    <div class="w-full max-w-md rounded-2xl border border-fu-line bg-fu-paper p-7 shadow-2xl">
      <div class="mb-6 flex items-start justify-between">
        <div>
          <p class="tag-marker mb-1">account</p>
          <h2 class="font-display text-2xl font-bold tracking-tight text-fu-ink">Sign in</h2>
          <p class="mt-1 text-sm text-fu-muted">django-allauth headless · server-rendered, no SPA</p>
        </div>
        <button type="button" @click="open = false" class="rounded-md p-2 text-fu-muted transition-colors hover:bg-fu-line/40 hover:text-fu-ink" aria-label="Close">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Social providers (shown when configured) -->
      <div class="mb-5 grid grid-cols-2 gap-3">
        {providers.map((p) => (
          <button
            type="button"
            @click={ `social('${p.id}')` }
            class="flex items-center justify-center gap-2 rounded-lg border border-fu-line bg-fu-card px-4 py-2.5 text-sm font-medium text-fu-ink transition-colors hover:border-fu-link/50 hover:text-fu-link"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={p.icon} /></svg>
            {p.label}
          </button>
        ))}
      </div>

      <div class="mb-5 flex items-center gap-3 text-xs uppercase tracking-wider text-fu-muted">
        <span class="h-px flex-1 bg-fu-line"></span>or email
        <span class="h-px flex-1 bg-fu-line"></span>
      </div>

      <!-- Email/password form -->
      <form @submit.prevent="submit()" class="space-y-4">
        <div>
          <label for="login-email" class="mb-1.5 block font-mono text-[0.65rem] uppercase tracking-wider text-fu-muted">Email</label>
          <input id="login-email" type="email" required autocomplete="email" x-model="email" class="input-field" placeholder="you@example.com" />
        </div>
        <div>
          <label for="login-password" class="mb-1.5 block font-mono text-[0.65rem] uppercase tracking-wider text-fu-muted">Password</label>
          <input id="login-password" type="password" required autocomplete="current-password" x-model="password" class="input-field" placeholder="••••••••" />
        </div>

        <p x-show="error" x-cloak x-transition class="text-sm font-medium text-red-500" role="alert" x-text="error"></p>

        <button type="submit" class="btn-primary w-full" :disabled="loading">
          <span x-show="!loading">Sign in</span>
          <span x-show="loading" x-cloak>Signing in…</span>
        </button>
      </form>

      <p class="mt-5 text-center text-xs text-fu-muted">
        New here? <a href="/accounts/signup/" class="font-medium text-fu-link hover:text-fu-ink">Create an account</a>
        <span class="mx-2 text-fu-line" aria-hidden="true">|</span>
        <a href="/accounts/password/reset/" class="font-medium text-fu-link hover:text-fu-ink">Forgot password?</a>
      </p>
    </div>
  </div>
</div>

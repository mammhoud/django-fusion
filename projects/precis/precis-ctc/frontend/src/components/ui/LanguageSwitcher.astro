---
/**
 * LanguageSwitcher — displays available content languages and lets the user
 * switch. Uses /i18n/setlang/ (Django) to persist the choice server-side and
 * also stores it in localStorage so the Astro static shell can read it.
 *
 * How it works:
 *  1. At SSG build time the available languages come from the API response
 *     passed down via `availableLanguages` prop (from /apis/content/languages/).
 *  2. At runtime Alpine.js reads the stored language and highlights it.
 *  3. On selection: POST to /i18n/setlang/ then reload the page so Django
 *     serves translated navigation/content on the next request.
 */

export interface LanguageOption {
  code: string;
  name: string;
  native: string;
  flag?: string;
  dir?: 'ltr' | 'rtl';
}

interface Props {
  availableLanguages?: LanguageOption[];
  currentLanguage?: string;
  /** Display variant: 'dropdown' (default) | 'inline' */
  variant?: 'dropdown' | 'inline';
}

const {
  availableLanguages = [],
  currentLanguage = 'en',
  variant = 'dropdown',
} = Astro.props;

// Default language list used when prop is empty (same as backend LANGUAGES setting)
const DEFAULT_LANGUAGES: LanguageOption[] = [
  { code: 'en',    name: 'English',              native: 'English',    flag: '🇬🇧', dir: 'ltr' },
  { code: 'fr',    name: 'French',               native: 'Français',   flag: '🇫🇷', dir: 'ltr' },
  { code: 'de',    name: 'German',               native: 'Deutsch',    flag: '🇩🇪', dir: 'ltr' },
  { code: 'es',    name: 'Spanish',              native: 'Español',    flag: '🇪🇸', dir: 'ltr' },
  { code: 'ar',    name: 'Arabic',               native: 'العربية',    flag: '🇸🇦', dir: 'rtl' },
  { code: 'pt-br', name: 'Portuguese (Brazil)',  native: 'Português',  flag: '🇧🇷', dir: 'ltr' },
  { code: 'sv',    name: 'Swedish',              native: 'Svenska',    flag: '🇸🇪', dir: 'ltr' },
];

const langs = availableLanguages.length > 0 ? availableLanguages : DEFAULT_LANGUAGES;
---

{variant === 'dropdown' && (
  <div
    class="lang-switcher"
    x-data={`{
      open: false,
      current: localStorage.getItem('ctc_lang') || '${currentLanguage}',
      langs: ${JSON.stringify(langs)},
      get currentLang() {
        return this.langs.find(l => l.code === this.current) || this.langs[0];
      },
      async select(code) {
        this.current = code;
        this.open = false;
        localStorage.setItem('ctc_lang', code);
        // Persist on the Django side so translated navigation loads correctly
        try {
          const csrfToken = document.cookie.match(/csrftoken=([^;]+)/)?.[1] || '';
          await fetch('/i18n/setlang/', {
            method: 'POST',
            credentials: 'include',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
              'X-CSRFToken': csrfToken,
            },
            body: new URLSearchParams({ language: code, next: window.location.pathname }),
          });
        } catch (e) { /* best effort */ }
        window.location.reload();
      },
    }`}
    @keydown.escape.window="open = false"
    @click.outside="open = false"
  >
    <button
      class="lang-trigger"
      @click="open = !open"
      :aria-expanded="open"
      aria-label="Switch language"
      type="button"
    >
      <span class="lang-flag" x-text="currentLang.flag" aria-hidden="true"></span>
      <span class="lang-code" x-text="currentLang.code.toUpperCase()"></span>
      <svg class="lang-chevron" :class="{ 'rotate-180': open }" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
        <path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="lang-dropdown" x-show="open" x-transition:enter="lang-enter" x-transition:enter-start="lang-enter-start" x-transition:enter-end="lang-enter-end" x-transition:leave="lang-leave" x-transition:leave-start="lang-enter-end" x-transition:leave-end="lang-enter-start">
      <template x-for="lang in langs" :key="lang.code">
        <button
          class="lang-option"
          :class="{ 'lang-option--active': lang.code === current }"
          @click="select(lang.code)"
          type="button"
        >
          <span class="lang-flag" x-text="lang.flag" aria-hidden="true"></span>
          <span class="lang-native" x-text="lang.native"></span>
          <svg x-show="lang.code === current" class="lang-check" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </template>
    </div>
  </div>
)}

{variant === 'inline' && (
  <div
    class="lang-inline"
    x-data={`{
      current: localStorage.getItem('ctc_lang') || '${currentLanguage}',
      langs: ${JSON.stringify(langs)},
      async select(code) {
        this.current = code;
        localStorage.setItem('ctc_lang', code);
        try {
          const csrfToken = document.cookie.match(/csrftoken=([^;]+)/)?.[1] || '';
          await fetch('/i18n/setlang/', {
            method: 'POST',
            credentials: 'include',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
              'X-CSRFToken': csrfToken,
            },
            body: new URLSearchParams({ language: code, next: window.location.pathname }),
          });
        } catch (e) { /* best effort */ }
        window.location.reload();
      },
    }`}
  >
    <template x-for="lang in langs" :key="lang.code">
      <button
        class="lang-pill"
        :class="{ 'lang-pill--active': lang.code === current }"
        @click="select(lang.code)"
        type="button"
        :title="lang.name"
      >
        <span x-text="lang.flag" aria-hidden="true"></span>
        <span x-text="lang.code.toUpperCase()"></span>
      </button>
    </template>
  </div>
)}

<style>
  /* ── Dropdown variant ────────────────────────────────────────────────── */
  .lang-switcher {
    position: relative;
  }

  .lang-trigger {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    border-radius: 100px;
    border: 1px solid var(--fu-line, rgba(0,0,0,0.08));
    background: transparent;
    color: var(--fu-muted, #6b7280);
    font-family: var(--font-mono, ui-monospace);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }

  .lang-trigger:hover {
    background: var(--fu-surface, #f8f9fb);
    color: var(--fu-ink, #0f1117);
    border-color: var(--fu-line);
  }

  .lang-flag { font-size: 0.85rem; line-height: 1; }
  .lang-code { font-size: 0.65rem; }

  .lang-chevron {
    color: var(--fu-muted);
    transition: transform 0.2s;
  }

  .lang-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 160px;
    background: var(--fu-card, #fff);
    border: 1px solid var(--fu-line, rgba(0,0,0,0.08));
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.10);
    overflow: hidden;
    z-index: 200;
    padding: 0.35rem;
  }

  /* Alpine transitions */
  .lang-enter { transition: opacity 0.15s, transform 0.15s; }
  .lang-enter-start { opacity: 0; transform: translateY(-6px) scale(0.97); }
  .lang-enter-end   { opacity: 1; transform: translateY(0) scale(1); }
  .lang-leave { transition: opacity 0.1s; }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.55rem 0.75rem;
    border: none;
    background: transparent;
    border-radius: 8px;
    cursor: pointer;
    text-align: left;
    font-size: 0.82rem;
    color: var(--fu-muted, #6b7280);
    transition: background 0.15s, color 0.15s;
  }

  .lang-option:hover {
    background: var(--fu-surface, #f8f9fb);
    color: var(--fu-ink, #0f1117);
  }

  .lang-option--active {
    color: var(--fu-teal, #0d9488);
    background: rgba(13, 148, 136, 0.06);
  }

  .lang-native { flex: 1; }

  .lang-check {
    color: var(--fu-teal, #0d9488);
    flex-shrink: 0;
  }

  /* ── Inline variant ──────────────────────────────────────────────────── */
  .lang-inline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .lang-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
    border: 1px solid var(--fu-line, rgba(0,0,0,0.08));
    background: transparent;
    color: var(--fu-muted, #6b7280);
    font-family: var(--font-mono, ui-monospace);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .lang-pill:hover {
    background: var(--fu-surface, #f8f9fb);
    color: var(--fu-ink, #0f1117);
  }

  .lang-pill--active {
    background: rgba(13, 148, 136, 0.08);
    border-color: rgba(13, 148, 136, 0.25);
    color: var(--fu-teal, #0d9488);
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-trigger, .lang-option, .lang-pill { transition: none; }
  }
</style>

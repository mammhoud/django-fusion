#!/bin/bash
set -euo pipefail

# Keep system tools such as `make` available even when a virtualenv is active.
export PATH="/opt/venv/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"
APP_HOME="${APP_HOME:-/app}"
APP_VENV="${VIRTUAL_ENV:-/opt/venv}"
LOG_DIR="${LOG_DIR:-${APP_HOME}/logs}"
SITE_NAME="${DJANGO_SITE:-${DJANGO_WEBSITE:-${WEBSITE:-${PROJECT_PATH:-ctc-research}}}}"

mkdir -p "$LOG_DIR" "${LOG_DIR}/${SITE_NAME}"

echo "[ENTRYPOINT] Booting in ${APP_HOME} for ${SITE_NAME}..."

run_logged() {
    local name="$1"
    shift
    local logfile="${LOG_DIR}/${name}.log"
    echo "[LOG] $name: $*"
    echo "===== $(date -Iseconds) $name: $* =====" >> "$logfile"
    "$@" 2>&1 | tee -a "$logfile"
}

if ! command -v uv >/dev/null 2>&1; then
    echo "[SETUP] Installing uv..."
    python -m pip install --no-cache-dir --upgrade uv
else
    echo "[OK] uv already installed: $(uv --version)"
fi

if [ -d "$APP_VENV" ]; then
    echo "[CHECK] Checking Python venv validity..."
    PYTHON_BIN="$APP_VENV/bin/python"
    if [ ! -f "$PYTHON_BIN" ] || ! "$PYTHON_BIN" --version >/dev/null 2>&1; then
        echo "[WARN] Broken venv detected at $APP_VENV"
        rm -rf "$APP_VENV"
        uv venv "$APP_VENV"
    else
        echo "[OK] Venv is valid"
    fi
fi

cd "$APP_HOME"
SITE_DIR_NAME="${PROJECT_PATH:-$SITE_NAME}"
if [ ! -d "${APP_HOME}/${SITE_DIR_NAME}" ] && [ "$SITE_NAME" = "vresume" ]; then
    SITE_DIR_NAME="VResume"
fi
SITE_BACKEND_DIR="${APP_HOME}/${SITE_DIR_NAME}/backend"
if [ -d "$SITE_BACKEND_DIR" ]; then
    export PYTHONPATH="${APP_HOME}/libs/django-fusion/src:${SITE_BACKEND_DIR}:${APP_HOME}/${SITE_DIR_NAME}/www:${APP_HOME}/${SITE_DIR_NAME}:${APP_HOME}:${PYTHONPATH:-}"
else
    export PYTHONPATH="${APP_HOME}/libs/django-fusion/src:${APP_HOME}/${SITE_DIR_NAME}/www:${APP_HOME}/${SITE_DIR_NAME}:${APP_HOME}:${PYTHONPATH:-}"
fi

if [ "${RUN_UV_SYNC:-false}" = "true" ]; then
    echo "[SETUP] Syncing Python dependencies with uv..."
    if [ -f uv.lock ]; then
        uv sync --frozen --no-install-project
    else
        uv sync --no-install-project
    fi
fi

###############################################################################
# DJANGO SETUP (opt-in for main app, not workers)
###############################################################################
if [ "${RUN_SETUP:-false}" = "true" ]; then
    echo "[SETUP] Running Django setup..."

    echo "[SETUP] Preparing static files..."
    BUILD_ASSETS_MODE="${BUILD_ASSETS_ON_START:-auto}"
    WEBPACK_BIN="${APP_HOME}/assets/node_modules/.bin/webpack"

    # Skip webpack if pre-built bundles exist (baked into image at build time)
    # Bundles are in <site>/assets/bundles/<site>/ (or vresume for VResume)
    SITE_BUNDLES_DIR="${APP_HOME}/${SITE_DIR_NAME}/assets/bundles"
    BUNDLE_SUBDIR="${SITE_DIR_NAME}"
    [ "$SITE_NAME" = "vresume" ] && BUNDLE_SUBDIR="vresume"
    SITE_BUNDLE_PATH="${SITE_BUNDLES_DIR}/${BUNDLE_SUBDIR}"
    if [ -d "$SITE_BUNDLE_PATH" ] && ls "$SITE_BUNDLE_PATH"/*.js >/dev/null 2>&1; then
        echo "[INFO] Pre-built webpack bundles found at ${SITE_BUNDLE_PATH} — skipping runtime build"
        SHOULD_BUILD_ASSETS=false
    else
        SHOULD_BUILD_ASSETS=false
        case "$BUILD_ASSETS_MODE" in
            true|1|yes)
                if [ -x "$WEBPACK_BIN" ]; then
                    SHOULD_BUILD_ASSETS=true
                else
                    echo "[WARN] BUILD_ASSETS_ON_START=${BUILD_ASSETS_MODE}, but ${WEBPACK_BIN} is missing; run 'npm --prefix assets ci --include=dev --legacy-peer-deps' before container startup to enable webpack builds."
                fi
                ;;
            auto)
                if [ -x "$WEBPACK_BIN" ]; then
                    SHOULD_BUILD_ASSETS=true
                else
                    echo "[INFO] Skipping webpack build because assets/node_modules is not installed in the mounted workspace."
                fi
                ;;
            false|0|no)
                echo "[INFO] BUILD_ASSETS_ON_START=${BUILD_ASSETS_MODE}; skipping webpack build."
                ;;
            *)
                echo "[WARN] Unknown BUILD_ASSETS_ON_START=${BUILD_ASSETS_MODE}; expected auto, true, or false. Skipping webpack build."
                ;;
        esac
    fi

    if [ "$SHOULD_BUILD_ASSETS" = "true" ]; then
        echo "[SETUP] Collecting/building static files..."
        if ! run_logged build_assets env WEBSITE="$SITE_NAME" PROJECT_PATH="$SITE_NAME" /usr/bin/make build-assets-site; then
            if ! run_logged collectstatic python manage.py collectstatic --noinput; then
                echo "[WARN] static collection failed (non-fatal); see ${LOG_DIR}/build_assets.log and ${LOG_DIR}/collectstatic.log"
            fi
        fi
    fi


    echo "[SETUP] Waiting for the configured database..."
    DB_READY_ATTEMPTS="${DB_READY_ATTEMPTS:-30}"
    DB_READY_DELAY="${DB_READY_DELAY:-2}"
    db_ready=false
    for ((attempt=1; attempt<=DB_READY_ATTEMPTS; attempt++)); do
        if python manage.py shell -c \
            'from django.db import connection; connection.ensure_connection()' \
            >/dev/null 2>&1; then
            db_ready=true
            echo "[OK] Database is ready"
            break
        fi
        echo "[WAIT] Database is not ready (attempt ${attempt}/${DB_READY_ATTEMPTS})"
        sleep "$DB_READY_DELAY"
    done
    if [ "$db_ready" != "true" ]; then
        echo "[ERROR] Database did not become ready; refusing to start"
        exit 1
    fi

    echo "[SETUP] Making migrations..."
    if ! run_logged makemigrations python manage.py makemigrations --noinput; then
        echo "[WARN] makemigrations failed (non-fatal); see ${LOG_DIR}/makemigrations.log"
    fi

    echo "[SETUP] Applying migrations..."
    if ! run_logged migrate python manage.py migrate --noinput; then
        echo "[ERROR] migrate failed; see ${LOG_DIR}/migrate.log"
        exit 1
    fi

    if [ -n "${SUPERUSER_USERNAME:-}" ] && [ -n "${SUPERUSER_PASSWORD:-}" ]; then
        echo "[SETUP] Ensuring superuser..."
        run_logged superuser python -m django_fusion.infrastructure.scripts.superuser || echo "[WARN] superuser failed (non-fatal); see ${LOG_DIR}/superuser.log"
    fi

    # Fixture loading is opt-in in production. Migrations and serving must be
    # safe on every restart; fixture replacement is an explicit maintenance
    # operation because it can replace Wagtail pages, sites, and images.
    if [ "${LOAD_DATA_ON_START:-false}" = "true" ]; then
        echo "[SETUP] Loading dumped data fixtures..."
        # Use the site's `load_data` command when available. The command is
        # non-destructive by default and accepts --replace only when the
        # operator has also explicitly set FORCE_LOAD_DUMPS=true.
        if python manage.py help load_data >/dev/null 2>&1; then
            LOAD_DATA_ARGS=()
            if [ "${FORCE_LOAD_DUMPS:-false}" = "true" ]; then
                LOAD_DATA_ARGS+=("--replace")
            fi
            if ! run_logged load_data python manage.py load_data "${LOAD_DATA_ARGS[@]}"; then
                echo "[WARN] load_data failed (non-fatal); see ${LOG_DIR}/load_data.log"
            fi
        else
            LOAD_DUMP_ARGS=("$SITE_NAME")
            [ "${FORCE_LOAD_DUMPS:-false}" = "true" ] && LOAD_DUMP_ARGS+=("--force" "--include-dumps")
            [ "${LOAD_FIXTURES:-false}" = "true" ] && LOAD_DUMP_ARGS+=("--include-extra")
            if ! run_logged load_dumped_data python tests/scripts/dev/load_dumped_data.py "${LOAD_DUMP_ARGS[@]}"; then
                echo "[WARN] dumped data load failed (non-fatal); see ${LOG_DIR}/load_dumped_data.log"
            fi
        fi
    else
        echo "[INFO] Fixture loading disabled; use LOAD_DATA_ON_START=true for a maintenance load."
    fi

    echo "[SETUP] Setting up Wagtail home page and language..."
    if python manage.py help setup_wagtail_home >/dev/null 2>&1; then
        if ! run_logged setup_wagtail_home python manage.py setup_wagtail_home; then
            echo "[WARN] setup_wagtail_home failed (non-fatal); see ${LOG_DIR}/setup_wagtail_home.log"
        fi
    else
        echo "[INFO] setup_wagtail_home command is not installed for ${SITE_NAME}; skipping."
    fi

    echo "[SETUP] Compiling translation messages..."
    if ! run_logged compilemessages python manage.py compilemessages; then
        echo "[WARN] compilemessages failed (non-fatal); see ${LOG_DIR}/compilemessages.log"
    fi

    echo "[SETUP] Verifying Wagtail pages and collected assets..."
    VERIFY_ARGS=()
    [ "${STRICT_ASSETS:-false}" = "true" ] && VERIFY_ARGS+=("--strict-assets")
    [ "${STRICT_PAGE_CONTENT:-false}" = "true" ] && VERIFY_ARGS+=("--strict-pages")
    [ "${STRICT_PAGE_CONTENT:-false}" != "true" ] && VERIFY_ARGS+=("--no-strict-content")
    if ! run_logged verify_runtime python tests/scripts/staging/verify_runtime.py "${VERIFY_ARGS[@]}"; then
        echo "[WARN] runtime verification failed (non-fatal); see ${LOG_DIR}/verify_runtime.log"
    fi

    if command -v crontab >/dev/null 2>&1; then
        echo "[SETUP] Installing hourly error-report cron..."
        # Use the full path to the venv interpreter: cron runs with a
        # stripped PATH that does not include /opt/venv/bin, so a bare
        # `python` invocation fails with `/bin/sh: 1: python: not found`.
        # We additionally prefix the venv on PATH for any child `python`
        # resolution in case downstream helpers dispatch to bare `python`.
        (crontab -l 2>/dev/null | grep -v "send_error_report"; \
         echo "0 * * * * cd ${APP_HOME} && PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin /opt/venv/bin/python manage.py send_error_report >> ${APP_HOME}/logs/error_report_cron.log 2>&1") \
         | crontab - 2>/dev/null || echo "[WARN] crontab install failed (non-fatal)"
        service cron start 2>/dev/null || crond 2>/dev/null || true
    else
        echo "[INFO] cron not available"
    fi
fi

if [ "$#" -eq 0 ]; then
    set -- server
fi

case "$1" in
    uv|uvicorn|python|pytest|/bin/*|/usr/bin/*|/usr/local/bin/*)
        echo "[RUN] Executing command directly: $*"
        exec "$@"
        ;;
    *)
        echo "[RUN] Launching make target: $*"
        exec /usr/bin/make "$@"
        ;;
esac

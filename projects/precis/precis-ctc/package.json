{
  "name": "precis-assets",
  "version": "0.1.0",
  "private": true,
  "description": "Precis LMS Django-side webpack asset build — extends projects/webpack/base.config.js",
  "scripts": {
    "build": "npx webpack --config webpack/precis.config.js --mode=production",
    "dev": "npx webpack --config webpack/precis.config.js --mode=development --watch",
    "build:prod": "npx webpack --config webpack/precis.config.js --mode=production",
    "build:dev": "npx webpack --config webpack/precis.config.js --mode=development",
    "clean": "rm -rf ../../assets/bundles/ctc-research"
  },

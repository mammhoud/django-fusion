    "webpack-merge": "^6.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "autoprefixer": "^10.4.23",
    "babel-loader": "^10.0.0",
    "core-js": "^3.43.0",
    "css-loader": "^7.1.2",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "postcss-loader": "^8.2.0",
    "postcss-preset-env": "^10.5.0",
    "sass": "^1.89.0",

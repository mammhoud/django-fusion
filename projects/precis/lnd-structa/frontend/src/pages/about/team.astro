---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import CTA from '@/components/blocks/CTA.astro';
import Toast from '@/components/ui/Toast.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import ContentError from '@/components/ui/ContentError.astro';
import AboutSubNav from '@/components/ui/AboutSubNav.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('team'),
  ]);
} catch { /* use fallbacks */ }

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const pageBody = pageData?.body;
const members = ((pageData as any)?.team as any[] | undefined)?.map((m: any) => ({
  name: String(m.name || ''),
  role: String(m.role || ''),
  bio: String(m.bio || ''),
  initials: String(m.initials || (m.name || '??').split(' ').map((p: string) => p[0]).join('').slice(0, 2).toUpperCase()),
  links: (m.links || []).map((l: any) => ({ platform: String(l.platform || ''), url: String(l.url || '') })),
})) ?? [];
---

<Layout
  title={pageData?.title || 'Team'}
  description={pageData?.search_description || 'The people behind structa.cloud: the founder, the product leads, and the open-source contributors.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="team"
>
  <Breadcrumb
    items={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }]}
    current={pageData?.title || 'Team'}
  />

  <Hero
    eyebrow={pageHero?.badge || 'about · the team'}
    heading={pageHero?.title || 'The people behind structa.cloud'}
    accent=''
    intro={pageHero?.subtitle || "One engineer, three product leads, and the open-source contributors who make the monorepo ship."}
    primaryCta={pageHero?.primary_cta ? { label: pageHero.primary_cta.label, href: pageHero.primary_cta.href } : { label: 'Meet the founder', href: '/about' }}
    secondaryCta={pageHero?.secondary_cta ? { label: pageHero.secondary_cta.label, href: pageHero.secondary_cta.href } : { label: 'Get in touch', href: '/contact/' }}
    status='200 OK · text/html · the people, in one response'
  />

  <AboutSubNav current="team" />

  {pageBody ? (
    <section class='doc-sheet bg-fu-paper py-16 md:py-20'>
      <div class='container-fusion'>
        <div class='mx-auto max-w-2xl leading-relaxed text-fu-muted' set:html={pageBody} />
      </div>
    </section>
  ) : null}

  {members.length ? (
  <section id='team' class='doc-sheet bg-fu-paper py-16 md:py-20'>
    <div class='container-fusion'>
      <div class='mb-12 max-w-2xl'>
        <p class='tag-marker mb-4'>the team</p>
        <h2 class='mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl'>Who builds what</h2>
        <p class='text-fu-muted'>Every product is a project in the monorepo, and every project has an owner.</p>
      </div>
      <div class='grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3'>
        {members.map((m) => (
          <article class='card flex flex-col p-6'>
            <div class='mb-4 flex items-center gap-4'>
              <div class='flex h-12 w-12 items-center justify-center rounded-full border border-fu-line bg-fu-card font-mono text-sm font-semibold text-fu-link'>
                {m.initials}
              </div>
              <div>
                <h3 class='font-display text-lg font-semibold text-fu-ink' style='margin:0;'>{m.name}</h3>
                {m.role && <p class='mt-0.5 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-fu-muted'>{m.role}</p>}
              </div>
            </div>
            {m.bio && <p class='mb-4 text-sm leading-relaxed text-fu-muted'>{m.bio}</p>}
            {m.links.length > 0 && (
              <div class='mt-auto flex flex-wrap gap-2 pt-2'>
                {m.links.map((l: any) => (
                  <a href={l.url} target='_blank' rel='noopener' class='btn-secondary !h-8 !px-3 !py-0 text-[0.72rem]'>{l.platform}</a>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
  ) : <ContentError label="Team data unavailable" />}

  <CTA
    heading={pageCta?.title || 'Built in the open'}
    intro={pageCta?.subtitle || 'Every line of structa.cloud is public on GitHub. Come build with us.'}
    ctaLabel={pageCta?.primary_cta?.label || 'View on GitHub'}
    ctaHref={pageCta?.primary_cta?.href || 'https://github.com/mammhoud'}
  />
  <Toast />
</Layout>

# ================================================================
# Landing-Fusion — Frontend (Astro) Environment
# ================================================================
# Copy to `.env` and adjust. Read by astro.config.mjs (PORT, BACKEND_URL,
# PUBLIC_SITE_URL) and src/lib/* (PUBLIC_* vars at build/dev time).
# ================================================================

# ── Ports & dev proxy ────────────────────────────────────────────
# Astro dev server port (astro.config.mjs)
PORT=3000
# Django backend origin for the Astro dev proxy (auth, APIs, fragments,
# static/media, learning). Change to the service name in Docker builds.
BACKEND_URL=http://127.0.0.1:8074

# ── Site identity ────────────────────────────────────────────────
# Canonical site URL (SEO, sitemap, OG metadata)
PUBLIC_SITE_URL=https://landing.structa.cloud

# ── Backend roads (src/lib/api.ts + src/lib/site.ts) ─────────────
# Server-side backend base used by the SSG data fetch
PUBLIC_FUSION_API_URL=http://127.0.0.1:8074
# Browser-safe backend origin. Empty = same-origin production routing.
PUBLIC_BROWSER_API_URL=
# Enable the live HTMX fragment road (render-first / Django road)
PUBLIC_ENABLE_BACKEND=true

# ── Content ──────────────────────────────────────────────────────
# Build-time content locale: en | ar | sv | fr | de | es | pt
PUBLIC_CONTENT_LANGUAGE=en

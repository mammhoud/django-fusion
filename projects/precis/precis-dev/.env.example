[TEMPLATE]
# ================================================================
# 🌐 Precis Main (unified LMS + landing) — Environment Configuration
# ================================================================
# Copy this file to .env (project dir) and fill in values.
#
# CONFIG CASCADE — where each value lives (low → high priority):
#   1. YAML defaults   configs/*.yml (site identity, admin, CSS panel,
#                      local-dev defaults) + projects/precis/configs/Env
#   2. Site overrides  Env/_site.yml
#   3. THIS .env       <project>/.env — uncommitted local customization
#   4. Compose         docker-compose.yml `environment:` (DJANGO_* / bare)
#
# Rule: YAML holds defaults, .env holds customization, Compose holds
# deploy-time truth. `make config-show` prints the merged result.
# ================================================================

# ── Cascade & environment ────────────────────────────────────────
# SERVER_ENV=development | demo | staging | testing | production
SERVER_ENV=development
# WEBSITE / WEBSITE_NAME select the site registry entry (precis-main).
WEBSITE_NAME=precis-main

# ── Core ────────────────────────────────────────────────────────
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,precis-main-backend,precis-main-frontend
DJANGO_DB_PATH=backend/db.sqlite3

# ── Site Identity (defaults in configs/site.yml; override here) ─
DOMAIN_NAME=structa.cloud
SITE_DOMAIN=structa.cloud
WAGTAIL_SITE_NAME=StructAI Softwares
WAGTAILADMIN_BASE_URL=http://localhost:8074

# ── Admin & CSS panel (defaults in configs/admin.yml) ───────────
# Admin paths are backend-owned: /admin → Wagtail login,
# /django-admin → Django admin login (proxy contract).
# The design-system stylesheet is compiled by `make css` from
# frontend/src/styles/globals.css → assets/static/css/fusion.css and served
# at /static/css/fusion.css after collectstatic. No env var required.

# ── Ports ────────────────────────────────────────────────────────
PRECIS_MAIN_BACKEND_PORT=8074
PRECIS_MAIN_FRONTEND_PORT=3000

# ── Auth (django-allauth headless) ──────────────────────────────
ACCOUNT_EMAIL_VERIFICATION=optional
DEFAULT_FROM_EMAIL=Structa Cloud <structa.cloud@gmail.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ── Social Auth ──────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── CORS & CSRF ──────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8074,http://127.0.0.1:8074,http://localhost:3000,http://127.0.0.1:3000

# ── Fusion Render Mode ───────────────────────────────────────────
# True  = Django renders full HTML (fusion-render-first, SEO-friendly)
# False = JSON data APIs — Astro frontend renders from /apis/* endpoints
FUSION_RENDER_FIRST=0

# ── Fusion Asset Pipeline ────────────────────────────────────────
# Webpack is disabled by default for precis-main (uses Astro/Vite for
# bundling). Enable only if you need django-fusion component SCSS bundling.
FUSION_WEBPACK_ENABLED=0
FUSION_WEBPACK_WORKSPACE=landing
FUSION_WEBPACK_OUTPUT_PATH=projects/precis/precis-main/backend/assets/static/bundles/
FUSION_WEBPACK_STATS_FILE=projects/precis/precis-main/backend/webpack-stats.json

# ── Webpack (when enabled) ───────────────────────────────────────
FUSION_WEBPACK_WORKSPACE_PATH=

# ── Learning Commerce ────────────────────────────────────────────
LEARNING_PAYMENT_PROVIDER=
LEARNING_COURSE_CURRENCY=USD
FUSION_DEFAULT_CURRENCY=USD

# ── Newsletter (optional) ────────────────────────────────────────
# Provider: "" (off) | "mailchimp" | "brevo" | "webhook"
NEWSLETTER_PROVIDER=
NEWSLETTER_MAILCHIMP_API_KEY=
NEWSLETTER_MAILCHIMP_LIST_ID=
NEWSLETTER_MAILCHIMP_SERVER_PREFIX=us1
NEWSLETTER_BREVO_API_KEY=
NEWSLETTER_BREVO_LIST_ID=
NEWSLETTER_WEBHOOK_URL=

# ── Email (production — SMTP) ────────────────────────────────────
# Gmail SMTP for structa.cloud@gmail.com (use a Gmail "App password",
# 16 chars without spaces). Uncomment + copy to .env to enable sending.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_HOST_USER=structa.cloud@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# SERVER_EMAIL=Structa Cloud <structa.cloud@gmail.com>

# ── Database (wired by type — configs/database.yml contract) ───────
# Local dev (manage.py runserver) defaults to SQLite. Set DB_TYPE=postgres
# (or DJANGO_DB_ENGINE=django.db.backends.postgresql / USE_POSTGRES=1) to
# connect to the shared ``postgres`` container (application/databases) with
# this site's own database (DB_NAME_LANDING → db_precis_landing). Docker
# Compose sets DB_TYPE=postgres by default; DB_TYPE=sqlite keeps the
# container on SQLite (CI/local runs).
#
# The password is NEVER stored in YAML — it is read from .env here
# (POSTGRES_PASSWORD is the shared cluster credential; it must match
# application/databases/.env). Copy the generated default from
# application/databases/.env.example into this file (or repo-root .env).
DB_TYPE=postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=
DB_NAME_LANDING=db_precis_landing
# Explicit DJANGO_DB_* overrides (only needed to differ from the above):
# DJANGO_DB_NAME=db_precis_landing
# DJANGO_DB_USER=admin
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=postgres
# DJANGO_DB_PORT=5432

# ── Static files (defaults in configs/defaults.yml → STATIC:) ───
# Read:   backend/assets/static + assets/static + frontend/public
# Output: backend/assets/staticfiles (STATIC_ROOT, after collectstatic)
# Media:  backend/assets/media (MEDIA_ROOT)
# Deploy: named volumes precis-main-static / precis-main-media;
#         /static/ served by whitenoise behind traefik; /media/ via
#         shared-proxy nginx. See docs/guides/config-cascade.md.
# Override the collected location only when moving STATIC_ROOT:
# DJANGO_STATIC_ROOT=

# ── Redis (optional — cache/sessions) ────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Sentry (optional — error monitoring) ─────────────────────────
# SENTRY_DSN=https://<key>@sentry.io/<project>

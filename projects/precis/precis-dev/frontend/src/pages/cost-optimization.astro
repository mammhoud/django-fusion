---
import Layout from '@/layouts/Layout.astro';
import CTA from '@/components/blocks/CTA.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation } from '@/lib/api';
import type { SiteSettings, NavigationData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
try { [siteSettings, navData] = await Promise.all([cachedSiteSettings(), cachedNavigation()]); } catch { /* static fallback */ }
---

<Layout title="Cloud Cost Optimization with Evidence" description="Find cloud waste, connect spend to architecture, and prioritize cost improvements without sacrificing reliability." navItems={navData?.nav_items} siteSettings={siteSettings} pageSlug="cost-optimization">
  <section class="section-hero reg-marks overflow-hidden py-20 md:py-28"><div class="container-fusion"><div class="max-w-3xl"><p class="tag-marker mb-5">service · cost optimization</p><h1 class="font-display text-4xl font-bold tracking-tight text-fu-ink md:text-6xl">Spend less by understanding more.</h1><p class="mt-6 max-w-2xl text-lg leading-relaxed text-fu-muted">A cost review should connect invoices to workloads, usage patterns, architecture decisions, and the reliability trade-offs your team is willing to make.</p><div class="mt-8 flex flex-wrap gap-3"><a class="btn-primary" href="/contact/?topic=infrastructure-and-ai-assessment">Request a cost review <span aria-hidden="true">→</span></a><a class="btn-secondary" href="/services/">See our approach</a></div></div></div></section>
  <section class="doc-sheet bg-fu-card py-20 md:py-28"><div class="container-fusion"><div class="grid gap-5 md:grid-cols-3"><article class="card p-6"><p class="tag-marker mb-4">visibility</p><h2 class="font-display text-xl font-semibold text-fu-ink">Map the spend</h2><p class="mt-3 text-sm leading-relaxed text-fu-muted">Separate baseline usage, seasonal demand, idle resources, and shared platform costs.</p></article><article class="card p-6"><p class="tag-marker mb-4">decisions</p><h2 class="font-display text-xl font-semibold text-fu-ink">Rank the levers</h2><p class="mt-3 text-sm leading-relaxed text-fu-muted">Prioritize changes by expected value, effort, risk, and impact on the customer experience.</p></article><article class="card p-6"><p class="tag-marker mb-4">operating rhythm</p><h2 class="font-display text-xl font-semibold text-fu-ink">Keep improving</h2><p class="mt-3 text-sm leading-relaxed text-fu-muted">Turn one-off cleanup into ownership, alerts, budgets, and a review cadence.</p></article></div><div class="mt-16 grid gap-8 lg:grid-cols-2"><div><p class="tag-marker mb-4">what we avoid</p><h2 class="font-display text-3xl font-bold tracking-tight text-fu-ink">False savings that create real incidents.</h2></div><ul class="grid gap-3 text-sm text-fu-muted"><li class="card p-5">No blanket downsizing without workload evidence.</li><li class="card p-5">No cost target detached from reliability requirements.</li><li class="card p-5">No “savings” claim before the baseline and assumptions are agreed.</li></ul></div></div></section>
  <CTA heading="Want a clearer cloud cost baseline?" intro="Bring the invoice, the architecture, and the questions your team is already asking. We will help turn them into a prioritized review." ctaLabel="Request a cost review" ctaHref="/contact/?topic=infrastructure-and-ai-assessment" />
  <Toast /><HtmxBootstrap />
</Layout>

---
/** Share buttons — social sharing with Web Share API fallback.
 *
 * Uses navigator.share() on mobile, copies URL on desktop.
 */
interface Props {
  url?: string;
  title?: string;
  text?: string;
  platforms?: ('twitter' | 'linkedin' | 'facebook' | 'copy' | 'email')[];
}

const {
  url,
  title = '',
  text = '',
  platforms = ['twitter', 'linkedin', 'copy'],
} = Astro.props;

const shareUrl = url || '';
const encodedUrl = encodeURIComponent(shareUrl);
const encodedTitle = encodeURIComponent(title);
const encodedText = encodeURIComponent(text);
---

<div
  x-data="{
    copied: false,
    async share(platform) {
      if (platform === 'copy') {
        await navigator.clipboard.writeText(this.$data.shareUrl);
        this.copied = true;
        setTimeout(() => this.copied = false, 2000);
        return;
      }
      if (platform === 'native') {
        try {
          await navigator.share({ title: this.$data.shareTitle, text: this.$data.shareText, url: this.$data.shareUrl });
        } catch {}
        return;
      }
      const urls = {
        twitter: `https://twitter.com/intent/tweet?url=${this.$data.encodedUrl}&text=${this.$data.encodedTitle}`,
        linkedin: `https://linkedin.com/sharing/share-offsite/?url=${this.$data.encodedUrl}`,
        facebook: `https://facebook.com/sharer/sharer.php?u=${this.$data.encodedUrl}`,
        email: `mailto:?subject=${this.$data.encodedTitle}&body=${this.$data.encodedText}%0A%0A${this.$data.encodedUrl}`,
      };
      window.open(urls[platform], '_blank', 'noopener,noreferrer,width=600,height=400');
    },
    get shareUrl() { return '${shareUrl}' || window.location.href; },
    get shareTitle() { return '${title}' || document.title; },
    get shareText() { return '${text}'; },
    get encodedUrl() { return encodeURIComponent(this.shareUrl); },
    get encodedTitle() { return encodeURIComponent(this.shareTitle); },
    get encodedText() { return encodeURIComponent(this.shareText); },
  }"
  class="flex flex-wrap items-center gap-2"
>
  <span class="mr-1 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-fu-muted">Share</span>

  {platforms.map((platform) => (
    <button
      type="button"
      @click={`share('${platform}')`}
      class="flex h-8 w-8 items-center justify-center rounded-md text-fu-muted transition-colors hover:bg-fu-line/40 hover:text-fu-ink"
      aria-label={`Share on ${platform}`}
    >
      {platform === 'copy' && (
        <svg x-show="!copied" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
        </svg>
      )}
      {platform === 'copy' && (
        <svg x-show="copied" x-cloak class="h-4 w-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      )}
      {platform === 'twitter' && (
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      )}
      {platform === 'linkedin' && (
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      )}
      {platform === 'email' && (
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      )}
    </button>
  ))}

  {/* Native share (mobile) */}
  <button
    type="button"
    @click="share('native')"
    class="flex h-8 w-8 items-center justify-center rounded-md text-fu-muted transition-colors hover:bg-fu-line/40 hover:text-fu-ink sm:hidden"
    aria-label="Share"
  >
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
    </svg>
  </button>
</div>

---
/**
 * LanguageSwitcher — Alpine-powered dropdown, persisted via Django backend.
 *
 * Selecting a language:
 *  1. Establishes the CSRF cookie via the content-languages endpoint.
 *  2. POSTs to /i18n/setlang/ so Django stores the choice in the session
 *     and sets the configured language cookie.
 *  3. Stores the choice in sessionStorage/localStorage so the Astro shell
 *     keeps the same preference across page transitions.
 *
 * Hydration: the bundled LANG_META table is injected as the immediate
 * (offline-safe) source, then GET /apis/content/languages/ replaces it
 * with the Wagtail SiteLanguage catalog (seeded + admin-editable).
 */
import { LANG_META, LANG_CODES } from '@/lib/translations';
import { browserEndpoint } from '@/lib/site';

const langs = LANG_CODES.map((code) => ({
  code,
  native: LANG_META[code].native,
  flag: LANG_META[code].flag,
  dir: LANG_META[code].dir,
}));

const defaultLang = 'en';
const langsJson = JSON.stringify(langs);
const apiBase = browserEndpoint('/apis/content/languages/').replace(/\/apis\/content\/languages\//, '');

interface Props {
  align?: 'start' | 'end';
}
const { align = 'end' } = Astro.props;
---

<script is:inline define:vars={{ langsJson, defaultLang, apiBase }}>
  window.__FUSION_LANGS = JSON.parse(langsJson);
  window.__FUSION_DEFAULT_LANG = defaultLang;
  window.__FUSION_API_BASE = apiBase;
</script>

<div
  class="relative"
  x-data="{
    open: false,
    active: window.__FUSION_DEFAULT_LANG,
    langs: window.__FUSION_LANGS,
    async init() {
      try {
        const res = await fetch(window.__FUSION_API_BASE + '/apis/content/languages/', { credentials: 'include', headers: { Accept: 'application/json' } });
        if (res.ok) {
          const data = await res.json();
          if (data && Array.isArray(data.languages) && data.languages.length) {
            this.langs = data.languages.map((lang) => {
              const bundled = window.__FUSION_LANGS.find((l) => l.code === lang.code);
              return {
                code: lang.code,
                native: lang.native || bundled?.native || lang.code,
                flag: lang.flag || bundled?.flag || '🌐',
                dir: lang.dir === 'rtl' ? 'rtl' : 'ltr',
              };
            });
          }
          // If no stored preference, trust the server-side default.
          const hasStored = sessionStorage.getItem('fusion-lang') || localStorage.getItem('fusion-lang') || document.cookie.match(/(?:^|; )django_language=/);
          if (!hasStored && data.language) this.active = data.language;
        }
      } catch { /* backend offline — keep bundled catalog */ }

      let stored = null;
      try { stored = sessionStorage.getItem('fusion-lang') || localStorage.getItem('fusion-lang'); } catch { /* noop */ }
      if (!stored) {
        try { stored = document.cookie.match(/(?:^|; )django_language=([^;]+)/)?.[1]; } catch { /* noop */ }
      }
      const browser = (navigator.language || '').split('-')[0];
      const initial = [stored, browser, this.active].find((code) =>
        code && this.langs.some((lang) => lang.code === code)
      );
      if (initial) this.apply(initial, true);
    },
    async apply(code, persist = true) {
      const meta = this.langs.find((l) => l.code === code);
      if (!meta) return;
      const previous = this.active;
      this.active = code;
      document.documentElement.lang = code;
      document.documentElement.dir = meta.dir;
      if (persist) {
        try {
          sessionStorage.setItem('fusion-lang', code);
          localStorage.setItem('fusion-lang', code);
          // Establish the CSRF cookie before the state-changing request.
          await fetch(window.__FUSION_API_BASE + '/apis/content/languages/', { credentials: 'include', headers: { Accept: 'application/json' } });
          const csrfToken = document.cookie.match(/(?:^|; )csrftoken=([^;]+)/)?.[1] || '';
          const response = await fetch('/i18n/setlang/', {
            method: 'POST',
            credentials: 'include',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
              'X-CSRFToken': csrfToken,
              Accept: 'application/json',
            },
            body: new URLSearchParams({ language: code }),
          });
          if (!response.ok) throw new Error('Language request failed (' + response.status + ')');
        } catch (error) {
          console.error('Language persistence failed', error);
          this.active = previous;
          try {
            sessionStorage.setItem('fusion-lang', previous);
            localStorage.setItem('fusion-lang', previous);
          } catch { /* noop */ }
          document.documentElement.lang = previous;
          const prevMeta = this.langs.find((l) => l.code === previous);
          if (prevMeta) document.documentElement.dir = prevMeta.dir;
        }
      }
      this.open = false;
      window.dispatchEvent(new CustomEvent('fusion:lang-changed', { detail: { code } }));
    },
    currentFlag() {
      return this.langs.find((l) => l.code === this.active)?.flag || '🌐';
    },
  }"
  @keydown.escape.window="open = false"
  @click.outside="open = false"
>
  <button
    type="button"
    class="flex items-center gap-1.5 rounded-md border border-fu-line bg-fu-card px-2.5 py-1.5 text-sm font-medium text-fu-ink transition-all hover:border-fu-link/50"
    @click="open = !open"
    aria-haspopup="listbox"
    :aria-expanded="open.toString()"
    aria-label="Change language"
    title="Change language"
  >
    <span class="text-base leading-none" aria-hidden="true" x-text="currentFlag()"></span>
    <span class="hidden sm:inline font-mono text-[0.72rem] uppercase tracking-[0.08em]" x-text="active"></span>
    <svg class="h-3 w-3 text-fu-muted transition-transform" :class="open && 'rotate-180'" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>

  <div
    x-show="open"
    x-cloak
    x-transition:enter="transition ease-out duration-150"
    x-transition:enter-start="opacity-0 scale-95 -translate-y-1"
    x-transition:enter-end="opacity-100 scale-100 translate-y-0"
    x-transition:leave="transition ease-in duration-100"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @click.self="open = false"
    class={`absolute ${align === 'start' ? 'start-0' : 'end-0'} mt-2 w-48 rounded-xl border border-fu-line bg-fu-paper p-1.5 shadow-xl`}
    role="listbox"
    aria-label="Select language"
  >
    <template x-for="lang in langs" :key="lang.code">
      <button
        type="button"
        role="option"
        :aria-selected="active === lang.code"
        class="flex w-full items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors hover:bg-fu-card"
        :class="active === lang.code ? 'text-fu-link font-semibold' : 'text-fu-ink'"
        @click="apply(lang.code)"
        @keydown.enter.prevent="apply(lang.code)"
      >
        <span class="text-base" aria-hidden="true" x-text="lang.flag"></span>
        <span x-text="lang.native"></span>
        <span x-show="active === lang.code" class="ml-auto text-fu-link" aria-hidden="true">✓</span>
      </button>
    </template>
  </div>
</div>

---
import Layout from '@/layouts/Layout.astro';
import ContactForm from '@/components/blocks/ContactForm.astro';
import NewsletterSubscribe from '@/components/blocks/NewsletterSubscribe.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import Toast from '@/components/ui/Toast.astro';
import ContentError from '@/components/ui/ContentError.astro';
import { cachedSiteSettings, cachedNavigation, cachedContact } from '@/lib/api';
import type { SiteSettings, NavigationData, ContactData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let contactData: ContactData | undefined;
try {
  [siteSettings, navData, contactData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedContact(),
  ]);
} catch { /* use fallbacks */ }

const methods = contactData?.methods;
---

<Layout title={contactData?.title || 'Contact Us'} description={contactData?.description || 'Get in touch — we reply within one business day.'} navItems={navData?.nav_items} siteSettings={siteSettings} pageSlug="contact">
  <section class='section-hero reg-marks overflow-hidden py-16'>
    <div class='container-fusion'>
      <div class='mx-auto max-w-2xl text-center'>
        <p class='tag-marker mb-5'>contact</p>
        <h1 class='mb-4 font-display text-4xl font-bold tracking-tight md:text-5xl'>{contactData?.title || 'Contact Us'}</h1>
        <p class='text-lg text-fu-muted'>{contactData?.description || "We'd love to hear from you. Send a message and we'll get back to you soon."}</p>
      </div>
    </div>
  </section>

  <div class='py-14'>
    {methods?.length ? (
      <ContactForm methods={methods} formTitle={contactData?.form_title} formDescription={contactData?.form_description} />
    ) : (
      <ContentError label="Contact information unavailable" />
    )}
  </div>

  <NewsletterSubscribe />
  <Toast />
  <HtmxBootstrap />
</Layout>

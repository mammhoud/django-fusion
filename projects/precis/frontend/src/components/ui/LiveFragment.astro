---
/**
 * LiveFragment — an HTMX section that requests the *backend* component.
 *
 * Mechanism (AHA-stack, plan §12):
 *   - On load, HTMX issues `hx-get` to the django-fusion handler for this
 *     route (e.g. `{fusionApiUrl}/features/`). Because the request carries
 *     the `HX-Request` header, the backend renders `pages/fragments/page.html`
 *     — the content region only — and swaps it into this section.
 *   - While the request is in flight, the section shows a default skeleton
 *     (`.fusion-skeleton` shimmer). HTMX toggles `#htmx-global-indicator`
 *     via the global beforeRequest/afterRequest listeners in Layout.astro.
 *   - On success the backend HTML replaces the skeleton (`hx-swap`).
 *   - On error (backend down) the section falls back to a quiet note.
 *
 * `fusionApiUrl` defaults to '' (same-origin). Set PUBLIC_FUSION_API_URL to
 * point at the Django backend directly (e.g. http://localhost:8074).
 *
 * Recursion guard: on a standalone static build (no PUBLIC_FUSION_API_URL)
 * the endpoint resolves same-origin, so `hx-get` would fetch *this very page*
 * (which contains another LiveFragment) and nest the full document into
 * itself forever. When no backend is configured we never fire the request —
 * the section shows a quiet note instead. The actual request region lives in
 * LiveFragmentTarget.astro (the `<template>` fallback must stay in plain
 * template body — inside a JSX expression the Astro compiler flattens it).
 *
 * The `skeletonVariant` prop selects a component-matched skeleton so the
 * placeholder reflects the actual content shape — no layout jump on swap.
 */
import LiveFragmentTarget from '@/components/ui/LiveFragmentTarget.astro';
import { fusionApiUrl } from '@/lib/site';

interface Props {
  /** Backend route to fetch — must match an apps/handlers url, e.g. '/features/'. */
  route: string;
  /** Fragment name label, shown as the section tag-marker. */
  label?: string;
  heading?: string;
  intro?: string;
  /** Number of skeleton cards shown while the fragment loads (generic 'card' variant only). */
  skeletonCards?: number;
  /**
   * Component-matched skeleton variant. When set, LiveFragment renders a
   * skeleton that mirrors the real content shape (hero, stats, features, etc.)
   * instead of generic cards. Leave unset for generic cards via skeletonCards.
   */
  skeletonVariant?: 'hero-section' | 'stats-row' | 'features-grid' | 'testimonial'
    | 'testimonials-carousel' | 'pricing-grid' | 'pricing-folded' | 'faq-list'
    | 'cta-banner' | 'contact-form' | 'section-header';
}

const {
  route,
  label = 'live · from the backend',
  heading = '',
  intro = '',
  skeletonCards = 3,
  skeletonVariant,
} = Astro.props;

// Ensure the URL joins cleanly and stays relative when fusionApiUrl is ''.
const endpoint = `${fusionApiUrl.replace(/\/+$/, '')}${route}`;

// Recursion guard — see header comment. Only fire HTMX when a backend is
// configured; otherwise show the quiet fallback note.
const hasBackend = fusionApiUrl !== '';
---


<section class="live-fragment doc-sheet bg-fu-paper py-20 md:py-24" data-live-fragment>
  <div class="container-fusion">
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <p class="tag-marker mb-4">{label}</p>
      {heading && <h2 class="mb-4 font-display text-3xl font-bold tracking-tight text-fu-ink md:text-4xl">{heading}</h2>}
      {intro && <p class="text-fu-muted">{intro}</p>}
    </div>

    {hasBackend ? (
      <LiveFragmentTarget
        endpoint={endpoint}
        route={route}
        skeletonCards={skeletonCards}
        skeletonVariant={skeletonVariant}
      />
    ) : (
      <div class="live-fragment__target">
        <div class="live-fragment__fallback">
          The live fragment for <code class="font-mono">{route}</code> needs the Django backend.
          Rebuild the frontend with <code class="font-mono">PUBLIC_FUSION_API_URL</code> set to point
          at the backend (e.g. <code class="font-mono">http://localhost:8074</code>) to enable it.
          The static sections on this page render the same content.
        </div>
      </div>
    )}
  </div>
</section>

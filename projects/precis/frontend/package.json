{
  "name": "lms-fusion-astro",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "LMS Fusion Astro frontend with the CMS landing shell, HTMX, Alpine.js, and shared skeleton loading states.",
  "scripts": {
    "dev": "astro dev -p 3002",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",

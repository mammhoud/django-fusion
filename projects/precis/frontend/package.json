    "@astrojs/alpinejs": "^1.0.0",
    "@astrojs/mdx": "^4.2.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@types/alpinejs": "^3.13.11",
    "alpinejs": "^3.15.12",
    "astro": "^5.6.1",
    "clsx": "^2.1.1",
    "htmx.org": "^2.0.4",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/cli": "^4.1.4",
    "@tailwindcss/vite": "^4.1.4",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.25",
    "sass": "^1.102.0",

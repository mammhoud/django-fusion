---
/** Video embed — responsive 16:9 container with lazy loading.
 *  Supports YouTube, Vimeo, and direct MP4 sources.
 */
interface Props {
  /** Provider: youtube, vimeo, or direct mp4 URL */
  src: string;
  provider?: 'youtube' | 'vimeo' | 'mp4';
  title?: string;
  poster?: string;
  autoplay?: boolean;
  loop?: boolean;
  muted?: boolean;
  controls?: boolean;
  class?: string;
}

const {
  src,
  provider = 'youtube',
  title = 'Video',
  poster,
  autoplay = false,
  loop = false,
  muted = true,
  controls = true,
  class: cls = '',
} = Astro.props;

let embedUrl = src;
if (provider === 'youtube') {
  const videoId = src.includes('youtube.com/watch?v=')
    ? new URL(src).searchParams.get('v')
    : src.split('/').pop()?.split('?')[0];
  const params = new URLSearchParams({ autoplay: autoplay ? '1' : '0', mute: muted ? '1' : '0', controls: controls ? '1' : '0', loop: loop ? '1' : '0', rel: '0' });
  embedUrl = `https://www.youtube.com/embed/${videoId}?${params}`;
} else if (provider === 'vimeo') {
  const videoId = src.split('/').pop()?.split('?')[0];
  const params = new URLSearchParams({ autoplay: autoplay ? '1' : '0', muted: muted ? '1' : '0', loop: loop ? '1' : '0' });
  embedUrl = `https://player.vimeo.com/video/${videoId}?${params}`;
}
---

<figure class={`fusion-video relative overflow-hidden rounded-xl border border-fu-line bg-fu-card ${cls}`}>
  <div class="aspect-video">
    {provider === 'mp4' ? (
      <video
        src={src}
        poster={poster}
        autoplay={autoplay}
        loop={loop}
        muted={muted}
        controls={controls}
        class="h-full w-full object-cover"
        playsinline
        preload="metadata"
      >
        <track kind="captions" />
      </video>
    ) : (
      <iframe
        src={embedUrl}
        title={title}
        class="h-full w-full"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    )}
  </div>
  {title && provider !== 'mp4' && (
    <figcaption class="sr-only">{title}</figcaption>
  )}
</figure>

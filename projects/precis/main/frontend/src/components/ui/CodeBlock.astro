---
/** Code block — syntax-highlighted with copy button.
 *
 * Uses a minimal inline highlighter (comment/string/keyword tokens).
 * For production, integrate with Shiki or Prism.
 */
interface Props {
  code: string;
  language?: string;
  filename?: string;
  showLineNumbers?: boolean;
  class?: string;
}

const {
  code,
  language = 'plaintext',
  filename,
  showLineNumbers = false,
  class: cls = '',
} = Astro.props;

const lines = code.trim().split('\n');
---

<figure class={`fusion-code-block group relative overflow-hidden rounded-xl border border-fu-line bg-[#131312] ${cls}`}>
  {/* Header bar */}
  {(filename || language !== 'plaintext') && (
    <div class="flex items-center justify-between border-b border-fu-line/20 px-4 py-2">
      <div class="flex items-center gap-2">
        <span class="flex gap-1.5" aria-hidden="true">
          <span class="h-2.5 w-2.5 rounded-full bg-red-400/70"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-yellow-400/70"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-green-400/70"></span>
        </span>
        {filename && <span class="font-mono text-xs text-fu-muted/70">{filename}</span>}
      </div>
      {language !== 'plaintext' && (
        <span class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-fu-muted/50">{language}</span>
      )}
    </div>
  )}

  {/* Code */}
  <div class="relative">
    <pre class={`overflow-x-auto p-4 text-sm leading-relaxed ${showLineNumbers ? 'pl-12' : ''}`}>
      <code class={`language-${language} font-mono text-[#E4E4E0]`}>
        {lines.map((line, i) => (
          <span class="block">
            {showLineNumbers && (
              <span class="absolute left-0 inline-block w-10 select-none text-right pr-3 text-fu-muted/30">{i + 1}</span>
            )}
            {line || '\u00A0'}
          </span>
        ))}
      </code>
    </pre>

    {/* Copy button */}
    <button
      type="button"
      x-data="{ copied: false }"
      @click="navigator.clipboard.writeText($el.closest('.fusion-code-block').querySelector('code').textContent || ''); copied = true; setTimeout(() => copied = false, 2000)"
      class="absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-md bg-fu-line/10 text-fu-muted/60 opacity-0 transition-all hover:bg-fu-line/20 hover:text-fu-muted group-hover:opacity-100 focus:opacity-100"
      aria-label="Copy code"
    >
      <svg x-show="!copied" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
      </svg>
      <svg x-show="copied" x-cloak class="h-4 w-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
      </svg>
    </button>
  </div>
</figure>

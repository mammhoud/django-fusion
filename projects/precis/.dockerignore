# LMS-Fusion project Docker context
# Keep source, package manifests, public assets, and shared assets available to
# the frontend Dockerfile; exclude only generated/local artifacts.

# Frontend dependencies and build output
frontend/node_modules/
frontend/.astro/
frontend-next-legacy/
frontend/node_modules/
frontend/.cache/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Shared asset dependencies and generated output
assets/node_modules/
assets/.cache/
assets/bundles/
assets/staticfiles/
assets/media/

# Python/runtime caches
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.hypothesis/
**/*.egg-info/

# Local build artifacts and reports
**/dist/
**/build/
**/coverage/
**/test_reports/
**/*.log
logs/

# Local databases and secrets
**/*.sqlite3
**/.env
**/.env.*

# Editor/OS/VCS files
**/.git/
**/.idea/
**/.vscode/
**/.DS_Store
**/Thumbs.db

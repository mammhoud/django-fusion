{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "precis-main-assets",
  "root": "projects/precis/precis-main",
  "projectType": "library",
  "tags": ["product:precis-main", "type:assets", "stack:webpack"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["assets", "^production"],
      "cache": true,
      "options": { "command": "npm run build", "cwd": "projects/precis/precis-main" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run dev", "cwd": "projects/precis/precis-main" }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run clean", "cwd": "projects/precis/precis-main" }
    }
  }
}

---
/** Schema.org breadcrumb navigation shared by all nested landing pages. */
interface BreadcrumbItem { label: string; href: string; }
interface Props { items: BreadcrumbItem[]; current?: string; class?: string; }
const { items, current, class: cls } = Astro.props;
---
<nav aria-label="Breadcrumb" class:list={['site-breadcrumb', cls]} data-fusion-component="breadcrumb">
  <ol class="site-breadcrumb__list" itemscope itemtype="https://schema.org/BreadcrumbList">
    {items.map((item, i) => {
      const isLast = i === items.length - 1 && !current;
      return (
        <li class:list={['site-breadcrumb__item', isLast && 'site-breadcrumb__item--current']} itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <meta itemprop="position" content={String(i + 1)} />
          {isLast ? <span itemprop="name" aria-current="page">{item.label}</span> : <a href={item.href} class="site-breadcrumb__link" itemprop="item"><span itemprop="name">{item.label}</span></a>}
          {!isLast && <span class="site-breadcrumb__separator" aria-hidden="true">/</span>}
        </li>
      );
    })}
    {current && <li class="site-breadcrumb__item site-breadcrumb__item--current" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page"><meta itemprop="position" content={String(items.length + 1)} /><span itemprop="name">{current}</span></li>}
  </ol>
</nav>

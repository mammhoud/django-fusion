---
interface Props {
  class?: string;
  hover?: boolean;
  padding?: 'none' | 'sm' | 'md' | 'lg';
}

const { class: className = '', hover = false, padding = 'md' } = Astro.props;

const padClass = {
  none: '',
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
}[padding];
---

<div
  class:list={['card', padClass, hover && 'hover:-translate-y-1 hover:shadow-lg', className]}
>
  <slot />
</div>

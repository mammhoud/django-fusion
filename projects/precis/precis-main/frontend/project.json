{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "precis-main-frontend",
  "root": "projects/precis/precis-main/frontend",
  "projectType": "application",
  "tags": ["product:precis-main", "type:frontend", "stack:astro"],
  "implicitDependencies": ["precis-main-assets", "precis-main-backend", "django-fusion-assets", "fusion-js"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build", "cwd": "projects/precis/precis-main/frontend" }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run check", "cwd": "projects/precis/precis-main/frontend" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run test", "cwd": "projects/precis/precis-main/frontend" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run dev", "cwd": "projects/precis/precis-main/frontend" }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run preview", "cwd": "projects/precis/precis-main/frontend" }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run test:e2e:playwright", "cwd": "projects/precis/precis-main/frontend" }
    }
  }
}

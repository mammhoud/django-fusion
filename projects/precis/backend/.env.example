# ================================================================
# 🌐 Precis LMS — Environment Configuration Example
# ================================================================
# Copy to .env and fill in values.
# This project imports shared Fusion defaults from configs.default,
# then applies LMS-specific overrides from this file via Dynaconf.
# ================================================================

# ── Core Environment ─────────────────────────────────────────────
# Valid SERVER_ENV values: development, demo, staging, testing, production
SERVER_ENV=development
RUNNING_ENV=local
MODULE=FUSION
DJANGO_WEBSITE=lms-fusion
WEBSITE=lms-fusion
WEBSITE_NAME=lms-fusion

# ── Django ───────────────────────────────────────────────────────
DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret

# ── Domain & Hosts ───────────────────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1,lms-fusion.localhost
CSRF_TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3458
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3458

# ── Redis (cache, sessions, broker) ──────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/3

# ── Django Superuser (initial setup) ─────────────────────────────
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@precis.cloud
SUPERUSER_PASSWORD=change-me

# ── Feature Flags ────────────────────────────────────────────────
VAULT_ENABLED_FOR_DYNACONF=false

# ── Email (SMTP) ─────────────────────────────────────────────────
EMAIL_STRATEGY=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_SENDER_1=your-primary-sender@gmail.com
EMAIL_SENDER_1_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-primary-sender@gmail.com

# ── Database (PostgreSQL — used in production/demo/staging) ──────
# For local dev without Docker, set DB_TYPE=sqlite.
DB_ENGINE=django.db.backends.postgresql
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=db_structa
DB_USER=postgres
DB_PASSWORD=change-me

# ── Branding ─────────────────────────────────────────────────────
FUSION_SITE_NAME=Precis LMS
FUSION_COMPANY_NAME=StructAI Softwares
FUSION_CREATOR_NAME=Precis Team
FUSION_PRIMARY_COLOR=#00a1b3
FUSION_SECONDARY_COLOR=#008080

# ── Fusion Render Mode ───────────────────────────────────────────
# True  = Django renders full HTML (fusion-render-first)
# False = JSON data APIs — frontend renders from endpoints
FUSION_RENDER_FIRST_DEFAULT=1

# ── Fusion Asset Pipeline ────────────────────────────────────────
FUSION_WEBPACK_ENABLED=0
FUSION_WEBPACK_WORKSPACE=precis
FUSION_WEBPACK_OUTPUT_PATH=projects/precis/assets/static/bundles/
FUSION_WEBPACK_STATS_FILE=projects/precis/backend/webpack-stats.json

# ── Webpack (when enabled) ───────────────────────────────────────
# Workspace config file path (relative to project root or absolute)
FUSION_WEBPACK_WORKSPACE_PATH=

# ── Bolt API ─────────────────────────────────────────────────────
FUSION_BOLT_ENABLED=1
FUSION_BOLT_PREFIX=/api
FUSION_BOLT_OPENAPI_TITLE=Precis LMS API
FUSION_BOLT_OPENAPI_VERSION=1.0.0

# ── Auth (django-allauth) ────────────────────────────────────────
ACCOUNT_EMAIL_VERIFICATION=optional
MFA_PASSKEY_LOGIN_ENABLED=1

# ── Payments (optional) ──────────────────────────────────────────
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...

# ── Newsletter Provider ──────────────────────────────────────────
# Provider: "" (off) | "mailchimp" | "brevo" | "webhook"
NEWSLETTER_PROVIDER=

# ── Sentry (optional — error monitoring) ─────────────────────────
# SENTRY_DSN=https://<key>@sentry.io/<project>

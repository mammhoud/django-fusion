# ================================================================
# 🌐 Landing-Fusion — Environment Configuration Example
# ================================================================
# Copy to .env and fill in values.
# This project uses a standalone Django + Wagtail config at
# projects/precis/lnd-structa/backend/settings.py — no shared configs.
# ================================================================

# ── Core ────────────────────────────────────────────────────────
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,precis-landing-backend,precis-landing-frontend
DJANGO_DB_PATH=backend/db.sqlite3

# ── Site Identity ────────────────────────────────────────────────
WAGTAIL_SITE_NAME=StructAI Softwares
WAGTAILADMIN_BASE_URL=http://localhost:8074

# ── Ports ────────────────────────────────────────────────────────
# Backend Django dev server
LANDING_BACKEND_PORT=8074
# Astro frontend dev server (matches frontend/astro.config.mjs; override
# per-run via frontend/.env — see frontend/.env.example)
LANDING_FRONTEND_PORT=3000

# ── Auth (django-allauth headless) ──────────────────────────────
ACCOUNT_EMAIL_VERIFICATION=optional
DEFAULT_FROM_EMAIL=Structa Cloud <structa.cloud@gmail.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ── Social Auth ──────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── CORS & CSRF ──────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8074,http://127.0.0.1:8074,http://localhost:3000,http://127.0.0.1:3000

# ── Fusion Render Mode ───────────────────────────────────────────
# True  = Django renders full HTML (fusion-render-first, SEO-friendly)
# False = JSON data APIs — Astro frontend renders from /apis/* endpoints
FUSION_RENDER_FIRST=0

# ── Fusion Asset Pipeline ────────────────────────────────────────
# Webpack is disabled by default for precis-landing (uses Astro/Vite for bundling).
# Enable only if you need django-fusion component SCSS bundling.
FUSION_WEBPACK_ENABLED=0
FUSION_WEBPACK_WORKSPACE=landing
FUSION_WEBPACK_OUTPUT_PATH=projects/precis/lnd-structa/backend/assets/static/bundles/
FUSION_WEBPACK_STATS_FILE=projects/precis/lnd-structa/backend/webpack-stats.json

# ── Webpack (when enabled) ───────────────────────────────────────
# Workspace config file (relative to project root or absolute)
FUSION_WEBPACK_WORKSPACE_PATH=

# ── Learning Commerce ────────────────────────────────────────────
LEARNING_PAYMENT_PROVIDER=
LEARNING_COURSE_CURRENCY=USD

# ── Newsletter (optional) ────────────────────────────────────────
# Provider: "" (off) | "mailchimp" | "brevo" | "webhook"
NEWSLETTER_PROVIDER=
NEWSLETTER_MAILCHIMP_API_KEY=
NEWSLETTER_MAILCHIMP_LIST_ID=
NEWSLETTER_MAILCHIMP_SERVER_PREFIX=us1
NEWSLETTER_BREVO_API_KEY=
NEWSLETTER_BREVO_LIST_ID=
NEWSLETTER_WEBHOOK_URL=

# ── Email (production — SMTP) ────────────────────────────────────
# Gmail SMTP for structa.cloud@gmail.com (use a Gmail "App password",
# 16 chars without spaces). Uncomment + copy to .env to enable sending.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_HOST_USER=structa.cloud@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# SERVER_EMAIL=Structa Cloud <structa.cloud@gmail.com>

# ── PostgreSQL (shared cluster — override SQLite) ─────────────────
# Set DJANGO_DB_ENGINE=postgresql (or USE_POSTGRES=1) to connect to the
# shared ``postgres`` container (applications/databases) with this site's
# own database (DB_NAME_LANDING → db_landing).
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_HOST=postgres
# DJANGO_DB_PORT=5432
# DJANGO_DB_NAME=db_landing
# DJANGO_DB_USER=admin
# DJANGO_DB_PASSWORD=change-me

# ── Redis (optional — cache/sessions) ────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Sentry (optional — error monitoring) ─────────────────────────
# SENTRY_DSN=https://<key>@sentry.io/<project>

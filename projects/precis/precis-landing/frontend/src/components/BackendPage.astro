---
/**
 * BackendPage — the minimal Astro shell for backend-owned pages.
 *
 * The Wagtail/django-fusion backend is the single source of truth for page
 * content. This component fetches the rendered content fragment
 * (`/fragment/pages/<slug>/`) at build time and embeds it verbatim, while the
 * shared Layout supplies only the chrome (header, footer, SEO, theme). No page
 * markup is duplicated here — the backend fragment IS the page body, delivered
 * over the same HTML road the runtime HTMX/SSE fragment swap uses.
 */
import Layout from '@/layouts/Layout.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData, cachedFragment } from '@/lib/api';

interface Props {
  /** Backend page slug — drives both the content fragment and the SEO metadata. */
  slug: string;
}

const { slug } = Astro.props;

const [siteSettings, navData, pageData, fragmentHtml] = await Promise.all([
  cachedSiteSettings(),
  cachedNavigation(),
  cachedPageData(slug),
  cachedFragment(slug),
]);
---

<Layout
  title={pageData?.title}
  description={pageData?.search_description}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug={slug}
>
  <Fragment set:html={fragmentHtml} />
</Layout>

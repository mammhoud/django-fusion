{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "precis-landing",
  "root": "projects/precis/precis-landing/frontend",
  "projectType": "application",
  "tags": [
    "product:precis-landing",
    "type:frontend",
    "stack:astro"
  ],
  "implicitDependencies": [
    "precis-landing-assets",
    "precis-landing-backend",
    "django-fusion-assets",
    "fusion-js"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build",
        "cwd": "projects/precis/precis-landing/frontend"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run check",
        "cwd": "projects/precis/precis-landing/frontend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run test",
        "cwd": "projects/precis/precis-landing/frontend"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev",
        "cwd": "projects/precis/precis-landing/frontend"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run preview",
        "cwd": "projects/precis/precis-landing/frontend"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run test:e2e:playwright",
        "cwd": "projects/precis/precis-landing/frontend"
      }
    }
  }
}
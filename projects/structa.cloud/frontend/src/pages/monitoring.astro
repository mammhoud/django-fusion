---
import Layout from '@/layouts/Layout.astro';
import CTA from '@/components/blocks/CTA.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation } from '@/lib/api';
import type { SiteSettings, NavigationData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
try { [siteSettings, navData] = await Promise.all([cachedSiteSettings(), cachedNavigation()]); } catch { /* static fallback */ }
---

<Layout title="Monitoring That Helps Teams Decide" description="Build useful observability around customer impact, service health, and the decisions your team needs to make." navItems={navData?.nav_items} siteSettings={siteSettings} pageSlug="monitoring">
  <section class="section-hero reg-marks overflow-hidden py-20 md:py-28"><div class="container-fusion"><div class="max-w-3xl"><p class="tag-marker mb-5">service · monitoring and support</p><h1 class="font-display text-4xl font-bold tracking-tight text-fu-ink md:text-6xl">Detect the signal before it becomes a surprise.</h1><p class="mt-6 max-w-2xl text-lg leading-relaxed text-fu-muted">We connect logs, metrics, traces, checks, and runbooks to the user-facing outcomes your team is responsible for.</p><div class="mt-8 flex flex-wrap gap-3"><a class="btn-primary" href="/contact/?topic=infrastructure-and-ai-assessment">Review our observability <span aria-hidden="true">→</span></a><a class="btn-secondary" href="/services/">See all services</a></div></div></div></section>
  <section class="doc-sheet bg-fu-card py-20 md:py-28"><div class="container-fusion"><div class="grid gap-5 md:grid-cols-2"><article class="card p-6"><p class="tag-marker mb-4">signal</p><h2 class="font-display text-xl font-semibold text-fu-ink">Measure what matters</h2><p class="mt-3 text-sm leading-relaxed text-fu-muted">Start from customer journeys and service objectives, then choose the smallest useful set of signals.</p></article><article class="card p-6"><p class="tag-marker mb-4">response</p><h2 class="font-display text-xl font-semibold text-fu-ink">Make the next action clear</h2><p class="mt-3 text-sm leading-relaxed text-fu-muted">Pair alerts with context, ownership, severity, and a runbook your team can actually follow.</p></article><article class="card p-6"><p class="tag-marker mb-4">learning</p><h2 class="font-display text-xl font-semibold text-fu-ink">Review the system</h2><p class="mt-3 text-sm leading-relaxed text-fu-muted">Use incidents and near misses to improve architecture, deployment, and the quality of the signal.</p></article><article class="card p-6"><p class="tag-marker mb-4">handoff</p><h2 class="font-display text-xl font-semibold text-fu-ink">Leave an operating model</h2><p class="mt-3 text-sm leading-relaxed text-fu-muted">Your team should know what healthy looks like, who responds, and how to change the system safely.</p></article></div></div></section>
  <CTA heading="Make production easier to understand." intro="Start with the services and incidents you care about most. We will help you shape a monitoring path that supports better decisions." ctaLabel="Review our observability" ctaHref="/contact/?topic=infrastructure-and-ai-assessment" />
  <Toast /><HtmxBootstrap />
</Layout>

---
/**
 * BrandModal — the brandkit story for ONE product, opened from product
 * tooltips/cards.
 *
 * SINGLE SOURCE OF TRUTH: this component is a thin wrapper around the shared
 * django-fusion partial @fusion-templates/fusion/includes/brand_modal.html,
 * imported raw (?raw) and injected with set:html. The Django road
 * {% include %}s the SAME file from pages/base.html, so the two roads render
 * identical markup + Alpine logic and can never drift.
 *
 * Because the partial is never compiled by Astro, the \' escapes in its
 * marks script survive untouched (the exact problem that originally forced
 * marks OUT of an x-data attribute and into window.__FUSION_MARKS).
 *
 * This wrapper only adds the Astro-specific brand URL: the env-aware
 * browserEndpoint() result is published as window.__FUSION_BRAND_URL, which
 * the partial's openBoard() honours (falling back to '/apis/brand/').
 *
 * Trigger contract (works on BOTH roads, no Alpine scope needed — lives in
 * the shared partial):
 *   - any element with `data-open-brand="<slug>"` opens the modal (delegated
 *     click handler), and
 *   - the `fusion:open-brand` window event with `detail.slug` also opens it.
 *
 * Board data comes from GET /apis/brand/ (derived from the catalog +
 * BRAND_SPEC on the backend), so page + modal + /brand/ can never drift.
 * BrandPage.display_mode (page / modal / both) decides whether the
 * "Full brand page" link is offered.
 */
import { browserEndpoint } from '@/lib/site';
// ?raw — Vite returns the file contents as a string; Astro never compiles it.
import brandModalHtml from '@fusion-templates/fusion/includes/brand_modal.html?raw';

const brandUrl = browserEndpoint('/apis/brand/');
---

<Fragment set:html={brandModalHtml} />

<script is:inline define:vars={{ brandUrl }}>
  window.__FUSION_BRAND_URL = brandUrl;
</script>

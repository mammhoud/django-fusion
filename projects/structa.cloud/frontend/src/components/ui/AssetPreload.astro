---
import type { AssetManifest } from '@/lib/api';

interface Props {
  manifest?: AssetManifest | null;
}

const { manifest } = Astro.props;
const top = manifest?.top ?? {};
const preconnect = top.preconnect ?? manifest?.preconnect ?? [];
const stylesheets = [...(top.css ?? []), ...(top.fonts ?? [])].filter((url, index, urls) => urls.indexOf(url) === index);
const scripts = manifest?.bottom?.js ?? [];
const fontFiles = (top.fonts ?? []).filter((url) => /\.(woff2?|ttf|otf)(\?|$)/i.test(url));
---

{preconnect.map((url) => <link rel="preconnect" href={url} crossorigin={url.startsWith('https://')} />)}
{stylesheets
  .filter((url) => !fontFiles.includes(url))
  .map((url) => <link rel="preload" href={url} as="style" />)}
{fontFiles.map((url) => <link rel="preload" href={url} as="font" type="font/woff2" crossorigin />)}
{scripts.map((url) => <link rel="preload" href={url} as="script" />)}

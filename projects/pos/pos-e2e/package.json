{
  "name": "pos-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Playwright E2E test suite for all POS editions (full, solo, mini, client, cloud)",
  "scripts": {
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:report": "npx playwright show-report",
    "test:e2e:full": "npx playwright test --project=pos-full",
    "test:e2e:solo": "npx playwright test --project=pos-solo",
    "test:e2e:mini": "npx playwright test --project=pos-mini",
    "test:e2e:client": "npx playwright test --project=pos-client",
    "test:e2e:cloud": "npx playwright test --project=pos-cloud",
    "test:api": "npx playwright test tests/api/",
    "test:all": "npx playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}

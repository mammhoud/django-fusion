---
import Layout from '../layouts/Layout.astro';

const resources = [
  { id: 'products', label: 'Products', table: '/htmx/tables/products/', form: '/htmx/forms/product/' },
  { id: 'categories', label: 'Categories', table: '/htmx/tables/categories/', form: '/htmx/forms/category/' },
  { id: 'customers', label: 'Customers', table: '/htmx/tables/customers/', form: '/htmx/forms/customer/' },
  { id: 'client-categories', label: 'Loyalty Tiers', table: '/htmx/tables/client-categories/', form: '/htmx/forms/client-category/' },
  { id: 'sales', label: 'Sales', table: '/htmx/tables/sales/', form: null },
  { id: 'suppliers', label: 'Suppliers', table: '/htmx/tables/suppliers/', form: '/htmx/forms/supplier/' },
];
---

<Layout title="Data — Formint POS">
  <div class="page-shell">
    <section class="hero">
      <p class="eyebrow">Django Ninja · ninja-extra · django-fusion</p>
      <h1>Data components</h1>
      <p class="intro">
        Tables and forms rendered by django-fusion over the merged POS models,
        with a full CRUD REST API served by Django Ninja + ninja-extra.
      </p>
    </section>

    <nav class="resource-nav" aria-label="Data resources">
      {resources.map((r) => (
        <button
          class:list={['chip', { active: r.id === 'products' }]}
          data-resource={r.id}
          data-table={r.table}
          data-form={r.form || ''}
          hx-get={r.table}
          hx-trigger="click"
          hx-target="#formint-table-slot"
          hx-swap="innerHTML"
        >{r.label}</button>
      ))}
    </nav>

    <section class="workspace">
      <div id="formint-form-slot" class="form-card" aria-live="polite"></div>
      <div id="formint-table-slot" class="table-card" aria-live="polite"
           hx-get="/htmx/tables/products/"
           hx-trigger="load"
           hx-headers='{"X-Fusion-Render-First":"true"}'
           hx-swap="innerHTML">
        <div class="skeleton-grid" aria-hidden="true">
          <span class="skeleton skeleton-line"></span>
          <span class="skeleton skeleton-line"></span>
          <span class="skeleton skeleton-line"></span>
        </div>
      </div>
    </section>

    <section class="api-card" aria-label="REST API">
      <div class="section-heading">
        <div>
          <p class="eyebrow">REST API — /api/v1</p>
          <h2>Ninja-extra CRUD controllers</h2>
        </div>
      </div>
      <pre class="api-example"><code>{`GET    /api/v1/products/            list (pagination)
POST   /api/v1/products/            create
GET    /api/v1/products/{id}        find one
PATCH  /api/v1/products/{id}        partial update
DELETE /api/v1/products/{id}        delete
GET    /api/v1/health               system health
GET    /api/v1/stats                KPI counts
GET    /api/v1/docs                 interactive docs`}</code></pre>
      <div class="api-links">
        <a href="/api/v1/docs" target="_blank" rel="noopener" class="btn btn-primary">Open API docs</a>
        <a href="/api/v1/openapi.json" target="_blank" rel="noopener" class="btn btn-ghost">OpenAPI JSON</a>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Resource switcher: change active chip, load its table + form, and keep the
  // form/table slots in sync with the django-fusion HTMX fragments.
  const chips = document.querySelectorAll<HTMLElement>('.resource-nav .chip');
  chips.forEach((chip) => {
    chip.addEventListener('htmx:afterRequest', () => {
      chips.forEach((c) => c.classList.toggle('active', c === chip));
    });
  });

  // After a form saves, refresh the table + clear the form slot.
  document.body.addEventListener('formint-table-refresh', () => {
    const active = document.querySelector<HTMLElement>('.resource-nav .chip.active');
    const tableUrl = active?.dataset.table || '/htmx/tables/products/';
    // htmx.org ships its own minimal global types; cast to access ajax().
    const hx = (window as unknown as { htmx?: { ajax: (m: string, u: string, o: Record<string, string>) => void } }).htmx;
    hx?.ajax('GET', tableUrl, { target: '#formint-table-slot', swap: 'innerHTML' });
    const formSlot = document.querySelector('#formint-form-slot');
    if (formSlot) formSlot.innerHTML = '';
  });
</script>

<style>
  .page-shell { max-width: 72rem; margin: 0 auto; padding: 4rem 1.25rem; }
  .hero { max-width: 48rem; margin-bottom: 2rem; }
  .eyebrow { margin: 0 0 0.5rem; color: #2563eb; font-size: 0.76rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  h1 { margin: 0; color: #111827; font-size: clamp(2rem, 5vw, 3.5rem); letter-spacing: -0.05em; line-height: 1; }
  h2 { margin: 0; color: #111827; font-size: 1.3rem; }
  .intro { max-width: 40rem; margin: 1rem 0 0; color: #475569; line-height: 1.6; }
  .resource-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; }
  .chip { padding: 0.5rem 1rem; font: inherit; font-weight: 600; color: #334155; background: #fff; border: 1px solid #dbe3ef; border-radius: 999px; cursor: pointer; transition: all 0.15s ease; }
  .chip:hover { border-color: #93c5fd; color: #1d4ed8; }
  .chip.active { background: #2563eb; border-color: #2563eb; color: #fff; box-shadow: 0 0.4rem 1rem rgb(37 99 235 / 0.25); }
  .workspace { display: grid; gap: 1.25rem; margin-bottom: 2rem; }
  .form-card, .table-card, .api-card { padding: clamp(1rem, 3vw, 1.75rem); background: #fff; border: 1px solid #dbe3ef; border-radius: 1rem; box-shadow: 0 1rem 2.5rem rgb(15 23 42 / 0.06); }
  .table-card { min-height: 18rem; }
  .api-card { margin-top: 1rem; }
  .section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
  .api-example { margin: 0 0 1rem; padding: 1.25rem; background: #0f172a; color: #a5f3fc; border-radius: 0.75rem; font-size: 0.85rem; line-height: 1.7; overflow-x: auto; }
  .api-links { display: flex; gap: 0.75rem; }
  .btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.6rem 1.1rem; border-radius: 0.6rem; font-weight: 600; text-decoration: none; font-size: 0.9rem; border: 1px solid transparent; cursor: pointer; transition: all 0.15s ease; }
  .btn-primary { background: #2563eb; color: #fff; }
  .btn-primary:hover { background: #1d4ed8; }
  .btn-ghost { background: #fff; color: #334155; border-color: #dbe3ef; }
  .btn-ghost:hover { border-color: #93c5fd; }
  .skeleton-grid { display: grid; gap: 0.75rem; }
  .skeleton-line { display: block; height: 2.75rem; border-radius: 0.6rem; background: linear-gradient(90deg, #eef2f7 25%, #f8fafc 50%, #eef2f7 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; }
  @keyframes shimmer { to { background-position: -200% 0; } }
  @media (prefers-reduced-motion: reduce) { .skeleton-line { animation: none; } }
  @media (max-width: 700px) { .page-shell { padding-top: 2.5rem; } .api-links { flex-direction: column; } }
</style>

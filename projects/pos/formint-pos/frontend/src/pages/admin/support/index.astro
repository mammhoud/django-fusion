---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/ui/Icon.astro';
---

<Layout title="Support - Formint POS">
  <div x-data="supportPage()" x-init="load()" class="max-w-[96rem] mx-auto p-4">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
      <h1 class="flex items-center gap-2 text-lg font-extrabold" style="color: var(--color-text-primary)">
        <Icon name="ticket" class="h-5 w-5" style="color: var(--color-primary)" />
        Support Tickets
      </h1>
      <div class="flex flex-wrap items-center gap-2">
        <input type="search" x-model="search" @input="page=1" placeholder="Search tickets..." class="input flex-1 sm:w-56 text-xs" />
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
      <div class="stat-card"><span class="stat-card__title">Total</span><span class="stat-card__value" x-text="total" style="color: var(--color-primary)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Open</span><span class="stat-card__value" x-text="openCount" style="color: var(--color-warning)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Resolved</span><span class="stat-card__value" x-text="resolvedCount" style="color: var(--color-success)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Closed</span><span class="stat-card__value" x-text="closedCount" style="color: var(--color-text-secondary)">0</span></div>
    </div>
    <div class="flex flex-wrap gap-1 mb-3">
      <template x-for="s in ['All','open','in_progress','resolved','closed']" :key="s">
        <button @click="filterStatus=s==='All'?'':s; page=1" :class="'btn btn-xs '+((filterStatus||'All')===s?'btn-primary':'btn-ghost')" x-text="s==='All'?'All':s.replace('_',' ').replace(/\b\w/g,c=>c.toUpperCase())"></button>
      </template>
    </div>
    <div x-show="loading" class="space-y-2"><template x-for="i in 5" :key="i"><div class="skeleton-shimmer h-10 rounded"></div></template></div>
    <div x-show="!loading && filteredItems.length===0" class="text-center py-12 opacity-50 text-sm">No support tickets.</div>
    <div x-show="!loading && filteredItems.length>0" class="card overflow-x-auto">
      <table class="data-table" role="grid">
        <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Subject</th><th>Status</th><th>Created</th><th class="w-20">Actions</th></tr></thead>
        <tbody>
          <template x-for="item in pagedItems()" :key="item.id">
            <tr class="cursor-pointer hover:bg-[var(--color-surface-hover)]" @click="viewTicket(item)">
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.id"></span></td>
              <td class="px-3 py-2"><span class="text-xs font-medium" x-text="item.name"></span></td>
              <td class="px-3 py-2"><span class="text-xs" x-text="item.email"></span></td>
              <td class="px-3 py-2"><span class="text-xs max-w-[300px] truncate block" x-text="item.subject"></span></td>
              <td class="px-3 py-2">
                <span class="badge"
                  :class="{ 'badge-soft-warning': item.status==='open', 'badge-soft-info': item.status==='in_progress', 'badge-soft-success': item.status==='resolved', 'badge-soft-neutral': item.status==='closed' }"
                  x-text="item.status.replace('_',' ')"></span>
              </td>
              <td class="px-3 py-2"><span class="text-xs opacity-50" x-text="item.created_at?.slice(0,10) || '—'"></span></td>
              <td class="px-3 py-2"><div class="flex gap-1">
                <button @click.stop="viewTicket(item)" class="btn btn-ghost btn-xs px-1.5" title="View" aria-label="View"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-eye" /></svg></button>
                <button @click.stop="confirmDelete(item)" class="btn btn-ghost btn-xs px-1.5" title="Delete" aria-label="Delete"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-trash" /></svg></button>
              </div></td>
            </tr>
          </template>
        </tbody>
      </table>
      <div class="flex items-center justify-between p-3 border-t border-[var(--color-border-subtle)] text-xs">
        <span x-text="'Showing ' + ((page-1)*perPage + 1) + '-' + Math.min(page*perPage, filteredItems.length) + ' of ' + filteredItems.length"></span>
        <div class="flex gap-1">
          <button @click="page=Math.max(1,page-1)" :disabled="page===1" class="btn btn-ghost btn-xs">&larr; Prev</button>
          <button @click="page++" :disabled="page*perPage>=filteredItems.length" class="btn btn-ghost btn-xs">Next &rarr;</button>
        </div>
      </div>
    </div>

    <!-- Ticket Detail Modal -->
    <div x-show="selectedTicket" x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-black/40" @click.self="selectedTicket=null">
      <div class="card max-w-lg mx-4 p-6 space-y-3" @click.stop="">
        <div class="flex justify-between items-center">
          <h2 class="font-semibold" x-text="selectedTicket?.subject"></h2>
          <button @click="selectedTicket=null" class="btn btn-ghost btn-xs" aria-label="Close"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-x" /></svg></button>
        </div>
        <div class="text-xs space-y-1">
          <p><strong>From:</strong> <span x-text="selectedTicket?.name + ' <' + selectedTicket?.email + '>'"></span></p>
          <p><strong>Status:</strong> <span x-text="selectedTicket?.status?.replace('_',' ')"></span></p>
          <p><strong>Created:</strong> <span x-text="selectedTicket?.created_at?.slice(0,16)"></span></p>
        </div>
        <div class="p-3 rounded bg-[var(--color-surface-raised)] text-sm whitespace-pre-wrap" x-text="selectedTicket?.message"></div>
        <div class="flex gap-2 justify-end">
          <button @click="selectedTicket=null" class="btn btn-ghost btn-sm">Close</button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  document.addEventListener('alpine:init', () => {
    Alpine.data('supportPage', () => ({
      items: [], loading: true, search: '', filterStatus: '', page: 1, perPage: 20, selectedTicket: null,
      get total() { return this.items.length; },
      get openCount() { return this.items.filter((i: any) => i.status==='open').length; },
      get resolvedCount() { return this.items.filter((i: any) => i.status==='resolved').length; },
      get closedCount() { return this.items.filter((i: any) => i.status==='closed').length; },
      get filteredItems() { let l = this.items; if (this.search) { const q = this.search.toLowerCase(); l = l.filter((i: any) => Object.values(i).some(v => String(v).toLowerCase().includes(q))); } if (this.filterStatus) l = l.filter((i: any) => i.status===this.filterStatus); return l; },
      pagedItems() { const s = (this.page-1)*this.perPage; return this.filteredItems.slice(s, s+this.perPage); },
      async load() { this.loading=true; try { const r = await fetch('/support-tickets/'); if (r.ok) { const d = await r.json(); this.items = d.data || d || []; } } catch(e){} finally { this.loading=false; } },
      viewTicket(item: any) { this.selectedTicket = item; },
      confirmDelete(item: any) { this.$store.ui.toast('Delete stub', 'info'); },
    }));
  });
</script>

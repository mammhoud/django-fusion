---
import Layout from '../layouts/Layout.astro';
import Skeleton from '../components/ui/Skeleton.astro';
---

<Layout>
  <div class="page-shell">
    <section class="hero" aria-labelledby="page-title">
      <p class="eyebrow">Arabic-first · offline-capable · restaurant-focused</p>
      <h1 id="page-title">Formint POS Professional</h1>
      <p class="intro">
        Phase 1 foundation for branch operations, orders, kitchen coordination, sync, and reports.
      </p>
    </section>

    <section
      id="branch-summary"
      class="data-card"
      data-skeleton-label="Branch summary"
      aria-labelledby="branch-summary-title"
      aria-live="polite"
      hx-get="/htmx/branches/summary/"
      hx-trigger="load"
      hx-headers='{"X-Fusion-Render-First":"true"}'
      hx-target="#branch-summary-content"
      hx-swap="innerHTML"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">Vertical slice</p>
          <h2 id="branch-summary-title">Branch → order → KDS → sync → report</h2>
        </div>
        <span class="status-dot" aria-label="Phase 1 planned"></span>
      </div>

      <div id="branch-summary-content">
        <Skeleton variant="branch-summary" count={3} />
        <p class="sr-only">Loading branch summary…</p>
        <p class="sr-only" data-fusion-note>First request uses django-fusion rendering.</p>
      </div>
    </section>

    <section class="principles" aria-label="Phase 1 principles">
      <article><strong>Astro shell</strong><span>Owns layout, skeleton, retry, and responsive states.</span></article>
      <article><strong>HTMX data</strong><span>Swaps only the target section; never full backend pages.</span></article>
      <article><strong>Django rules</strong><span>Owns validation, permissions, transactions, and audit.</span></article>
    </section>
  </div>
</Layout>

<style>
  .page-shell { max-width: 72rem; margin: 0 auto; padding: 4rem 1.25rem; }
  .hero { max-width: 48rem; margin-bottom: 2rem; }
  .eyebrow { margin: 0 0 0.5rem; color: var(--color-primary); font-size: 0.76rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  h1 { margin: 0; color: var(--color-text-primary); font-size: clamp(2rem, 6vw, 4.5rem); letter-spacing: -0.06em; line-height: 0.98; }
  h2 { margin: 0; color: var(--color-text-primary); font-size: clamp(1rem, 2vw, 1.45rem); }
  .intro { max-width: 38rem; margin: 1rem 0 0; color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.6; }
  .data-card { padding: clamp(1rem, 3vw, 2rem); background: var(--color-surface-card); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-box); box-shadow: var(--shadow-lg); }
  .section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .status-dot { width: 0.7rem; height: 0.7rem; margin-top: 0.35rem; border-radius: 50%; background: var(--color-warning); box-shadow: 0 0 0 0.3rem color-mix(in oklab, var(--color-warning) 30%, transparent); }
  .principles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1rem; }
  .principles article { display: grid; gap: 0.35rem; padding: 1rem; color: var(--color-text-secondary); background: color-mix(in oklab, var(--color-primary) 9%, transparent); border-radius: 0.8rem; line-height: 1.45; }
  .principles strong { color: var(--color-text-primary); }
  @media (max-width: 700px) {
    .page-shell { padding-top: 2.5rem; }
    .principles { grid-template-columns: 1fr; }
  }
</style>

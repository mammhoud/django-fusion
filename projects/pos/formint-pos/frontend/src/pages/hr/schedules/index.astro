---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/ui/Icon.astro';
---

<Layout title="Schedules - Formint POS">
  <div x-data="schedulesPage()" x-init="load()" class="max-w-[96rem] mx-auto p-4">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
      <h1 class="flex items-center gap-2 text-lg font-extrabold" style="color: var(--color-text-primary)">
        <Icon name="calendar-stats" class="h-5 w-5" style="color: var(--color-chart-3)" />
        Schedules
      </h1>
      <div class="flex flex-wrap items-center gap-2">
        <input type="search" x-model="search" @input="page=1" placeholder="Search by employee..." class="input flex-1 sm:w-56 text-xs" />
        <button @click="openAdd()" class="btn btn-primary btn-sm gap-1"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plus" /></svg> Add Shift</button>
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
      <div class="stat-card"><span class="stat-card__title">Shifts</span><span class="stat-card__value" x-text="total" style="color: var(--color-primary)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Scheduled</span><span class="stat-card__value" x-text="scheduledCount" style="color: var(--color-info)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Completed</span><span class="stat-card__value" x-text="completedCount" style="color: var(--color-success)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Today</span><span class="stat-card__value" x-text="todayCount" style="color: var(--color-warning)">0</span></div>
    </div>
    <div class="flex flex-wrap gap-1 mb-3">
      <template x-for="s in ['All','scheduled','confirmed','completed','absent']" :key="s">
        <button @click="filterStatus=s==='All'?'':s; page=1" :class="'btn btn-xs '+((filterStatus||'All')===s?'btn-primary':'btn-ghost')" x-text="s==='All'?'All':s.charAt(0).toUpperCase()+s.slice(1)"></button>
      </template>
    </div>
    <div x-show="loading" class="space-y-2"><template x-for="i in 5" :key="i"><div class="skeleton-shimmer h-10 rounded"></div></template></div>
    <div x-show="!loading && filteredItems.length===0" class="text-center py-12 opacity-50 text-sm">No schedules.</div>
    <div x-show="!loading && filteredItems.length>0" class="card overflow-x-auto">
      <table class="data-table" role="grid">
        <thead><tr><th>ID</th><th>Employee</th><th>Day</th><th>Start</th><th>End</th><th>Status</th><th class="w-20">Actions</th></tr></thead>
        <tbody>
          <template x-for="item in pagedItems()" :key="item.id">
            <tr class="cursor-pointer hover:bg-[var(--color-surface-hover)]">
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.id"></span></td>
              <td class="px-3 py-2"><span class="text-xs font-medium" x-text="item.employee_name || 'Employee #'+item.employee_id"></span></td>
              <td class="px-3 py-2"><span class="text-xs capitalize" x-text="item.day"></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.start_time || '-'" ></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.end_time || '-'" ></span></td>
              <td class="px-3 py-2">
                <span class="badge"
                  :class="{ 'badge-soft-info':item.status==='scheduled', 'badge-soft-warning':item.status==='confirmed', 'badge-soft-success':item.status==='completed', 'badge-soft-error':item.status==='absent' }"
                  x-text="item.status"></span>
              </td>
              <td class="px-3 py-2"><div class="flex gap-1">
                <button @click.stop="openEdit(item)" class="btn btn-ghost btn-xs px-1.5" title="Edit" aria-label="Edit"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-pencil" /></svg></button>
                <button @click.stop="confirmDelete(item)" class="btn btn-ghost btn-xs px-1.5" title="Delete" aria-label="Delete"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-trash" /></svg></button>
              </div></td>
            </tr>
          </template>
        </tbody>
      </table>
      <div class="flex items-center justify-between p-3 border-t border-[var(--color-border-subtle)] text-xs">
        <span x-text="'Showing ' + ((page-1)*perPage + 1) + '-' + Math.min(page*perPage, filteredItems.length) + ' of ' + filteredItems.length"></span>
        <div class="flex gap-1">
          <button @click="page=Math.max(1,page-1)" :disabled="page===1" class="btn btn-ghost btn-xs">&larr; Prev</button>
          <button @click="page++" :disabled="page*perPage>=filteredItems.length" class="btn btn-ghost btn-xs">Next &rarr;</button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  document.addEventListener('alpine:init', () => {
    Alpine.data('schedulesPage', () => ({
      items: [], loading: true, search: '', filterStatus: '', page: 1, perPage: 20,
      get total() { return this.items.length; },
      get scheduledCount() { return this.items.filter((i: any) => i.status==='scheduled').length; },
      get completedCount() { return this.items.filter((i: any) => i.status==='completed').length; },
      get todayCount() { const d = new Date().toLocaleDateString('en-US',{weekday:'long'}).toLowerCase(); return this.items.filter((i: any) => i.day===d).length; },
      get filteredItems() { let l = this.items; if (this.search) { const q = this.search.toLowerCase(); l = l.filter((i: any) => Object.values(i).some(v => String(v).toLowerCase().includes(q))); } if (this.filterStatus) l = l.filter((i: any) => i.status===this.filterStatus); return l; },
      pagedItems() { const s = (this.page-1)*this.perPage; return this.filteredItems.slice(s, s+this.perPage); },
      async load() { this.loading=true; try { const r = await fetch('/employee-schedules/'); if (r.ok) { const d = await r.json(); this.items = d.data || d || []; } } catch(e){} finally { this.loading=false; } },
      openAdd() { this.$store.ui.toast('Add form coming soon', 'info'); },
      openEdit(item: any) { this.$store.ui.toast('Editing shift #' + item.id, 'info'); },
      confirmDelete(item: any) { this.$store.ui.toast('Delete stub', 'info'); },
    }));
  });
</script>

---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/ui/Icon.astro';
---

<Layout title="Employees - Formint POS">
  <div
    x-data="employeesPage()"
    x-init="load()"
    class="max-w-[96rem] mx-auto p-4"
  >
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
      <h1 class="flex items-center gap-2 text-lg font-extrabold" style="color: var(--color-text-primary)">
        <Icon name="users" class="h-5 w-5" style="color: var(--color-chart-3)" />
        Employees
      </h1>
      <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
        <input type="search" x-model="search" @input="page=1"
          placeholder="Search staff..." class="input flex-1 sm:w-56 text-xs" />
        <button @click="openAdd()" class="btn btn-primary btn-sm gap-1"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plus" /></svg> Add Staff</button>
      </div>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
      <div class="stat-card">
        <span class="stat-card__title">Total Staff</span>
        <span class="stat-card__value" x-text="total" style="color: var(--color-primary)">0</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__title">Active</span>
        <span class="stat-card__value" x-text="activeCount" style="color: var(--color-success)">0</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__title">Kitchen</span>
        <span class="stat-card__value" x-text="kitchenCount" style="color: var(--color-warning)">0</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__title">Avg Rate</span>
        <span class="stat-card__value" x-text="'$' + avgRate" style="color: var(--color-info)">$0</span>
      </div>
    </div>

    <!-- Role filter pills -->
    <div class="flex flex-wrap gap-1 mb-3" role="tablist">
      <template x-for="role in ['All','cashier','server','manager','admin','kitchen']" :key="role">
        <button @click="filterRole = role === 'All' ? '' : role; page=1"
          :class="'btn btn-xs ' + ((filterRole || 'All') === role ? 'btn-primary' : 'btn-ghost')"
          x-text="role === 'All' ? 'All Roles' : role.charAt(0).toUpperCase() + role.slice(1)">
        </button>
      </template>
    </div>

    <!-- Loading skeleton -->
    <div x-show="loading" class="space-y-2">
      <template x-for="i in 5" :key="i">
        <div class="skeleton-shimmer h-10 rounded" aria-hidden="true"></div>
      </template>
    </div>

    <!-- Empty state -->
    <div x-show="!loading && filteredItems.length === 0" class="text-center py-12 opacity-50 text-sm">
      No employees found. <span x-show="search">Try a different search.</span>
    </div>

    <!-- Table -->
    <div x-show="!loading && filteredItems.length > 0" class="card overflow-x-auto">
      <table class="data-table" role="grid">
        <thead>
          <tr>
            <th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>PIN</th><th>Rate/hr</th><th>Status</th><th class="w-20">Actions</th>
          </tr>
        </thead>
        <tbody>
          <template x-for="item in pagedItems()" :key="item.id">
            <tr class="cursor-pointer hover:bg-[var(--color-surface-hover)]" @click="openEdit(item)">
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.id"></span></td>
              <td class="px-3 py-2"><span class="text-xs font-medium" x-text="item.first_name + ' ' + item.last_name"></span></td>
              <td class="px-3 py-2"><span class="text-xs" x-text="item.email || '-'" ></span></td>
              <td class="px-3 py-2">
                <span class="badge" :class="{ 'badge-soft-success': item.role==='admin', 'badge-soft-info': item.role==='manager', 'badge-soft-neutral': item.role==='cashier', 'badge-soft-warning': item.role==='server', 'badge-soft-accent': item.role==='kitchen' }" x-text="item.role"></span>
              </td>
              <td class="px-3 py-2"><span class="text-xs font-mono" x-text="item.pin_code || '---'"></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="'$' + (Number(item.hourly_rate) || 0).toFixed(2)"></span></td>
              <td class="px-3 py-2">
                <span class="badge" :class="item.is_active ? 'badge-soft-success' : 'badge-soft-error'" x-text="item.is_active ? 'Active' : 'Inactive'"></span>
              </td>
              <td class="px-3 py-2">
                <div class="flex gap-1">
                  <button @click.stop="openEdit(item)" class="btn btn-ghost btn-xs px-1.5" title="Edit" aria-label="Edit"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-pencil" /></svg></button>
                  <button @click.stop="confirmDelete(item)" class="btn btn-ghost btn-xs px-1.5" title="Delete" aria-label="Delete"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-trash" /></svg></button>
                </div>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
      <div class="flex items-center justify-between p-3 border-t border-[var(--color-border-subtle)] text-xs">
        <span x-text="'Showing ' + ((page-1)*perPage + 1) + '-' + Math.min(page*perPage, filteredItems.length) + ' of ' + filteredItems.length"></span>
        <div class="flex gap-1">
          <button @click="page = Math.max(1, page-1)" :disabled="page === 1" class="btn btn-ghost btn-xs">&larr; Prev</button>
          <button @click="page++" :disabled="page * perPage >= filteredItems.length" class="btn btn-ghost btn-xs">Next &rarr;</button>
        </div>
      </div>
    </div>

    <!-- Delete Modal -->
    <div x-show="deleteTarget" x-transition.opacity
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/40"
      @click.self="deleteTarget = null">
      <div class="card max-w-sm mx-4 p-6 text-center space-y-4">
        <p class="font-semibold">Remove this employee?</p>
        <p class="text-sm opacity-60" x-text="deleteTarget?.first_name + ' ' + deleteTarget?.last_name"></p>
        <div class="flex gap-2 justify-center">
          <button @click="deleteTarget = null" class="btn btn-ghost btn-sm">Cancel</button>
          <button @click="doDelete()" class="btn btn-error btn-sm">Remove</button>
        </div>
      </div>
    </div>

    <!-- Add/Edit Form Modal -->
    <div
      x-show="formOpen"
      x-transition.opacity.duration.200ms
      class="fixed inset-0 z-[60] flex items-start justify-center pt-[8vh] bg-black/50 px-4 overflow-y-auto"
      @click.self="closeForm()"
      @keydown.escape.window="closeForm()"
    >
      <div
        class="card w-full max-w-xl p-6 space-y-5 shadow-2xl"
        x-transition.scale.90.duration.200ms
        @click.stop
      >
        <div class="flex items-center justify-between">
          <h2 class="text-base font-bold" x-text="editingItem ? 'Edit Employee' : 'New Employee'"></h2>
          <button @click="closeForm()" class="btn btn-ghost btn-sm" aria-label="Close"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-x" /></svg></button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- First Name -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">First Name *</label>
            <input type="text" x-model="form.first_name" class="input w-full" placeholder="e.g. Jane" required />
          </div>
          <!-- Last Name -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Last Name *</label>
            <input type="text" x-model="form.last_name" class="input w-full" placeholder="e.g. Smith" required />
          </div>
          <!-- Email -->
          <div class="sm:col-span-2">
            <label class="text-xs font-medium opacity-70 mb-1 block">Email</label>
            <input type="email" x-model="form.email" class="input w-full" placeholder="jane@example.com" />
          </div>
          <!-- Phone -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Phone</label>
            <input type="tel" x-model="form.phone" class="input w-full" placeholder="+1 555-0000" />
          </div>
          <!-- Role -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Role *</label>
            <select x-model="form.role" class="input w-full" required>
              <option value="cashier">Cashier</option>
              <option value="server">Server</option>
              <option value="manager">Manager</option>
              <option value="admin">Administrator</option>
              <option value="kitchen">Kitchen Staff</option>
            </select>
          </div>
          <!-- PIN Code -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">PIN Code</label>
            <input type="text" x-model="form.pin_code" class="input w-full font-mono" placeholder="e.g. 1234" maxlength="6" />
          </div>
          <!-- Hourly Rate -->
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Hourly Rate ($)</label>
            <input type="number" x-model="form.hourly_rate" class="input w-full" step="0.01" min="0" placeholder="0.00" />
          </div>
          <!-- Active toggle -->
          <div class="sm:col-span-2 flex items-center gap-3">
            <label class="text-xs font-medium opacity-70">Active</label>
            <button type="button" @click="form.is_active = !form.is_active" :class="form.is_active && 'switch--on'" class="switch" role="switch" :aria-checked="form.is_active"><span class="switch__knob"></span></button>
            <span class="text-xs opacity-60" x-text="form.is_active ? 'Yes' : 'No'"></span>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex gap-2 justify-end pt-2 border-t border-[var(--color-border-subtle)]">
          <button @click="closeForm()" class="btn btn-ghost btn-sm" :disabled="formSaving">Cancel</button>
          <button @click="doSave()" class="btn btn-primary btn-sm gap-1" :disabled="formSaving">
            <span x-show="formSaving" class="inline-block h-3 w-3 animate-spin rounded-full border-2 border-current border-t-transparent"></span>
            <span x-text="editingItem ? 'Update' : 'Create'"></span>
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  document.addEventListener('alpine:init', () => {
    Alpine.data('employeesPage', () => ({
      items: [], loading: true, search: '', filterRole: '', page: 1, perPage: 20,
      deleteTarget: null,
      formOpen: false, formSaving: false, editingItem: null,
      form: {
        first_name: '', last_name: '', email: '', phone: '',
        role: 'cashier', pin_code: '', hourly_rate: '0', is_active: true,
      },

      get total() { return this.items.length; },
      get activeCount() { return this.items.filter((i: any) => i.is_active).length; },
      get kitchenCount() { return this.items.filter((i: any) => i.role === 'kitchen').length; },
      get avgRate() {
        const active = this.items.filter((i: any) => i.is_active && i.hourly_rate);
        if (!active.length) return '0.00';
        return (active.reduce((s: number, i: any) => s + Number(i.hourly_rate), 0) / active.length).toFixed(2);
      },
      get filteredItems() {
        let list = this.items;
        if (this.search) {
          const q = this.search.toLowerCase();
          list = list.filter((i: any) => Object.values(i).some(v => String(v).toLowerCase().includes(q)));
        }
        if (this.filterRole) list = list.filter((i: any) => i.role === this.filterRole);
        return list;
      },
      pagedItems() {
        const start = (this.page - 1) * this.perPage;
        return this.filteredItems.slice(start, start + this.perPage);
      },
      async load() {
        this.loading = true;
        try {
          const res = await fetch('/employees/');
          if (res.ok) { const d = await res.json(); this.items = d.data || d || []; }
        } catch (e) { console.error(e); }
        finally { this.loading = false; }
      },

      resetForm() {
        this.form = {
          first_name: '', last_name: '', email: '', phone: '',
          role: 'cashier', pin_code: '', hourly_rate: '0', is_active: true,
        };
        this.editingItem = null;
      },

      openAdd() {
        this.resetForm();
        this.formOpen = true;
      },

      openEdit(item: any) {
        this.resetForm();
        this.editingItem = item;
        this.form = {
          first_name: item.first_name || '',
          last_name: item.last_name || '',
          email: item.email || '',
          phone: item.phone || '',
          role: item.role || 'cashier',
          pin_code: item.pin_code || '',
          hourly_rate: item.hourly_rate ?? '0',
          is_active: item.is_active !== false,
        };
        this.formOpen = true;
      },

      closeForm() {
        if (this.formSaving) return;
        this.formOpen = false;
        this.resetForm();
      },

      async doSave() {
        if (!this.form.first_name || !this.form.last_name) {
          this.$store.ui.toast('First and last name are required', 'error');
          return;
        }
        this.formSaving = true;
        const payload = {
          first_name: this.form.first_name,
          last_name: this.form.last_name,
          email: this.form.email || null,
          phone: this.form.phone,
          role: this.form.role,
          pin_code: this.form.pin_code,
          hourly_rate: parseFloat(String(this.form.hourly_rate)) || 0,
          is_active: this.form.is_active,
        };

        try {
          let res;
          if (this.editingItem) {
            res = await fetch('/employees/' + this.editingItem.id + '/', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
          } else {
            res = await fetch('/employees/', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
          }
          if (res.ok) {
            this.$store.ui.toast(this.editingItem ? 'Employee updated' : 'Employee added', 'success');
            this.closeForm();
            await this.load();
          } else {
            const err = await res.text();
            this.$store.ui.toast('Save failed: ' + (err || res.status), 'error');
          }
        } catch (e) {
          this.$store.ui.toast('Network error', 'error');
        } finally {
          this.formSaving = false;
        }
      },

      confirmDelete(item: any) { this.deleteTarget = item; },
      async doDelete() {
        if (!this.deleteTarget) return;
        const id = this.deleteTarget.id; this.deleteTarget = null;
        try {
          await fetch('/employees/' + id + '/', { method: 'DELETE' });
          this.items = this.items.filter((i: any) => i.id !== id);
          this.$store.ui.toast('Removed', 'success');
        } catch (e) { this.$store.ui.toast('Failed', 'error'); }
      },
    }));
  });
</script>

---
import Layout from '../layouts/Layout.astro';
import Skeleton from '../components/ui/Skeleton.astro';
---

<Layout title="Fusion — Formint POS">
  <div class="page-shell">
    <section class="hero">
      <p class="eyebrow">django-fusion · PageHandler · FusionDecoder</p>
      <h1>Fusion render contract</h1>
      <p class="intro">
        Two sides of the same contract: the <strong>server-rendered page</strong>
        (django-fusion <code>PageHandler</code> — full layout for browsers, lean
        fragment for HTMX) and the <strong>encoded fragment pointer</strong>
        (<code>FusionCodec</code> on Django ↔ <code>FusionDecoder</code> in the
        browser).
      </p>
    </section>

    <!-- 1. PageHandler full page → HTMX fragment swap -->
    <section class="card" aria-labelledby="page-handler-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">/fusion/page/ · PageHandler</p>
          <h2 id="page-handler-title">Server-rendered page</h2>
        </div>
        <button
          type="button"
          class="btn btn-primary btn-sm"
          id="reload-page"
          hx-get="/fusion/page/"
          hx-trigger="click"
          hx-target="#page-handler-content"
          hx-swap="innerHTML"
        >Reload fragment</button>
      </div>

      <div
        id="page-handler-content"
        class="page-handler-content"
        data-skeleton-label="Server page"
        aria-live="polite"
        hx-get="/fusion/page/"
        hx-trigger="load"
        hx-swap="innerHTML"
      >
        <Skeleton variant="branch-summary" count={3} />
        <p class="sr-only">Loading the PageHandler fragment…</p>
      </div>

      <p class="note">
        The browser request sends <code>HX-Request</code>, so django-fusion
        resolves the fragment strategy and serves
        <code>formint/fragments/page.html</code> — the same content an Astro
        shell swaps in without ever leaving the SPA.
      </p>
    </section>

    <!-- 2. FusionDecoder pointer round-trip -->
    <section class="card" aria-labelledby="pointer-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">/fusion/pointer/ · FusionDecoder</p>
          <h2 id="pointer-title">Encoded fragment pointer</h2>
        </div>
        <button type="button" class="btn btn-ghost btn-sm" id="toggle-mode">
          Toggle session mode
        </button>
      </div>

      <dl class="pointer-grid" id="pointer-grid">
        <div><dt>Encoded</dt><dd class="mono" data-field="encoded">—</dd></div>
        <div><dt>Decoded component</dt><dd class="mono" data-field="component">—</dd></div>
        <div><dt>Pointer render-first</dt><dd data-field="pointer-mode">—</dd></div>
        <div><dt>Session preference</dt><dd data-field="session">—</dd></div>
        <div><dt>Effective strategy</dt><dd data-field="strategy">—</dd></div>
      </dl>
      <div class="toggle-row">
        <label class="toggle" for="session-toggle">
          <input type="checkbox" id="session-toggle" />
          <span class="toggle-track" aria-hidden="true"></span>
          <span class="toggle-label">Persist preference in Django session</span>
        </label>
        <button type="button" class="btn btn-ghost btn-sm" id="reset-mode">Reset to default</button>
      </div>
      <p class="note">
        The toggle writes <code>fusion_render_first</code> into the Django
        session via <code>FusionSessionChecker</code>
        (<code>POST /fusion/session-mode/</code>, cleared with
        <code>DELETE</code>) — the same value the Astro shell caches in
        <code>sessionStorage</code> so <code>FusionDecoder.decode()</code>
        and the server agree on the effective strategy
        (header → session → default precedence).
      </p>
    </section>
  </div>
</Layout>

<script>
  import { fusionDecoder, FusionDecodeError } from '../lib/fusion-decoder';

  type PointerBody = {
    encoded: string;
    decoded: { component: string; fusion_render_first: boolean; htmx?: boolean };
    fusion_render_first: boolean;
  };

  function field(name: string): HTMLElement | null {
    return document.querySelector(`[data-field="${name}"]`);
  }

  function renderStrategy(pointerMode: boolean, session: boolean | undefined): void {
    const el = field('strategy');
    if (!el) return;
    const strategy =
      session !== undefined
        ? session
          ? 'fusion-render (session)'
          : 'data-api (session)'
        : pointerMode
          ? 'fusion-render (pointer)'
          : 'data-api (pointer)';
    el.textContent = strategy;
    el.classList.toggle('ok', strategy.startsWith('fusion-render'));
  }

  /** Sync the toggle checkbox with the current session preference. */
  function syncToggle(session: boolean | undefined): void {
    const input = document.getElementById('session-toggle') as HTMLInputElement | null;
    if (!input) return;
    input.checked = session === true;
    input.indeterminate = session === undefined;
  }

  async function loadPointer(): Promise<void> {
    const status = field('encoded');
    if (!status) return;
    try {
      const res = await fetch('/fusion/pointer/', { headers: { 'Accept': 'application/json' } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const body = (await res.json()) as PointerBody;

      const pointer = fusionDecoder.decodeFragmentPointer(body.encoded);
      const session = fusionDecoder.getSessionPreference();

      field('encoded')!.textContent = body.encoded.slice(0, 48) + '…';
      field('encoded')!.title = body.encoded;
      field('component')!.textContent = pointer.component;
      field('pointer-mode')!.textContent = pointer.fusion_render_first ? 'true' : 'false';
      field('session')!.textContent =
        session === undefined ? 'unset' : String(session);
      renderStrategy(pointer.fusion_render_first, session);
      syncToggle(session);
    } catch (err) {
      const msg = err instanceof FusionDecodeError ? err.message : String(err);
      field('encoded')!.textContent = `error: ${msg}`;
    }
  }

  /** Seed sessionStorage from the server preference (other tabs/browsers). */
  async function seedSessionFromServer(): Promise<void> {
    try {
      const res = await fetch('/fusion/session-mode/', {
        headers: { 'Accept': 'application/json' },
      });
      if (!res.ok) return;
      const body = (await res.json()) as {
        session_preference: boolean | null;
      };
      if (body.session_preference !== null) {
        fusionDecoder.initSession(body.session_preference);
      }
    } catch {
      /* ignore — sessionStorage stays authoritative on failure */
    }
  }

  /** Persist the preference in the Django session via FusionSessionChecker. */
  async function persistSessionPreference(value: boolean): Promise<boolean> {
    try {
      const res = await fetch('/fusion/session-mode/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fusion_render_first: value }),
      });
      return res.ok;
    } catch {
      return false;
    }
  }

  async function clearSessionPreference(): Promise<boolean> {
    try {
      const res = await fetch('/fusion/session-mode/', { method: 'DELETE' });
      return res.ok;
    } catch {
      return false;
    }
  }

  // Session-mode toggle → writes the preference server-side via
  // FusionSessionChecker and mirrors it in sessionStorage, then refreshes.
  const toggleInput = document.getElementById('session-toggle') as HTMLInputElement | null;
  toggleInput?.addEventListener('change', async () => {
    const next = toggleInput.checked;
    const ok = await persistSessionPreference(next);
    if (ok) {
      fusionDecoder.initSession(next);
      loadPointer();
    } else {
      toggleInput.checked = !next;
    }
  });

  const resetButton = document.getElementById('reset-mode');
  resetButton?.addEventListener('click', async () => {
    const ok = await clearSessionPreference();
    if (ok) {
      fusionDecoder.clearSession();
      loadPointer();
    }
  });

  await seedSessionFromServer();
  loadPointer();
</script>

<style>
  .page-shell { max-width: 72rem; margin: 0 auto; padding: 4rem 1.25rem; }
  .hero { max-width: 52rem; margin-bottom: 2rem; }
  .eyebrow { margin: 0 0 0.5rem; color: #2563eb; font-size: 0.76rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  h1 { margin: 0; color: #111827; font-size: clamp(2rem, 5vw, 3.5rem); letter-spacing: -0.05em; line-height: 1; }
  h2 { margin: 0; color: #111827; font-size: 1.3rem; }
  .intro { max-width: 42rem; margin: 1rem 0 0; color: #475569; font-size: 1.05rem; line-height: 1.6; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9em; background: #eef2ff; border-radius: 0.3rem; padding: 0.1rem 0.35rem; }
  .card { padding: clamp(1rem, 3vw, 1.75rem); background: #fff; border: 1px solid #dbe3ef; border-radius: 1rem; box-shadow: 0 1rem 2.5rem rgb(15 23 42 / 0.06); margin-bottom: 1.5rem; }
  .section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
  .page-handler-content { min-height: 10rem; }
  .note { margin: 1rem 0 0; color: #64748b; font-size: 0.85rem; line-height: 1.55; }
  .pointer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 0.75rem; margin: 0; }
  .pointer-grid div { padding: 0.9rem 1rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.7rem; }
  .pointer-grid dt { margin: 0 0 0.3rem; color: #64748b; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  .pointer-grid dd { margin: 0; color: #0f172a; font-size: 0.9rem; font-weight: 600; overflow-wrap: anywhere; }
  .pointer-grid dd.ok { color: #059669; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.78rem !important; }
  .btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.6rem 1.1rem; border-radius: 0.6rem; font-weight: 600; text-decoration: none; font-size: 0.9rem; border: 1px solid transparent; cursor: pointer; transition: all 0.15s ease; }
  .btn-primary { background: #2563eb; color: #fff; }
  .btn-primary:hover { background: #1d4ed8; }
  .btn-ghost { background: #fff; color: #334155; border-color: #dbe3ef; }
  .btn-ghost:hover { border-color: #93c5fd; }
  .btn-sm { padding: 0.4rem 0.85rem; font-size: 0.82rem; }
  .toggle-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.25rem; flex-wrap: wrap; }
  .toggle { display: inline-flex; align-items: center; gap: 0.6rem; cursor: pointer; font-size: 0.88rem; font-weight: 600; color: #334155; }
  .toggle input { position: absolute; opacity: 0; pointer-events: none; }
  .toggle-track {
    position: relative;
    width: 2.6rem; height: 1.45rem; flex: none;
    background: #cbd5e1; border-radius: 999px;
    transition: background 0.18s ease;
  }
  .toggle-track::after {
    content: '';
    position: absolute;
    top: 0.18rem; left: 0.18rem;
    width: 1.1rem; height: 1.1rem;
    background: #fff; border-radius: 50%;
    box-shadow: 0 1px 3px rgb(15 23 42 / 0.25);
    transition: transform 0.18s ease;
  }
  .toggle input:checked + .toggle-track { background: #2563eb; }
  .toggle input:checked + .toggle-track::after { transform: translateX(1.15rem); }
  .toggle input:indeterminate + .toggle-track::after {
    left: 0.75rem;
    width: 1.1rem;
    background: #94a3b8;
  }
  .toggle input:focus-visible + .toggle-track { outline: 2px solid #93c5fd; outline-offset: 2px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 700px) {
    .page-shell { padding-top: 2.5rem; }
    .section-heading { flex-direction: column; }
  }
</style>

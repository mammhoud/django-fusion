---
// Formint POS - Icon component (references the Tabler sprite included in Layout).
// Usage (static chrome): <Icon name="cart" size={16} class="..." style="color: ..." />
// Usage (Alpine x-for templates): inline <svg><use :href="'#i-' + name" /></svg>
interface Props {
  name: string;
  size?: number;
  class?: string;
  style?: string;
  'aria-label'?: string;
}

const { name, size = 16, class: cls = '', style, 'aria-label': ariaLabel } = Astro.props;
const labelled = ariaLabel ? ariaLabel : undefined;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  style={style}
  aria-hidden={labelled ? 'false' : 'true'}
  aria-label={labelled}
  focusable="false"
>
  <use href={`#i-${name}`} />
</svg>

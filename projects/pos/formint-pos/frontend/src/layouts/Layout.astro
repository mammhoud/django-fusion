---
interface Props {
  title?: string;
}

const { title = 'Formint POS Professional' } = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Formint POS Professional restaurant operations shell" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand" aria-label="Formint POS home">Formint POS</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/">Home</a>
        <a href="/data/">Data</a>
      </nav>
      <span class="edition-badge">Professional · Phase 2</span>
    </header>

    <main>
      <slot />
    </main>

    <div id="htmx-global-status" class="sr-only" role="status" aria-live="polite"></div>

    <!-- Global HTMX indicator (landing-fusion port) — shown by htmx-bootstrap.ts -->
    <div id="htmx-global-indicator" class="htmx-indicator" role="status" aria-live="polite" aria-hidden="true">
      <div class="htmx-indicator__inner">
        <span class="htmx-indicator__spinner" aria-hidden="true"></span>
        <div class="htmx-indicator__text">
          <strong id="htmx-indicator-target">Loading data…</strong>
          <span id="htmx-indicator-hint">Fetching from the sidecar…</span>
        </div>
      </div>
    </div>

    <script>
      import '../lib/htmx-bootstrap';
    </script>
  </body>
</html>

<style>
  :global(:root) {
    color-scheme: light;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    background: #f8fafc;
    color: #172033;
  }

  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; min-width: 320px; }
  :global(a) { color: inherit; }
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 0 1.25rem;
    background: #fff;
    border-bottom: 1px solid #dbe3ef;
  }
  .brand { font-weight: 800; text-decoration: none; letter-spacing: -0.02em; }
  .site-nav { display: flex; gap: 1rem; }
  .site-nav a { color: #475569; font-size: 0.9rem; font-weight: 600; text-decoration: none; transition: color 0.15s ease; }
  .site-nav a:hover { color: #2563eb; }
  .edition-badge { color: #475569; font-size: 0.8rem; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Global HTMX indicator ─────────────────────────────────────────── */
  .htmx-indicator {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    opacity: 0;
    transform: translateY(0.75rem);
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .htmx-indicator.htmx-request {
    opacity: 1;
    transform: translateY(0);
  }
  .htmx-indicator__inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: #0f172a;
    color: #e2e8f0;
    border: 1px solid #1e293b;
    border-radius: 0.8rem;
    box-shadow: 0 1rem 2.5rem rgb(15 23 42 / 0.35);
  }
  .htmx-indicator__spinner {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    border: 2px solid rgb(148 163 184 / 0.35);
    border-top-color: #60a5fa;
    border-radius: 50%;
    animation: fusion-spin 0.8s linear infinite;
  }
  .htmx-indicator__text { display: grid; gap: 0.15rem; }
  .htmx-indicator__text strong { font-size: 0.85rem; font-weight: 650; }
  .htmx-indicator__text span { font-size: 0.75rem; color: #94a3b8; }
  .htmx-indicator__pulse {
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    margin-right: 0.35rem;
    border-radius: 50%;
    background: #f59e0b;
    animation: fusion-pulse 1s ease-in-out infinite;
  }
  .htmx-indicator__pulse--slow { background: #f97316; }

  @keyframes fusion-spin { to { transform: rotate(360deg); } }
  @keyframes fusion-pulse { 50% { opacity: 0.35; } }

  /* ── Skeleton loading (default content-on-the-way state) ───────────── */
  /* Shimmer blocks that mirror the final layout, so regions never flash
     empty while an HTMX fragment is in flight. */
  .fusion-skeleton {
    display: inline-flex;
    flex-direction: column;
    gap: 0.6rem;
    width: 100%;
  }
  .fusion-skeleton__line {
    display: block;
    height: 0.9rem;
    border-radius: 0.25rem;
    background: linear-gradient(90deg, #eef2f7 25%, #f8fafc 50%, #eef2f7 75%);
    background-size: 200% 100%;
    animation: fusion-shimmer 1.4s ease-in-out infinite;
  }
  .fusion-skeleton__line--tag { height: 0.65rem; width: 7rem; margin-bottom: 0.4rem; }
  .fusion-skeleton__line--title { height: 1.6rem; width: min(24rem, 65%); margin-bottom: 0.4rem; }
  .fusion-skeleton__line--btn { height: 2.5rem; border-radius: 0.375rem; }
  .fusion-skeleton__line--stat-value { height: 2rem; width: 5rem; margin-bottom: 0.4rem; }

  /* KPI grid */
  .fusion-skeleton--kpi__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 0.75rem; }
  .fusion-skeleton__kpi-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 0.8rem;
  }

  /* Data table */
  .fusion-skeleton--table { gap: 0.75rem; }
  .fusion-skeleton__table-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.5rem; }
  .fusion-skeleton__table-row {
    display: block;
    height: 2.4rem;
    border-radius: 0.5rem;
    background: linear-gradient(90deg, #eef2f7 25%, #f8fafc 50%, #eef2f7 75%);
    background-size: 200% 100%;
    animation: fusion-shimmer 1.4s ease-in-out infinite;
  }
  .fusion-skeleton__table-pager { display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.75rem; }

  /* Form */
  .fusion-skeleton--form__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0.9rem; }
  .fusion-skeleton__field { display: flex; flex-direction: column; gap: 0.4rem; }

  /* Branch summary */
  .fusion-skeleton--branch { gap: 0.5rem; }
  .fusion-skeleton--branch__stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.75rem; margin-top: 1rem; }
  .fusion-skeleton__stat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.9rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
  }

  /* Nav bar */
  .fusion-skeleton--nav { width: 100%; }
  .fusion-skeleton--nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.25rem;
    background: #fff;
    border-bottom: 1px solid #dbe3ef;
  }
  .fusion-skeleton--nav__brand { width: 8rem; height: 1.4rem; }
  .fusion-skeleton--nav__links { display: flex; gap: 1rem; }
  .fusion-skeleton--nav__link { width: 4.5rem; height: 0.9rem; }
  .fusion-skeleton--nav__cta { width: 7rem; height: 2.2rem; }

  /* Full-page loader */
  .fusion-skeleton--page-loader {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: rgb(248 250 252 / 0.92);
    backdrop-filter: blur(4px);
  }
  .fusion-skeleton--page-loader__logo { display: flex; justify-content: center; }
  .fusion-skeleton--page-loader__dots { display: flex; gap: 0.4rem; margin-top: 0.6rem; }
  .fusion-skeleton--page-loader__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #2563eb;
    animation: fusion-blink 1.2s ease-in-out infinite;
  }
  .fusion-skeleton--page-loader__dot:nth-child(2) { animation-delay: 0.15s; }
  .fusion-skeleton--page-loader__dot:nth-child(3) { animation-delay: 0.3s; }
  .fusion-skeleton--page-loader__label { margin: 0.4rem 0 0; color: #475569; font-size: 0.85rem; font-weight: 600; }

  @keyframes fusion-shimmer { to { background-position: -200% 0; } }
  @keyframes fusion-blink { 50% { opacity: 0.3; } }

  @media (max-width: 700px) {
    .site-header { align-items: flex-start; flex-direction: column; padding-block: 0.8rem; }
    .fusion-skeleton--kpi__grid, .fusion-skeleton--branch__stats,
    .fusion-skeleton--form__grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fusion-skeleton__line, .fusion-skeleton__table-row,
    .fusion-skeleton__line--tag, .fusion-skeleton__line--title,
    .fusion-skeleton__line--btn, .fusion-skeleton__line--stat-value,
    .htmx-indicator__spinner, .htmx-indicator__pulse,
    .fusion-skeleton--page-loader__dot { animation: none !important; }
  }
</style>

---
interface Props {
  title?: string;
}

const { title = 'Formint POS Professional' } = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Formint POS Professional restaurant operations shell" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand" aria-label="Formint POS home">Formint POS</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/">Home</a>
        <a href="/data/">Data</a>
      </nav>
      <span class="edition-badge">Professional · Phase 2</span>
    </header>

    <main>
      <slot />
    </main>

    <div id="htmx-global-status" class="sr-only" role="status" aria-live="polite"></div>

    <script>
      import htmx from 'htmx.org';

      window.htmx = htmx;
      const status = document.querySelector('#htmx-global-status');
      let requests = 0;

      document.body.addEventListener('htmx:beforeRequest', () => {
        requests += 1;
        if (status) status.textContent = 'Loading Formint data…';
      });

      document.body.addEventListener('htmx:afterRequest', () => {
        requests = Math.max(0, requests - 1);
        if (requests === 0 && status) status.textContent = 'Formint data updated.';
      });

      document.body.addEventListener('htmx:responseError', () => {
        requests = 0;
        if (status) status.textContent = 'Unable to load data. Retry the section.';
      });
    </script>
  </body>
</html>

<style>
  :global(:root) {
    color-scheme: light;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    background: #f8fafc;
    color: #172033;
  }

  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; min-width: 320px; }
  :global(a) { color: inherit; }
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 0 1.25rem;
    background: #fff;
    border-bottom: 1px solid #dbe3ef;
  }
  .brand { font-weight: 800; text-decoration: none; letter-spacing: -0.02em; }
  .site-nav { display: flex; gap: 1rem; }
  .site-nav a { color: #475569; font-size: 0.9rem; font-weight: 600; text-decoration: none; transition: color 0.15s ease; }
  .site-nav a:hover { color: #2563eb; }
  .edition-badge { color: #475569; font-size: 0.8rem; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

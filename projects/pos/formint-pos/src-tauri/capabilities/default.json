{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Formint POS main window capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-is-maximized",
    "core:window:allow-maximize",
    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-execute",
    "opener:default",
    "dialog:default",
    "fs:default"
  ]
}

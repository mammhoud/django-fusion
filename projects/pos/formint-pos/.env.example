# =============================================================================
# Formint POS — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in your values (`.env` is git-ignored).
#
# The backend reads these directly from the process environment:
#   cp .env.example .env && set -a && . ./.env && set +a
#   (or export them in your shell / service manager)

# ── Django ───────────────────────────────────────────────────────────────────
# Production must set a strong secret key and DEBUG=false.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1

# ── Admin superuser (used by `python manage.py --ensure-superuser`) ────────
# WARNING: when DJANGO_DEBUG=0 the default password (admin123) is REFUSED —
# you MUST set a strong FORMINT_ADMIN_PASSWORD for any deployment.
FORMINT_ADMIN_EMAIL=admin@formint.local
FORMINT_ADMIN_PASSWORD=admin123
FORMINT_ADMIN_NAME=Formint Admin

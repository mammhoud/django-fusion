# Tinker Configuration (.env)
# ============================================================
# Copy to .env and fill in production secrets
# This file is gitignored and never committed
#
# See: configs/settings.yml for all available settings
#
# Precedence:
#   1. Environment variables (.env file)
#   2. settings.{ENV}.yml (environment overrides)
#   3. settings.yml (defaults)

# ============================================================
# Environment Detection
# ============================================================
# Options: development, staging, production
TINKER_ENV=development

# ============================================================
# Django Settings
# ============================================================
TINKER_SECRET_KEY=django-insecure-change-this-in-production
TINKER_DEBUG=true
TINKER_ALLOWED_HOSTS=localhost,127.0.0.1,cypercloud.localhost

# ============================================================
# Database
# ============================================================
# SQLite (default, no config needed)
# To use PostgreSQL, uncomment and fill these:
# DB_ENGINE=django.db.backends.postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tinker_db
# DB_USER=tinker_user
# DB_PASSWORD=your-secure-password

# ============================================================
# Email (Production)
# ============================================================
# For development, console backend is used (emails print to console)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production, use SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@cypercloud.local

# ============================================================
# AI Models - Ollama (Local)
# ============================================================
# Base URL for Ollama API
OLLAMA_BASE_URL=http://localhost:11434
# Model identifier
OLLAMA_MODEL=gemma3:4b

# ============================================================
# AI Models - OpenAI Compatible APIs (Cloud)
# ============================================================
# Anthropic Claude
# ANTHROPIC_API_URL=https://api.anthropic.com/v1
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# OpenAI GPT
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-api-key-here

# DeepSeek
# DEEPSEEK_API_URL=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY=your-api-key-here

# ============================================================
# Template Sites Paths
# ============================================================
# Override default paths if needed
# TINKER_CTC_TEMPLATES=../ctc-research/templates
# TINKER_LMS_TEMPLATES=../lms/templates
# TINKER_VRESUME_TEMPLATES=../VResume/www/pages/templates

# ============================================================
# Ceptor-AI Configuration
# ============================================================
# Path to agents directory
# CEPTOR_AI_AGENTS_DIR=../../.kilo/agent/
# Path to models file
# CEPTOR_AI_MODELS_FILE=../../.kilo/models.yml

# ============================================================
# Gunicorn Configuration (Production)
# ============================================================
TINKER_WORKERS=2

# ============================================================
# Security (Production)
# ============================================================
# CSRF_COOKIE_SECURE=true
# SESSION_COOKIE_SECURE=true
# SECURE_SSL_REDIRECT=true

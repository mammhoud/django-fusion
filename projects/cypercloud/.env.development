# Tinker Development Environment (.env.development)
# ============================================================
# Development-specific configuration
# Loaded automatically when TINKER_ENV=development
# See settings.development.yml for environment-specific Django overrides

TINKER_ENV=development
TINKER_DEBUG=true
TINKER_SECRET_KEY=django-insecure-cypercloud-development-only
TINKER_ALLOWED_HOSTS=localhost,127.0.0.1,cypercloud.localhost,127.0.0.1:5073

# Local SQLite database
# (no database env vars needed for SQLite)

# Ollama (local AI model server)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Email: Console backend for development
# Emails will be printed to console instead of actually sent
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Gunicorn workers for development
TINKER_WORKERS=2

# No SSL redirect in development
SECURE_SSL_REDIRECT=false
CSRF_COOKIE_SECURE=false
SESSION_COOKIE_SECURE=false

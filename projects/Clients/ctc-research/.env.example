# CTC Research environment variable names only.
# Copy to an ignored .env or configure through the deployment secret store.
# Never commit real passwords, tokens, app passwords, or private keys.

WEBSITE=precis-ctc
DJANGO_SITE=precis-ctc
PROJECT_PATH=precis-ctc
SITE_DOMAIN=ctc-research.com
SITE_PORT=443
HOST=0.0.0.0
PORT=5070
DEBUG=false
SERVER_TYPE=uvicorn
WORKERS=4
LOG_LEVEL=info
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME_CTC=db_precis_ctc
DB_NAME=db_precis_ctc
DB_USER=
DB_PASSWORD=

REDIS_PASSWORD=
REDIS_URL=
DRAMATIQ_BROKER_URL=
DRAMATIQ_PROCESSES=2
DRAMATIQ_THREADS=4
FUSION_TASK_BACKEND=dramatiq
FUSION_TASK_MODULES=plugins.workers.email_tasks,plugins.workers.course_tasks,plugins.workers.content_tasks,plugins.workers.legacy_email_tasks,plugins.workers.campaign_tasks

PUBLIC_SITE_URL=https://ctc-research.com
PUBLIC_BUILD_API_URL=https://ctc-research.com
PUBLIC_FUSION_API_URL=
PUBLIC_ENABLE_BACKEND=true
FUSION_RENDER_FIRST=true
MEDIA_URL=/media/
STATIC_URL=/static/
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/precis-ctc/assets/staticfiles

# Gmail SMTP via an approved app password; leave empty until provisioned.
EMAIL_STRATEGY=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
EMAIL_TEST_RECIPIENT=

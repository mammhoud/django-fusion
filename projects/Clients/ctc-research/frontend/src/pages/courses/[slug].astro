---
import Layout from '@/layouts/Layout.astro';
import CTA from '@/components/blocks/CTA.astro';
import ContentError from '@/components/ui/ContentError.astro';
import { fetchCourseDetail, cachedCourseList } from '@/lib/api';
import { cachedSiteSettings, cachedNavigation } from '@/lib/api';
import type { CourseCard, CourseDetail, NavigationData, SiteSettings } from '@/lib/api';

export async function getStaticPaths() {
  // Build-time content is optional: Docker/CI can build the static shell
  // before Django is running. The backend still supplies the authoritative
  // list at runtime; unknown slugs fall through to the ContentError branch.
  try {
    const catalog = await cachedCourseList();
    if (catalog.data.length) return catalog.data.map((course) => ({ params: { slug: course.slug } }));
  } catch {
    // Backend unreachable during docker build — emit empty path set.
  }
  return [];
}

const { slug } = Astro.params;
let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
try {
  [siteSettings, navData] = await Promise.all([
    cachedSiteSettings(),
    cachedNavigation(),
  ]);
} catch {
  // Site chrome may be unavailable during a preview build.
}
let course: CourseDetail | undefined;
try {
    course = await fetchCourseDetail(slug!);
  } catch {
    // Unknown slugs still render the normal ContentError fallback.
  }

// Related courses — other published courses for the “Keep exploring” strip.
let relatedCourses: CourseCard[] = [];
try {
  const catalog = await cachedCourseList();
  relatedCourses = (catalog.data ?? [])
    .filter((c) => c.slug !== slug)
    .slice(0, 3);
} catch {
  // Related strip is optional — skip silently.
}

const formatDifficulty = (value: string) => value.replace(/\b\w/g, (char) => char.toUpperCase());
const overviewBlocks = Array.isArray(course?.overview) ? course.overview : [];
const objectives = Array.isArray(course?.objectives) ? course.objectives : [];
const targetAudience = Array.isArray(course?.target_audience) ? course.target_audience : [];
const requirements = Array.isArray(course?.requirements) ? course.requirements : [];
const specializations = Array.isArray(course?.specializations) ? course.specializations : [];
const tags = Array.isArray(course?.tags) ? course.tags : [];
const modules = Array.isArray(course?.modules) ? course.modules : [];
const previewVideo = Array.isArray(course?.preview_video_url) ? course.preview_video_url : (course?.preview_video_url ? [String(course.preview_video_url)] : []);
const heroImage = course?.image_url || course?.header_image;
---

<Layout
  title={course?.title || 'Course Detail'}
  description={course?.short_description || 'Medical research courses for clinicians, researchers, and medical writers — from protocol to publication.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageSlug={`course:${slug}`}
>
  {course ? (
    <>
      <!-- ===== HERO — Cinematic Full-Bleed ===== -->
      <section class="course-hero" style={heroImage ? `--hero-image: url('${heroImage}')` : ''}>
        <div class="course-hero__overlay"></div>
        <div class="course-hero__inner">
          <div class="course-hero__content reveal-up">
            <nav class="course-hero__crumb" aria-label="Breadcrumb">
              <ol class="course-hero__crumb-list">
                <li class="course-hero__crumb-item"><a class="course-hero__crumb-link" href="/">Home</a></li>
                <li class="course-hero__crumb-sep" aria-hidden="true">/</li>
                <li class="course-hero__crumb-item"><a class="course-hero__crumb-link" href="/courses/">Courses</a></li>
                <li class="course-hero__crumb-sep" aria-hidden="true">/</li>
                <li class="course-hero__crumb-item course-hero__crumb-item--active" aria-current="page">{course.title}</li>
              </ol>
            </nav>
            <span class="course-hero__eyebrow">{formatDifficulty(course.difficulty)} · {course.duration}h · {course.language.toUpperCase()}</span>
            <h1 class="course-hero__title">{course.title}</h1>
            <p class="course-hero__subtitle">{course.short_description}</p>
            <div class="course-hero__actions">
              <a href="#enroll" class="btn-magnetic">
                <span data-i18n="course_enroll">Enroll now</span>
                <span class="btn-magnetic__icon">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 13L13 1M13 1H4.5M13 1V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </a>
              <a href="/courses/" class="btn-ghost">
                <span data-i18n="course_back">← Back to catalog</span>
              </a>
            </div>
          </div>
          <!-- Stats strip -->
          <div class="course-hero__stats reveal-up" style="--reveal-delay: 0.15s">
            {course.enrolled_count ? <div class="course-hero__stat"><span class="course-hero__stat-value">{course.enrolled_count}+</span><span class="course-hero__stat-label" data-i18n="course_students">Students</span></div> : null}
            <div class="course-hero__stat"><span class="course-hero__stat-value">{modules.length}</span><span class="course-hero__stat-label" data-i18n="course_modules">Modules</span></div>
            <div class="course-hero__stat"><span class="course-hero__stat-value">{course.duration}h</span><span class="course-hero__stat-label" data-i18n="course_duration">Duration</span></div>
            {course.has_certificate ? <div class="course-hero__stat"><span class="course-hero__stat-value">✓</span><span class="course-hero__stat-label" data-i18n="course_certificate">Certificate</span></div> : null}
          </div>
        </div>
      </section>

      <!-- ===== MAIN CONTENT — Asymmetrical Bento ===== -->
      <section class="course-main">
        <div class="course-main__grid">

          <!-- LEFT: Content column -->
          <div class="course-main__content">

            <!-- WHY THIS COURSE — Double-Bezel card -->
            <article class="card-premium reveal-up">
              <div class="card-premium__shell">
                <div class="card-premium__core">
                  <p class="tag-marker" data-i18n="course_overview">course overview</p>
                  <h2 class="card-premium__title" data-i18n="course_why">Why this course matters</h2>
                  <p class="card-premium__body">{course.description}</p>
                  {heroImage && !heroImage.includes('placeholder') ? <img src={heroImage} alt={course.title} loading="lazy" class="card-premium__hero-image" /> : null}
                </div>
              </div>
            </article>

            <!-- OVERVIEW BLOCKS -->
            {overviewBlocks.length ? (
              <article class="card-premium reveal-up" style="--reveal-delay: 0.1s">
                <div class="card-premium__shell">
                  <div class="card-premium__core">
                    <div class="card-premium__blocks">
                      {overviewBlocks.map((block: any) => (
                        <div class="card-premium__block">
                          {block.value?.heading && <h3 class="card-premium__block-title">{block.value.heading}</h3>}
                          {block.value?.body && <p class="card-premium__body-sm">{String(block.value.body)}</p>}
                          {Array.isArray(block.value?.list_items) && <ul class="card-premium__list">{block.value.list_items.map((item: string) => <li><span>✓</span><span>{item}</span></li>)}</ul>}
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </article>
            ) : null}

            <!-- LEARNING OBJECTIVES -->
            {objectives.length ? (
              <article class="card-premium reveal-up" style="--reveal-delay: 0.15s">
                <div class="card-premium__shell">
                  <div class="card-premium__core">
                    <h3 class="card-premium__section-title" data-i18n="course_learn">What you'll learn</h3>
                    <ul class="card-premium__objectives-grid">
                      {objectives.map((item: string) => <li><span class="check-icon">✓</span><span>{item}</span></li>)}
                    </ul>
                  </div>
                </div>
              </article>
            ) : null}

            <!-- WHO IT IS FOR -->
            {targetAudience.length ? (
              <article class="card-premium reveal-up" style="--reveal-delay: 0.2s">
                <div class="card-premium__shell">
                  <div class="card-premium__core">
                    <h3 class="card-premium__section-title" data-i18n="course_audience">Who this course is for</h3>
                    <ul class="card-premium__list">
                      {targetAudience.map((item: string) => <li><span>→</span><span>{item}</span></li>)}
                    </ul>
                  </div>
                </div>
              </article>
            ) : null}

            <!-- REQUIREMENTS -->
            {requirements.length ? (
              <article class="card-premium reveal-up" style="--reveal-delay: 0.25s">
                <div class="card-premium__shell">
                  <div class="card-premium__core">
                    <h3 class="card-premium__section-title" data-i18n="course_requirements">Requirements</h3>
                    <ul class="card-premium__list">
                      {requirements.map((item: string) => <li><span>•</span><span>{item}</span></li>)}
                    </ul>
                  </div>
                </div>
              </article>
            ) : null}

            <!-- TAGS -->
            {(specializations.length || tags.length) ? (
              <div class="flex flex-wrap gap-2 mt-6 reveal-up" style="--reveal-delay: 0.3s">
                {[...specializations, ...tags].map((label: string) => <span class="badge-primary">{label}</span>)}
              </div>
            ) : null}

            <!-- PREVIEW VIDEOS -->
            {previewVideo.length ? (
              <article class="card-premium reveal-up" style="--reveal-delay: 0.35s">
                <div class="card-premium__shell">
                  <div class="card-premium__core">
                    <h3 class="card-premium__section-title" data-i18n="course_preview">Course preview</h3>
                    <div class="card-premium__video-links">
                      {previewVideo.map((url: string) => (
                        <a href={url} target="_blank" rel="noreferrer" class="btn-secondary inline-flex" data-i18n="course_watch_preview">Watch preview →</a>
                      ))}
                    </div>
                  </div>
                </div>
              </article>
            ) : null}

          </div>

          <!-- RIGHT: Sticky sidebar — Double-Bezel pricing card -->
          <aside class="course-main__sidebar" id="enroll">
            <div class="card-premium card-premium--sticky reveal-up" style="--reveal-delay: 0.05s">
              <div class="card-premium__shell">
                <div class="card-premium__core">
                  <p class="tag-marker mb-4" data-i18n="course_facts">course facts</p>

                  <!-- Price -->
                  <div class="sidebar-price">
                    {course.is_free
                      ? <span class="sidebar-price__value text-success" data-i18n="course_free">Free</span>
                      : course.is_discounted
                        ? <>
                            <span class="sidebar-price__value">${course.current_price}</span>
                            <span class="sidebar-price__original">${course.original_price}</span>
                            <span class="sidebar-price__discount">-{course.discount_percentage_calculated}%</span>
                          </>
                        : <span class="sidebar-price__value">${course.price}</span>
                    }
                  </div>

                  <!-- Facts -->
                  <dl class="sidebar-facts">
                    <div class="sidebar-facts__row"><dt data-i18n="course_duration">Duration</dt><dd>{course.duration} hours</dd></div>
                    <div class="sidebar-facts__row"><dt data-i18n="course_level">Level</dt><dd>{formatDifficulty(course.difficulty)}</dd></div>
                    <div class="sidebar-facts__row"><dt data-i18n="course_language">Language</dt><dd class="uppercase">{course.language}</dd></div>
                    <div class="sidebar-facts__row"><dt data-i18n="course_modules">Modules</dt><dd>{modules.length}</dd></div>
                    <div class="sidebar-facts__row"><dt data-i18n="course_certificate">Certificate</dt><dd>{course.has_certificate ? 'Included' : '—'}</dd></div>
                    {course.average_rating ? <div class="sidebar-facts__row"><dt data-i18n="course_rating">Rating</dt><dd class="sidebar-facts__rating">{'★'.repeat(Math.round(course.average_rating))} {course.average_rating}</dd></div> : null}
                  </dl>

                  <!-- CTA -->
                  <a href="/contact/" class="btn-magnetic btn-magnetic--full mt-6">
                    <span data-i18n={course.is_free ? 'course_enroll_free' : 'course_enroll'}>{course.is_free ? 'Enroll for free' : 'Enroll now'}</span>
                    <span class="btn-magnetic__icon">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 13L13 1M13 1H4.5M13 1V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </a>

                  {course.is_discounted && course.discount_until ? (
                    <p class="sidebar-discount-note">Offer ends {new Date(course.discount_until).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</p>
                  ) : null}

                  {course.has_certificate ? (
                    <div class="sidebar-cert-badge">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="9" r="6" stroke="#22c55e" stroke-width="1.5"/><path d="M7 9l2 2 4-4" stroke="#22c55e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 14l1.5 3h5L14 14" stroke="#22c55e" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      <span>Certificate included</span>
                    </div>
                  ) : null}
                </div>
              </div>
            </div>
          </aside>

        </div>
      </section>

      <!-- ===== SYLLABUS — Smooth Accordion ===== -->
      {modules.length ? (
        <section class="syllabus-section reveal-up">
          <div class="syllabus-section__inner">
            <div class="syllabus-section__header">
              <p class="tag-marker">learning path</p>
              <h2 class="syllabus-section__title" data-i18n="course_syllabus">Course syllabus</h2>
              <p class="syllabus-section__subtitle">{modules.length} modules · step-by-step learning path</p>
            </div>

            <div class="syllabus-accordion" id="syllabus">
              {modules.map((mod: any, idx: number) => (
                <div class="syllabus-accordion__item">                    <button
                    class="syllabus-accordion__trigger"
                    aria-expanded={idx === 0 ? 'true' : 'false'}
                  >
                    <span class="syllabus-accordion__index">{String(idx + 1).padStart(2, '0')}</span>
                    <span class="syllabus-accordion__label">
                      <span class="syllabus-accordion__module-title">{mod.title}</span>
                      {mod.description && <span class="syllabus-accordion__module-desc">{mod.description}</span>}
                    </span>
                    <span class="syllabus-accordion__meta">
                      <span class="syllabus-accordion__lesson-count">{mod.lessons?.length || 0} <span data-i18n="course_lessons">lessons</span></span>
                      <span class="syllabus-accordion__chevron">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </span>
                    </span>
                  </button>
                  <div class="syllabus-accordion__panel">
                    {mod.lessons?.length ? (
                      <ul class="syllabus-accordion__lessons">
                        {mod.lessons.map((lesson: any) => (
                          <li class="syllabus-accordion__lesson">
                            <span class="syllabus-accordion__lesson-icon">
                              {lesson.is_preview
                                ? <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="#22c55e" stroke-width="1.5"/><path d="M6.5 5.5l4 2.5-4 2.5V5.5z" fill="#22c55e" stroke="#22c55e" stroke-width="0.5"/></svg>
                                : <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2" opacity="0.35"/><path d="M6.5 5.5l4 2.5-4 2.5V5.5z" fill="currentColor" opacity="0.35"/></svg>
                              }
                            </span>
                            <span class="syllabus-accordion__lesson-title">{lesson.title}</span>
                            <span class="syllabus-accordion__lesson-duration">{lesson.duration || 0} min</span>
                            {lesson.is_preview ? <span class="syllabus-accordion__lesson-badge">Preview</span> : null}
                          </li>
                        ))}
                      </ul>
                    ) : null}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      ) : null}

      <!-- ===== INSTRUCTOR — Editorial Card ===== -->
      {course.instructor ? (
        <section class="instructor-section reveal-up">
          <div class="instructor-section__inner">
            <div class="card-premium">
              <div class="card-premium__shell">
                <div class="card-premium__core instructor-card">
                  {course.instructor?.profile?.avatar ? (
                    <img src={course.instructor.profile.avatar} alt={course.instructor.name || course.instructor.username} class="instructor-card__avatar" width="100" height="100" loading="lazy" />
                  ) : (
                    <div class="instructor-card__avatar-placeholder">{course.instructor.name?.[0] || 'I'}</div>
                  )}
                  <div class="instructor-card__info">
                    <p class="tag-marker" data-i18n="course_instructor">instructor</p>
                    <h3 class="instructor-card__name">{course.instructor.name || course.instructor.username}</h3>
                    {course.instructor?.profile?.title && <p class="instructor-card__title">{course.instructor.profile.title}</p>}
                    {course.instructor?.profile?.bio && <p class="instructor-card__bio">{course.instructor.profile.bio}</p>}
                    <div class="instructor-card__links">
                      {course.instructor?.profile?.website ? <a href={course.instructor.profile.website} class="btn-ghost-sm">Website</a> : null}
                      {course.instructor?.profile?.linkedin ? <a href={course.instructor.profile.linkedin} class="btn-ghost-sm">LinkedIn</a> : null}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      ) : null}

      <!-- ===== RELATED — Keep exploring ===== -->
      {relatedCourses.length ? (
        <section class="related-section reveal-up">
          <div class="related-section__inner">
            <div class="related-section__header">
              <p class="tag-marker">keep exploring</p>
              <h2 class="related-section__title" data-i18n="course_related">More courses from the catalog</h2>
            </div>
            <div class="related-section__grid">
              {relatedCourses.map((rel: CourseCard) => (
                <a href={`/courses/${rel.slug}/`} class="related-card">
                  <div class="related-card__top">
                    <span class="badge-primary">{formatDifficulty(rel.difficulty)}</span>
                    <span class="related-card__lang">{String(rel.language).toUpperCase()}</span>
                  </div>
                  <h3 class="related-card__title">{rel.title}</h3>
                  <p class="related-card__desc">{rel.short_description}</p>
                  <div class="related-card__meta">
                    <span>{rel.duration}h</span>
                    <span>{Number(rel.price || 0) > 0 ? `$${Number(rel.price).toLocaleString('en-US')}` : 'Free'}</span>
                    <span class="related-card__cta" data-i18n="course_view">View →</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      ) : null}

      <!-- ===== CTA ===== -->
      <CTA
        heading={course?.has_certificate ? 'Earn your certificate today' : 'Ready to start learning?'}
        intro={course?.has_certificate ? 'Complete this course and earn a verifiable certificate. Join students already enrolled.' : 'Join the students already advancing their careers with this course.'}
        ctaLabel="Return to catalog"
        ctaHref="/courses/"
      />
    </>
  ) : (
    <section class="py-32"><div class="container"><ContentError label="Course not found" showHomeLink={true} /></div></section>
  )}
</Layout>

<!-- ===== REVEAL ANIMATIONS + ACCORDION ===== -->
<script>
  // Staggered reveal on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('reveal-up--visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  const revealTargets = document.querySelectorAll('.reveal-up');
  if (!('IntersectionObserver' in window)) {
    revealTargets.forEach((el) => el.classList.add('reveal-up--visible'));
  } else {
    revealTargets.forEach((el) => observer.observe(el));
  }

  // Accordion toggle (delegated — CSP-safe, no inline onclick)
  document.getElementById('syllabus')?.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    const trigger = target?.closest('.syllabus-accordion__trigger') as HTMLElement | null;
    if (!trigger) return;
    const item = trigger.closest('.syllabus-accordion__item') as HTMLElement | null;
    if (!item) return;
    const isOpen = item.classList.toggle('syllabus-accordion__item--open');
    trigger.setAttribute('aria-expanded', String(isOpen));
  });
</script>

<style is:global>
  /* ==================================================================
     COURSE PAGE — PREMIUM DESIGN SYSTEM
     Archetype: Soft Structuralism + Asymmetrical Bento
     Typography: Geist (via CDN) — clean grotesk with editorial weight
     ================================================================== */

  @import url('https://fonts.cdnfonts.com/css/geist');

  :root {
    --course-surface: #f8f9fb;
    --course-card: #ffffff;
    --course-ink: #0f1117;
    --course-muted: #6b7280;
    --course-line: rgba(0, 0, 0, 0.06);
    --course-accent: #E61919;
    --course-accent-glow: rgba(230, 25, 25, 0.08);
    --course-accent-gold: #c9962e;
    --course-accent-gold-glow: rgba(201, 150, 46, 0.08);
    --course-radius-lg: 0;
    --course-radius-md: 0;
    --course-radius-sm: 0;
    --course-transition: 0.5s cubic-bezier(0.32, 0.72, 0, 1);
    --course-transition-fast: 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }

  /* ---- Staggered reveal (clean rise — no blur, so nothing can stay
     blurred after the animation settles) ---- */
  .reveal-up {
    opacity: 1;
    transform: translateY(0);
    filter: none;
    transition: opacity 0.9s cubic-bezier(0.32, 0.72, 0, 1),
                transform 0.9s cubic-bezier(0.32, 0.72, 0, 1);
    transition-delay: var(--reveal-delay, 0s);
  }
  .js .reveal-up {
    opacity: 0;
    transform: translateY(2rem);
  }
  /* The visible state must out-specify `.js .reveal-up` (two classes),
     otherwise the hidden rule wins and sections stay at opacity 0 even
     after the observer fires — same pattern as `.js .reveal.reveal-visible`
     in globals.css. */
  .js .reveal-up.reveal-up--visible {
    opacity: 1;
    transform: translateY(0);
    filter: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .js .reveal-up,
    .js .reveal-up.reveal-up--visible {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
  }

  /* ---- Cinematic Hero ---- */
  .course-hero {
    position: relative;
    min-height: min(85dvh, 700px);
    display: flex;
    align-items: flex-end;
    background-color: #0f1117;
    overflow: hidden;
  }
  /* Blurred backdrop — the background image lives on its own layer so the
     blur applies to the image itself. This works in every browser, unlike
     `backdrop-filter` on the overlay, which Safari does not apply to the
     parent element's background. The scale hides edge bleed from the blur. */
  .course-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--hero-image, none);
    background-size: cover;
    background-position: center 30%;
    filter: blur(14px) saturate(1.05);
    transform: scale(1.12);
    z-index: 0;
  }
  .course-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      rgba(15, 17, 23, 0.25) 0%,
      rgba(15, 17, 23, 0.55) 40%,
      rgba(15, 17, 23, 0.92) 100%
    );
    z-index: 1;
  }
  .course-hero::after {
    content: '';
    position: absolute;
    inset: 0;

---
import Layout from '@/layouts/Layout.astro';
import TeamSection from '@/components/blocks/TeamSection.astro';
import PageHeader from '@/components/blocks/PageHeader.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData, TeamMember } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('team'),
  ]);
} catch { /* use fallbacks */ }

// Map the backend team_members shape onto TeamSection's props. Names and
// bios come from the localized TeamPage — no hardcoded members anywhere.
const members = (pageData?.team_members || []).map((m: TeamMember) => ({
  name: m.name || '',
  role: m.position || '',
  image: m.photo?.url,
  initials: (m.name || '').split(/\s+/).map((p) => p[0]).join('').slice(0, 2).toUpperCase(),
  bio: m.bio,
  links: [
    m.linkedin ? { platform: 'linkedin', url: m.linkedin, label: 'LinkedIn' } : null,
    m.twitter ? { platform: 'website', url: m.twitter, label: 'Twitter' } : null,
    m.facebook ? { platform: 'website', url: m.facebook, label: 'Facebook' } : null,
  ].filter(Boolean) as { platform: string; url: string; label: string }[],
}));
---

<Layout
  title={pageData?.title || 'Our Team'}
  description={pageData?.search_description || 'Meet the team behind CTC Research.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="team"
>
  <PageHeader
    eyebrow="the research network"
    title={pageData?.team_title || 'Meet the team'}
    intro={pageData?.team_subtitle || 'Academic, clinical, and analytical collaborators connected by a shared research method.'}
    variant="network"
    index="06"
    primaryCta={{ label: 'Work with the team', href: '/contact/' }}
    secondaryCta={{ label: 'Our approach', href: '/about/research/' }}
  />

  {members.length ? (
    <TeamSection
      eyebrow="the team"
      title={pageData?.team_title || 'Meet the team'}
      description={pageData?.team_subtitle}
      members={members}
    />
  ) : (
    <section class="team doc-sheet bg-fu-paper py-20 md:py-28">
      <div class="container-fusion team__header">
        <p class="tag-marker mb-4">the research network</p>
        <h2 class="font-display text-4xl font-bold tracking-tight text-fu-ink md:text-5xl">Meet the research network</h2>
        <p class="mt-4 text-fu-muted">Our academic, clinical, and analytical collaborators are introduced as each profile is ready. Start with the research question and we will connect the right expertise.</p>
        <a class="btn-primary mt-8 inline-flex" href="/contact/">Work with the team</a>
      </div>
    </section>
  )}

  <Toast />
</Layout>

<script>
  // The CTC frontend is intentionally static for fast delivery. When a
  // visitor requests a locale with ?lang=, hydrate the visible Team page
  // (header, section title, member cards) from the authoritative localized
  // Wagtail API instead of serving the English build artifact unchanged.
  const SUPPORTED = ['en', 'sv', 'fr', 'de', 'es', 'ar', 'pt-br'];
  const UI_COPY = {
    en: { eyebrow: 'the research network', cta1: 'Work with the team', cta2: 'Our approach' },
    ar: { eyebrow: 'شبكة الأبحاث', cta1: 'اعمل مع الفريق', cta2: 'منهجنا' },
    de: { eyebrow: 'das Forschungsnetzwerk', cta1: 'Mit dem Team arbeiten', cta2: 'Unser Ansatz' },
    es: { eyebrow: 'la red de investigación', cta1: 'Trabaja con el equipo', cta2: 'Nuestro enfoque' },
    fr: { eyebrow: 'le réseau de recherche', cta1: 'Travailler avec l’équipe', cta2: 'Notre approche' },
    'pt-br': { eyebrow: 'a rede de pesquisa', cta1: 'Trabalhe com a equipe', cta2: 'Nossa abordagem' },
    sv: { eyebrow: 'forskningsnätverket', cta1: 'Arbeta med teamet', cta2: 'Vår ansats' },
  };

  const setText = (root: Element | null, selector: string, value: unknown): void => {
    const node = root?.querySelector(selector);
    if (node && value) node.textContent = String(value);
  };
  const setMany = (root: Element | null, selector: string, values: unknown[]): void => {
    root?.querySelectorAll(selector).forEach((node: Element, index: number) => {
      if (values[index]) node.textContent = String(values[index]);
    });
  };

  async function syncLocalizedTeam() {
    const requested = new URLSearchParams(window.location.search).get('lang')?.toLowerCase();
    if (!requested || !SUPPORTED.includes(requested) || requested === 'en') return;
    try {
      let data: Record<string, any> | null = null;
      for (let attempt = 0; attempt < 3 && !data; attempt += 1) {
        try {
          const response: Response = await window.fetch(`/apis/pages/team/?lang=${encodeURIComponent(requested)}&locale_refresh=1`, {
            cache: 'no-store',
            headers: { Accept: 'application/json' },
          });
          if (response.ok) {
            const candidate: Record<string, any> = await response.json() as Record<string, any>;
            if (candidate.language === requested) data = candidate;
          }
        } catch (error) {
          // Retry transient network failures; the final catch below preserves
          // the usable static page if the backend remains unavailable.
        }
        if (!data && attempt < 2) await new Promise((resolve) => setTimeout(resolve, 250 * (attempt + 1)));
      }
      if (!data) return;
      const copy = UI_COPY[requested as keyof typeof UI_COPY] || UI_COPY.en;

      const header = document.querySelector('.page-header');
      setText(header, '.page-header__eyebrow', copy.eyebrow);
      setText(header, '.page-header__title', data.team_title);
      setText(header, '.page-header__intro', data.team_subtitle);
      setMany(header, '.page-header__actions a', [copy.cta1, copy.cta2]);

      const section = document.querySelector('.team');
      setText(section, '.team__header .page-section__title', data.team_title);
      setText(section, '.team__header p.text-fu-muted', data.team_subtitle);

      // Swap member cards in place — the backend roster order matches the
      // build-time order, so index mapping is stable.
      const members: any[] = data.team_members || [];
      document.querySelectorAll('.team__card').forEach((card, index) => {
        const member = members[index];
        if (!member) return;
        setText(card, '.team__name', member.name);
        setText(card, '.team__role', member.position);
        setText(card, '.team__bio', member.bio);
      });

      document.documentElement.setAttribute('lang', requested);
      document.documentElement.setAttribute('dir', requested === 'ar' ? 'rtl' : 'ltr');
      document.documentElement.dataset.language = requested;
      document.documentElement.dataset.localizedReady = requested;
      document.title = data.title || document.title;
      document.querySelector('meta[name="description"]')?.setAttribute('content', data.seo?.description || data.team_subtitle || '');
    } catch (error) {
      console.warn('Localized Team content could not be loaded', error);
    }
  }

  syncLocalizedTeam();
</script>

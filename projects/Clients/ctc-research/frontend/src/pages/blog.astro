---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/blocks/Hero.astro';
import BlogPreview from '@/components/blocks/BlogPreview.astro';
import CTA from '@/components/blocks/CTA.astro';
import ContentError from '@/components/ui/ContentError.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation, cachedPageData, fetchBlogPosts } from '@/lib/api';
import type { SiteSettings, NavigationData, PageData, BlogPostData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
let pageData: PageData | undefined;
try {
  [siteSettings, navData, pageData] = await Promise.all([
    cachedSiteSettings(), cachedNavigation(), cachedPageData('blog'),
  ]);
} catch { /* use fallbacks */ }

const pageHero = pageData?.hero;
const pageCta = pageData?.cta;
const pageBlog = (pageData?.blog as any[] | undefined);

// The editorial index is served from the live blog API (seeded BlogPost
// rows) when the Wagtail page does not carry a `blog` block — the API is the
// authoritative source for the /blog/<slug>/ detail routes, so the two views
// can never disagree about what is published.
let livePosts: BlogPostData[] = [];
try {
  const list = await fetchBlogPosts();
  livePosts = list.data ?? [];
} catch { /* blog API unavailable — fall back to the page block only */ }

const posts = (pageBlog ?? livePosts).map((p: any) => ({
  title: String(p.title || ''),
  slug: String(p.slug || ''),
  excerpt: String(p.excerpt || ''),
  date: String(p.published_date || p.date || '').split('T')[0],
  category: String((p.categories && p.categories[0]?.name) || p.category || ''),
  readTime: String(p.reading_time ? `${p.reading_time} min read` : p.read_time || ''),
}));
---


<Layout
  title={pageData?.title || 'Blog'}
  description={pageData?.search_description || 'The CTC Research blog — notes on clinical research, evidence synthesis, and health innovation.'}
  navItems={navData?.nav_items}
  siteSettings={siteSettings}
  pageData={pageData}
  pageSlug="blog"
>
  <Hero
    eyebrow={pageHero?.badge || 'insights · medical research learning'}
    heading={pageHero?.title || 'The Blog'}
    accent='for evidence'
    intro={pageHero?.subtitle || 'Notes on clinical research, evidence synthesis, and health innovation from the CTC Research team.'}
    primaryCta={pageHero?.primary_cta ? { label: pageHero.primary_cta.label, href: pageHero.primary_cta.href } : { label: 'Browse courses', href: '/courses/' }}
    secondaryCta={pageHero?.secondary_cta ? { label: pageHero.secondary_cta.label, href: pageHero.secondary_cta.href } : { label: 'Contact us', href: '/contact/' }}
    variant="archive"
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Blog' }]}
  />

  {posts.length ? (
    <BlogPreview
      eyebrow='insights'
      title='From the blog'
      description={pageData?.search_description}
      posts={posts}
    />
  ) : (
    <ContentError label="The backend has not published any editorial documents yet." />
  )}

  <CTA
    heading={pageCta?.title || 'Advance health through research'}
    intro={pageCta?.subtitle || 'Join clinicians, biostatisticians, and medical writers building trusted evidence.'}
    ctaLabel={pageCta?.primary_cta?.label || 'Browse courses'}
    ctaHref={pageCta?.primary_cta?.href || '/courses/'}
  />
  <Toast />
</Layout>

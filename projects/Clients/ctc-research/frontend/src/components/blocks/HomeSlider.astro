---
import { publicHref } from '@/lib/site';

interface Slide {  eyebrow: string;
  title: string;
  text: string;
  href: string;
  cta: string;
  image?: string;
  alt?: string;
}

interface Props {
  slides: Slide[];
  /** Swiper-style options — loop, autoplay, navigation, dots. */
  loop?: boolean;
  autoplay?: boolean;
  autoplayInterval?: number;
  showNavigation?: boolean;
  showDots?: boolean;
  /** Optional eyebrow/heading/intro overrides (used for Wagtail-driven sliders). */
  eyebrow?: string;
  heading?: string;
  intro?: string;
}

const {
  slides = [],
  loop = true,
  autoplay = true,
  autoplayInterval = 7000,
  showNavigation = true,
  showDots = true,
  eyebrow = 'the research agenda',
  heading = 'The research agenda',
  intro = 'Move through the connected work: a clinical question, a defensible method, and the next useful learning step.',
} = Astro.props;
---

{slides.length ? (
  <section class="home-slider" aria-labelledby="home-slider-title" data-testid="home-slider"  x-data={`{
    active: 0,
    total: ${slides.length},
    interval: ${autoplayInterval},
    timer: null,
    playing: ${autoplay},
    touchStartX: 0,
    touchStartY: 0,
    touchX: 0,
    isSwiping: false,
    init() {
      if (${autoplay}) { this.start(); }
    },
    start() {
      this.stop();
      this.playing = true;
      this.timer = setInterval(() => this.next(), ${autoplayInterval});
      this.$nextTick(() => { this.restartProgress(); });
    },
    stop() {
      if (this.timer) { clearInterval(this.timer); this.timer = null; }
      this.playing = false;
      this.pauseProgress();
    },
    togglePlay() {
      this.playing ? this.stop() : this.start();
    },
    restartProgress() {
      const bar = this.$refs.progress;
      if (!bar) return;
      bar.classList.remove('is-running');
      void bar.offsetWidth; // reflow — restart the CSS animation
      bar.classList.add('is-running');
    },
    pauseProgress() {
      const bar = this.$refs.progress;
      if (bar) bar.classList.remove('is-running');
    },
    next() {
      this.active = ${loop} ? (this.active + 1) % this.total : Math.min(this.active + 1, this.total - 1);
      if (this.playing) this.restartProgress();
    },
    previous() {
      this.active = ${loop} ? (this.active - 1 + this.total) % this.total : Math.max(this.active - 1, 0);
      if (this.playing) this.restartProgress();
    },
    goTo(index) {
      this.active = index;
      if (this.playing) this.restartProgress();
    },
    onTouchStart(e) {
      this.touchStartX = e.touches[0].clientX;
      this.touchStartY = e.touches[0].clientY;
      this.isSwiping = false;
    },
    onTouchMove(e) {
      const dx = e.touches[0].clientX - this.touchStartX;
      const dy = e.touches[0].clientY - this.touchStartY;
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 10) {
        this.isSwiping = true;
        this.touchX = dx;
        e.preventDefault();
      }
    },
    onTouchEnd() {
      if (this.isSwiping) {
        if (this.touchX < -40) this.next();
        else if (this.touchX > 40) this.previous();
      }
      this.touchX = 0;
      this.isSwiping = false;
    }
  }`}>
    <div class="container-fusion">
      <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <p class="tag-marker mb-3" data-l10n="home_chrome.slider_head.eyebrow">{eyebrow}</p>
          <h2 id="home-slider-title" class="page-section__title mb-0" data-l10n="home_chrome.slider_head.title">{heading}</h2>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-fu-muted" data-l10n="home_chrome.slider_head.intro">{intro}</p>
      </div>

      <div class="home-slider__frame" @mouseenter="stop()" @mouseleave="playing ? start() : null" @touchstart="onTouchStart($event)" @touchmove="onTouchMove($event)" @touchend="onTouchEnd()">
        <!-- Autoplay progress — a hairline that sweeps the slide's lifetime.
             Restarts on every slide change; removed while paused/hovered. -->
        <div class="home-slider__progress" x-ref="progress" :style="'--home-slider-duration: ' + interval + 'ms'" aria-hidden="true"></div>

        <div class="home-slider__track" :style="`transform: translateX(-${active * 100}%)`">
          {slides.map((slide, index) => (
            <article class="home-slider__slide" data-testid="home-slide" aria-hidden={index === 0 ? 'false' : 'true'} :aria-hidden={`active !== ${index}`}>
              <div class="home-slider__copy">
                <p class="home-slider__index">
                  <span class="home-slider__index-num">{String(index + 1).padStart(2, '0')} <span class="home-slider__index-total">/ {String(slides.length).padStart(2, '0')}</span></span>
                  <span class="home-slider__index-label">{slide.eyebrow}</span>
                </p>
                <h3 class="home-slider__title">{slide.title}</h3>
                <p class="home-slider__text">{slide.text}</p>
                <a class="btn-secondary mt-6 inline-flex w-fit" href={publicHref(slide.href)}>
                  <span>{slide.cta}</span>
                  <span class="home-slider__cta-arrow" aria-hidden="true">→</span>
                </a>
              </div>
              <div class="home-slider__media">
                {slide.image ? <img src={slide.image} alt={slide.alt || slide.title} loading={index === 0 ? 'eager' : 'lazy'} /> : <div class="home-slider__placeholder">CTC / {slide.eyebrow}</div>}
              </div>
            </article>
          ))}
        </div>
        {showDots && (
          <div class="home-slider__controls">
            <div class="home-slider__dots" role="tablist" aria-label="Research agenda slides">
              {slides.map((slide, index) => (
                <button type="button" class="home-slider__dot" role="tab" :aria-selected={`active === ${index}`} aria-current={index === 0 ? 'true' : 'false'} :aria-current={`active === ${index} ? 'true' : 'false'`} @click={`goTo(${index})`} aria-label={`Show slide ${index + 1}: ${slide.eyebrow}`}>
                  <span class="home-slider__dot-fill"></span>
                </button>
              ))}
            </div>
            {showNavigation && (
              <div class="home-slider__control-group">
                <button
                  type="button"
                  class="home-slider__play"
                  @click="togglePlay()"
                  :aria-label="playing ? 'Pause slideshow' : 'Play slideshow'"
                  :aria-pressed="playing ? 'true' : 'false'"
                >
                  <svg x-show="playing" class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="0.5"/><rect x="14" y="5" width="4" height="14" rx="0.5"/></svg>
                  <svg x-show="!playing" class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                </button>
                <div class="home-slider__arrow">
                  <button type="button" class="btn-secondary !px-3 !py-2" @click="previous()" aria-label="Previous research slide">←</button>
                  <button type="button" class="btn-primary !px-3 !py-2" @click="next()" aria-label="Next research slide">→</button>
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  </section>
) : null}

---
// CounterCard — BEM stat block with icon + odometer + label.
// Adapted from .archives/theme/components/CounterCard.html (Histudy LMS),
// re-skinned to the CTC Blue/Teal clinical theme.
interface Counter {
  label: string;
  value: number;
  suffix?: string;
  iconPath?: string;
}

interface Props {
  counters?: Counter[];
  heading?: string;
  intro?: string;
}

// Center metrics — research-facing counters used when the backend is
// unreachable at build time. Real numbers come from the seeded page data.
const defaultCounters: Counter[] = [
  {
    label: 'Peer-reviewed studies supported',
    value: 140,
    suffix: '+',
    iconPath: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    label: 'Active research programs',
    value: 12,
    iconPath: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    label: 'Researchers and clinicians trained',
    value: 2400,
    suffix: '+',
    iconPath: 'M12 6.25a3.5 3.5 0 100-7 3.5 3.5 0 000 7zM4 21a8 8 0 0116 0',
  },
  {
    label: 'Median manuscript turnaround',
    value: 6,
    suffix: ' wks',
    iconPath: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  },
];

const {
  counters = defaultCounters,
  heading = 'The center, in numbers',
  intro = 'Research output across clinical research, biostatistics, and evidence synthesis.',
} = Astro.props;
---

<section class="fu-counter">
  <div class="container-fusion">
    <div class="fu-counter__header">
      {heading && <h2 class="page-section__title">{heading}</h2>}
      {intro && <p class="text-fu-muted">{intro}</p>}
    </div>

    <div class="fu-counter__grid">
      {counters.map((c) => (
        <div
          class="fu-counter__item group"
          x-data={`{ shown: false, count: 0 }`}
          x-intersect.once="shown = true"
          x-effect={
            c.value > 0
              ? `if (shown && count === 0) { const target = ${c.value}; const step = Math.max(1, Math.ceil(target / 40)); const t = setInterval(() => { count += step; if (count >= target) { count = target; clearInterval(t); } }, 24); }`
              : undefined
          }
        >
          <div class="fu-counter__icon" aria-hidden="true">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
              <path stroke-linecap="round" stroke-linejoin="round" d={c.iconPath || 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'} />
            </svg>
          </div>
          <div class="fu-counter__value" x-text={`shown ? count.toLocaleString() + '${c.suffix ?? ''}' : '0${c.suffix ?? ''}'`}>
            0{c.suffix ?? ''}
          </div>
          <span class="fu-counter__label">{c.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

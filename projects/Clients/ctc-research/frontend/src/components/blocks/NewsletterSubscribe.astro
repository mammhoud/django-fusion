---
/** Newsletter subscription form — submits via HTMX to the Django backend.
 *
 * The backend endpoint POST /api/newsletter/subscribe/ accepts { email } and
 * returns a visitor-friendly HTML fragment for HTMX (or JSON for API clients).
 * The address is saved as pending until the visitor confirms it by email.
 */
interface Props {
  title?: string;
  description?: string;
  placeholder?: string;
  buttonLabel?: string;
  /** Privacy note shown below the form */
  privacyNote?: string;
}

const {
  title = 'Keep learning with us',
  description = 'Get occasional research news, new course announcements, and practical guidance for better health evidence.',
  placeholder = 'Your email address',
  buttonLabel = 'Join the list',
  privacyNote = 'One useful email a month. No advertising. Leave whenever you like.',
} = Astro.props;
---

<section class="newsletter">
  <div class="newsletter__inner">
    <div class="newsletter__content">
      <h2 class="newsletter__heading">{title}</h2>
      {description && <p class="newsletter__text">{description}</p>}

    <form
        method="post"
        action="/api/newsletter/subscribe/"
        hx-post="/api/newsletter/subscribe/"
        hx-target="#newsletter-feedback"
        hx-swap="innerHTML"
        hx-indicator="#newsletter-spinner"
        class="newsletter__form"
      >
        <label for="newsletter-email" class="sr-only">Email address</label>
        <input
          id="newsletter-email"
          type="email"
          name="email"
          required
          placeholder={placeholder}
          class="newsletter__input"
        />
        <button type="submit" class="btn-primary shrink-0">
          <span id="newsletter-spinner" class="htmx-indicator newsletter__spinner mr-1 inline-block h-3 w-3 border-2 border-current" aria-hidden="true"></span>
          {buttonLabel}
        </button>
      </form>

      <div id="newsletter-feedback" class="newsletter__feedback"></div>

      {privacyNote && <p class="newsletter__privacy">{privacyNote}</p>}
    </div>
  </div>
</section>

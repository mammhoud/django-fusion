---
import { publicHref } from '@/lib/site';

interface Crumb {  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

/**
 * Breadcrumb trail — BEM block adapted from the archive theme's
 * ``fu-breadcrumb__list``. Renders ``Home / Section / Page`` with the current
 * page as the final, non-linked crumb. Used above the page header/CTA so every
 * subpage keeps its place in the site tree.
 */
const { items = [] } = Astro.props;
---

{items.length ? (
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol class="breadcrumb__list">
      {items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li class:list={['breadcrumb__item', isLast ? 'breadcrumb__item--active' : '']}>
            {item.href && !isLast ? (
              <a class="breadcrumb__link" href={publicHref(item.href)}>{item.label}</a>
            ) : (
              <span class="breadcrumb__current" aria-current={isLast ? 'page' : undefined}>{item.label}</span>
            )}
            {!isLast && <span class="breadcrumb__sep" aria-hidden="true">/</span>}
          </li>
        );
      })}
    </ol>
  </nav>
) : null}

<style is:global>
  .breadcrumb { margin-bottom: 1.25rem; }
  .breadcrumb__list { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; padding: 0; margin: 0; list-style: none; }
  .breadcrumb__item { display: inline-flex; align-items: center; gap: 0.45rem; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; }
  .breadcrumb__link { color: hsl(var(--fu-muted)); text-decoration: none; transition: color 0.3s ease; }
  .breadcrumb__link:hover { color: hsl(var(--fu-link)); }
  .breadcrumb__current { color: hsl(var(--fu-ink)); }
  .breadcrumb__item--active .breadcrumb__current { color: hsl(var(--fu-link)); }
  .breadcrumb__sep { color: hsl(var(--fu-line-strong, var(--fu-line))); }
  .breadcrumb--on-dark .breadcrumb__link { color: hsl(var(--fu-paper) / 0.7); }
  .breadcrumb--on-dark .breadcrumb__link:hover { color: hsl(var(--fu-paper)); }
  .breadcrumb--on-dark .breadcrumb__current { color: hsl(var(--fu-paper)); }
  .breadcrumb--on-dark .breadcrumb__sep { color: hsl(var(--fu-paper) / 0.4); }
</style>

---
import Accordion from '@/components/ui/Accordion.astro';
import Skeleton from '@/components/ui/Skeleton.astro';

interface Props {
  heading?: string;
  intro?: string;
  items?: { question: string; answer: string }[];
  /** Whether to render the search bar. */
  searchable?: boolean;
}

const defaultItems = [
  {
    question: 'What does CTC Research offer?',
    answer:
      'CTC Research is a global center of excellence advancing health and well-being through clinical research, evidence synthesis, and health innovation — learning paths, research programs, and evidence services.',
  },
  {
    question: 'Do I need a research background?',
    answer:
      'No. Courses are structured for clinicians, biostatisticians, and medical writers, with beginner-friendly paths that build toward advanced methods.',
  },
  {
    question: 'How do the learning paths work?',
    answer:
      'Each path is self-paced with clear modules, preview lessons, and a visible next action. Progress and certificates stay in one learner account.',
  },
  {
    question: 'Can teams or institutions partner with the center?',
    answer:
      'Yes. Contact us about research collaboration, team learning cohorts, and custom programs for your organization.',
  },
  {
    question: 'Is the content evidence-based?',
    answer:
      'Yes. Methods follow reproducible research standards — good clinical practice, publication integrity, and rigorous research practices.',
  },
];

const {
  heading = 'Questions, answered clearly',
  intro = 'Direct answers about courses, research programs, and working with the center.',
  items = defaultItems,
  searchable = true,
} = Astro.props;

/** Items serialised into the Alpine scope so filtering + counter share one source of truth. */
const itemsJson = JSON.stringify(items);
---

<section id="faq" class="faq" data-localized-block="faq">
  <div class="container-fusion">
    <div class="faq__header">
      <p class="tag-marker mb-4">faq</p>
      {heading && <h2 class="page-section__title">{heading}</h2>}
      {intro && <p class="text-fu-muted">{intro}</p>}
    </div>

    <div data-hydrate-skeleton>
      <Skeleton variant="faq-list" count={items.length} />
    </div>

    <div data-hydrate-content class="mx-auto max-w-2xl" x-data={`{ query: '', items: ${itemsJson} }`}>
      {searchable && (
        <div class="faq__search">
          <div class="relative">
            <svg class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-fu-muted/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.3-4.3M17 10a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input
              type="search"
              x-model="query"
              class="input-field !pl-11 !py-3"
              placeholder="Search the FAQ…"
              aria-label="Search frequently asked questions"
            />
          </div>
          <p
            class="mt-3 text-center font-mono text-[0.72rem] uppercase tracking-wider text-fu-muted"
            x-show="query.length > 0"
            x-cloak
            x-text="`${items.filter(i => i.question.toLowerCase().includes(query.toLowerCase()) || i.answer.toLowerCase().includes(query.toLowerCase())).length} match(es)`"
          ></p>
        </div>
      )}

      <div class="faq__list">
        {items.map((item, i) => (
          <div
            x-show={`query === '' || items[${i}].question.toLowerCase().includes(query.toLowerCase()) || items[${i}].answer.toLowerCase().includes(query.toLowerCase())`}
            x-cloak
          >
            <Accordion items={[item]} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

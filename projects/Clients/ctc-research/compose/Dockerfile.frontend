# =============================================================================
# Frontend container for CTC Research (Astro + HTMX + Alpine.js)
# Build context: project root (projects/precis/precis-ctc)
# =============================================================================
FROM node:24-slim AS builder
WORKDIR /app/frontend

ARG PUBLIC_FUSION_API_URL=
ARG PUBLIC_BUILD_API_URL=https://ctc-research.com
ARG PUBLIC_ENABLE_BACKEND=true
ARG PUBLIC_SITE_URL=https://ctc-research.com
ENV PUBLIC_FUSION_API_URL=${PUBLIC_FUSION_API_URL} \
    PUBLIC_BUILD_API_URL=${PUBLIC_BUILD_API_URL} \
    PUBLIC_ENABLE_BACKEND=${PUBLIC_ENABLE_BACKEND} \
    PUBLIC_SITE_URL=${PUBLIC_SITE_URL}

COPY frontend/package*.json ./
RUN npm ci --legacy-peer-deps

COPY frontend/. .
COPY assets/ ../assets/
# astro.config.mjs maps @fusion/* to ../../../libs/django-fusion/js/fusion-js/src
# (i.e. /libs/django-fusion/js/fusion-js/src inside this image). The repo
# fusion-js source is provided as the `fusionjs` additional build context
# (see docker-compose.yml) and copied to that exact path.
COPY --from=fusionjs / /libs/django-fusion/js/fusion-js/src/
RUN mkdir -p /app/frontend/public
RUN npm run build

FROM node:24-slim AS runner
WORKDIR /app/frontend

COPY --from=builder /app/frontend/package*.json ./
COPY --from=builder /app/frontend/astro.config.mjs ./astro.config.mjs
COPY --from=builder /app/frontend/dist ./dist
COPY --from=builder /app/frontend/node_modules ./node_modules

EXPOSE 3002
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "3002", "--allowed-hosts"]

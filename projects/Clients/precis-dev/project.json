{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "precis-dev-assets",
  "root": "projects/precis/precis-dev",
  "projectType": "library",
  "tags": ["product:precis-dev", "type:assets", "stack:webpack"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["assets", "^production"],
      "cache": true,
      "options": { "command": "npm run build", "cwd": "projects/precis/precis-dev" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run dev", "cwd": "projects/precis/precis-dev" }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run clean", "cwd": "projects/precis/precis-dev" }
    },
    "redeploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if [ -f docker-compose.override.yml ]; then docker compose -f docker-compose.yml -f docker-compose.override.yml up -d --build; else docker compose -f docker-compose.yml up -d --build; fi",
        "cwd": "projects/precis/precis-dev"
      }
    },
    "cleanup": {
      "executor": "nx:run-commands",
      "options": { "command": "make -C ../../.. cleanup", "cwd": "projects/precis/precis-dev" }
    }
  }
}

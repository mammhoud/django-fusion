---
/**
 * ProductGrid — a catalog grid whose single source of truth is the Redux
 * products slice.
 *
 * Rendering contract (progressive enhancement, no SEO/FOUC regression):
 *   - SSR: the grid is rendered from the `products` prop at build time using
 *     the shared `product-markup` module, so the static HTML carries the
 *     real catalog (indexable, visible without JS).
 *   - Client: the `productGrid` Alpine component (registered in alpine.js)
 *     reads `selectProducts` from the store and re-renders the grid from
 *     Redux whenever the catalog changes (store.subscribe). The SSR key is
 *     compared to the store key on mount — identical catalogs are left
 *     untouched, so there is no reveal flash or layout jump.
 *
 * `excludeSlug` lets a page render one product separately (e.g. the featured
 * card on /products/) while the grid stays in sync with the full store
 * catalog minus that slug.
 *
 * Pages keep their own section headers; this component is the grid only.
 */
import { productGridMarkup, productSlugKey } from '@/lib/product-markup';
import type { ProductCard } from '@/lib/store/productsSlice';

interface Props {
  /** Catalog to render at SSR time (pageData.products or the snippet catalog). */
  products?: ProductCard[];
  /** Slug excluded from the client re-render (rendered separately by the page). */
  excludeSlug?: string;
  /**
   * Full multilingual snippet catalog to seed the Redux products slice with
   * (en + ar rows). When provided, the client grid's source of truth becomes
   * this catalog (filtered by `filter`), not init.ts's English-only
   * pageData.products bridge. Keeps SSR and client identical on first paint.
   */
  catalog?: ProductCard[];
  /** Default language filter applied to `catalog` on the client. */
  filter?: string;
  /** Grid wrapper classes — defaults to the shared catalog grid. */
  className?: string;
}

const {
  products = [],
  excludeSlug = '',
  catalog,
  filter = '',
  className = 'grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3',
} = Astro.props;

const ssrKey = productSlugKey(products);
const markup = products.length ? productGridMarkup(products) : '';
const configJson = JSON.stringify({ ssrKey, excludeSlug, catalog: catalog ?? null, filter });
---

<div x-data={`productGrid(${configJson})`} data-product-grid>
  <!-- Quiet empty state — swapped into the target by the client when the
       store catalog is (or becomes) empty. Lives OUTSIDE the replaced
       target so innerHTML re-renders never destroy it. -->
  <template data-product-grid-empty>
    <p class="col-span-full rounded-xl border border-fu-line bg-fu-card p-8 text-center text-sm text-fu-muted">
      The product catalog is not available right now.
    </p>
  </template>

  <div class={className} data-product-grid-target aria-live="polite">
    {markup ? (
      <Fragment set:html={markup} />
    ) : (
      <p class="col-span-full rounded-xl border border-fu-line bg-fu-card p-8 text-center text-sm text-fu-muted">
        The product catalog is not available right now.
      </p>
    )}
  </div>
</div>

---
import Layout from '@/layouts/Layout.astro';
import CTA from '@/components/blocks/CTA.astro';
import HtmxBootstrap from '@/components/HtmxBootstrap.astro';
import Toast from '@/components/ui/Toast.astro';
import { cachedSiteSettings, cachedNavigation } from '@/lib/api';
import type { SiteSettings, NavigationData } from '@/lib/api';

let siteSettings: SiteSettings | undefined;
let navData: NavigationData | undefined;
try {
  [siteSettings, navData] = await Promise.all([cachedSiteSettings(), cachedNavigation()]);
} catch { /* use static presentation fallbacks */ }
---

<Layout title="Cloud Engineering for Confident Scale" description="Make cloud infrastructure repeatable, observable, and ready for the next release with practical platform engineering." navItems={navData?.nav_items} siteSettings={siteSettings} pageSlug="cloud-engineering">
  <section class="section-hero reg-marks overflow-hidden py-20 md:py-28"><div class="container-fusion"><div class="max-w-3xl"><p class="tag-marker mb-5">service · cloud engineering</p><h1 class="font-display text-4xl font-bold tracking-tight text-fu-ink md:text-6xl">Scale the platform without scaling the uncertainty.</h1><p class="mt-6 max-w-2xl text-lg leading-relaxed text-fu-muted">We turn infrastructure, delivery, observability, and recovery into explicit systems your team can inspect, repeat, and improve.</p><div class="mt-8 flex flex-wrap gap-3"><a class="btn-primary" href="/contact/?topic=infrastructure-and-ai-assessment">Book an infrastructure review <span aria-hidden="true">→</span></a><a class="btn-secondary" href="/services/">Explore all services</a></div></div></div></section>
  <section class="doc-sheet bg-fu-card py-20 md:py-28"><div class="container-fusion"><div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4"><article class="card p-6"><p class="tag-marker mb-4">01</p><h2 class="font-display text-xl font-semibold text-fu-ink">Baseline</h2><p class="mt-3 text-sm leading-relaxed text-fu-muted">Understand traffic, dependencies, spend, incidents, and the recovery path.</p></article><article class="card p-6"><p class="tag-marker mb-4">02</p><h2 class="font-display text-xl font-semibold text-fu-ink">Codify</h2><p class="mt-3 text-sm leading-relaxed text-fu-muted">Make environments and delivery changes reviewable through repeatable configuration.</p></article><article class="card p-6"><p class="tag-marker mb-4">03</p><h2 class="font-display text-xl font-semibold text-fu-ink">Observe</h2><p class="mt-3 text-sm leading-relaxed text-fu-muted">Connect meaningful signals to the decisions your team needs to make.</p></article><article class="card p-6"><p class="tag-marker mb-4">04</p><h2 class="font-display text-xl font-semibold text-fu-ink">Handoff</h2><p class="mt-3 text-sm leading-relaxed text-fu-muted">Leave ownership, runbooks, and the next improvement backlog in the open.</p></article></div><div class="mt-16 rounded-xl border border-fu-line bg-fu-ink p-6 text-fu-paper md:p-10"><p class="tag-marker mb-4 text-fu-mark">reference architecture</p><div class="grid gap-3 text-center font-mono text-xs uppercase tracking-[0.12em] sm:grid-cols-5"><span class="rounded-md border border-fu-paper/20 px-3 py-4">Users</span><span class="rounded-md border border-fu-paper/20 px-3 py-4">Edge</span><span class="rounded-md border border-fu-paper/20 px-3 py-4">Platform</span><span class="rounded-md border border-fu-paper/20 px-3 py-4">Services</span><span class="rounded-md border border-fu-paper/20 px-3 py-4">Data</span></div><p class="mt-6 text-sm leading-relaxed text-fu-paper/70">The exact provider can vary. The contract should not: clear ownership, observable behavior, controlled change, and a recovery path.</p></div></div></section>
  <CTA heading="Make the next release easier to trust." intro="Start with an infrastructure review grounded in your current system, not a generic migration checklist." ctaLabel="Book an infrastructure review" ctaHref="/contact/?topic=infrastructure-and-ai-assessment" />
  <Toast /><HtmxBootstrap />
</Layout>

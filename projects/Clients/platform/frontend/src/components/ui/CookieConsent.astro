---
/** Cookie consent banner — Alpine.js managed, localStorage persisted.
 *
 * Shows on first visit. Accept/Deny stored in localStorage.
 * Only renders when consent hasn't been given yet.
 */
interface Props {
  message?: string;
  acceptLabel?: string;
  denyLabel?: string;
  privacyUrl?: string;
  privacyLabel?: string;
}

const {
  message = 'This site uses cookies only for essential functionality. Theme preference and HTMX navigation state. No tracking, no ads.',
  acceptLabel = 'Accept',
  denyLabel = 'Deny',
  privacyUrl = '/privacy/',
  privacyLabel = 'Privacy policy',
} = Astro.props;
---

<div
  x-data="{
    visible: false,
    init() {
      // Sandbox-safe: in a sandboxed iframe (or private/blocked storage)
      // localStorage access throws SecurityError — never let that break
      // the banner. Without storage we show once per page load.
      let stored = null;
      try { stored = localStorage.getItem('cookie-consent'); } catch (e) {}
      if (!stored) this.visible = true;
    },
    accept() {
      try { localStorage.setItem('cookie-consent', 'accepted'); } catch (e) {}
      this.visible = false;
    },
    deny() {
      try { localStorage.setItem('cookie-consent', 'denied'); } catch (e) {}
      this.visible = false;
    },
  }"
  x-show="visible"
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="opacity-0 translate-y-4"
  x-transition:enter-end="opacity-100 translate-y-0"
  x-transition:leave="transition ease-in duration-200"
  x-transition:leave-start="opacity-100 translate-y-0"
  x-transition:leave-end="opacity-0 translate-y-4"
  x-cloak
  class="fixed bottom-4 left-4 right-4 z-50 mx-auto max-w-2xl rounded-xl border border-fu-line bg-fu-paper p-5 shadow-xl md:bottom-6"
  role="dialog"
  aria-label="Cookie consent"
>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex-1">
      <p class="text-sm leading-relaxed text-fu-muted">
        {message}
        {' '}
        <a href={privacyUrl} class="font-medium text-fu-link underline underline-offset-2 hover:text-fu-ink transition-colors">
          {privacyLabel}
        </a>
      </p>
      <p class="mt-1.5 font-mono text-[0.62rem] uppercase tracking-[0.14em] text-fu-muted">
        accepting sets no tracking · denying keeps the site fully functional
      </p>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <button type="button" @click="deny()" class="btn-secondary !h-9 !px-4 !py-0 text-xs">
        {denyLabel}
      </button>
      <button type="button" @click="accept()" class="btn-primary !h-9 !px-4 !py-0 text-xs">
        {acceptLabel}
      </button>
    </div>
  </div>
</div>

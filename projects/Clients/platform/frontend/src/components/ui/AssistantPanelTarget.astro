---
/**
 * AssistantPanelTarget — the HTMX-requesting region of the assistant panel.
 *
 * Extracted from AssistantPanel.astro so the `<template data-fragment-fallback>`
 * element lives in plain template body (inside a JSX expression the Astro
 * compiler flattens `<template>` content and the emitted code fails to parse).
 *
 * Fires `hx-get` on load; the Django `apps.chat` backend answers the HX-Request
 * header with the compact `/assistant/panel/` fragment. Errors swap in the quiet
 * fallback note via the shared listener in htmx-bootstrap.ts.
 *
 * Reuses `.live-fragment__target` inside `[data-live-fragment]` so the existing
 * `renderFragmentFallback` listener applies without a second error path.
 */
interface Props {
  /** Fully-resolved backend URL for the fragment, e.g. 'http://localhost:8074/assistant/panel/'. */
  endpoint: string;
  /** Backend route (for labels), e.g. '/assistant/panel/'. */
  route: string;
}

const { endpoint, route } = Astro.props;
---

<div
  class="live-fragment__target assistant-panel__mount"
  hx-get={endpoint}
  hx-trigger="load"
  hx-target="this"
  hx-swap="innerHTML"
  data-fragment-endpoint={endpoint}
>
  <!-- Chat-shaped loading skeleton while the backend responds -->
  <div class="assistant-panel__skeleton flex flex-col gap-3 p-6" aria-hidden="true">
    <span class="fusion-skeleton__line self-end rounded-2xl" style="width:45%;height:1.9rem"></span>
    <span class="fusion-skeleton__line rounded-2xl" style="width:72%;height:1.9rem"></span>
    <span class="fusion-skeleton__line self-end rounded-2xl" style="width:56%;height:1.9rem"></span>
    <span class="fusion-skeleton__line rounded-2xl" style="width:64%;height:1.9rem"></span>
    <p class="mt-4 text-center font-mono text-[0.7rem] uppercase tracking-wider text-fu-muted">
      requesting {route} · text/html
    </p>
  </div>

  <!-- Quiet error fallback (swap listener lives in htmx-bootstrap.ts). -->
  <template data-fragment-fallback>
    <p class="assistant-panel__fallback p-6 text-center text-sm text-fu-muted">
      The assistant is not reachable right now (is the Django server running at
      <code class="font-mono">{endpoint}</code>?).
    </p>
  </template>
</div>

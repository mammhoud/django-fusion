---
/** ContentError — shown when backend content is unavailable.
 *  Replaces hardcoded HTML fallbacks with a consistent error state
 *  that links to the 404 page or the home page.
 */
interface Props {
  /** Short description of what content is missing */
  label?: string;
  /** Show a "Back to Home" link */
  showHomeLink?: boolean;
  /** Custom class for the wrapper */
  class?: string;
}
const { label = 'Content not available', showHomeLink = true, class: className = '' } = Astro.props;
---

<div class={`py-14 ${className}`.trim()}>
  <div class="container-fusion">
    <div class="mx-auto max-w-xl text-center">
      <p class="tag-marker mb-5">unavailable</p>
      <div class="mb-4 font-mono text-5xl font-semibold tracking-tight text-fu-link md:text-6xl">503</div>
      <h2 class="mb-4 font-display text-2xl font-bold tracking-tight text-fu-ink">
        {label}
      </h2>
      <p class="mb-8 text-fu-muted">
        This content is currently unavailable. The backend may be down or the
        requested data could not be loaded. Please try again later.
      </p>
      <div class="flex flex-col justify-center gap-3 sm:flex-row">
        {
          showHomeLink && (
            <a href="/" class="btn-secondary !px-7 !py-3">Back to Home</a>
          )
        }
        <a href="/contact/" class="btn-primary !px-7 !py-3">Contact Support</a>
      </div>
    </div>
  </div>
</div>

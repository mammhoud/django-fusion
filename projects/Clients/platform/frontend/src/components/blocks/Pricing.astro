---
import PricingCard from '@/components/ui/PricingCard.astro';

export interface Plan {
  name: string;
  price: string;
  period: string;
  description: string;
  features: string[];
  highlighted?: boolean;
  cta: { label: string; href: string };
}

interface Props {
  heading?: string;
  intro?: string;
  plans?: Plan[];
  /** Render the pricing grid without its own <section> wrapper (used when folded into Features). */
  folded?: boolean;
}

const defaultPlans: Plan[] = [
  {
    name: 'Open source',
    price: '$0',
    period: 'where available',
    description: 'For exploring the public libraries and products that offer a self-hosted edition.',
    features: [
      'Public source code',
      'Self-hosted documentation',
      'Core product capabilities',
      'Product-specific licensing',
    ],
    cta: { label: 'Explore products', href: '/products/' },
  },
  {
    name: 'Pro',
    price: 'From $29',
    period: 'per month',
    description: 'For teams that need production workflows and room to grow.',
    highlighted: true,
    features: [
      'Production-ready capabilities',
      'Priority support options',
      'Advanced analytics where included',
      'Deployment guidance',
      'Product-specific feature set',
    ],
    cta: { label: 'Go Pro', href: '/contact/' },
  },
  {
    name: 'Business',
    price: 'Custom',
    period: 'per deployment',
    description: 'For organizations that need governance, integrations, or managed delivery.',
    features: [
      'Organization workflows',
      'Roles and permissions where included',
      'Custom branding options',
      'API and integration support',
      'Deployment and success support',
    ],
    cta: { label: 'Contact sales', href: '/contact/' },
  },
];

const {
  heading = 'Pricing, printed clearly',
  intro = 'Edition names and availability vary by product. Compare the catalog before choosing the right path.',
  plans = defaultPlans,
  folded = false,
} = Astro.props;
---

{folded ? (
  <div id="pricing" class="mt-16 sm:mt-20 border-t border-fu-line pt-14 sm:pt-16">
    <div class="pricing__header">
      <h2 class="page-section__title">{heading}</h2>
      <p class="text-fu-muted">{intro}</p>
    </div>

    <div class="pricing__grid">
      {plans.map((plan) => <PricingCard plan={plan} />)}
    </div>
  </div>
) : (
  <section id="pricing" class="pricing">
    <div class="container-fusion">
      <div class="pricing__header">
        <h2 class="page-section__title">{heading}</h2>
        <p class="text-fu-muted">{intro}</p>
      </div>

      <div class="pricing__grid">
        {plans.map((plan) => <PricingCard plan={plan} />)}
      </div>
    </div>
  </section>
)}

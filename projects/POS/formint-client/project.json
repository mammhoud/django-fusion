{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "formint-client",
  "root": "projects/formints/formint-client",
  "projectType": "application",
  "tags": ["product:formint-client", "type:frontend", "stack:tauri+vue"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build", "cwd": "projects/formints/formint-client" }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run lint", "cwd": "projects/formints/formint-client" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run dev", "cwd": "projects/formints/formint-client" }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run preview", "cwd": "projects/formints/formint-client" }
    },
    "tauri": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run tauri dev", "cwd": "projects/formints/formint-client" }
    }
  }
}

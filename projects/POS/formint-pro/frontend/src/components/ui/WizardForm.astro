---
/**
 * WizardForm — reusable multi-step wizard (register, checkout, onboarding).
 *
 * Steps are declared as data (title + optional description); each step body
 * is provided by the parent via named slots (`step-0`, `step-1`, …). The
 * wizard owns navigation, progress, per-step validation, and a final submit.
 *
 * Astro requires static slot names, so step bodies are enumerated up to 10
 * (`step-0` … `step-9`); only the active panel is visible via x-show.
 *
 * Usage:
 *   <WizardForm steps={[
 *     { title: 'Details', description: 'Business basics' },
 *     { title: 'Catalog', description: 'Products & categories' },
 *     { title: 'Confirm', description: 'Review & save' },
 *   ]} formKey="setupWizard" @submit="onWizardSubmit">
 *     <div slot="step-0"><FusionForm resource="supplier" formKey="wiz1" /></div>
 *     <div slot="step-1"><FusionForm resource="product" formKey="wiz2" /></div>
 *     <div slot="step-2">…summary…</div>
 *   </WizardForm>
 *
 * The component registers Alpine data `wizardForm` exposing:
 *   - `current`, `steps`, `goNext()`, `goBack()`, `validateStep(i)`
 *   - `submit()` — final submit hook passed via `onFinish`
 *   - progress %, keyboard (←/→) and reduced-motion aware transitions
 */
interface Step {
  title: string;
  description?: string;
  icon?: string;
}

interface Props {
  steps: Step[];
  formKey?: string;
  class?: string;
  'data-skeleton-label'?: string;
}

const { steps, formKey = 'setupWizard', class: className = '', 'data-skeleton-label': skeletonLabel } = Astro.props;
const stepData = JSON.stringify(steps);
---

<div
  class={`wizard ${className}`.trim()}
  x-data="wizardForm({
    steps: JSON.parse($el.dataset.steps),
    formKey: $el.dataset.formKey || 'setupWizard',
  })"
  x-init="init()"
  data-steps={stepData}
  data-form-key={formKey}
  data-skeleton-label={skeletonLabel}
  x-cloak
>
  <!-- Progress rail -->
  <ol class="wizard__rail" aria-label="Wizard steps">
    <template x-for="(step, i) in steps" :key="i">
      <li class="wizard__step" :class="{ 'wizard__step--active': i === current, 'wizard__step--done': i < current }">
        <button
          type="button"
          class="wizard__step-btn"
          @click="goTo(i)"
          :aria-current="i === current ? 'step' : undefined"
          :disabled="i > current && !allowJumpAhead"
        >
          <span class="wizard__step-indicator" x-text="i < current ? '✓' : i + 1"></span>
          <span class="wizard__step-text">
            <span class="wizard__step-title" x-text="step.title"></span>
            <span class="wizard__step-desc" x-show="step.description" x-text="step.description"></span>
          </span>
        </button>
      </li>
    </template>
  </ol>

  <!-- Progress bar -->
  <div class="wizard__progress" aria-hidden="true">
    <div class="wizard__progress-bar" :style="`width: ${progress}%`"></div>
  </div>

  <!-- Step bodies (parent slots). Astro requires static slot names, so panels
       are enumerated up to MAX_STEPS; parents only define the slots they use
       and Alpine hides the rest (x-show). -->
  <div class="wizard__body" :key="current">
    <div x-show="current === 0" x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-3" x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0 translate-y-2" role="tabpanel" aria-label={steps[0]?.title}>
      <slot name="step-0" />
    </div>
    <div x-show="current === 1" x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-3" x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0 translate-y-2" role="tabpanel" aria-label={steps[1]?.title}>
      <slot name="step-1" />
    </div>
    <div x-show="current === 2" x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-3" x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0 translate-y-2" role="tabpanel" aria-label={steps[2]?.title}>
      <slot name="step-2" />
    </div>
    <div x-show="current === 3" x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-3" x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0 translate-y-2" role="tabpanel" aria-label={steps[3]?.title}>
      <slot name="step-3" />
    </div>
    <div x-show="current === 4" x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-3" x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0 translate-y-2" role="tabpanel" aria-label={steps[4]?.title}>
      <slot name="step-4" />
    </div>
    <div x-show="current === 5" x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-3" x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0 translate-y-2" role="tabpanel" aria-label={steps[5]?.title}>
      <slot name="step-5" />
    </div>
    <div x-show="current === 6" x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-3" x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0 translate-y-2" role="tabpanel" aria-label={steps[6]?.title}>
      <slot name="step-6" />
    </div>
    <div x-show="current === 7" x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-3" x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0 translate-y-2" role="tabpanel" aria-label={steps[7]?.title}>
      <slot name="step-7" />
    </div>
    <div x-show="current === 8" x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-3" x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0 translate-y-2" role="tabpanel" aria-label={steps[8]?.title}>
      <slot name="step-8" />
    </div>
    <div x-show="current === 9" x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-3" x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0 translate-y-2" role="tabpanel" aria-label={steps[9]?.title}>
      <slot name="step-9" />
    </div>
  </div>

  <!-- Footer navigation -->
  <div class="wizard__footer">
    <div class="flex items-center gap-2 text-xs opacity-60">
      <span x-text="`Step ${current + 1} of ${steps.length}`"></span>
    </div>
    <div class="flex gap-2">
      <button type="button" class="btn btn-ghost btn-sm" @click="goBack()" x-show="current > 0" :disabled="submitting">
        ← Back
      </button>
      <button
        type="button"
        class="btn btn-primary btn-sm gap-1"
        @click="goNext()"
        :disabled="submitting"
        x-text="current === steps.length - 1 ? (submitting ? 'Saving…' : 'Finish') : 'Next →'"
      ></button>
    </div>
  </div>
</div>

<script>
  import Alpine from 'alpinejs';

  document.addEventListener('alpine:init', () => {
    Alpine.data('wizardForm', (config: any) => ({
      steps: config.steps,
      formKey: config.formKey,
      current: 0,
      submitting: false,
      allowJumpAhead: true,
      onFinish: null as ((data: any) => void | Promise<void>) | null,

      get progress() {
        return ((this.current + 1) / this.steps.length) * 100;
      },

      init() {
        // Keyboard nav (alt+arrows) — no-op when typing in a field.
        window.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.altKey && e.key === 'ArrowRight') this.goNext();
          if (e.altKey && e.key === 'ArrowLeft') this.goBack();
        });
        // Expose the instance so the owning page can wire onFinish without
        // reaching into Alpine internals: el.__wizard = this.
        const el: any = this.$el;
        if (el) el.__wizard = this;
      },

      validateStep(i: number): boolean {
        // Find any nested FusionForm in the step and validate it.
        const el = document.querySelector(`[data-form-key="${this.formKey}"] .wizard__body`);
        if (!el) return true;
        const stepEl = el.children[i] as HTMLElement | undefined;
        if (!stepEl) return true;
        const forms = stepEl.querySelectorAll('[x-data^="fusionFormComp"]');
        let valid = true;
        forms.forEach((f: HTMLElement) => {
          const alpine: any = (f as any)._x_dataStack?.[0];
          if (alpine?.validate && !alpine.validate()) valid = false;
        });
        return valid;
      },

      goTo(i: number) {
        if (i > this.current && !this.allowJumpAhead) return;
        if (i < 0 || i >= this.steps.length || i === this.current) return;
        this.current = i;
      },

      goBack() {
        if (this.current > 0) this.current -= 1;
      },

      async goNext() {
        if (this.current === this.steps.length - 1) {
          await this.finish();
          return;
        }
        if (!this.validateStep(this.current)) return;
        this.current += 1;
      },

      async finish() {
        this.submitting = true;
        try {
          // Fire a DOM event so parents can bind @wizard:finish on the wizard
          // element (no Alpine store / internals required).
          this.$el.dispatchEvent(new CustomEvent('wizard:finish', { detail: { wizard: this.formKey } }));
          if (this.onFinish) await this.onFinish({ wizard: this.formKey });
        } finally {
          this.submitting = false;
        }
      },
    }));
  });
</script>

<style>
  .wizard { display: grid; gap: 1.25rem; }
  .wizard__rail { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0; padding: 0; }
  .wizard__step { flex: 1 1 10rem; min-width: 9rem; }
  .wizard__step-btn {
    display: flex; align-items: center; gap: 0.625rem; width: 100%;
    padding: 0.625rem 0.75rem; border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-field); background: var(--color-surface-card);
    color: var(--color-text-secondary); cursor: pointer;
    transition: border-color var(--transition-fast), color var(--transition-fast), box-shadow var(--transition-fast);
    text-align: left;
  }
  .wizard__step-btn:hover:not(:disabled) { border-color: var(--color-primary); color: var(--color-text-primary); }
  .wizard__step-btn:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .wizard__step--active .wizard__step-btn {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-focus-ring);
  }
  .wizard__step--done .wizard__step-btn { border-color: var(--color-success); }
  .wizard__step-indicator {
    flex: none; width: 1.6rem; height: 1.6rem; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 0.7rem; font-weight: 800;
    background: var(--color-surface-raised); color: var(--color-text-secondary);
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .wizard__step--active .wizard__step-indicator {
    background: var(--color-primary); color: var(--color-primary-content);
  }
  .wizard__step--done .wizard__step-indicator {
    background: var(--color-success); color: var(--color-success-content);
  }
  .wizard__step-text { display: grid; gap: 0.1rem; min-width: 0; }
  .wizard__step-title { font-size: 0.8rem; font-weight: 700; color: var(--color-text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wizard__step-desc { font-size: 0.68rem; opacity: 0.6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wizard__progress { height: 0.25rem; border-radius: 999px; background: var(--color-surface-raised); overflow: hidden; }
  .wizard__progress-bar {
    height: 100%; border-radius: inherit;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    transition: width var(--transition-slow) cubic-bezier(0.32, 0.72, 0, 1);
  }
  .wizard__body { min-height: 12rem; }
  .wizard__footer {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding-top: 1rem; border-top: 1px solid var(--color-border-subtle);
  }
  @media (prefers-reduced-motion: reduce) {
    .wizard__progress-bar, .wizard__step-btn { transition: none; }
  }
</style>

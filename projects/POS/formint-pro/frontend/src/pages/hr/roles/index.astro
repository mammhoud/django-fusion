---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/ui/Icon.astro';
---

<Layout title="Roles - Formint POS">
  <div x-data="rolesPage()" x-init="load()" class="max-w-[96rem] mx-auto p-4">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
      <h1 class="flex items-center gap-2 text-lg font-extrabold" style="color: var(--color-text-primary)">
        <Icon name="shield" class="h-5 w-5" style="color: var(--color-chart-3)" />
        Roles & Permissions
      </h1>
      <div class="flex flex-wrap items-center gap-2">
        <input type="search" x-model="search" @input="page=1" placeholder="Search roles..." class="input flex-1 sm:w-56 text-xs" />
        <button @click="openAdd()" class="btn btn-primary btn-sm gap-1"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plus" /></svg> New Role</button>
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-4">
      <div class="stat-card"><span class="stat-card__title">Total Roles</span><span class="stat-card__value" x-text="total" style="color: var(--color-primary)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Active</span><span class="stat-card__value" x-text="activeCount" style="color: var(--color-success)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Permission Flags</span><span class="stat-card__value" x-text="totalPerms" style="color: var(--color-info)">0</span></div>
    </div>
    <div x-show="loading" class="space-y-2"><template x-for="i in 5" :key="i"><div class="skeleton-shimmer h-10 rounded"></div></template></div>
    <div x-show="!loading && filteredItems.length===0" class="text-center py-12 opacity-50 text-sm">No roles defined.</div>
    <div x-show="!loading && filteredItems.length>0" class="card overflow-x-auto">
      <table class="data-table" role="grid">
        <thead><tr><th>ID</th><th>Name</th><th>Description</th><th>Permissions</th><th>Status</th><th class="w-20">Actions</th></tr></thead>
        <tbody>
          <template x-for="item in pagedItems()" :key="item.id">
            <tr class="cursor-pointer hover:bg-[var(--color-surface-hover)]">
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.id"></span></td>
              <td class="px-3 py-2"><span class="text-xs font-medium" x-text="item.name"></span></td>
              <td class="px-3 py-2"><span class="text-xs opacity-60" x-text="item.description || '-'" ></span></td>
              <td class="px-3 py-2"><div class="flex flex-wrap gap-1">
                <template x-for="(val, key) in item.permissions||{}" :key="key">
                  <span class="badge"
                    :class="val ? 'badge-soft-success' : 'badge-soft-neutral'"
                    x-text="key.replace('can_','').replace(/_/g,' ')"></span>
                </template>
                <span x-show="!item.permissions || Object.keys(item.permissions).length===0" class="text-xs opacity-40">-</span>
              </div></td>
              <td class="px-3 py-2"><span class="badge" :class="item.is_active?'badge-soft-success':'badge-soft-error'" x-text="item.is_active?'Active':'Inactive'"></span></td>
              <td class="px-3 py-2"><div class="flex gap-1">
                <button @click.stop="openEdit(item)" class="btn btn-ghost btn-xs px-1.5" title="Edit" aria-label="Edit"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-pencil" /></svg></button>
                <button @click.stop="confirmDelete(item)" class="btn btn-ghost btn-xs px-1.5" title="Delete" aria-label="Delete"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-trash" /></svg></button>
              </div></td>
            </tr>
          </template>
        </tbody>
      </table>
      <div class="flex items-center justify-between p-3 border-t border-[var(--color-border-subtle)] text-xs">
        <span x-text="'Showing ' + ((page-1)*perPage + 1) + '-' + Math.min(page*perPage, filteredItems.length) + ' of ' + filteredItems.length"></span>
        <div class="flex gap-1">
          <button @click="page=Math.max(1,page-1)" :disabled="page===1" class="btn btn-ghost btn-xs">&larr; Prev</button>
          <button @click="page++" :disabled="page*perPage>=filteredItems.length" class="btn btn-ghost btn-xs">Next &rarr;</button>
        </div>
      </div>
    </div>

    <div x-show="deleteTarget" x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-black/40" @click.self="deleteTarget=null">
      <div class="card max-w-sm mx-4 p-6 text-center space-y-4">
        <p class="font-semibold">Delete role?</p>
        <p class="text-sm opacity-60" x-text="deleteTarget?.name"></p>
        <div class="flex gap-2 justify-center">
          <button @click="deleteTarget=null" class="btn btn-ghost btn-sm">Cancel</button>
          <button @click="doDelete()" class="btn btn-error btn-sm">Delete</button>
        </div>
      </div>
    </div>

    <div x-show="formOpen" x-transition.opacity.duration.200ms class="fixed inset-0 z-[60] flex items-start justify-center pt-[8vh] bg-black/50 px-4 overflow-y-auto" @click.self="closeForm()" @keydown.escape.window="closeForm()">
      <div class="card w-full max-w-lg p-6 space-y-5 shadow-2xl" x-transition.scale.90.duration.200ms @click.stop>
        <div class="flex items-center justify-between"><h2 class="text-base font-bold" x-text="editingItem ? 'Edit Role' : 'New Role'"></h2><button @click="closeForm()" class="btn btn-ghost btn-sm" aria-label="Close"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-x" /></svg></button></div>
        <div class="grid grid-cols-1 gap-4">
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Name *</label><input type="text" x-model="form.name" class="input w-full" placeholder="e.g. Shift Manager" required /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Description</label><textarea x-model="form.description" class="input w-full" rows="2" placeholder="What this role can do…"></textarea></div>
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Permissions (JSON)</label>
            <textarea x-model="form.permissions_json" class="input w-full font-mono text-xs" rows="4" spellcheck="false" placeholder='{"can_manage_products": true, "can_view_reports": false}'></textarea>
            <p class="text-[11px] opacity-40 mt-1">Flags are stored as-is and shown as badges on the list.</p>
          </div>
          <div class="flex items-center gap-2"><input type="checkbox" x-model="form.is_active" class="rounded" /><label class="text-xs font-medium opacity-70">Active role</label></div>
        </div>
        <div class="flex gap-2 justify-end pt-2 border-t border-[var(--color-border-subtle)]"><button @click="closeForm()" class="btn btn-ghost btn-sm" :disabled="formSaving">Cancel</button><button @click="doSave()" class="btn btn-primary btn-sm gap-1" :disabled="formSaving"><span x-show="formSaving" class="inline-block h-3 w-3 animate-spin rounded-full border-2 border-current border-t-transparent"></span><span x-text="editingItem ? 'Update' : 'Create'"></span></button></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  document.addEventListener('alpine:init', () => {
    Alpine.data('rolesPage', () => ({
      items: [], loading: true, search: '', page: 1, perPage: 20, deleteTarget: null,
      formOpen: false, formSaving: false, editingItem: null,
      form: { name: '', description: '', permissions_json: '{}', is_active: true },
      get total() { return this.items.length; },
      get activeCount() { return this.items.filter((i: any) => i.is_active).length; },
      get totalPerms() { return this.items.reduce((s: number, i: any) => s + Object.keys(i.permissions||{}).length, 0); },
      get filteredItems() { let l = this.items; if (this.search) { const q = this.search.toLowerCase(); l = l.filter((i: any) => Object.values(i).some(v => String(v).toLowerCase().includes(q))); } return l; },
      pagedItems() { const s = (this.page-1)*this.perPage; return this.filteredItems.slice(s, s+this.perPage); },
      async load() { this.loading=true; try { const r = await fetch('/roles/'); if (r.ok) { const d = await r.json(); this.items = d.data || d || []; } } catch(e){} finally { this.loading=false; } },
      resetForm() { this.form = { name: '', description: '', permissions_json: '{}', is_active: true }; this.editingItem = null; },
      openAdd() { this.resetForm(); this.formOpen = true; },
      openEdit(item: any) { this.resetForm(); this.editingItem = item; this.form = { name: item.name || '', description: item.description || '', permissions_json: JSON.stringify(item.permissions || {}, null, 2), is_active: item.is_active !== false }; this.formOpen = true; },
      closeForm() { if (this.formSaving) return; this.formOpen = false; this.resetForm(); },
      async doSave() {
        if (!this.form.name.trim()) { this.$store.ui.toast('Role name is required', 'error'); return; }
        let permissions: Record<string, boolean> = {};
        try { permissions = JSON.parse(this.form.permissions_json || '{}'); if (typeof permissions !== 'object' || permissions === null || Array.isArray(permissions)) throw new Error('not-an-object'); }
        catch { this.$store.ui.toast('Permissions must be a JSON object, e.g. {"can_manage_products": true}', 'error'); return; }
        this.formSaving = true;
        const p = { name: this.form.name, description: this.form.description, permissions, is_active: this.form.is_active };
        try {
          let r;
          if (this.editingItem) { r = await fetch('/roles/' + this.editingItem.id + '/', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(p) }); }
          else { r = await fetch('/roles/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(p) }); }
          if (r.ok) { this.$store.ui.toast(this.editingItem ? 'Role updated' : 'Role created', 'success'); this.closeForm(); await this.load(); }
          else { const e = await r.text(); this.$store.ui.toast('Save failed: ' + (e || r.status), 'error'); }
        } catch(e) { this.$store.ui.toast('Network error', 'error'); }
        finally { this.formSaving = false; }
      },
      confirmDelete(item: any) { this.deleteTarget = item; },
      async doDelete() { if (!this.deleteTarget) return; const id = this.deleteTarget.id; const name = this.deleteTarget.name; this.deleteTarget = null; try { await fetch('/roles/' + id + '/', { method: 'DELETE' }); this.items = this.items.filter((i: any) => i.id !== id); this.$store.ui.toast('Role "' + name + '" deleted', 'success'); } catch(e) { this.$store.ui.toast('Failed', 'error'); } },
    }));
  });
</script>

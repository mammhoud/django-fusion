---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/ui/Icon.astro';
---

<Layout title="Payroll - Formint POS">
  <div x-data="payrollPage()" x-init="load()" class="max-w-[96rem] mx-auto p-4">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
      <h1 class="flex items-center gap-2 text-lg font-extrabold" style="color: var(--color-text-primary)">
        <Icon name="wallet" class="h-5 w-5" style="color: var(--color-chart-3)" />
        Payroll
      </h1>
      <div class="flex flex-wrap items-center gap-2">
        <input type="search" x-model="search" @input="page=1" placeholder="Search by employee..." class="input flex-1 sm:w-56 text-xs" />
        <button @click="openAdd()" class="btn btn-primary btn-sm gap-1"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plus" /></svg> New Record</button>
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
      <div class="stat-card"><span class="stat-card__title">Records</span><span class="stat-card__value" x-text="total" style="color: var(--color-primary)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Paid</span><span class="stat-card__value" x-text="paidCount" style="color: var(--color-success)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Draft</span><span class="stat-card__value" x-text="draftCount" style="color: var(--color-warning)">0</span></div>
      <div class="stat-card"><span class="stat-card__title">Total Paid</span><span class="stat-card__value" x-text="'$' + totalPaid" style="color: var(--color-info)">$0</span></div>
    </div>
    <div class="flex flex-wrap gap-1 mb-3">
      <template x-for="s in ['All','draft','calculated','approved','paid']" :key="s">
        <button @click="filterStatus = s==='All'?'':s; page=1" :class="'btn btn-xs '+((filterStatus||'All')===s?'btn-primary':'btn-ghost')" x-text="s==='All'?'All':s.charAt(0).toUpperCase()+s.slice(1)"></button>
      </template>
    </div>
    <div x-show="loading" class="space-y-2"><template x-for="i in 5" :key="i"><div class="skeleton-shimmer h-10 rounded"></div></template></div>
    <div x-show="!loading && filteredItems.length===0" class="text-center py-12 opacity-50 text-sm">No payroll records.</div>
    <div x-show="!loading && filteredItems.length>0" class="card overflow-x-auto">
      <table class="data-table" role="grid">
        <thead><tr><th>ID</th><th>Employee</th><th>Period</th><th>Hours</th><th>Rate/hr</th><th>Gross</th><th>Net</th><th>Status</th><th class="w-20">Actions</th></tr></thead>
        <tbody>
          <template x-for="item in pagedItems()" :key="item.id">
            <tr class="cursor-pointer hover:bg-[var(--color-surface-hover)]">
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.id"></span></td>
              <td class="px-3 py-2"><span class="text-xs font-medium" x-text="empName(item.employee) || 'Employee #'+item.employee"></span></td>
              <td class="px-3 py-2"><span class="text-xs" x-text="item.period_start + ' → ' + item.period_end"></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="item.regular_hours != null ? Number(item.regular_hours) + (Number(item.overtime_hours||0) ? ' + ' + item.overtime_hours + ' ot' : '') : '-'" ></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="'$'+(Number(item.base_salary)||0).toFixed(2)"></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums font-medium" x-text="'$'+(Number(item.total_pay)||0).toFixed(2)"></span></td>
              <td class="px-3 py-2"><span class="text-xs tabular-nums" x-text="'$'+(Number(item.net_pay)||0).toFixed(2)"></span></td>
              <td class="px-3 py-2">
                <span class="badge"
                  :class="{ 'badge-soft-neutral': item.status==='draft', 'badge-soft-info': item.status==='calculated', 'badge-soft-warning': item.status==='approved', 'badge-soft-success': item.status==='paid' }"
                  x-text="item.status"></span>
              </td>
              <td class="px-3 py-2"><div class="flex gap-1">
                <button @click.stop="openEdit(item)" class="btn btn-ghost btn-xs px-1.5" title="Edit" aria-label="Edit"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-pencil" /></svg></button>
                <button @click.stop="confirmDelete(item)" class="btn btn-ghost btn-xs px-1.5" title="Delete" aria-label="Delete"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-trash" /></svg></button>
              </div></td>
            </tr>
          </template>
        </tbody>
      </table>
      <div class="flex items-center justify-between p-3 border-t border-[var(--color-border-subtle)] text-xs">
        <span x-text="'Showing ' + ((page-1)*perPage + 1) + '-' + Math.min(page*perPage, filteredItems.length) + ' of ' + filteredItems.length"></span>
        <div class="flex gap-1">
          <button @click="page=Math.max(1,page-1)" :disabled="page===1" class="btn btn-ghost btn-xs">&larr; Prev</button>
          <button @click="page++" :disabled="page*perPage>=filteredItems.length" class="btn btn-ghost btn-xs">Next &rarr;</button>
        </div>
      </div>
    </div>

    <div x-show="deleteTarget" x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-black/40" @click.self="deleteTarget=null">
      <div class="card max-w-sm mx-4 p-6 text-center space-y-4">
        <p class="font-semibold">Delete payroll record?</p>
        <p class="text-sm opacity-60" x-text="(empName(deleteTarget?.employee) || 'Record #'+deleteTarget?.id) + ' — ' + (deleteTarget?.period_start || '')"></p>
        <div class="flex gap-2 justify-center">
          <button @click="deleteTarget=null" class="btn btn-ghost btn-sm">Cancel</button>
          <button @click="doDelete()" class="btn btn-error btn-sm">Delete</button>
        </div>
      </div>
    </div>

    <div x-show="formOpen" x-transition.opacity.duration.200ms class="fixed inset-0 z-[60] flex items-start justify-center pt-[8vh] bg-black/50 px-4 overflow-y-auto" @click.self="closeForm()" @keydown.escape.window="closeForm()">
      <div class="card w-full max-w-lg p-6 space-y-5 shadow-2xl" x-transition.scale.90.duration.200ms @click.stop>
        <div class="flex items-center justify-between"><h2 class="text-base font-bold" x-text="editingItem ? 'Edit Payroll Record' : 'New Payroll Record'"></h2><button @click="closeForm()" class="btn btn-ghost btn-sm" aria-label="Close"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-x" /></svg></button></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2">
            <label class="text-xs font-medium opacity-70 mb-1 block">Employee *</label>
            <select x-model="form.employee" class="input w-full" required>
              <option value="">Select employee…</option>
              <template x-for="emp in employeeList" :key="emp.id"><option :value="emp.id" x-text="emp.first_name + ' ' + emp.last_name"></option></template>
            </select>
          </div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Period start *</label><input type="date" x-model="form.period_start" class="input w-full" required /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Period end *</label><input type="date" x-model="form.period_end" class="input w-full" required /></div>
          <div>
            <label class="text-xs font-medium opacity-70 mb-1 block">Status</label>
            <select x-model="form.status" class="input w-full">
              <option value="draft">Draft</option>
              <option value="calculated">Calculated</option>
              <option value="approved">Approved</option>
              <option value="paid">Paid</option>
            </select>
          </div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Base salary</label><input type="number" min="0" step="0.01" x-model="form.base_salary" class="input w-full" /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Bonuses</label><input type="number" min="0" step="0.01" x-model="form.bonuses" class="input w-full" /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Deductions</label><input type="number" min="0" step="0.01" x-model="form.deductions" class="input w-full" /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Regular hours</label><input type="number" min="0" step="0.5" x-model="form.regular_hours" class="input w-full" /></div>
          <div><label class="text-xs font-medium opacity-70 mb-1 block">Overtime hours</label><input type="number" min="0" step="0.5" x-model="form.overtime_hours" class="input w-full" /></div>
          <div class="sm:col-span-2"><label class="text-xs font-medium opacity-70 mb-1 block">Notes</label><textarea x-model="form.notes" class="input w-full" rows="2" placeholder="Optional notes"></textarea></div>
          <p class="text-[11px] opacity-40 sm:col-span-2">Net pay is computed automatically as base salary + bonuses − deductions.</p>
        </div>
        <div class="flex gap-2 justify-end pt-2 border-t border-[var(--color-border-subtle)]"><button @click="closeForm()" class="btn btn-ghost btn-sm" :disabled="formSaving">Cancel</button><button @click="doSave()" class="btn btn-primary btn-sm gap-1" :disabled="formSaving"><span x-show="formSaving" class="inline-block h-3 w-3 animate-spin rounded-full border-2 border-current border-t-transparent"></span><span x-text="editingItem ? 'Update' : 'Create'"></span></button></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  document.addEventListener('alpine:init', () => {
    Alpine.data('payrollPage', () => ({
      items: [], employeeList: [], loading: true, search: '', filterStatus: '', page: 1, perPage: 20, deleteTarget: null,
      formOpen: false, formSaving: false, editingItem: null,
      form: { employee: '', period_start: '', period_end: '', status: 'draft', regular_hours: '', overtime_hours: '', base_salary: '', bonuses: '', deductions: '', notes: '' },
      get total() { return this.items.length; },
      get paidCount() { return this.items.filter((i: any) => i.status==='paid').length; },
      get draftCount() { return this.items.filter((i: any) => i.status==='draft').length; },
      get totalPaid() { return this.items.filter((i: any) => i.status==='paid').reduce((s: number, i: any) => s + Number(i.net_pay||0), 0).toFixed(2); },
      get filteredItems() { let l = this.items; if (this.search) { const q = this.search.toLowerCase(); l = l.filter((i: any) => Object.values(i).some(v => String(v).toLowerCase().includes(q))); } if (this.filterStatus) l = l.filter((i: any) => i.status===this.filterStatus); return l; },
      pagedItems() { const s = (this.page-1)*this.perPage; return this.filteredItems.slice(s, s+this.perPage); },
      empName(id: any) { const e = this.employeeList.find((x: any) => String(x.id) === String(id)); return e ? ((e.first_name || '') + ' ' + (e.last_name || '')).trim() : ''; },
      async load() { this.loading=true; try { const [r, e] = await Promise.all([fetch('/payroll/'), fetch('/employees/')]); if (r.ok) { const d = await r.json(); this.items = d.data || d || []; } if (e.ok) { const d = await e.json(); this.employeeList = d.data || d || []; } } catch(e){} finally { this.loading=false; } },
      resetForm() { this.form = { employee: '', period_start: '', period_end: '', status: 'draft', regular_hours: '', overtime_hours: '', base_salary: '', bonuses: '', deductions: '', notes: '' }; this.editingItem = null; },
      openAdd() { this.resetForm(); this.formOpen = true; },
      openEdit(item: any) { this.resetForm(); this.editingItem = item; this.form = { employee: item.employee ?? '', period_start: item.period_start || '', period_end: item.period_end || '', status: item.status || 'draft', regular_hours: item.regular_hours ?? '', overtime_hours: item.overtime_hours ?? '', base_salary: item.base_salary ?? '', bonuses: item.bonuses ?? '', deductions: item.deductions ?? '', notes: item.notes || '' }; this.formOpen = true; },
      closeForm() { if (this.formSaving) return; this.formOpen = false; this.resetForm(); },
      async doSave() {
        if (!this.form.employee) { this.$store.ui.toast('Employee is required', 'error'); return; }
        if (!this.form.period_start || !this.form.period_end) { this.$store.ui.toast('Pay period dates are required', 'error'); return; }
        this.formSaving = true;
        const base = parseFloat(String(this.form.base_salary)) || 0;
        const bonuses = parseFloat(String(this.form.bonuses)) || 0;
        const deductions = parseFloat(String(this.form.deductions)) || 0;
        const net_pay = Math.max(0, Math.round((base + bonuses - deductions) * 100) / 100);
        const p = {
          employee: this.form.employee, period_start: this.form.period_start, period_end: this.form.period_end,
          status: this.form.status,
          regular_hours: parseFloat(String(this.form.regular_hours)) || 0,
          overtime_hours: parseFloat(String(this.form.overtime_hours)) || 0,
          base_salary: base, bonuses, deductions, net_pay,
          notes: this.form.notes,
        };
        try {
          let r;
          if (this.editingItem) { r = await fetch('/payroll/' + this.editingItem.id + '/', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(p) }); }
          else { r = await fetch('/payroll/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(p) }); }
          if (r.ok) { this.$store.ui.toast(this.editingItem ? 'Payroll record updated' : 'Payroll record created', 'success'); this.closeForm(); await this.load(); }
          else { const e = await r.text(); this.$store.ui.toast('Save failed: ' + (e || r.status), 'error'); }
        } catch(e) { this.$store.ui.toast('Network error', 'error'); }
        finally { this.formSaving = false; }
      },
      confirmDelete(item: any) { this.deleteTarget = item; },
      async doDelete() { if (!this.deleteTarget) return; const id = this.deleteTarget.id; this.deleteTarget = null; try { await fetch('/payroll/' + id + '/', { method: 'DELETE' }); this.items = this.items.filter((i: any) => i.id !== id); this.$store.ui.toast('Payroll record deleted', 'success'); } catch(e) { this.$store.ui.toast('Failed', 'error'); } },
    }));
  });
</script>

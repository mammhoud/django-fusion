---
import '../../styles/global.css';

const focusSale = Astro.url.searchParams.get('sale') || '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Order Display · Formint POS</title>
    <script is:inline>
      (() => {
        try {
          const ui = JSON.parse(localStorage.getItem('formint-ui') || '{}');
          if (ui.mode === 'dark') document.documentElement.classList.add('dark');
        } catch {}
      })();
    </script>
  </head>
  <body
    x-data="customerDisplay()"
    x-init="init()"
    data-focus-sale={focusSale}
    class="min-h-screen"
  >
    <main class="max-w-6xl mx-auto px-4 py-6">
      <!-- ── Header strip ── -->
      <header class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-2">
          <span class="text-lg font-extrabold" style="color: var(--color-text-primary)">Order Display</span>
          <span class="tag tag--sm tag--neutral" x-text="summaryLabel"></span>
        </div>
        <div class="flex items-center gap-2 text-xs opacity-50">
          <span class="inline-block h-2 w-2 rounded-full" :style="{ background: connected ? 'var(--color-success)' : 'var(--color-error)' }"></span>
          <span x-text="connected ? 'Live' : 'Reconnecting…'"></span>
          <span class="hidden sm:inline" x-text="clockLabel"></span>
        </div>
      </header>

      <!-- ── Single-order confirmation mode ── -->
      <div x-show="focusSaleId" class="mx-auto max-w-2xl">
        <div x-show="isLoading" class="skeleton-shimmer h-64 rounded-xl" aria-hidden="true"></div>
        <div x-show="!isLoading && error" class="text-center py-20 opacity-60 text-sm" x-text="error"></div>
        <div x-show="!isLoading && focusOrder" class="card p-6 space-y-5">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-xs uppercase tracking-wide opacity-40">Order</p>
              <h1 class="text-4xl font-extrabold" style="color: var(--color-text-primary)" x-text="'#' + focusOrder.sale_id"></h1>
            </div>
            <div class="text-right">
              <span class="badge" :class="statusBadgeClass(focusOrder.kitchen_ticket?.status)" x-text="statusLabel"></span>
              <p x-show="focusOrder.table_number" class="text-sm mt-1 opacity-60" x-text="'Table ' + focusOrder.table_number"></p>
            </div>
          </div>

          <div class="divide-y divide-[var(--color-border-subtle)]">
            <template x-for="item in focusOrder.items" :key="item.product_name">
              <div class="py-2.5 flex items-center justify-between gap-3">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="w-6 h-6 rounded flex items-center justify-center text-xs font-bold shrink-0" style="background: var(--color-surface-raised); color: var(--color-text-secondary)" x-text="item.quantity"></span>
                  <span class="font-medium truncate" style="color: var(--color-text-primary)" x-text="item.product_name"></span>
                </div>
                <span class="shrink-0 text-sm opacity-70" x-text="'$' + item.line_total.toFixed(2)"></span>
              </div>
            </template>
          </div>

          <div class="flex items-center justify-between pt-2 border-t font-bold text-lg" style="border-color: var(--color-border-subtle); color: var(--color-text-primary)">
            <span>Total</span>
            <span x-text="'$' + focusOrder.total.toFixed(2)"></span>
          </div>

          <!-- Progress -->
          <template x-if="focusOrder.kitchen_ticket">
            <div>
              <div class="flex justify-between text-xs opacity-50 mb-1">
                <span x-text="progressLabel"></span>
                <span x-text="elapsedLabel"></span>
              </div>
              <div class="w-full h-2 rounded-full overflow-hidden" style="background: var(--color-surface-raised)">
                <div
                  class="h-full rounded-full transition-all duration-700"
                  :class="{ 'animate-pulse': focusOrder.kitchen_ticket.is_overdue }"
                  :style="{ width: progressPercent + '%', background: progressColor }"
                ></div>
              </div>
            </div>
          </template>
          <p x-show="!focusOrder.kitchen_ticket || focusOrder.kitchen_ticket.status === 'delivered'" class="text-center text-sm" style="color: var(--color-success)">
            ✓ Your order is ready. Thank you!
          </p>
        </div>
      </div>

      <!-- ── Board mode ── -->
      <div x-show="!focusSaleId">
        <div x-show="isLoading" class="grid grid-cols-2 md:grid-cols-3 gap-3">
          <template x-for="i in 6" :key="i">
            <div class="skeleton-shimmer h-56 rounded-xl" aria-hidden="true"></div>
          </template>
        </div>

        <div x-show="!isLoading && orders.length === 0" class="text-center py-24 opacity-50 text-sm">
          No active orders. All clear.
        </div>

        <div x-show="!isLoading && orders.length > 0" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          <template x-for="order in orders" :key="order.sale_id">
            <article class="card p-4 flex flex-col gap-3">
              <div class="flex items-start justify-between">
                <div>
                  <p class="text-[11px] uppercase tracking-wide opacity-40">Order</p>
                  <h2 class="text-2xl font-extrabold" style="color: var(--color-text-primary)" x-text="'#' + order.sale_id"></h2>
                </div>
                <div class="text-right">
                  <span class="badge" :class="statusBadgeClass(order.kitchen_ticket?.status)" x-text="statusLabelFor(order)"></span>
                  <p x-show="order.table_number" class="text-xs mt-1 opacity-50" x-text="'Table ' + order.table_number"></p>
                </div>
              </div>
              <div class="flex-1 space-y-1.5">
                <template x-for="item in order.items" :key="item.product_name">
                  <div class="flex items-center justify-between gap-2 text-sm">
                    <span class="truncate opacity-80" x-text="item.quantity + '× ' + item.product_name"></span>
                    <span class="shrink-0 opacity-60" x-text="'$' + item.line_total.toFixed(2)"></span>
                  </div>
                </template>
              </div>
              <div class="flex items-center justify-between border-t pt-2 text-sm" style="border-color: var(--color-border-subtle)">
                <span class="opacity-60" x-text="elapsedLabelFor(order)"></span>
                <span class="font-bold" style="color: var(--color-text-primary)" x-text="'$' + order.total.toFixed(2)"></span>
              </div>
            </article>
          </template>
        </div>
      </div>
    </main>

    <script>
      import Alpine from 'alpinejs';

      document.addEventListener('alpine:init', () => {
        Alpine.data('customerDisplay', () => ({
          orders: [],
          focusOrder: null,
          focusSaleId: '',
          isLoading: true,
          error: '',
          connected: false,
          pollTimer: null,
          clockTimer: null,
          clockLabel: '',

          get summaryLabel() {
            const s = this.summary;
            if (this.focusSaleId) return 'Confirmation';
            const parts = [];
            if (s.preparing) parts.push(s.preparing + ' preparing');
            if (s.ready) parts.push(s.ready + ' ready');
            if (s.pending) parts.push(s.pending + ' pending');
            return parts.length ? parts.join(', ') : 'No active orders';
          },

          get summary() {
            return this.orders.reduce(
              (acc, o) => {
                const st = o.kitchen_ticket?.status;
                if (st === 'preparing') acc.preparing += 1;
                else if (st === 'ready') acc.ready += 1;
                else if (st === 'pending') acc.pending += 1;
                return acc;
              },
              { preparing: 0, ready: 0, pending: 0 }
            );
          },

          get statusLabel() {
            const st = this.focusOrder?.kitchen_ticket?.status;
            return statusLabels[st] || this.focusOrder?.status || '';
          },

          statusLabelFor(order) {
            const st = order.kitchen_ticket?.status;
            return statusLabels[st] || order.status || '';
          },

          get progressPercent() {
            const t = this.focusOrder?.kitchen_ticket;
            if (!t || !t.prepare_time_minutes) return 0;
            return Math.min(100, Math.round((t.elapsed_minutes / t.prepare_time_minutes) * 100));
          },

          get progressColor() {
            const p = this.progressPercent;
            if (p < 50) return 'var(--color-success)';
            if (p < 90) return 'var(--color-warning)';
            return 'var(--color-error)';
          },

          get progressLabel() {
            const t = this.focusOrder?.kitchen_ticket;
            if (!t) return '';
            if (t.is_overdue) return 'Running late';
            if (t.status === 'ready') return 'Ready';
            return `Est. ${t.remaining_minutes} min remaining`;
          },

          get elapsedLabel() {
            const t = this.focusOrder?.kitchen_ticket;
            if (!t) return '';
            return `${t.elapsed_minutes}m elapsed`;
          },

          elapsedLabelFor(order) {
            const t = order.kitchen_ticket;
            if (!t) return 'Just placed';
            if (t.is_overdue) return 'Running late';
            if (t.status === 'ready') return 'Ready for pickup';
            return `${t.elapsed_minutes}m, ~${t.remaining_minutes}m left`;
          },

          statusBadgeClass(status) {
            return statusBadgeMap[status] || 'badge-neutral';
          },

          async load() {
            try {
              if (this.focusSaleId) {
                const res = await fetch(`/customer-display/${this.focusSaleId}`);
                if (!res.ok) {
                  this.error = 'This order could not be found.';
                  return;
                }
                this.focusOrder = await res.json();
              } else {
                const res = await fetch('/customer-display/board');
                if (res.ok) {
                  const data = await res.json();
                  this.orders = data.orders || [];
                  this.connected = true;
                }
              }
              this.error = '';
            } catch (e) {
              this.connected = false;
            } finally {
              this.isLoading = false;
            }
          },

          init() {
            this.focusSaleId = this.$root.dataset.focusSale || '';
            this.load();
            this.pollTimer = setInterval(() => this.load(), 5000);
            this.tickClock();
            this.clockTimer = setInterval(() => this.tickClock(), 1000);
          },

          tickClock() {
            this.clockLabel = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          },

          destroy() {
            if (this.pollTimer) clearInterval(this.pollTimer);
            if (this.clockTimer) clearInterval(this.clockTimer);
          },
        }));
      });

      const statusLabels = {
        pending: 'Pending',
        preparing: 'Preparing',
        ready: 'Ready',
        delivered: 'Delivered',
      };
      const statusBadgeMap = {
        pending: 'badge-warning',
        preparing: 'badge-info',
        ready: 'badge-success',
        delivered: 'badge-neutral',
      };

      Alpine.start();
    </script>
  </body>
</html>

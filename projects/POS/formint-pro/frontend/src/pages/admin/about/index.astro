---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/ui/Icon.astro';
---

<Layout title="About - Formint POS">
  <div x-data="aboutPage()" x-init="load()" class="max-w-[96rem] mx-auto p-4">
    <h1 class="flex items-center gap-2 text-lg font-extrabold mb-4" style="color: var(--color-text-primary)">
      <Icon name="info-circle" class="h-5 w-5" style="color: var(--color-primary)" />
      About
    </h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

      <!-- Brand Card -->
      <div class="card p-6 flex items-start gap-4">
        <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-chart-1)] flex items-center justify-center text-white text-2xl font-bold shrink-0">
          <span x-text="brand.initial || 'F'">F</span>
        </div>
        <div class="min-w-0">
          <h2 class="text-lg font-bold" style="color: var(--color-text-primary)" x-text="brand.name || 'Formint POS'">Formint POS</h2>
          <p class="text-sm opacity-50" x-text="'v' + (brand.version || '2.0.0')">v2.0.0</p>
          <p class="text-xs mt-2" style="color: var(--color-text-secondary)" x-text="brand.tagline || 'Professional restaurant operations platform'">
            Professional restaurant operations platform
          </p>
          <p class="text-xs mt-1 opacity-50">&copy; <span x-text="brand.year">2026</span> Structa Cloud</p>
        </div>
      </div>

      <!-- Health Card -->
      <div class="card p-4 space-y-3">
        <h2 class="font-semibold text-sm" style="color: var(--color-text-primary)">System Health</h2>
        <div x-show="loading" class="space-y-2"><template x-for="i in 4"><div class="skeleton-shimmer h-8 rounded"></div></template></div>
        <div x-show="!loading" class="space-y-2">
          <div class="flex justify-between text-xs"><span class="opacity-50">Server</span><span :class="health.status === 'ok' ? 'text-[var(--color-success-strong)]' : 'text-[var(--color-error-strong)]'" x-text="health.status || 'unknown'">ok</span></div>
          <div class="flex justify-between text-xs"><span class="opacity-50">Service</span><span x-text="health.service || '---'">formint-server</span></div>
          <div class="flex justify-between text-xs"><span class="opacity-50">Phase</span><span x-text="'Phase ' + (health.phase || 2)">Phase 2</span></div>
          <div class="flex justify-between text-xs"><span class="opacity-50">Registered Models</span><span x-text="health.models || 0">0</span></div>
          <div class="flex justify-between text-xs"><span class="opacity-50">Auth Methods</span><span x-text="(health.auth_methods || ['bearer_token','api_key']).join(', ')">bearer_token, api_key</span></div>
          <div class="flex justify-between text-xs"><span class="opacity-50">Render Mode</span><span x-text="health.render_mode || 'data'">data</span></div>
        </div>
      </div>

      <!-- Stats Card -->
      <div class="card p-4 space-y-3">
        <h2 class="font-semibold text-sm" style="color: var(--color-text-primary)">Database Stats</h2>
        <div x-show="loading" class="space-y-2"><template x-for="i in 5"><div class="skeleton-shimmer h-8 rounded"></div></template></div>
        <div x-show="!loading" class="grid grid-cols-2 gap-x-4 gap-y-2">
          <template x-for="(v, k) in stats" :key="k">
            <div class="flex justify-between text-xs"><span class="opacity-50 capitalize" x-text="k.replace(/_/g, ' ')"></span><span class="tabular-nums" x-text="v"></span></div>
          </template>
        </div>
      </div>

      <!-- Branches Card -->
      <div class="card p-4 space-y-3">
        <h2 class="font-semibold text-sm" style="color: var(--color-text-primary)">Branches</h2>
        <div x-show="loading" class="space-y-2"><template x-for="i in 3"><div class="skeleton-shimmer h-12 rounded"></div></template></div>
        <div x-show="!loading && branches.length === 0" class="text-center py-8 opacity-50 text-xs">No branches online.</div>
        <div x-show="!loading" class="space-y-2">
          <template x-for="node in branches" :key="node.node_id">
            <div class="flex items-center gap-3 p-2 rounded-lg border border-[var(--color-border-subtle)]">
              <div class="w-2 h-2 rounded-full shrink-0" :class="node.status === 'online' ? 'bg-[var(--color-success)]' : node.status === 'degraded' ? 'bg-[var(--color-warning)]' : 'bg-[var(--color-neutral)]'"></div>
              <div class="min-w-0 flex-1"><div class="text-sm font-medium" x-text="node.hostname"></div><div class="text-xs opacity-50" x-text="node.node_id + ' - ' + node.node_type"></div></div>
              <span class="badge text-xs px-1.5 py-0 rounded border border-[var(--color-border-subtle)]" x-text="node.version"></span>
            </div>
          </template>
        </div>
      </div>

      <!-- Tech Stack Card -->
      <div class="card p-4 space-y-2 md:col-span-2">
        <h2 class="font-semibold text-sm" style="color: var(--color-text-primary)">Tech Stack</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          <div class="stat-card"><span class="stat-card__title">Backend</span><span class="stat-card__value text-sm">Robyn + Django</span></div>
          <div class="stat-card"><span class="stat-card__title">Frontend</span><span class="stat-card__value text-sm">Astro + Alpine.js</span></div>
          <div class="stat-card"><span class="stat-card__title">CSS</span><span class="stat-card__value text-sm">Tailwind CSS v4</span></div>
          <div class="stat-card"><span class="stat-card__title">Database</span><span class="stat-card__value text-sm">SQLite / Postgres</span></div>
          <div class="stat-card"><span class="stat-card__title">Realtime</span><span class="stat-card__value text-sm">WebSocket + HTMX</span></div>
          <div class="stat-card"><span class="stat-card__title">Auth</span><span class="stat-card__value text-sm">JWT + API Keys</span></div>
          <div class="stat-card"><span class="stat-card__title">API</span><span class="stat-card__value text-sm">NinjaExtra + OpenAPI</span></div>
          <div class="stat-card"><span class="stat-card__title">POS</span><span class="stat-card__value text-sm">Formint Professional</span></div>
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  document.addEventListener('alpine:init', () => {
    Alpine.data('aboutPage', () => ({
      brand: {}, health: {}, stats: {}, branches: [], loading: true,

      async load() {
        try {
          const [h, st, nav] = await Promise.all([
            fetch('/health').then(r => r.ok ? r.json() : {}),
            fetch('/fusion/branches/summary/').then(r => r.ok ? r.json() : {}),
            fetch('/fusion/render-mode/').then(r => r.ok ? r.json() : {}),
          ]);
          this.health = (h as any).data || h || {};
          this.health.render_mode = (nav as any).data?.render_mode || 'data';
          this.stats = (st as any).data || st || {};
          this.branches = ((st as any).data?.branches || (st as any).branches || (st as any).data?.nodes || []);
          this.brand = {
            name: 'Formint POS',
            version: '2.0.0',
            initial: 'F',
            tagline: 'Professional restaurant operations platform',
            year: new Date().getFullYear(),
          };
        } catch (e) { console.error(e); }
        finally { this.loading = false; }
      },
    }));
  });
</script>

---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/ui/Icon.astro';
import Skeleton from '../../../components/ui/Skeleton.astro';
import FusionTable from '../../../components/ui/FusionTable.astro';
import FusionForm from '../../../components/ui/FusionForm.astro';
import WizardForm from '../../../components/ui/WizardForm.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
---

<Layout title="Sync Center · Formint POS">
  <div class="page-shell" x-data="syncCenter()" x-init="init()">
    <!-- Hero -->
    <section class="hero">
      <SectionHeading level="h1" eyebrow="API-first transport, offline snapshot" title="Sync Center" />
      <p class="intro">
        One transport for every data round-trip: the app queries the server API,
        restarts it via Tauri invokes when it is down, and falls back to cached
        snapshots offline, so operations never hard-stop.
      </p>
    </section>

    <!-- ── Transport status strip ── -->
    <section class="card transport-strip" aria-labelledby="transport-title">
      <SectionHeading title="Backend connectivity" id="transport-title" size="sm">
        <span slot="actions" class="badge" :class="transportBadgeClass" x-text="transportLabel"></span>
      </SectionHeading>
      <div x-show="transportLoading" class="space-y-2">
        <div class="skeleton-shimmer h-8 rounded" aria-hidden="true"></div>
      </div>
      <dl x-show="!transportLoading" class="transport-strip__grid">
        <div><dt>Transport</dt><dd x-text="status.transport">-</dd></div>
        <div><dt>Tauri shell</dt><dd x-text="status.tauri ? 'available' : 'browser mode'">-</dd></div>
        <div><dt>Server</dt><dd x-text="status.server || 'n/a'">-</dd></div>
        <div><dt>Health</dt><dd x-text="status.health ? `ok · ${status.health.models} models` : 'unreachable'">-</dd></div>
      </dl>
      <div class="mt-3 flex gap-2">
        <button class="btn btn-ghost btn-sm" @click="refreshStatus()" :disabled="transportLoading">
          <span x-show="transportLoading" class="inline-block h-3 w-3 animate-spin rounded-full border-2 border-current border-t-transparent"></span>
          Refresh
        </button>
        <button class="btn btn-ghost btn-sm" @click="testSync()" :disabled="syncRunning">
          <span x-show="syncRunning" class="inline-block h-3 w-3 animate-spin rounded-full border-2 border-current border-t-transparent"></span>
          Run test sync
        </button>
      </div>
      <p x-show="syncMessage" class="note" x-text="syncMessage"></p>
    </section>

    <!-- ── Sync stats ── -->
    <section class="card" aria-labelledby="sync-stats-title">
      <SectionHeading title="Approval ledger" id="sync-stats-title" size="sm">
        <Icon slot="actions" name="sync" class="h-5 w-5" style="color: var(--color-primary)" />
      </SectionHeading>
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
        <div class="stat-card"><span class="stat-card__title">Pending</span><span class="stat-card__value" x-text="stats.pending ?? '-'"></span></div>
        <div class="stat-card"><span class="stat-card__title">Approved</span><span class="stat-card__value" x-text="stats.approved ?? '-'"></span></div>
        <div class="stat-card"><span class="stat-card__title">Rejected</span><span class="stat-card__value" x-text="stats.rejected ?? '-'"></span></div>
        <div class="stat-card"><span class="stat-card__title">Applied</span><span class="stat-card__value" x-text="stats.applied ?? '-'"></span></div>
        <div class="stat-card"><span class="stat-card__title">Total</span><span class="stat-card__value" x-text="stats.total ?? '-'"></span></div>
      </div>
    </section>

    <!-- ── FusionTable (components API) ── -->
    <section class="card" aria-labelledby="components-title">
      <SectionHeading title="Product catalog (components as data)" id="components-title" size="sm">
        <button slot="actions" class="btn btn-ghost btn-sm" @click="reloadTable()">Reload</button>
      </SectionHeading>
      <FusionTable resource="products" data-skeleton-label="Product catalog" />
    </section>

    <!-- ── Wizard (reusable multi-step form) ── -->
    <section class="card" aria-labelledby="wizard-title">
      <SectionHeading title="Supplier onboarding wizard" id="wizard-title" size="sm">
        <span slot="actions" class="tag tag--primary tag--sm">Reusable</span>
      </SectionHeading>
      <WizardForm
        steps={[
          { title: 'Supplier', description: 'Business details' },
          { title: 'Catalog', description: 'First products' },
          { title: 'Review', description: 'Confirm & sync' },
        ]}
        formKey="syncWizard"
        @wizard:finish="finishWizard()"
      >
        <div slot="step-0">
          <FusionForm resource="supplier" formKey="wizSupplier" data-skeleton-label="Supplier form" />
        </div>
        <div slot="step-1">
          <FusionForm resource="product" formKey="wizProduct" data-skeleton-label="Product form" />
        </div>
        <div slot="step-2">
          <div class="space-y-3 text-sm">
            <p class="text-xs opacity-60">Final step: review entered values and push to the cloud server.</p>
            <button class="btn btn-primary btn-sm gap-1" @click="finishWizard()">
              <Icon name="cloud-upload" class="h-4 w-4" />
              Push to cloud
            </button>
          </div>
        </div>
      </WizardForm>
    </section>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';

  document.addEventListener('alpine:init', () => {
    Alpine.data('syncCenter', () => ({
      transportLoading: true,
      syncRunning: false,
      syncMessage: '',
      status: {
        transport: '-', tauri: false, server: null, capabilities: null, health: null,
      },
      stats: {} as Record<string, number>,

      get transportLabel() {
        const map: Record<string, string> = {
          api: 'Live API', invoke: 'Invoke fallback', snapshot: 'Offline snapshot',
        };
        return map[this.status.transport] || this.status.transport;
      },
      get transportBadgeClass() {
        const map: Record<string, string> = {
          api: 'badge-soft-success', invoke: 'badge-soft-warning', snapshot: 'badge-soft-error',
        };
        return map[this.status.transport] || 'badge';
      },

      async init() {
        await Promise.all([this.refreshStatus(), this.loadStats()]);
      },

      async refreshStatus() {
        this.transportLoading = true;
        try {
          const { transportStatus } = await import('../../../lib/fusion-api');
          this.status = await transportStatus();
        } finally {
          this.transportLoading = false;
        }
      },

      async loadStats() {
        try {
          const { fusionFetch } = await import('../../../lib/fusion-api');
          const res = await fusionFetch('/api/v1/sync/stats/');
          this.stats = res.data || {};
        } catch { /* offline */ }
      },

      reloadTable() {
        // Ask the FusionTable on the page to re-fetch.
        const table = document.querySelector('[data-resource="products"]');
        (table as any)?._x_dataStack?.[0]?.load?.();
      },

      async testSync() {
        this.syncRunning = true;
        this.syncMessage = '';
        try {
          const { fusionFetch } = await import('../../../lib/fusion-api');
          const res = await fusionFetch('/api/v1/sync/status/');
          if (res.ok && res.data) {
            const d = res.data as any;
            this.syncMessage =
              `Engine ${d.engine}, ${d.nodes?.online}/${d.nodes?.total} nodes online, ` +
              `${d.cloud_links?.length ?? 0} cloud link(s) · ${d.sync_ok_last_24h ?? 0} syncs in 24h`;
          } else {
            this.syncMessage = 'Sync status unreachable; snapshot/native fallback active.';
          }
        } finally {
          this.syncRunning = false;
        }
      },

      async finishWizard() {
        try {
          const { fusionFetch } = await import('../../../lib/fusion-api');
          const res = await fusionFetch('/api/v1/sync/push-products/', {
            method: 'POST',
            body: JSON.stringify({
              master_node_id: 'local',
              target_node_id: 'cloud',
              products: [],
              create_approval: true,
            }),
          });
          this.syncMessage = res.ok
            ? 'Push registered with the server (approval pending).'
            : 'Push failed; check the server.';
        } catch {
          this.syncMessage = 'Push failed; server unreachable.';
        }
      },
    }));
  });
</script>

<style>
  .page-shell { max-width: 72rem; margin: 0 auto; padding: 2.5rem 1.25rem; }
  .hero { max-width: 48rem; margin-bottom: 2rem; }
  .intro { max-width: 40rem; margin: 1rem 0 0; color: var(--color-text-secondary); font-size: 1rem; line-height: 1.6; }
  .card { padding: 1.5rem; background: var(--color-surface-card); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-box); box-shadow: var(--shadow-lg); margin-bottom: 1.25rem; }
  .transport-strip__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.75rem; }
  .transport-strip__grid div { padding: 0.75rem; background: var(--color-surface-page); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-field); }
  .transport-strip__grid dt { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.55; margin-bottom: 0.25rem; }
  .transport-strip__grid dd { font-size: 0.85rem; font-weight: 650; color: var(--color-text-primary); }
  .note { margin-top: 0.75rem; font-size: 0.8rem; color: var(--color-text-secondary); }
</style>

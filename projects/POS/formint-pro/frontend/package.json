  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tabler/icons": "^3.46.0",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^26.1.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"

{
  "name": "formint-pos-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Formint POS Professional Astro shell with Alpine.js and HTMX",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",

# =============================================================================
# POS-KO — .gitignore (v1.1 — 3 Edition System)
# =============================================================================
# Covers all 3 editions (pos-ko-minimal, pos-ko-extended, pos-ko-full),
# root-level artifacts, and everything `make clean` removes.
#
# Tracked (committed):
#   - Source code: src/, src-tauri/src/, server/  (editions)
#   - Config: package.json, tsconfig.json, Cargo.toml, tauri.conf.json
#   - Docs: docs/, README.md, PUBLISH.md, .env.example
#   - Scripts: scripts/ (build, dev, i18n, checksum)
#   - CI/CD: .github/workflows/
#   - Assets: public/, src-tauri/icons/
#   - Lockfiles: pnpm-lock.yaml, Cargo.lock
#
# Ignored (build artifacts, generated, secrets):
#   - Dependencies: node_modules/, .venv/
#   - Build output: dist/, target/, gen/, server/dist/, server/build/
#   - Database: restaurant.db
#   - Secrets: .env (NOT .env.example)
#   - Logs: *.log
#   - IDE: .vscode/ (except extensions.json), .idea/
#   - OS: .DS_Store, Thumbs.db

# =============================================================================
# Dependencies — NEVER commit
# =============================================================================

# Node.js / pnpm
node_modules/
pnpm-store/
package-lock.json          # pnpm is used; ignore stray npm lockfile

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg
.venv/
.venv-build/
venv/
pip-log.txt
pip-delete-this-directory.txt

# Rust
# (target/ is covered below under Build Output)

# =============================================================================
# Build Output — generated, NEVER commit
# =============================================================================

# Vite / frontend
dist/
dist-ssr/

# Tauri / Rust
target/                    # Cargo build output
src-tauri/target/
src-tauri/gen/             # Tauri generated (Android/iOS)

# Server (PyInstaller) — covered by *.spec and __pycache__/ above
server/build/
server/dist/

# Checksums (generated by scripts/dev/generate-checksums.cjs)
*.sha256
CHECKSUMS.txt

# Binaries (generated build artifacts)
src-tauri/binaries/dist/
src-tauri/binaries/build/

# =============================================================================
# Database — contains user/business data, NEVER commit
# =============================================================================

*.db
*.sqlite
*.sqlite3
restaurant.db

# =============================================================================
# Environment & Secrets — NEVER commit
# =============================================================================

.env
.env.*
!.env.example             # Track the template only
*.env.backup*
.env.local
.env.*.local
secrets.yml

# Android signing keys — ABSOLUTELY NEVER commit
*.jks
*.keystore
*.keystore.bak
src-tauri/gen/android/keystore/

# SSL / TLS
*.pem
*.key
*.crt
*.p12
*.pfx

# =============================================================================
# Logs
# =============================================================================

*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =============================================================================
# OS Files
# =============================================================================

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# =============================================================================
# Editor & IDE — local config only
# =============================================================================

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# =============================================================================
# Temporary & Cache
# =============================================================================

*.tmp
*.temp
tmp/
temp/
.cache/
*.cache
.sass-cache/
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
.tox/
.nox/

# =============================================================================
# Publish & Bundle (generated by `make publish`)
# =============================================================================

publish-bundle/

# =============================================================================
# Screenshot captures (generated by `make screenshots`)
# =============================================================================

_captures/

# =============================================================================
# Webpack / Vite (generated stats)
# =============================================================================

stats.html
*.tsbuildinfo

# Runtime artifacts
appmap.log

# Root .dockerignore — applies when build context is workspace root
# ===============================================================
# Global patterns
# ===============================================================

# Dependencies (always rebuilt in Docker)
**/node_modules
**/.venv

# Python bytecode
**/__pycache__
**/*.pyc
**/*.pyo

# Build & cache artifacts
**/.sass-cache
**/.cache
**/dist
**/build
**/*.egg-info
**/.pytest_cache
**/.hypothesis
**/.ruff_cache
**/.mypy_cache
**/.tox
**/.nox

# OS files
**/.DS_Store
**/Thumbs.db

# Version control
**/.git
**/.gitignore
**/.gitattributes
**/.gitmodules

# IDE & editor config
**/.idea
**/.vscode
**/.claude

# Logs
**/*.log
**/logs

# Environment & secrets
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.cert

# Backups
**/backups

# ===============================================================
# Tinker-specific exclusions
# ===============================================================

# Local SQLite database (re-created at runtime via entrypoint symlink)
cypercloud/db.sqlite3
cypercloud/data/

# Collected static files (rebuilt in Docker via collectstatic at build time)
cypercloud/staticfiles/
cypercloud/static_root/
cypercloud/media_root/

# Pre-built webpack bundles (rebuilt in Docker from source)
cypercloud/assets/bundles/
cypercloud/assets/node_modules/

# Source maps & workbox precache (generated by webpack, not needed at runtime)
cypercloud/assets/bundles/**/*.map
cypercloud/assets/bundles/**/precache-*

# ===============================================================
# Other site-specific exclusions (avoid sending unrelated data)
# ===============================================================
# The cypercloud build only copies cypercloud/ + libs/, but these
# patterns prevent accidental inclusion from the shared context.

# Other application directories (not copied by cypercloud Dockerfile)
ctc-research/assets/bundles/
lms/assets/bundles/
VResume/assets/bundles/

# Shared workspace bundles
assets/bundles/
assets/media/
assets/staticfiles/

# Per-tool runtime data, secrets, and generated files.
# None of these belong in git; several contain credentials or keys.

# AFFiNE (contains private keys + blobs)
affine/affine-data/

# Ollama model cache (large; pull models at runtime)
ollama/data/

# Monitoring state (Grafana DB, Prometheus TSDB)
monitoring/data/
monitoring/grafana/

# Local env overrides (copy from ../.env.example)
**/.env

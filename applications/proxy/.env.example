# ===========================================================
# Traefik proxy environment variables
# ===========================================================
# Copy this file to `proxy/.env` and fill in real values.
# `proxy/.env` is gitignored. Do NOT commit it.
#
# These values are consumed by proxy/docker-compose.traefik.yml and
# passed to the default-proxy container. Certificates use the HTTP-01
# challenge, which needs no DNS provider token.
# ===========================================================

# ----- Let's Encrypt account email -------------------------------
# Used for the ACME account registration and expiry notifications.
LETSENCRYPT_EMAIL=admin@structa.cloud

# ----- Shared application services --------------------------------
# Required by docker-compose.nginx.yml. Generate unique values and keep them
# synchronized with the affine role and default-redis service in databases.
# This value is inserted into a PostgreSQL URI; percent-encode URI-reserved
# characters (for example @ becomes %40) before placing it here.
AFFINE_DB_PASSWORD=
REDIS_PASSWORD=
AFFINE_VERSION=stable
AFFINE_SERVER_EXTERNAL_URL=https://space.structa.cloud

# ----- AFFiNE email (Gmail SMTP via app password) ------------------
# Powers workspace invite and notification emails from space.structa.cloud.
MAILER_HOST=smtp.gmail.com
MAILER_PORT=587
MAILER_USER=structa.cloud@gmail.com
MAILER_PASSWORD=
MAILER_SENDER=structa.cloud@gmail.com

# Local environment file with secrets (DB passwords, etc.)
# Copy from .env.example and fill in real values.
.env

# Runtime ACME storage — contains Let's Encrypt account keys and live certs.
# The configs/ directory itself is committed (with .gitkeep) so that bind
# mounts resolve, but the JSON inside is not.
configs/acme.json
configs/acme.json.tmp

# Manual cert/ACME backups — tarballs contain private keys.
data/backups/

# Self-signed certificates under data/certs/.
# These are local-dev / fallback artifacts; production certs come from
# Let's Encrypt via Traefik (see LETSENCRYPT.md).
# Keep the .gitkeep so the directory still resolves for bind mounts.
data/certs/
!data/certs/.gitkeep

# Persistent application data; keep credentials and user files out of Git.
data/affine-data/

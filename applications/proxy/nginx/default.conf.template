# Docker embedded DNS: the AFFiNE upstream uses variable
# proxy_pass (see below), so nginx must resolve their container names at
# request time via this resolver — otherwise requests 502 with "no resolver
# defined" even when the workspace container is up.
resolver 127.0.0.11 valid=30s ipv6=off;

# The workspace origin is space.structa.cloud (root = AFFiNE); former hosts
# redirect there. Keep .localhost and public hosts on the same host family
# (space.localhost vs space.structa.cloud).
map $host $space_redirect_base {
    default          https://space.structa.cloud;
    affine.localhost http://space.localhost;
    blinko.localhost http://space.localhost;
}


# Fusion sites use the same public /static/ and /media/ URLs. Select their
# named-volume roots by the Host header while preserving the legacy shared
# paths for the existing sites and media subdomains.
map $host $static_root {
    default /var/www/static;
    cms-fusion.localhost /var/www/sites/cms-fusion/static;
    cms-fusion.com /var/www/sites/cms-fusion/static;
    www.cms-fusion.com /var/www/sites/cms-fusion/static;
    lms-fusion.localhost /var/www/sites/lms-fusion/static;
    lms-fusion.com /var/www/sites/lms-fusion/static;
    www.lms-fusion.com /var/www/sites/lms-fusion/static;
    ctc-research.com /var/www/sites/lms-fusion/static;
    www.ctc-research.com /var/www/sites/lms-fusion/static;
    arch.ctc-research.com /var/www/sites/lms-fusion/static;
}

map $host $media_root {
    default /var/www/media;
    cms-fusion.localhost /var/www/media/cms-fusion;
    cms-fusion.com /var/www/media/cms-fusion;
    www.cms-fusion.com /var/www/media/cms-fusion;
    lms-fusion.localhost /var/www/media/lms-fusion;
    lms-fusion.com /var/www/media/lms-fusion;
    www.lms-fusion.com /var/www/media/lms-fusion;
    ctc-research.com /var/www/media/lms-fusion;
    www.ctc-research.com /var/www/media/lms-fusion;
    arch.ctc-research.com /var/www/media/lms-fusion;
}

server {
    listen 80;
    server_name _;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/markdown text/javascript application/javascript application/xml application/json image/svg+xml;

    # MIME types
    types {
        text/html                             html htm shtml;
        text/css                              css;
        text/xml                              xml;
        text/markdown                         md;
        image/gif                             gif;
        image/jpeg                            jpeg jpg;
        image/png                             png;
        image/svg+xml                         svg svgz;
        image/webp                            webp;
        application/javascript                js;
        application/json                      json;
        application/font-woff                 woff;
        application/font-woff2                woff2;
        font/ttf                              ttf;
        font/otf                              otf;
    }

    # Site-specific webpack bundles (collected into each site's STATIC_ROOT)
    location /static/bundles/ctc-research/ {
        alias /var/www/sites/ctc-research/static/bundles/ctc-research/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /static/bundles/lms/ {
        alias /var/www/sites/lms/static/bundles/lms/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /static/bundles/vresume/ {
        alias /var/www/sites/vresume/static/bundles/vresume/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /static/bundles/cms-fusion/ {
        alias /var/www/sites/cms-fusion/static/bundles/cms-fusion/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /static/bundles/lms-fusion/ {
        alias /var/www/sites/lms-fusion/static/bundles/lms-fusion/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    # Site-specific static files
    location /sites/ctc-research/static/ {
        alias /var/www/sites/ctc-research/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /sites/lms/static/ {
        alias /var/www/sites/lms/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /sites/vresume/static/ {
        alias /var/www/sites/vresume/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /sites/cms-fusion/static/ {
        alias /var/www/sites/cms-fusion/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /sites/lms-fusion/static/ {
        alias /var/www/sites/lms-fusion/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    # Shared static files
    location /static/ {
        alias $static_root/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    # Site-specific media files
    location /media/ctc-research/ {
        alias /var/www/media/ctc-research/;
        expires 30d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /media/lms/ {
        alias /var/www/media/lms/;
        expires 30d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /media/vresume/ {
        alias /var/www/media/vresume/;
        expires 30d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    # Shared media files. Fusion hosts resolve to their named-volume root
    # through $media_root; legacy hosts retain /var/www/media/.
    location /media/ {
        alias $media_root/;
        expires 30d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    # Health check endpoint
    location /health/ {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # Resolver smoke probe — exercised by the shared-media healthcheck.
    # Proxies to a stable in-stack container (docus) through the SAME
    # variable-upstream + resolver path the AFFiNE workspace
    # containers use. 200 = resolver configured and resolving at runtime;
    # 502 "no resolver defined" = config regression the healthcheck must catch
    # at deploy time. Closed-loop and safe: docus always serves its SPA
    # fallback (200), so the probe never depends on coder-* workspace
    # containers being up.
    location = /__resolver_probe__ {
        access_log off;
        set $resolver_probe docus:3000;
        proxy_pass http://$resolver_probe;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # ------------------------------------------------------------
    # Docus — Structa Cloud documentation (Nuxt server)
    # Docus owns SSR, content search, locale routing, sitemap, and LLM routes.
    # Keep the /docs/ prefix intact for the media host and let Docus render
    # direct deep links instead of applying a static SPA fallback.
    location = /docs {
        absolute_redirect off;
        return 301 /docs/;
    }

    location /docs/ {
        set $docus_upstream docus:3000;
        proxy_pass http://$docus_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    # Media index — serve a small landing page at the root so `/` isn't a
    # bare 404 (media.structa.cloud, media.ctc-research.com, media.lms.com,
    # media.vresume.structa.cloud). Content lives in ./nginx/www/index.html,
    # bind-mounted to /var/www/html (see docker-compose.nginx.yml).
    location = / {
        root /var/www/html;
        try_files /index.html =404;
        add_header Cache-Control "no-cache";
    }

    # Return 404 for any other requests (this is a media-only server)
    location / {
        return 404;
    }
}

# ------------------------------------------------------------
# Workspace origin — space.structa.cloud (root = AFFiNE)
# ------------------------------------------------------------
# Root serves AFFiNE (web client + API + WebSocket on one origin at
# coder-${WORKSPACE_NAME}-affine:3010). The upstream name is pinned by the
# repo's devcontainer compose (.devcontainer/docker-compose.yml) to
# coder-${WORKSPACE_NAME}-*; WORKSPACE_NAME defaults to "workspace" on both
# sides. Variable-based upstream keeps `nginx -t` (shared-media healthcheck)
# green while the workspace is stopped; requests 502 until it is up.
server {
    listen 80;
    server_name space.localhost space.structa.cloud;

    location / {
        set $affine_ws_upstream coder-${WORKSPACE_NAME}-affine:3010;
        proxy_pass http://$affine_ws_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        client_max_body_size 128m;
    }
}

# ------------------------------------------------------------
# Legacy hosts — redirect to space.structa.cloud
# ------------------------------------------------------------
# Former AFFiNE (affine.localhost) and Blinko (blinko.structa.cloud) hosts
# redirect to the consolidated origin so existing bookmarks keep working.
# FileGator and its host were removed entirely. Traefik routes them here (see
# ../traefik/dynamic/space.yml, affine.yml, blinko.yml).
server {
    listen 80;
    server_name affine.localhost;

    location / {
        return 301 $space_redirect_base/;
    }
}

server {
    listen 80;
    server_name blinko.localhost blinko.structa.cloud;

    location / {
        return 301 $space_redirect_base/;
    }
}

# ------------------------------------------------------------
# Docs — docs.structa.cloud (Docus Nuxt server)
# ------------------------------------------------------------
# Traefik strips /docs from this host before forwarding to shared-media.
# Docus still emits /docs/ asset URLs, which Traefik strips again on the
# browser's subsequent requests. The variable upstream keeps shared-media's
# Nginx config valid while the Docus workspace service is restarting.
server {
    listen 80;
    server_name docs.structa.cloud docs.localhost;

    location / {
        set $docus_host_upstream docus:3000;
        proxy_pass http://$docus_host_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_buffering off;
    }
}

#!/usr/bin/env bash

### Create database backups.
###
### Options:
###     --all              Backup all databases (default)
###     --database <name>  Backup specific database
###     --list             List databases available for backup
###
### Usage:
###     $ docker compose -f <environment>.yml (exec |run --rm) postgres backup
###     $ docker compose -f <environment>.yml (exec |run --rm) postgres backup --database db_staging
###     $ docker compose -f <environment>.yml (exec |run --rm) postgres backup --list

set -o errexit
set -o pipefail
set -o nounset

working_dir="$(dirname ${0})"
source "${working_dir}/_sourced/constants.sh"
source "${working_dir}/_sourced/messages.sh"

# Function to backup a single database
backup_database() {
    local db_name="$1"
    local timestamp=$(date +'%Y_%m_%dT%H_%M_%S')
    local backup_filename="${db_name}_${BACKUP_FILE_PREFIX}_${timestamp}.sql.gz"
    
    # Get database-specific user if exists
    local db_user="$POSTGRES_USER"
    local db_password="$POSTGRES_PASSWORD"
    
    # Try to get database-specific credentials
    local db_upper=$(echo "$db_name" | tr '[:lower:]' '[:upper:]' | tr '-' '_')
    local user_var="DB_${db_upper}_USER"
    local pass_var="DB_${db_upper}_PASSWORD"
    
    if [ -n "${!user_var:-}" ]; then
        db_user="${!user_var}"
        if [ -n "${!pass_var:-}" ]; then
            db_password="${!pass_var}"
        fi
    fi
    
    message_info "Backing up database '${db_name}' with user '${db_user}'..."
    
    export PGHOST="$POSTGRES_HOST"
    export PGPORT="$POSTGRES_PORT"
    export PGUSER="$db_user"
    export PGPASSWORD="$db_password"
    export PGDATABASE="$db_name"
    
    # Check if we can connect to the database
    if ! psql -lqt 2>/dev/null | cut -d \| -f 1 | grep -qw "$db_name"; then
        message_warning "Database '$db_name' does not exist or cannot be accessed. Skipping..."
        return 1
    fi
    
    # Perform backup
    pg_dump --clean --if-exists | gzip > "${BACKUP_DIR_PATH}/${backup_filename}"
    
    # Verify backup was created
    if [ -f "${BACKUP_DIR_PATH}/${backup_filename}" ]; then
        local file_size=$(du -h "${BACKUP_DIR_PATH}/${backup_filename}" | cut -f1)
        message_success "Database '$db_name' backup '${backup_filename}' created (${file_size})"
    else
        message_error "Failed to create backup for database '$db_name'"
        return 1
    fi
}

# Parse command line arguments
BACKUP_ALL=true
SPECIFIC_DB=""
LIST_DATABASES=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --all)
            BACKUP_ALL=true
            shift
            ;;
        --database)
            SPECIFIC_DB="$2"
            BACKUP_ALL=false
            shift 2
            ;;
        --list)
            LIST_DATABASES=true
            shift
            ;;
        *)
            message_error "Unknown option: $1"
            echo "Usage: backup [--all] [--database <name>] [--list]"
            exit 1
            ;;
    esac
done

# List databases if requested
if [ "$LIST_DATABASES" = true ]; then
    message_welcome "Available databases for backup:"
    for db in "${ALL_DATABASES[@]}"; do
        echo "  - $db"
    done
    exit 0
fi

# Set password for superuser operations
if [ -n "$POSTGRES_PASSWORD" ]; then
    export PGPASSWORD="$POSTGRES_PASSWORD"
fi

# Perform backup
if [ "$BACKUP_ALL" = true ]; then
    message_welcome "Starting full backup of all databases..."
    
    # Create full cluster backup (requires superuser)
    FULL_BACKUP_FILENAME="full_cluster_${BACKUP_FILE_PREFIX}_$(date +'%Y_%m_%dT%H_%M_%S').sql.gz"
    if [ "$POSTGRES_USER" = "postgres" ] || pg_isready -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" -U "$POSTGRES_USER" 2>/dev/null; then
        message_info "Creating full cluster backup..."
        pg_dumpall --clean --if-exists | gzip > "${BACKUP_DIR_PATH}/${FULL_BACKUP_FILENAME}"
        message_success "Full cluster backup created: ${FULL_BACKUP_FILENAME}"
    else
        message_warning "Cannot create full cluster backup. Falling back to individual database backups..."
    fi
    
    # Backup individual databases
    for db in "${ALL_DATABASES[@]}"; do
        backup_database "$db" || true
    done
    
    message_success "All backups completed and placed in '${BACKUP_DIR_PATH}'."
    
elif [ -n "$SPECIFIC_DB" ]; then
    # Check if database exists
    if [[ " ${ALL_DATABASES[@]} " =~ " ${SPECIFIC_DB} " ]]; then
        backup_database "$SPECIFIC_DB"
    else
        message_error "Database '$SPECIFIC_DB' not found or not accessible."
        message_info "Available databases: ${ALL_DATABASES[*]}"
        exit 1
    fi
    
else
    # Default: backup all databases
    message_welcome "Backing up all databases..."
    for db in "${ALL_DATABASES[@]}"; do
        backup_database "$db" || true
    done
    message_success "All backups completed and placed in '${BACKUP_DIR_PATH}'."
fi

# Cleanup old backups
message_info "Cleaning up backups older than ${BACKUP_RETENTION_DAYS} days..."
find "$BACKUP_DIR_PATH" -name "*.sql.gz" -mtime +$BACKUP_RETENTION_DAYS -delete 2>/dev/null || true
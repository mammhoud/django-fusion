# ─────────────────────────────────────────────────────────────────────────────
# Shared Databases — local environment (application/databases/.env)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` in this directory (or `make setup`) before starting
# the shared PostgreSQL + Redis stack. The passwords below are freshly
# generated RANDOM defaults — rotate them before any shared/production use.
#
# This .env is the Compose *interpolation* source (docker compose reads the
# .env next to the compose file) AND is loaded into the containers via the
# `env_file` entry in each service's docker-compose.yml. It is listed AFTER
# the repo-root `.env`, so this local file wins on conflicts — keeping the
# credentials used for interpolation and runtime identical. Set a value in the
# repo-root `.env` (then remove it here) to let the root override this file.
#
# Databases are created by two init mechanisms:
#   1. postgres/init/00-create-databases.sql — creates the shared `django`
#      role, all project DBs, the `blinko` role+DB, and schema grants.
#   2. postgres/init/00.initdb-multiple-databases.sh — creates role-scoped
#      databases from the INITDB_MULTIPLE_DATABASES / POSTGRES_DATABASES env
#      vars (used for Coder and any DB needing a dedicated password).
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (shared cluster) ─────────────────────────────────────────────
# Superuser role + default database created by the postgres image.
POSTGRES_USER=admin
POSTGRES_PASSWORD=2Obcdl4VzZSEX9VBWsjvkoMBZz3SiAB_
POSTGRES_PORT=5432

# Multiple databases created by the shell init script — format db:owner:password.
# Every `structa`-owned site DB uses the shared POSTGRES_PASSWORD; the coder
# role has its own credentials. Override the whole list here if you need
# per-database passwords.
POSTGRES_DATABASES=db_precis_lms:structa:2Obcdl4VzZSEX9VBWsjvkoMBZz3SiAB_,db_precis_dev:structa:2Obcdl4VzZSEX9VBWsjvkoMBZz3SiAB_,db_precis_ctc:structa:2Obcdl4VzZSEX9VBWsjvkoMBZz3SiAB_,db_vresume:structa:2Obcdl4VzZSEX9VBWsjvkoMBZz3SiAB_,coder:coder:EpLeZonZAiwsDoVDA8x1bIea77XvDP6S,db_loop_crm:structa:2Obcdl4VzZSEX9VBWsjvkoMBZz3SiAB_,blinko:blinko:Blinko2024SecurePass!

# ── Blinko database (self-hosted AI notes) ──────────────────────────────────
# Blinko's role and database are created by postgres/init/00-create-databases.sql
# on first start. This password is injected into the init script and used by
# the Blinko app container at runtime.
BLINKO_DB_USER=blinko
BLINKO_DB_PASSWORD=Blinko2024SecurePass!
BLINKO_DB_NAME=blinko

# ── Redis (cache / Dramatiq broker) ─────────────────────────────────────────
REDIS_PASSWORD=mJzEUgouGTpr7DSNnUyda9nz7u3BPuN7
REDIS_PORT=6379

# ── Role-specific database passwords ────────────────────────────────────────
# Coder control plane (application/tools/coder/). Must stay in sync with the
# matching entry in POSTGRES_DATABASES above.
CODER_DB_USER=coder
CODER_DB_NAME=coder
CODER_DB_PASSWORD=EpLeZonZAiwsDoVDA8x1bIea77XvDP6S
[TEMPLATE]
# ─────────────────────────────────────────────────────────────────────────────
# Self-hosted tools — local environment (application/tools/.env)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` in this directory (`make setup` in any tool dir) or
# keep the values in the repo-root `.env`. Every variable referenced by the
# tool docker-compose files lives here — including tools that are currently
# COMMENTED OUT of application/tools/docker-compose.yml (adminer, monitoring,
# ollama) — so each tool stack is self-sufficient.
#
# Each tool Makefile uses this file for interpolation when present
# (ENV_FILE ?= ../.env), falling back to the repo-root `.env` otherwise.
# Secrets below are generated RANDOM defaults — rotate before shared use.
#
# Shared credentials (PostgreSQL, Redis, Coder DB) must MATCH the values in
# application/databases/.env — those databases/roles are created by the init
# scripts there. See the "Shared infrastructure" section at the bottom.
# ─────────────────────────────────────────────────────────────────────────────

# ── Adminer — database administration UI ─────────────────────────────────────
ADMINER_VERSION=latest
ADMINER_DESIGN=hydra

# ── Blinko — self-hosted personal AI note tool ──────────────────────────────
# Blinko connects to the shared PostgreSQL cluster.  The BLINKO_DB_* values
# must match the matching entries in application/databases/.env — the `blinko`
# role and database are created by the database init scripts on first start.
BLINKO_DB_USER=blinko
BLINKO_DB_PASSWORD=Blinko2024SecurePass!
BLINKO_DB_NAME=blinko
BLINKO_PORT=1111
BLINKO_NEXTAUTH_SECRET=blinko-structa-cloud-secret-2024
BLINKO_PUBLIC_URL=https://tools.structa.cloud/notes
# NEXTAUTH_URL=https://tools.structa.cloud/notes

# ── Mailpit — email catcher ──────────────────────────────────────────────────
MAILPIT_VERSION=latest
MAILPIT_SMTP_PORT=1025

# ── Monitoring — Prometheus + Grafana ────────────────────────────────────────
PROMETHEUS_VERSION=latest
GRAFANA_VERSION=latest
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=FTV2x2nF5_9mNCIPf1_aFasQhFvcbqLd

# ── xyOps — operations automation platform ───────────────────────────────────
# Default sign-in: admin / admin — change immediately after first login.
# xySat workers connect to the conductor hostname on port 5522.
XYOPS_VERSION=latest
XYOPS_HOSTNAME=xyops
XYOPS_XYSAT_LOCAL=true
XYOPS_HTTP_PORT=5522
XYOPS_HTTPS_PORT=5523
XYOPS_BASE_URL=https://ops.structa.cloud

# ── tools-web — dashboard auth (tools.structa.cloud) ────────────────────────
# Two layers of auth on the tools dashboard:
#   1. Dashboard login — accounts from application/tools/tools-web/users.yml
#      (bcrypt-hashed). Default accounts (change the hashes before shared use):
#        admin      / admin
#        supervisor / supervisor
#      New hashes: node -e "console.log(require('bcryptjs').hashSync('pw', 10))"
#   2. Per-tool unlock — the SHARED password below, asked when opening any
#      tool from the dashboard. One password for every tool.
# TOOLS_UNLOCK_PASSWORD is required (tools-web returns 500 without it).
# Generate with: openssl rand -base64 18 | tr -d '/+=' | head -c 20
TOOLS_UNLOCK_PASSWORD=hyvloMwHmnJCmgEYn7hl
# Optional: explicit secret used to sign session cookies (falls back to
# TOOLS_UNLOCK_PASSWORD if unset). Generate with: openssl rand -hex 16
TOOLS_SESSION_SECRET=2e1be3f22aae25d733e4b10a9e7ebeaa

# ── Blinko sign-in ───────────────────────────────────────────────────────────
# Blinko has NO hardcoded default admin credentials. The first visitor creates
# an account via the sign-up page on the Blinko login screen. After that, only
# the registered email + password can sign in. The live demo (blinko/blinko)
# is a special demo-only setup and does not apply to self-hosted instances.

# ── AFFiNE — permanent shared workspace ──────────────────────────────────────
# First visitor signs up through the onboarding flow — no pre-seeded user.
# AFFINE_DB_PASSWORD / REDIS_PASSWORD must match application/databases/.env.
# Percent-encode reserved URI characters in AFFINE_DB_PASSWORD (e.g. @ → %40).
AFFINE_VERSION=stable
AFFINE_DB_PASSWORD=change-me-match-databases-env
AFFINE_SERVER_EXTERNAL_URL=https://tools.structa.cloud

# ── Coder (Space) — cloud dev environment at space.structa.cloud ────────────
# CODER_DB_* must match application/databases/.env (role created there).
CODER_VERSION=latest
CODER_DB_USER=coder
CODER_DB_NAME=coder
CODER_DB_PASSWORD=change-me-match-databases-env
CODER_ACCESS_URL=https://space.structa.cloud
CODER_DANGEROUS_ALLOW_PATH_APP_SITE_OWNER_ACCESS=true
CODER_HTTP_PORT=7080
CODER_HTTPS_PORT=7443
CODER_TLS_ENABLED=false
DOCKER_GROUP_GID=999

# ── Shared outbound mail (AFFiNE / Blinko notifications — Gmail SMTP) ───────
# Use a Gmail "App password" (16 chars without spaces) for MAILER_PASSWORD.
MAILER_HOST=smtp.gmail.com
MAILER_PORT=587
MAILER_USER=
MAILER_PASSWORD=yo3Umd6zDMaFin96KfqFztE_4agnricG
MAILER_SENDER=structa.cloud@gmail.com

# ── Shared infrastructure (must match application/databases/.env) ───────────
# The PostgreSQL and Redis stacks live in application/databases/; tools only
# consume them. Keep these in sync with that .env — copy the actual values:
#   POSTGRES_USER / POSTGRES_PASSWORD   (shared cluster superuser)
#   REDIS_PASSWORD                      (AFFiNE connects via default-redis)
#   BLINKO_DB_PASSWORD                  (blinko role — matches the init script)
#   CODER_DB_PASSWORD                   (coder role)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-match-databases-env
REDIS_PASSWORD=change-me-match-databases-env

# ── Misc ─────────────────────────────────────────────────────────────────────
TZ=America/Los_Angeles

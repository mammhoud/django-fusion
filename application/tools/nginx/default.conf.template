# Tools-proxy Nginx — reverse proxy for self-hosted tools and Docus.
# All static/media serving now lives on the separate assets-proxy.
# The variable upstreams resolve by container_name on the external `common`
# network, so tool containers can be started/stopped independently.
resolver 127.0.0.11 valid=30s ipv6=off;

# ------------------------------------------------------------
# Default server — health check only (for independent container health)
# ------------------------------------------------------------
server {
    listen 80 default_server;
    server_name _;

    location /health/ {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    location / {
        return 404;
    }
}

# ------------------------------------------------------------
# Docs — docs.structa.cloud (Docus Nuxt server)
# ------------------------------------------------------------
server {
    listen 80;
    server_name docs.structa.cloud docs.localhost;

    location / {
        set $docus_host_upstream docus:3000;
        proxy_pass http://$docus_host_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_buffering off;
    }
}

# ------------------------------------------------------------
# Tools — tools.structa.cloud (self-hosted utilities, path-based)
# ------------------------------------------------------------
# One navigation door for every utility under application/tools/. The root
# serves a small landing page; each /<tool>/ prefix is proxied to its own
# container by name on the external `common` network (Start/stop independent
# of this proxy). Apps that support a base-path setting (Mailpit MP_WEBROOT,
# Grafana serve_from_sub_path) are configured in their docker-compose so the
# browser sees the subpath consistently.
#
#   /             → tools navigation page (nginx/www/tools/index.html)
#   /adminer/     → adminer:8080
#   /mailpit/     → mailpit:8025   (MP_WEBROOT=/mailpit/)
#   /grafana/     → grafana:3000   (serve_from_sub_path=true)
#   /docs/        → docus:3000
#   /notes/       → blinko:1111
server {
    listen 80;
    server_name tools.structa.cloud tools.localhost;

    # Tools navigation page at the root.
    location = / {
        root /var/www/html/tools;
        try_files /index.html =404;
        add_header Cache-Control "no-cache";
    }

    # Health check endpoint (Traefik tools-service healthCheck).
    location = /health/ {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    location /adminer/ {
        set $adminer_upstream adminer:8080;
        proxy_pass http://$adminer_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
    }

    location /mailpit/ {
        set $mailpit_upstream mailpit:8025;
        proxy_pass http://$mailpit_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }

    location /grafana/ {
        set $grafana_upstream grafana:3000;
        proxy_pass http://$grafana_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }

    location /docs/ {
        set $tools_docus_upstream docus:3000;
        proxy_pass http://$tools_docus_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    # Blinko serves its Next.js application from `/`, while the public
    # contract is `/notes/`. Strip the public prefix before proxying so the
    # upstream does not return a route-level 404 for `/notes/`.
    location = /notes {
        absolute_redirect off;
        return 301 /notes/;
    }

    location ^~ /notes/ {
        set $blinko_upstream blinko:1111;
        rewrite ^/notes/(.*)$ /$1 break;
        proxy_pass http://$blinko_upstream;
        proxy_set_header X-Forwarded-Prefix /notes;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        client_max_body_size 128m;
    }

    # Catch-all → Blinko SPA routing.
    location / {
        set $blinko_upstream blinko:1111;
        proxy_pass http://$blinko_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        client_max_body_size 128m;
    }
}
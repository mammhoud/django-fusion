# Docker embedded DNS: variable proxy_pass directives below resolve shared
# service names at request time through the embedded Docker DNS resolver.
resolver 127.0.0.11 valid=30s ipv6=off;

# The workspace control plane is space.structa.cloud (Coder, routed by
# Traefik directly). AFFiNE is served at tools.structa.cloud/space/.

# Fusion sites use the same public /static/ and /media/ URLs. Select their
# named-volume roots by the Host header while preserving the legacy shared
# paths for the existing sites and media subdomains.
map $host $static_root {
    default /var/www/static;
    cms-fusion.localhost /var/www/sites/cms-fusion/static;
    cms-fusion.com /var/www/sites/cms-fusion/static;
    www.cms-fusion.com /var/www/sites/cms-fusion/static;
    precis-lms.localhost /var/www/sites/precis-lms/static;
    lms-fusion.com /var/www/sites/precis-lms/static;
    www.lms-fusion.com /var/www/sites/precis-lms/static;
    lms.structa.cloud /var/www/sites/precis-lms/static;
    www.lms.structa.cloud /var/www/sites/precis-lms/static;
    ctc-research.com /var/www/sites/ctc-research/static;
    www.ctc-research.com /var/www/sites/ctc-research/static;
    arch.ctc-research.com /var/www/sites/ctc-research/static;
}

map $host $media_root {
    default /var/www/media;
    cms-fusion.localhost /var/www/media/cms-fusion;
    cms-fusion.com /var/www/media/cms-fusion;
    www.cms-fusion.com /var/www/media/cms-fusion;
    precis-lms.localhost /var/www/media/precis-lms;
    lms-fusion.com /var/www/media/precis-lms;
    www.lms-fusion.com /var/www/media/precis-lms;
    lms.structa.cloud /var/www/media/precis-lms;
    www.lms.structa.cloud /var/www/media/precis-lms;
    ctc-research.com /var/www/media/ctc-research;
    www.ctc-research.com /var/www/media/ctc-research;
    arch.ctc-research.com /var/www/media/ctc-research;
}

server {
    listen 80;
    server_name _;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/markdown text/javascript application/javascript application/xml application/json image/svg+xml;

    # MIME types
    types {
        text/html                             html htm shtml;
        text/css                              css;
        text/xml                              xml;
        text/markdown                         md;
        image/gif                             gif;
        image/jpeg                            jpeg jpg;
        image/png                             png;
        image/svg+xml                         svg svgz;
        image/webp                            webp;
        application/javascript                js;
        application/json                      json;
        application/font-woff                 woff;
        application/font-woff2                woff2;
        font/ttf                              ttf;
        font/otf                              otf;
    }

    # Site-specific webpack bundles (collected into each site's STATIC_ROOT)
    location /static/bundles/ctc-research/ {
        alias /var/www/sites/ctc-research/static/bundles/ctc-research/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /static/bundles/lms/ {
        alias /var/www/sites/lms/static/bundles/lms/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /static/bundles/vresume/ {
        alias /var/www/sites/vresume/static/bundles/vresume/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /static/bundles/cms-fusion/ {
        alias /var/www/sites/cms-fusion/static/bundles/cms-fusion/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /static/bundles/precis-lms/ {
        alias /var/www/sites/precis-lms/static/bundles/precis-lms/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    # Site-specific static files
    location /sites/ctc-research/static/ {
        alias /var/www/sites/ctc-research/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /sites/lms/static/ {
        alias /var/www/sites/lms/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /sites/vresume/static/ {
        alias /var/www/sites/vresume/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /sites/cms-fusion/static/ {
        alias /var/www/sites/cms-fusion/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /sites/precis-lms/static/ {
        alias /var/www/sites/precis-lms/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    # Shared static files
    location /static/ {
        alias $static_root/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    # Site-specific media files
    location /media/ctc-research/ {
        alias /var/www/media/ctc-research/;
        expires 30d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /media/lms/ {
        alias /var/www/media/lms/;
        expires 30d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location /media/vresume/ {
        alias /var/www/media/vresume/;
        expires 30d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    # Shared media files. Fusion hosts resolve to their named-volume root
    # through $media_root; legacy hosts retain /var/www/media/.
    location /media/ {
        alias $media_root/;
        expires 30d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        try_files $uri $uri/ =404;
    }

    # Health check endpoint
    location /health/ {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # Optional resolver probe for operators. The healthcheck intentionally
    # uses the local endpoint above so proxy health is independent of backend
    # rollout order.
    location = /__resolver_probe__ {
        access_log off;
        set $resolver_probe docus:3000;
        proxy_pass http://$resolver_probe;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # ------------------------------------------------------------
    # Docus — Structa Cloud documentation (Nuxt server)
    # Docus owns SSR, content search, locale routing, sitemap, and LLM routes.
    # Keep the /docs/ prefix intact for the media host and let Docus render
    # direct deep links instead of applying a static SPA fallback.
    location = /docs {
        absolute_redirect off;
        return 301 /docs/;
    }

    location /docs/ {
        set $docus_upstream docus:3000;
        proxy_pass http://$docus_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    # Media index — serve a small landing page at the root so `/` isn't a
    # bare 404 (media.structa.cloud, media.ctc-research.com, media.lms.com,
    # media.vresume.structa.cloud). Content lives in ./nginx/www/index.html,
    # bind-mounted to /var/www/html (see docker-compose.nginx.yml).
    location = / {
        root /var/www/html;
        try_files /index.html =404;
        add_header Cache-Control "no-cache";
    }

    # Return 404 for any other requests (this is a media-only server)
    location / {
        return 404;
    }
}

# ------------------------------------------------------------
# Docs — docs.structa.cloud (Docus Nuxt server)
# ------------------------------------------------------------
# Traefik strips /docs from this host before forwarding to shared-proxy.
# Docus still emits /docs/ asset URLs, which Traefik strips again on the
# browser's subsequent requests. The variable upstream keeps shared-proxy's
# Nginx config valid while the Docus workspace service is restarting.
server {
    listen 80;
    server_name docs.structa.cloud docs.localhost;

    location / {
        set $docus_host_upstream docus:3000;
        proxy_pass http://$docus_host_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_buffering off;
    }
}

# ------------------------------------------------------------
# Tools — tools.structa.cloud (self-hosted utilities, path-based)
# ------------------------------------------------------------
# One navigation door for every utility under application/tools/. The root
# serves a small landing page; each /<tool>/ prefix is proxied to its own
# container by name on the external `common` network (start/stop independent
# of this proxy). Apps that support a base-path setting (Mailpit MP_WEBROOT,
# Grafana serve_from_sub_path) are configured in their docker-compose so the
# browser sees the subpath consistently.
#
#   /             → tools navigation page (nginx/www/tools/index.html)
#   /adminer/     → adminer:8080
#   /mailpit/     → mailpit:8025   (MP_WEBROOT=/mailpit/)
#   /ai/          → open-webui:8080
#   /grafana/     → grafana:3000   (serve_from_sub_path=true)
#   /docs/        → docus:3000
#   /space/       → proxy-affine:3010
#
# AFFiNE's own redirects and SPA are origin-absolute (it redirects to
# `/admin/setup`, `/workspace`, … and loads assets/API from origin paths), so
# the catch-all below proxies every non-tool path to proxy-affine:3010.
# /admin/setup, /workspace, /api/, /graphql, and AFFiNE assets all resolve
# through it; the tools nav page keeps the exact `/` location above.
server {
    listen 80;
    server_name tools.structa.cloud tools.localhost;

    # Tools navigation page at the root.
    location = / {
        root /var/www/html/tools;
        try_files /index.html =404;
        add_header Cache-Control "no-cache";
    }

    # Health check endpoint (Traefik tools-service healthCheck).
    location = /health/ {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    location /adminer/ {
        set $adminer_upstream adminer:8080;
        proxy_pass http://$adminer_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
    }

    location /mailpit/ {
        set $mailpit_upstream mailpit:8025;
        proxy_pass http://$mailpit_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }

    location /ai/ {
        set $open_webui_upstream open-webui:8080;
        proxy_pass http://$open_webui_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        client_max_body_size 128m;
    }

    location /grafana/ {
        set $grafana_upstream grafana:3000;
        proxy_pass http://$grafana_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }

    location /docs/ {
        set $tools_docus_upstream docus:3000;
        proxy_pass http://$tools_docus_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location /space/ {
        set $tools_affine_upstream proxy-affine:3010;
        proxy_pass http://$tools_affine_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        client_max_body_size 128m;
    }

    # Catch-all → AFFiNE at origin paths (setup, workspace, assets, APIs).
    # Keeps /admin/setup working after AFFiNE's absolute redirects.
    location / {
        set $tools_affine_upstream proxy-affine:3010;
        proxy_pass http://$tools_affine_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        client_max_body_size 128m;
    }
}

  "scripts": {
    "purgecss": "npx purgecss --config ./purgecss.config.js",
    "analyze": "PROJECT_PATH=structa.cloud npx webpack --config ../webpack/main.config.js --profile --json > stats.json && npx webpack-bundle-analyzer stats.json",
    "css:stats": "npx cssstats assets/static/css/master.css",
    "css:minify": "npx cssnano assets/static/css/master.css assets/static/css/master.min.css",
    "dev": "PROJECT_PATH=structa.cloud webpack serve --mode development --config ../webpack/main.config.js",
    "watch": "PROJECT_PATH=structa.cloud webpack watch --mode development --config ../webpack/main.config.js",
    "build": "PROJECT_PATH=structa.cloud NODE_ENV=production webpack --mode production --config ../webpack/main.config.js",
    "build:dev": "PROJECT_PATH=structa.cloud webpack --mode development --config ../webpack/main.config.js",
    "build:prod": "npm run build",
    "build:analyze": "PROJECT_PATH=structa.cloud NODE_ENV=production webpack --mode production --config ../webpack/main.config.js --stats detailed",
    "clean": "rm -rf assets/bundles/*",
    "start": "npm run dev"
  }

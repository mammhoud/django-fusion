#!/bin/bash
set -o errexit
set -o pipefail
set -o nounset

APP_HOME="/app"
cd "$APP_HOME"

HOST="${HOST:-0.0.0.0}"
PORT="${PORT:-5070}"
WORKERS="${WORKERS:-4}"
RELOAD="${RELOAD:-false}"
LOG_LEVEL="${LOG_LEVEL:-info}"
APP_MODULE="${APP_MODULE:-www.asgi:application}"
WATCH_DIRS="${WATCH_DIRS:-./www,./configs}"

echo "🚀 Starting uvicorn: $APP_MODULE on $HOST:$PORT"

if [ "$RELOAD" = "true" ]; then
    ARGS=(
        "$APP_MODULE"
        "--host" "$HOST"
        "--port" "$PORT"
        "--reload"
        "--log-level" "debug"
    )
    IFS=',' read -ra DIR_ARRAY <<< "$WATCH_DIRS"
    for dir in "${DIR_ARRAY[@]}"; do
        dir_clean=$(echo "$dir" | xargs)
        [ -d "$dir_clean" ] && ARGS+=("--reload-dir" "$dir_clean")
    done
else
    ARGS=(
        "$APP_MODULE"
        "--host" "$HOST"
        "--port" "$PORT"
        "--workers" "$WORKERS"
        "--log-level" "$LOG_LEVEL"
    )
fi

echo "🏥 Health: http://${HOST}:${PORT}/health/"
exec uvicorn "${ARGS[@]}"

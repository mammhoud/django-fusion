#!/bin/bash
set -euo pipefail

echo "🚀 Entrypoint: Booting..."

###############################################################################
# DJANGO SETUP (Only for main app, not workers)
###############################################################################
if [ "${RUN_SETUP:-false}" = "true" ]; then

    echo "📦 Building static assets..."
    python manage.py build_assets --collectstatic-only --no-input 2>&1 || echo "⚠️  build_assets failed (non-fatal)"

    echo "🗃️  Making migrations..."
    python manage.py makemigrations --noinput 2>&1 || echo "⚠️  makemigrations failed (non-fatal)"

    echo "🗃️  Applying migrations..."
    python manage.py migrate --noinput 2>&1 || echo "⚠️  migrate failed (non-fatal)"

    if [ -n "${SUPERUSER_USERNAME:-}" ] && [ -n "${SUPERUSER_PASSWORD:-}" ]; then
        echo "👑 Ensuring superuser..."
        python -m django_rseal.scripts.superuser 2>&1 || echo "⚠️  superuser failed (non-fatal)"
    fi

    # ── Load dump-data.json first (always, skip if already loaded) ───────────
    FIXTURES_DIR="/app/assets/fixtures"
    if [ -f "${FIXTURES_DIR}/dump-data.json" ]; then
        echo "📂 Loading dump-data.json ..."
        # Only load if wagtailcore_page table has 2 or fewer rows (just root + welcome)
        PAGE_COUNT=$(python manage.py shell -c "from wagtail.models import Page; print(Page.objects.count())" 2>/dev/null | tail -1 || echo "0")
        if [ "${PAGE_COUNT:-0}" -le 2 ]; then
            python manage.py loaddata "${FIXTURES_DIR}/dump-data.json" --ignorenonexistent 2>&1 \
                || echo "⚠️  loaddata dump-data.json failed (non-fatal)"
        else
            echo "  ℹ️  Skipping — ${PAGE_COUNT} pages already in DB"
        fi
    fi

    # ── Load extra fixtures only when LOAD_FIXTURES=true ─────────────────────
    if [ "${LOAD_FIXTURES:-false}" = "true" ]; then
        echo "📂 Loading extra fixtures..."
        for fixture in initial_choices.json users.json; do
            if [ -f "${FIXTURES_DIR}/${fixture}" ]; then
                echo "  → ${fixture}"
                python manage.py loaddata "${FIXTURES_DIR}/${fixture}" --ignorenonexistent 2>&1 \
                    || echo "⚠️  loaddata ${fixture} failed (non-fatal)"
            fi
        done
    fi

    # ── Set Wagtail home page + English language (after data is loaded) ───────
    echo "🏠 Setting up Wagtail home page and language..."
    python manage.py setup_wagtail_home 2>&1 || echo "⚠️  setup_wagtail_home failed (non-fatal)"

    echo "🌐 Compiling translation messages..."
    python manage.py compilemessages 2>&1 || echo "⚠️  compilemessages failed (non-fatal)"

    if command -v crontab >/dev/null 2>&1; then
        echo "⏰ Installing hourly error-report cron..."
        (crontab -l 2>/dev/null | grep -v "send_error_report"; \
         echo "0 * * * * cd /app && python manage.py send_error_report >> /app/logs/error_report_cron.log 2>&1") \
         | crontab - 2>/dev/null || echo "⚠️  crontab install failed (non-fatal)"
        service cron start 2>/dev/null || crond 2>/dev/null || true
    else
        echo "ℹ️  cron not available"
    fi
fi

echo "🎯 Launching: $*"
cd /app
exec "$@"

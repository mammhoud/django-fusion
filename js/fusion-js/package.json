{
  "name": "fusion-js",
  "version": "0.1.0",
  "description": "Framework-agnostic modular TS/ESM modules for django-fusion frontends (htmx wrapper, SSE client, fragments, scroll reveal, theme).",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./src/index.ts" },
    "./modules/*": { "types": "./src/modules/*.ts", "import": "./src/modules/*.ts" }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}

{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "docs",
  "root": "docs",
  "projectType": "application",
  "tags": ["type:docs", "stack:node"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "cache": true,
      "options": { "command": "npm run build", "cwd": "docs" }
    },
    "build-static": {
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "cache": true,
      "options": { "command": "npm run build:static", "cwd": "docs" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run dev", "cwd": "docs" }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run preview", "cwd": "docs" }
    },
    "prepare-content": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run prepare-content", "cwd": "docs" }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["prepare-content"],
      "options": { "command": "make check", "cwd": "docs" }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["check"],
      "options": { "command": "docker compose -f docker-compose.yml up -d --build", "cwd": "docs" }
    }
  }
}

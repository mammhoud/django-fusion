@import "tailwindcss";
@plugin "flyonui";
@import "flyonui/variants.css";
@import "./planinc-palette.css";
/* Design token contract (PI-011 · P1). Tier 1 global → 2 alias → 3 channel → 4 component.
 * Both @import rules must precede every other at-rule, so this sits before @config. */
@import "./tokens.css";
/* Platform/OS adaptation layer (PI-014). Reads the data-* attributes that
 * src/platform/PlatformProvider.tsx mirrors onto <html>, so one stylesheet
 * serves web, PWA, and the Tauri desktop/mobile shells. Colour-free by rule. */
@import "./platform.css";
@config "../../tailwind.config.js";

/* --------------------------------------------------------------------------
 * Tokens → Tailwind v4 theme namespace.
 * This is the shadcn-style contract: semantic CSS variables exposed as
 * utilities (`bg-background`, `text-desc`, `border-border`, `ring-ring`, …).
 * `inline` keeps the resolution at the utility site so the `.dark` remap in
 * tokens.css flows through without a `dark:` branch anywhere.
 * ------------------------------------------------------------------------ */
@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-secondbackground: var(--secondbackground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-destructive-soft: var(--destructive-soft);
  --color-destructive-soft-foreground: var(--destructive-soft-foreground);
  --color-success: var(--success);
  --color-success-foreground: var(--success-foreground);
  --color-success-soft: var(--success-soft);
  --color-success-soft-foreground: var(--success-soft-foreground);
  --color-warning: var(--warning);
  --color-warning-foreground: var(--warning-foreground);
  --color-warning-soft: var(--warning-soft);
  --color-warning-soft-foreground: var(--warning-soft-foreground);
  --color-info: var(--info);
  --color-info-foreground: var(--info-foreground);
  --color-info-soft: var(--info-soft);
  --color-info-soft-foreground: var(--info-soft-foreground);
  --color-chart-1: var(--chart-1);
  --color-chart-2: var(--chart-2);
  --color-chart-3: var(--chart-3);
  --color-chart-4: var(--chart-4);
  --color-chart-5: var(--chart-5);
  --color-chart-6: var(--chart-6);
  --color-progress-from: var(--progress-from);
  --color-progress-to: var(--progress-to);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-header: var(--header);
  --color-hover: var(--hover);
  --color-desc: var(--desc);
  --color-ignore: var(--ignore);
  --color-tag: var(--tag);
  --color-tag-foreground: var(--tag-foreground);

  --radius-sm: var(--pi-radius-sm);
  --radius-md: var(--pi-radius-md);
  --radius-lg: var(--pi-radius-lg);
  --radius-xl: var(--pi-radius-xl);
  --radius-2xl: var(--pi-radius-2xl);
}

.bm-burger-button {
  display: none;
}

.bm-menu-wrap {
  width: fit-content;
  height: 100%;
  overflow: hidden !important;
}

.bm-menu {
  overflow: hidden !important;
}

::selection {
  background-color: var(--selection-bg);
  color: var(--selection-fg);
}

::marker {
  color: var(--desc) !important;
}

.card-masonry-grid {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  margin-left: -10px;
  width: auto;
}

.card-masonry-grid_column {
  padding-left: 10px;
  background-clip: padding-box;
}

/* Style your items */
.card-masonry-grid_column>div {
  margin-bottom: 10px;
}


.blog-masonry-grid {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  margin-left: -20px;
  width: auto;
}

.blog-masonry-grid_column {
  padding-left: 20px;
  background-clip: padding-box;
}

/* Style your items */
.blog-masonry-grid_column>div {
  margin-bottom: 20px;
}

/* Fix card height  */
.layout-container>div {
  height: 100%;
  z-index: 10;
}

html,
body {
  scroll-behavior: smooth;
  overflow-y: hidden!important;
  height: var(--doc-height);
  overscroll-behavior: none;
  -webkit-overflow-scrolling: touch;
  background-color: var(--secondbackground);
  font-family: var(--font-family);
}

/* --------------------------------------------------------------------------
 * Appearance v2 (PI-011 · P3).
 * `lib/appearance.ts` puts the user's choices on <html> as `data-*` attributes
 * plus `--pi-ui-scale`; these rules turn them into token overrides, so density /
 * type scale / direction / motion / contrast reach every surface — including the
 * third-party ones (Vditor, ECharts, HeroUI) — without a prop being threaded
 * through the component tree. Every value below references a token; no literal
 * is introduced here.
 * ------------------------------------------------------------------------ */

/* `1rem` resolves against the initial font size, so this scales the whole UI. */
html {
  font-size: calc(1rem * var(--pi-ui-scale));
}

body {
  line-height: var(--pi-line-height);
}

html[data-line-height="compact"] {
  --pi-line-height: 1.4;
}

html[data-line-height="relaxed"] {
  --pi-line-height: 1.8;
}

/* Compact trades breathing room for cards per screen (chips are the densest
 * repeated element in the card layout). */
html[data-density="compact"] {
  --chip-font-size: 12px;
  --chip-radius: 5px;
  --contextmenu-item-radius: 9px;
}

html[data-contrast-boost="true"]:not(.dark) {
  --desc: var(--pi-color-neutral-800);
  --ignore: var(--pi-color-neutral-600);
  --border: var(--pi-color-neutral-300);
}

html[data-contrast-boost="true"].dark {
  --desc: var(--pi-color-neutral-225);
  --ignore: var(--pi-color-neutral-500);
  --border: var(--pi-color-neutral-800);
}

/* The user-facing motion switch, symmetric with the
 * `prefers-reduced-motion` block in tokens.css. */
html[data-reduce-motion="true"] {
  --motion-fast: 1ms;
  --motion-base: 1ms;
}

/* The dark variant is a token remap (`--hero-glow` / `--hero-base`), not a
 * `.dark` component branch — see tokens.css tier 4. */
.dashboard-hero {
  background:
    radial-gradient(circle at 90% 10%, var(--hero-glow), transparent 34%),
    linear-gradient(135deg, var(--hero-base), var(--background));
}

.h-mobile-full {
  height: var(--doc-height);
}

/* menu  tree list  */
.tree ul {
  list-style: none !important;
}

/* menu  tree list  */
.tree li {
  list-style: none !important;
}

.planinc-tag {
   margin-right: 4px;
   margin-left: 4px;
   color: var(--primary) !important;
   background-color: color-mix(in srgb, var(--primary) 10%, transparent);
   border-radius: var(--tag-radius);
   font-size: var(--chip-font-size);
   padding: 3px;
   text-decoration: none !important;
}

.planinc-reference {
   border: 2px solid color-mix(in srgb, var(--primary) 20%, transparent);
   background-color: color-mix(in srgb, var(--primary) 10%, transparent);
   border-radius: var(--tag-radius);
   font-size: var(--chip-font-size);
   padding: 4px;
   cursor: pointer;
   transition: all var(--motion-base) var(--motion-ease);
}

.planinc-reference:hover {
   background-color: color-mix(in srgb, var(--primary) 20%, transparent);
}


.contextmenu {
   padding: 2px !important;
   padding-top: 6px !important;
   padding-bottom: 6px !important;
   box-shadow: var(--shadow) !important;
   border-radius: var(--contextmenu-radius) !important;
   border: 2px solid var(--desc) !important;
   background-color: var(--background) !important;
   transition: all var(--motion-base) var(--curve-enter);
}

.contextmenu .contextmenu__item {
   border-radius: var(--contextmenu-item-radius);
   margin-left: 3px;
   margin-right: 3px;
   transition: all var(--motion-fast) var(--curve-exit);
}

.contextmenu .contextmenu__item:hover {
   background-color: var(--secondbackground) !important;
}

.PhotoView-Portal {
  z-index: 10000;
}

.swiper-3d .swiper-slide-shadow {
  background: var(--swiper-3d-shadow) !important;
}

.ͼo.cm-focused .cm-matchingBracket {
  color: var(--desc);
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

/* The `:root` / `.dark` token declarations that used to live here moved to
 * `./tokens.css` as tiers 1–4 of the design token contract (PI-011 · P1).
 * Nothing in this file declares a colour literal any more. */

.glass-effect {
  background: var(--glass-bg);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}



::-webkit-scrollbar {
  background: transparent;
  width: 8px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
  transition: all 1s;
}

::-webkit-scrollbar-thumb {
   background: var(--primary);
   border-radius: var(--scrollbar-radius);
   transition: all var(--motion-fast) var(--curve-exit);
}

::-webkit-scrollbar-thumb:hover {
   background: color-mix(in srgb, var(--primary) 80%, transparent);
}

.hide-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.hide-scrollbar::-webkit-scrollbar {
  display: none;
}

.mermaid-wrapper {
   display: flex;
   justify-content: center;
   margin: 1rem 0;
   padding: 1rem;
   border-radius: var(--card-radius);
   transition: all var(--motion-base) var(--curve-enter);
}

.markmap-foreign {
   color: var(--foreground);
}

.echarts-wrapper {
   display: flex;
   justify-content: center;
   margin: 1rem 0;
   padding: 1rem;
   border-radius: var(--card-radius);
   background: var(--secondbackground);
   transition: all var(--motion-base) var(--curve-enter);
}

.group[data-focus-visible="true"] .group-data-\[focus-visible\=true\]\:ring-2 {
   --tw-ring-shadow: 0 !important;
}

.note-card--highlight {
  animation: highlight-pulse 2s ease-out forwards;
}

@keyframes highlight-pulse {
  0%   { box-shadow: 0 0 0 0 var(--planinc-accent-20, rgba(245, 158, 11, 0.2)); }
  30%  { box-shadow: 0 0 0 8px var(--planinc-accent-40, rgba(245, 158, 11, 0.4)); }
  100% { box-shadow: 0 0 0 0 transparent; }
}
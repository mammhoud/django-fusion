{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:anytype:schema:2026-08-04:type-milestone:ver-1.0",
  "type": "object",
  "title": "Milestone",
  "x-app": "Anytype",
  "x-icon-name": "flag",
  "x-plural": "Milestones",
  "x-schema-version": "1.0",
  "x-type-key": "milestone",
  "properties": {
    "Object type": {
      "const": "Milestone",

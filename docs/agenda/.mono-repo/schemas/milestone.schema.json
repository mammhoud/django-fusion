      "x-key": "tags"
    },
    "Status": {
      "enum": ["Planned", "In Progress", "Reached", "Cancelled"],
      "type": "string",
      "x-key": "status"
    },
    "Target": {
      "format": "date-time",
      "type": "string",
      "x-format": "date",
      "x-key": "targetDate"
    },
    "Description": {"type": "string", "x-key": "description"},
    "Links": {
      "items": {"type": "string"},
      "type": "array",
      "x-format": "object",
      "x-key": "links"
    }
  },
  "required": ["Object type", "Tags", "Status"]
}